+// Penalizaciones escalonadas, exención por un gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const GESTOR = "socio-040";
+
+/** Crea una reserva con el reloj en `creadaA` y luego pone el reloj en `ahora`. Devuelve la reserva. */
+async function reservaConAntelacion(pistaId: string, inicio: string, ahora: string, creadaA = "2026-11-18T10:00") {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: creadaA } });
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId, inicio } });
+  assert.equal(creada.status, 201, JSON.stringify(creada.cuerpo));
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  return creada.cuerpo.reserva;
+}
+
+const cancelar = (id: string, cuerpo?: unknown, socio?: string) =>
+  api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+
+test("tramos: sin penalización con 48 h o más, 25 % entre 24 y 48 h, 50 % y forzar por debajo de 24 h", async () => {
+  // Miércoles 2 de diciembre de 2026 a las 18:00 en pista 2: punta, 2800.
+  const holgada = await reservaConAntelacion("pista-2", "2026-12-02T18:00", "2026-11-29T18:00");
+  const sinPenalizacion = await cancelar(holgada.id);
+  assert.equal(sinPenalizacion.status, 200);
+  assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(sinPenalizacion.cuerpo.reembolso, 2800);
+
+  const media = await reservaConAntelacion("pista-2", "2026-12-03T18:00", "2026-12-02T08:00");
+  const reducida = await cancelar(media.id);
+  assert.equal(reducida.status, 200);
+  assert.equal(reducida.cuerpo.reserva.penalizacion, 700);
+  assert.equal(reducida.cuerpo.reembolso, 2100);
+
+  const justa = await reservaConAntelacion("pista-2", "2026-12-04T18:00", "2026-12-04T08:00");
+  const sinForzar = await cancelar(justa.id);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await cancelar(justa.id, { forzar: true });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1400);
+  assert.equal(forzada.cuerpo.reembolso, 1400);
+});
+
+test("límites exactos: a 48 h justas no hay penalización y a 24 h justas es el 25 % sin forzar", async () => {
+  const a48 = await reservaConAntelacion("pista-1", "2026-12-07T10:30", "2026-12-05T10:30");
+  const gratis = await cancelar(a48.id);
+  assert.equal(gratis.status, 200);
+  assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.cuerpo.reembolso, 1800);
+
+  const a24 = await reservaConAntelacion("pista-1", "2026-12-08T10:30", "2026-12-07T10:30");
+  const reducida = await cancelar(a24.id);
+  assert.equal(reducida.status, 200);
+  assert.equal(reducida.cuerpo.reserva.penalizacion, 450);
+  assert.equal(reducida.cuerpo.reembolso, 1350);
+});
+
+test("cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales.
+  const marzo = await reservaConAntelacion("pista-2", "2027-03-28T21:00", "2027-03-26T20:30");
+  const reducida = await cancelar(marzo.id);
+  assert.equal(reducida.status, 200);
+  assert.equal(reducida.cuerpo.reserva.penalizacion, 700);
+  assert.equal(reducida.cuerpo.reembolso, 2100);
+
+  // Desde las 20:00 del viernes son 48 horas reales justas (49 de reloj): gratis.
+  const marzoGratis = await reservaConAntelacion("pista-1", "2027-03-28T21:00", "2027-03-26T20:00");
+  const exactas = await cancelar(marzoGratis.id);
+  assert.equal(exactas.cuerpo.reserva.penalizacion, undefined, "20:00 del viernes a 21:00 del domingo son 48 horas reales");
+
+  // En octubre los relojes se atrasan: del sábado 30 a las 21:30 al domingo 31 a las 21:00 hay 24,5 horas reales.
+  const octubre = await reservaConAntelacion("pista-2", "2027-10-31T21:00", "2027-10-30T21:30");
+  const sinForzar = await cancelar(octubre.id);
+  assert.equal(sinForzar.status, 200);
+  assert.equal(sinForzar.cuerpo.reserva.penalizacion, 700);
+});
+
+test("exención: un gestor cancela sin penalización con un motivo de 10 caracteres o más", async () => {
+  const r = await reservaConAntelacion("pista-3", "2026-12-10T09:00", "2026-12-10T08:00");
+  const sinIdentificar = await cancelar(r.id, { exento: true, motivo: "Lluvia torrencial" });
+  assert.equal(sinIdentificar.status, 401);
+  assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await cancelar(r.id, { exento: true, motivo: "Lluvia torrencial" }, "socio-003");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const sinMotivo = await cancelar(r.id, { exento: true }, GESTOR);
+  assert.equal(sinMotivo.status, 400);
+  assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const corto = await cancelar(r.id, { exento: true, motivo: "Lluvia" }, GESTOR);
+  assert.equal(corto.status, 400);
+  assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva.estado, "confirmada");
+
+  const exenta = await cancelar(r.id, { exento: true, motivo: "Pista inundada por la lluvia" }, GESTOR);
+  assert.equal(exenta.status, 200);
+  assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+  assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "Pista inundada por la lluvia");
+  assert.equal(exenta.cuerpo.reembolso, 1200);
+});
+
+test("reservas pasadas: no se cancelan, tampoco con exento", async () => {
+  const r = await reservaConAntelacion("pista-3", "2026-12-11T09:00", "2026-12-11T09:00");
+  const normal = await cancelar(r.id, { forzar: true });
