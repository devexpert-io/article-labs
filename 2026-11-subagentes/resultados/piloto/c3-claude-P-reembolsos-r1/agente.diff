+test("informe de caja: reservas, ingresos y penalizaciones por pista y del club", async () => {
+  const propia = await arrancarApi();
+  try {
+    // Una cancelación con penalización en noviembre: R-0520, pista 3, 1200, a 23 horas.
+    const forzada = await propia.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+
+    const estado = (await propia.pedir("GET", "/_estado")).cuerpo;
+    for (const mes of ["2026-10", "2026-11"]) {
+      const informe = await propia.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: GESTOR });
+      assert.equal(informe.status, 200);
+      assert.equal(informe.cuerpo.mes, mes);
+      const esperado = { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 };
+      const pistas = ["pista-1", "pista-2", "pista-3", "pista-4"].map((pistaId) => {
+        const delMes = estado.reservas.filter((r: any) => r.pistaId === pistaId && r.inicio.startsWith(mes));
+        const cobradas = delMes.filter((r: any) => r.estado === "confirmada" || r.estado === "no_presentada");
+        const ingresos = cobradas.reduce((s: number, r: any) => s + r.importe, 0);
+        const penalizaciones = delMes.filter((r: any) => r.estado === "cancelada").reduce((s: number, r: any) => s + (r.penalizacion ?? 0), 0);
+        const fila = { pistaId, reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+        esperado.reservas += fila.reservas;
+        esperado.ingresos += fila.ingresos;
+        esperado.penalizaciones += fila.penalizaciones;
+        esperado.total += fila.total;
+        return fila;
+      });
+      assert.deepEqual(informe.cuerpo.pistas, pistas);
+      assert.deepEqual(informe.cuerpo.total, esperado);
+      assert.ok(esperado.reservas > 0);
+    }
+    const noviembre = await propia.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR });
+    assert.equal(noviembre.cuerpo.pistas.find((p: any) => p.pistaId === "pista-3").penalizaciones, 600);
+    assert.equal(noviembre.cuerpo.total.penalizaciones, 600);
+
+    // Un mes sin movimientos: todas las pistas aparecen, a cero.
+    const vacio = await propia.pedir("GET", "/api/informes/caja?mes=2027-01", { socio: GESTOR });
+    assert.deepEqual(vacio.cuerpo, {
+      mes: "2027-01",
+      pistas: ["pista-1", "pista-2", "pista-3", "pista-4"].map((pistaId) => ({ pistaId, reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 })),
+      total: { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    });
+  } finally {
+    propia.cerrar();
+  }
+});
