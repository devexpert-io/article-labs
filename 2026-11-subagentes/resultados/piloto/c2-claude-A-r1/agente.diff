+// Lista de espera de franjas (docs/specs/lista-espera.md).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+// 2026-11-30 (lunes) no tiene reservas en la semilla. Socios con pocas reservas futuras:
+// Nora (socio-041) ninguna, Marta (socio-002) e Irene (socio-004) una, Luis (socio-005) dos.
+const FRANJA = { pistaId: "pista-1", inicio: "2026-11-30T18:00" };
+
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+const reservar = async (api: Api, socioId: string, franja = FRANJA) => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, ...franja } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva.id as string;
+};
+const apuntar = (api: Api, socio: string | undefined, franja: Record<string, unknown> = FRANJA) =>
+  api.pedir("POST", "/api/esperas", { cuerpo: franja, ...(socio ? { socio } : {}) });
+const esperas = async (api: Api) => (await api.pedir("GET", "/_estado")).cuerpo.esperas;
+
+test("apuntarse a una franja ocupada", () => conApi(async (api) => {
+  await reservar(api, "socio-003");
+  const r = await apuntar(api, "socio-041");
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.cuerpo.espera, { id: r.cuerpo.espera.id, socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-30T18:00", estado: "activa", posicion: 1 });
+  const segunda = await apuntar(api, "socio-002");
+  assert.equal(segunda.cuerpo.espera.posicion, 2);
+  const sin = await apuntar(api, undefined);
+  assert.equal(sin.status, 401);
+  assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+}));
+
+test("solo se esperan franjas ocupadas y que se podrían reservar", () => conApi(async (api) => {
+  await reservar(api, "socio-003");
+  const casos: [Record<string, unknown>, string, number, string?][] = [
+    [{ pistaId: "pista-2", inicio: "2026-11-30T18:00" }, "FRANJA_LIBRE", 409],
+    [{ pistaId: "pista-9", inicio: "2026-11-30T18:00" }, "PISTA_NO_ENCONTRADA", 404],
+    [{ pistaId: "pista-4", inicio: "2026-11-30T18:00" }, "PISTA_CERRADA", 409],
+    [{ pistaId: "pista-1", inicio: "2026-11-30T18:15" }, "FRANJA_INVALIDA", 400],
+    [{ pistaId: "pista-1", inicio: "2026-11-18T09:00" }, "FRANJA_PASADA", 409],
+    [{ pistaId: "pista-1" }, "DATOS_INVALIDOS", 400],
+    [FRANJA, "CUOTA_INACTIVA", 409, "socio-011"],
+  ];
+  for (const [franja, codigo, http, socio] of casos) {
+    const r = await apuntar(api, socio ?? "socio-041", franja);
+    assert.equal(r.status, http, codigo);
+    assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+}));
+
+test("sin duplicados, sin esperar lo propio y como mucho 2 esperas activas", () => conApi(async (api) => {
+  await reservar(api, "socio-003");
+  await reservar(api, "socio-003", { pistaId: "pista-2", inicio: "2026-11-30T18:00" });
+  await reservar(api, "socio-006", { pistaId: "pista-3", inicio: "2026-11-30T18:00" });
+  assert.equal((await apuntar(api, "socio-041")).status, 201);
+  const otra = await apuntar(api, "socio-041");
+  assert.equal(otra.cuerpo.error.codigo, "YA_EN_ESPERA");
+  const propia = await apuntar(api, "socio-003");
+  assert.equal(propia.cuerpo.error.codigo, "YA_RESERVADA");
+  assert.equal((await apuntar(api, "socio-041", { pistaId: "pista-2", inicio: "2026-11-30T18:00" })).status, 201);
+  const tercera = await apuntar(api, "socio-041", { pistaId: "pista-3", inicio: "2026-11-30T18:00" });
+  assert.equal(tercera.status, 409);
+  assert.equal(tercera.cuerpo.error.codigo, "LIMITE_DE_ESPERAS");
+}));
+
+test("consultar las esperas activas con su posición", () => conApi(async (api) => {
+  await reservar(api, "socio-003");
+  await apuntar(api, "socio-002");
+  const nora = await apuntar(api, "socio-041");
+  const propias = await api.pedir("GET", "/api/esperas", { socio: "socio-041" });
+  assert.equal(propias.status, 200);
+  assert.deepEqual(propias.cuerpo.esperas, [nora.cuerpo.espera]);
+  assert.equal(propias.cuerpo.esperas[0].posicion, 2);
+  const gestor = await api.pedir("GET", "/api/esperas?socio=socio-041", { socio: GESTOR });
+  assert.deepEqual(gestor.cuerpo.esperas, [nora.cuerpo.espera]);
+  assert.deepEqual((await api.pedir("GET", "/api/esperas", { socio: GESTOR })).cuerpo.esperas, []);
+  const ajena = await api.pedir("GET", "/api/esperas?socio=socio-041", { socio: "socio-002" });
+  assert.equal(ajena.status, 403);
+  assert.equal(ajena.cuerpo.error.codigo, "SIN_PERMISO");
+  const sin = await api.pedir("GET", "/api/esperas");
+  assert.equal(sin.status, 401);
+}));
+
+test("retirarse: los de detrás suben y solo puede su dueño o un gestor", () => conApi(async (api) => {
+  await reservar(api, "socio-003");
+  const marta = (await apuntar(api, "socio-002")).cuerpo.espera;
+  await apuntar(api, "socio-041");
+  await apuntar(api, "socio-004");
+  const ajena = await api.pedir("DELETE", `/api/esperas/${marta.id}`, { socio: "socio-041" });
+  assert.equal(ajena.status, 403);
+  assert.equal(ajena.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("DELETE", `/api/esperas/${marta.id}`)).status, 401);
+  const retirada = await api.pedir("DELETE", `/api/esperas/${marta.id}`, { socio: "socio-002" });
+  assert.equal(retirada.status, 200);
+  assert.equal(retirada.cuerpo.espera.estado, "retirada");
+  assert.equal("posicion" in retirada.cuerpo.espera, false);
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-041" })).cuerpo.esperas[0].posicion, 1);
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-004" })).cuerpo.esperas[0].posicion, 2);
+  const irene = (await api.pedir("GET", "/api/esperas", { socio: "socio-004" })).cuerpo.esperas[0];
+  const porGestor = await api.pedir("DELETE", `/api/esperas/${irene.id}`, { socio: GESTOR });
+  assert.equal(porGestor.cuerpo.espera.estado, "retirada");
+  const noExiste = await api.pedir("DELETE", "/api/esperas/E-9999", { socio: GESTOR });
+  assert.equal(noExiste.status, 404);
+  assert.equal(noExiste.cuerpo.error.codigo, "ESPERA_NO_ENCONTRADA");
+}));
+
+test("al cancelar, la franja se asigna al primero de la lista", () => conApi(async (api) => {
+  const id = await reservar(api, "socio-003");
+  const nora = (await apuntar(api, "socio-041")).cuerpo.espera;
+  await apuntar(api, "socio-002");
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  const nueva = (await api.pedir("GET", `/api/reservas/${r.cuerpo.asignadaA}`)).cuerpo.reserva;
+  assert.equal(nueva.socioId, "socio-041");
+  assert.equal(nueva.pistaId, "pista-1");
+  assert.equal(nueva.inicio, "2026-11-30T18:00");
+  assert.equal(nueva.estado, "confirmada");
+  assert.equal(nueva.importe, 2800);
+  assert.equal(nueva.notas, "Asignada desde la lista de espera");
+  const estadoNora = (await esperas(api)).find((e: { id: string }) => e.id === nora.id);
+  assert.equal(estadoNora.estado, "asignada");
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-002" })).cuerpo.esperas[0].posicion, 1);
+}));
+
+test("también se asigna al cancelar con forzar", () => conApi(async (api) => {
+  await apuntar(api, "socio-041", { pistaId: "pista-3", inicio: "2026-11-19T09:00" });
