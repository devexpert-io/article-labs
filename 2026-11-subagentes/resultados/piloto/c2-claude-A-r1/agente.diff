+      const p = pista(pistaId as string);
+      comprobarFranja(socio, p, inicio as string);
+      const reservada = estado.reservas.find((r) => r.pistaId === p.id && r.inicio === inicio && r.estado === "confirmada");
+      if (!reservada) throw new ErrorDelClub("FRANJA_LIBRE", "Esa franja está libre: se puede reservar directamente");
+      if (reservada.socioId === socio.id) throw new ErrorDelClub("YA_RESERVADA", "Esa franja ya la tienes reservada");
+      if (colaDe(p.id, inicio as string).some((e) => e.socioId === socio.id)) {
+        throw new ErrorDelClub("YA_EN_ESPERA", "Ya estás en la lista de espera de esa franja");
+      }
+      if (estado.esperas.filter((e) => vigente(e) && e.socioId === socio.id).length >= MAXIMO_ESPERAS_ACTIVAS) {
+        throw new ErrorDelClub("LIMITE_DE_ESPERAS", `Cada socio puede tener como mucho ${MAXIMO_ESPERAS_ACTIVAS} esperas activas`);
+      }
+      const espera: Espera = {
+        id: `E-${String(estado.esperas.length + 1).padStart(4, "0")}`,
+        socioId: socio.id,
+        pistaId: p.id,
+        inicio: inicio as string,
+        estado: "activa",
+      };
+      estado.esperas.push(espera);
+      return { espera: conPosicion(espera) };
+    },
+
+    listarEsperas(quien: Socio | undefined, socioId?: string) {
+      const socio = exigirIdentificado(quien);
+      if (socioId !== undefined && socioId !== socio.id) {
+        exigirGestor(socio);
+        if (!estado.socios.some((s) => s.id === socioId)) throw new ErrorDelClub("SOCIO_NO_ENCONTRADO", `No existe el socio ${socioId}`, 404);
+      }
+      const de = socioId ?? socio.id;
+      const esperas = estado.esperas
+        .filter((e) => vigente(e) && e.socioId === de)
+        .sort((a, b) => (a.inicio === b.inicio ? a.pistaId.localeCompare(b.pistaId) : a.inicio.localeCompare(b.inicio)));
+      return { esperas: esperas.map(conPosicion) };
+    },
+
+    retirarEspera(quien: Socio | undefined, id: string) {
+      const socio = exigirIdentificado(quien);
+      const espera = estado.esperas.find((e) => e.id === id);
+      if (!espera) throw new ErrorDelClub("ESPERA_NO_ENCONTRADA", `No existe la espera ${id}`, 404);
+      if (espera.socioId !== socio.id && socio.rol !== "gestor") {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo su dueño o un gestor pueden retirar esta espera", 403);
+      }
+      if (!vigente(espera)) throw new ErrorDelClub("ESPERA_NO_ACTIVA", "La espera ya no está activa");
+      espera.estado = "retirada";
+      return { espera: conPosicion(espera) };
     },
   };
 }
