+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+const gestor = "socio-040";
+const cabecera = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+const ruta = "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-31";
+before(async () => { api = await arrancarApi(); });
+after(() => api.cerrar());
+
+test("exportar exige identificación y rol de gestor", async () => {
+  for (const [socio, status, codigo] of [
+    [undefined, 401, "NO_IDENTIFICADO"],
+    ["socio-002", 403, "SIN_PERMISO"],
+    ["socio-999", 401, "NO_IDENTIFICADO"],
+  ] as const) {
+    const respuesta = await api.pedir("GET", ruta, { socio });
+    assert.equal(respuesta.status, status);
+    assert.equal(respuesta.cuerpo.error.codigo, codigo);
+  }
+});
+
+test("CSV incluye todo el periodo, columnas exactas, relaciones, orden y CRLF", async () => {
+  const antes = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=1");
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const respuesta = await api.pedir("GET", ruta, { socio: gestor });
+  assert.equal(respuesta.status, 200);
+  assert.equal(respuesta.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(respuesta.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-10-31.csv"');
+  assert.ok(respuesta.texto.endsWith("\r\n"));
+  assert.ok(!respuesta.texto.replaceAll("\r\n", "").includes("\n"));
+  const lineas = respuesta.texto.split("\r\n");
+  assert.equal(lineas.shift(), cabecera);
+  assert.equal(lineas.pop(), "");
+  const esperadas = estado.reservas.filter((r: any) => r.inicio >= "2026-10-01" && r.inicio < "2026-11-01")
+    .sort((a: any, b: any) => a.inicio.localeCompare(b.inicio) || a.pistaId.localeCompare(b.pistaId));
+  assert.equal(lineas.length, 315, "no se aplica el límite de 100 del listado JSON");
+  assert.equal(esperadas[0].inicio.slice(0, 10), "2026-10-01");
+  assert.equal(esperadas.at(-1).inicio.slice(0, 10), "2026-10-31");
+  for (const [i, r] of esperadas.entries()) {
+    const socio = estado.socios.find((s: any) => s.id === r.socioId);
+    const pista = estado.pistas.find((p: any) => p.id === r.pistaId);
+    assert.deepEqual(lineas[i].split(","), [r.id, r.inicio.slice(0, 10), r.inicio.slice(11), pista.nombre,
+      socio.nombre, socio.email, r.estado, (r.importe / 100).toFixed(2), "", r.notas]);
+  }
+  const despues = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=1");
+  assert.equal(despues.texto, antes.texto, "el listado mantiene formato, filtros y paginación");
+});
+
+test("CSV filtra cada estado y devuelve solo la cabecera en periodos vacíos", async () => {
+  for (const estado of ["confirmada", "cancelada", "no_presentada"]) {
+    const respuesta = await api.pedir("GET", `${ruta}&estado=${estado}`, { socio: gestor });
+    const filas = respuesta.texto.trimEnd().split("\r\n").slice(1);
+    assert.ok(filas.length > 0);
+    assert.ok(filas.every((fila: string) => fila.split(",")[6] === estado));
+  }
+  const vacio = await api.pedir("GET", "/api/reservas/exportar?desde=2026-01-01&hasta=2026-01-01", { socio: gestor });
+  assert.equal(vacio.texto, `${cabecera}\r\n`);
+});
+
+test("exportar valida fechas, orden, duración inclusiva y estado", async () => {
+  for (const parametros of ["", "desde=2026-10-01", "hasta=2026-10-31", "desde=01-10-2026&hasta=2026-10-31",
+    "desde=2026-10-02&hasta=2026-10-01", "desde=2026-02-30&hasta=2026-03-01",
+    "desde=2026-13-01&hasta=2026-13-02", "desde=2026-10-01&hasta=2026-10-31&estado=otro",
+    "desde=2026-10-01&hasta=2026-10-31&estado="]) {
+    const respuesta = await api.pedir("GET", `/api/reservas/exportar?${parametros}`, { socio: gestor });
+    assert.equal(respuesta.status, 400, parametros);
+    assert.equal(respuesta.cuerpo.error.codigo, "DATOS_INVALIDOS", parametros);
+  }
+  const valido = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2026-12-31", { socio: gestor });
+  assert.equal(valido.status, 200, "92 días incluidos");
+  const largo = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2027-01-01", { socio: gestor });
+  assert.equal(largo.status, 400);
+  assert.equal(largo.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+});
+
+test("CSV escapa comas, comillas y saltos y exporta la penalización en euros", async () => {
+  const notas = 'Traer, "bolas"\ny palas\r\nextra';
+  const creada = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-11-19T19:30", notas },
+  });
+  assert.equal(creada.status, 201);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-19T10:00" } });
+  const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  const respuesta = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19&estado=cancelada", { socio: gestor });
+  assert.ok(respuesta.texto.includes(`${creada.cuerpo.reserva.id},2026-11-19,19:30,Pista 2,Nora Benítez,nora.benitez@example.com,cancelada,28.00,28.00,"Traer, ""bolas""\ny palas\r\nextra"\r\n`));
+});
