@@ -0,0 +1,135 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+const inicio = "2026-11-19T19:30";
+const pistaId = "pista-1";
+const esperar = (api: Api, socio = "socio-004", datos = { pistaId, inicio }) =>
+  api.pedir("POST", "/api/esperas", { socio, cuerpo: datos });
+const crear = (api: Api, socioId: string, inicio: string, pistaId = "pista-2") =>
+  api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+
+function error(r: { status: number; cuerpo: any }, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+test("esperas: identidad, validaciones de reserva, duplicados y límite", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const [metodo, ruta] of [["POST", "/api/esperas"], ["GET", "/api/esperas"], ["DELETE", "/api/esperas/E-0001"]]) {
+    error(await api.pedir(metodo!, ruta!, { cuerpo: metodo === "POST" ? { pistaId, inicio } : undefined }), 401, "NO_IDENTIFICADO");
+  }
+  error(await esperar(api, "socio-004", { pistaId: "no-existe", inicio }), 404, "PISTA_NO_ENCONTRADA");
+  error(await esperar(api, "socio-004", { pistaId: "pista-4", inicio }), 409, "PISTA_CERRADA");
