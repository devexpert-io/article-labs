diff --git a/test/codigos-descuento.test.ts b/test/codigos-descuento.test.ts
new file mode 100644
index 0000000..8ebcd99
--- /dev/null
+++ b/test/codigos-descuento.test.ts
@@ -0,0 +1,157 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+async function conApi(probar: (api: Api) => Promise<void>, ahora?: string) {
+  const api = await arrancarApi(ahora ? { AHORA: ahora } : {});
+  try { await probar(api); } finally { api.cerrar(); }
+}
+
+function reservar(api: Api, codigo?: unknown, inicio = "2026-11-24T10:30", otros = {}) {
+  return api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio, ...otros, ...(codigo === undefined ? {} : { codigo }) },
+  });
+}
+
+test("sin código guarda los importes y los devuelve al consultar y listar", async () => conApi(async (api) => {
+  const creada = await reservar(api);
+  assert.equal(creada.status, 201);
+  const r = creada.cuerpo.reserva;
+  assert.equal(r.importeBase, 1800);
+  assert.equal(r.descuento, 0);
+  assert.equal(r.importe, 1800);
+  assert.equal(Object.hasOwn(r, "codigo"), false);
+  assert.deepEqual((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva, r);
+  assert.deepEqual((await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.reservas, [r]);
+}));
+
+test("BIENVENIDA aplica el 50 % solo a la primera reserva incluso si se cancela", async () => conApi(async (api) => {
+  const creada = await reservar(api, " bienvenida ");
+  assert.equal(creada.status, 201);
+  assert.equal(creada.cuerpo.reserva.codigo, "BIENVENIDA");
+  assert.equal(creada.cuerpo.reserva.importeBase, 1800);
+  assert.equal(creada.cuerpo.reserva.descuento, 900);
+  assert.equal(creada.cuerpo.reserva.importe, 900);
+  await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+  const repetida = await reservar(api, "BIENVENIDA");
+  assert.equal(repetida.status, 409);
+  assert.equal(repetida.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  const historial = await reservar(api, "BIENVENIDA", "2026-11-24T12:00", { socioId: "socio-003" });
+  assert.equal(historial.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+}));
+
+test("BIENVENIDA usa la fecha del reloj del club, incluido el último día", async () => {
+  await conApi(async (api) => {
+    const creada = await reservar(api, "BIENVENIDA", "2027-01-04T10:30");
+    assert.equal(creada.status, 201);
+    assert.equal(creada.cuerpo.reserva.descuento, 900);
+  }, "2026-12-31T23:59");
+  await conApi(async (api) => {
+    const caducada = await reservar(api, "BIENVENIDA", "2027-01-04T10:30");
+    assert.equal(caducada.status, 409);
+    assert.equal(caducada.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }, "2027-01-01T00:00");
+});
+
+test("MANANAS descuenta 400 céntimos solo entre semana antes de las 12", async () => conApi(async (api) => {
+  for (const inicio of ["2026-11-25T12:00", "2026-11-25T18:00", "2026-11-28T10:30", "2026-11-29T09:00"]) {
+    const no = await reservar(api, "MANANAS", inicio);
+    assert.equal(no.status, 409);
+    assert.equal(no.cuerpo.error.codigo, "CODIGO_NO_APLICABLE", inicio);
+  }
+  for (const inicio of ["2026-11-24T09:00", "2026-11-24T10:30"]) {
+    const si = await reservar(api, "MANANAS", inicio);
+    assert.equal(si.status, 201);
+    assert.equal(si.cuerpo.reserva.descuento, 400);
+    assert.equal(si.cuerpo.reserva.importe, 1400);
+  }
+}));
+
+test("CLUB10 normaliza el código, limita los usos históricos y libera los cancelados", async () => conApi(async (api) => {
+  let primeraId = "";
+  for (const [i, dia] of [24, 25, 26].entries()) {
+    const creada = await reservar(api, "  club10 ", `2026-11-${dia}T10:30`);
+    assert.equal(creada.status, 201);
+    assert.equal(creada.cuerpo.reserva.codigo, "CLUB10");
+    assert.equal(creada.cuerpo.reserva.descuento, 180);
+    assert.equal(creada.cuerpo.reserva.importe, 1620);
+    if (i === 0) primeraId = creada.cuerpo.reserva.id;
+  }
+  // Una cancelada deja libre un uso, aunque antes hubiera tres reservas.
+  await api.pedir("POST", `/api/reservas/${primeraId}/cancelar`);
+  const reemplazo = await reservar(api, "CLUB10", "2026-11-27T10:30");
+  assert.equal(reemplazo.status, 201);
+  // Pasar las reservas no libera los usos del código ni activa el límite de futuras.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-28T10:00" } });
+  const agotado = await reservar(api, "CLUB10", "2026-11-30T10:30");
+  assert.equal(agotado.status, 409);
+  assert.equal(agotado.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+}));
+
+test("CLUB10 cuenta las no presentadas y BIENVENIDA cuenta cualquier estado anterior", () => {
+  const estado = crearSemilla();
+  const club = crearClub(estado);
+  for (const dia of [24, 25, 26]) {
+    const { reserva } = club.crearReserva({ socioId: "socio-041", pistaId: "pista-2", inicio: `2026-11-${dia}T10:30`, codigo: "CLUB10" });
+    reserva.estado = "no_presentada";
+  }
+  for (const codigo of ["CLUB10", "BIENVENIDA"]) {
+    assert.throws(() => club.crearReserva({ socioId: "socio-041", pistaId: "pista-2", inicio: "2026-11-27T10:30", codigo }), { codigo: "CODIGO_NO_APLICABLE" });
+  }
+});
+
+test("el formato acepta un único texto del catálogo", async () => conApi(async (api) => {
+  for (const codigo of ["", "OTRO", "CLUB10,MANANAS"]) {
+    const respuesta = await reservar(api, codigo);
+    assert.equal(respuesta.status, 400);
+    assert.equal(respuesta.cuerpo.error.codigo, "CODIGO_INVALIDO");
+  }
+  for (const codigo of [null, 10, false, ["CLUB10", "MANANAS"], { codigo: "CLUB10" }]) {
+    const respuesta = await reservar(api, codigo);
+    assert.equal(respuesta.status, 400);
+    assert.equal(respuesta.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+}));
+
+test("las reglas de reserva se validan antes del código y los fallos no consumen usos", async () => conApi(async (api) => {
+  const casos = [
+    { socioId: "socio-011", codigo: "CUOTA_INACTIVA" },
+    { pistaId: "pista-4", codigo: "PISTA_CERRADA" },
+    { pistaId: "no-existe", codigo: "PISTA_NO_ENCONTRADA" },
+    { inicio: "2026-11-24T10:00", codigo: "FRANJA_INVALIDA" },
+    { inicio: "2026-11-18T09:00", codigo: "FRANJA_PASADA" },
+    { pistaId: "pista-1", inicio: "2026-11-19T19:30", codigo: "FRANJA_NO_DISPONIBLE" },
+  ];
+  for (const { codigo, ...datos } of casos) {
+    const no = await reservar(api, "NO-EXISTE", undefined, datos);
+    assert.equal(no.cuerpo.error.codigo, codigo);
+  }
+  const primera = await reservar(api, "BIENVENIDA");
+  assert.equal(primera.status, 201);
+  for (const dia of [25, 26]) assert.equal((await reservar(api, undefined, `2026-11-${dia}T10:30`)).status, 201);
+  const limite = await reservar(api, "NO-EXISTE", "2026-11-27T10:30");
+  assert.equal(limite.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+}));
+
+test("la cancelación tardía cobra el importe descontado y disponibilidad conserva el precio base", async () => conApi(async (api) => {
+  const disponibilidad = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-19&pista=pista-2");
+  assert.equal(disponibilidad.cuerpo.pistas[0].franjas.find((f: any) => f.inicio.endsWith("09:00")).precio, 1800);
+  const creada = await reservar(api, "MANANAS", "2026-11-19T09:00");
+  assert.equal(creada.status, 201);
+  const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1400);
+  const despues = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-19&pista=pista-2");
+  assert.equal(despues.cuerpo.pistas[0].franjas.find((f: any) => f.inicio.endsWith("09:00")).precio, 1800);
+}));
+
+test("MANANAS no reduce el importe por debajo de cero", () => {
+  const estado = crearSemilla();
+  estado.pistas[1]!.precioValle = 250;
+  const r = crearClub(estado).crearReserva({ socioId: "socio-041", pistaId: "pista-2", inicio: "2026-11-24T10:30", codigo: "MANANAS" }).reserva;
+  assert.equal(r.importeBase, 250);
+  assert.equal(r.descuento, 250);
+  assert.equal(r.importe, 0);
+});
