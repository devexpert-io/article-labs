+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi } from "./ayuda.ts";
+
+test("cancelar con descuento asigna la espera a precio completo y exporta ambos importes", async () => {
+  const api = await arrancarApi();
+  try {
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-19T10:30", codigo: "BIENVENIDA" },
+    });
+    assert.equal(creada.status, 201);
+    const original = creada.cuerpo.reserva;
+    assert.equal(original.importe, 600);
+
+    const espera = await api.pedir("POST", "/api/esperas", {
+      socio: "socio-004", cuerpo: { pistaId: original.pistaId, inicio: original.inicio },
+    });
+    assert.equal(espera.status, 201);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-19T08:00" } });
+    const cancelada = await api.pedir("POST", `/api/reservas/${original.id}/cancelar`, {
+      cuerpo: { forzar: true },
+    });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 600);
+    assert.equal(typeof cancelada.cuerpo.asignadaA, "string");
+    const asignada = (await api.pedir("GET", `/api/reservas/${cancelada.cuerpo.asignadaA}`)).cuerpo.reserva;
+    assert.equal(asignada.socioId, "socio-004");
+    assert.equal(asignada.importeBase, 1200);
+    assert.equal(asignada.descuento, 0);
+    assert.equal(asignada.importe, 1200);
+    assert.equal(asignada.codigo, undefined);
+    assert.equal(asignada.notas, "Asignada desde la lista de espera");
+    assert.deepEqual((await api.pedir("GET", "/api/esperas", { socio: "socio-004" })).cuerpo.esperas, []);
+
+    const csv = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19", {
+      socio: "socio-040",
+    });
+    assert.equal(csv.status, 200);
+    const filas = csv.texto.split("\r\n");
+    assert.equal(filas.find((fila) => fila.startsWith(`${original.id},`))?.split(",").slice(6, 9).join(","), "cancelada,6.00,6.00");
+    assert.equal(filas.find((fila) => fila.startsWith(`${asignada.id},`))?.split(",").slice(6).join(","), "confirmada,12.00,,Asignada desde la lista de espera");
+  } finally {
+    api.cerrar();
+  }
+});
