+async function reservar(a: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await a.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+}
+
+async function esperar(a: Api, socio: string | undefined, pistaId: string, inicio: string) {
+  return a.pedir("POST", "/api/esperas", { cuerpo: { pistaId, inicio }, socio });
+}
+
+test("1. apuntarse a una franja ocupada responde 201 con la espera activa y su posición", async () => {
+  await reservar(api, "socio-006", "pista-2", "2026-11-25T18:00");
+  const r = await esperar(api, "socio-026", "pista-2", "2026-11-25T18:00");
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.espera.socioId, "socio-026");
+  assert.equal(r.cuerpo.espera.pistaId, "pista-2");
+  assert.equal(r.cuerpo.espera.inicio, "2026-11-25T18:00");
+  assert.equal(r.cuerpo.espera.estado, "activa");
+  assert.equal(r.cuerpo.espera.posicion, 1);
+  assert.ok(r.cuerpo.espera.id);
+
+  const anonimo = await esperar(api, undefined, "pista-2", "2026-11-25T18:00");
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  assert.equal((await api.pedir("GET", "/api/esperas")).cuerpo.error.codigo, "NO_IDENTIFICADO");
