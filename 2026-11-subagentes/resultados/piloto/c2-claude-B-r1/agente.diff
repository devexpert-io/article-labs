+      if (de !== socio.id) {
+        if (socio.rol !== "gestor") throw new ErrorDelClub("SIN_PERMISO", "Solo un gestor puede ver las esperas de otro socio", 403);
+        if (!estado.socios.some((s) => s.id === de)) throw new ErrorDelClub("SOCIO_NO_ENCONTRADO", `No existe el socio ${de}`, 404);
+      }
+      return { esperas: estado.esperas.filter((e) => e.socioId === de && esperaVigente(e)).map(conPosicion) };
+    },
+
+    retirarEspera(quien: Socio | undefined, id: string) {
+      const socio = identificado(quien);
+      const e = estado.esperas.find((x) => x.id === id);
+      if (!e) throw new ErrorDelClub("ESPERA_NO_ENCONTRADA", `No existe la espera ${id}`, 404);
+      if (e.socioId !== socio.id && socio.rol !== "gestor") {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo su dueño o un gestor puede retirar esta espera", 403);
+      }
+      if (!esperaVigente(e)) throw new ErrorDelClub("ESPERA_NO_ACTIVA", "Esa espera ya no está activa");
+      e.estado = "retirada";
+      return { espera: conPosicion(e) };
     },
   };
 }
