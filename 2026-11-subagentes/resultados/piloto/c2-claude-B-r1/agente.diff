@@ -0,0 +1,204 @@
+// Códigos de descuento al reservar (docs/specs/codigos-descuento.md), probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearClub, ErrorDelClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+// En la semilla: Nora Benítez (socio-041) no tiene ninguna reserva; Marta López (socio-002) tiene historial y una
+// reserva futura; socio-011 no tiene la cuota al día; la pista 4 está cerrada.
+// Pista 1: 1800 valle / 2800 punta. Pista 3: 1200 valle. El 2026-11-25 es miércoles y el 2026-11-28, sábado.
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function reservar(api: Api, socioId: string, pistaId: string, inicio: string, codigo?: unknown) {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio, ...(codigo !== undefined ? { codigo } : {}) } });
+}
+
+test("sin código, la reserva se crea como antes, con importeBase igual a importe y descuento 0", () =>
+  conApi(async (api) => {
+    const r = await reservar(api, "socio-002", "pista-1", "2026-11-25T18:00");
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.importeBase, 2800);
+    assert.equal(r.cuerpo.reserva.importe, 2800);
+    assert.equal(r.cuerpo.reserva.descuento, 0);
+    assert.equal("codigo" in r.cuerpo.reserva, false);
+  }));
+
+test("BIENVENIDA descuenta el 50 % solo en la primera reserva del socio", () =>
+  conApi(async (api) => {
+    const r = await reservar(api, "socio-041", "pista-1", "2026-11-28T10:30", "BIENVENIDA");
+    assert.equal(r.status, 201);
+    assert.deepEqual(
+      { importeBase: r.cuerpo.reserva.importeBase, descuento: r.cuerpo.reserva.descuento, importe: r.cuerpo.reserva.importe, codigo: r.cuerpo.reserva.codigo },
+      { importeBase: 2800, descuento: 1400, importe: 1400, codigo: "BIENVENIDA" },
+    );
+    const segunda = await reservar(api, "socio-041", "pista-1", "2026-11-28T12:00", "BIENVENIDA");
+    assert.equal(segunda.status, 409);
+    assert.equal(segunda.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+    const conHistorial = await reservar(api, "socio-002", "pista-1", "2026-11-28T13:30", "BIENVENIDA");
+    assert.equal(conHistorial.status, 409);
+    assert.equal(conHistorial.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }));
+
+test("BIENVENIDA tampoco vale si el socio solo tiene reservas canceladas", () =>
+  conApi(async (api) => {
+    const r = await reservar(api, "socio-041", "pista-1", "2026-11-28T10:30");
+    assert.equal(r.status, 201);
+    const cancelada = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`, { cuerpo: {} });
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    const otra = await reservar(api, "socio-041", "pista-1", "2026-11-28T12:00", "BIENVENIDA");
+    assert.equal(otra.status, 409);
+    assert.equal(otra.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }));
+
+test("BIENVENIDA vale el 31 de diciembre de 2026", () =>
+  conApi(async (api) => {
+    const r = await reservar(api, "socio-041", "pista-1", "2027-01-02T10:30", "BIENVENIDA");
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.descuento, 1400);
+  }, { AHORA: "2026-12-31T23:59" }));
+
+test("BIENVENIDA caduca después del 31 de diciembre de 2026", () =>
+  conApi(async (api) => {
+    const r = await reservar(api, "socio-041", "pista-1", "2027-01-02T10:30", "BIENVENIDA");
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }, { AHORA: "2027-01-01T00:00" }));
+
+test("MANANAS descuenta 4,00 € solo de lunes a viernes antes de las 12:00", () =>
+  conApi(async (api) => {
+    const miercoles = await reservar(api, "socio-002", "pista-3", "2026-11-25T10:30", "MANANAS");
+    assert.equal(miercoles.status, 201);
+    assert.equal(miercoles.cuerpo.reserva.importeBase, 1200);
+    assert.equal(miercoles.cuerpo.reserva.descuento, 400);
+    assert.equal(miercoles.cuerpo.reserva.importe, 800);
+    assert.equal(miercoles.cuerpo.reserva.codigo, "MANANAS");
+    const mediodia = await reservar(api, "socio-002", "pista-3", "2026-11-25T12:00", "MANANAS");
+    assert.equal(mediodia.status, 409);
+    assert.equal(mediodia.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+    const sabado = await reservar(api, "socio-002", "pista-3", "2026-11-28T09:00", "MANANAS");
+    assert.equal(sabado.status, 409);
+    assert.equal(sabado.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+    const lunes = await reservar(api, "socio-002", "pista-1", "2026-11-30T09:00", "MANANAS");
+    assert.equal(lunes.status, 201);
+    assert.equal(lunes.cuerpo.reserva.importe, 1400);
+  }));
+
+test("CLUB10 descuenta el 10 % hasta 3 reservas por socio, sin contar las canceladas", () =>
+  conApi(async (api) => {
+    const primera = await reservar(api, "socio-041", "pista-1", "2026-11-25T09:00", "CLUB10");
+    assert.equal(primera.status, 201);
+    assert.deepEqual([primera.cuerpo.reserva.importeBase, primera.cuerpo.reserva.descuento, primera.cuerpo.reserva.importe], [1800, 180, 1620]);
+    const segunda = await reservar(api, "socio-041", "pista-1", "2026-11-25T10:30", "CLUB10");
+    assert.equal(segunda.status, 201);
+    await api.pedir("POST", `/api/reservas/${segunda.cuerpo.reserva.id}/cancelar`, { cuerpo: {} });
+    assert.equal((await reservar(api, "socio-041", "pista-1", "2026-11-25T12:00", "CLUB10")).status, 201);
+    assert.equal((await reservar(api, "socio-041", "pista-1", "2026-11-25T13:30", "CLUB10")).status, 201);
+    // Ya ha jugado esas tres: no son futuras, pero siguen contando como usos de CLUB10.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T10:00" } });
+    const cuarta = await reservar(api, "socio-041", "pista-1", "2026-11-27T09:00", "CLUB10");
+    assert.equal(cuarta.status, 409);
+    assert.equal(cuarta.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+    const sinCodigo = await reservar(api, "socio-041", "pista-1", "2026-11-27T09:00");
+    assert.equal(sinCodigo.status, 201);
+  }));
+
+test("CLUB10 cuenta las reservas no presentadas", () => {
+  const estado = crearSemilla();
+  const club = crearClub(estado);
+  for (const inicio of ["2026-11-25T09:00", "2026-11-25T10:30", "2026-11-25T12:00"]) {
+    club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio, codigo: "CLUB10" });
+  }
+  estado.ahora = "2026-11-26T10:00";
+  for (const r of estado.reservas.filter((r) => r.socioId === "socio-041")) r.estado = "no_presentada";
+  assert.throws(
+    () => club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-27T09:00", codigo: "CLUB10" }),
+    (e: unknown) => e instanceof ErrorDelClub && e.codigo === "CODIGO_NO_APLICABLE" && e.http === 409,
+  );
+});
+
+test("el código no distingue mayúsculas ni espacios alrededor, y se valida su formato", () =>
+  conApi(async (api) => {
+    const r = await reservar(api, "socio-041", "pista-1", "2026-11-25T18:00", "  club10 ");
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.codigo, "CLUB10");
+    assert.equal(r.cuerpo.reserva.importe, 2520);
+    const desconocido = await reservar(api, "socio-041", "pista-1", "2026-11-25T19:30", "VERANO");
+    assert.equal(desconocido.status, 400);
+    assert.equal(desconocido.cuerpo.error.codigo, "CODIGO_INVALIDO");
+    const numero = await reservar(api, "socio-041", "pista-1", "2026-11-25T19:30", 10);
+    assert.equal(numero.status, 400);
+    assert.equal(numero.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }));
+
+test("solo se acepta un código por reserva y los descuentos no se acumulan", () =>
+  conApi(async (api) => {
+    const lista = await reservar(api, "socio-041", "pista-1", "2026-11-25T09:00", ["MANANAS", "CLUB10"]);
+    assert.equal(lista.status, 400);
+    assert.equal(lista.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const juntos = await reservar(api, "socio-041", "pista-1", "2026-11-25T09:00", "MANANAS CLUB10");
+    assert.equal(juntos.status, 400);
+    assert.equal(juntos.cuerpo.error.codigo, "CODIGO_INVALIDO");
+    const uno = await reservar(api, "socio-041", "pista-1", "2026-11-25T09:00", "MANANAS");
+    assert.equal(uno.cuerpo.reserva.descuento, 400);
+  }));
+
+test("GET de una reserva y la lista devuelven los importes y el código", () =>
+  conApi(async (api) => {
+    const creada = (await reservar(api, "socio-041", "pista-3", "2026-11-25T09:00", "mananas")).cuerpo.reserva;
+    const esperado = { importeBase: 1200, descuento: 400, importe: 800, codigo: "MANANAS" };
+    const una = (await api.pedir("GET", `/api/reservas/${creada.id}`)).cuerpo.reserva;
+    assert.deepEqual({ importeBase: una.importeBase, descuento: una.descuento, importe: una.importe, codigo: una.codigo }, esperado);
+    const lista = (await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.reservas;
+    assert.equal(lista.length, 1);
+    assert.deepEqual({ importeBase: lista[0].importeBase, descuento: lista[0].descuento, importe: lista[0].importe, codigo: lista[0].codigo }, esperado);
+  }));
+
+test("las reglas del club van primero y el código no cuenta como usado", () =>
+  conApi(async (api) => {
+    const cerrada = await reservar(api, "socio-041", "pista-4", "2026-11-25T18:00", "BIENVENIDA");
+    assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+    const pasada = await reservar(api, "socio-041", "pista-1", "2026-11-18T09:00", "BIENVENIDA");
+    assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+    const cuota = await reservar(api, "socio-011", "pista-1", "2026-11-25T18:00", "NOEXISTE");
+    assert.equal(cuota.cuerpo.error.codigo, "CUOTA_INACTIVA");
+    const franja = await reservar(api, "socio-041", "pista-1", "2026-11-25T10:00", "MANANAS");
+    assert.equal(franja.cuerpo.error.codigo, "FRANJA_INVALIDA");
+    // Luis Martín (socio-005) tiene dos reservas futuras: con una más llega al límite.
+    assert.equal((await reservar(api, "socio-005", "pista-2", "2026-11-25T18:00")).status, 201);
+    const limite = await reservar(api, "socio-005", "pista-2", "2026-11-25T19:30", "CLUB10");
+    assert.equal(limite.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+    // Nora sigue pudiendo usar BIENVENIDA porque los intentos fallidos no crearon ninguna reserva.
+    const bienvenida = await reservar(api, "socio-041", "pista-1", "2026-11-25T18:00", "BIENVENIDA");
+    assert.equal(bienvenida.status, 201);
+    assert.equal(bienvenida.cuerpo.reserva.descuento, 1400);
+  }));
+
+test("la penalización por cancelar fuera de plazo es el importe con descuento", () =>
+  conApi(async (api) => {
+    const r = (await reservar(api, "socio-041", "pista-1", "2026-11-25T18:00", "BIENVENIDA")).cuerpo.reserva;
+    assert.equal(r.importe, 1400);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T10:00" } });
