@@ -0,0 +1,218 @@
+// Penalizaciones escalonadas, exención por un gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const reloj = (ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+
+/** Crea una reserva con el reloj por defecto y deja el reloj en `ahora`. */
+async function reservaA(socioId: string, pistaId: string, inicio: string, ahora: string) {
+  await reloj("2026-11-18T10:00");
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(creada.status, 201, creada.texto);
+  await reloj(ahora);
+  return creada.cuerpo.reserva as { id: string; importe: number };
+}
+
+const cancelar = (id: string, cuerpo?: unknown, socio?: string) =>
+  api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+
+test("tramos: 48 h o más, gratis; entre 24 y 48 h, 25 %; menos de 24 h, 50 % y solo con forzar", async () => {
+  // Pista 2 un martes a las 12:00: valle, 1800 céntimos.
+  const sinPenalizacion = await reservaA("socio-020", "pista-2", "2026-12-01T12:00", "2026-11-28T12:00");
+  const gratis = await cancelar(sinPenalizacion.id);
+  assert.equal(gratis.status, 200);
+  assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.cuerpo.reembolso, 1800);
+
+  const tardia = await reservaA("socio-020", "pista-2", "2026-12-01T13:30", "2026-11-30T10:00");
+  const r25 = await cancelar(tardia.id);
+  assert.equal(r25.status, 200);
+  assert.equal(r25.cuerpo.reserva.penalizacion, 450);
+  assert.equal(r25.cuerpo.reembolso, 1350);
+
+  const urgente = await reservaA("socio-020", "pista-2", "2026-12-01T15:00", "2026-12-01T10:00");
+  const sinForzar = await cancelar(urgente.id);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const r50 = await cancelar(urgente.id, { forzar: true });
+  assert.equal(r50.status, 200);
+  assert.equal(r50.cuerpo.reserva.penalizacion, 900);
+  assert.equal(r50.cuerpo.reembolso, 900);
+  assert.equal(r50.cuerpo.reserva.estado, "cancelada");
+});
+
+test("límites exactos: a 48 h justas no hay penalización; a 24 h justas, 25 % sin forzar", async () => {
+  const a48 = await reservaA("socio-021", "pista-3", "2026-12-02T12:00", "2026-11-30T12:00");
+  const gratis = await cancelar(a48.id);
+  assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.cuerpo.reembolso, 1200);
+
+  const a24 = await reservaA("socio-021", "pista-3", "2026-12-02T13:30", "2026-12-01T13:30");
+  const r25 = await cancelar(a24.id);
+  assert.equal(r25.status, 200);
+  assert.equal(r25.cuerpo.reserva.penalizacion, 300);
+  assert.equal(r25.cuerpo.reembolso, 900);
+
+  // Un minuto menos de 24 h ya necesita forzar.
+  const casi = await reservaA("socio-021", "pista-3", "2026-12-02T15:00", "2026-12-01T15:01");
+  assert.equal((await cancelar(casi.id)).cuerpo.error.codigo, "FUERA_DE_PLAZO");
+});
+
+test("cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales.
+  const primavera = await reservaA("socio-025", "pista-3", "2027-03-28T21:00", "2027-03-26T20:30");
+  const r25 = await cancelar(primavera.id);
+  assert.equal(r25.status, 200);
+  assert.equal(r25.cuerpo.reserva.penalizacion, 500, "47,5 horas: tramo del 25 % (punta, 2000)");
+  assert.equal(r25.cuerpo.reembolso, 1500);
+
+  // En otoño los relojes se atrasan: del viernes 29 de octubre de 2027 a las 21:30 al domingo 31 a las 21:00
+  // hay 48,5 horas reales, no 47,5.
+  const otono = await reservaA("socio-025", "pista-3", "2027-10-31T21:00", "2027-10-29T21:30");
+  const gratis = await cancelar(otono.id);
+  assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.cuerpo.reembolso, 2000);
+});
+
+test("exención: un gestor cancela sin penalización con un motivo, sin forzar", async () => {
+  const r = await reservaA("socio-023", "pista-1", "2026-12-03T12:00", "2026-12-03T11:00");
+  const motivo = "Lesión justificada con parte médico";
+
+  const anonimo = await cancelar(r.id, { exento: true, motivo });
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await cancelar(r.id, { exento: true, motivo }, "socio-023");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const sinMotivo = await cancelar(r.id, { exento: true }, GESTOR);
+  assert.equal(sinMotivo.status, 400);
+  assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const corto = await cancelar(r.id, { exento: true, motivo: "123456789" }, GESTOR);
+  assert.equal(corto.status, 400);
+  assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva.estado, "confirmada");
+
+  const exenta = await cancelar(r.id, { exento: true, motivo }, GESTOR);
+  assert.equal(exenta.status, 200);
+  assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+  assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(exenta.cuerpo.reserva.motivoCancelacion, motivo);
+  assert.equal(exenta.cuerpo.reembolso, r.importe);
+
+  const diez = await reservaA("socio-023", "pista-1", "2026-12-03T13:30", "2026-12-02T20:00");
+  const justo = await cancelar(diez.id, { exento: true, motivo: "1234567890" }, GESTOR);
+  assert.equal(justo.status, 200);
+  assert.equal(justo.cuerpo.reembolso, diez.importe);
+});
+
+test("reservas pasadas: no se cancelan, tampoco con exento", async () => {
+  const r = await reservaA("socio-024", "pista-1", "2026-12-04T12:00", "2026-12-04T12:00");
+  const normal = await cancelar(r.id, { forzar: true });
+  assert.equal(normal.status, 409);
+  assert.equal(normal.cuerpo.error.codigo, "RESERVA_PASADA");
+  const exenta = await cancelar(r.id, { exento: true, motivo: "Lluvia torrencial en la pista" }, GESTOR);
+  assert.equal(exenta.status, 409);
+  assert.equal(exenta.cuerpo.error.codigo, "RESERVA_PASADA");
+});
+
+test("informe de caja: solo gestores y mes con formato AAAA-MM", async () => {
+  await reloj("2026-11-18T10:00");
