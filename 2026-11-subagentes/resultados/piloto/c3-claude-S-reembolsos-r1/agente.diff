+    const b = (await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-030", pistaId: "pista-1", inicio: "2027-01-04T18:00" } })).cuerpo.reserva;
+    await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-031", pistaId: "pista-3", inicio: "2027-01-04T12:00" } });
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-04T10:00" } });
+    assert.equal((await otra.pedir("POST", `/api/reservas/${a.id}/cancelar`, { cuerpo: { forzar: true } })).cuerpo.reembolso, 900);
+    assert.equal((await otra.pedir("POST", `/api/reservas/${b.id}/cancelar`, { cuerpo: { exento: true, motivo: "Avería en la iluminación" }, socio: GESTOR })).cuerpo.reembolso, 2800);
+    const informe = (await otra.pedir("GET", "/api/informes/caja?mes=2027-01", { socio: GESTOR })).cuerpo;
+    assert.deepEqual(informe.pistas, [
+      { pistaId: "pista-1", reservas: 0, ingresos: 0, penalizaciones: 900, total: 900 },
+      { pistaId: "pista-2", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+      { pistaId: "pista-3", reservas: 1, ingresos: 1200, penalizaciones: 0, total: 1200 },
+      { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    ]);
+    assert.deepEqual(informe.total, { reservas: 1, ingresos: 1200, penalizaciones: 900, total: 2100 });
+  } finally {
+    otra.cerrar();
+  }
