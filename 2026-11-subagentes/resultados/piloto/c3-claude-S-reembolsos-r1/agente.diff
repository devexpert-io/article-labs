+test("informe de caja: suma por pista las reservas, los ingresos y las penalizaciones del mes", async () => {
+  await reloj("2026-11-18T10:00");
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const mes = "2026-10";
+  const delMes = estado.reservas.filter((r: any) => r.inicio.startsWith(mes));
+  const esperado = (filtro: (r: any) => boolean) => {
+    const rs = delMes.filter(filtro);
+    const cobradas = rs.filter((r: any) => r.estado !== "cancelada");
+    const ingresos = cobradas.reduce((s: number, r: any) => s + r.importe, 0);
+    const penalizaciones = rs.filter((r: any) => r.estado === "cancelada").reduce((s: number, r: any) => s + (r.penalizacion ?? 0), 0);
+    return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+  };
+  const informe = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: GESTOR });
+  assert.equal(informe.status, 200);
+  assert.equal(informe.cuerpo.mes, mes);
+  assert.deepEqual(informe.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+  for (const fila of informe.cuerpo.pistas) {
+    const { pistaId, ...resto } = fila;
+    assert.deepEqual(resto, esperado((r) => r.pistaId === pistaId), pistaId);
+  }
+  assert.deepEqual(informe.cuerpo.total, esperado(() => true));
+  assert.ok(informe.cuerpo.total.reservas > 0);
+
+  // Un mes sin movimientos trae todas las pistas a cero.
+  const vacio = await api.pedir("GET", "/api/informes/caja?mes=2025-01", { socio: GESTOR });
+  const cero = { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 };
+  assert.equal(vacio.cuerpo.pistas.length, 4);
+  for (const fila of vacio.cuerpo.pistas) assert.deepEqual({ ...fila, pistaId: undefined }, { ...cero, pistaId: undefined });
+  assert.deepEqual(vacio.cuerpo.total, cero);
+});
+
