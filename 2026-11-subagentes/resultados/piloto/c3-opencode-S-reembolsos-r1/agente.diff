+/** Desfase de la zona (Europe/Madrid) en milisegundos para un instante UTC concreto. */
+function desfaseMadrid(instante: number): number {
+  const partes = new Intl.DateTimeFormat("en-US", { timeZone: ZONA, timeZoneName: "longOffset" }).formatToParts(new Date(instante));
+  const nombre = partes.find((p) => p.type === "timeZoneName")?.value ?? "GMT";
+  const encontrado = /GMT([+-])(\d{2}):(\d{2})/.exec(nombre);
+  if (!encontrado) return 0;
+  const signo = encontrado[1] === "-" ? -1 : 1;
+  return signo * (Number(encontrado[2]) * 60 + Number(encontrado[3])) * 60_000;
+}
+
+/** Convierte una fecha-hora local del club (Europe/Madrid) a un instante UTC real, contando el cambio de hora. */
+function enMadrid(fechaHora: string): number {
+  const objetivo = Date.parse(`${fechaHora}:00Z`);
+  let instante = objetivo;
+  for (let i = 0; i < 3; i++) instante = objetivo - desfaseMadrid(instante);
+  return instante;
+}
