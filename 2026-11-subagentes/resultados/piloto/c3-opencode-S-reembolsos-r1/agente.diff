+++ b/test/reembolsos.test.ts
@@ -0,0 +1,224 @@
+// La política de cancelación escalonada, la exención y el informe de caja, probadas por la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-001";
+
+/** Arranca una API propia, ejecuta el cuerpo y la cierra. Aísla el estado entre pruebas. */
+async function conApi(cuerpo: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await cuerpo(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+/** Fija el reloj y crea una reserva. Devuelve la reserva creada (id e importe). */
+async function crear(api: Api, ahora: string, inicio: string, pista = "pista-1", socio = SOCIO) {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: socio, pistaId: pista, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva as { id: string; importe: number };
+}
+
+test("tramos: con 48h o más no hay penalización", async () => {
+  await conApi(async (api) => {
+    const r = await crear(api, "2026-12-01T12:00", "2026-12-04T12:00");
+    const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada.cuerpo.reembolso, r.importe);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+  });
+});
+
+test("tramos: entre 24 y 48 horas se penaliza el 25 %", async () => {
+  await conApi(async (api) => {
+    const r = await crear(api, "2026-12-01T10:00", "2026-12-02T12:00"); // 26 horas
+    const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    const esperada = Math.round(r.importe * 0.25);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, esperada);
+    assert.equal(cancelada.cuerpo.reembolso, r.importe - esperada);
+  });
+});
+
+test("tramos: con menos de 24 horas solo se cancela con forzar y se penaliza el 50 %", async () => {
+  await conApi(async (api) => {
+    const r = await crear(api, "2026-12-01T10:00", "2026-12-01T16:30"); // 6,5 horas
+    const sinForzar = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    const esperada = Math.round(r.importe * 0.5);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, esperada);
+    assert.equal(forzada.cuerpo.reembolso, r.importe - esperada);
+  });
+});
+
+test("límites exactos: 48 horas justas sin penalización y 24 horas justas con el 25 %", async () => {
+  await conApi(async (api) => {
+    const en48 = await crear(api, "2026-12-01T12:00", "2026-12-03T12:00");
+    const a48 = await api.pedir("POST", `/api/reservas/${en48.id}/cancelar`);
+    assert.equal(a48.status, 200);
+    assert.equal(a48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(a48.cuerpo.reembolso, en48.importe);
+
+    const en24 = await crear(api, "2026-12-01T12:00", "2026-12-02T12:00");
+    const a24 = await api.pedir("POST", `/api/reservas/${en24.id}/cancelar`);
+    assert.equal(a24.status, 200);
+    assert.equal(a24.cuerpo.reserva.penalizacion, Math.round(en24.importe * 0.25));
+  });
+});
+
+test("cambio de hora: la antelación son horas reales de Madrid", async () => {
+  await conApi(async (api) => {
+    // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales, no 48,5.
+    const r = await crear(api, "2027-03-26T20:30", "2027-03-28T21:00");
+    const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, Math.round(r.importe * 0.25));
+  });
+});
+
+test("exención: un gestor puede eximir con un motivo de 10+ caracteres", async () => {
+  await conApi(async (api) => {
+    const r = await crear(api, "2026-12-01T10:00", "2026-12-01T16:30"); // menos de 24h, sin forzar
+    const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, {
+      socio: GESTOR,
+      cuerpo: { exento: true, motivo: "Avalado por la dirección del club" },
+    });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada.cuerpo.reembolso, r.importe);
+    assert.equal(cancelada.cuerpo.reserva.motivoCancelacion, "Avalado por la dirección del club");
+  });
+});
+
+test("exención: sin motivo o con motivo corto devuelve 400 DATOS_INVALIDOS", async () => {
+  await conApi(async (api) => {
+    const sinMotivo = await crear(api, "2026-12-01T10:00", "2026-12-01T18:00");
+    const a = await api.pedir("POST", `/api/reservas/${sinMotivo.id}/cancelar`, { socio: GESTOR, cuerpo: { exento: true } });
+    assert.equal(a.status, 400);
+    assert.equal(a.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const corto = await crear(api, "2026-12-01T10:00", "2026-12-01T19:30");
+    const b = await api.pedir("POST", `/api/reservas/${corto.id}/cancelar`, { socio: GESTOR, cuerpo: { exento: true, motivo: "corto" } });
+    assert.equal(b.status, 400);
+    assert.equal(b.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  });
+});
+
+test("exención: sin permiso de gestor ni identidad no se puede eximir", async () => {
+  await conApi(async (api) => {
+    const noGestor = await crear(api, "2026-12-01T10:00", "2026-12-01T21:00");
+    const a = await api.pedir("POST", `/api/reservas/${noGestor.id}/cancelar`, {
+      socio: SOCIO,
+      cuerpo: { exento: true, motivo: "Motivo suficientemente largo" },
+    });
+    assert.equal(a.status, 403);
+    assert.equal(a.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const sinIdentidad = await crear(api, "2026-12-01T10:00", "2026-12-02T09:00");
+    const b = await api.pedir("POST", `/api/reservas/${sinIdentidad.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "Motivo suficientemente largo" },
+    });
+    assert.equal(b.status, 401);
+    assert.equal(b.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  });
