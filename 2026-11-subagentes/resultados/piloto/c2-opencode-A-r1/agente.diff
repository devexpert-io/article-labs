+// Códigos de descuento al reservar, probados a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+/** Ejecuta una prueba con una API aislada y recién arrancada. */
+async function conApi(fn: (api: Api) => Promise<void>): Promise<void> {
+  const a = await arrancarApi();
+  try {
+    await fn(a);
+  } finally {
+    a.cerrar();
+  }
+}
+
+test("sin código, la reserva queda como antes", async () => {
+  await conApi(async (api) => {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T10:30" } });
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.importeBase, 1800);
+    assert.equal(r.cuerpo.reserva.descuento, 0);
+    assert.equal(r.cuerpo.reserva.importe, 1800);
+    assert.equal(r.cuerpo.reserva.codigo, undefined);
+  });
+});
+
+test("BIENVENIDA descuenta el 50 % solo en la primera reserva", async () => {
+  await conApi(async (api) => {
+    const nora = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T10:30", codigo: "BIENVENIDA" } });
+    assert.equal(nora.status, 201);
+    assert.equal(nora.cuerpo.reserva.importeBase, 1800);
+    assert.equal(nora.cuerpo.reserva.descuento, 900);
+    assert.equal(nora.cuerpo.reserva.importe, 900);
+    assert.equal(nora.cuerpo.reserva.codigo, "BIENVENIDA");
+
+    const segunda = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-02T10:30", codigo: "BIENVENIDA" } });
+    assert.equal(segunda.status, 409);
+    assert.equal(segunda.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+
+    const conHistorial = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-004", pistaId: "pista-1", inicio: "2026-12-03T10:30", codigo: "BIENVENIDA" } });
+    assert.equal(conHistorial.status, 409);
+    assert.equal(conHistorial.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  });
+});
+
+test("BIENVENIDA caduca el 31 de diciembre de 2026", async () => {
+  const a = await arrancarApi({ AHORA: "2027-01-01T10:00" });
+  try {
+    const nora = await a.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-02T10:30", codigo: "BIENVENIDA" } });
+    assert.equal(nora.status, 409);
+    assert.equal(nora.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  } finally {
+    a.cerrar();
+  }
+});
+
+test("MANANAS descuenta 4 € en mañanas de lunes a viernes", async () => {
+  await conApi(async (api) => {
+    const ok = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T10:30", codigo: "MANANAS" } });
+    assert.equal(ok.status, 201);
+    assert.equal(ok.cuerpo.reserva.importeBase, 1800);
+    assert.equal(ok.cuerpo.reserva.descuento, 400);
+    assert.equal(ok.cuerpo.reserva.importe, 1400);
+
+    const sabado = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-05T10:30", codigo: "MANANAS" } });
+    assert.equal(sabado.status, 409);
+    assert.equal(sabado.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+
+    const mediodia = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T12:00", codigo: "MANANAS" } });
+    assert.equal(mediodia.status, 409);
+    assert.equal(mediodia.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  });
+});
+
+test("CLUB10 descuenta el 10 % y tiene un límite de 3 reservas", async () => {
+  await conApi(async (api) => {
+    const crear = (inicio: string) => api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio, codigo: "CLUB10" } });
+    for (const inicio of ["2026-12-01T10:30", "2026-12-01T12:00", "2026-12-01T13:30"]) {
+      const r = await crear(inicio);
+      assert.equal(r.status, 201, inicio);
+      assert.equal(r.cuerpo.reserva.importeBase, 1200, inicio);
+      assert.equal(r.cuerpo.reserva.descuento, 120, inicio);
+      assert.equal(r.cuerpo.reserva.importe, 1080, inicio);
+    }
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-02T00:00" } });
+    const cuarta = await crear("2026-12-03T10:30");
+    assert.equal(cuarta.status, 409);
+    assert.equal(cuarta.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  });
+});
+
+test("las reservas canceladas no cuentan para el límite de CLUB10", async () => {
+  await conApi(async (api) => {
+    const crear = (inicio: string) => api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio, codigo: "CLUB10" } });
+    const ids: string[] = [];
+    for (const inicio of ["2026-12-01T10:30", "2026-12-01T12:00", "2026-12-01T13:30"]) {
+      ids.push((await crear(inicio)).cuerpo.reserva.id as string);
+    }
+    await api.pedir("POST", `/api/reservas/${ids[0]}/cancelar`);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-02T00:00" } });
+    const tercera = await crear("2026-12-03T10:30");
+    assert.equal(tercera.status, 201, "con una cancelada solo quedan dos, y una tercera sí se permite");
+  });
+});
+
+test("el código no distingue mayúsculas ni espacios y rechaza lo desconocido", async () => {
+  await conApi(async (api) => {
+    const ok = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T10:30", codigo: "  club10 " } });
+    assert.equal(ok.status, 201);
+    assert.equal(ok.cuerpo.reserva.codigo, "CLUB10");
+    assert.equal(ok.cuerpo.reserva.descuento, 180);
+
+    const mal = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T12:00", codigo: "NOEXISTE" } });
+    assert.equal(mal.status, 400);
+    assert.equal(mal.cuerpo.error.codigo, "CODIGO_INVALIDO");
+
+    const noTexto = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T13:30", codigo: 123 } });
+    assert.equal(noTexto.status, 400);
+    assert.equal(noTexto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  });
+});
+
+test("las reglas del club se comprueban antes que el código", async () => {
+  await conApi(async (api) => {
+    const sinCuota = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-011", pistaId: "pista-1", inicio: "2026-12-01T10:30", codigo: "MANANAS" } });
+    assert.equal(sinCuota.status, 409);
+    assert.equal(sinCuota.cuerpo.error.codigo, "CUOTA_INACTIVA");
+
+    const ocupada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-009", pistaId: "pista-1", inicio: "2026-11-19T19:30", codigo: "CLUB10" } });
+    assert.equal(ocupada.status, 409);
+    assert.equal(ocupada.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  });
+});
+
+test("GET devuelve los importes y el código guardados", async () => {
+  await conApi(async (api) => {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T10:30", codigo: "MANANAS" } });
+    const id = r.cuerpo.reserva.id as string;
+    const detalle = await api.pedir("GET", `/api/reservas/${id}`);
+    assert.equal(detalle.cuerpo.reserva.importeBase, 1800);
+    assert.equal(detalle.cuerpo.reserva.descuento, 400);
+    assert.equal(detalle.cuerpo.reserva.importe, 1400);
+    assert.equal(detalle.cuerpo.reserva.codigo, "MANANAS");
+    const lista = await api.pedir("GET", "/api/reservas?socio=socio-003&fecha=2026-12-01");
+    assert.ok(lista.cuerpo.reservas.some((x: { id: string; descuento: number }) => x.id === id && x.descuento === 400));
+  });
+});
+
+test("la penalización fuera de plazo es el importe con descuento", async () => {
+  await conApi(async (api) => {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T10:30", codigo: "MANANAS" } });
+    assert.equal(r.cuerpo.reserva.importe, 1400);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T11:00" } });
+    const c = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, 1400);
+  });
+});
+
+test("la disponibilidad sigue mostrando el precio sin descuento", async () => {
+  const d = await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-01");
