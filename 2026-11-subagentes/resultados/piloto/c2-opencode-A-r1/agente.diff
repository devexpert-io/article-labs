+
+test("el periodo no puede abarcar más de 92 días", async () => {
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-01-01&hasta=2026-12-31", { socio: GESTOR });
+  assert.equal(r.status, 400);
+  assert.equal(r.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+  const justo = await api.pedir("GET", "/api/reservas/exportar?desde=2026-01-01&hasta=2026-04-02", { socio: GESTOR });
+  assert.equal(justo.status, 200, "92 días exactos sí se permiten");
+});
+
+test("filtra por estado y rechaza estados desconocidos", async () => {
+  const mal = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19&estado=otra", { socio: GESTOR });
+  assert.equal(mal.status, 400);
+  assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
