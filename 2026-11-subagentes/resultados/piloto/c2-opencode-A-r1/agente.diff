+// Lista de espera de franjas, probada a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const GESTOR = "socio-040";
+const OCUPADA_1930 = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+
+/** Ejecuta una prueba con una API aislada y recién arrancada. */
+async function conApi(fn: (api: Api) => Promise<void>): Promise<void> {
+  const a = await arrancarApi();
+  try {
+    await fn(a);
+  } finally {
+    a.cerrar();
+  }
+}
+
+test("apuntarse responde 201 con la espera y su posición, y exige X-Socio", async () => {
+  await conApi(async (api) => {
+    const sinCabecera = await api.pedir("POST", "/api/esperas", { cuerpo: OCUPADA_1930 });
+    assert.equal(sinCabecera.status, 401);
+    assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const r = await api.pedir("POST", "/api/esperas", { cuerpo: OCUPADA_1930, socio: "socio-001" });
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.espera.estado, "activa");
+    assert.equal(r.cuerpo.espera.posicion, 1);
+    assert.equal(r.cuerpo.espera.socioId, "socio-001");
+  });
+});
+
+test("solo se puede esperar una franja ocupada, válida y con la cuota al día", async () => {
+  await conApi(async (api) => {
+    const libre = await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-1", inicio: "2026-12-01T10:30" }, socio: "socio-001" });
+    assert.equal(libre.status, 409);
+    assert.equal(libre.cuerpo.error.codigo, "FRANJA_LIBRE");
+
+    const inexistente = await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-999", inicio: "2026-11-19T19:30" }, socio: "socio-001" });
+    assert.equal(inexistente.status, 404);
+    assert.equal(inexistente.cuerpo.error.codigo, "PISTA_NO_ENCONTRADA");
+
+    const cerrada = await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-4", inicio: "2026-11-19T19:30" }, socio: "socio-001" });
+    assert.equal(cerrada.status, 409);
+    assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+
+    const invalida = await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-1", inicio: "2026-11-19T11:00" }, socio: "socio-001" });
+    assert.equal(invalida.status, 400);
+    assert.equal(invalida.cuerpo.error.codigo, "FRANJA_INVALIDA");
+
+    const pasada = await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-1", inicio: "2026-11-18T09:00" }, socio: "socio-001" });
+    assert.equal(pasada.status, 409);
+    assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+
+    const sinCuota = await api.pedir("POST", "/api/esperas", { cuerpo: OCUPADA_1930, socio: "socio-011" });
+    assert.equal(sinCuota.status, 409);
+    assert.equal(sinCuota.cuerpo.error.codigo, "CUOTA_INACTIVA");
+  });
+});
+
+test("sin duplicados ni más de 2 esperas, y sin esperar lo que ya se tiene", async () => {
+  await conApi(async (api) => {
+    await api.pedir("POST", "/api/esperas", { cuerpo: OCUPADA_1930, socio: "socio-001" });
+    const repetida = await api.pedir("POST", "/api/esperas", { cuerpo: OCUPADA_1930, socio: "socio-001" });
+    assert.equal(repetida.status, 409);
+    assert.equal(repetida.cuerpo.error.codigo, "YA_EN_ESPERA");
+
+    // socio-007 ya tiene reservada esa franja.
+    const yaReservada = await api.pedir("POST", "/api/esperas", { cuerpo: OCUPADA_1930, socio: "socio-007" });
+    assert.equal(yaReservada.status, 409);
+    assert.equal(yaReservada.cuerpo.error.codigo, "YA_RESERVADA");
+
+    // socio-003 acumula dos esperas y la tercera falla.
+    await api.pedir("POST", "/api/esperas", { cuerpo: OCUPADA_1930, socio: "socio-003" });
+    await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-3", inicio: "2026-11-19T09:00" }, socio: "socio-003" });
+    const limite = await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-1", inicio: "2026-11-19T18:00" }, socio: "socio-003" });
+    assert.equal(limite.status, 409);
+    assert.equal(limite.cuerpo.error.codigo, "LIMITE_DE_ESPERAS");
+  });
+});
+
+test("la posición es el orden de llegada y un gestor puede consultar a otro socio", async () => {
+  await conApi(async (api) => {
+    await api.pedir("POST", "/api/esperas", { cuerpo: OCUPADA_1930, socio: "socio-001" });
+    await api.pedir("POST", "/api/esperas", { cuerpo: OCUPADA_1930, socio: "socio-003" });
+
+    const propias = await api.pedir("GET", "/api/esperas", { socio: "socio-003" });
+    assert.equal(propias.status, 200);
+    assert.equal(propias.cuerpo.esperas.length, 1);
+    assert.equal(propias.cuerpo.esperas[0].posicion, 2);
+
+    const deOtro = await api.pedir("GET", "/api/esperas?socio=socio-001", { socio: GESTOR });
+    assert.equal(deOtro.status, 200);
+    assert.equal(deOtro.cuerpo.esperas.length, 1);
+    assert.equal(deOtro.cuerpo.esperas[0].socioId, "socio-001");
+    assert.equal(deOtro.cuerpo.esperas[0].posicion, 1);
+
+    const prohibido = await api.pedir("GET", "/api/esperas?socio=socio-001", { socio: "socio-003" });
+    assert.equal(prohibido.status, 403);
+    assert.equal(prohibido.cuerpo.error.codigo, "SIN_PERMISO");
+  });
+});
+
+test("retirarse deja la espera en retirada y los demás suben de puesto", async () => {
+  await conApi(async (api) => {
+    const primera = await api.pedir("POST", "/api/esperas", { cuerpo: OCUPADA_1930, socio: "socio-001" });
+    await api.pedir("POST", "/api/esperas", { cuerpo: OCUPADA_1930, socio: "socio-003" });
+
+    const ajena = await api.pedir("DELETE", `/api/esperas/${primera.cuerpo.espera.id}`, { socio: "socio-003" });
+    assert.equal(ajena.status, 403);
+    assert.equal(ajena.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const retirada = await api.pedir("DELETE", `/api/esperas/${primera.cuerpo.espera.id}`, { socio: "socio-001" });
+    assert.equal(retirada.status, 200);
+    assert.equal(retirada.cuerpo.espera.estado, "retirada");
+
+    const restantes = await api.pedir("GET", "/api/esperas", { socio: "socio-003" });
+    assert.equal(restantes.cuerpo.esperas[0].posicion, 1, "el que quedaba sube al puesto 1");
+
+    const inexistente = await api.pedir("DELETE", "/api/esperas/E-9999", { socio: "socio-001" });
+    assert.equal(inexistente.status, 404);
+    assert.equal(inexistente.cuerpo.error.codigo, "ESPERA_NO_ENCONTRADA");
+  });
+});
+
+test("al cancelar, la franja se asigna al primero de la lista", async () => {
+  await conApi(async (api) => {
+    const reserva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-001", pistaId: "pista-1", inicio: "2026-12-01T10:30" } });
+    const espera = await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-1", inicio: "2026-12-01T10:30" }, socio: "socio-002" });
+
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.ok(cancelada.cuerpo.asignadaA, "hay asignación");
+    assert.notEqual(cancelada.cuerpo.asignadaA, null);
+
+    const asignada = await api.pedir("GET", `/api/reservas/${cancelada.cuerpo.asignadaA}`);
+    assert.equal(asignada.cuerpo.reserva.socioId, "socio-002");
+    assert.equal(asignada.cuerpo.reserva.notas, "Asignada desde la lista de espera");
+    assert.equal(asignada.cuerpo.reserva.estado, "confirmada");
+
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const esp = estado.esperas.find((e: { id: string }) => e.id === espera.cuerpo.espera.id);
+    assert.equal(esp.estado, "asignada");
+  });
+});
+
+test("se salta a quien ya no puede reservar y se prueba con el siguiente", async () => {
+  await conApi(async (api) => {
+    const reserva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-001", pistaId: "pista-1", inicio: "2026-12-01T10:30" } });
+    // socio-017 tiene 3 reservas futuras en la semilla: no podrá reservar.
+    await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-1", inicio: "2026-12-01T10:30" }, socio: "socio-017" });
+    const segunda = await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-1", inicio: "2026-12-01T10:30" }, socio: "socio-002" });
+
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.cuerpo.reserva.id}/cancelar`);
+    assert.ok(cancelada.cuerpo.asignadaA);
+    const asignada = await api.pedir("GET", `/api/reservas/${cancelada.cuerpo.asignadaA}`);
+    assert.equal(asignada.cuerpo.reserva.socioId, "socio-002", "se asigna al segundo de la lista");
+
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const descartada = estado.esperas.find((e: { id: string; pistaId: string; inicio: string; estado: string }) => e.id !== segunda.cuerpo.espera.id && e.pistaId === "pista-1" && e.inicio === "2026-12-01T10:30");
+    assert.equal(descartada.estado, "descartada");
+  });
+});
+
+test("las esperas caducan cuando empieza la franja", async () => {
+  await conApi(async (api) => {
+    await api.pedir("POST", "/api/esperas", { cuerpo: OCUPADA_1930, socio: "socio-002" });
+    await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-3", inicio: "2026-11-19T09:00" }, socio: "socio-002" });
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-20T00:00" } });
+
+    const vacias = await api.pedir("GET", "/api/esperas", { socio: "socio-002" });
