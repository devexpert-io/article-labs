+// Exportación de reservas a CSV, probada a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const GESTOR = "socio-040";
+
+test("solo los gestores pueden exportar", async () => {
+  const ruta = "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19";
+  const sinCabecera = await api.pedir("GET", ruta);
+  assert.equal(sinCabecera.status, 401);
+  assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("GET", ruta, { socio: "socio-001" });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const gestor = await api.pedir("GET", ruta, { socio: GESTOR });
+  assert.equal(gestor.status, 200);
+});
+
+test("responde el CSV con sus cabeceras y CRLF", async () => {
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19", { socio: GESTOR });
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-11-19-2026-11-19.csv"');
+  assert.ok(r.texto.startsWith("id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas\r\n"), "cabecera exacta");
+  assert.ok(r.texto.endsWith("\r\n"), "la última línea también termina en CRLF");
+});
+
+test("una fila por reserva del periodo, ordenada por inicio y pista", async () => {
+  const desde = "2026-11-19";
+  const hasta = "2026-11-19";
+  const r = await api.pedir("GET", `/api/reservas/exportar?desde=${desde}&hasta=${hasta}`, { socio: GESTOR });
+  const filas = r.texto.split("\r\n").filter((l: string) => l.length > 0).slice(1);
+  const listado = (await api.pedir("GET", `/api/reservas?desde=${desde}&hasta=${hasta}&limite=100`)).cuerpo.reservas as Array<{ inicio: string; pistaId: string }>;
+  assert.equal(filas.length, listado.length);
+  const inicios = filas.map((l: string) => `${l.split(",")[1]}T${l.split(",")[2]}`);
+  for (let i = 1; i < inicios.length; i++) {
+    assert.ok(inicios[i]! >= inicios[i - 1]!, "las filas van ordenadas por inicio");
+  }
+});
+
+test("los importes van en euros con dos decimales y la penalización vacía si no la hay", async () => {
+  await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T10:30" } });
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-12-01&hasta=2026-12-01", { socio: GESTOR });
+  const fila = r.texto.split("\r\n").find((l: string) => l.startsWith("R-") && l.includes("2026-12-01"));
