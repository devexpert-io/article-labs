@@ -0,0 +1,196 @@
+// Los códigos de descuento al reservar, probados a través de la API.
+// Cada test arranca su propia API para partir siempre del mismo estado.
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+beforeEach(async () => {
+  api = await arrancarApi();
+});
+afterEach(() => api.cerrar());
+
+// Nora Benítez (socio-041) se da de alta esta semana: cero reservas en la semilla.
+const NUEVA = "socio-041";
+
+test("sin código, la reserva es como antes (importeBase === importe, descuento 0, sin codigo)", async () => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-25T09:00" } });
+  assert.equal(r.status, 201);
+  const reserva = r.cuerpo.reserva;
+  assert.equal(reserva.importeBase, 1800);
+  assert.equal(reserva.descuento, 0);
+  assert.equal(reserva.importe, 1800);
+  assert.equal(reserva.importeBase, reserva.importe);
+  assert.equal("codigo" in reserva, false);
+});
+
+test("BIENVENIDA descuenta el 50 % en la primera reserva del socio", async () => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "BIENVENIDA" } });
+  assert.equal(r.status, 201);
+  const reserva = r.cuerpo.reserva;
+  assert.equal(reserva.importeBase, 1800);
+  assert.equal(reserva.descuento, 900);
+  assert.equal(reserva.importe, 900);
+  assert.equal(reserva.codigo, "BIENVENIDA");
+});
+
+test("BIENVENIDA no vale si el socio ya tiene alguna reserva (cualquier estado)", async () => {
+  // Irene Sanz (socio-004) ya tiene reservas en la semilla.
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-004", pistaId: "pista-2", inicio: "2026-11-25T09:00", codigo: "BIENVENIDA" } });
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("BIENVENIDA no vale después del 31 de diciembre de 2026", async () => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-05T10:00" } });
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2027-01-06T09:00", codigo: "BIENVENIDA" } });
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("MANANAS descuenta 4,00 € entre semana antes de las 12:00", async () => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "MANANAS" } });
+  assert.equal(r.status, 201);
+  const reserva = r.cuerpo.reserva;
+  assert.equal(reserva.importeBase, 1800);
+  assert.equal(reserva.descuento, 400);
+  assert.equal(reserva.importe, 1400);
+  assert.equal(reserva.codigo, "MANANAS");
+});
+
+test("MANANAS no vale en fin de semana", async () => {
+  // 2026-11-28 es sábado.
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-28T09:00", codigo: "MANANAS" } });
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("MANANAS no vale a partir de las 12:00", async () => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-25T12:00", codigo: "MANANAS" } });
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("CLUB10 descuenta el 10 %", async () => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "CLUB10" } });
+  assert.equal(r.status, 201);
+  const reserva = r.cuerpo.reserva;
+  assert.equal(reserva.importeBase, 1800);
+  assert.equal(reserva.descuento, 180);
+  assert.equal(reserva.importe, 1620);
+  assert.equal(reserva.codigo, "CLUB10");
+});
+
+test("CLUB10 solo vale 3 usos por socio", async () => {
+  for (const inicio of ["2026-11-25T09:00", "2026-11-26T09:00", "2026-11-27T09:00"]) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio, codigo: "CLUB10" } });
+    assert.equal(r.status, 201, `esperada 201 para ${inicio}`);
+  }
+  // Mueve el reloj para que esas tres reservas dejen de ser futuras y no salte el límite de reservas.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-28T10:00" } });
+  const cuarta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-30T09:00", codigo: "CLUB10" } });
+  assert.equal(cuarta.status, 409);
+  assert.equal(cuarta.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("las canceladas con CLUB10 no cuentan hacia el límite", async () => {
+  const a = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "CLUB10" } });
+  const cancelada = await api.pedir("POST", `/api/reservas/${a.cuerpo.reserva.id}/cancelar`);
+  assert.equal(cancelada.status, 200);
+  // Tres confirmadas con CLUB10 caben: la cancelada no consume uno de los tres usos.
+  for (const inicio of ["2026-11-26T09:00", "2026-11-27T09:00", "2026-11-30T09:00"]) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio, codigo: "CLUB10" } });
+    assert.equal(r.status, 201, `esperada 201 para ${inicio}`);
+  }
+});
+
+test("el código no distingue mayúsculas ni espacios de alrededor", async () => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "  club10 " } });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.codigo, "CLUB10");
+  assert.equal(r.cuerpo.reserva.descuento, 180);
+});
+
+test("un código que no está en el catálogo responde 400 CODIGO_INVALIDO", async () => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "NOEXISTE" } });
+  assert.equal(r.status, 400);
+  assert.equal(r.cuerpo.error.codigo, "CODIGO_INVALIDO");
+});
+
+test("un código que no es texto responde 400 DATOS_INVALIDOS", async () => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: 123 } });
+  assert.equal(r.status, 400);
+  assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+});
+
+test("solo se acepta un código por reserva (no se acumulan)", async () => {
+  // Varios códigos (un array) no es un texto: se rechaza, no se acumulan descuentos.
+  const varios = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: ["MANANAS", "CLUB10"] } });
+  assert.equal(varios.status, 400);
+  assert.equal(varios.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  // Con un único código, el descuento es solo el de ese código (CLUB10: 10 %, no 10 % + 4 €).
+  const uno = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "CLUB10" } });
+  assert.equal(uno.status, 201);
+  assert.equal(uno.cuerpo.reserva.descuento, 180);
+  assert.equal(uno.cuerpo.reserva.codigo, "CLUB10");
+});
+
+test("GET /api/reservas/:id y GET /api/reservas devuelven importeBase, descuento, importe y codigo", async () => {
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "MANANAS" } });
+  const id = creada.cuerpo.reserva.id;
+  const una = await api.pedir("GET", `/api/reservas/${id}`);
+  assert.equal(una.status, 200);
+  assert.equal(una.cuerpo.reserva.importeBase, 1800);
+  assert.equal(una.cuerpo.reserva.descuento, 400);
+  assert.equal(una.cuerpo.reserva.importe, 1400);
+  assert.equal(una.cuerpo.reserva.codigo, "MANANAS");
+  const lista = await api.pedir("GET", `/api/reservas?socio=${NUEVA}`);
+  const encontrada = lista.cuerpo.reservas.find((r: any) => r.id === id);
+  assert.ok(encontrada);
+  assert.equal(encontrada.importeBase, 1800);
+  assert.equal(encontrada.descuento, 400);
+  assert.equal(encontrada.importe, 1400);
+  assert.equal(encontrada.codigo, "MANANAS");
+});
+
+test("las reglas del club van antes que el código y el código no se gasta si fallan", async () => {
+  const pasada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-18T09:00", codigo: "BIENVENIDA" } });
+  assert.equal(pasada.status, 409);
+  assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+  // La primera reserva de verdad sigue pudiendo usar BIENVENIDA (no se gastó en el intento fallido).
+  const valida = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "BIENVENIDA" } });
+  assert.equal(valida.status, 201);
+  assert.equal(valida.cuerpo.reserva.descuento, 900);
+});
+
+test("el límite de reservas futuras va antes que el código", async () => {
+  for (const inicio of ["2026-11-25T09:00", "2026-11-26T09:00", "2026-11-27T09:00"]) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio } });
+    assert.equal(r.status, 201);
+  }
+  const cuarta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-30T09:00", codigo: "CLUB10" } });
+  assert.equal(cuarta.status, 409);
+  assert.equal(cuarta.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+});
+
+test("la penalización por cancelar fuera de plazo es el importe con descuento", async () => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T08:00" } });
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NUEVA, pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "MANANAS" } });
+  assert.equal(r.status, 201);
+  const reserva = r.cuerpo.reserva;
+  assert.equal(reserva.importe, 1400);
+  const sinForzar = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1400);
+});
+
+test("la disponibilidad sigue mostrando el precio sin descuento", async () => {
+  const d = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-25");
+  const p1 = d.cuerpo.pistas.find((p: any) => p.pistaId === "pista-1");
+  const franja = p1.franjas.find((f: any) => f.inicio === "2026-11-25T09:00");
+  assert.equal(franja.estado, "libre");
+  assert.equal(franja.precio, 1800);
+});
diff --git a/test/exportar-csv.test.ts b/test/exportar-csv.test.ts
