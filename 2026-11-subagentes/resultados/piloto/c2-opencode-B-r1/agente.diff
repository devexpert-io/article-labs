@@ -0,0 +1,172 @@
+// Exportación de reservas a CSV, probada a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+const HORAS = ["09:00", "10:30", "12:00", "13:30", "15:00", "16:30", "18:00", "19:30", "21:00"];
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+test("solo los gestores pueden exportar", async () => {
+  const ruta = "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-31";
+  const sinSocio = await api.pedir("GET", ruta);
+  assert.equal(sinSocio.status, 401);
+  assert.equal(sinSocio.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("GET", ruta, { socio: "socio-001" });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const gestor = await api.pedir("GET", ruta, { socio: "socio-040" });
+  assert.equal(gestor.status, 200);
+});
+
+test("responde 200 con las cabeceras CSV y el nombre del fichero", async () => {
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-31", { socio: "socio-040" });
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-10-31.csv"');
+});
+
+test("la primera línea es la cabecera exacta", async () => {
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-31", { socio: "socio-040" });
+  assert.equal(r.texto.split("\r\n")[0], CABECERA);
+});
+
+test("una fila por reserva del periodo, ordenada por inicio y por pista", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const esperadas = estado.reservas
+    .filter((r: any) => r.inicio.slice(0, 10) >= "2026-10-01" && r.inicio.slice(0, 10) <= "2026-10-31")
+    .sort((a: any, b: any) => (a.inicio === b.inicio ? a.pistaId.localeCompare(b.pistaId) : a.inicio.localeCompare(b.inicio)))
+    .map((r: any) => r.id);
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-31", { socio: "socio-040" });
+  const lineas = r.texto.split("\r\n");
+  assert.equal(lineas[0], CABECERA);
+  const ids = lineas.slice(1, -1).map((l: string) => l.split(",")[0]);
+  assert.deepEqual(ids, esperadas);
+});
+
+test("importes y penalización en euros con dos decimales y punto", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const socios = new Map<string, { nombre: string; email: string }>(estado.socios.map((s: any) => [s.id, s]));
+  const pistas = new Map<string, string>(estado.pistas.map((p: any) => [p.id, p.nombre]));
+  const r0 = estado.reservas[0];
+  const r = await api.pedir("GET", `/api/reservas/exportar?desde=${r0.inicio.slice(0, 10)}&hasta=${r0.inicio.slice(0, 10)}`, { socio: "socio-040" });
+  const linea = r.texto.split("\r\n").find((l: string) => l.startsWith(`${r0.id},`))!;
+  assert.ok(linea, "la reserva debe aparecer en el CSV");
+  const campos = linea.split(",");
+  assert.equal(campos[0], r0.id);
+  assert.equal(campos[1], r0.inicio.slice(0, 10));
+  assert.equal(campos[2], r0.inicio.slice(11, 16));
+  assert.equal(campos[3], pistas.get(r0.pistaId));
+  assert.equal(campos[4], socios.get(r0.socioId)!.nombre);
+  assert.equal(campos[5], socios.get(r0.socioId)!.email);
+  assert.equal(campos[6], r0.estado);
+  assert.equal(campos[7], (r0.importe / 100).toFixed(2));
+  assert.equal(campos[8], "");
+});
+
+test("escapa comas, comillas y saltos de línea según RFC 4180", async () => {
+  const creada = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-11-21T16:30", notas: 'Incluye coma, "comillas" y\nsalto de línea' },
+  });
+  assert.equal(creada.status, 201);
+  const id = creada.cuerpo.reserva.id;
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-21&hasta=2026-11-21", { socio: "socio-040" });
