+// La lista de espera de franjas, probada a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Arranca una API nueva para cada prueba y la cierra al terminar. */
+async function conApi(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+/** Socios con la cuota al día y sin reservas futuras confirmadas (ideales para las pruebas). */
+async function sociosLimpios(api: Api, cuantos: number): Promise<string[]> {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const conFuturas = new Set(
+    estado.reservas
+      .filter((r: { estado: string; inicio: string }) => r.estado === "confirmada" && r.inicio > estado.ahora)
+      .map((r: { socioId: string }) => r.socioId),
+  );
+  const ids: string[] = [];
+  for (const s of estado.socios as { id: string; rol: string; cuotaActiva: boolean }[]) {
+    if (s.rol === "socio" && s.cuotaActiva && !conFuturas.has(s.id)) ids.push(s.id);
+  }
+  assert.ok(ids.length >= cuantos, `faltan socios limpios (${ids.length} < ${cuantos})`);
+  return ids.slice(0, cuantos);
+}
+
+// Franja ocupada en la semilla: socio-007 tiene la pista-1 el jueves 19 a las 19:30.
+const OCUPADA = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+
+test("apuntarse a una franja ocupada crea una espera activa con posición", async () => {
+  await conApi(async (api) => {
+    const [socio] = await sociosLimpios(api, 1);
+    const res = await api.pedir("POST", "/api/esperas", { socio, cuerpo: OCUPADA });
+    assert.equal(res.status, 201);
+    assert.equal(res.cuerpo.espera.estado, "activa");
+    assert.equal(res.cuerpo.espera.posicion, 1);
+    assert.equal(res.cuerpo.espera.socioId, socio);
+    assert.equal(res.cuerpo.espera.pistaId, "pista-1");
+    assert.equal(res.cuerpo.espera.inicio, "2026-11-19T19:30");
+    assert.match(res.cuerpo.espera.id, /^E-\d{4}$/);
+
+    const sinCabecera = await api.pedir("POST", "/api/esperas", { cuerpo: OCUPADA });
+    assert.equal(sinCabecera.status, 401);
+    assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  });
+});
