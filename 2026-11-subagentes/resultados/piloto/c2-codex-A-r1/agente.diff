+    const r = await api.pedir(metodo!, ruta!);
+    assert.equal(r.status, 401); assert.equal(r.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  }
+  const a = await esperar(api, inicio);
+  assert.equal(a.status, 201);
+  assert.deepEqual(a.cuerpo.espera, { id: "E-0001", socioId: socio, pistaId: "pista-1", inicio, estado: "activa", posicion: 1 });
