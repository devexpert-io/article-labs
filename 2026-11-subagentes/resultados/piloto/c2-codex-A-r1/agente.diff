+  assert.deepEqual((await api.pedir("GET", "/api/esperas?socio=socio-005", { socio: gestor })).cuerpo, (await listar()).cuerpo);
+  const ajena = await api.pedir("GET", "/api/esperas?socio=socio-005", { socio });
+  assert.equal(ajena.status, 403); assert.equal(ajena.cuerpo.error.codigo, "SIN_PERMISO");
