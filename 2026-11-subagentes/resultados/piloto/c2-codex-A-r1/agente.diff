+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi } from "./ayuda.ts";
+
+test("CSV: permisos, validación de periodo y estado", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const ruta = "/api/reservas/exportar";
+  for (const [socio, status, codigo] of [[undefined, 401, "NO_IDENTIFICADO"], ["socio-004", 403, "SIN_PERMISO"]] as const) {
+    const r = await api.pedir("GET", ruta, { socio });
+    assert.equal(r.status, status); assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+  for (const q of ["", "?desde=2026-11-18", "?desde=2026-1-01&hasta=2026-11-18",
+    "?desde=2026-02-30&hasta=2026-03-01", "?desde=2026-11-19&hasta=2026-11-18",
+    "?desde=2026-11-18&hasta=2026-11-18&estado=otro", "?desde=2026-11-18&hasta=2026-11-18&estado="]) {
+    const r = await api.pedir("GET", ruta + q, { socio: "socio-040" });
+    assert.equal(r.status, 400); assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  const grande = await api.pedir("GET", ruta + "?desde=2026-01-01&hasta=2026-04-03", { socio: "socio-040" });
+  assert.equal(grande.status, 400); assert.equal(grande.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+  assert.equal((await api.pedir("GET", ruta + "?desde=2026-01-01&hasta=2026-04-02", { socio: "socio-040" })).status, 200);
+});
+
+test("CSV: todas las filas, orden, importes, escapado y CRLF sin cambiar el listado", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const antes = (await api.pedir("GET", "/api/reservas?limite=100")).cuerpo;
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2026-11-18", { socio: "socio-040" });
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-11-18.csv"');
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const esperadas = estado.reservas.filter((r: any) => r.inicio.slice(0, 10) <= "2026-11-18");
+  const lineas = r.texto.split("\r\n");
+  assert.equal(lineas.shift(), "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas");
+  assert.equal(lineas.pop(), "");
+  assert.ok(lineas.length > 100); assert.equal(lineas.length, esperadas.length);
+  assert.deepEqual(lineas.map((l) => l.split(",")[0]), esperadas.map((r: any) => r.id));
+  assert.ok(!r.texto.replaceAll("\r\n", "").includes("\n"));
+  assert.deepEqual((await api.pedir("GET", "/api/reservas?limite=100")).cuerpo, antes);
+  const notas = 'Hola, "Nora"\nsegunda línea';
+  const nueva = (await api.pedir("POST", "/api/reservas", { cuerpo: {
+    socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T09:00", notas,
+  } })).cuerpo.reserva;
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T08:00" } });
+  await api.pedir("POST", `/api/reservas/${nueva.id}/cancelar`, { cuerpo: { forzar: true } });
+  const csv = await api.pedir("GET", "/api/reservas/exportar?desde=2026-12-01&hasta=2026-12-01&estado=cancelada", { socio: "socio-040" });
+  assert.ok(csv.texto.endsWith(`${nueva.id},2026-12-01,09:00,Pista 1,Nora Benítez,nora.benitez@example.com,cancelada,18.00,18.00,"Hola, ""Nora""\nsegunda línea"\r\n`));
+  for (const estado of ["confirmada", "no_presentada"]) {
+    const filtrado = await api.pedir("GET", `/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-31&estado=${estado}`, { socio: "socio-040" });
+    assert.ok(filtrado.texto.split("\r\n").slice(1, -1).every((l) => l.split(",")[6] === estado));
+  }
+});
