+  api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-1", inicio } });
+const esperar = (api: Api, inicio: string, socio = "socio-004") =>
+  api.pedir("POST", "/api/esperas", { socio, cuerpo: { pistaId: "pista-1", inicio } });
