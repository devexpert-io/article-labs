+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+function reservar(api: Api, inicio: string, codigo?: unknown, socioId = "socio-041") {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-1", inicio, ...(codigo === undefined ? {} : { codigo }) } });
+}
+
+test("descuentos: sin código, desglose y disponibilidad sin descuento", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const r = await reservar(api, "2026-12-01T09:00");
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.importeBase, 1800); assert.equal(r.cuerpo.reserva.descuento, 0);
+  assert.equal(r.cuerpo.reserva.importe, 1800); assert.ok(!("codigo" in r.cuerpo.reserva));
+  const con = await reservar(api, "2026-12-01T10:30", "  club10 ");
+  assert.equal(con.status, 201);
+  assert.equal(con.cuerpo.reserva.codigo, "CLUB10");
+  assert.equal(con.cuerpo.reserva.descuento, 180); assert.equal(con.cuerpo.reserva.importe, 1620);
+  assert.deepEqual((await api.pedir("GET", `/api/reservas/${con.cuerpo.reserva.id}`)).cuerpo.reserva, con.cuerpo.reserva);
+  const lista = (await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.reservas;
+  assert.deepEqual(lista, [r.cuerpo.reserva, con.cuerpo.reserva]);
+  const d = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-01&pista=pista-1")).cuerpo;
+  assert.equal(d.pistas[0].franjas[1].precio, 1800);
+});
+
+test("BIENVENIDA: primera reserva, cualquier historial y fecha del club", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const r = await reservar(api, "2026-12-01T09:00", "bienvenida");
+  assert.equal(r.status, 201); assert.equal(r.cuerpo.reserva.importe, 900);
+  await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+  assert.equal((await reservar(api, "2026-12-01T10:30", "BIENVENIDA")).cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  for (const estado of ["confirmada", "no_presentada", "cancelada"]) {
+    const historial = (await api.pedir("GET", "/_estado")).cuerpo.reservas.find((r: any) => r.estado === estado && r.socioId !== "socio-041");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-31T23:59" } });
+    const intento = await reservar(api, "2027-01-04T09:00", "BIENVENIDA", historial.socioId);
+    assert.equal(intento.status, 409); assert.equal(intento.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }
+  const limite = await arrancarApi({ AHORA: "2026-12-31T23:59" }); t.after(() => limite.cerrar());
+  assert.equal((await reservar(limite, "2027-01-04T09:00", "BIENVENIDA")).status, 201);
+  const caducado = await arrancarApi({ AHORA: "2027-01-01T00:00" }); t.after(() => caducado.cerrar());
+  assert.equal((await reservar(caducado, "2027-01-04T09:00", "BIENVENIDA")).cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("MANANAS: días laborables y límite de las 12, penalización descontada", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  for (const inicio of ["2026-12-01T12:00", "2026-12-05T09:00", "2026-12-06T10:30"]) {
+    const r = await reservar(api, inicio, "MANANAS");
+    assert.equal(r.status, 409); assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }
+  for (const inicio of ["2026-12-01T09:00", "2026-12-04T10:30"]) {
+    const r = await reservar(api, inicio, "MANANAS");
+    assert.equal(r.status, 201); assert.equal(r.cuerpo.reserva.descuento, 400);
+    assert.equal(r.cuerpo.reserva.importe, 1400);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: inicio.slice(0, 10) + "T08:00" } });
+    const cancelada = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 1400);
+  }
+});
+
+test("CLUB10: máximo tres usos incluyendo pasados; cancelación libera uso", async (t) => {
+  const api = await arrancarApi({ AHORA: "2026-12-01T08:00" }); t.after(() => api.cerrar());
+  let id = "";
+  for (const dia of ["01", "02", "03"]) {
+    const r = await reservar(api, `2026-12-${dia}T09:00`, "CLUB10");
+    assert.equal(r.status, 201); id = r.cuerpo.reserva.id;
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: `2026-12-${dia}T10:00` } });
+  }
+  const limite = await reservar(api, "2026-12-04T09:00", "CLUB10");
+  assert.equal(limite.status, 409); assert.equal(limite.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-03T08:00" } });
+  await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal((await reservar(api, "2026-12-04T09:00", "CLUB10")).status, 201);
+});
+
+test("códigos: formato, un solo código y precedencia de las reglas del club", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  for (const codigo of [null, 10, [], {}, ["CLUB10", "MANANAS"]]) {
+    const r = await reservar(api, "2026-12-01T09:00", codigo);
+    assert.equal(r.status, 400); assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const codigo of ["", "OTRO", "CLUB10 MANANAS", "CLUB10,MANANAS"]) {
+    const r = await reservar(api, "2026-12-01T09:00", codigo);
+    assert.equal(r.status, 400); assert.equal(r.cuerpo.error.codigo, "CODIGO_INVALIDO");
+  }
+  for (const [cambios, codigo] of [
+    [{ socioId: "socio-011" }, "CUOTA_INACTIVA"],
+    [{ pistaId: "pista-4" }, "PISTA_CERRADA"],
+    [{ inicio: "2026-11-18T09:00" }, "FRANJA_PASADA"],
+    [{ inicio: "2026-12-01T09:15" }, "FRANJA_INVALIDA"],
+    [{ inicio: "2026-11-19T19:30" }, "FRANJA_NO_DISPONIBLE"],
+  ] as const) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T09:00", codigo: 42, ...cambios } });
+    assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+  assert.equal((await reservar(api, "2026-12-01T09:00", "BIENVENIDA")).status, 201);
+  await reservar(api, "2026-12-01T10:30");
+  await reservar(api, "2026-12-01T12:00");
+  assert.equal((await reservar(api, "2026-12-01T13:30", "OTRO")).cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+});
