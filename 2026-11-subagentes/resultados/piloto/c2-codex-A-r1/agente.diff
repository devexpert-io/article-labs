+// Transiciones sin endpoint público: cambios de cuota y marcado de no presentada.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { crearClub, ErrorDelClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+test("esperas: perder la cuota después del alta descarta al socio y continúa la cola", () => {
+  const estado = crearSemilla();
+  estado.ahora = "2026-12-01T08:00";
+  const club = crearClub(estado);
+  const franja = { pistaId: "pista-1", inicio: "2026-12-04T09:00" };
+  const titular = club.crearReserva({ ...franja, socioId: "socio-002" }).reserva;
+  club.crearEspera("socio-004", franja);
+  club.crearEspera("socio-005", franja);
+  estado.socios.find((s) => s.id === "socio-004")!.cuotaActiva = false;
+  const resultado = club.cancelarReserva(titular.id, {});
+  assert.ok(resultado.asignadaA);
+  assert.equal(club.obtenerReserva(resultado.asignadaA).reserva.socioId, "socio-005");
+  assert.deepEqual(estado.esperas.map((e) => e.estado), ["descartada", "asignada"]);
+});
+
+test("esperas: si nadie puede reservar no hay asignación", () => {
+  const estado = crearSemilla();
+  estado.ahora = "2026-12-01T08:00";
+  const club = crearClub(estado);
+  const franja = { pistaId: "pista-1", inicio: "2026-12-04T09:00" };
+  const titular = club.crearReserva({ ...franja, socioId: "socio-002" }).reserva;
+  club.crearEspera("socio-004", franja);
+  estado.socios.find((s) => s.id === "socio-004")!.cuotaActiva = false;
+  const antes = estado.reservas.length;
+  assert.equal(club.cancelarReserva(titular.id, {}).asignadaA, null);
+  assert.equal(estado.esperas[0]!.estado, "descartada");
+  assert.equal(estado.reservas.length, antes);
+});
+
+test("CLUB10: las no presentadas cuentan y las canceladas no", () => {
+  const estado = crearSemilla();
+  estado.ahora = "2026-12-01T08:00";
+  const club = crearClub(estado);
+  const datos = { socioId: "socio-041", pistaId: "pista-1", codigo: "CLUB10" };
+  for (const hora of ["09:00", "10:30", "12:00"]) {
+    club.crearReserva({ ...datos, inicio: "2026-12-04T" + hora }).reserva.estado = "no_presentada";
+  }
+  const antes = estado.contador;
+  assert.throws(() => club.crearReserva({ ...datos, inicio: "2026-12-04T13:30" }),
+    (e: unknown) => e instanceof ErrorDelClub && e.codigo === "CODIGO_NO_APLICABLE" && e.http === 409);
+  assert.equal(estado.contador, antes);
+  club.cancelarReserva(estado.reservas.at(-1)!.id, {});
+  assert.equal(club.crearReserva({ ...datos, inicio: "2026-12-04T13:30" }).reserva.importe, 1620);
+});
+
+test("descuentos: céntimos enteros y el descuento fijo nunca supera el precio", () => {
+  const estado = crearSemilla();
+  estado.ahora = "2026-12-01T08:00";
+  estado.pistas[0]!.precioValle = 301;
+  const club = crearClub(estado);
+  const datos = { socioId: "socio-041", pistaId: "pista-1" };
+  const bienvenida = club.crearReserva({ ...datos, inicio: "2026-12-04T09:00", codigo: "BIENVENIDA" }).reserva;
+  assert.equal(bienvenida.descuento, 151);
+  assert.equal(bienvenida.importe, 150);
+  const manana = club.crearReserva({ ...datos, inicio: "2026-12-04T10:30", codigo: "MANANAS" }).reserva;
+  assert.equal(manana.importeBase, 301); assert.equal(manana.descuento, 301); assert.equal(manana.importe, 0);
+});
