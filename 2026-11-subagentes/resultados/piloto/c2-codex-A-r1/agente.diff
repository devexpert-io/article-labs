+  const esperas = (await api.pedir("GET", "/_estado")).cuerpo.esperas;
+  assert.deepEqual(esperas.map((e: any) => e.estado), ["descartada", "asignada"]);
+});
+
+test("esperas: caducan al empezar, no cuentan para el límite y no se asignan", async (t) => {
