diff --git a/test/codigos-descuento.test.ts b/test/codigos-descuento.test.ts
new file mode 100644
index 0000000..0bb4eab
--- /dev/null
+++ b/test/codigos-descuento.test.ts
@@ -0,0 +1,172 @@
+// Códigos de descuento al reservar (docs/specs/codigos-descuento.md), probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const reservar = (api: Api, cuerpo: Record<string, unknown>) => api.pedir("POST", "/api/reservas", { cuerpo });
+
+test("sin código, todo igual: importeBase igual a importe, descuento 0 y sin codigo", () => conApi(async (api) => {
+  const r = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-25T18:00" });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.importe, 2800);
+  assert.equal(r.cuerpo.reserva.importeBase, 2800);
+  assert.equal(r.cuerpo.reserva.descuento, 0);
+  assert.equal("codigo" in r.cuerpo.reserva, false);
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  for (const reserva of estado.reservas) {
+    assert.equal(reserva.importeBase, reserva.importe, `${reserva.id} de la semilla`);
+    assert.equal(reserva.descuento, 0, `${reserva.id} de la semilla`);
+  }
+}));
+
+test("BIENVENIDA: 50 % en la primera reserva del socio y solo esa", () => conApi(async (api) => {
+  const primera = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T18:00", codigo: "BIENVENIDA" });
+  assert.equal(primera.status, 201);
+  assert.deepEqual(
+    { importeBase: primera.cuerpo.reserva.importeBase, descuento: primera.cuerpo.reserva.descuento, importe: primera.cuerpo.reserva.importe, codigo: primera.cuerpo.reserva.codigo },
+    { importeBase: 2800, descuento: 1400, importe: 1400, codigo: "BIENVENIDA" },
+  );
+  // Aunque cancele la primera, ya tiene una reserva anterior.
+  await api.pedir("POST", `/api/reservas/${primera.cuerpo.reserva.id}/cancelar`);
+  const segunda = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T18:00", codigo: "BIENVENIDA" });
+  assert.equal(segunda.status, 409);
+  assert.equal(segunda.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  const veterano = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-27T18:00", codigo: "BIENVENIDA" });
+  assert.equal(veterano.status, 409);
+  assert.equal(veterano.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+}));
+
+test("BIENVENIDA vale hasta el 31 de diciembre de 2026 incluido, según la hora del club", () => conApi(async (api) => {
+  const ultimoDia = await reservar(api, { socioId: "socio-041", pistaId: "pista-3", inicio: "2027-01-05T10:30", codigo: "BIENVENIDA" });
+  assert.equal(ultimoDia.status, 201);
+  assert.equal(ultimoDia.cuerpo.reserva.descuento, 600);
+}, { AHORA: "2026-12-31T23:30" }));
+
+test("BIENVENIDA caduca después del 31 de diciembre de 2026, aunque el socio no tenga reservas", () => conApi(async (api) => {
+  const r = await reservar(api, { socioId: "socio-041", pistaId: "pista-3", inicio: "2027-01-05T10:30", codigo: "BIENVENIDA" });
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+}, { AHORA: "2027-01-04T10:00" }));
+
+test("MANANAS: 4,00 € en franjas de lunes a viernes que empiezan antes de las 12:00", () => conApi(async (api) => {
+  const manana = await reservar(api, { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-25T10:30", codigo: "MANANAS" });
+  assert.equal(manana.status, 201);
+  assert.equal(manana.cuerpo.reserva.importeBase, 1200);
+  assert.equal(manana.cuerpo.reserva.descuento, 400);
+  assert.equal(manana.cuerpo.reserva.importe, 800);
+  assert.equal(manana.cuerpo.reserva.codigo, "MANANAS");
+  // Se puede usar más de una vez.
+  const otra = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-27T09:00", codigo: "MANANAS" });
+  assert.equal(otra.status, 201);
+  assert.equal(otra.cuerpo.reserva.importe, 1400);
+  for (const inicio of ["2026-11-25T12:00", "2026-11-25T18:00", "2026-11-28T09:00", "2026-11-29T10:30"]) {
+    const r = await reservar(api, { socioId: "socio-006", pistaId: "pista-2", inicio, codigo: "MANANAS" });
+    assert.equal(r.status, 409, inicio);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE", inicio);
+  }
+}));
+
+test("CLUB10: 10 %, como mucho 3 reservas por socio sin contar las canceladas", () => conApi(async (api) => {
+  const ids: string[] = [];
+  for (const inicio of ["2026-11-25T18:00", "2026-11-26T18:00", "2026-11-27T18:00"]) {
+    const r = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio, codigo: "CLUB10" });
+    assert.equal(r.status, 201, inicio);
+    assert.equal(r.cuerpo.reserva.importeBase, 2800);
+    assert.equal(r.cuerpo.reserva.descuento, 280);
+    assert.equal(r.cuerpo.reserva.importe, 2520);
+    ids.push(r.cuerpo.reserva.id);
+  }
+  // Las canceladas no cuentan.
+  assert.equal((await api.pedir("POST", `/api/reservas/${ids[2]}/cancelar`)).status, 200);
+  const otra = await reservar(api, { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-11-27T18:00", codigo: "CLUB10" });
+  assert.equal(otra.status, 201);
+  // Ya pasadas siguen contando: tiene 3 con CLUB10 y no le queda ninguna futura.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T10:00" } });
+  const cuarta = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T18:00", codigo: "club10" });
+  assert.equal(cuarta.status, 409);
+  assert.equal(cuarta.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  const sinCodigo = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T18:00" });
+  assert.equal(sinCodigo.status, 201);
+  // Otro socio sí puede usarlo.
+  const otroSocio = await reservar(api, { socioId: "socio-003", pistaId: "pista-2", inicio: "2026-12-01T18:00", codigo: "CLUB10" });
+  assert.equal(otroSocio.status, 201);
+}));
+
+test("formato del código: mayúsculas y espacios dan igual, y los errores de formato son 400", () => conApi(async (api) => {
+  const r = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-25T18:00", codigo: "  club10 " });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.codigo, "CLUB10");
+  for (const codigo of ["NAVIDAD", "", "CLUB10 MANANAS", "CLUB10,MANANAS"]) {
+    const mal = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-26T18:00", codigo });
+    assert.equal(mal.status, 400, codigo);
+    assert.equal(mal.cuerpo.error.codigo, "CODIGO_INVALIDO", codigo);
+  }
+  // Un solo código por reserva: una lista no es un texto.
+  for (const codigo of [10, null, true, ["CLUB10", "MANANAS"], { codigo: "CLUB10" }]) {
+    const mal = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-26T18:00", codigo });
+    assert.equal(mal.status, 400, JSON.stringify(codigo));
+    assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS", JSON.stringify(codigo));
+  }
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.reservas.filter((x: any) => x.inicio === "2026-11-26T18:00" && x.pistaId === "pista-1").length, 0);
+}));
+
+test("la reserva guarda los importes y el código, y la API los devuelve", () => conApi(async (api) => {
+  const creada = (await reservar(api, { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-25T09:00", codigo: "MANANAS" })).cuerpo.reserva;
+  const esperado = { importeBase: 1200, descuento: 400, importe: 800, codigo: "MANANAS" };
+  const una = (await api.pedir("GET", `/api/reservas/${creada.id}`)).cuerpo.reserva;
+  assert.deepEqual({ importeBase: una.importeBase, descuento: una.descuento, importe: una.importe, codigo: una.codigo }, esperado);
+  const lista = (await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.reservas;
+  assert.equal(lista.length, 1);
+  assert.deepEqual({ importeBase: lista[0].importeBase, descuento: lista[0].descuento, importe: lista[0].importe, codigo: lista[0].codigo }, esperado);
+}));
+
+test("las reglas del club van primero y el código no cuenta como usado", () => conApi(async (api) => {
+  const casos: [Record<string, unknown>, string][] = [
+    [{ socioId: "socio-041", pistaId: "pista-4", inicio: "2026-11-25T18:00" }, "PISTA_CERRADA"],
+    [{ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-18T09:00" }, "FRANJA_PASADA"],
+    [{ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-19T19:30" }, "FRANJA_NO_DISPONIBLE"],
+    [{ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T18:15" }, "FRANJA_INVALIDA"],
+    [{ socioId: "socio-011", pistaId: "pista-1", inicio: "2026-11-25T18:00" }, "CUOTA_INACTIVA"],
+  ];
+  for (const [cuerpo, codigoError] of casos) {
+    const r = await reservar(api, { ...cuerpo, codigo: "BIENVENIDA" });
+    assert.equal(r.cuerpo.error.codigo, codigoError);
+  }
+  // Con una franja de tarde, MANANAS no aplica, pero la pista cerrada va antes.
+  const cerrada = await reservar(api, { socioId: "socio-041", pistaId: "pista-4", inicio: "2026-11-25T18:00", codigo: "MANANAS" });
+  assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+  // Luis Martín tiene 2 futuras: con una más llega al límite.
+  assert.equal((await reservar(api, { socioId: "socio-005", pistaId: "pista-1", inicio: "2026-11-25T18:00" })).status, 201);
+  const limite = await reservar(api, { socioId: "socio-005", pistaId: "pista-1", inicio: "2026-11-26T18:00", codigo: "CLUB10" });
+  assert.equal(limite.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+  // Nora Benítez sigue sin reservas, así que BIENVENIDA le sigue valiendo.
+  const bienvenida = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T19:30", codigo: "BIENVENIDA" });
+  assert.equal(bienvenida.status, 201);
+  assert.equal(bienvenida.cuerpo.reserva.descuento, 1400);
+}));
+
+test("la penalización por cancelar fuera de plazo es el importe con descuento", () => conApi(async (api) => {
+  const r = (await reservar(api, { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-25T10:30", codigo: "MANANAS" })).cuerpo.reserva;
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T09:00" } });
+  const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 800);
+}));
+
+test("la disponibilidad sigue mostrando el precio sin descuento", () => conApi(async (api) => {
+  await reservar(api, { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-25T10:30", codigo: "MANANAS" });
+  const dia = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-25&pista=pista-3")).cuerpo;
+  const franja = dia.pistas[0].franjas.find((f: any) => f.inicio === "2026-11-25T10:30");
+  assert.equal(franja.estado, "reservada");
+  assert.equal(franja.precio, 1200);
+}));
