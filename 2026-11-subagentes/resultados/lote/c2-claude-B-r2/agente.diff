+      if (!ocupante) throw new ErrorDelClub("FRANJA_LIBRE", "Esa franja está libre: se puede reservar directamente");
+      if (ocupante.socioId === socio.id) throw new ErrorDelClub("YA_RESERVADA", "Esa franja ya la tienes reservada");
+      if (listaDe(p.id, franja).some((e) => e.socioId === socio.id)) {
+        throw new ErrorDelClub("YA_EN_ESPERA", "Ya estás en la lista de espera de esa franja");
+      }
+      if (estado.esperas.filter((e) => vigente(e) && e.socioId === socio.id).length >= MAXIMO_ESPERAS_ACTIVAS) {
+        throw new ErrorDelClub("LIMITE_DE_ESPERAS", `${socio.nombre} ya tiene ${MAXIMO_ESPERAS_ACTIVAS} esperas activas`);
+      }
+      const espera: Espera = {
+        id: `E-${String(estado.esperas.length + 1).padStart(4, "0")}`,
+        socioId: socio.id,
+        pistaId: p.id,
+        inicio: franja,
+        estado: "activa",
+      };
+      estado.esperas.push(espera);
+      return { espera: conPosicion(espera) };
+    },
+
+    listarEsperas(quien: Socio | undefined, socioId?: string) {
+      const socio = exigirIdentidad(quien);
+      const de = socioId ?? socio.id;
+      if (de !== socio.id) {
+        if (socio.rol !== "gestor") throw new ErrorDelClub("SIN_PERMISO", "Solo un gestor puede ver las esperas de otro socio", 403);
+        if (!estado.socios.some((s) => s.id === de)) throw new ErrorDelClub("SOCIO_NO_ENCONTRADO", `No existe el socio ${de}`, 404);
+      }
+      return { esperas: estado.esperas.filter((e) => vigente(e) && e.socioId === de).map(conPosicion) };
+    },
+
+    retirarEspera(quien: Socio | undefined, id: string) {
+      const socio = exigirIdentidad(quien);
+      const espera = estado.esperas.find((e) => e.id === id);
+      if (!espera) throw new ErrorDelClub("ESPERA_NO_ENCONTRADA", `No existe la espera ${id}`, 404);
+      if (espera.socioId !== socio.id && socio.rol !== "gestor") {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo su dueño o un gestor puede retirar esta espera", 403);
+      }
+      if (!vigente(espera)) throw new ErrorDelClub("ESPERA_NO_ACTIVA", "Esa espera ya no está activa");
+      espera.estado = "retirada";
+      return { espera: conPosicion(espera) };
     },
   };
 }
