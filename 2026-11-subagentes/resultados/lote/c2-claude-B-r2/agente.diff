@@ -0,0 +1,157 @@
+// Exportar reservas a CSV (docs/specs/exportar-csv.md), probado a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+/** Exporta como el gestor, salvo que se diga otro socio (o null para llamar sin X-Socio). */
+const exportar = (consulta: string, socio: string | null = GESTOR) =>
+  api.pedir("GET", `/api/reservas/exportar${consulta}`, { socio: socio ?? undefined });
+
+/** Las líneas del CSV, sin el CRLF final. */
+const lineas = (texto: string) => texto.split("\r\n").slice(0, -1);
+
+test("solo exporta un gestor", async () => {
+  const anonimo = await exportar("?desde=2026-11-19&hasta=2026-11-19", null);
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await exportar("?desde=2026-11-19&hasta=2026-11-19", "socio-002");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const desconocido = await exportar("?desde=2026-11-19&hasta=2026-11-19", "socio-999");
+  assert.equal(desconocido.status, 401);
+  assert.equal(desconocido.cuerpo.error.codigo, "NO_IDENTIFICADO");
+});
+
+test("responde 200 con CSV, su content-type y el nombre del fichero con el periodo", async () => {
+  const r = await exportar("?desde=2026-11-01&hasta=2026-11-30");
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-11-01-2026-11-30.csv"');
+});
+
+test("la primera línea es la cabecera exacta y todas las líneas terminan en CRLF", async () => {
+  const r = await exportar("?desde=2026-11-19&hasta=2026-11-19");
+  assert.ok(r.texto.startsWith(`${CABECERA}\r\n`));
+  assert.ok(r.texto.endsWith("\r\n"));
+  assert.ok(!/[^\r]\n/.test(r.texto), "no hay saltos de línea sin CR");
+  const vacio = await exportar("?desde=2027-06-01&hasta=2027-06-01");
+  assert.equal(vacio.texto, `${CABECERA}\r\n`);
+});
+
+test("una fila por reserva del periodo, ordenadas por inicio y por pista, con nombres e importes en euros", async () => {
+  const r = await exportar("?desde=2026-11-19&hasta=2026-11-19");
+  assert.deepEqual(lineas(r.texto), [
+    CABECERA,
+    "R-0520,2026-11-19,09:00,Pista 3,Marta López,marta.lopez@example.com,confirmada,12.00,,",
+    "R-0524,2026-11-19,10:30,Pista 2,Clara Prieto,clara.prieto@example.com,confirmada,18.00,,Clase con monitor: avisar a Diego cuando lleguen.",
+    "R-0525,2026-11-19,12:00,Pista 1,Ana Sanz,ana.sanz@example.com,confirmada,18.00,,Viene un invitado que no es socio.",
+    "R-0488,2026-11-19,15:00,Pista 2,Diego Prieto,diego.prieto@example.com,confirmada,18.00,,",
+    "R-0523,2026-11-19,18:00,Pista 1,Raúl Vega,raul.vega@example.com,confirmada,28.00,,Traen sus propias palas. Piden bolas nuevas.",
+    "R-0489,2026-11-19,18:00,Pista 2,Elena Romero,elena.romero@example.com,confirmada,28.00,,",
+    "R-0515,2026-11-19,19:30,Pista 1,Jorge Ruiz,jorge.ruiz@example.com,confirmada,28.00,,",
+  ]);
+});
+
+test("incluye ambos extremos y todos los estados, igual que el listado", async () => {
+  const listado = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=1");
+  const r = await exportar("?desde=2026-10-01&hasta=2026-10-31");
+  const filas = lineas(r.texto).slice(1);
+  assert.equal(filas.length, listado.cuerpo.total);
+  const fechas = filas.map((f) => f.split(",")[1]);
+  assert.equal(fechas[0], "2026-10-01");
+  assert.equal(fechas.at(-1), "2026-10-31");
+  const estados = new Set(filas.map((f) => f.split(",")[6]));
+  assert.ok(estados.has("confirmada") && estados.has("cancelada"), "salen reservas en varios estados");
+  const inicios = filas.map((f) => f.split(",").slice(1, 3).join("T"));
+  assert.deepEqual(inicios, [...inicios].sort(), "ordenadas por inicio");
+});
+
+test("filtra por estado y rechaza un estado desconocido", async () => {
+  const canceladas = lineas((await exportar("?desde=2026-10-01&hasta=2026-10-31&estado=cancelada")).texto).slice(1);
+  const listado = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&estado=cancelada&limite=1");
+  assert.equal(canceladas.length, listado.cuerpo.total);
+  assert.ok(canceladas.length > 0);
+  assert.ok(canceladas.every((f) => f.split(",")[6] === "cancelada"));
+  for (const estado of ["confirmada", "no_presentada"]) {
+    assert.equal((await exportar(`?desde=2026-10-01&hasta=2026-10-31&estado=${estado}`)).status, 200);
+  }
+  const malo = await exportar("?desde=2026-10-01&hasta=2026-10-31&estado=pendiente");
+  assert.equal(malo.status, 400);
+  assert.equal(malo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+});
+
+test("la penalización va en euros y, si no hay, el campo va vacío", async () => {
+  const cancelada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  const filas = lineas((await exportar("?desde=2026-11-19&hasta=2026-11-19")).texto);
+  assert.equal(filas[1], "R-0520,2026-11-19,09:00,Pista 3,Marta López,marta.lopez@example.com,cancelada,12.00,12.00,");
+  assert.equal(filas[4], "R-0488,2026-11-19,15:00,Pista 2,Diego Prieto,diego.prieto@example.com,confirmada,18.00,,");
+});
+
+test("escapa según el RFC 4180 las notas con comas, comillas y saltos de línea", async () => {
+  const notas = ["Con coma, y punto", 'Dice "hola"', "Primera línea\nsegunda línea", "Sin nada raro"];
+  const ids: string[] = [];
+  for (const [i, nota] of notas.entries()) {
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: i === 3 ? "socio-005" : "socio-041", pistaId: `pista-${i === 3 ? 3 : i + 1}`, inicio: i === 3 ? "2026-11-26T10:30" : "2026-11-25T10:30", notas: nota },
+    });
+    assert.equal(creada.status, 201, JSON.stringify(creada.cuerpo));
+    ids.push(creada.cuerpo.reserva.id);
+  }
+  const r = await exportar("?desde=2026-11-25&hasta=2026-11-26");
+  const filaDe = (id: string) => {
+    const inicio = r.texto.indexOf(`${id},`);
+    return r.texto.slice(inicio, r.texto.indexOf("\r\n", inicio));
+  };
+  const fin = (fila: string) => fila.split(",").slice(9).join(",");
+  assert.equal(fin(filaDe(ids[0]!)), '"Con coma, y punto"');
+  assert.equal(fin(filaDe(ids[1]!)), '"Dice ""hola"""');
+  assert.equal(fin(filaDe(ids[2]!)), '"Primera línea\nsegunda línea"');
+  assert.equal(fin(filaDe(ids[3]!)), "Sin nada raro");
+  assert.ok(r.texto.includes(`${ids[0]},2026-11-25,10:30,Pista 1,`), "los demás campos van sin comillas");
+});
+
+test("desde y hasta son obligatorios, con formato válido y en orden", async () => {
+  for (const consulta of [
+    "",
+    "?desde=2026-11-01",
+    "?hasta=2026-11-30",
+    "?desde=2026-11-1&hasta=2026-11-30",
+    "?desde=01-11-2026&hasta=2026-11-30",
+    "?desde=2026-11-01&hasta=2026-02-30",
+    "?desde=2026-11-30&hasta=2026-11-01",
+  ]) {
+    const r = await exportar(consulta);
+    assert.equal(r.status, 400, consulta);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", consulta);
+  }
+});
+
+test("el periodo abarca como mucho 92 días contando los dos extremos", async () => {
+  const justo = await exportar("?desde=2026-09-01&hasta=2026-12-01");
+  assert.equal(justo.status, 200);
+  const largo = await exportar("?desde=2026-09-01&hasta=2026-12-02");
+  assert.equal(largo.status, 400);
+  assert.equal(largo.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+});
+
+test("GET /api/reservas no cambia y /api/reservas/:id sigue funcionando", async () => {
+  const listado = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=2");
+  assert.equal(listado.status, 200);
+  assert.match(listado.cabeceras.get("content-type") ?? "", /^application\/json/);
+  assert.deepEqual(Object.keys(listado.cuerpo), ["total", "pagina", "paginas", "reservas"]);
+  assert.equal(listado.cuerpo.total, 315);
+  assert.equal(listado.cuerpo.reservas.length, 2);
+  const una = await api.pedir("GET", "/api/reservas/R-0488");
+  assert.equal(una.status, 200);
+  assert.equal(una.cuerpo.reserva.id, "R-0488");
+});
