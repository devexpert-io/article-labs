+// La lista de espera de franjas ocupadas, probada a través de la API (docs/specs/lista-espera.md).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Franjas ocupadas fijas de la semilla.
+const DE_SOCIO_007 = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+const DE_MARTA = { pistaId: "pista-3", inicio: "2026-11-19T09:00" }; // socio-002, faltan 23 horas
+const DE_SOCIO_009 = { pistaId: "pista-1", inicio: "2026-11-21T15:00" };
+const DE_IRENE = { pistaId: "pista-1", inicio: "2026-11-23T18:00" }; // socio-004, R de 2800
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function idReserva(api: Api, franja: { pistaId: string; inicio: string }): Promise<string> {
+  const r = await api.pedir("GET", `/api/reservas?fecha=${franja.inicio.slice(0, 10)}&pista=${franja.pistaId}&estado=confirmada`);
+  return r.cuerpo.reservas.find((x: { inicio: string }) => x.inicio === franja.inicio).id;
+}
+
+async function esperaEnEstado(api: Api, id: string) {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  return estado.esperas.find((e: { id: string }) => e.id === id);
+}
+
+test("apuntarse a una franja ocupada responde 201 con la espera activa y su posición", () => conApi(async (api) => {
+  const primera = await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: DE_SOCIO_007 });
+  assert.equal(primera.status, 201);
+  assert.equal(primera.cuerpo.espera.socioId, "socio-041");
+  assert.equal(primera.cuerpo.espera.pistaId, "pista-1");
+  assert.equal(primera.cuerpo.espera.inicio, "2026-11-19T19:30");
+  assert.equal(primera.cuerpo.espera.estado, "activa");
+  assert.equal(primera.cuerpo.espera.posicion, 1);
+  assert.ok(primera.cuerpo.espera.id);
+  const segunda = await api.pedir("POST", "/api/esperas", { socio: "socio-004", cuerpo: DE_SOCIO_007 });
+  assert.equal(segunda.cuerpo.espera.posicion, 2);
+
+  const anonima = await api.pedir("POST", "/api/esperas", { cuerpo: DE_SOCIO_007 });
+  assert.equal(anonima.status, 401);
+  assert.equal(anonima.cuerpo.error.codigo, "NO_IDENTIFICADO");
+}));
+
+test("solo se esperan franjas ocupadas que se podrían reservar", () => conApi(async (api) => {
+  const casos: [string, { pistaId: string; inicio: string }, number, string][] = [
+    ["socio-041", { pistaId: "pista-2", inicio: "2026-11-19T19:30" }, 409, "FRANJA_LIBRE"],
+    ["socio-041", { pistaId: "pista-9", inicio: "2026-11-19T19:30" }, 404, "PISTA_NO_ENCONTRADA"],
+    ["socio-041", { pistaId: "pista-4", inicio: "2026-11-19T19:30" }, 409, "PISTA_CERRADA"],
+    ["socio-041", { pistaId: "pista-1", inicio: "2026-11-19T19:00" }, 400, "FRANJA_INVALIDA"],
+    ["socio-041", { pistaId: "pista-1", inicio: "2026-11-18T09:00" }, 409, "FRANJA_PASADA"],
+    ["socio-022", DE_SOCIO_007, 409, "CUOTA_INACTIVA"],
+  ];
+  for (const [socio, cuerpo, http, codigo] of casos) {
+    const r = await api.pedir("POST", "/api/esperas", { socio, cuerpo });
+    assert.equal(r.status, http, codigo);
+    assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+}));
+
+test("sin duplicados, sin esperar lo propio y como mucho 2 esperas activas", () => conApi(async (api) => {
+  assert.equal((await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: DE_SOCIO_007 })).status, 201);
+  const repetida = await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: DE_SOCIO_007 });
+  assert.equal(repetida.status, 409);
+  assert.equal(repetida.cuerpo.error.codigo, "YA_EN_ESPERA");
+
+  const propia = await api.pedir("POST", "/api/esperas", { socio: "socio-007", cuerpo: DE_SOCIO_007 });
+  assert.equal(propia.status, 409);
+  assert.equal(propia.cuerpo.error.codigo, "YA_RESERVADA");
+
+  assert.equal((await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: DE_MARTA })).status, 201);
+  const tercera = await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: DE_SOCIO_009 });
+  assert.equal(tercera.status, 409);
+  assert.equal(tercera.cuerpo.error.codigo, "LIMITE_DE_ESPERAS");
+}));
+
+test("GET /api/esperas da las esperas activas con su posición; un gestor puede pedir las de otro", () => conApi(async (api) => {
+  await api.pedir("POST", "/api/esperas", { socio: "socio-004", cuerpo: DE_SOCIO_007 });
+  await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: DE_SOCIO_007 });
+  await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: DE_MARTA });
+
+  const mias = await api.pedir("GET", "/api/esperas", { socio: "socio-041" });
+  assert.equal(mias.status, 200);
+  assert.deepEqual(mias.cuerpo.esperas.map((e: any) => [e.pistaId, e.inicio, e.posicion]), [
+    ["pista-1", "2026-11-19T19:30", 2],
+    ["pista-3", "2026-11-19T09:00", 1],
+  ]);
+
+  const gestor = await api.pedir("GET", "/api/esperas?socio=socio-004", { socio: "socio-040" });
+  assert.equal(gestor.status, 200);
+  assert.deepEqual(gestor.cuerpo.esperas.map((e: any) => [e.socioId, e.posicion]), [["socio-004", 1]]);
+
+  const ajenas = await api.pedir("GET", "/api/esperas?socio=socio-004", { socio: "socio-041" });
+  assert.equal(ajenas.status, 403);
+  assert.equal(ajenas.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("GET", "/api/esperas")).status, 401);
+}));
+
+test("retirarse deja la espera en retirada y los de detrás suben un puesto", () => conApi(async (api) => {
+  const a = (await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: DE_SOCIO_007 })).cuerpo.espera;
+  const b = (await api.pedir("POST", "/api/esperas", { socio: "socio-004", cuerpo: DE_SOCIO_007 })).cuerpo.espera;
+  const c = (await api.pedir("POST", "/api/esperas", { socio: "socio-003", cuerpo: DE_SOCIO_007 })).cuerpo.espera;
+
+  const ajena = await api.pedir("DELETE", `/api/esperas/${a.id}`, { socio: "socio-004" });
+  assert.equal(ajena.status, 403);
+  assert.equal(ajena.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const retirada = await api.pedir("DELETE", `/api/esperas/${a.id}`, { socio: "socio-041" });
+  assert.equal(retirada.status, 200);
+  assert.equal(retirada.cuerpo.espera.estado, "retirada");
+  assert.equal(retirada.cuerpo.espera.posicion, undefined);
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-004" })).cuerpo.esperas[0].posicion, 1);
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-003" })).cuerpo.esperas[0].posicion, 2);
+  assert.deepEqual((await api.pedir("GET", "/api/esperas", { socio: "socio-041" })).cuerpo.esperas, []);
+
+  const porGestor = await api.pedir("DELETE", `/api/esperas/${b.id}`, { socio: "socio-040" });
+  assert.equal(porGestor.status, 200);
+  assert.equal(porGestor.cuerpo.espera.estado, "retirada");
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-003" })).cuerpo.esperas[0].posicion, 1);
+  assert.equal(c.posicion, 3);
+
+  const noExiste = await api.pedir("DELETE", "/api/esperas/E-9999", { socio: "socio-041" });
+  assert.equal(noExiste.status, 404);
+  assert.equal(noExiste.cuerpo.error.codigo, "ESPERA_NO_ENCONTRADA");
+  assert.equal((await api.pedir("DELETE", `/api/esperas/${c.id}`)).status, 401);
+}));
+
+test("al cancelar, la franja se asigna al primero de la lista", () => conApi(async (api) => {
+  const primera = (await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: DE_IRENE })).cuerpo.espera;
+  const segunda = (await api.pedir("POST", "/api/esperas", { socio: "socio-003", cuerpo: DE_IRENE })).cuerpo.espera;
+  const cancelada = await api.pedir("POST", `/api/reservas/${await idReserva(api, DE_IRENE)}/cancelar`);
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+  assert.ok(cancelada.cuerpo.asignadaA);
+
+  const nueva = (await api.pedir("GET", `/api/reservas/${cancelada.cuerpo.asignadaA}`)).cuerpo.reserva;
+  assert.equal(nueva.socioId, "socio-041");
+  assert.equal(nueva.pistaId, "pista-1");
+  assert.equal(nueva.inicio, "2026-11-23T18:00");
+  assert.equal(nueva.estado, "confirmada");
+  assert.equal(nueva.importe, 2800);
+  assert.equal(nueva.importeBase, 2800);
+  assert.equal(nueva.descuento, 0);
+  assert.equal(nueva.codigo, undefined);
+  assert.equal(nueva.notas, "Asignada desde la lista de espera");
+  assert.equal((await esperaEnEstado(api, primera.id)).estado, "asignada");
+  assert.equal((await esperaEnEstado(api, segunda.id)).estado, "activa");
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-003" })).cuerpo.esperas[0].posicion, 1);
+
+  // También al cancelar con forzar, que sigue cobrando su penalización.
+  await api.pedir("POST", "/api/esperas", { socio: "socio-004", cuerpo: DE_MARTA });
+  const forzada = await api.pedir("POST", `/api/reservas/${await idReserva(api, DE_MARTA)}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1200);
+  const deIrene = (await api.pedir("GET", `/api/reservas/${forzada.cuerpo.asignadaA}`)).cuerpo.reserva;
+  assert.equal(deIrene.socioId, "socio-004");
+  assert.equal(deIrene.importe, 1200);
+}));
+
+test("se salta a quien ya no podría reservar y se prueba con el siguiente", () => conApi(async (api) => {
+  // Luis Martín (socio-005) tiene dos reservas futuras: se apunta y luego llega a tres.
+  const luis = (await api.pedir("POST", "/api/esperas", { socio: "socio-005", cuerpo: DE_IRENE })).cuerpo.espera;
+  const nora = (await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: DE_IRENE })).cuerpo.espera;
