+    { inicio: "2026-12-01T21:00", importe: 2800 },
+    { inicio: "2026-12-05T09:00", importe: 2800 }, // fin de semana
+  ];
+  for (const [i, caso] of casos.entries()) {
+    const api = await arrancarApi();
