+test("una franja de 90 minutos está reservada si una reserva confirmada se solapa con ella, aunque sea en parte", async () => {
+  await conApi(async (api) => {
+    const r = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-12-01T10:00", duracion: 60 },
