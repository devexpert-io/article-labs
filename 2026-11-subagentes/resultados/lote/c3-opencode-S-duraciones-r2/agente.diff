+test("cada pista trae huecos: los intervalos libres más largos posibles, y una pista cerrada no tiene", async () => {
+  await conApi(async (api) => {
+    // Día sin reservas: un único hueco de 09:00 a 22:30.
+    const vacio = await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-01");
+    const pista3Vacia = vacio.cuerpo.pistas.find((p: { pistaId: string }) => p.pistaId === "pista-3");
+    assert.deepEqual(pista3Vacia.huecos, [{ inicio: "2026-12-01T09:00", fin: "2026-12-01T22:30" }]);
