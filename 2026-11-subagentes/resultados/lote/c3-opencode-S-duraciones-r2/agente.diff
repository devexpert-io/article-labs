+    const estado = Object.fromEntries(pista3.franjas.map((f: { inicio: string; estado: string }) => [f.inicio, f.estado]));
+    // 10:00-11:00 solapa en parte con 09:00-10:30 y con 10:30-12:00.
+    assert.equal(estado["2026-12-01T09:00"], "reservada");
