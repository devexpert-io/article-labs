@@ -0,0 +1,290 @@
+// La feature de duraciones (60, 90 o 120 minutos), probada a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(fn: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("duracion es opcional, vale 60, 90 o 120 y cualquier otro valor responde DURACION_INVALIDA", async () => {
+  await conApi(async (api) => {
+    const deSesenta = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T09:00", duracion: 60 },
+    });
+    assert.equal(deSesenta.status, 201);
+    assert.equal(deSesenta.cuerpo.reserva.duracion, 60);
+    assert.equal(deSesenta.cuerpo.reserva.fin, "2026-12-01T10:00");
+
+    const porDefecto = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-12-01T10:00" },
+    });
+    assert.equal(porDefecto.status, 201);
+    assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+
+    const deCientoVeinte = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-12-01T11:00", duracion: 120 },
+    });
+    assert.equal(deCientoVeinte.status, 201);
+    assert.equal(deCientoVeinte.cuerpo.reserva.duracion, 120);
+    assert.equal(deCientoVeinte.cuerpo.reserva.fin, "2026-12-01T13:00");
+
+    for (const malo of [45, 0, 121, "90", null, 1.5]) {
+      const r = await api.pedir("POST", "/api/reservas", {
+        cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-12-01T14:00", duracion: malo },
+      });
+      assert.equal(r.status, 400, `duracion=${JSON.stringify(malo)} debe fallar`);
+      assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA");
+    }
+  });
+});
+
+test("una reserva empieza en punto o y media, no antes de las 09:00 y termina como muy tarde a las 22:30", async () => {
+  await conApi(async (api) => {
+    const base = { socioId: "socio-041", pistaId: "pista-1" };
+
+    const media = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { ...base, inicio: "2026-12-01T20:30", duracion: 120 },
+    });
+    assert.equal(media.status, 201);
+    assert.equal(media.cuerpo.reserva.fin, "2026-12-01T22:30");
+
+    const invalidas = [
+      { inicio: "2026-12-01T09:15", duracion: 60 }, // no es en punto ni y media
+      { inicio: "2026-12-01T08:30", duracion: 60 }, // antes de las 09:00
+      { inicio: "2026-12-01T21:30", duracion: 90 }, // termina a las 23:00
+      { inicio: "2026-12-01T21:30", duracion: 120 }, // termina a las 23:30
+    ];
+    for (const cuerpo of invalidas) {
+      const r = await api.pedir("POST", "/api/reservas", { cuerpo: { ...base, ...cuerpo } });
+      assert.equal(r.status, 400, `${cuerpo.inicio}/${cuerpo.duracion} debe fallar`);
+      assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA");
+    }
+
+    const justa = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { ...base, inicio: "2026-12-02T21:30", duracion: 60 },
+    });
+    assert.equal(justa.status, 201);
+    assert.equal(justa.cuerpo.reserva.fin, "2026-12-02T22:30");
+  });
+});
+
+test("fin es inicio más la duración", async () => {
+  await conApi(async (api) => {
+    const r = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T13:30", duracion: 120 },
+    });
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.inicio, "2026-12-01T13:30");
+    assert.equal(r.cuerpo.reserva.fin, "2026-12-01T15:30");
+  });
+});
+
+test("sin solapes: no se puede solapar con reservas confirmadas, ni con las de 90 minutos que ya existían", async () => {
+  await conApi(async (api) => {
+    const primera = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-12-01T09:00", duracion: 60 },
+    });
+    assert.equal(primera.status, 201);
+
+    // Termina justo cuando empieza otra: no es solaparse.
+    const pegada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-006", pistaId: "pista-3", inicio: "2026-12-01T10:00", duracion: 60 },
+    });
+    assert.equal(pegada.status, 201);
+
+    // Solape parcial con la primera (09:00-10:00).
+    const solape = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-007", pistaId: "pista-3", inicio: "2026-12-01T09:30", duracion: 60 },
+    });
+    assert.equal(solape.status, 409);
+    assert.equal(solape.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+
+    // Solape con una reserva de 90 minutos que ya existía en la semilla: jueves 19 a las 19:30 en la pista 1.
+    const antigua = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-19T19:00", duracion: 60 },
+    });
+    assert.equal(antigua.status, 409);
+    assert.equal(antigua.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+
+    // Las canceladas no ocupan la pista.
+    const cancelable = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-008", pistaId: "pista-2", inicio: "2026-12-01T09:00", duracion: 60 },
+    });
+    assert.equal(cancelable.status, 201);
+    const cancelada = await api.pedir("POST", `/api/reservas/${cancelable.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    const reusa = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-009", pistaId: "pista-2", inicio: "2026-12-01T09:00", duracion: 60 },
+    });
+    assert.equal(reusa.status, 201);
+  });
+});
+
+test("el importe se calcula por minutos, cruzando las 18:00 y en fin de semana", async () => {
+  await conApi(async (api) => {
+    // Ejemplo de la spec: pista 1 (1800/2800), martes 17:30-19:00 → 2467.
+    const cruzada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T17:30", duracion: 90 },
+    });
+    assert.equal(cruzada.status, 201);
+    assert.equal(cruzada.cuerpo.reserva.importe, 2467);
+
+    // Fin de semana: sábado 09:00-10:00, todo punta → 60 × 2800 / 90 = 1867.
+    const sabado = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-006", pistaId: "pista-1", inicio: "2026-12-05T09:00", duracion: 60 },
+    });
+    assert.equal(sabado.cuerpo.reserva.importe, 1867);
+
+    // Valle en día laborable: martes 12:00-13:00 → 60 × 1800 / 90 = 1200.
+    const valle = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-007", pistaId: "pista-1", inicio: "2026-12-01T12:00", duracion: 60 },
+    });
+    assert.equal(valle.cuerpo.reserva.importe, 1200);
+  });
+});
