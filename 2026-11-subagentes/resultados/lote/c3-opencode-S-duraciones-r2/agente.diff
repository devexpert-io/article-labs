+    const cuarta = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-02T15:00", duracion: 60 },
+    });
+    assert.equal(cuarta.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+  });
+});
