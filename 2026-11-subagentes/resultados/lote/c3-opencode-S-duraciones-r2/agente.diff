+test("las reglas del club siguen aplicando sea cual sea la duración", async () => {
+  await conApi(async (api) => {
+    // Cuota al día.
+    const sinCuota = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-011", pistaId: "pista-1", inicio: "2026-12-01T09:00", duracion: 60 },
+    });
+    assert.equal(sinCuota.cuerpo.error.codigo, "CUOTA_INACTIVA");
+
+    // Pista cerrada.
+    const cerrada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-4", inicio: "2026-12-01T09:00", duracion: 60 },
+    });
+    assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+
+    // La reserva no puede haber empezado.
+    const pasada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-18T09:00", duracion: 60 },
+    });
+    assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+
+    // Máximo de 3 reservas futuras, sea cual sea su duración.
+    const reservas = [
+      { inicio: "2026-12-02T09:00", duracion: 60 },
+      { inicio: "2026-12-02T10:00", duracion: 90 },
+      { inicio: "2026-12-02T12:00", duracion: 120 },
+    ];
+    for (const [i, datos] of reservas.entries()) {
+      const r = await api.pedir("POST", "/api/reservas", {
+        cuerpo: { socioId: "socio-041", pistaId: "pista-1", ...datos },
+      });
+      assert.equal(r.status, 201, `reserva ${i + 1} de 3`);
