+    // Con una reserva de 60 minutos a las 10:00 se parte en dos huecos.
+    await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-12-01T10:00", duracion: 60 },
+    });
+    const ocupado = await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-01&pista=pista-3");
+    assert.deepEqual(ocupado.cuerpo.pistas[0].huecos, [
+      { inicio: "2026-12-01T09:00", fin: "2026-12-01T10:00" },
