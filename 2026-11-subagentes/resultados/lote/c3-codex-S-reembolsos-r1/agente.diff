+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado } from "../src/tipos.ts";
+
+async function crear(api: Api, inicio = "2027-03-28T21:00", pistaId = "pista-2") {
+  const respuesta = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio },
+  });
+  assert.equal(respuesta.status, 201);
+  return respuesta.cuerpo.reserva;
+}
+
+const tramos = [
+  { ahora: "2027-03-26T19:00", porcentaje: 0 }, // 49 horas reales
+  { ahora: "2027-03-26T20:00", porcentaje: 0 }, // 48 exactas
+  { ahora: "2027-03-26T20:30", porcentaje: 0.25 }, // ejemplo de la spec: 47,5
+  { ahora: "2027-03-27T20:00", porcentaje: 0.25 }, // 24 exactas (cambio de hora)
+  { ahora: "2027-03-27T20:01", porcentaje: 0.5 },
+  { ahora: "2027-03-28T20:59", porcentaje: 0.5 },
+  { ahora: "2027-10-29T21:30", inicio: "2027-10-31T21:00", porcentaje: 0 }, // 48,5 reales
+  { ahora: "2027-10-30T21:30", inicio: "2027-10-31T21:00", porcentaje: 0.25 }, // 24,5 reales
+];
+for (const caso of tramos) {
+  test(`cancelación y reembolso con reloj ${caso.ahora}`, async () => {
+    const api = await arrancarApi();
+    try {
+      const reserva = await crear(api, caso.inicio);
+      await api.pedir("POST", "/_reloj", { cuerpo: { ahora: caso.ahora } });
+      const ruta = `/api/reservas/${reserva.id}/cancelar`;
+      if (caso.porcentaje === 0.5) {
+        for (const cuerpo of [{}, { forzar: false }]) {
+          const rechazada = await api.pedir("POST", ruta, { cuerpo });
+          assert.equal(rechazada.status, 409);
+          assert.equal(rechazada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+          assert.equal((await api.pedir("GET", `/api/reservas/${reserva.id}`)).cuerpo.reserva.estado, "confirmada");
+        }
+      }
+      const cancelada = await api.pedir("POST", ruta, { cuerpo: { forzar: caso.porcentaje === 0.5 } });
+      assert.equal(cancelada.status, 200);
+      assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+      assert.equal(cancelada.cuerpo.reserva.penalizacion, reserva.importe * caso.porcentaje);
+      assert.equal(cancelada.cuerpo.reembolso, reserva.importe * (1 - caso.porcentaje));
+    } finally {
+      api.cerrar();
+    }
+  });
