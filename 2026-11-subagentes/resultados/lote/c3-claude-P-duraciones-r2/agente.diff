+test("6. una reserva de 90 minutos a una de las horas de siempre cuesta lo mismo que antes", async () => {
+  for (const fecha of ["2026-12-08", "2026-12-12"]) {
+    const finde = fecha === "2026-12-12";
+    for (const hora of HORAS) {
+      const antes = finde || hora >= "18:00" ? 2000 : 1200;
+      assert.equal(await importe("pista-3", `${fecha}T${hora}`), antes, `${fecha} ${hora}`);
+      assert.equal(await importe("pista-3", `${fecha}T${hora}`, 90), antes, `${fecha} ${hora}`);
+    }
+  }
+  // Y en la disponibilidad, el precio de cada franja es el de siempre.
+  const p1 = await disponibilidad("2026-12-08", "pista-1");
+  assert.deepEqual(p1.franjas.map((f: any) => f.precio), [1800, 1800, 1800, 1800, 1800, 1800, 2800, 2800, 2800]);
+});
