+test("5. el precio se calcula por minutos, también cruzando las 18:00 y en fin de semana", async () => {
+  // Martes 1 de diciembre. Pista 1: valle 1800, punta 2800. Pista 3: valle 1200, punta 2000.
+  assert.equal(await importe("pista-1", "2026-12-01T17:30", 90), 2467); // el ejemplo de la spec
+  assert.equal(await importe("pista-1", "2026-12-01T13:00", 60), 1200);
+  assert.equal(await importe("pista-1", "2026-12-01T19:00", 60), 1867); // 1866,67
+  assert.equal(await importe("pista-1", "2026-12-01T19:00", 120), 3733); // 3733,33
+  assert.equal(await importe("pista-1", "2026-12-01T17:00", 120), 3067); // 1200 + 1866,67
+  assert.equal(await importe("pista-3", "2026-12-01T17:00", 120), 2133); // 800 + 1333,33
+  assert.equal(await importe("pista-3", "2026-12-01T16:30", 120), 1867); // 90 × 1200/90 + 30 × 2000/90 = 1866,67
+  assert.equal(await importe("pista-3", "2026-12-01T15:30", 120), 1600); // todo valle
+  // Sábado 5 y domingo 6: todo a punta.
+  assert.equal(await importe("pista-3", "2026-12-05T10:00", 120), 2667);
+  assert.equal(await importe("pista-1", "2026-12-06T09:30", 60), 1867);
+  assert.equal(await importe("pista-3", "2026-12-06T16:30", 90), 2000);
+});
