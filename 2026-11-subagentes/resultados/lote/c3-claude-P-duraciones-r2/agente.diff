+// Reservas de 60, 90 o 120 minutos (docs/specs/duraciones.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const HORAS = ["09:00", "10:30", "12:00", "13:30", "15:00", "16:30", "18:00", "19:30", "21:00"];
+
+async function reservar(socioId: string, pistaId: string, inicio: string, duracion?: unknown) {
+  const cuerpo: Record<string, unknown> = { socioId, pistaId, inicio };
+  if (duracion !== undefined) cuerpo.duracion = duracion;
+  return api.pedir("POST", "/api/reservas", { cuerpo });
+}
+
+/** Reserva, comprueba que se ha creado y la cancela (gratis, falta más de un día) para no gastar el límite del socio. */
+async function importe(pistaId: string, inicio: string, duracion?: number): Promise<number> {
+  const r = await reservar("socio-041", pistaId, inicio, duracion);
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+  return r.cuerpo.reserva.importe;
+}
+
+async function disponibilidad(fecha: string, pista: string) {
+  const r = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pista}`);
+  assert.equal(r.status, 200);
+  return r.cuerpo.pistas[0];
+}
+
+test("1. duracion es opcional, vale 60, 90 o 120 y por defecto son 90", async () => {
+  const porDefecto = await reservar("socio-006", "pista-1", "2026-12-01T09:00");
+  assert.equal(porDefecto.status, 201);
+  assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+  for (const duracion of [60, 120]) {
+    const r = await reservar("socio-006", "pista-2", duracion === 60 ? "2026-12-01T09:00" : "2026-12-01T12:00", duracion);
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.duracion, duracion);
+  }
+  for (const duracion of [0, 30, 45, 75, 89, 90.5, 150, -90, "90", null, true]) {
+    const r = await reservar("socio-016", "pista-3", "2026-12-01T09:00", duracion);
+    assert.equal(r.status, 400, `duracion ${JSON.stringify(duracion)}`);
+    assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA");
+  }
+});
+
+test("2. una reserva empieza en punto o y media, desde las 09:00, y termina como muy tarde a las 22:30", async () => {
+  const invalidos: [string, number][] = [
+    ["2026-12-02T08:30", 60], ["2026-12-02T09:15", 60], ["2026-12-02T10:45", 90], ["2026-12-02T21:30", 90],
+    ["2026-12-02T21:00", 120], ["2026-12-02T22:00", 60], ["2026-12-02T22:30", 60], ["2026-12-02T25:00", 60],
+    ["2026-12-02 10:00", 60], ["mañana", 60],
+  ];
+  for (const [inicio, duracion] of invalidos) {
+    const r = await reservar("socio-016", "pista-3", inicio, duracion);
+    assert.equal(r.status, 400, `${inicio} ${duracion}`);
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  }
+  for (const [inicio, duracion] of [["2026-12-02T21:30", 60], ["2026-12-02T09:00", 120], ["2026-12-02T18:30", 120]] as const) {
+    const r = await reservar("socio-016", "pista-3", inicio, duracion);
+    assert.equal(r.status, 201, `${inicio} ${duracion}`);
+  }
+});
+
+test("3. fin es inicio más la duración", async () => {
+  const casos: [string, number, string][] = [
+    ["2026-12-03T09:30", 60, "2026-12-03T10:30"],
+    ["2026-12-03T11:00", 90, "2026-12-03T12:30"],
+    ["2026-12-03T20:30", 120, "2026-12-03T22:30"],
+  ];
+  for (const [inicio, duracion, fin] of casos) {
+    const r = await reservar("socio-020", "pista-1", inicio, duracion);
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.fin, fin);
+  }
+});
+
+test("4. una reserva no se solapa con las confirmadas de la pista, nuevas o antiguas", async () => {
+  // Jueves 19, pista 2: reservas antiguas de 90 minutos a las 10:30, 15:00 y 18:00.
+  for (const [inicio, duracion] of [["2026-11-19T16:00", 60], ["2026-11-19T14:00", 120], ["2026-11-19T11:30", 60], ["2026-11-19T17:30", 60]] as const) {
+    const r = await reservar("socio-023", "pista-2", inicio, duracion);
+    assert.equal(r.status, 409, `${inicio} ${duracion}`);
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  }
+  // Terminar justo cuando empieza otra, o empezar justo cuando termina, no es solaparse.
+  const pegadaAntes = await reservar("socio-023", "pista-2", "2026-11-19T13:00", 120);
