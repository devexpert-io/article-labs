+test("8. una franja está reservada si cualquier reserva confirmada se solapa con ella, aunque sea en parte", async () => {
+  // Jueves 10 de diciembre, pista 2: 11:00-12:00 pisa la franja de las 10:30; 13:00-14:00 pisa las de las 12:00 y las 13:30.
+  await reservar("socio-027", "pista-2", "2026-12-10T11:00", 60);
+  await reservar("socio-027", "pista-2", "2026-12-10T13:00", 60);
+  // Una cancelada no cuenta.
+  const cancelada = await reservar("socio-027", "pista-2", "2026-12-10T19:00", 60);
+  await api.pedir("POST", `/api/reservas/${cancelada.cuerpo.reserva.id}/cancelar`);
+  const p2 = await disponibilidad("2026-12-10", "pista-2");
+  const estados = Object.fromEntries(p2.franjas.map((f: any) => [f.inicio.slice(11), f.estado]));
+  assert.deepEqual(estados, {
+    "09:00": "libre", "10:30": "reservada", "12:00": "reservada", "13:30": "reservada",
+    "15:00": "libre", "16:30": "libre", "18:00": "libre", "19:30": "libre", "21:00": "libre",
+  });
+  assert.equal(p2.franjas.length, 9);
+  for (const f of p2.franjas) {
+    const [h, m] = f.inicio.slice(11).split(":").map(Number);
+    const fin = h * 60 + m + 90;
+    assert.equal(f.fin, `2026-12-10T${String(Math.floor(fin / 60)).padStart(2, "0")}:${String(fin % 60).padStart(2, "0")}`);
+  }
+});
