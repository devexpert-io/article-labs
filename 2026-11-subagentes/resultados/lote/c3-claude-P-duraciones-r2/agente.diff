+test("9. huecos: los intervalos libres más largos del día, ordenados y sin tener en cuenta la hora actual", async () => {
+  // Jueves 19, pista 1: ocupada de 12:00 a 13:30 y de 18:00 a 21:00 (dos reservas seguidas).
+  const p1 = await disponibilidad("2026-11-19", "pista-1");
+  assert.deepEqual(p1.huecos, [
+    { inicio: "2026-11-19T09:00", fin: "2026-11-19T12:00" },
+    { inicio: "2026-11-19T13:30", fin: "2026-11-19T18:00" },
+    { inicio: "2026-11-19T21:00", fin: "2026-11-19T22:30" },
+  ]);
+  // Hoy (son las 10:00): los huecos empiezan a las 09:00 igualmente.
+  const hoy = await disponibilidad("2026-11-18", "pista-1");
+  assert.deepEqual(hoy.huecos, [
+    { inicio: "2026-11-18T09:00", fin: "2026-11-18T16:30" },
+    { inicio: "2026-11-18T19:30", fin: "2026-11-18T22:30" },
+  ]);
+  // Un día sin reservas: un solo hueco de apertura a cierre.
+  const vacio = await disponibilidad("2026-12-15", "pista-3");
+  assert.deepEqual(vacio.huecos, [{ inicio: "2026-12-15T09:00", fin: "2026-12-15T22:30" }]);
+  // Con reservas nuevas de varias duraciones, en los extremos del día, y una cancelada que no cuenta.
+  await reservar("socio-028", "pista-3", "2026-12-15T09:00", 60);
