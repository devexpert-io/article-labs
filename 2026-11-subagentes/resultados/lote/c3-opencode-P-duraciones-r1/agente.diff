+test("disponibilidad: una franja está reservada si cualquier reserva se solapa, y añade huecos", async () => {
+  await conApi({}, async (api) => {
+    // 60 minutos: 10:00-11:00 en la pista 1.
+    await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-001", pistaId: "pista-1", inicio: `${LIBRE}T10:00`, duracion: 60 } });
+
+    const disp = (await api.pedir("GET", `/api/disponibilidad?fecha=${LIBRE}`)).cuerpo;
+    const p1 = disp.pistas.find((p: any) => p.pistaId === "pista-1");
+    const porFranja = Object.fromEntries(p1.franjas.map((f: any) => [f.inicio.slice(11), f.estado]));
+    assert.equal(porFranja["09:00"], "reservada"); // se solapa con 10:00-10:30
+    assert.equal(porFranja["10:30"], "reservada"); // se solapa con 10:30-11:00
+    assert.equal(porFranja["12:00"], "libre");
+
+    assert.deepEqual(p1.huecos, [
+      { inicio: `${LIBRE}T09:00`, fin: `${LIBRE}T10:00` },
+      { inicio: `${LIBRE}T11:00`, fin: `${LIBRE}T22:30` },
+    ]);
+
+    // Una pista cerrada no tiene huecos.
+    const p4 = disp.pistas.find((p: any) => p.pistaId === "pista-4");
+    assert.equal(p4.estado, "cerrada");
+    assert.deepEqual(p4.huecos, []);
+  });
+});
