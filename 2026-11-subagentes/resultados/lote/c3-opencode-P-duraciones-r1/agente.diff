+// La feature de duraciones (60, 90 o 120 minutos) probada a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(entorno: Record<string, string> = {}, fn: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi(entorno);
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+// El miércoles 25 de noviembre no tiene reservas en la semilla: sirve para probar solapes y huecos sin ruido.
+const LIBRE = "2026-11-25";
+
+test("duracion es opcional, vale 60/90/120 y por defecto 90; otro valor es DURACION_INVALIDA", async () => {
+  await conApi({}, async (api) => {
+    const porDefecto = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${LIBRE}T09:00` } });
+    assert.equal(porDefecto.status, 201);
+    assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+
+    const sesenta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${LIBRE}T11:00`, duracion: 60 } });
+    assert.equal(sesenta.cuerpo.reserva.duracion, 60);
+
+    const cientoVeinte = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${LIBRE}T15:00`, duracion: 120 } });
+    assert.equal(cientoVeinte.cuerpo.reserva.duracion, 120);
+
+    for (const duracion of [45, 0, 130, "90", 90.5, null]) {
+      const invalida = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: `${LIBRE}T12:00`, duracion } });
+      assert.equal(invalida.status, 400, `duracion ${JSON.stringify(duracion)}`);
+      assert.equal(invalida.cuerpo.error.codigo, "DURACION_INVALIDA");
+    }
+  });
+});
+
+test("el inicio es en punto o y media, desde las 09:00, y termina como tarde a las 22:30", async () => {
+  await conApi({}, async (api) => {
+    const yMedia = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${LIBRE}T09:30`, duracion: 60 } });
+    assert.equal(yMedia.status, 201);
+    assert.equal(yMedia.cuerpo.reserva.fin, `${LIBRE}T10:30`);
+
+    // fin = inicio + duración
+    const larga = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${LIBRE}T12:00`, duracion: 120 } });
+    assert.equal(larga.cuerpo.reserva.fin, `${LIBRE}T14:00`);
+
+    const casos: Array<[string, number]> = [
+      [`${LIBRE}T15:15`, 60], // no en punto ni y media
+      [`${LIBRE}T08:30`, 60], // antes de abrir
+      [`${LIBRE}T21:30`, 120], // termina a las 23:30
+    ];
+    for (const [inicio, duracion] of casos) {
+      const invalida = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio, duracion } });
+      assert.equal(invalida.status, 400, inicio);
+      assert.equal(invalida.cuerpo.error.codigo, "FRANJA_INVALIDA");
+    }
+
+    // 21:30 + 60 = 22:30 es válido
+    const justo = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: `${LIBRE}T21:30`, duracion: 60 } });
+    assert.equal(justo.status, 201);
+  });
+});
+
+test("no se solapa con reservas confirmadas, y que una termine cuando empieza otra no es solaparse", async () => {
+  await conApi({}, async (api) => {
+    // 10:00-11:00
+    const a = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-001", pistaId: "pista-1", inicio: `${LIBRE}T10:00`, duracion: 60 } });
+    assert.equal(a.status, 201);
+
+    // 09:30-11:00 se solapa en parte con 10:00-11:00
+    const solape = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: `${LIBRE}T09:30`, duracion: 90 } });
+    assert.equal(solape.status, 409);
+    assert.equal(solape.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+
+    // 09:00-10:00 termina justo cuando empieza la de 10:00: no es solaparse
+    const tocando = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-006", pistaId: "pista-1", inicio: `${LIBRE}T09:00`, duracion: 60 } });
+    assert.equal(tocando.status, 201);
+
+    // 11:00-12:00 empieza justo cuando termina la de 10:00-11:00
+    const despues = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-008", pistaId: "pista-1", inicio: `${LIBRE}T11:00`, duracion: 60 } });
+    assert.equal(despues.status, 201);
+  });
+});
+
+test("se solapa con las reservas de 90 minutos que ya existían y las canceladas no ocupan la pista", async () => {
+  await conApi({}, async (api) => {
+    // La pista 1 ya tiene una reserva confirmada el jueves 19 de 18:00 a 19:30.
+    const solapeAntigua = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-19T17:30", duracion: 60 } });
+    assert.equal(solapeAntigua.status, 409);
+    assert.equal(solapeAntigua.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
