+/**
+ * Importe de una reserva por minutos: cada minuto vale el precio de la franja de 90 minutos
+ * dividido entre 90. De lunes a viernes es punta a partir de las 18:00 y valle antes; el fin de
+ * semana es punta todo el día. El total se redondea al céntimo más cercano, y medio céntimo hacia arriba.
+ */
+export function importeReserva(pista: Pista, inicio: string, duracion: number): number {
+  const esFinde = diaDeLaSemana(inicio.slice(0, 10)) === 0 || diaDeLaSemana(inicio.slice(0, 10)) === 6;
+  const inicioMin = minutosDelDia(inicio.slice(11));
+  const finMin = inicioMin + duracion;
+  const INICIO_PUNTA = 18 * 60;
+  let valleMinutos = 0;
+  let puntaMinutos = 0;
+  for (let m = inicioMin; m < finMin; m++) {
+    if (esFinde || m >= INICIO_PUNTA) puntaMinutos += 1;
+    else valleMinutos += 1;
+  }
+  const bruto = (valleMinutos * pista.precioValle + puntaMinutos * pista.precioPunta) / MINUTOS_FRANJA;
+  return Math.round(bruto);
