+/** Minutos desde medianoche de una hora "HH:MM". */
+export function minutosDelDia(hora: string): number {
+  const [h, m] = hora.split(":").map(Number);
+  return h! * 60 + m!;
+}
+
+/** "HH:MM" a partir de los minutos desde medianoche. */
+export function formatearMinutos(total: number): string {
   const hh = String(Math.floor(total / 60)).padStart(2, "0");
   const mm = String(total % 60).padStart(2, "0");
-  return `${inicio.slice(0, 10)}T${hh}:${mm}`;
+  return `${hh}:${mm}`;
+}
+
+/** `inicio` (AAAA-MM-DDTHH:MM) más `minutos`, dentro del mismo día. */
+export function sumarMinutos(inicio: string, minutos: number): string {
+  return `${inicio.slice(0, 10)}T${formatearMinutos(minutosDelDia(inicio.slice(11)) + minutos)}`;
+}
+
+export function finDeFranja(inicio: string): string {
+  return sumarMinutos(inicio, MINUTOS_FRANJA);
+}
+
+export function finDeReserva(inicio: string, duracion: number): string {
+  return sumarMinutos(inicio, duracion);
