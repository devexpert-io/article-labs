+
+    listarEsperas(quien: Socio | undefined, socioId?: string) {
+      const socio = exigirIdentidad(quien);
+      const de = socioId ?? socio.id;
+      if (de !== socio.id && socio.rol !== "gestor") throw new ErrorDelClub("SIN_PERMISO", "Solo un gestor puede ver las esperas de otro socio", 403);
+      return { esperas: estado.esperas.filter((e) => esperaVigente(e) && e.socioId === de).map(conPosicion) };
+    },
+
+    retirarEspera(quien: Socio | undefined, id: string) {
+      const socio = exigirIdentidad(quien);
+      const e = estado.esperas.find((x) => x.id === id);
+      if (!e) throw new ErrorDelClub("ESPERA_NO_ENCONTRADA", `No existe la espera ${id}`, 404);
+      if (e.socioId !== socio.id && socio.rol !== "gestor") throw new ErrorDelClub("SIN_PERMISO", "Solo su dueño o un gestor puede retirar esta espera", 403);
+      if (e.estado !== "activa") throw new ErrorDelClub("ESPERA_NO_ACTIVA", `La espera ya está ${e.estado}`);
+      e.estado = "retirada";
+      return { espera: conPosicion(e) };
     },
   };
 }
