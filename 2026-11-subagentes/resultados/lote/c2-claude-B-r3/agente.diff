+// Códigos de descuento al reservar (docs/specs/codigos-descuento.md), probados a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const reservar = (a: Api, cuerpo: Record<string, unknown>) => a.pedir("POST", "/api/reservas", { cuerpo });
+
+// Fechas sin reservas en la semilla: lunes 30 de noviembre, martes 1 y sábado 5 de diciembre de 2026.
+// Pista 1: valle 1800, punta 2800. Pista 3: valle 1200, punta 2000.
+
+test("sin código, todo igual: importeBase = importe, descuento 0 y sin codigo", async () => {
+  const r = await reservar(api, { socioId: "socio-006", pistaId: "pista-1", inicio: "2026-11-30T12:00" });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.importe, 1800);
+  assert.equal(r.cuerpo.reserva.importeBase, 1800);
+  assert.equal(r.cuerpo.reserva.descuento, 0);
+  assert.equal("codigo" in r.cuerpo.reserva, false);
+});
+
+test("las reservas de la semilla exponen importeBase y descuento coherentes", async () => {
+  const lista = await api.pedir("GET", "/api/reservas?limite=100");
+  for (const r of lista.cuerpo.reservas) {
+    assert.equal(r.importeBase, r.importe);
+    assert.equal(r.descuento, 0);
+    assert.equal(r.codigo, undefined);
+  }
+});
+
+test("BIENVENIDA descuenta el 50 % en la primera reserva y solo en la primera", async () => {
+  const primera = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-05T09:00", codigo: "BIENVENIDA" });
+  assert.equal(primera.status, 201);
+  assert.deepEqual(
+    { importeBase: primera.cuerpo.reserva.importeBase, descuento: primera.cuerpo.reserva.descuento, importe: primera.cuerpo.reserva.importe, codigo: primera.cuerpo.reserva.codigo },
+    { importeBase: 2800, descuento: 1400, importe: 1400, codigo: "BIENVENIDA" },
+  );
+  const segunda = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-05T10:30", codigo: "BIENVENIDA" });
+  assert.equal(segunda.status, 409);
+  assert.equal(segunda.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  // Un socio con historial (aunque sea de reservas canceladas o pasadas) tampoco puede usarlo.
+  const veterano = await reservar(api, { socioId: "socio-016", pistaId: "pista-1", inicio: "2026-12-05T12:00", codigo: "BIENVENIDA" });
+  assert.equal(veterano.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("BIENVENIDA no se puede usar si la hora del club es posterior al 31 de diciembre de 2026", async () => {
+  const otra = await arrancarApi({ AHORA: "2026-12-31T22:00" });
+  try {
+    const ultimoDia = await reservar(otra, { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-04T09:00", codigo: "BIENVENIDA" });
+    assert.equal(ultimoDia.status, 201);
+    assert.equal(ultimoDia.cuerpo.reserva.descuento, 900);
+  } finally {
+    otra.cerrar();
+  }
+  const tarde = await arrancarApi({ AHORA: "2027-01-01T00:00" });
+  try {
+    const r = await reservar(tarde, { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-04T09:00", codigo: "BIENVENIDA" });
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  } finally {
+    tarde.cerrar();
+  }
+});
+
+test("MANANAS descuenta 4 € de lunes a viernes antes de las 12:00 y en otra franja no vale", async () => {
+  const lunes = await reservar(api, { socioId: "socio-020", pistaId: "pista-3", inicio: "2026-11-30T10:30", codigo: "MANANAS" });
+  assert.equal(lunes.status, 201);
+  assert.equal(lunes.cuerpo.reserva.importeBase, 1200);
+  assert.equal(lunes.cuerpo.reserva.descuento, 400);
+  assert.equal(lunes.cuerpo.reserva.importe, 800);
+  assert.equal(lunes.cuerpo.reserva.codigo, "MANANAS");
+  const mediodia = await reservar(api, { socioId: "socio-020", pistaId: "pista-3", inicio: "2026-11-30T12:00", codigo: "MANANAS" });
+  assert.equal(mediodia.status, 409);
+  assert.equal(mediodia.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  const sabado = await reservar(api, { socioId: "socio-020", pistaId: "pista-3", inicio: "2026-12-05T09:00", codigo: "MANANAS" });
+  assert.equal(sabado.status, 409);
+  assert.equal(sabado.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("CLUB10 descuenta el 10 % hasta 3 reservas por socio, sin contar las canceladas", async () => {
+  const otra = await arrancarApi();
+  try {
+    const ids: string[] = [];
+    for (const hora of ["09:00", "10:30", "18:00"]) {
+      const r = await reservar(otra, { socioId: "socio-023", pistaId: "pista-1", inicio: `2026-11-30T${hora}`, codigo: "CLUB10" });
+      assert.equal(r.status, 201);
+      ids.push(r.cuerpo.reserva.id);
+    }
+    const [primera] = (await otra.pedir("GET", `/api/reservas?socio=socio-023&fecha=2026-11-30`)).cuerpo.reservas;
+    assert.equal(primera.importeBase, 1800);
+    assert.equal(primera.descuento, 180);
+    assert.equal(primera.importe, 1620);
+    assert.equal(primera.codigo, "CLUB10");
+
+    // Pasan los días: ya no son reservas futuras, así que el límite de reservas no frena la cuarta.
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T08:00" } });
+    const cuarta = await reservar(otra, { socioId: "socio-023", pistaId: "pista-1", inicio: "2026-12-02T09:00", codigo: "CLUB10" });
+    assert.equal(cuarta.status, 409);
+    assert.equal(cuarta.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+
+    // Con otro socio: si cancela una de sus tres, vuelve a poder usarlo.
+    const otras: string[] = [];
+    for (const hora of ["09:00", "10:30", "12:00"]) {
+      const r = await reservar(otra, { socioId: "socio-024", pistaId: "pista-2", inicio: `2026-12-05T${hora}`, codigo: "club10" });
+      assert.equal(r.status, 201);
+      otras.push(r.cuerpo.reserva.id);
+    }
+    const cancelada = await otra.pedir("POST", `/api/reservas/${otras[0]}/cancelar`);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    const otraVez = await reservar(otra, { socioId: "socio-024", pistaId: "pista-2", inicio: "2026-12-05T13:30", codigo: "CLUB10" });
+    assert.equal(otraVez.status, 201);
+    assert.equal(otraVez.cuerpo.reserva.descuento, 280);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("formato del código: mayúsculas y espacios dan igual; desconocido es 400 CODIGO_INVALIDO; no texto es 400 DATOS_INVALIDOS", async () => {
+  const r = await reservar(api, { socioId: "socio-026", pistaId: "pista-3", inicio: "2026-12-01T09:00", codigo: "  club10 " });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.codigo, "CLUB10");
+  assert.equal(r.cuerpo.reserva.descuento, 120);
+  const desconocido = await reservar(api, { socioId: "socio-026", pistaId: "pista-3", inicio: "2026-12-01T10:30", codigo: "VERANO" });
+  assert.equal(desconocido.status, 400);
+  assert.equal(desconocido.cuerpo.error.codigo, "CODIGO_INVALIDO");
+  for (const codigo of [10, null, true, { codigo: "CLUB10" }]) {
+    const malo = await reservar(api, { socioId: "socio-026", pistaId: "pista-3", inicio: "2026-12-01T10:30", codigo });
+    assert.equal(malo.status, 400, JSON.stringify(codigo));
+    assert.equal(malo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+});
+
+test("un código por reserva: no se acumulan ni se aceptan varios", async () => {
+  const lista = await reservar(api, { socioId: "socio-027", pistaId: "pista-3", inicio: "2026-12-01T10:30", codigo: ["MANANAS", "CLUB10"] });
+  assert.equal(lista.status, 400);
+  assert.equal(lista.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const codigo of ["MANANAS CLUB10", "MANANAS,CLUB10"]) {
+    const juntos = await reservar(api, { socioId: "socio-027", pistaId: "pista-3", inicio: "2026-12-01T10:30", codigo });
+    assert.equal(juntos.status, 400);
+    assert.equal(juntos.cuerpo.error.codigo, "CODIGO_INVALIDO");
+  }
+  const uno = await reservar(api, { socioId: "socio-027", pistaId: "pista-3", inicio: "2026-12-01T10:30", codigo: "MANANAS" });
+  assert.equal(uno.cuerpo.reserva.descuento, 400);
+});
+
+test("los importes se guardan y los devuelven GET /api/reservas/:id y GET /api/reservas", async () => {
+  const creada = await reservar(api, { socioId: "socio-028", pistaId: "pista-1", inicio: "2026-12-01T09:00", codigo: "MANANAS" });
+  const id = creada.cuerpo.reserva.id;
+  const esperado = { importeBase: 1800, descuento: 400, importe: 1400, codigo: "MANANAS" };
+  const una = (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva;
+  assert.deepEqual({ importeBase: una.importeBase, descuento: una.descuento, importe: una.importe, codigo: una.codigo }, esperado);
+  const lista = (await api.pedir("GET", "/api/reservas?socio=socio-028&fecha=2026-12-01")).cuerpo.reservas;
+  const enLista = lista.find((r: { id: string }) => r.id === id);
+  assert.deepEqual({ importeBase: enLista.importeBase, descuento: enLista.descuento, importe: enLista.importe, codigo: enLista.codigo }, esperado);
+});
+
+test("las reglas del club van primero y el código no cuenta como usado", async () => {
+  // Nora ya usó BIENVENIDA en otro test; aquí, un socio sin reservas y con la franja ocupada.
+  const otra = await arrancarApi();
+  try {
+    const ocupada = await reservar(otra, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-19T19:30", codigo: "BIENVENIDA" });
+    assert.equal(ocupada.status, 409);
+    assert.equal(ocupada.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+    const cerrada = await reservar(otra, { socioId: "socio-041", pistaId: "pista-4", inicio: "2026-11-30T09:00", codigo: "VERANO" });
+    assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+    const cuota = await reservar(otra, { socioId: "socio-011", pistaId: "pista-1", inicio: "2026-11-30T09:00", codigo: "MANANAS" });
+    assert.equal(cuota.cuerpo.error.codigo, "CUOTA_INACTIVA");
+    const ocupadaYNoAplica = await reservar(otra, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-19T19:30", codigo: "MANANAS" });
+    assert.equal(ocupadaYNoAplica.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+    // Los intentos fallidos no gastan el código: BIENVENIDA sigue valiendo en su primera reserva.
+    const ahora = await reservar(otra, { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-11-19T19:30", codigo: "BIENVENIDA" });
+    assert.equal(ahora.status, 201);
+    assert.equal(ahora.cuerpo.reserva.descuento, 1400);
+  } finally {
+    otra.cerrar();
+  }
+});
