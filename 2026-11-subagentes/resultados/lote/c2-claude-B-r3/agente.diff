+    case "BIENVENIDA":
+      if (estado.ahora.slice(0, 10) > BIENVENIDA_HASTA) noAplicable(`solo vale hasta el ${BIENVENIDA_HASTA}`);
+      if (delSocio.length > 0) noAplicable("solo vale en la primera reserva del socio");
