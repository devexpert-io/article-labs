+// Reservas de 60, 90 o 120 minutos: duraciones, inicios, solapes, precios y huecos.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Arranca una API aislada, ejecuta la prueba y la cierra. */
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const MAS_TARDE = { AHORA: "2026-11-25T08:00" };
+
+test("duracion es opcional, vale 60, 90 o 120 y cualquier otro valor da DURACION_INVALIDA", async () => {
+  await conApi(MAS_TARDE, async (api) => {
+    const porDefecto = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-012", pistaId: "pista-1", inicio: "2026-11-25T09:00" },
+    });
+    assert.equal(porDefecto.status, 201);
+    assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+    assert.equal(porDefecto.cuerpo.reserva.fin, "2026-11-25T10:30");
+    assert.equal(porDefecto.cuerpo.reserva.importe, 1800);
+
+    const sesenta = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-013", pistaId: "pista-1", inicio: "2026-11-25T10:30", duracion: 60 },
+    });
+    assert.equal(sesenta.status, 201);
+    assert.equal(sesenta.cuerpo.reserva.duracion, 60);
+    assert.equal(sesenta.cuerpo.reserva.fin, "2026-11-25T11:30");
+    assert.equal(sesenta.cuerpo.reserva.importe, 1200);
+
+    const cientoVeinte = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-014", pistaId: "pista-1", inicio: "2026-11-25T12:00", duracion: 120 },
+    });
+    assert.equal(cientoVeinte.status, 201);
+    assert.equal(cientoVeinte.cuerpo.reserva.duracion, 120);
+    assert.equal(cientoVeinte.cuerpo.reserva.fin, "2026-11-25T14:00");
+    assert.equal(cientoVeinte.cuerpo.reserva.importe, 2400);
+
+    for (const duracion of [45, 0, 120.5, 180, -60, "90", null]) {
+      const invalida = await api.pedir("POST", "/api/reservas", {
+        cuerpo: { socioId: "socio-015", pistaId: "pista-2", inicio: "2026-11-25T12:00", duracion },
+      });
+      assert.equal(invalida.status, 400, `duracion ${String(duracion)} debe dar 400`);
+      assert.equal(invalida.cuerpo.error.codigo, "DURACION_INVALIDA");
+    }
+  });
+});
+
+test("inicios en punto o y media, no antes de las 09:00 y fin como muy tarde a las 22:30", async () => {
+  await conApi(MAS_TARDE, async (api) => {
+    for (const inicio of ["2026-11-25T09:15", "2026-11-25T10:45", "2026-11-25T08:30"]) {
+      const invalida = await api.pedir("POST", "/api/reservas", {
+        cuerpo: { socioId: "socio-012", pistaId: "pista-1", inicio, duracion: 60 },
+      });
+      assert.equal(invalida.status, 400, `${inicio} debe dar 400`);
+      assert.equal(invalida.cuerpo.error.codigo, "FRANJA_INVALIDA");
+    }
+
+    const sePasa = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-012", pistaId: "pista-1", inicio: "2026-11-25T21:30", duracion: 120 },
+    });
+    assert.equal(sePasa.status, 400);
+    assert.equal(sePasa.cuerpo.error.codigo, "FRANJA_INVALIDA");
+
+    const sesentaTarde = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-012", pistaId: "pista-1", inicio: "2026-11-25T22:00", duracion: 60 },
+    });
+    assert.equal(sesentaTarde.status, 400);
+    assert.equal(sesentaTarde.cuerpo.error.codigo, "FRANJA_INVALIDA");
+
+    const justoAlCierre = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-013", pistaId: "pista-2", inicio: "2026-11-25T20:30", duracion: 120 },
+    });
+    assert.equal(justoAlCierre.status, 201);
+    assert.equal(justoAlCierre.cuerpo.reserva.fin, "2026-11-25T22:30");
+
+    const hastaElCierre = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-014", pistaId: "pista-3", inicio: "2026-11-25T21:00", duracion: 90 },
+    });
+    assert.equal(hastaElCierre.status, 201);
+    assert.equal(hastaElCierre.cuerpo.reserva.fin, "2026-11-25T22:30");
+  });
+});
+
+test("una reserva no se solapa con las nuevas ni con las de 90 minutos que ya existían", async () => {
+  // Reservas antiguas de la semilla: la pista 1 del jueves 19 a las 19:30 (19:30-21:00).
+  await conApi({}, async (api) => {
+    for (const inicio of ["2026-11-19T19:00", "2026-11-19T19:30", "2026-11-19T20:00", "2026-11-19T20:30"]) {
+      const solapada = await api.pedir("POST", "/api/reservas", {
+        cuerpo: { socioId: "socio-020", pistaId: "pista-1", inicio, duracion: 60 },
+      });
+      assert.equal(solapada.status, 409, `${inicio} se solapa`);
+      assert.equal(solapada.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+    }
+  });
+
+  await conApi(MAS_TARDE, async (api) => {
+    const primera = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-017", pistaId: "pista-2", inicio: "2026-11-26T10:00", duracion: 60 },
+    });
+    assert.equal(primera.status, 201);
+
+    const solapada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-018", pistaId: "pista-2", inicio: "2026-11-26T10:30", duracion: 90 },
+    });
+    assert.equal(solapada.status, 409);
+    assert.equal(solapada.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+
+    const pegada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-018", pistaId: "pista-2", inicio: "2026-11-26T11:00", duracion: 60 },
+    });
+    assert.equal(pegada.status, 201, "terminar justo cuando empieza otra no es solaparse");
+
