+ * con el medio céntimo hacia arriba.
+ */
+export function precioReserva(pista: Pista, inicio: string, duracion: number): number {
+  let minutosValle = 0;
+  let minutosPunta = 0;
+  const comienzo = Date.parse(`${inicio}:00Z`);
+  for (let minuto = 0; minuto < duracion; minuto += 1) {
+    const instante = new Date(comienzo + minuto * 60_000).toISOString().slice(0, 16);
+    if (esPunta(instante)) minutosPunta += 1;
+    else minutosValle += 1;
+  }
+  const centimos = minutosValle * pista.precioValle + minutosPunta * pista.precioPunta;
+  return Math.floor((centimos + MINUTOS_FRANJA / 2) / MINUTOS_FRANJA);
