+test("las reglas del club siguen: cuota, pista cerrada, franja pasada y máximo de reservas", async () => {
+  await conApi({ AHORA: "2026-11-29T10:00" }, async (api) => {
+    const sinCuota = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-011", pistaId: "pista-1", inicio: "2026-11-29T12:00", duracion: 60 },
+    });
+    assert.equal(sinCuota.status, 409);
+    assert.equal(sinCuota.cuerpo.error.codigo, "CUOTA_INACTIVA");
+
+    const cerrada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-012", pistaId: "pista-4", inicio: "2026-11-29T12:00", duracion: 60 },
+    });
+    assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+
+    const pasada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-012", pistaId: "pista-1", inicio: "2026-11-29T09:00", duracion: 60 },
+    });
+    assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+
+    // Nora no tiene reservas: tres de 60 minutos agotan su límite.
+    for (const hora of ["12:00", "13:00", "14:00"]) {
+      const creada = await api.pedir("POST", "/api/reservas", {
+        cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `2026-11-29T${hora}`, duracion: 60 },
+      });
+      assert.equal(creada.status, 201);
+    }
+    const cuarta = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-29T15:00", duracion: 60 },
+    });
+    assert.equal(cuarta.status, 409);
+    assert.equal(cuarta.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+  });
+});
