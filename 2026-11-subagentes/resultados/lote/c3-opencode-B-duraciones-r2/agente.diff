+test("disponibilidad: franjas reservadas por solape parcial y huecos libres", async () => {
+  await conApi(MAS_TARDE, async (api) => {
+    const fecha = "2026-11-27";
+    const inicial = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`);
+    const pista1Inicial = inicial.cuerpo.pistas.find((p: any) => p.pistaId === "pista-1");
+    assert.deepEqual(pista1Inicial.huecos, [{ inicio: `${fecha}T09:00`, fin: `${fecha}T22:30` }]);
+    const pistaCerrada = inicial.cuerpo.pistas.find((p: any) => p.pistaId === "pista-4");
+    assert.deepEqual(pistaCerrada.huecos, []);
+
+    const once = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-012", pistaId: "pista-1", inicio: `${fecha}T11:00`, duracion: 60 },
+    });
+    assert.equal(once.status, 201);
+
+    const conUna = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`);
+    const pista1 = conUna.cuerpo.pistas.find((p: any) => p.pistaId === "pista-1");
+    const franja = (hora: string) => pista1.franjas.find((f: any) => f.inicio === `${fecha}T${hora}`).estado;
+    assert.equal(franja("10:30"), "reservada", "una reserva de 11:00 a 12:00 ocupa parte de la franja 10:30-12:00");
+    assert.equal(franja("09:00"), "libre");
+    assert.equal(franja("12:00"), "libre");
+    assert.deepEqual(pista1.huecos, [
+      { inicio: `${fecha}T09:00`, fin: `${fecha}T11:00` },
+      { inicio: `${fecha}T12:00`, fin: `${fecha}T22:30` },
+    ]);
+
+    await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-013", pistaId: "pista-1", inicio: `${fecha}T12:00`, duracion: 60 },
+    });
+    const conDos = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`);
+    const pista1Dos = conDos.cuerpo.pistas.find((p: any) => p.pistaId === "pista-1");
+    assert.deepEqual(pista1Dos.huecos, [
+      { inicio: `${fecha}T09:00`, fin: `${fecha}T11:00` },
+      { inicio: `${fecha}T13:00`, fin: `${fecha}T22:30` },
+    ]);
+    const pista2 = conDos.cuerpo.pistas.find((p: any) => p.pistaId === "pista-2");
+    assert.deepEqual(pista2.huecos, [{ inicio: `${fecha}T09:00`, fin: `${fecha}T22:30` }]);
+
+    // Los huecos no dependen de la hora actual.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: `${fecha}T15:00` } });
+    const masTarde = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`);
+    const pista1Tarde = masTarde.cuerpo.pistas.find((p: any) => p.pistaId === "pista-1");
+    assert.equal(pista1Tarde.huecos[0].inicio, `${fecha}T09:00`);
+  });
+});
