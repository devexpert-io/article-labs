+  assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("DELETE", `/api/esperas/${ids[0]}`)).status, 401);
+  const propia = await api.pedir("DELETE", `/api/esperas/${ids[0]}`, { socio: "socio-003" });
+  assert.equal(propia.status, 200);
+  assert.equal(propia.cuerpo.espera.estado, "retirada");
+  assert.equal(propia.cuerpo.espera.posicion, undefined);
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-006" })).cuerpo.esperas[0].posicion, 1);
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-008" })).cuerpo.esperas[0].posicion, 2);
+  assert.deepEqual((await api.pedir("GET", "/api/esperas", { socio: "socio-003" })).cuerpo.esperas, []);
