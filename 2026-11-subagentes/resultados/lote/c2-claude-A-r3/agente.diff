+// Lista de espera de franjas (docs/specs/lista-espera.md).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+// Ocupadas en la semilla: la pista 1 el jueves 19 a las 19:30 (socio-007), la pista 3 el jueves 19 a las 09:00
+// (Marta López, R-0520, a 23 horas) y la pista 1 el lunes 23 a las 18:00 (Irene Sanz, a más de 24 horas).
+const JUEVES = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+const MARTA = { pistaId: "pista-3", inicio: "2026-11-19T09:00" };
+const LUNES = { pistaId: "pista-1", inicio: "2026-11-23T18:00" };
+
+/** Cada test arranca su propia API para no arrastrar esperas de otros. */
+async function conApi(probar: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await probar(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const apuntar = (api: Api, socio: string | undefined, cuerpo: unknown) => api.pedir("POST", "/api/esperas", { cuerpo, socio });
+
+async function idReserva(api: Api, franja: { pistaId: string; inicio: string }): Promise<string> {
+  const r = await api.pedir("GET", `/api/reservas?fecha=${franja.inicio.slice(0, 10)}&pista=${franja.pistaId}&estado=confirmada`);
+  return r.cuerpo.reservas.find((x: { inicio: string }) => x.inicio === franja.inicio).id;
+}
+
+test("apuntarse a una franja ocupada", () => conApi(async (api) => {
+  const r = await apuntar(api, "socio-003", JUEVES);
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.cuerpo.espera, { id: r.cuerpo.espera.id, socioId: "socio-003", ...JUEVES, estado: "activa", posicion: 1 });
+  const anonimo = await apuntar(api, undefined, JUEVES);
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+}));
+
+test("solo se esperan franjas ocupadas que se podrían reservar", () => conApi(async (api) => {
