+  const ajeno = await api.pedir("GET", "/api/esperas?socio=socio-008", { socio: "socio-003" });
+  assert.equal(ajeno.status, 403);
+  assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("GET", "/api/esperas?socio=socio-003", { socio: "socio-003" })).status, 200);
+  const anonimo = await api.pedir("GET", "/api/esperas");
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+}));
