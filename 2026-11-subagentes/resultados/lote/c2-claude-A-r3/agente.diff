+test("sin duplicados, sin esperar lo que ya es tuyo y como mucho 2 esperas activas", () => conApi(async (api) => {
+  assert.equal((await apuntar(api, "socio-003", JUEVES)).status, 201);
+  const otraVez = await apuntar(api, "socio-003", JUEVES);
+  assert.equal(otraVez.cuerpo.error.codigo, "YA_EN_ESPERA");
+  const suya = await apuntar(api, "socio-007", JUEVES);
+  assert.equal(suya.cuerpo.error.codigo, "YA_RESERVADA");
