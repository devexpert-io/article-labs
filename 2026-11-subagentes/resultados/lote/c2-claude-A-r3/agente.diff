+// Códigos de descuento al reservar (docs/specs/codigos-descuento.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Miércoles 25 de noviembre: fuera de la semilla, todas las franjas libres. Pista 3: 12,00 € valle, 20,00 € punta.
+const MIERCOLES = "2026-11-25";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const reservar = (a: Api, cuerpo: Record<string, unknown>) => a.pedir("POST", "/api/reservas", { cuerpo });
+
+test("sin código, la reserva se crea como antes, con importeBase y descuento 0", async () => {
+  const r = await reservar(api, { socioId: "socio-003", pistaId: "pista-3", inicio: `${MIERCOLES}T09:00` });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.importe, 1200);
+  assert.equal(r.cuerpo.reserva.importeBase, 1200);
+  assert.equal(r.cuerpo.reserva.descuento, 0);
+  assert.equal("codigo" in r.cuerpo.reserva, false);
+});
+
+test("BIENVENIDA: 50 % en la primera reserva del socio", async () => {
+  const yaTiene = await reservar(api, { socioId: "socio-004", pistaId: "pista-3", inicio: `${MIERCOLES}T19:30`, codigo: "BIENVENIDA" });
+  assert.equal(yaTiene.status, 409);
+  assert.equal(yaTiene.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  // Nora Benítez no tiene ninguna reserva.
+  const nora = await reservar(api, { socioId: "socio-041", pistaId: "pista-3", inicio: `${MIERCOLES}T19:30`, codigo: "BIENVENIDA" });
+  assert.equal(nora.status, 201);
+  assert.equal(nora.cuerpo.reserva.importeBase, 2000);
+  assert.equal(nora.cuerpo.reserva.descuento, 1000);
+  assert.equal(nora.cuerpo.reserva.importe, 1000);
+  assert.equal(nora.cuerpo.reserva.codigo, "BIENVENIDA");
+  // Ya no es su primera reserva, aunque la cancele.
+  await api.pedir("POST", `/api/reservas/${nora.cuerpo.reserva.id}/cancelar`);
+  const otra = await reservar(api, { socioId: "socio-041", pistaId: "pista-3", inicio: `${MIERCOLES}T21:00`, codigo: "BIENVENIDA" });
+  assert.equal(otra.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("BIENVENIDA caduca después del 31 de diciembre de 2026", async () => {
+  const otra = await arrancarApi({ AHORA: "2026-12-31T23:00" });
+  try {
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-01T08:00" } });
+    const tarde = await reservar(otra, { socioId: "socio-041", pistaId: "pista-3", inicio: "2027-01-04T09:00", codigo: "BIENVENIDA" });
+    assert.equal(tarde.status, 409);
+    assert.equal(tarde.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-31T23:59" } });
+    const aTiempo = await reservar(otra, { socioId: "socio-041", pistaId: "pista-3", inicio: "2027-01-04T09:00", codigo: "BIENVENIDA" });
+    assert.equal(aTiempo.status, 201);
+    assert.equal(aTiempo.cuerpo.reserva.importe, 600);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("MANANAS: 4,00 € en franjas de lunes a viernes antes de las 12:00", async () => {
+  const manana = await reservar(api, { socioId: "socio-006", pistaId: "pista-3", inicio: `${MIERCOLES}T10:30`, codigo: "MANANAS" });
+  assert.equal(manana.status, 201);
+  assert.equal(manana.cuerpo.reserva.importeBase, 1200);
+  assert.equal(manana.cuerpo.reserva.descuento, 400);
+  assert.equal(manana.cuerpo.reserva.importe, 800);
+  assert.equal(manana.cuerpo.reserva.codigo, "MANANAS");
+  for (const inicio of [`${MIERCOLES}T12:00`, "2026-11-28T09:00", "2026-11-29T10:30"]) {
+    const r = await reservar(api, { socioId: "socio-006", pistaId: "pista-2", inicio, codigo: "MANANAS" });
+    assert.equal(r.status, 409, inicio);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE", inicio);
+  }
+});
+
+test("CLUB10: 10 % y como mucho 3 reservas por socio, sin contar las canceladas", async () => {
+  const otra = await arrancarApi();
+  try {
+    const ids: string[] = [];
+    for (const hora of ["09:00", "10:30", "12:00"]) {
+      const r = await reservar(otra, { socioId: "socio-041", pistaId: "pista-1", inicio: `${MIERCOLES}T${hora}`, codigo: "CLUB10" });
+      assert.equal(r.status, 201);
+      assert.equal(r.cuerpo.reserva.descuento, 180);
+      assert.equal(r.cuerpo.reserva.importe, 1620);
+      ids.push(r.cuerpo.reserva.id);
+    }
+    // La cancelada no cuenta: se puede volver a usar.
+    await otra.pedir("POST", `/api/reservas/${ids[0]}/cancelar`);
+    const cuarta = await reservar(otra, { socioId: "socio-041", pistaId: "pista-1", inicio: `${MIERCOLES}T18:00`, codigo: "CLUB10" });
+    assert.equal(cuarta.status, 201);
+    assert.equal(cuarta.cuerpo.reserva.descuento, 280);
+    // Ya tiene 3 confirmadas con CLUB10. Cuando pasan, siguen contando.
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T08:00" } });
+    const quinta = await reservar(otra, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-27T09:00", codigo: "CLUB10" });
+    assert.equal(quinta.status, 409);
+    assert.equal(quinta.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+    const sinCodigo = await reservar(otra, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-27T09:00" });
+    assert.equal(sinCodigo.status, 201);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("el código no distingue mayúsculas ni espacios y tiene que existir", async () => {
+  const r = await reservar(api, { socioId: "socio-006", pistaId: "pista-1", inicio: `${MIERCOLES}T13:30`, codigo: "  club10 " });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.codigo, "CLUB10");
+  assert.equal(r.cuerpo.reserva.importe, 1620);
+  for (const codigo of ["XYZ", "", "CLUB10 MANANAS", "CLUB10,MANANAS", "toString", "__proto__"]) {
+    const malo = await reservar(api, { socioId: "socio-006", pistaId: "pista-1", inicio: `${MIERCOLES}T15:00`, codigo });
+    assert.equal(malo.status, 400, codigo);
+    assert.equal(malo.cuerpo.error.codigo, "CODIGO_INVALIDO", codigo);
+  }
+  for (const codigo of [10, null, true, ["CLUB10", "MANANAS"], { codigo: "CLUB10" }]) {
+    const malo = await reservar(api, { socioId: "socio-006", pistaId: "pista-1", inicio: `${MIERCOLES}T15:00`, codigo });
+    assert.equal(malo.status, 400, JSON.stringify(codigo));
+    assert.equal(malo.cuerpo.error.codigo, "DATOS_INVALIDOS", JSON.stringify(codigo));
+  }
+});
+
+test("GET /api/reservas/:id y GET /api/reservas devuelven los importes y el código", async () => {
+  const r = await reservar(api, { socioId: "socio-006", pistaId: "pista-2", inicio: `${MIERCOLES}T09:00`, codigo: "mananas" });
+  const id = r.cuerpo.reserva.id;
+  const una = (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva;
+  assert.deepEqual([una.importeBase, una.descuento, una.importe, una.codigo], [1800, 400, 1400, "MANANAS"]);
+  const lista = (await api.pedir("GET", `/api/reservas?fecha=${MIERCOLES}&pista=pista-2`)).cuerpo.reservas;
+  assert.deepEqual(lista.find((x: { id: string }) => x.id === id), una);
+});
+
+test("las reglas del club van primero y, si fallan, el código no cuenta como usado", async () => {
+  const otra = await arrancarApi();
+  try {
+    const cerrada = await reservar(otra, { socioId: "socio-041", pistaId: "pista-4", inicio: `${MIERCOLES}T09:00`, codigo: "BIENVENIDA" });
+    assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+    const pasada = await reservar(otra, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-18T09:00", codigo: "NOEXISTE" });
+    assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+    const ocupada = await reservar(otra, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-19T19:30", codigo: "BIENVENIDA" });
+    assert.equal(ocupada.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+    const cuota = await reservar(otra, { socioId: "socio-022", pistaId: "pista-1", inicio: `${MIERCOLES}T09:00`, codigo: "BIENVENIDA" });
+    assert.equal(cuota.cuerpo.error.codigo, "CUOTA_INACTIVA");
+    // socio-017 ya tiene 3 reservas futuras.
+    const limite = await reservar(otra, { socioId: "socio-017", pistaId: "pista-1", inicio: `${MIERCOLES}T09:00`, codigo: "CLUB10" });
+    assert.equal(limite.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+    // Ningún intento fallido gastó la bienvenida de Nora.
+    const nora = await reservar(otra, { socioId: "socio-041", pistaId: "pista-1", inicio: `${MIERCOLES}T09:00`, codigo: "BIENVENIDA" });
+    assert.equal(nora.status, 201);
+    assert.equal(nora.cuerpo.reserva.importe, 900);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("la penalización por cancelar fuera de plazo es lo que paga el socio, con el descuento", async () => {
+  const otra = await arrancarApi();
+  try {
+    const r = await reservar(otra, { socioId: "socio-006", pistaId: "pista-3", inicio: `${MIERCOLES}T10:30`, codigo: "MANANAS" });
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: `${MIERCOLES}T09:00` } });
+    const cancelada = await otra.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 800);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("la disponibilidad sigue mostrando el precio sin descuento", async () => {
+  const d = await api.pedir("GET", `/api/disponibilidad?fecha=${MIERCOLES}&pista=pista-3`);
+  const franja = d.cuerpo.pistas[0].franjas.find((f: { inicio: string }) => f.inicio === `${MIERCOLES}T10:30`);
+  assert.equal(franja.estado, "reservada");
+  assert.equal(franja.precio, 1200);
+});
