+test("la posición es el orden de llegada y GET /api/esperas la devuelve", () => conApi(async (api) => {
+  for (const socio of ["socio-003", "socio-006", "socio-008"]) await apuntar(api, socio, JUEVES);
+  await apuntar(api, "socio-006", LUNES);
