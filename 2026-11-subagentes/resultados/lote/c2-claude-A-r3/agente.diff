+    ["socio-003", { pistaId: "pista-9", inicio: "2026-11-19T19:30" }, 404, "PISTA_NO_ENCONTRADA"],
+    ["socio-003", { pistaId: "pista-4", inicio: "2026-11-19T19:30" }, 409, "PISTA_CERRADA"],
+    ["socio-003", { pistaId: "pista-1", inicio: "2026-11-19T19:00" }, 400, "FRANJA_INVALIDA"],
+    ["socio-003", { pistaId: "pista-1", inicio: "2026-11-18T09:00" }, 409, "FRANJA_PASADA"],
+    ["socio-022", JUEVES, 409, "CUOTA_INACTIVA"],
+    ["socio-003", { pistaId: "pista-1" }, 400, "DATOS_INVALIDOS"],
+  ];
+  for (const [socio, cuerpo, http, codigo] of casos) {
+    const r = await apuntar(api, socio, cuerpo);
+    assert.equal(r.status, http, codigo);
+    assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+}));
