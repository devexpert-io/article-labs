+test("duraciones válidas, valor por defecto y errores de duración e inicio", async () => {
+  const base = { socioId: "socio-041", pistaId: "pista-2" };
+  const unaHora = await api.pedir("POST", "/api/reservas", { cuerpo: { ...base, inicio: "2026-12-01T09:30", duracion: 60 } });
+  assert.equal(unaHora.status, 201);
+  assert.equal(unaHora.cuerpo.reserva.fin, "2026-12-01T10:30");
+  assert.equal(unaHora.cuerpo.reserva.duracion, 60);
+  const porDefecto = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-2", inicio: "2026-12-01T11:00" } });
+  assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+  const dosHoras = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-005", pistaId: "pista-2", inicio: "2026-12-01T13:00", duracion: 120 } });
+  assert.equal(dosHoras.cuerpo.reserva.fin, "2026-12-01T15:00");
+  for (const duracion of [0, 30, 90.5, "60"]) {
+    const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { ...base, inicio: "2026-12-01T15:30", duracion } });
+    assert.equal(respuesta.status, 400);
+    assert.equal(respuesta.cuerpo.error.codigo, "DURACION_INVALIDA");
+  }
+  for (const inicio of ["2026-12-01T08:30", "2026-12-01T09:15", "2026-12-01T22:00", "2026-12-01T22:30"]) {
+    const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-006", pistaId: "pista-2", inicio, duracion: 60 } });
+    assert.equal(respuesta.status, 400);
+    assert.equal(respuesta.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  }
+});
+
+test("solapes, precio por minuto, franjas y huecos respetan la duración", async () => {
