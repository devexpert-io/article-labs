+  const reserva = creado.cuerpo.reserva;
+  assert.equal(reserva.importe, 2467, "media hora valle y una hora punta se redondean al céntimo");
+  assert.equal(reserva.duracion, 90);
+  const choque = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T18:30", duracion: 60 } });
+  assert.equal(choque.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  const contiguas = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T19:00", duracion: 60 } });
+  assert.equal(contiguas.status, 201);
+  const sabado = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-006", pistaId: "pista-3", inicio: "2026-12-05T17:30", duracion: 60 } });
+  assert.equal(sabado.cuerpo.reserva.importe, 1333, "sábado aplica punta todo el día");
+  const datos = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-01&pista=pista-1")).cuerpo.pistas[0];
