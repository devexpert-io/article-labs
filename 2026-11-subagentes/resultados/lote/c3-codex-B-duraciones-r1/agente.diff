+export function precio(pista: Pista, inicio: string, duracion = MINUTOS_FRANJA): number {
+  const sabadoODomingo = diaDeLaSemana(inicio.slice(0, 10)) === 0 || diaDeLaSemana(inicio.slice(0, 10)) === 6;
+  let valle = 0;
+  let punta = 0;
+  for (let minuto = 0; minuto < duracion; minuto++) {
+    const instante = Date.parse(`${inicio.slice(0, 10)}T${inicio.slice(11)}:00Z`) + minuto * 60_000;
+    const hora = new Date(instante).getUTCHours();
+    if (sabadoODomingo || hora >= 18) punta++;
+    else valle++;
+  }
+  return Math.floor((valle * pista.precioValle + punta * pista.precioPunta + 45) / 90);
 }
 
