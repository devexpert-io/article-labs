+  assert.deepEqual((await disponibilidad(api)).huecos, [{ inicio: "2026-11-25T09:00", fin: "2026-11-25T22:30" }]);
+  const primera = await crear(api, "2026-11-25T10:00", 60);
+  const segunda = await crear(api, "2026-11-25T11:00", 120);
+  const tercera = await crear(api, "2026-11-25T21:30", 60);
+  assert.equal(primera.status, 201);
+  assert.equal(segunda.status, 201);
+  assert.equal(tercera.status, 201);
+  const d = await disponibilidad(api);
+  assert.deepEqual(d.huecos, [
+    { inicio: "2026-11-25T09:00", fin: "2026-11-25T10:00" },
+    { inicio: "2026-11-25T13:00", fin: "2026-11-25T21:30" },
