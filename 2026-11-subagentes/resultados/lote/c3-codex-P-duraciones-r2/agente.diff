+    assert.equal(rechazada.status, 409);
+    assert.equal(rechazada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await cancelar(api, tarde.cuerpo.reserva.id, true);
+    assert.equal(forzada.penalizacion, tarde.cuerpo.reserva.importe);
