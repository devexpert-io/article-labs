+  assert.deepEqual(d.franjas.filter((f: any) => f.estado === "reservada").map((f: any) => f.inicio.slice(11)), ["09:00", "10:30", "12:00", "21:00"]);
+  await cancelar(api, primera.cuerpo.reserva.id);
+  assert.deepEqual((await disponibilidad(api)).huecos[0], { inicio: "2026-11-25T09:00", fin: "2026-11-25T11:00" });
+  const cerrada = await disponibilidad(api, "2026-11-25", "pista-4");
+  assert.deepEqual(cerrada.huecos, []);
+  assert.ok(cerrada.franjas.every((f: any) => f.estado === "cerrada"));
+  const antes = await disponibilidad(api);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T20:00" } });
+  assert.deepEqual(await disponibilidad(api), antes);
+  const antigua = await disponibilidad(api, "2026-11-19");
+  assert.ok(antigua.huecos.every((h: any) => h.fin <= "2026-11-19T18:00" || h.inicio >= "2026-11-19T21:00"));
