--- /dev/null
+++ b/test/duraciones.test.ts
@@ -0,0 +1,208 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function preparar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+function crear(api: Api, inicio: string, duracion?: unknown, otros: Record<string, unknown> = {}) {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio, duracion, ...otros } });
+}
+
+async function cancelar(api: Api, id: string, forzar = false) {
+  const respuesta = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { forzar } });
+  assert.equal(respuesta.status, 200);
+  return respuesta.cuerpo.reserva;
+}
+
+async function disponibilidad(api: Api, fecha = "2026-11-25", pista = "pista-1") {
+  const respuesta = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pista}`);
+  assert.equal(respuesta.status, 200);
+  return respuesta.cuerpo.pistas[0];
+}
+
+test("duraciones admitidas, valor por defecto y fin calculado", async (t) => {
+  const api = await preparar(t);
+  for (const [duracion, minutos, fin] of [[undefined, 90, "10:30"], [60, 60, "10:00"], [90, 90, "10:30"], [120, 120, "11:00"]] as const) {
+    const r = await crear(api, "2026-11-25T09:00", duracion);
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.duracion, minutos);
+    assert.equal(r.cuerpo.reserva.fin, `2026-11-25T${fin}`);
+    await cancelar(api, r.cuerpo.reserva.id);
+  }
+  for (const duracion of [null, 0, -60, 30, 61, 180, 90.5, "60", true, {}, []]) {
+    const r = await crear(api, "2026-11-25T09:00", duracion);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA");
+  }
+});
+
+test("inicios en punto o y media dentro del horario, incluido el cierre exacto", async (t) => {
+  const api = await preparar(t);
+  for (const [hora, duracion] of [["09:00", 60], ["09:30", 90], ["20:30", 120], ["21:00", 90], ["21:30", 60]] as const) {
+    const r = await crear(api, `2026-11-25T${hora}`, duracion);
+    assert.equal(r.status, 201, hora);
+    await cancelar(api, r.cuerpo.reserva.id);
+  }
+  for (const [hora, duracion] of [["08:30", 120], ["09:15", 60], ["09:60", 60], ["21:00", 120], ["21:30", 90], ["22:00", 60], ["24:00", 60]] as const) {
+    const r = await crear(api, `2026-11-25T${hora}`, duracion);
+    assert.equal(r.status, 400, hora);
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  }
+  const sinFormato = await crear(api, "2026-11-25 09:00", 60);
+  assert.equal(sinFormato.cuerpo.error.codigo, "FRANJA_INVALIDA");
+});
+
+test("solapes parciales, contenidos y adyacencia con reservas nuevas y antiguas", async (t) => {
+  const api = await preparar(t);
+  const primera = await crear(api, "2026-11-25T10:00", 120);
+  assert.equal(primera.status, 201);
+  for (const [hora, duracion] of [["09:00", 90], ["09:30", 120], ["10:00", 60], ["10:30", 60], ["11:30", 60]] as const) {
+    const r = await crear(api, `2026-11-25T${hora}`, duracion);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  }
+  assert.equal((await crear(api, "2026-11-25T09:00", 60)).status, 201);
+  assert.equal((await crear(api, "2026-11-25T12:00", 60)).status, 201);
+  await cancelar(api, primera.cuerpo.reserva.id);
+  assert.equal((await crear(api, "2026-11-25T10:00", 120)).status, 201, "una cancelada deja de ocupar");
+  const antigua = await crear(api, "2026-11-19T20:00", 60);
+  assert.equal(antigua.status, 409);
+  assert.equal(antigua.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  assert.equal((await crear(api, "2026-11-25T10:00", 60, { pistaId: "pista-2", socioId: "socio-004" })).status, 201);
+});
+
+test("precio por minutos en valle, punta, cruces y ambos días del fin de semana", async (t) => {
+  const api = await preparar(t);
+  const casos = [
+    ["2026-11-25T12:00", 60, "pista-1", 1200],
+    ["2026-11-25T12:00", 120, "pista-1", 2400],
+    ["2026-11-25T18:00", 60, "pista-1", 1867],
+    ["2026-11-25T17:30", 90, "pista-1", 2467],
+    ["2026-11-25T17:30", 120, "pista-1", 3400],
+    ["2026-11-25T17:00", 90, "pista-3", 1467],
+    ["2026-11-28T09:00", 60, "pista-1", 1867],
+    ["2026-11-29T09:00", 120, "pista-3", 2667],
+  ] as const;
+  for (const [inicio, duracion, pistaId, importe] of casos) {
+    const r = await crear(api, inicio, duracion, { pistaId });
+    assert.equal(r.status, 201, inicio);
+    assert.equal(r.cuerpo.reserva.importe, importe, inicio);
+    await cancelar(api, r.cuerpo.reserva.id);
+  }
+});
+
+test("las nueve franjas tradicionales mantienen sus precios de 90 minutos", async (t) => {
+  const api = await preparar(t);
+  for (const fecha of ["2026-11-25", "2026-11-28"]) {
+    for (const [pistaId, valle, punta] of [["pista-1", 1800, 2800], ["pista-2", 1800, 2800], ["pista-3", 1200, 2000]] as const) {
+      const d = await disponibilidad(api, fecha, pistaId);
+      assert.equal(d.franjas.length, 9);
+      for (const f of d.franjas) {
+        const esperado = fecha === "2026-11-28" || f.inicio.slice(11) >= "18:00" ? punta : valle;
+        const r = await crear(api, f.inicio, undefined, { pistaId });
+        assert.equal(r.status, 201);
+        assert.equal(r.cuerpo.reserva.importe, esperado);
+        assert.equal(f.precio, esperado);
+        await cancelar(api, r.cuerpo.reserva.id);
+      }
