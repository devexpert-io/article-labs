+test("cuota, pista cerrada, reloj y máximo de tres futuras se aplican a cualquier duración", async (t) => {
+  const api = await preparar(t);
+  for (const duracion of [60, 90, 120]) {
+    for (const [inicio, otros, codigo] of [
