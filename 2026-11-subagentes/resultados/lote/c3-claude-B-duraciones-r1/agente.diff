+// Reservas de 60, 90 o 120 minutos, probadas a través de la API.
+// Cada test trabaja en días que la semilla deja libres (desde el 25 de noviembre), para no depender de la ocupación al azar.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { importeDeReserva } from "../src/semilla.ts";
+import type { Pista } from "../src/tipos.ts";
+
+let api: Api;
+/** Reservas futuras confirmadas por socio, contando también las que hacen estos tests. */
+const futuras = new Map<string, number>();
+
+before(async () => {
+  api = await arrancarApi();
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  for (const r of estado.reservas) {
+    if (r.estado === "confirmada" && r.inicio > estado.ahora) futuras.set(r.socioId, (futuras.get(r.socioId) ?? 0) + 1);
+  }
+});
+after(() => api.cerrar());
+
+// Socios de la semilla con cuota al día. socio-011, socio-022 y socio-033 tienen la cuota inactiva.
+const SOCIOS_CON_CUOTA = Array.from({ length: 41 }, (_, i) => `socio-${String(i + 1).padStart(3, "0")}`)
+  .filter((id) => !["socio-011", "socio-022", "socio-033"].includes(id));
+
+function socioCon(criterio: (id: string) => boolean): string {
+  const id = SOCIOS_CON_CUOTA.find(criterio);
+  if (!id) throw new Error("no hay socios disponibles para el test");
+  return id;
+}
+
+/** Un socio con cuota al día y sitio para una reserva futura más. */
+function socioDisponible(): string {
+  return socioCon((id) => (futuras.get(id) ?? 0) < 3);
+}
+
+/** Un socio sin ninguna reserva futura. */
+function socioSinReservas(): string {
+  return socioCon((id) => (futuras.get(id) ?? 0) === 0);
+}
+
+/** Hace una reserva. Si no se da socio, usa uno que tenga sitio en su límite. */
+async function reservar(datos: Record<string, unknown>, socioId = socioDisponible()) {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, ...datos } });
+  if (respuesta.status === 201) futuras.set(socioId, (futuras.get(socioId) ?? 0) + 1);
+  return respuesta;
+}
+
+async function disponibilidad(fecha: string, pistaId: string, club: Api = api) {
+  const r = await club.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pistaId}`);
+  assert.equal(r.status, 200);
+  return r.cuerpo.pistas[0];
+}
+
+function pista(valle: number, punta: number): Pista {
+  return { id: "prueba", nombre: "Prueba", tipo: "muro", cubierta: false, estado: "operativa", precioValle: valle, precioPunta: punta };
+}
+
+test("la duración es opcional: 90 por defecto, y 60, 90 o 120 minutos", async () => {
+  const porDefecto = await reservar({ pistaId: "pista-1", inicio: "2026-11-25T09:00" });
+  assert.equal(porDefecto.status, 201);
+  assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+  assert.equal(porDefecto.cuerpo.reserva.fin, "2026-11-25T10:30");
+
+  const una = await reservar({ pistaId: "pista-1", inicio: "2026-11-25T10:30", duracion: 60 });
+  assert.equal(una.status, 201);
+  assert.equal(una.cuerpo.reserva.duracion, 60);
+  assert.equal(una.cuerpo.reserva.fin, "2026-11-25T11:30");
+
+  const dos = await reservar({ pistaId: "pista-1", inicio: "2026-11-25T12:00", duracion: 120 });
+  assert.equal(dos.status, 201);
+  assert.equal(dos.cuerpo.reserva.duracion, 120);
+  assert.equal(dos.cuerpo.reserva.fin, "2026-11-25T14:00");
+});
+
+test("una duración distinta de 60, 90 o 120 responde 400 DURACION_INVALIDA", async () => {
+  for (const duracion of [45, 0, 75, 150, "90", null, true]) {
+    const r = await reservar({ pistaId: "pista-1", inicio: "2026-11-25T15:00", duracion });
+    assert.equal(r.status, 400, `duracion ${JSON.stringify(duracion)}`);
+    assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA", `duracion ${JSON.stringify(duracion)}`);
+  }
+});
+
+test("el inicio debe ser en punto o y media, no antes de las 09:00 y con fin como muy tarde a las 22:30", async () => {
+  const invalidas: [string, number][] = [
+    ["2026-11-25T09:15", 60], // no es en punto ni y media
+    ["2026-11-25T10:45", 90],
+    ["2026-11-25T08:30", 60], // antes de la apertura
