+
+/** Importe de una reserva por minutos: valle antes de las 18:00 entre semana, punta el resto. Redondea al céntimo, medio céntimo hacia arriba. */
+export function precioPorMinutos(pista: Pista, inicio: string, duracion: number): number {
+  const dia = diaDeLaSemana(inicio.slice(0, 10));
+  const [h, m] = inicio.slice(11).split(":").map(Number);
+  const inicioMin = h! * 60 + m!;
+  const finMin = inicioMin + duracion;
+  let valle = 0;
+  let punta = 0;
+  if (dia === 0 || dia === 6) {
+    punta = duracion;
+  } else {
+    valle = Math.max(0, Math.min(finMin, 18 * 60) - inicioMin);
+    punta = duracion - valle;
+  }
+  const centimos = valle * pista.precioValle + punta * pista.precioPunta;
+  return Math.floor((centimos + 45) / 90);
+}
