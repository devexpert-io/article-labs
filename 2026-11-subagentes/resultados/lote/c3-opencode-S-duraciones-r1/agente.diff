@@ -0,0 +1,254 @@
+// La feature de duraciones (reservas de 60, 90 o 120 minutos), probada a través de la API.
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+beforeEach(async () => {
+  api = await arrancarApi();
+});
+afterEach(() => api.cerrar());
+
+const MARTES = "2026-12-01"; // entre semana
+const SABADO = "2026-12-05"; // fin de semana
+
+/** Un socio con la cuota al día y sin reservas futuras, para no chocar con el límite de tres. */
+async function nuevoSocio(): Promise<string> {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const ocupados = new Set(
+    estado.reservas
+      .filter((r: { estado: string; inicio: string }) => r.estado === "confirmada" && r.inicio > estado.ahora)
+      .map((r: { socioId: string }) => r.socioId),
+  );
+  const socio = estado.socios.find(
+    (s: { cuotaActiva: boolean; rol: string; id: string }) => s.cuotaActiva && s.rol === "socio" && !ocupados.has(s.id),
+  );
+  assert.ok(socio, "debe quedar algún socio libre");
+  return socio.id;
+}
+
+test("duracion es opcional y vale 60, 90 o 120, con 90 por defecto", async () => {
+  const porDefecto = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${MARTES}T09:00` },
+  });
+  assert.equal(porDefecto.status, 201);
+  assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+  assert.equal(porDefecto.cuerpo.reserva.fin, `${MARTES}T10:30`);
+
+  const sesenta = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: `${MARTES}T10:00`, duracion: 60 },
+  });
+  assert.equal(sesenta.cuerpo.reserva.duracion, 60);
+  assert.equal(sesenta.cuerpo.reserva.fin, `${MARTES}T11:00`);
+
+  const cientoVeinte = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: `${MARTES}T11:00`, duracion: 120 },
+  });
+  assert.equal(cientoVeinte.cuerpo.reserva.duracion, 120);
+  assert.equal(cientoVeinte.cuerpo.reserva.fin, `${MARTES}T13:00`);
+});
+
+test("una duracion distinta de 60, 90 o 120 responde DURACION_INVALIDA", async () => {
+  for (const duracion of [45, 0, 121, 90.5, "90", null]) {
+    const r = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${MARTES}T09:00`, duracion },
+    });
+    assert.equal(r.status, 400, `duracion ${String(duracion)} debe fallar`);
+    assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA");
+  }
+});
+
+test("los inicios deben ser en punto o y media, no antes de las 09:00, y terminar como muy tarde a las 22:30", async () => {
+  const noPuntoNiMedia = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${MARTES}T09:15` },
+  });
+  assert.equal(noPuntoNiMedia.cuerpo.error.codigo, "FRANJA_INVALIDA");
+
+  const antesDeAbrir = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${MARTES}T08:30` },
+  });
+  assert.equal(antesDeAbrir.cuerpo.error.codigo, "FRANJA_INVALIDA");
+
+  const terminaTarde = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${MARTES}T21:30`, duracion: 120 },
+  });
+  assert.equal(terminaTarde.cuerpo.error.codigo, "FRANJA_INVALIDA");
+
+  const ultimaValida = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${MARTES}T20:30`, duracion: 120 },
+  });
+  assert.equal(ultimaValida.status, 201);
+  assert.equal(ultimaValida.cuerpo.reserva.fin, `${MARTES}T22:30`);
+});
+
+test("no se solapan reservas confirmadas de la misma pista, pero fin == inicio no solapa", async () => {
+  const primera = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${MARTES}T09:00`, duracion: 60 },
+  });
+  assert.equal(primera.status, 201);
+
+  const solapada = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${MARTES}T09:30`, duracion: 60 },
+  });
+  assert.equal(solapada.status, 409);
+  assert.equal(solapada.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+
+  const encadenada = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${MARTES}T10:00`, duracion: 60 },
+  });
+  assert.equal(encadenada.status, 201);
+});
+
+test("una reserva nueva se solapa con una de 90 minutos que ya existía", async () => {
+  // Irene Sanz ya tiene la pista 1 el 23 a las 18:00 durante 90 minutos.
+  const r = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-23T18:00", duracion: 60 },
+  });
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+});
+
+test("las reservas canceladas no ocupan la pista", async () => {
+  const creada = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${MARTES}T09:00`, duracion: 60 },
+  });
+  const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+  assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+
+  const otra = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${MARTES}T09:00`, duracion: 60 },
+  });
+  assert.equal(otra.status, 201);
+});
+
+test("el precio se calcula por minutos, cruzando las 18:00 y en fin de semana", async () => {
+  // Pista 1: valle 1800, punta 2800. Martes 17:30-19:00: 30 min de valle y 60 de punta -> 2467.
+  const cruce = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: await nuevoSocio(), pistaId: "pista-1", inicio: `${MARTES}T17:30`, duracion: 90 },
+  });
+  assert.equal(cruce.cuerpo.reserva.importe, 2467);
+
+  const valle = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: await nuevoSocio(), pistaId: "pista-1", inicio: `${MARTES}T09:00`, duracion: 60 },
+  });
+  assert.equal(valle.cuerpo.reserva.importe, 1200);
+
+  const sabado = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: await nuevoSocio(), pistaId: "pista-1", inicio: `${SABADO}T09:00`, duracion: 60 },
+  });
+  assert.equal(sabado.cuerpo.reserva.importe, 1867);
+
+  // 120 minutos de punta en la pista 3 (punta 2000): 120 × 2000 / 90 = 2666,67 -> 2667.
