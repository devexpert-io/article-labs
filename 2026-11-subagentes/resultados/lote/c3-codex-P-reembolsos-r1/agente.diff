+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function apiNueva(t: TestContext): Promise<Api> {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+async function crear(api: Api, inicio = "2027-01-15T21:00", pistaId = "pista-1") {
+  const respuesta = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio },
+  });
+  assert.equal(respuesta.status, 201);
+  return respuesta.cuerpo.reserva;
+}
+
+for (const caso of [
+  { ahora: "2027-01-13T20:59", porcentaje: 0, forzar: false },
+  { ahora: "2027-01-13T21:00", porcentaje: 0, forzar: false },
+  { ahora: "2027-01-13T21:01", porcentaje: 0.25, forzar: false },
+  { ahora: "2027-01-14T21:00", porcentaje: 0.25, forzar: false },
+  { ahora: "2027-01-14T21:01", porcentaje: 0.5, forzar: true },
+]) {
+  test(`tramos y reembolso con reloj ${caso.ahora}`, async (t) => {
+    const api = await apiNueva(t);
+    const reserva = await crear(api);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: caso.ahora } });
+    const ruta = `/api/reservas/${reserva.id}/cancelar`;
+    if (caso.forzar) {
+      for (const cuerpo of [{}, { forzar: false }]) {
+        const rechazada = await api.pedir("POST", ruta, { cuerpo });
+        assert.equal(rechazada.status, 409);
+        assert.equal(rechazada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+      }
+      assert.equal((await api.pedir("GET", `/api/reservas/${reserva.id}`)).cuerpo.reserva.estado, "confirmada");
+    }
+    const cancelada = await api.pedir("POST", ruta, { cuerpo: { forzar: caso.forzar, motivo: "Cambio de planes" } });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    assert.equal(cancelada.cuerpo.reserva.penalizacion ?? 0, reserva.importe * caso.porcentaje);
+    assert.equal(cancelada.cuerpo.reembolso, reserva.importe * (1 - caso.porcentaje));
+    assert.equal(cancelada.cuerpo.reserva.motivoCancelacion, "Cambio de planes");
+  });
+}
+
+for (const caso of [
+  { inicio: "2027-03-28T21:00", ahora: "2027-03-26T20:30", porcentaje: 0.25 },
+  { inicio: "2027-10-31T21:00", ahora: "2027-10-29T21:30", porcentaje: 0 },
+  { inicio: "2027-03-28T21:00", ahora: "2027-03-27T20:30", porcentaje: 0.5 },
+]) {
+  test(`la antelación usa horas reales de Madrid: ${caso.ahora} a ${caso.inicio}`, async (t) => {
+    const api = await apiNueva(t);
+    const reserva = await crear(api, caso.inicio);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: caso.ahora } });
+    const ruta = `/api/reservas/${reserva.id}/cancelar`;
+    if (caso.porcentaje === 0.5) {
+      const rechazada = await api.pedir("POST", ruta);
+      assert.equal(rechazada.status, 409);
+      assert.equal(rechazada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    }
+    const respuesta = await api.pedir("POST", ruta, { cuerpo: { forzar: caso.porcentaje === 0.5 } });
+    assert.equal(respuesta.status, 200);
+    assert.equal(respuesta.cuerpo.reserva.penalizacion ?? 0, reserva.importe * caso.porcentaje);
+    assert.equal(respuesta.cuerpo.reembolso, reserva.importe * (1 - caso.porcentaje));
+  });
+}
+
+test("exención: identidad, permisos, motivo y devolución íntegra sin forzar", async (t) => {
+  const api = await apiNueva(t);
+  const reserva = await crear(api);
