+    assert.equal(forzada.cuerpo.reserva.estado, "cancelada");
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+    const otraCancelada = await cancelar(api, otra, { forzar: true, motivo: "Lesión" });
+    assert.equal(otraCancelada.cuerpo.reserva.penalizacion, 900);
+  }));
+
+test("el cambio de hora cuenta horas reales de Madrid", () =>
+  conClub(async (api) => {
+    // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas (se adelanta el reloj).
+    const conCambio = await reservar(api, "2027-03-28T21:00", { pista: "pista-1" });
+    const sinCambio = await reservar(api, "2027-03-28T21:00", { pista: "pista-2" });
