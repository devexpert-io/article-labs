+    const forzada = await cancelar(api, sinCambio, { forzar: true });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 1400);
+  }));
+
+test("la reserva guarda su penalización y el reembolso es el importe menos la penalización", () =>
+  conClub(async (api) => {
+    const id = await reservar(api, "2026-12-01T12:00");
+    await moverReloj(api, "2026-11-30T12:00");
+    const cancelada = await cancelar(api, id);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 450);
+    assert.equal(cancelada.cuerpo.reserva.importe - cancelada.cuerpo.reserva.penalizacion, cancelada.cuerpo.reembolso);
+    await moverReloj(api, "2026-11-25T10:00");
