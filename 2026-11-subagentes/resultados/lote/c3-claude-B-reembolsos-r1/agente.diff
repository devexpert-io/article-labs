+test("el informe de caja suma reservas, ingresos y penalizaciones por pista y para el club", () =>
+  conClub(async (api) => {
+    // Todas se reservan con el reloj por defecto y se cancelan más tarde, con el reloj movido.
+    await reservar(api, "2027-01-12T12:00", { socio: "socio-030", pista: "pista-1" }); // 1800, cobrada
+    const r2 = await reservar(api, "2027-01-13T12:00", { socio: "socio-031", pista: "pista-2" }); // 1800, cancelada a 24 h: 450
+    const r3 = await reservar(api, "2027-01-14T19:30", { socio: "socio-034", pista: "pista-3" }); // cancelada con exención: 0
+    await reservar(api, "2027-02-02T12:00", { socio: "socio-030", pista: "pista-1" }); // febrero, no cuenta
+    await reservar(api, "2027-01-15T12:00", { socio: "socio-035", pista: "pista-3" }); // 1200, cobrada
+    await reservar(api, "2027-01-31T21:00", { socio: "socio-036", pista: "pista-2" }); // domingo, punta: 2800, cobrada
+    await moverReloj(api, "2027-01-12T12:00");
+    assert.equal((await cancelar(api, r2)).cuerpo.reserva.penalizacion, 450);
+    assert.equal((await cancelar(api, r3, { exento: true, motivo: MOTIVO }, GESTOR)).status, 200);
+
+    const enero = await api.pedir("GET", "/api/informes/caja?mes=2027-01", { socio: GESTOR });
+    assert.equal(enero.status, 200);
+    assert.equal(enero.cuerpo.mes, "2027-01");
+    assert.deepEqual(enero.cuerpo.pistas, [
+      { pistaId: "pista-1", reservas: 1, ingresos: 1800, penalizaciones: 0, total: 1800 },
+      { pistaId: "pista-2", reservas: 1, ingresos: 2800, penalizaciones: 450, total: 3250 },
+      { pistaId: "pista-3", reservas: 1, ingresos: 1200, penalizaciones: 0, total: 1200 },
+      { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    ]);
+    assert.deepEqual(enero.cuerpo.total, { reservas: 3, ingresos: 5800, penalizaciones: 450, total: 6250 });
+
+    const febrero = await api.pedir("GET", "/api/informes/caja?mes=2027-02", { socio: GESTOR });
+    assert.deepEqual(febrero.cuerpo.total, { reservas: 1, ingresos: 1800, penalizaciones: 0, total: 1800 });
+
+    const vacio = await api.pedir("GET", "/api/informes/caja?mes=2027-06", { socio: GESTOR });
+    assert.equal(vacio.cuerpo.pistas.length, 4, "todas las pistas, también las que no tienen movimientos");
+    assert.deepEqual(vacio.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+  }));
