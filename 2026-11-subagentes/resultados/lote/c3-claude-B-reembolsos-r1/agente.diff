+// Penalizaciones escalonadas, exención de gestor e informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-041"; // Nora Benítez: sin reservas en la semilla.
+const MOTIVO = "La pista se ha inundado por la lluvia";
+
+/** Arranca una API limpia (reloj por defecto, 2026-11-18T10:00), la usa y la cierra. */
+async function conClub(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reservar(api: Api, inicio: string, { socio = SOCIO, pista = "pista-1" } = {}): Promise<string> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: socio, pistaId: pista, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva.id;
+}
+
+async function moverReloj(api: Api, ahora: string): Promise<void> {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+async function estadoDe(api: Api, id: string): Promise<string> {
+  return (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva.estado;
+}
+
+test("sin penalización con 48 horas o más de antelación, también justo en 48 horas", () =>
+  conClub(async (api) => {
+    const lejos = await reservar(api, "2026-12-01T12:00", { pista: "pista-1" });
+    const justo = await reservar(api, "2026-12-01T12:00", { pista: "pista-2" });
+    await moverReloj(api, "2026-11-28T12:00"); // 72 horas
+    const tresDias = await cancelar(api, lejos);
+    assert.equal(tresDias.status, 200);
+    assert.equal(tresDias.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(tresDias.cuerpo.reembolso, 1800);
+    await moverReloj(api, "2026-11-29T12:00"); // 48 horas justas
+    const dosDias = await cancelar(api, justo);
+    assert.equal(dosDias.status, 200, JSON.stringify(dosDias.cuerpo));
+    assert.equal(dosDias.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(dosDias.cuerpo.reembolso, 1800);
+  }));
+
+test("entre 24 y 48 horas: 25 % sin forzar, también justo en 24 horas", () =>
+  conClub(async (api) => {
+    const casiDosDias = await reservar(api, "2026-12-01T12:00", { pista: "pista-1" });
+    const veinticuatro = await reservar(api, "2026-12-01T12:00", { pista: "pista-2" });
+    await moverReloj(api, "2026-11-29T12:01"); // 47 horas y 59 minutos
+    const a47 = await cancelar(api, casiDosDias);
+    assert.equal(a47.status, 200, JSON.stringify(a47.cuerpo));
+    assert.equal(a47.cuerpo.reserva.penalizacion, 450);
+    assert.equal(a47.cuerpo.reembolso, 1350);
+    await moverReloj(api, "2026-11-30T12:00"); // 24 horas justas
+    const a24 = await cancelar(api, veinticuatro);
+    assert.equal(a24.status, 200, JSON.stringify(a24.cuerpo));
+    assert.equal(a24.cuerpo.reserva.penalizacion, 450);
+    assert.equal(a24.cuerpo.reembolso, 1350);
+  }));
+
+test("menos de 24 horas: sin forzar es 409 FUERA_DE_PLAZO y con forzar cobra el 50 %", () =>
+  conClub(async (api) => {
+    const id = await reservar(api, "2026-12-01T12:00", { pista: "pista-1" });
+    const otra = await reservar(api, "2026-12-01T12:00", { pista: "pista-2" });
+    await moverReloj(api, "2026-11-30T12:01"); // 23 horas y 59 minutos
+    const sinForzar = await cancelar(api, id);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    assert.equal(await estadoDe(api, id), "confirmada", "un rechazo no cancela la reserva");
