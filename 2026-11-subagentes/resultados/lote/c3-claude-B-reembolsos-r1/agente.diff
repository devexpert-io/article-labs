+// Las horas son reales en Madrid: la diferencia se calcula con los instantes UTC, así cuenta el cambio de hora.
+const formatoMadrid = new Intl.DateTimeFormat("en-US", {
+  timeZone: "Europe/Madrid",
+  hourCycle: "h23",
+  year: "numeric",
+  month: "2-digit",
+  day: "2-digit",
+  hour: "2-digit",
+  minute: "2-digit",
+  second: "2-digit",
+});
+
+/** Desfase de Madrid respecto a UTC, en milisegundos, en ese instante. */
+function desfaseMadrid(instante: number): number {
+  const partes = Object.fromEntries(formatoMadrid.formatToParts(new Date(instante)).map((p) => [p.type, p.value]));
+  const comoUtc = Date.UTC(
+    Number(partes.year), Number(partes.month) - 1, Number(partes.day),
+    Number(partes.hour), Number(partes.minute), Number(partes.second),
+  );
+  return comoUtc - Math.floor(instante / 1000) * 1000;
+}
+
+/** Instante real (milisegundos UTC) de una hora local de Madrid `AAAA-MM-DDTHH:MM`. */
+function instanteMadrid(local: string): number {
+  const comoUtc = Date.parse(`${local}:00Z`);
+  const primera = comoUtc - desfaseMadrid(comoUtc);
+  return comoUtc - desfaseMadrid(primera);
+}
