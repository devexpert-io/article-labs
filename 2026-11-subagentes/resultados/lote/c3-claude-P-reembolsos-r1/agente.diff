+  assert.equal(octubre.total.reservas, cobradas.length);
+  assert.equal(octubre.total.ingresos, cobradas.reduce((s: number, x: any) => s + x.importe, 0));
+  assert.equal(octubre.total.penalizaciones, 0);
+  assert.equal(octubre.total.total, octubre.total.ingresos);
+  for (const p of octubre.pistas) {
+    const suyas = cobradas.filter((x: any) => x.pistaId === p.pistaId);
