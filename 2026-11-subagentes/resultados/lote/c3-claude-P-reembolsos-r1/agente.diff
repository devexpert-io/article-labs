+    mes: "2027-01",
+    pistas: [
+      { pistaId: "pista-1", reservas: 1, ingresos: 2800, penalizaciones: 0, total: 2800 },
+      { pistaId: "pista-2", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+      { pistaId: "pista-3", reservas: 1, ingresos: 1200, penalizaciones: 300, total: 1500 },
+      { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    ],
+    total: { reservas: 2, ingresos: 4000, penalizaciones: 300, total: 4300 },
+  });
+
+  // Octubre, con el historial de la semilla: cuenta confirmadas y no presentadas por fecha de inicio.
