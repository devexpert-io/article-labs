+// Penalizaciones escalonadas, exención de gestores e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const GESTOR = "socio-040";
+const reloj = async (ahora: string) => assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+
+/** Crea una reserva con la hora por defecto del club y devuelve su id. */
+async function reservar(socioId: string, pistaId: string, inicio: string): Promise<string> {
+  await reloj("2026-11-18T10:00");
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva.id;
+}
+
+const cancelar = (id: string, cuerpo: unknown = {}, socio?: string) =>
+  api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+
+test("tramos y límites exactos de la penalización", async () => {
+  // Jueves 10 de diciembre a las 12:00, pista 2 en horario de valle: 1800 céntimos.
+  const a48 = await reservar("socio-006", "pista-2", "2026-12-10T12:00");
+  const a47 = await reservar("socio-024", "pista-1", "2026-12-10T12:00");
+  const a24 = await reservar("socio-026", "pista-2", "2026-12-10T13:30");
+  const a23 = await reservar("socio-027", "pista-1", "2026-12-10T13:30");
+
+  await reloj("2026-12-08T12:00");
+  const gratis = await cancelar(a48);
+  assert.equal(gratis.status, 200);
+  assert.equal(gratis.cuerpo.reserva.estado, "cancelada");
+  assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.cuerpo.reembolso, 1800);
+
+  await reloj("2026-12-08T12:01");
+  const cuarto = await cancelar(a47);
+  assert.equal(cuarto.status, 200);
+  assert.equal(cuarto.cuerpo.reserva.penalizacion, 450);
+  assert.equal(cuarto.cuerpo.reembolso, 1350);
+
+  await reloj("2026-12-09T13:30");
+  const justo24 = await cancelar(a24);
+  assert.equal(justo24.status, 200);
+  assert.equal(justo24.cuerpo.reserva.penalizacion, 450);
+  assert.equal(justo24.cuerpo.reembolso, 1350);
+
+  await reloj("2026-12-09T13:31");
+  const sinForzar = await cancelar(a23);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await cancelar(a23, { forzar: true });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+  assert.equal(forzada.cuerpo.reembolso, 900);
+});
+
+test("la antelación se cuenta en horas reales de Madrid, con el cambio de hora", async () => {
+  // Domingo 28 de marzo de 2027 a las 21:00, pista 2 en punta: 2800 céntimos.
+  const id = await reservar("socio-028", "pista-2", "2027-03-28T21:00");
+  const otra = await reservar("socio-034", "pista-1", "2027-03-28T21:00");
+  // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales: 25 %.
+  await reloj("2027-03-26T20:30");
+  const r = await cancelar(id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 700);
+  assert.equal(r.cuerpo.reembolso, 2100);
+  // Del viernes 26 a las 20:00 hay 48 horas reales: sin penalización.
+  await reloj("2027-03-26T20:00");
+  const gratis = await cancelar(otra);
+  assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.cuerpo.reembolso, 2800);
+});
+
+test("un gestor puede eximir de la penalización con un motivo", async () => {
+  const id = await reservar("socio-035", "pista-2", "2026-12-15T10:30");
+  await reloj("2026-12-15T09:00");
+  const motivo = "Lesión justificada con parte médico";
+
+  const anonimo = await cancelar(id, { exento: true, motivo });
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await cancelar(id, { exento: true, motivo }, "socio-035");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const sinMotivo = await cancelar(id, { exento: true }, GESTOR);
+  assert.equal(sinMotivo.status, 400);
+  assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const corto = await cancelar(id, { exento: true, motivo: "Lluvia" }, GESTOR);
+  assert.equal(corto.status, 400);
+  assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva.estado, "confirmada");
+
+  const exenta = await cancelar(id, { exento: true, motivo }, GESTOR);
+  assert.equal(exenta.status, 200);
+  assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+  assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(exenta.cuerpo.reserva.motivoCancelacion, motivo);
+  assert.equal(exenta.cuerpo.reembolso, 1800);
+});
+
+test("una reserva que ya ha empezado no se cancela, tampoco con exento", async () => {
+  const id = await reservar("socio-036", "pista-2", "2026-12-16T10:30");
+  await reloj("2026-12-16T10:30");
+  const r = await cancelar(id, { exento: true, motivo: "Se ha ido la luz en el club" }, GESTOR);
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "RESERVA_PASADA");
+  const forzada = await cancelar(id, { forzar: true });
+  assert.equal(forzada.cuerpo.error.codigo, "RESERVA_PASADA");
+});
+
+test("las reservas ya canceladas conservan su penalización", async () => {
+  const id = await reservar("socio-038", "pista-3", "2026-12-17T09:00");
+  await reloj("2026-12-16T12:00");
+  const primera = await cancelar(id, { forzar: true });
+  assert.equal(primera.cuerpo.reserva.penalizacion, 600);
+  await reloj("2026-12-10T12:00");
+  const otra = await cancelar(id, { exento: true, motivo: "Intento de recalcular" }, GESTOR);
+  assert.equal(otra.status, 409);
+  assert.equal(otra.cuerpo.error.codigo, "YA_CANCELADA");
+  assert.equal((await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva.penalizacion, 600);
+});
+
+test("informe de caja: permisos y formato del mes", async () => {
+  const anonimo = await api.pedir("GET", "/api/informes/caja?mes=2026-10");
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
