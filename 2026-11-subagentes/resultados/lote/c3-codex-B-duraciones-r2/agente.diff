+/** Precio por minutos, aplicando la tarifa vigente a cada minuto. */
+export function precioPorDuracion(pista: Pista, inicio: string, duracion: number): number {
+  let numerador = 0;
+  const finDeSemana = [0, 6].includes(diaDeLaSemana(inicio.slice(0, 10)));
+  const minutosInicio = Number(inicio.slice(11, 13)) * 60 + Number(inicio.slice(14, 16));
+  for (let minuto = 0; minuto < duracion; minuto++) {
+    const actual = minutosInicio + minuto;
+    numerador += finDeSemana || actual >= 18 * 60 ? pista.precioPunta : pista.precioValle;
+  }
+  return Math.floor(numerador / MINUTOS_FRANJA + 0.5);
+}
+
 export function finDeFranja(inicio: string): string {
+  return finDeReserva(inicio, MINUTOS_FRANJA);
+}
+
+export function finDeReserva(inicio: string, duracion: number): string {
   const [h, m] = inicio.slice(11).split(":").map(Number);
-  const total = h! * 60 + m! + MINUTOS_FRANJA;
+  const total = h! * 60 + m! + duracion;
   const hh = String(Math.floor(total / 60)).padStart(2, "0");
   const mm = String(total % 60).padStart(2, "0");
   return `${inicio.slice(0, 10)}T${hh}:${mm}`;
