+// Reservas de 60, 90 o 120 minutos (docs/specs/duraciones.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const reservar = (cuerpo: Record<string, unknown>) => api.pedir("POST", "/api/reservas", { cuerpo });
+// El martes 1 de diciembre de 2026 y el sábado 5 no tienen reservas en la semilla.
+const MARTES = "2026-12-01";
+const SABADO = "2026-12-05";
+
+test("1. duracion es opcional, vale 60, 90 o 120 y por defecto son 90", async () => {
+  const sin = await reservar({ socioId: "socio-006", pistaId: "pista-1", inicio: `${MARTES}T09:00` });
+  assert.equal(sin.status, 201);
+  assert.equal(sin.cuerpo.reserva.duracion, 90);
+  assert.equal(sin.cuerpo.reserva.fin, `${MARTES}T10:30`);
+  for (const duracion of [45, 0, 150, "60", null, 90.5]) {
+    const r = await reservar({ socioId: "socio-006", pistaId: "pista-2", inicio: `${MARTES}T09:00`, duracion });
+    assert.equal(r.status, 400, `duracion ${JSON.stringify(duracion)}`);
+    assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA");
+  }
+  const sesenta = await reservar({ socioId: "socio-006", pistaId: "pista-2", inicio: `${MARTES}T09:00`, duracion: 60 });
+  assert.equal(sesenta.status, 201);
+  const ciento20 = await reservar({ socioId: "socio-006", pistaId: "pista-3", inicio: `${MARTES}T09:00`, duracion: 120 });
+  assert.equal(ciento20.status, 201);
+});
+
+test("2 y 3. empieza en punto o y media, desde las 09:00, termina como muy tarde a las 22:30, y fin es inicio más la duración", async () => {
+  const invalidas: [string, number][] = [
+    ["09:15", 60], ["08:30", 60], ["08:00", 120], ["21:00", 120], ["22:00", 60], ["21:30", 90], ["22:30", 60], ["24:00", 60],
+  ];
+  for (const [hora, duracion] of invalidas) {
+    const r = await reservar({ socioId: "socio-016", pistaId: "pista-1", inicio: `${MARTES}T${hora}`, duracion });
+    assert.equal(r.status, 400, `${hora} + ${duracion}`);
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  }
+  const validas: [string, string, number, string][] = [
+    ["socio-016", "21:30", 60, "22:30"],
+    ["socio-016", "11:00", 120, "13:00"],
+    ["socio-020", "13:30", 90, "15:00"],
+  ];
+  for (const [socioId, hora, duracion, fin] of validas) {
+    const r = await reservar({ socioId, pistaId: "pista-1", inicio: `${MARTES}T${hora}`, duracion });
+    assert.equal(r.status, 201, `${hora} + ${duracion}`);
+    assert.equal(r.cuerpo.reserva.fin, `${MARTES}T${fin}`);
+    assert.equal(r.cuerpo.reserva.duracion, duracion);
+  }
+  const ultima = await reservar({ socioId: "socio-020", pistaId: "pista-2", inicio: `${MARTES}T20:30`, duracion: 120 });
+  assert.equal(ultima.cuerpo.reserva.fin, `${MARTES}T22:30`);
+});
+
+test("4. no se solapa con reservas confirmadas, nuevas o antiguas; tocarse no es solaparse y las canceladas no ocupan", async () => {
+  // R-0521: la reserva de siempre de pista 2, viernes 20 de 18:00 a 19:30.
+  const solapes: [string, number][] = [["19:00", 60], ["16:30", 120], ["18:30", 60], ["17:00", 120]];
+  for (const [hora, duracion] of solapes) {
+    const r = await reservar({ socioId: "socio-023", pistaId: "pista-2", inicio: `2026-11-20T${hora}`, duracion });
+    assert.equal(r.status, 409, `${hora} + ${duracion}`);
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  }
+  const despues = await reservar({ socioId: "socio-023", pistaId: "pista-2", inicio: "2026-11-20T19:30", duracion: 60 });
+  assert.equal(despues.status, 201);
+  const antes = await reservar({ socioId: "socio-023", pistaId: "pista-2", inicio: "2026-11-20T17:00", duracion: 60 });
+  assert.equal(antes.status, 201);
+  // Con una reserva nueva de 120 minutos.
+  const larga = await reservar({ socioId: "socio-024", pistaId: "pista-3", inicio: `${SABADO}T10:00`, duracion: 120 });
+  assert.equal(larga.status, 201);
+  const pisa = await reservar({ socioId: "socio-026", pistaId: "pista-3", inicio: `${SABADO}T11:30`, duracion: 60 });
+  assert.equal(pisa.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  const otraPista = await reservar({ socioId: "socio-026", pistaId: "pista-1", inicio: `${SABADO}T11:30`, duracion: 60 });
+  assert.equal(otraPista.status, 201);
+  // Cancelada: deja la pista libre.
+  assert.equal((await api.pedir("POST", `/api/reservas/${larga.cuerpo.reserva.id}/cancelar`)).status, 200);
+  const ahora = await reservar({ socioId: "socio-026", pistaId: "pista-3", inicio: `${SABADO}T11:30`, duracion: 60 });
+  assert.equal(ahora.status, 201);
+});
+
+test("5. el precio va por minutos, con valle y punta y redondeo al céntimo", async () => {
+  const casos: [string, string, string, number, number][] = [
+    // El ejemplo de la spec: martes de 17:30 a 19:00 en pista 1 = 600 + 1866,67.
+    ["socio-027", "pista-2", `${MARTES}T17:30`, 90, 2467],
+    // Valle: 60 × 1800 / 90.
+    ["socio-027", "pista-2", `${MARTES}T15:00`, 60, 1200],
+    // Cruza las 18:00 en pista 3: 60 × 1200 / 90 + 60 × 2000 / 90 = 800 + 1333,33.
+    ["socio-028", "pista-3", `${MARTES}T17:00`, 120, 2133],
+    // Punta entera: 60 × 2800 / 90 = 1866,67.
+    ["socio-028", "pista-2", `${MARTES}T19:00`, 60, 1867],
+    // Fin de semana, todo punta aunque sea por la mañana: 120 × 2000 / 90 = 2666,67.
+    ["socio-034", "pista-3", `${SABADO}T15:00`, 120, 2667],
+    ["socio-034", "pista-2", `${SABADO}T09:00`, 60, 1867],
+  ];
+  for (const [socioId, pistaId, inicio, duracion, importe] of casos) {
+    const r = await reservar({ socioId, pistaId, inicio, duracion });
+    assert.equal(r.status, 201, `${pistaId} ${inicio}`);
+    assert.equal(r.cuerpo.reserva.importe, importe, `${pistaId} ${inicio} + ${duracion}`);
+  }
+});
+
+test("6. una reserva de 90 minutos a una hora de siempre cuesta lo mismo que antes", async () => {
+  const pistas = (await api.pedir("GET", "/api/pistas")).cuerpo.pistas;
+  for (const fecha of ["2026-12-02", "2026-12-06"]) {
+    const dispo = (await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`)).cuerpo;
+    for (const p of dispo.pistas) {
+      const pista = pistas.find((x: any) => x.id === p.pistaId);
+      for (const f of p.franjas) {
+        const punta = fecha === "2026-12-06" || f.inicio.slice(11) >= "18:00";
+        assert.equal(f.precio, punta ? pista.precioPunta : pista.precioValle, `${p.pistaId} ${f.inicio}`);
+      }
+    }
+  }
+  const valle = await reservar({ socioId: "socio-035", pistaId: "pista-1", inicio: "2026-12-02T16:30", duracion: 90 });
+  assert.equal(valle.cuerpo.reserva.importe, 1800);
+  const punta = await reservar({ socioId: "socio-035", pistaId: "pista-3", inicio: "2026-12-02T18:00" });
+  assert.equal(punta.cuerpo.reserva.importe, 2000);
+  const finde = await reservar({ socioId: "socio-035", pistaId: "pista-3", inicio: "2026-12-06T09:00" });
+  assert.equal(finde.cuerpo.reserva.importe, 2000);
+});
+
+test("7. todas las reservas devuelven duracion, también las que ya existían", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  for (const r of estado.reservas) assert.equal(typeof r.duracion, "number", r.id);
+  const antigua = (await api.pedir("GET", "/api/reservas/R-0001")).cuerpo.reserva;
