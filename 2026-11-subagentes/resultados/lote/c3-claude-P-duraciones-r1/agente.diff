+test("8 y 9. disponibilidad: franjas reservadas por solape parcial y huecos libres del día", async () => {
+  const fecha = "2026-12-03";
+  assert.equal((await reservar({ socioId: "socio-036", pistaId: "pista-2", inicio: `${fecha}T11:00`, duracion: 60 })).status, 201);
+  assert.equal((await reservar({ socioId: "socio-036", pistaId: "pista-2", inicio: `${fecha}T12:30`, duracion: 60 })).status, 201);
+  // Una cancelada no cuenta.
+  const cancelada = await reservar({ socioId: "socio-038", pistaId: "pista-2", inicio: `${fecha}T19:00`, duracion: 60 });
+  await api.pedir("POST", `/api/reservas/${cancelada.cuerpo.reserva.id}/cancelar`);
+  const dispo = (await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`)).cuerpo;
+  const p2 = dispo.pistas.find((p: any) => p.pistaId === "pista-2");
+  const estados = Object.fromEntries(p2.franjas.map((f: any) => [f.inicio.slice(11), f.estado]));
+  assert.deepEqual(estados, {
+    "09:00": "libre", "10:30": "reservada", "12:00": "reservada", "13:30": "libre", "15:00": "libre",
+    "16:30": "libre", "18:00": "libre", "19:30": "libre", "21:00": "libre",
+  });
+  assert.deepEqual(p2.huecos, [
+    { inicio: `${fecha}T09:00`, fin: `${fecha}T11:00` },
+    { inicio: `${fecha}T12:00`, fin: `${fecha}T12:30` },
+    { inicio: `${fecha}T13:30`, fin: `${fecha}T22:30` },
+  ]);
+  const p1 = dispo.pistas.find((p: any) => p.pistaId === "pista-1");
+  assert.deepEqual(p1.huecos, [{ inicio: `${fecha}T09:00`, fin: `${fecha}T22:30` }]);
+  const p4 = dispo.pistas.find((p: any) => p.pistaId === "pista-4");
+  assert.deepEqual(p4.huecos, []);
+
+  // Con las reservas antiguas de 90 minutos: jueves 19 en pista 1 hay 12:00, 18:00 y 19:30 ocupadas, entre otras.
+  const jueves = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-19&pista=pista-1")).cuerpo.pistas[0];
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const ocupadas = estado.reservas
+    .filter((r: any) => r.pistaId === "pista-1" && r.estado === "confirmada" && r.inicio.startsWith("2026-11-19"))
+    .sort((a: any, b: any) => a.inicio.localeCompare(b.inicio));
+  // Los huecos y las reservas confirmadas cubren el día entero sin solaparse.
+  const tramos = [...jueves.huecos, ...ocupadas.map((r: any) => ({ inicio: r.inicio, fin: r.fin }))]
+    .sort((a, b) => a.inicio.localeCompare(b.inicio));
+  assert.equal(tramos[0].inicio, "2026-11-19T09:00");
+  assert.equal(tramos.at(-1).fin, "2026-11-19T22:30");
+  for (let i = 1; i < tramos.length; i++) assert.equal(tramos[i].inicio, tramos[i - 1].fin);
+  for (let i = 1; i < jueves.huecos.length; i++) assert.ok(jueves.huecos[i].inicio > jueves.huecos[i - 1].fin, "huecos maximales");
+});
