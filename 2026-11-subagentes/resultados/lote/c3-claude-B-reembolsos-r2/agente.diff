+test("el informe de caja de un mes con historial coincide con el estado del club", async () => {
+  const api = await abrir();
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const resumen = (reservas: any[]) => {
+    const cobradas = reservas.filter((r) => r.estado !== "cancelada");
+    const ingresos = cobradas.reduce((suma, r) => suma + r.importe, 0);
+    const penalizaciones = reservas
+      .filter((r) => r.estado === "cancelada")
+      .reduce((suma, r) => suma + (r.penalizacion ?? 0), 0);
+    return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+  };
+  for (const mes of ["2026-10", "2026-11"]) {
+    const informe = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: GESTOR });
+    assert.equal(informe.status, 200);
+    const delMes = estado.reservas.filter((r: any) => r.inicio.startsWith(mes));
+    for (const pista of estado.pistas) {
+      const esperado = resumen(delMes.filter((r: any) => r.pistaId === pista.id));
+      const obtenido = informe.cuerpo.pistas.find((p: any) => p.pistaId === pista.id);
+      assert.deepEqual({ ...obtenido, pistaId: undefined }, { ...esperado, pistaId: undefined }, `${mes} ${pista.id}`);
+    }
+    assert.deepEqual(informe.cuerpo.total, resumen(delMes), mes);
+  }
+});
