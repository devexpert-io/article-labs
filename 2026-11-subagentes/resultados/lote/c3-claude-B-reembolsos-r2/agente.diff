+// La política de cancelación escalonada, la exención de gestor y el informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { after, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const abiertas: Api[] = [];
+after(() => {
+  for (const api of abiertas) api.cerrar();
+});
+
+const GESTOR = "socio-040";
+// Nora Benítez: socio sin reservas, con la cuota al día.
+const SOCIO = "socio-041";
+const PISTA = "pista-1";
+// Jueves 10 de diciembre de 2026: sin reservas en la semilla, precio de valle (1800 céntimos).
+const INICIO = "2026-12-10T12:00";
+
+async function abrir(): Promise<Api> {
+  const api = await arrancarApi();
+  abiertas.push(api);
+  return api;
+}
+
+/** Crea una reserva con el reloj en su hora por defecto y luego mueve el reloj a `ahora`. */
+async function reservaAntes(ahora: string, inicio = INICIO) {
+  const api = await abrir();
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIO, pistaId: PISTA, inicio } });
+  assert.equal(creada.status, 201);
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+  return { api, id: creada.cuerpo.reserva.id as string, importe: creada.cuerpo.reserva.importe as number };
+}
+
+test("cancelar con 48 horas o más de antelación no tiene penalización", async () => {
+  const { api, id, importe } = await reservaAntes("2026-12-08T12:00");
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, importe);
+
+  const lejos = await reservaAntes("2026-12-01T10:00");
+  const sinPenalizacion = await lejos.api.pedir("POST", `/api/reservas/${lejos.id}/cancelar`);
+  assert.equal(sinPenalizacion.cuerpo.reembolso, lejos.importe);
+});
+
+test("cancelar entre 24 y 48 horas cobra el 25 % sin necesidad de forzar", async () => {
+  // Faltan 47 horas y 59 minutos.
+  const casiCuarentaYOcho = await reservaAntes("2026-12-08T12:01");
+  const r1 = await casiCuarentaYOcho.api.pedir("POST", `/api/reservas/${casiCuarentaYOcho.id}/cancelar`);
+  assert.equal(r1.status, 200);
+  assert.equal(r1.cuerpo.reserva.penalizacion, 450);
+  assert.equal(r1.cuerpo.reembolso, 1350);
+
+  // Faltan 47 horas.
