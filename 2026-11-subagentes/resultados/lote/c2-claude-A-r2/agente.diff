+  const lista = (await api.pedir("GET", "/api/reservas?fecha=2026-11-27&socio=socio-013")).cuerpo.reservas;
+  assert.deepEqual(lista.map((x: any) => [x.id, x.importeBase, x.descuento, x.importe, x.codigo]), [[id, 1200, 400, 800, "MANANAS"]]);
