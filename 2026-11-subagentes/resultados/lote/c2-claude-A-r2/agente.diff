+// Códigos de descuento al reservar (docs/specs/codigos-descuento.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Nora Benítez (socio-041) no tiene ninguna reserva. socio-011 no tiene la cuota al día.
+// El miércoles 25 y el jueves 26 de noviembre no tienen reservas en la semilla; el sábado 28 tampoco.
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const reservar = (cuerpo: Record<string, unknown>, otra: Api = api) => otra.pedir("POST", "/api/reservas", { cuerpo });
+
+async function conApi<T>(ahora: string, prueba: (otra: Api) => Promise<T>): Promise<T> {
+  const otra = await arrancarApi({ AHORA: ahora });
+  try {
+    return await prueba(otra);
+  } finally {
+    otra.cerrar();
+  }
+}
+
+test("sin código, todo igual", async () => {
+  const r = await reservar({ socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-25T18:00" });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.importe, 2800);
+  assert.equal(r.cuerpo.reserva.importeBase, 2800);
+  assert.equal(r.cuerpo.reserva.descuento, 0);
+  assert.equal("codigo" in r.cuerpo.reserva, false);
+});
+
+test("BIENVENIDA: 50 % en la primera reserva; después ya no vale", async () => {
+  // Las reglas del club van primero: la franja ocupada responde su error y el código no cuenta como usado.
+  const ocupada = await reservar({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T18:00", codigo: "BIENVENIDA" });
+  assert.equal(ocupada.status, 409);
+  assert.equal(ocupada.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  const primera = await reservar({ socioId: "socio-041", pistaId: "pista-2", inicio: "2026-11-25T18:00", codigo: "BIENVENIDA" });
+  assert.equal(primera.status, 201);
+  assert.deepEqual(
+    { importeBase: primera.cuerpo.reserva.importeBase, descuento: primera.cuerpo.reserva.descuento, importe: primera.cuerpo.reserva.importe, codigo: primera.cuerpo.reserva.codigo },
+    { importeBase: 2800, descuento: 1400, importe: 1400, codigo: "BIENVENIDA" },
+  );
+  const segunda = await reservar({ socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-25T18:00", codigo: "BIENVENIDA" });
+  assert.equal(segunda.status, 409);
+  assert.equal(segunda.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  // Un socio con historial tampoco puede usarlo.
+  const veterano = await reservar({ socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-25T18:00", codigo: "BIENVENIDA" });
+  assert.equal(veterano.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("BIENVENIDA: una reserva cancelada también cuenta como reserva anterior", async () => {
+  await conApi("2026-11-18T10:00", async (otra) => {
+    const r = await reservar({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T18:00" }, otra);
+    await otra.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+    const despues = await reservar({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T19:30", codigo: "BIENVENIDA" }, otra);
+    assert.equal(despues.status, 409);
+    assert.equal(despues.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  });
+});
+
+test("BIENVENIDA: vale hasta el 31 de diciembre de 2026 incluido", async () => {
+  await conApi("2026-12-31T23:00", async (otra) => {
+    const r = await reservar({ socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-02T10:30", codigo: "BIENVENIDA" }, otra);
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.importe, 1400);
+  });
+  await conApi("2027-01-01T00:00", async (otra) => {
+    const r = await reservar({ socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-02T10:30", codigo: "BIENVENIDA" }, otra);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  });
+});
+
+test("MANANAS: 4,00 € de lunes a viernes antes de las 12:00", async () => {
+  const valle = await reservar({ socioId: "socio-006", pistaId: "pista-3", inicio: "2026-11-25T10:30", codigo: "MANANAS" });
+  assert.equal(valle.status, 201);
+  assert.equal(valle.cuerpo.reserva.importeBase, 1200);
+  assert.equal(valle.cuerpo.reserva.descuento, 400);
+  assert.equal(valle.cuerpo.reserva.importe, 800);
+  assert.equal(valle.cuerpo.reserva.codigo, "MANANAS");
+  const mediodia = await reservar({ socioId: "socio-006", pistaId: "pista-3", inicio: "2026-11-25T12:00", codigo: "MANANAS" });
+  assert.equal(mediodia.status, 409);
+  assert.equal(mediodia.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  const sabado = await reservar({ socioId: "socio-006", pistaId: "pista-3", inicio: "2026-11-28T09:00", codigo: "MANANAS" });
+  assert.equal(sabado.status, 409);
+  assert.equal(sabado.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  // Sin límite de usos.
+  const otra = await reservar({ socioId: "socio-006", pistaId: "pista-1", inicio: "2026-11-26T09:00", codigo: "mananas" });
+  assert.equal(otra.status, 201);
+  assert.equal(otra.cuerpo.reserva.importe, 1400);
+});
+
+test("CLUB10: 10 %, como mucho 3 reservas por socio sin contar las canceladas", async () => {
+  await conApi("2026-11-18T10:00", async (otra) => {
+    const ids: string[] = [];
+    for (const hora of ["09:00", "10:30", "12:00"]) {
+      const r = await reservar({ socioId: "socio-041", pistaId: "pista-1", inicio: `2026-11-26T${hora}`, codigo: "CLUB10" }, otra);
+      assert.equal(r.status, 201);
+      assert.equal(r.cuerpo.reserva.descuento, 180);
+      assert.equal(r.cuerpo.reserva.importe, 1620);
+      ids.push(r.cuerpo.reserva.id);
+    }
+    // La cancelada no cuenta: puede usar el código otra vez.
+    await otra.pedir("POST", `/api/reservas/${ids[0]}/cancelar`);
+    const cuarta = await reservar({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T18:00", codigo: "CLUB10" }, otra);
+    assert.equal(cuarta.status, 201);
+    assert.equal(cuarta.cuerpo.reserva.importe, 2520);
+    // Ya ha jugado sus tres reservas: el límite de reservas futuras no molesta, pero el código ya no vale.
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-27T10:00" } });
+    const quinta = await reservar({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-30T18:00", codigo: "CLUB10" }, otra);
+    assert.equal(quinta.status, 409);
+    assert.equal(quinta.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+    // Otro socio sí puede usarlo.
+    const otro = await reservar({ socioId: "socio-009", pistaId: "pista-1", inicio: "2026-11-30T18:00", codigo: "CLUB10" }, otra);
+    assert.equal(otro.status, 201);
+  });
+});
+
+test("formato del código: mayúsculas, espacios, códigos que no existen y tipos", async () => {
+  const espacios = await reservar({ socioId: "socio-010", pistaId: "pista-2", inicio: "2026-11-26T18:00", codigo: "  club10 " });
+  assert.equal(espacios.status, 201);
+  assert.equal(espacios.cuerpo.reserva.codigo, "CLUB10");
+  for (const codigo of ["VERANO", "CLUB10,MANANAS", ""]) {
+    const r = await reservar({ socioId: "socio-010", pistaId: "pista-2", inicio: "2026-11-26T19:30", codigo });
+    assert.equal(r.status, 400, codigo);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_INVALIDO", codigo);
+  }
+  for (const codigo of [10, ["CLUB10", "MANANAS"], null]) {
+    const r = await reservar({ socioId: "socio-010", pistaId: "pista-2", inicio: "2026-11-26T19:30", codigo });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+});
+
+test("las reglas del club van antes que el código", async () => {
+  const cuota = await reservar({ socioId: "socio-011", pistaId: "pista-2", inicio: "2026-11-26T21:00", codigo: "NOEXISTE" });
+  assert.equal(cuota.cuerpo.error.codigo, "CUOTA_INACTIVA");
+  const cerrada = await reservar({ socioId: "socio-012", pistaId: "pista-4", inicio: "2026-11-26T21:00", codigo: "CLUB10" });
+  assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+  const franja = await reservar({ socioId: "socio-012", pistaId: "pista-2", inicio: "2026-11-26T21:15", codigo: "CLUB10" });
+  assert.equal(franja.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  const pasada = await reservar({ socioId: "socio-012", pistaId: "pista-2", inicio: "2026-11-18T09:00", codigo: "CLUB10" });
+  assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+});
+
+test("los importes se guardan y se devuelven al consultar y listar", async () => {
+  const r = await reservar({ socioId: "socio-013", pistaId: "pista-3", inicio: "2026-11-27T09:00", codigo: "MANANAS" });
+  const id = r.cuerpo.reserva.id;
