diff --git a/test/duraciones.test.ts b/test/duraciones.test.ts
new file mode 100644
index 0000000..efc68be
--- /dev/null
+++ b/test/duraciones.test.ts
@@ -0,0 +1,174 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(comprobar: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try { await comprobar(api); } finally { api.cerrar(); }
+}
+
+function reservar(api: Api, inicio: string, duracion?: unknown, pistaId = "pista-1", socioId = "socio-041") {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio, duracion } });
+}
+
+async function comprobarError(respuesta: Awaited<ReturnType<Api["pedir"]>>, status: number, codigo: string) {
+  assert.equal(respuesta.status, status, respuesta.texto);
+  assert.equal(respuesta.cuerpo.error.codigo, codigo);
+}
+
+test("duración opcional, las tres duraciones válidas y sus fines", () => conApi(async (api) => {
+  for (const [i, duracion] of [undefined, 60, 90, 120].entries()) {
+    const respuesta = await reservar(api, `2026-12-0${i + 1}T10:00`, duracion, "pista-1");
+    // Se libera cada reserva para que el límite de tres no interfiera.
+    assert.equal(respuesta.status, 201, respuesta.texto);
+    assert.equal(respuesta.cuerpo.reserva.duracion, duracion ?? 90);
+    assert.equal(respuesta.cuerpo.reserva.fin, `2026-12-0${i + 1}T${duracion === 60 ? "11:00" : duracion === 120 ? "12:00" : "11:30"}`);
+    await api.pedir("POST", `/api/reservas/${respuesta.cuerpo.reserva.id}/cancelar`);
+  }
+  for (const duracion of [null, "60", 0, 30, 61, 90.5, 180, true, {}, []]) {
+    await comprobarError(await reservar(api, "2026-12-01T10:00", duracion), 400, "DURACION_INVALIDA");
+  }
+}));
+
+test("solo inicios en punto o y media dentro del horario completo", () => conApi(async (api) => {
+  for (const inicio of ["08:30", "09:15", "10:60", "21:45", "22:00", "23:30", "99:00"]) {
+    await comprobarError(await reservar(api, `2026-12-01T${inicio}`, 60), 400, "FRANJA_INVALIDA");
+  }
+  await comprobarError(await reservar(api, "2026-12-01T21:00", 120), 400, "FRANJA_INVALIDA");
+  for (const [dia, inicio, duracion] of [[1, "09:00", 120], [2, "21:00", 90], [3, "21:30", 60]] as const) {
+    const respuesta = await reservar(api, `2026-12-0${dia}T${inicio}`, duracion);
+    assert.equal(respuesta.status, 201, respuesta.texto);
+    if (dia > 1) assert.equal(respuesta.cuerpo.reserva.fin.slice(11), "22:30");
+  }
+}));
+
+test("solapes parciales, contención, extremos contiguos y canceladas", () => conApi(async (api) => {
+  const primera = await reservar(api, "2026-12-01T10:00", 90);
+  assert.equal(primera.status, 201);
+  for (const [inicio, duracion] of [["09:00", 120], ["10:00", 60], ["10:30", 60], ["11:00", 60], ["09:30", 120]] as const) {
+    await comprobarError(await reservar(api, `2026-12-01T${inicio}`, duracion), 409, "FRANJA_NO_DISPONIBLE");
+  }
+  assert.equal((await reservar(api, "2026-12-01T09:00", 60)).status, 201);
+  assert.equal((await reservar(api, "2026-12-01T11:30", 60)).status, 201);
+  await api.pedir("POST", `/api/reservas/${primera.cuerpo.reserva.id}/cancelar`);
+  assert.equal((await reservar(api, "2026-12-01T10:00", 90)).status, 201);
+}));
+
+test("las reservas antiguas bloquean cualquier solape y devuelven duración sin alterar sus datos", () => conApi(async (api) => {
+  const listado = await api.pedir("GET", "/api/reservas?fecha=2026-11-19&pista=pista-1");
+  const antigua = listado.cuerpo.reservas.find((r: any) => r.inicio === "2026-11-19T19:30");
+  assert.equal(antigua.duracion, 90);
+  const detalle = await api.pedir("GET", `/api/reservas/${antigua.id}`);
+  assert.deepEqual(detalle.cuerpo.reserva, antigua);
+  const estado = await api.pedir("GET", "/_estado");
+  assert.ok(estado.cuerpo.reservas.every((r: any) => r.duracion === 90));
+  await comprobarError(await reservar(api, "2026-11-19T20:00", 60), 409, "FRANJA_NO_DISPONIBLE");
+  await comprobarError(await reservar(api, "2026-11-19T19:00", 60), 409, "FRANJA_NO_DISPONIBLE");
+  const cancelada = await api.pedir("POST", `/api/reservas/${antigua.id}/cancelar`);
+  assert.equal(cancelada.cuerpo.reserva.duracion, 90);
+  assert.equal((await reservar(api, "2026-11-19T20:00", 60)).status, 201);
+}));
+
+test("precio por minuto, cruces de las 18:00, redondeo y fin de semana", () => conApi(async (api) => {
+  for (const [inicio, duracion, pista, importe] of [
+    ["2026-12-01T17:30", 90, "pista-1", 2467],
+    ["2026-12-01T17:00", 120, "pista-3", 2133],
+    ["2026-12-01T12:00", 60, "pista-1", 1200],
+    ["2026-12-01T18:00", 60, "pista-1", 1867],
+    ["2026-12-05T12:00", 120, "pista-1", 3733],
+    ["2026-12-06T09:00", 60, "pista-3", 1333],
+  ] as const) {
+    const respuesta = await reservar(api, inicio, duracion, pista);
+    assert.equal(respuesta.status, 201, respuesta.texto);
+    assert.equal(respuesta.cuerpo.reserva.importe, importe);
+    await api.pedir("POST", `/api/reservas/${respuesta.cuerpo.reserva.id}/cancelar`);
+  }
+}));
+
+test("todas las franjas tradicionales conservan su precio de 90 minutos", () => conApi(async (api) => {
+  const pistas = (await api.pedir("GET", "/api/pistas")).cuerpo.pistas.filter((p: any) => p.estado === "operativa");
+  for (const fecha of ["2026-12-01", "2026-12-05"]) {
+    for (const pista of pistas) {
+      const disponibilidad = (await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pista.id}`)).cuerpo.pistas[0];
+      assert.equal(disponibilidad.franjas.length, 9);
+      for (const franja of disponibilidad.franjas) {
+        const importe = fecha === "2026-12-05" || franja.inicio.slice(11) >= "18:00" ? pista.precioPunta : pista.precioValle;
+        assert.equal(franja.precio, importe);
+        const respuesta = await reservar(api, franja.inicio, undefined, pista.id);
+        assert.equal(respuesta.status, 201, respuesta.texto);
+        assert.equal(respuesta.cuerpo.reserva.importe, importe);
+        await api.pedir("POST", `/api/reservas/${respuesta.cuerpo.reserva.id}/cancelar`);
+      }
+    }
+  }
+}));
+
+test("disponibilidad marca cualquier solape y ofrece huecos máximos ordenados", () => conApi(async (api) => {
+  // Se crean desordenadas; las dos últimas forman un solo intervalo ocupado.
+  await reservar(api, "2026-12-01T14:00", 60);
+  await reservar(api, "2026-12-01T10:00", 60);
+  const contigua = await reservar(api, "2026-12-01T11:00", 90);
+  const disponibilidad = async () => (await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-01")).cuerpo.pistas;
+  const pistas = await disponibilidad();
+  assert.deepEqual(pistas[0].franjas.map((f: any) => f.estado), ["reservada", "reservada", "reservada", "reservada", "libre", "libre", "libre", "libre", "libre"]);
+  const intervalo = (inicio: string, fin: string) => ({ inicio: `2026-12-01T${inicio}`, fin: `2026-12-01T${fin}` });
+  assert.deepEqual(pistas[0].huecos, [intervalo("09:00", "10:00"), intervalo("12:30", "14:00"), intervalo("15:00", "22:30")]);
+  assert.deepEqual(pistas[1].huecos, [intervalo("09:00", "22:30")]);
+  assert.deepEqual(pistas[3].huecos, []);
+  await api.pedir("POST", `/api/reservas/${contigua.cuerpo.reserva.id}/cancelar`);
+  assert.deepEqual((await disponibilidad())[0].huecos, [intervalo("09:00", "10:00"), intervalo("11:00", "14:00"), intervalo("15:00", "22:30")]);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-02T10:00" } });
+  assert.deepEqual((await disponibilidad())[0].huecos, [intervalo("09:00", "10:00"), intervalo("11:00", "14:00"), intervalo("15:00", "22:30")]);
+}));
