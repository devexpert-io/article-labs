+test("cancelar cualquier duración respeta las 24 horas y penaliza el importe completo", () => conApi(async (api) => {
+  for (const duracion of [60, 90, 120]) {
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:00" } });
+    const creada = await reservar(api, "2026-12-01T17:30", duracion);
+    assert.equal(creada.status, 201, creada.texto);
+    const ruta = `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`;
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T17:30" } });
+    const gratis = await api.pedir("POST", ruta);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.duracion, duracion);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    const otra = await reservar(api, "2026-12-01T17:30", duracion);
+    const otraRuta = `/api/reservas/${otra.cuerpo.reserva.id}/cancelar`;
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T17:31" } });
+    await comprobarError(await api.pedir("POST", otraRuta), 409, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", otraRuta, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, otra.cuerpo.reserva.importe);
+    assert.equal(forzada.cuerpo.reserva.duracion, duracion);
+  }
+}));
