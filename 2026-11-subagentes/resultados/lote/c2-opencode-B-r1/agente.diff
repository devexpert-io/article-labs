+// La lista de espera de franjas, probada a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(fn: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+/** Franjas libres (y por tanto reservables) de un día, para montar escenarios. */
+async function franjasLibres(api: Api, fecha: string): Promise<{ pistaId: string; inicio: string }[]> {
+  const disp = (await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`)).cuerpo;
+  const resultado: { pistaId: string; inicio: string }[] = [];
+  for (const p of disp.pistas) {
+    for (const f of p.franjas) {
+      if (f.estado === "libre") resultado.push({ pistaId: p.pistaId, inicio: f.inicio });
+    }
+  }
+  return resultado;
+}
+
+const FRANJA_OCUPADA = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+
+test("apuntarse a una franja ocupada y sin X-Socio", () => conApi(async (api) => {
+  const sinSocio = await api.pedir("POST", "/api/esperas", { cuerpo: FRANJA_OCUPADA });
+  assert.equal(sinSocio.status, 401);
+  assert.equal(sinSocio.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const creada = await api.pedir("POST", "/api/esperas", { socio: "socio-010", cuerpo: FRANJA_OCUPADA });
+  assert.equal(creada.status, 201);
+  assert.equal(creada.cuerpo.espera.estado, "activa");
+  assert.equal(creada.cuerpo.espera.socioId, "socio-010");
+  assert.equal(creada.cuerpo.espera.pistaId, "pista-1");
+  assert.equal(creada.cuerpo.espera.inicio, "2026-11-19T19:30");
+  assert.equal(creada.cuerpo.espera.posicion, 1);
+}));
