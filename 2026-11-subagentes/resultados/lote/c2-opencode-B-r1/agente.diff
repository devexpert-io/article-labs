+++ b/test/exportar-csv.test.ts
@@ -0,0 +1,241 @@
+// La exportación de reservas a CSV, probada a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+/** Parte el CSV por CRLF y devuelve las líneas (cabecera y filas), descartando el CRLF final. */
+function lineas(texto: string): string[] {
+  const trozos = texto.split("\r\n");
+  assert.equal(trozos[trozos.length - 1], "", "el CSV debe terminar en CRLF");
+  return trozos.slice(0, -1);
+}
+
+/** Parsea una línea CSV según RFC 4180. */
+function campos(linea: string): string[] {
+  const resultado: string[] = [];
+  let campo = "";
+  let entreComillas = false;
+  for (let i = 0; i < linea.length; i++) {
+    const c = linea[i]!;
+    if (entreComillas) {
+      if (c === '"') {
+        if (linea[i + 1] === '"') {
+          campo += '"';
+          i += 1;
+        } else {
+          entreComillas = false;
+        }
+      } else {
+        campo += c;
+      }
+    } else if (c === '"') {
+      entreComillas = true;
+    } else if (c === ",") {
+      resultado.push(campo);
+      campo = "";
+    } else {
+      campo += c;
+    }
+  }
+  resultado.push(campo);
+  return resultado;
+}
+
+test("solo los gestores pueden exportar", async () => {
+  const sinSocio = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-01&hasta=2026-11-30");
+  assert.equal(sinSocio.status, 401);
+  assert.equal(sinSocio.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const socio = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-01&hasta=2026-11-30", { socio: "socio-001" });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const gestor = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-01&hasta=2026-11-30", { socio: GESTOR });
+  assert.equal(gestor.status, 200);
+});
+
+test("responde 200 con las cabeceras y la cabecera CSV exacta", async () => {
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-20", { socio: GESTOR });
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-11-19-2026-11-20.csv"');
+  assert.ok(r.texto.startsWith(`${CABECERA}\r\n`), "la primera línea es la cabecera exacta seguida de CRLF");
+});
+
+test("cada línea, incluida la última, termina en CRLF", async () => {
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19", { socio: GESTOR });
+  assert.ok(r.texto.endsWith("\r\n"), "el CSV termina en CRLF");
+  // El periodo usado no tiene notas con saltos de línea, así que no debe haber ningún LF suelto.
+  assert.ok(!/(?<!\r)\n/.test(r.texto), "no hay saltos de línea que no vayan precedidos de CR");
+});
+
+test("una fila por reserva del periodo, ordenada por inicio y pista", async () => {
+  const desde = "2026-11-19";
+  const hasta = "2026-11-20";
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const pistas = new Map<string, string>(estado.pistas.map((p: { id: string; nombre: string }) => [p.id, p.nombre]));
+  const socios = new Map<string, { id: string; nombre: string; email: string }>(
+    estado.socios.map((s: { id: string; nombre: string; email: string }) => [s.id, s]),
+  );
+  const esperadas = estado.reservas
+    .filter((r: { inicio: string }) => r.inicio.slice(0, 10) >= desde && r.inicio.slice(0, 10) <= hasta)
+    .slice()
+    .sort((a: { inicio: string; pistaId: string }, b: { inicio: string; pistaId: string }) =>
+      a.inicio === b.inicio ? a.pistaId.localeCompare(b.pistaId) : a.inicio.localeCompare(b.inicio));
+
+  const r = await api.pedir("GET", `/api/reservas/exportar?desde=${desde}&hasta=${hasta}`, { socio: GESTOR });
+  const filas = lineas(r.texto).slice(1);
+  assert.equal(filas.length, esperadas.length, "una fila por cada reserva del periodo");
+
+  filas.forEach((linea, i) => {
+    const c = campos(linea);
+    const e = esperadas[i]!;
+    assert.equal(c[0], e.id);
+    assert.equal(c[1], e.inicio.slice(0, 10));
+    assert.equal(c[2], e.inicio.slice(11));
+    assert.equal(c[3], pistas.get(e.pistaId));
+    assert.equal(c[4], socios.get(e.socioId)?.nombre);
+    assert.equal(c[5], socios.get(e.socioId)?.email);
+    assert.equal(c[6], e.estado);
+  });
