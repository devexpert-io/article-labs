+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+const franja = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+const otra = { pistaId: "pista-2", inicio: "2026-11-21T15:00" };
+const tercera = { pistaId: "pista-1", inicio: "2026-11-21T16:30" };
+const apuntar = (api: Api, socio = "socio-041", cuerpo = franja) => api.pedir("POST", "/api/esperas", { socio, cuerpo });
+async function reservaDeFranja(api: Api, inicio = franja.inicio, pistaId = franja.pistaId) {
+  const r = await api.pedir("GET", `/api/reservas?fecha=${inicio.slice(0, 10)}&pista=${pistaId}&estado=confirmada`);
+  return r.cuerpo.reservas.find((r: any) => r.inicio === inicio);
+}
+
+test("esperas: identidad, validaciones, duplicados y límite", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  for (const [metodo, ruta] of [["POST", "/api/esperas"], ["GET", "/api/esperas"], ["DELETE", "/api/esperas/E-0001"]]) {
+    const r = await api.pedir(metodo!, ruta!, { cuerpo: metodo === "POST" ? franja : undefined });
+    assert.equal(r.status, 401); assert.equal(r.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  }
+  for (const [datos, socio, http, codigo] of [
+    [{ ...franja, pistaId: "inexistente" }, "socio-041", 404, "PISTA_NO_ENCONTRADA"],
+    [{ ...franja, pistaId: "pista-4" }, "socio-041", 409, "PISTA_CERRADA"],
+    [{ ...franja, inicio: "2026-11-19T11:00" }, "socio-041", 400, "FRANJA_INVALIDA"],
+    [{ ...franja, inicio: "2026-11-18T09:00" }, "socio-041", 409, "FRANJA_PASADA"],
+    [franja, "socio-011", 409, "CUOTA_INACTIVA"],
+    [{ ...franja, pistaId: "pista-2" }, "socio-041", 409, "FRANJA_LIBRE"],
+    [franja, "socio-007", 409, "YA_RESERVADA"],
+  ] as const) {
+    const r = await apuntar(api, socio, datos); assert.equal(r.status, http); assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+  const primera = await apuntar(api); assert.equal(primera.status, 201); assert.equal(primera.cuerpo.espera.estado, "activa"); assert.equal(primera.cuerpo.espera.posicion, 1);
+  assert.equal((await apuntar(api)).cuerpo.error.codigo, "YA_EN_ESPERA");
+  assert.equal((await apuntar(api, "socio-041", otra)).status, 201);
+  assert.equal((await apuntar(api, "socio-041", tercera)).cuerpo.error.codigo, "LIMITE_DE_ESPERAS");
+});
+
+test("esperas: consulta, permisos, retirada y posiciones actuales", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const a = (await apuntar(api)).cuerpo.espera;
+  const b = (await apuntar(api, "socio-004")).cuerpo.espera; assert.equal(b.posicion, 2);
+  assert.equal((await api.pedir("GET", "/api/esperas?socio=socio-041", { socio: "socio-004" })).status, 403);
+  assert.equal((await api.pedir("DELETE", `/api/esperas/${a.id}`, { socio: "socio-004" })).status, 403);
+  assert.equal((await api.pedir("GET", "/api/esperas?socio=socio-041", { socio: "socio-040" })).cuerpo.esperas[0].id, a.id);
+  const retirada = await api.pedir("DELETE", `/api/esperas/${a.id}`, { socio: "socio-040" });
+  assert.equal(retirada.cuerpo.espera.estado, "retirada"); assert.equal(retirada.cuerpo.espera.posicion, undefined);
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-004" })).cuerpo.esperas[0].posicion, 1);
+  assert.equal((await api.pedir("DELETE", `/api/esperas/${b.id}`, { socio: "socio-004" })).status, 200);
+  const ausente = await api.pedir("DELETE", "/api/esperas/no-existe", { socio: "socio-041" });
+  assert.equal(ausente.status, 404); assert.equal(ausente.cuerpo.error.codigo, "ESPERA_NO_ENCONTRADA");
+});
+
+test("esperas: asignación FIFO, precio, nota y cancelación gratuita", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  await apuntar(api); await apuntar(api, "socio-004");
+  const original = await reservaDeFranja(api);
+  const cancelada = await api.pedir("POST", `/api/reservas/${original.id}/cancelar`);
+  assert.equal(cancelada.status, 200); assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+  const asignada = (await api.pedir("GET", `/api/reservas/${cancelada.cuerpo.asignadaA}`)).cuerpo.reserva;
+  assert.equal(asignada.socioId, "socio-041"); assert.equal(asignada.estado, "confirmada"); assert.equal(asignada.importe, 2800);
+  assert.equal(asignada.notas, "Asignada desde la lista de espera");
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.esperas[0].estado, "asignada");
+  assert.deepEqual((await api.pedir("GET", "/api/esperas", { socio: "socio-041" })).cuerpo.esperas, []);
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-004" })).cuerpo.esperas[0].posicion, 1);
+});
+
+test("esperas: saltar al límite de reservas y asignar con cancelación forzada", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  await apuntar(api); await apuntar(api, "socio-004");
+  for (const hora of ["09:00", "10:30", "12:00"]) {
+    assert.equal((await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `2026-12-01T${hora}` } })).status, 201);
+  }
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-19T10:00" } });
+  const original = await reservaDeFranja(api);
+  assert.equal((await api.pedir("POST", `/api/reservas/${original.id}/cancelar`)).cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const cancelada = await api.pedir("POST", `/api/reservas/${original.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 2800);
+  assert.equal((await api.pedir("GET", `/api/reservas/${cancelada.cuerpo.asignadaA}`)).cuerpo.reserva.socioId, "socio-004");
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.esperas[0].estado, "descartada");
+});
+
+test("esperas: descartar cuota que dejó de estar activa", () => {
+  // La API no permite cambiar cuotas; simulamos esa variación en el estado del club.
+  const estado = crearSemilla(); const club = crearClub(estado);
+  const nora = estado.socios.find((s) => s.id === "socio-041")!;
+  club.crearEspera(nora, franja); club.crearEspera(estado.socios.find((s) => s.id === "socio-004")!, franja);
+  nora.cuotaActiva = false;
+  const original = estado.reservas.find((r) => r.pistaId === franja.pistaId && r.inicio === franja.inicio)!;
+  const resultado = club.cancelarReserva(original.id, {});
+  assert.equal(estado.esperas[0]!.estado, "descartada");
+  assert.equal(estado.reservas.find((r) => r.id === resultado.asignadaA)!.socioId, "socio-004");
+});
+
+test("esperas: caducan al inicio, liberan el límite y no se asignan", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  await apuntar(api); await apuntar(api, "socio-041", otra);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: franja.inicio } });
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-041" })).cuerpo.esperas.length, 1);
+  assert.equal((await apuntar(api, "socio-041", tercera)).status, 201);
+  const original = await reservaDeFranja(api);
+  assert.equal((await api.pedir("POST", `/api/reservas/${original.id}/cancelar`, { cuerpo: { forzar: true } })).cuerpo.error.codigo, "RESERVA_PASADA");
+  const sinLista = await reservaDeFranja(api, "2026-11-23T18:00");
+  const cancelada = await api.pedir("POST", `/api/reservas/${sinLista.id}/cancelar`);
+  assert.equal(cancelada.status, 200); assert.equal(cancelada.cuerpo.asignadaA, null);
+});
