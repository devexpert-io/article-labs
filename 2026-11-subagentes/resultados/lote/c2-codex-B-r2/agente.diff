@@ -0,0 +1,87 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { arrancarApi } from "./ayuda.ts";
+import type { Estado } from "../src/tipos.ts";
+
+const periodo = "/api/reservas/exportar?desde=2026-10-01&hasta=2026-11-24";
+const gestor = { socio: "socio-040" };
+const cabecera = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas\r\n";
+
+test("CSV: permisos, cabeceras y exportación completa sin cambiar el listado", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const [socio, status, codigo] of [[undefined, 401, "NO_IDENTIFICADO"], ["socio-041", 403, "SIN_PERMISO"], ["inexistente", 401, "NO_IDENTIFICADO"]] as const) {
+    const r = await api.pedir("GET", periodo, { socio });
+    assert.equal(r.status, status);
+    assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+  const antes = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-11-24&limite=3&pagina=2");
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const r = await api.pedir("GET", periodo, gestor);
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-11-24.csv"');
+  assert.ok(r.texto.startsWith(cabecera));
+  assert.ok(r.texto.endsWith("\r\n"));
+  assert.equal(r.texto.replaceAll("\r\n", "").includes("\n"), false);
+  const filas = r.texto.slice(cabecera.length, -2).split("\r\n").map((fila) => fila.split(","));
+  assert.ok(filas.length > 100);
+  const esperadas = [...estado.reservas].sort((a, b) => a.inicio.localeCompare(b.inicio) || a.pistaId.localeCompare(b.pistaId));
+  assert.deepEqual(filas.map((f) => f[0]), esperadas.map((reserva) => reserva.id));
+  assert.deepEqual(new Set(filas.map((f) => f[6])), new Set(["confirmada", "cancelada", "no_presentada"]));
+  for (const [i, reserva] of esperadas.entries()) {
+    const fila = filas[i]!;
+    assert.equal(fila[1], reserva.inicio.slice(0, 10));
+    assert.equal(fila[2], reserva.inicio.slice(11));
+    assert.equal(fila[3], estado.pistas.find((p) => p.id === reserva.pistaId)!.nombre);
+    assert.equal(fila[4], estado.socios.find((s) => s.id === reserva.socioId)!.nombre);
+    assert.equal(fila[5], estado.socios.find((s) => s.id === reserva.socioId)!.email);
+    assert.match(fila[7]!, /^\d+\.\d{2}$/);
+    assert.equal(fila[8], "");
+  }
+  const despues = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-11-24&limite=3&pagina=2");
+  assert.deepEqual(despues.cuerpo, antes.cuerpo);
+});
+
+test("CSV: extremos incluidos, importes y escapado RFC 4180", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const notas = ["Con monitor, traer palas", 'Dice "hola"', "Primera línea\r\nSegunda línea\nFinal"];
+  const escapadas = ['"Con monitor, traer palas"', '"Dice ""hola"""', '"Primera línea\r\nSegunda línea\nFinal"'];
+  const ids: string[] = [];
+  for (let i = 0; i < notas.length; i++) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `2026-11-${25 + i}T09:00`, notas: notas[i] } });
+    assert.equal(r.status, 201);
+    ids.push(r.cuerpo.reserva.id);
+  }
+  const csv = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-25&hasta=2026-11-27", gestor);
+  assert.equal(csv.texto, cabecera + ids.map((id, i) => `${id},2026-11-${25 + i},09:00,Pista 1,Nora Benítez,nora.benitez@example.com,confirmada,18.00,,${escapadas[i]}\r\n`).join(""));
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const marta = estado.reservas.find((r) => r.socioId === "socio-002" && r.inicio === "2026-11-19T09:00")!;
+  assert.equal((await api.pedir("POST", `/api/reservas/${marta.id}/cancelar`, { cuerpo: { forzar: true } })).status, 200);
+  const penalizada = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19&estado=cancelada", gestor);
+  assert.ok(penalizada.texto.includes(`${marta.id},2026-11-19,09:00,Pista 3,Marta López,marta.lopez@example.com,cancelada,12.00,12.00,\r\n`));
+});
+
+test("CSV: validación de periodo, máximo inclusivo, filtros y periodos vacíos", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const query of ["", "desde=2026-11-01", "hasta=2026-11-01", "desde=&hasta=2026-11-01", "desde=01-11-2026&hasta=2026-11-01", "desde=2026-02-30&hasta=2026-11-01", "desde=2026-11-02&hasta=2026-11-01", "desde=2026-11-01&hasta=2026-11-02&estado=otro", "desde=2026-11-01&hasta=2026-11-02&estado="]) {
+    const r = await api.pedir("GET", `/api/reservas/exportar?${query}`, gestor);
+    assert.equal(r.status, 400, query);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", query);
+  }
+  const grande = await api.pedir("GET", "/api/reservas/exportar?desde=2026-01-01&hasta=2026-04-03", gestor);
+  assert.equal(grande.status, 400);
+  assert.equal(grande.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+  const maximo = await api.pedir("GET", "/api/reservas/exportar?desde=2026-01-01&hasta=2026-04-02", gestor);
+  assert.equal(maximo.status, 200);
+  assert.equal(maximo.texto, cabecera);
+  for (const filtro of ["confirmada", "cancelada", "no_presentada"]) {
+    const filtrada = await api.pedir("GET", `${periodo}&estado=${filtro}`, gestor);
+    assert.equal(filtrada.status, 200);
+    const filas = filtrada.texto.slice(cabecera.length, -2).split("\r\n");
+    assert.ok(filas.length > 0);
+    for (const fila of filas) assert.equal(fila.split(",")[6], filtro);
+  }
+});
