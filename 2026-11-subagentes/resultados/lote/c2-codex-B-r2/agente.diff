+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi } from "./ayuda.ts";
+
+test("una cancelación con descuento asigna la espera a precio completo y exporta ambos importes", async () => {
+  const api = await arrancarApi();
+  try {
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T10:30", codigo: "BIENVENIDA" },
+    });
+    assert.equal(creada.status, 201);
+    const original = creada.cuerpo.reserva;
+    assert.equal(original.importe, 900);
+    const espera = await api.pedir("POST", "/api/esperas", {
+      socio: "socio-004", cuerpo: { pistaId: original.pistaId, inicio: original.inicio },
+    });
+    assert.equal(espera.status, 201);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T09:00" } });
+    const cancelada = await api.pedir("POST", `/api/reservas/${original.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 900);
+    assert.ok(cancelada.cuerpo.asignadaA);
+    const asignada = (await api.pedir("GET", `/api/reservas/${cancelada.cuerpo.asignadaA}`)).cuerpo.reserva;
+    assert.equal(asignada.socioId, "socio-004");
+    assert.equal(asignada.importeBase, 1800);
+    assert.equal(asignada.descuento, 0);
+    assert.equal(asignada.importe, 1800);
+    assert.equal(asignada.codigo, undefined);
+    assert.equal(asignada.notas, "Asignada desde la lista de espera");
+    const csv = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-26&hasta=2026-11-26", { socio: "socio-040" });
+    assert.equal(csv.status, 200);
+    const filas = csv.texto.split("\r\n");
+    assert.equal(filas.length, 4);
+    const filaOriginal = filas.find((fila) => fila.startsWith(`${original.id},`));
+    const filaAsignada = filas.find((fila) => fila.startsWith(`${asignada.id},`));
+    assert.ok(filaOriginal?.includes(",cancelada,9.00,9.00,"));
+    assert.ok(filaAsignada?.includes(",confirmada,18.00,,Asignada desde la lista de espera"));
+    assert.deepEqual((await api.pedir("GET", "/api/esperas", { socio: "socio-004" })).cuerpo.esperas, []);
+  } finally {
+    api.cerrar();
+  }
+});
