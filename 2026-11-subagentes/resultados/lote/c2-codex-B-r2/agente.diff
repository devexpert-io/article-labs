+++ b/test/codigos-descuento.test.ts
@@ -0,0 +1,171 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+async function apiNueva(t: TestContext, ahora?: string): Promise<Api> {
+  const api = await arrancarApi(ahora ? { AHORA: ahora } : {});
+  t.after(() => api.cerrar());
+  return api;
+}
+
+function reservar(api: Api, codigo?: unknown, inicio = "2026-11-25T09:00", socioId = "socio-041", pistaId = "pista-1") {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio, ...(codigo === undefined ? {} : { codigo }) } });
+}
+
+test("sin código guarda los importes y GET los devuelve sin alterar el historial", async (t) => {
+  const api = await apiNueva(t);
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo.reservas[0];
+  const creada = await reservar(api);
+  assert.equal(creada.status, 201);
+  const r = creada.cuerpo.reserva;
+  assert.equal(r.importeBase, 1800);
+  assert.equal(r.descuento, 0);
+  assert.equal(r.importe, 1800);
+  assert.equal(Object.hasOwn(r, "codigo"), false);
+  assert.deepEqual((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva, r);
+  assert.deepEqual((await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.reservas, [r]);
+  assert.deepEqual((await api.pedir("GET", `/api/reservas/${antes.id}`)).cuerpo.reserva, antes);
+});
+
+test("BIENVENIDA descuenta la mitad y persiste el código normalizado", async (t) => {
+  const api = await apiNueva(t);
+  const creada = await reservar(api, "  bienvenida ");
+  assert.equal(creada.status, 201);
+  const r = creada.cuerpo.reserva;
+  assert.equal(r.importeBase, 1800);
+  assert.equal(r.descuento, 900);
+  assert.equal(r.importe, 900);
+  assert.equal(r.codigo, "BIENVENIDA");
+  assert.deepEqual((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva, r);
+  assert.deepEqual((await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.reservas, [r]);
+  await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+  const segunda = await reservar(api, "BIENVENIDA", "2026-11-26T09:00");
+  assert.equal(segunda.status, 409);
+  assert.equal(segunda.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  const historial = await reservar(api, "BIENVENIDA", "2026-11-26T09:00", "socio-004");
+  assert.equal(historial.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("BIENVENIDA usa la fecha del club, incluida toda la fecha de caducidad", async (t) => {
+  const api = await apiNueva(t, "2026-12-31T23:59");
+  assert.equal((await reservar(api, "BIENVENIDA", "2027-01-04T09:00")).status, 201);
+  const caducada = await apiNueva(t, "2027-01-01T00:00");
+  const resultado = await reservar(caducada, "BIENVENIDA", "2027-01-04T09:00");
+  assert.equal(resultado.status, 409);
+  assert.equal(resultado.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("MANANAS permite lunes a viernes a las 09:00 y 10:30 y rechaza el mediodía y el fin de semana", async (t) => {
+  const api = await apiNueva(t);
+  for (const inicio of ["2026-11-25T09:00", "2026-11-27T10:30"]) {
+    const r = await reservar(api, "MANANAS", inicio);
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.descuento, 400);
+    assert.equal(r.cuerpo.reserva.importe, 1400);
+  }
+  for (const inicio of ["2026-11-26T12:00", "2026-11-26T18:00", "2026-11-28T09:00", "2026-11-29T10:30"]) {
+    const r = await reservar(api, "MANANAS", inicio);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-01T00:00" } });
+  assert.equal((await reservar(api, "MANANAS", "2027-01-04T09:00")).status, 201);
+});
+
+test("CLUB10 permite tres usos, también históricos, y cancelar libera un uso", async (t) => {
+  const api = await apiNueva(t);
+  const reservas = [];
+  for (const inicio of ["2026-11-25T09:00", "2026-11-26T18:00", "2026-11-28T10:30"]) {
+    const r = await reservar(api, "  club10 ", inicio);
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.codigo, "CLUB10");
+    assert.equal(r.cuerpo.reserva.descuento, r.cuerpo.reserva.importeBase / 10);
+    reservas.push(r.cuerpo.reserva);
+  }
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T10:00" } });
+  const agotado = await reservar(api, "CLUB10", "2026-11-30T09:00");
+  assert.equal(agotado.status, 409);
+  assert.equal(agotado.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  await api.pedir("POST", `/api/reservas/${reservas[2].id}/cancelar`);
+  assert.equal((await reservar(api, "CLUB10", "2026-11-30T09:00")).status, 201);
+});
+
+test("los códigos desconocidos y múltiples son inválidos; los valores no textuales son datos inválidos", async (t) => {
+  const api = await apiNueva(t);
+  for (const codigo of ["INVENTADO", "", " ", "CLUB10,MANANAS", "CLUB10 MANANAS"]) {
+    const r = await reservar(api, codigo);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_INVALIDO");
+  }
+  for (const codigo of [null, 10, true, {}, ["CLUB10", "MANANAS"]]) {
+    const r = await reservar(api, codigo);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.total, 0);
+});
+
+test("las reglas del club preceden al código y los intentos fallidos no lo consumen", async (t) => {
+  const api = await apiNueva(t);
+  const casos = [
+    { socioId: "socio-011", pistaId: "pista-1", inicio: "2026-11-25T09:00", error: "CUOTA_INACTIVA" },
+    { socioId: "socio-041", pistaId: "pista-4", inicio: "2026-11-25T09:00", error: "PISTA_CERRADA" },
+    { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-17T09:00", error: "FRANJA_PASADA" },
+    { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-19T19:30", error: "FRANJA_NO_DISPONIBLE" },
+    { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T08:00", error: "FRANJA_INVALIDA" },
+    { socioId: "socio-041", pistaId: "no-existe", inicio: "2026-11-25T09:00", error: "PISTA_NO_ENCONTRADA" },
+  ];
+  for (const { error, ...cuerpo } of casos) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { ...cuerpo, codigo: "INVENTADO" } });
+    assert.equal(r.cuerpo.error.codigo, error);
+  }
+  const primera = await reservar(api, "BIENVENIDA");
+  assert.equal(primera.status, 201);
+  await reservar(api, undefined, "2026-11-26T09:00");
+  await reservar(api, undefined, "2026-11-27T09:00");
+  const limite = await reservar(api, 12, "2026-11-30T09:00");
+  assert.equal(limite.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+});
+
+test("la penalización usa el importe descontado y la disponibilidad conserva el precio base", async (t) => {
+  const api = await apiNueva(t);
+  const antes = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-25&pista=pista-1")).cuerpo;
+  const creada = await reservar(api, "MANANAS");
+  const r = creada.cuerpo.reserva;
+  const despues = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-25&pista=pista-1")).cuerpo;
+  assert.equal(antes.pistas[0].franjas[0].precio, 1800);
+  assert.equal(despues.pistas[0].franjas[0].precio, 1800);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-24T10:00" } });
+  const rechazada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+  assert.equal(rechazada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1400);
+});
+
+// No existe una operación HTTP para marcar no presentadas o cambiar precios.
+test("CLUB10 cuenta las no presentadas y BIENVENIDA cualquier estado anterior", () => {
+  for (const estadoAnterior of ["confirmada", "cancelada", "no_presentada"] as const) {
+    const estado = crearSemilla();
+    const club = crearClub(estado);
+    const r = club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00" }).reserva;
+    r.estado = estadoAnterior;
+    assert.throws(() => club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T09:00", codigo: "BIENVENIDA" }), { codigo: "CODIGO_NO_APLICABLE" });
+  }
+  const estado = crearSemilla();
+  const club = crearClub(estado);
+  for (const inicio of ["2026-11-25T09:00", "2026-11-26T09:00", "2026-11-27T09:00"]) {
+    club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio, codigo: "CLUB10" }).reserva.estado = "no_presentada";
+  }
+  assert.throws(() => club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-30T09:00", codigo: "CLUB10" }), { codigo: "CODIGO_NO_APLICABLE" });
+});
+
+test("un descuento fijo nunca deja un importe negativo", () => {
+  const estado = crearSemilla();
+  estado.pistas[0]!.precioValle = 300;
+  const r = crearClub(estado).crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "MANANAS" }).reserva;
+  assert.equal(r.importeBase, 300);
+  assert.equal(r.descuento, 300);
+  assert.equal(r.importe, 0);
+});
