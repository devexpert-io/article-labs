+++ b/src/exportar-csv.ts
@@ -0,0 +1,37 @@
+import { ErrorDelClub } from "./nucleo.ts";
+import type { Estado, Socio } from "./tipos.ts";
+
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+
+function fechaValida(fecha: string | null): fecha is string {
+  if (fecha === null || !/^\d{4}-\d{2}-\d{2}$/.test(fecha)) return false;
+  const instante = Date.parse(`${fecha}T00:00:00Z`);
+  return Number.isFinite(instante) && new Date(instante).toISOString().slice(0, 10) === fecha;
+}
+
+function campo(valor: string): string {
+  return /[,"\r\n]/.test(valor) ? `"${valor.replaceAll('"', '""')}"` : valor;
+}
+
+export function exportarReservasCsv(estado: Estado, quien: Socio | undefined, desde: string | null, hasta: string | null, filtro: string | null): string {
+  if (!quien) throw new ErrorDelClub("NO_IDENTIFICADO", "Debes identificarte para exportar reservas", 401);
+  if (quien.rol !== "gestor") throw new ErrorDelClub("SIN_PERMISO", "Solo los gestores pueden exportar reservas", 403);
+  if (!fechaValida(desde) || !fechaValida(hasta) || desde > hasta) {
+    throw new ErrorDelClub("DATOS_INVALIDOS", "desde y hasta deben ser fechas AAAA-MM-DD en orden", 400);
+  }
+  if ((Date.parse(`${hasta}T00:00:00Z`) - Date.parse(`${desde}T00:00:00Z`)) / 86_400_000 + 1 > 92) {
+    throw new ErrorDelClub("RANGO_DEMASIADO_GRANDE", "El periodo puede abarcar como máximo 92 días", 400);
+  }
+  if (filtro !== null && !["confirmada", "cancelada", "no_presentada"].includes(filtro)) {
+    throw new ErrorDelClub("DATOS_INVALIDOS", "estado debe ser confirmada, cancelada o no_presentada", 400);
+  }
+  const reservas = estado.reservas.filter((r) => r.inicio.slice(0, 10) >= desde && r.inicio.slice(0, 10) <= hasta && (filtro === null || r.estado === filtro));
+  reservas.sort((a, b) => a.inicio.localeCompare(b.inicio) || a.pistaId.localeCompare(b.pistaId));
+  const filas = reservas.map((r) => {
+    const pista = estado.pistas.find((p) => p.id === r.pistaId)!;
+    const socio = estado.socios.find((s) => s.id === r.socioId)!;
+    return [r.id, r.inicio.slice(0, 10), r.inicio.slice(11), pista.nombre, socio.nombre, socio.email, r.estado,
+      (r.importe / 100).toFixed(2), r.penalizacion === undefined ? "" : (r.penalizacion / 100).toFixed(2), r.notas].map(campo).join(",");
+  });
+  return [CABECERA, ...filas].join("\r\n") + "\r\n";
+}
