@@ -0,0 +1,166 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+const inicios = ["2026-12-01T09:00", "2026-12-02T09:00", "2026-12-03T09:00"];
+async function preparar(api: Api) {
+  const ids: string[] = [];
+  for (const inicio of inicios) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio } });
+    assert.equal(r.status, 201);
+    ids.push(r.cuerpo.reserva.id);
+  }
+  return ids;
+}
+const apuntar = (api: Api, socio = "socio-002", inicio = inicios[0], pistaId = "pista-1") =>
+  api.pedir("POST", "/api/esperas", { socio, cuerpo: { pistaId, inicio } });
+const comprobarError = (r: any, status: number, codigo: string) => {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+};
+
+test("esperas: identidad, alta, duplicados, reserva propia, límite y validaciones", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  await preparar(api);
+  for (const [metodo, ruta] of [["POST", "/api/esperas"], ["GET", "/api/esperas"], ["DELETE", "/api/esperas/E-0001"]]) {
+    comprobarError(await api.pedir(metodo!, ruta!), 401, "NO_IDENTIFICADO");
+  }
+  comprobarError(await apuntar(api, "socio-041"), 409, "YA_RESERVADA");
+  for (const [socio, inicio, pista, status, codigo] of [
+    ["socio-002", inicios[0], "pista-999", 404, "PISTA_NO_ENCONTRADA"],
+    ["socio-002", inicios[0], "pista-4", 409, "PISTA_CERRADA"],
+    ["socio-002", "2026-12-01T09:15", "pista-1", 400, "FRANJA_INVALIDA"],
+    ["socio-002", "2026-11-18T09:00", "pista-1", 409, "FRANJA_PASADA"],
+    ["socio-011", inicios[0], "pista-1", 409, "CUOTA_INACTIVA"],
+    ["socio-002", inicios[0], "pista-2", 409, "FRANJA_LIBRE"],
+  ] as const) {
+    comprobarError(await apuntar(api, socio, inicio, pista), status, codigo);
+  }
+  comprobarError(await api.pedir("POST", "/api/esperas", { socio: "socio-002", cuerpo: { pistaId: 1 } }), 400, "DATOS_INVALIDOS");
+  const primera = await apuntar(api);
+  assert.equal(primera.status, 201);
+  assert.deepEqual(primera.cuerpo.espera, { id: "E-0001", socioId: "socio-002", pistaId: "pista-1", inicio: inicios[0], estado: "activa", posicion: 1 });
+  comprobarError(await apuntar(api), 409, "YA_EN_ESPERA");
+  assert.equal((await apuntar(api, "socio-002", inicios[1])).status, 201);
+  comprobarError(await apuntar(api, "socio-002", inicios[2]), 409, "LIMITE_DE_ESPERAS");
+});
+
+test("esperas: posiciones dinámicas, consultas y retirada con permisos", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  await preparar(api);
+  const primera = (await apuntar(api)).cuerpo.espera;
+  const segunda = (await apuntar(api, "socio-004")).cuerpo.espera;
+  assert.equal(segunda.posicion, 2);
+  const propias = await api.pedir("GET", "/api/esperas", { socio: "socio-004" });
+  assert.deepEqual(propias.cuerpo.esperas, [segunda]);
+  assert.deepEqual((await api.pedir("GET", "/api/esperas?socio=socio-004", { socio: "socio-040" })).cuerpo, propias.cuerpo);
+  comprobarError(await api.pedir("GET", "/api/esperas?socio=socio-004", { socio: "socio-002" }), 403, "SIN_PERMISO");
+  comprobarError(await api.pedir("DELETE", "/api/esperas/" + primera.id, { socio: "socio-004" }), 403, "SIN_PERMISO");
+  comprobarError(await api.pedir("DELETE", "/api/esperas/no-existe", { socio: "socio-040" }), 404, "ESPERA_NO_ENCONTRADA");
+  const retirada = await api.pedir("DELETE", "/api/esperas/" + primera.id, { socio: "socio-002" });
+  assert.equal(retirada.status, 200);
+  assert.equal(retirada.cuerpo.espera.estado, "retirada");
+  assert.equal(Object.hasOwn(retirada.cuerpo.espera, "posicion"), false);
+  assert.deepEqual((await api.pedir("GET", "/api/esperas", { socio: "socio-002" })).cuerpo.esperas, []);
