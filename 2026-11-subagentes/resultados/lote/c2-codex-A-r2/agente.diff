+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi } from "./ayuda.ts";
+
+const cabecera = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas\r\n";
+
+test("CSV: permisos, cabeceras, todas las filas ordenadas y listado intacto", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const ruta = "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-31";
+  for (const [socio, status, codigo] of [[undefined, 401, "NO_IDENTIFICADO"], ["socio-041", 403, "SIN_PERMISO"]] as const) {
+    const r = await api.pedir("GET", ruta, { socio });
+    assert.equal(r.status, status);
+    assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+  const antes = (await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31")).cuerpo;
+  const r = await api.pedir("GET", ruta, { socio: "socio-040" });
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-10-31.csv"');
+  assert.ok(r.texto.startsWith(cabecera));
+  assert.ok(r.texto.endsWith("\r\n"));
+  assert.equal(r.texto.replaceAll("\r\n", "").includes("\n"), false);
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const esperadas = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10"))
+    .sort((a: any, b: any) => a.inicio.localeCompare(b.inicio) || a.pistaId.localeCompare(b.pistaId));
+  const filas = r.texto.slice(cabecera.length).trimEnd().split("\r\n");
+  assert.equal(filas.length, 315);
+  for (const [i, reserva] of esperadas.entries()) {
+    const socio = estado.socios.find((s: any) => s.id === reserva.socioId);
+    const pista = estado.pistas.find((p: any) => p.id === reserva.pistaId);
+    assert.equal(filas[i], [reserva.id, reserva.inicio.slice(0, 10), reserva.inicio.slice(11), pista.nombre,
+      socio.nombre, socio.email, reserva.estado, (reserva.importe / 100).toFixed(2), "", ""].join(","));
+  }
+  assert.deepEqual((await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31")).cuerpo, antes);
+  for (const estado of ["confirmada", "cancelada", "no_presentada"]) {
+    const filtrada = await api.pedir("GET", ruta + "&estado=" + estado, { socio: "socio-040" });
+    assert.equal(filtrada.texto.split("\r\n").length - 2, esperadas.filter((r: any) => r.estado === estado).length);
+  }
+});
+
+test("CSV: escapado RFC 4180, penalización y periodo vacío", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const notas = ['normal', 'una,coma', 'dice "hola"', 'dos\nlíneas', 'dos\rlíneas'];
+  for (const [i, nota] of notas.entries()) {
+    const inicio = "2026-12-0" + (i + 1) + "T09:00";
+    const nueva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio, notas: nota } });
+    assert.equal(nueva.status, 201);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: inicio.slice(0, 10) + "T08:00" } });
+    await api.pedir("POST", "/api/reservas/" + nueva.cuerpo.reserva.id + "/cancelar", { cuerpo: { forzar: true } });
+    const csv = await api.pedir("GET", "/api/reservas/exportar?desde=" + inicio.slice(0, 10) + "&hasta=" + inicio.slice(0, 10), { socio: "socio-040" });
+    const escapada = i === 0 ? nota : '"' + nota.replaceAll('"', '""') + '"';
+    assert.ok(csv.texto.endsWith(",cancelada," + (nueva.cuerpo.reserva.importe / 100).toFixed(2) + "," +
+      (nueva.cuerpo.reserva.importe / 100).toFixed(2) + "," + escapada + "\r\n"));
+  }
+  assert.equal((await api.pedir("GET", "/api/reservas/exportar?desde=2027-01-01&hasta=2027-01-01", { socio: "socio-040" })).texto, cabecera);
+});
+
+test("CSV: fechas y estados inválidos y límite inclusivo de 92 días", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const q of ["", "desde=2026-11-01", "hasta=2026-11-01", "desde=x&hasta=2026-11-01",
+    "desde=2026-02-30&hasta=2026-03-01", "desde=2026-11-02&hasta=2026-11-01",
+    "desde=2026-11-01&hasta=2026-11-02&estado=", "desde=2026-11-01&hasta=2026-11-02&estado=otra"]) {
+    const r = await api.pedir("GET", "/api/reservas/exportar?" + q, { socio: "socio-040" });
+    assert.equal(r.status, 400, q);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", q);
+  }
+  assert.equal((await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2026-12-31", { socio: "socio-040" })).status, 200);
+  const larga = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2027-01-01", { socio: "socio-040" });
+  assert.equal(larga.status, 400);
+  assert.equal(larga.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+});
