diff --git a/test/codigos-descuento.test.ts b/test/codigos-descuento.test.ts
new file mode 100644
index 0000000..a3d7f79
--- /dev/null
+++ b/test/codigos-descuento.test.ts
@@ -0,0 +1,123 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+const crear = (api: Api, inicio: string, codigo?: unknown, socioId = "socio-041", pistaId = "pista-1") =>
+  api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio, ...(codigo === undefined ? {} : { codigo }) } });
+
+test("descuentos: importes guardados, normalización, lectura y disponibilidad base", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const [i, codigo, descuento] of [[1, " bienvenida ", 900], [2, "  club10 ", 180], [3, undefined, 0]] as const) {
+    const r = await crear(api, "2026-12-0" + i + "T09:00", codigo);
+    assert.equal(r.status, 201);
+    const reserva = r.cuerpo.reserva;
+    assert.equal(reserva.importeBase, 1800);
+    assert.equal(reserva.descuento, descuento);
+    assert.equal(reserva.importe, 1800 - descuento);
+    assert.equal(reserva.codigo, codigo?.trim().toUpperCase());
+    assert.equal(Object.hasOwn(reserva, "codigo"), codigo !== undefined);
+    assert.deepEqual((await api.pedir("GET", "/api/reservas/" + reserva.id)).cuerpo.reserva, reserva);
+    assert.ok((await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.reservas.some((r: any) => JSON.stringify(r) === JSON.stringify(reserva)));
+    const disponibilidad = await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-0" + i + "&pista=pista-1");
+    assert.equal(disponibilidad.cuerpo.pistas[0].franjas[0].precio, 1800);
+  }
+});
+
+test("BIENVENIDA: historial en cualquier estado y vencimiento por reloj del club", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const usada = await crear(api, "2026-12-01T09:00", "BIENVENIDA");
+  await api.pedir("POST", "/api/reservas/" + usada.cuerpo.reserva.id + "/cancelar");
+  assert.equal((await crear(api, "2026-12-02T09:00", "BIENVENIDA")).cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  assert.equal((await crear(api, "2026-12-02T09:00", "BIENVENIDA", "socio-002")).cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  for (const ahora of ["2026-12-31T23:59", "2027-01-01T00:00"]) {
+    const otra = await arrancarApi({ AHORA: ahora });
+    t.after(() => otra.cerrar());
+    const r = await crear(otra, "2027-01-04T09:00", "BIENVENIDA");
+    assert.equal(r.status, ahora.startsWith("2026") ? 201 : 409);
+    if (r.status === 409) assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }
+});
+
+test("MANANAS: lunes a viernes antes de mediodía y penalización del importe descontado", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const inicio of ["2026-11-28T09:00", "2026-11-29T10:30", "2026-11-30T12:00", "2026-11-30T18:00"]) {
+    const r = await crear(api, inicio, "MANANAS");
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }
+  for (const inicio of ["2026-11-30T09:00", "2026-12-01T10:30", "2026-12-04T09:00"]) {
+    const r = await crear(api, inicio, "MANANAS");
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.descuento, 400);
+    assert.equal(r.cuerpo.reserva.importe, 1400);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: inicio.slice(0, 10) + "T08:00" } });
+    const cancelar = await api.pedir("POST", "/api/reservas/" + r.cuerpo.reserva.id + "/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(cancelar.cuerpo.reserva.penalizacion, 1400);
+  }
+});
+
+test("CLUB10: tres usos históricos, las cancelaciones liberan uso", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const ids: string[] = [];
+  for (let dia = 1; dia <= 3; dia++) {
+    const r = await crear(api, "2026-12-0" + dia + "T09:00", "CLUB10");
+    assert.equal(r.status, 201);
+    ids.push(r.cuerpo.reserva.id);
+  }
+  // Se pasan las reservas sin cancelarlas: ya no bloquea el límite de futuras.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-03T12:00" } });
+  const cuarta = await crear(api, "2026-12-04T09:00", "CLUB10");
+  assert.equal(cuarta.status, 409);
+  assert.equal(cuarta.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:00" } });
+  await api.pedir("POST", "/api/reservas/" + ids[0] + "/cancelar");
+  assert.equal((await crear(api, "2026-12-04T09:00", "CLUB10")).status, 201);
+});
+
+test("códigos: formato, un único código y reglas de reserva prioritarias, sin consumir usos", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const codigo of [null, 10, true, ["CLUB10", "MANANAS"], { codigo: "CLUB10" }, "", "OTRO", "CLUB10 MANANAS"]) {
+    const r = await crear(api, "2026-12-01T09:00", codigo);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, typeof codigo === "string" ? "CODIGO_INVALIDO" : "DATOS_INVALIDOS");
+  }
+  for (const [inicio, socio, pista, error] of [
+    ["2026-12-01T09:00", "socio-011", "pista-1", "CUOTA_INACTIVA"],
+    ["2026-12-01T09:00", "socio-041", "pista-4", "PISTA_CERRADA"],
+    ["2026-12-01T09:15", "socio-041", "pista-1", "FRANJA_INVALIDA"],
+    ["2026-11-18T09:00", "socio-041", "pista-1", "FRANJA_PASADA"],
+    ["2026-11-19T19:30", "socio-041", "pista-1", "FRANJA_NO_DISPONIBLE"],
+  ]) {
+    assert.equal((await crear(api, inicio!, "OTRO", socio!, pista!)).cuerpo.error.codigo, error);
+  }
+  assert.equal((await crear(api, "2026-12-01T09:00", "BIENVENIDA")).status, 201);
+  await crear(api, "2026-12-02T09:00");
+  await crear(api, "2026-12-03T09:00");
+  assert.equal((await crear(api, "2026-12-04T09:00", "OTRO")).cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+});
+
+test("condiciones con estados no presentados, redondeo y suelo del descuento", () => {
+  const estado = crearSemilla();
+  const club = crearClub(estado);
+  const primera = club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T09:00", codigo: "CLUB10" }).reserva;
+  primera.estado = "no_presentada";
+  assert.throws(() => club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-02T09:00", codigo: "BIENVENIDA" }), { codigo: "CODIGO_NO_APLICABLE" });
+  club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-02T09:00", codigo: "CLUB10" });
+  club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-03T09:00", codigo: "CLUB10" });
+  assert.throws(() => club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-04T09:00", codigo: "CLUB10" }), { codigo: "CODIGO_NO_APLICABLE" });
+  estado.pistas[0]!.precioValle = 101;
+  const barata = club.crearReserva({ socioId: "socio-002", pistaId: "pista-1", inicio: "2026-12-04T09:00", codigo: "MANANAS" }).reserva;
+  assert.equal(barata.importe, 0);
+  assert.equal(barata.descuento, 101);
+  estado.pistas[0]!.precioValle = 105;
+  const redondeada = club.crearReserva({ socioId: "socio-002", pistaId: "pista-1", inicio: "2026-12-07T09:00", codigo: "CLUB10" }).reserva;
+  assert.equal(redondeada.descuento, 11);
+  assert.equal(redondeada.importe, 94);
+});
