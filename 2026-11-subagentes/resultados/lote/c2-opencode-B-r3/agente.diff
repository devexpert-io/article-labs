+    // Fin de semana (sábado 28).
+    const finde = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-28T09:00", codigo: "MANANAS" },
+    });
+    assert.equal(finde.status, 409);
+    assert.equal(finde.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
