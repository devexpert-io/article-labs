+    for (const malo of [42, null, {}, [], true]) {
+      const invalido = await api.pedir("POST", "/api/reservas", {
+        cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-27T09:00", codigo: malo },
