+// Códigos de descuento al reservar, probados a través de la API.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(fn: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("1. sin código, la reserva es como antes", async () => {
+  await conApi(async (api) => {
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-25T09:00" },
+    });
+    assert.equal(creada.status, 201);
+    assert.equal(creada.cuerpo.reserva.importeBase, 1200);
+    assert.equal(creada.cuerpo.reserva.descuento, 0);
+    assert.equal(creada.cuerpo.reserva.importe, 1200);
+    assert.equal("codigo" in creada.cuerpo.reserva, false);
+
+    const una = await api.pedir("GET", `/api/reservas/${creada.cuerpo.reserva.id}`);
+    assert.equal(una.cuerpo.reserva.importeBase, 1200);
+    assert.equal(una.cuerpo.reserva.descuento, 0);
+    assert.equal("codigo" in una.cuerpo.reserva, false);
+  });
+});
+
+test("2. BIENVENIDA descuenta el 50 % solo en la primera reserva y antes de 2027", async () => {
+  await conApi(async (api) => {
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-25T09:00", codigo: " bienvenida " },
+    });
+    assert.equal(creada.status, 201);
+    assert.equal(creada.cuerpo.reserva.codigo, "BIENVENIDA");
+    assert.equal(creada.cuerpo.reserva.importeBase, 1200);
+    assert.equal(creada.cuerpo.reserva.descuento, 600);
+    assert.equal(creada.cuerpo.reserva.importe, 600);
+
+    // socio-004 (Irene Sanz) ya tiene una reserva previa en la semilla.
+    const conPrevias = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-004", pistaId: "pista-3", inicio: "2026-11-25T10:30", codigo: "BIENVENIDA" },
+    });
+    assert.equal(conPrevias.status, 409);
+    assert.equal(conPrevias.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  });
+
+  // Caducado: después del 31 de diciembre de 2026.
+  await conApi(async (api) => {
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-02T10:00" } });
+    const caducada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2027-01-03T09:00", codigo: "BIENVENIDA" },
+    });
+    assert.equal(caducada.status, 409);
+    assert.equal(caducada.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  });
+});
+
+test("3. MANANAS descuenta 4,00 € solo de lunes a viernes antes de las 12:00", async () => {
+  await conApi(async (api) => {
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-25T10:30", codigo: "MANANAS" },
+    });
+    assert.equal(creada.status, 201);
