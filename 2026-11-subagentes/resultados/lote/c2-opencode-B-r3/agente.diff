+  });
+});
+
+test("7. GET /api/reservas/:id y GET /api/reservas devuelven los importes y el código", async () => {
+  await conApi(async (api) => {
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-25T09:00", codigo: "BIENVENIDA" },
+    });
+    const id = creada.cuerpo.reserva.id;
+
+    const una = await api.pedir("GET", `/api/reservas/${id}`);
