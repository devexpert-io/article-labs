+// La lista de espera de franjas, probada a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+async function reservar(socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, `reservar ${socioId} ${pistaId} ${inicio}: ${JSON.stringify(r.cuerpo)}`);
+  return r.cuerpo.reserva;
+}
+
+async function futurasConfirmadas(socioId: string): Promise<number> {
+  const r = await api.pedir("GET", `/api/reservas?socio=${socioId}&estado=confirmada&desde=2026-11-18`);
+  return r.cuerpo.reservas.filter((x: any) => x.inicio > "2026-11-18T10:00").length;
+}
+
+async function socioConHueco(excluir: string[] = []): Promise<string> {
+  const estado = await api.pedir("GET", "/_estado");
+  const contar = (socioId: string) =>
+    estado.cuerpo.reservas.filter((r: any) => r.socioId === socioId && r.estado === "confirmada" && r.inicio > estado.cuerpo.ahora).length;
+  const socio = estado.cuerpo.socios.find(
+    (s: any) => s.rol === "socio" && s.cuotaActiva && !excluir.includes(s.id) && contar(s.id) < 3,
+  );
+  assert.ok(socio, "debe existir un socio con hueco para reservar");
+  return socio.id;
+}
+
+test("apuntarse responde 201 con la espera activa y su posición; sin X-Socio, 401", async () => {
+  await reservar("socio-006", "pista-1", "2026-11-25T12:00");
+  const r = await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-1", inicio: "2026-11-25T12:00" }, socio: "socio-041" });
+  assert.equal(r.status, 201);
+  assert.ok(r.cuerpo.espera.id);
+  assert.equal(r.cuerpo.espera.estado, "activa");
+  assert.equal(r.cuerpo.espera.socioId, "socio-041");
+  assert.equal(r.cuerpo.espera.pistaId, "pista-1");
+  assert.equal(r.cuerpo.espera.inicio, "2026-11-25T12:00");
+  assert.equal(r.cuerpo.espera.posicion, 1);
+
+  const sin = await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-1", inicio: "2026-11-25T12:00" } });
+  assert.equal(sin.status, 401);
+  assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+});
