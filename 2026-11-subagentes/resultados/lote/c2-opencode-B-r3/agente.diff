+    // Entre semana, pero a las 12:00 o más tarde.
+    const tarde = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-25T12:00", codigo: "MANANAS" },
+    });
+    assert.equal(tarde.status, 409);
+    assert.equal(tarde.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
