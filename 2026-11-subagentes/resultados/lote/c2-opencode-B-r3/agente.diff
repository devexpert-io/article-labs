+    assert.equal(una.cuerpo.reserva.importe, 600);
+    assert.equal(una.cuerpo.reserva.codigo, "BIENVENIDA");
+
+    const lista = await api.pedir("GET", `/api/reservas?socio=socio-041`);
+    const encontrada = lista.cuerpo.reservas.find((r: { id: string }) => r.id === id);
+    assert.equal(encontrada.importeBase, 1200);
