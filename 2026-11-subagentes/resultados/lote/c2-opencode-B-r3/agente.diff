+    assert.equal(encontrada.importe, 600);
+    assert.equal(encontrada.codigo, "BIENVENIDA");
+  });
+});
+
+test("8. las reglas del club se validan antes que el código", async () => {
+  await conApi(async (api) => {
+    // Ocupamos una franja con otro socio.
+    const ocupante = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-004", pistaId: "pista-1", inicio: "2026-11-25T09:00" },
