@@ -0,0 +1,199 @@
+// Exportación de reservas a CSV, probada a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-001";
+
+function escapar(valor: string): string {
+  return /[",\r\n]/.test(valor) ? `"${valor.replaceAll('"', '""')}"` : valor;
+}
+
+function csvEsperado(estado: any, desde: string, hasta: string, filtroEstado?: string): string {
+  const pistas = new Map<string, any>(estado.pistas.map((p: any) => [p.id, p]));
+  const socios = new Map<string, any>(estado.socios.map((s: any) => [s.id, s]));
+  const filas = estado.reservas
+    .filter((r: any) => r.inicio.slice(0, 10) >= desde && r.inicio.slice(0, 10) <= hasta && (!filtroEstado || r.estado === filtroEstado))
+    .sort((a: any, b: any) => (a.inicio === b.inicio ? a.pistaId.localeCompare(b.pistaId) : a.inicio.localeCompare(b.inicio)));
+  const lineas = ["id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas"];
+  for (const r of filas) {
+    const p = pistas.get(r.pistaId);
+    const s = socios.get(r.socioId);
+    lineas.push([
+      r.id,
+      r.inicio.slice(0, 10),
+      r.inicio.slice(11, 16),
+      p.nombre,
+      s.nombre,
+      s.email,
+      r.estado,
+      (r.importe / 100).toFixed(2),
+      r.penalizacion === undefined ? "" : (r.penalizacion / 100).toFixed(2),
+      r.notas,
+    ].map(escapar).join(","));
+  }
+  return lineas.join("\r\n") + "\r\n";
+}
+
+function filasCsv(texto: string): string[] {
+  const lineas = texto.split("\r\n");
+  assert.equal(lineas[lineas.length - 1], "", "el CSV debe terminar en CRLF");
+  return lineas.slice(0, -1);
+}
+
+const CABECERA_CSV = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+
+test("permisos: solo un gestor puede exportar", async () => {
+  const ruta = "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19";
+
+  const anonimo = await api.pedir("GET", ruta);
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const noGestor = await api.pedir("GET", ruta, { socio: SOCIO });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const gestor = await api.pedir("GET", ruta, { socio: GESTOR });
+  assert.equal(gestor.status, 200);
+});
+
+test("responde 200 con content-type y content-disposition del periodo", async () => {
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-20", { socio: GESTOR });
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-11-19-2026-11-20.csv"');
+});
+
+test("la primera línea es la cabecera exacta y las filas salen completas y ordenadas", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19", { socio: GESTOR });
+  assert.equal(r.status, 200);
+  const lineas = filasCsv(r.texto);
+  assert.equal(lineas[0], CABECERA_CSV);
+  const esperado = csvEsperado(estado, "2026-11-19", "2026-11-19");
+  assert.equal(r.texto, esperado);
+  // El periodo elegido tiene varias reservas, algunas en la misma franja.
+  assert.ok(lineas.length > 2, "debe haber varias reservas en el periodo");
+});
+
+test("importe y penalizacion van en euros con punto; sin penalizacion el campo va vacio", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19", { socio: GESTOR });
+  const lineas = filasCsv(r.texto);
+  const porId = new Map<string, string[]>();
+  for (const linea of lineas.slice(1)) {
+    const campos = linea.split(",");
+    porId.set(campos[0]!, campos);
+  }
+  // Cada reserva del periodo: importe en euros y penalizacion vacia (la semilla no tiene penalizaciones).
+  const delPeriodo = estado.reservas.filter((x: any) => x.inicio.slice(0, 10) === "2026-11-19");
+  assert.ok(delPeriodo.length > 0);
+  for (const reserva of delPeriodo) {
+    const campos = porId.get(reserva.id)!;
+    assert.ok(campos, `falta la reserva ${reserva.id}`);
+    assert.equal(campos[7], (reserva.importe / 100).toFixed(2));
+    assert.equal(campos[8], "");
+  }
+});
+
+test("una penalizacion presente se exporta en euros", async () => {
+  const otra = await arrancarApi();
+  try {
+    const creada = await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00" } });
+    assert.equal(creada.status, 201);
+    const id = creada.cuerpo.reserva.id;
