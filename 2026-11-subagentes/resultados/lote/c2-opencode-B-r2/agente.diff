@@ -0,0 +1,204 @@
+// Exportación de reservas a CSV, probada a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const GESTOR = "socio-040";
+
+function parsearCsv(texto: string): string[][] {
+  const filas: string[][] = [];
+  let fila: string[] = [];
+  let campo = "";
+  let i = 0;
+  let enComillas = false;
+  while (i < texto.length) {
+    const c = texto[i]!;
+    if (enComillas) {
+      if (c === '"') {
+        if (texto[i + 1] === '"') {
+          campo += '"';
+          i += 2;
+        } else {
+          enComillas = false;
+          i += 1;
+        }
+      } else {
+        campo += c;
+        i += 1;
+      }
+      continue;
+    }
+    if (c === '"') {
+      enComillas = true;
+      i += 1;
+    } else if (c === ",") {
+      fila.push(campo);
+      campo = "";
+      i += 1;
+    } else if (c === "\r") {
+      i += 1;
+    } else if (c === "\n") {
+      fila.push(campo);
+      filas.push(fila);
+      fila = [];
+      campo = "";
+      i += 1;
+    } else {
+      campo += c;
+      i += 1;
+    }
+  }
+  if (campo !== "" || fila.length > 0) {
+    fila.push(campo);
+    filas.push(fila);
+  }
+  return filas;
+}
+
+const exportar = (desde: string, hasta: string, estado?: string, socio?: string) =>
+  api.pedir("GET", `/api/reservas/exportar?desde=${desde}&hasta=${hasta}${estado ? `&estado=${estado}` : ""}`, { socio });
+
+test("solo los gestores pueden exportar", async () => {
+  const sinCabecera = await exportar("2026-11-01", "2026-11-30");
+  assert.equal(sinCabecera.status, 401);
+  assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const noGestor = await exportar("2026-11-01", "2026-11-30", undefined, "socio-001");
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const gestor = await exportar("2026-11-01", "2026-11-30", undefined, GESTOR);
+  assert.equal(gestor.status, 200);
+});
+
+test("responde 200 con las cabeceras CSV y el nombre del fichero con las fechas", async () => {
+  const r = await exportar("2026-11-01", "2026-11-30", undefined, GESTOR);
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-11-01-2026-11-30.csv"');
+});
+
+test("la primera línea es la cabecera exacta y todas las líneas terminan en CRLF", async () => {
+  const r = await exportar("2026-11-19", "2026-11-19", undefined, GESTOR);
+  assert.ok(r.texto.startsWith("id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas\r\n"));
+  assert.ok(r.texto.endsWith("\r\n"), "la última línea también termina en CRLF");
+});
+
+test("hay una fila por reserva del periodo, ordenada por inicio y pista", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const r = await exportar("2026-11-19", "2026-11-19", undefined, GESTOR);
+  const filas = parsearCsv(r.texto);
+  const cabecera = filas[0]!;
+  assert.deepEqual(cabecera, ["id", "fecha", "hora", "pista", "socio", "email", "estado", "importe", "penalizacion", "notas"]);
+
+  const esperadas = estado.reservas.filter((x: { inicio: string }) => x.inicio.slice(0, 10) === "2026-11-19");
+  assert.equal(filas.length - 1, esperadas.length, "una fila por reserva del día");
+
+  const datos = filas.slice(1);
+  const ordenadas = [...datos].sort((a, b) => {
+    const ka = a[1]! + a[2]!;
+    const kb = b[1]! + b[2]!;
+    if (ka !== kb) return ka < kb ? -1 : 1;
+    return a[3]!.localeCompare(b[3]!);
+  });
+  assert.deepEqual(datos, ordenadas, "ordenadas por inicio y, en empate, por pista");
+});
+
+test("los importes van en euros con dos decimales y la penalización vacía si no la hay", async () => {
+  const r = await exportar("2026-11-19", "2026-11-19", undefined, GESTOR);
+  const filas = parsearCsv(r.texto).slice(1);
+  // Marta López juega el jueves 19 a las 09:00 en la Pista 3 (valle): 1200 céntimos -> 12.00.
+  const marta = filas.find((f) => f[1] === "2026-11-19" && f[2] === "09:00" && f[3] === "Pista 3")!;
+  assert.ok(marta, "existe la reserva de Marta López");
+  assert.equal(marta[4], "Marta López");
+  assert.equal(marta[5], "marta.lopez@example.com");
+  assert.equal(marta[7], "12.00");
+  assert.equal(marta[8], "");
+});
+
+test("una reserva cancelada con penalización muestra la penalización con dos decimales", async () => {
+  // Busca una franja libre de hoy (posterior a la hora del club) para crear y cancelar con penalización.
+  const disp = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-18");
+  let libre: { pistaId: string; inicio: string } | undefined;
+  for (const p of disp.cuerpo.pistas) {
+    const f = p.franjas.find((x: { estado: string; inicio: string }) => x.estado === "libre" && x.inicio > "2026-11-18T10:00");
+    if (f) {
+      libre = { pistaId: p.pistaId, inicio: f.inicio };
+      break;
+    }
+  }
+  assert.ok(libre, "hay una franja libre hoy para la prueba");
+
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: libre.pistaId, inicio: libre.inicio } });
+  assert.equal(creada.status, 201);
+  const id = creada.cuerpo.reserva.id;
+  const cancelada = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  const penalizacion = cancelada.cuerpo.reserva.penalizacion;
+  assert.ok(typeof penalizacion === "number");
+
+  const r = await exportar("2026-11-18", "2026-11-18", undefined, GESTOR);
+  const fila = parsearCsv(r.texto).slice(1).find((f) => f[0] === id)!;
+  assert.ok(fila, "la reserva cancelada aparece en el CSV");
+  assert.equal(fila[6], "cancelada");
+  assert.equal(fila[8], (penalizacion / 100).toFixed(2));
+});
+
+test("escapa comas, comillas y saltos de línea según RFC 4180", async () => {
+  const notas = 'Nota con coma, "comillas" y\nsalto de línea';
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-25T12:00", notas } });
+  assert.equal(creada.status, 201);
+
+  const r = await exportar("2026-11-25", "2026-11-25", undefined, GESTOR);
+  const esperado = '"Nota con coma, ""comillas"" y\nsalto de línea"';
+  assert.ok(r.texto.includes(esperado), "la nota va entre comillas, con las comillas internas duplicadas y el salto dentro");
+});
+
+test("valida el periodo", async () => {
+  for (const ruta of [
+    "/api/reservas/exportar", // faltan ambos
+    "/api/reservas/exportar?desde=2026-11-01", // falta hasta
+    "/api/reservas/exportar?desde=2026-11-01&hasta=31/12/2026", // formato malo
