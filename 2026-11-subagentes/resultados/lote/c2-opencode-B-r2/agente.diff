+
+/** Arranca una API fresca para el test, la cierra al terminar y devuelve su instancia. */
+async function conApi(fn: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+// Nora Benítez: sin reservas y con la cuota al día. Ideal para los códigos.
+const NUEVA = "socio-041";
