+  }
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.ok(estado.reservas.every((r: any) => r.duracion === 90));
+});
+
+test("precios por minutos, cruce de las 18:00, redondeo y fin de semana", async (t) => {
+  const api = await preparar(t);
+  for (const [inicio, duracion, pista, importe] of [
+    ["2026-11-25T12:00", 60, "pista-1", 1200],
+    ["2026-11-25T12:00", 120, "pista-1", 2400],
+    ["2026-11-25T18:00", 60, "pista-1", 1867],
+    ["2026-11-25T17:30", 90, "pista-1", 2467],
+    ["2026-11-25T17:30", 60, "pista-1", 1533],
+    ["2026-11-25T17:00", 120, "pista-3", 2133],
+    ["2026-11-28T09:00", 60, "pista-1", 1867],
+    ["2026-11-29T12:00", 120, "pista-3", 2667],
