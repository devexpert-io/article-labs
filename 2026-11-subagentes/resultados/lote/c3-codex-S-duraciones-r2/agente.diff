@@ -0,0 +1,195 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function preparar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+function reservar(api: Api, inicio: string, duracion?: unknown, pistaId = "pista-1", socioId = "socio-041") {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio, duracion } });
+}
+
+async function cancelar(api: Api, id: string) {
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(r.status, 200);
+  return r.cuerpo.reserva;
+}
+
+async function disponibilidad(api: Api, fecha = "2026-11-25", pista = "pista-1") {
+  const r = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pista}`);
+  assert.equal(r.status, 200);
+  return r.cuerpo.pistas[0];
+}
+
+test("duraciones válidas, valor por defecto, fin y rechazo de otros valores", async (t) => {
+  const api = await preparar(t);
+  for (const duracion of [undefined, 60, 90, 120]) {
+    const r = await reservar(api, "2026-11-25T10:00", duracion);
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.duracion, duracion ?? 90);
+    assert.equal(r.cuerpo.reserva.fin, `2026-11-25T${duracion === 60 ? "11:00" : duracion === 120 ? "12:00" : "11:30"}`);
+    await cancelar(api, r.cuerpo.reserva.id);
+  }
+  for (const duracion of [0, -60, 30, 61, 90.5, 180, "60", null, true, {}, []]) {
+    const r = await reservar(api, "2026-11-25T10:00", duracion);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA");
+  }
+});
+
+test("inicios en punto o y media y límites de apertura y cierre", async (t) => {
+  const api = await preparar(t);
+  for (const [hora, duracion] of [["09:00", 60], ["10:00", 90], ["10:30", 120], ["21:30", 60], ["21:00", 90], ["20:30", 120]] as const) {
+    const r = await reservar(api, `2026-11-25T${hora}`, duracion);
+    assert.equal(r.status, 201);
+    await cancelar(api, r.cuerpo.reserva.id);
+  }
+  for (const inicio of ["2026-11-25T08:30", "2026-11-25T10:15", "2026-11-25T10:60", "2026-11-25T22:00", "2026-11-25T24:00", "2026-11-25T99:00", "10:00"]) {
+    const r = await reservar(api, inicio, 60);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  }
+  for (const [hora, duracion] of [["21:30", 90], ["21:00", 120]] as const) {
+    assert.equal((await reservar(api, `2026-11-25T${hora}`, duracion)).cuerpo.error.codigo, "FRANJA_INVALIDA");
+  }
+});
+
+test("solapes parciales, contención, adyacencia y reservas canceladas", async (t) => {
+  const api = await preparar(t);
+  const primera = await reservar(api, "2026-11-25T10:30", 60);
+  assert.equal(primera.status, 201);
+  for (const [hora, duracion] of [["10:00", 60], ["11:00", 60], ["10:00", 120], ["10:30", 60]] as const) {
+    const r = await reservar(api, `2026-11-25T${hora}`, duracion);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  }
+  const otraPista = await reservar(api, "2026-11-25T10:30", 60, "pista-2");
+  assert.equal(otraPista.status, 201);
+  await cancelar(api, otraPista.cuerpo.reserva.id);
+  assert.equal((await reservar(api, "2026-11-25T09:00", 90)).status, 201);
+  assert.equal((await reservar(api, "2026-11-25T11:30", 60)).status, 201);
+  await cancelar(api, primera.cuerpo.reserva.id);
+  assert.equal((await reservar(api, "2026-11-25T10:30", 60)).status, 201);
+});
+
+test("reservas antiguas conservan sus datos, devuelven duración y bloquean solapes", async (t) => {
+  const api = await preparar(t);
+  const lista = await api.pedir("GET", "/api/reservas?fecha=2026-11-19&pista=pista-1");
