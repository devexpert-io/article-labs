+
+test("todas las franjas tradicionales de 90 minutos conservan el precio", async (t) => {
+  const api = await preparar(t);
+  const pistas = (await api.pedir("GET", "/api/pistas")).cuerpo.pistas;
+  for (const fecha of ["2026-11-25", "2026-11-28", "2026-11-29"]) {
+    for (const p of pistas.filter((p: any) => p.estado === "operativa")) {
