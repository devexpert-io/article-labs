+test("cancelación gratis a las 24 horas y penalización completa después para cada duración", async (t) => {
+  const api = await preparar(t);
+  for (const duracion of [60, 90, 120]) {
+    const creada = await reservar(api, "2026-11-25T17:30", duracion);
+    assert.equal(creada.status, 201);
+    const r = creada.cuerpo.reserva;
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-24T17:30" } });
+    const gratis = await cancelar(api, r.id);
+    assert.equal(gratis.penalizacion, undefined);
+    assert.equal(gratis.duracion, duracion);
+    const otra = await reservar(api, r.inicio, duracion);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-24T17:31" } });
+    const fuera = await api.pedir("POST", `/api/reservas/${otra.cuerpo.reserva.id}/cancelar`);
+    assert.equal(fuera.status, 409);
+    assert.equal(fuera.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${otra.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, r.importe);
+    assert.equal(forzada.cuerpo.reserva.duracion, duracion);
+  }
