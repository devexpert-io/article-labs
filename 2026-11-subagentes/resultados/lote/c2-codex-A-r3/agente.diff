+test("asignación descarta cuota inactiva y pista cerrada sin perder la cancelación", () => {
+  for (const cerrar of [false, true]) {
+    const estado = crearSemilla();
+    const club = crearClub(estado);
+    const reserva = club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio }).reserva;
+    club.crearEspera(estado.socios.find((s) => s.id === "socio-004")!, { pistaId: "pista-1", inicio });
+    club.crearEspera(estado.socios.find((s) => s.id === "socio-002")!, { pistaId: "pista-1", inicio });
+    if (cerrar) club.cambiarEstadoPista("pista-1", "cerrada");
+    else estado.socios.find((s) => s.id === "socio-004")!.cuotaActiva = false;
+    const resultado = club.cancelarReserva(reserva.id, {});
+    assert.equal(resultado.reserva.estado, "cancelada");
