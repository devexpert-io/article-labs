+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+const inicio = "2026-11-25T09:00";
+const reservar = (api: Api, hora = inicio, socioId = "socio-041", codigo?: string) =>
+  api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-1", inicio: hora, codigo } });
+const esperar = (api: Api, socio = "socio-004", hora = inicio, pistaId = "pista-1") =>
+  api.pedir("POST", "/api/esperas", { socio, cuerpo: { pistaId, inicio: hora } });
+
+test("esperas: identidad, validaciones, duplicados y límite", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const [metodo, ruta] of [["GET", "/api/esperas"], ["POST", "/api/esperas"], ["DELETE", "/api/esperas/E-0001"]]) {
+    const r = await api.pedir(metodo!, ruta!);
+    assert.equal(r.status, 401);
+    assert.equal(r.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  }
+  for (const [socio, hora, pista, status, codigo] of [
+    ["socio-004", inicio, "pista-1", 409, "FRANJA_LIBRE"],
+    ["socio-004", inicio, "no-existe", 404, "PISTA_NO_ENCONTRADA"],
+    ["socio-004", inicio, "pista-4", 409, "PISTA_CERRADA"],
+    ["socio-004", "2026-11-25T09:15", "pista-1", 400, "FRANJA_INVALIDA"],
+    ["socio-004", "2026-11-18T09:00", "pista-1", 409, "FRANJA_PASADA"],
+    ["socio-011", inicio, "pista-1", 409, "CUOTA_INACTIVA"],
+  ] as const) {
+    const r = await esperar(api, socio, hora, pista);
+    assert.equal(r.status, status);
+    assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+  assert.equal((await api.pedir("POST", "/api/esperas", { socio: "socio-004", cuerpo: {} })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const hora of [inicio, "2026-11-25T10:30", "2026-11-25T12:00"]) {
+    assert.equal((await reservar(api, hora)).status, 201);
+  }
+  assert.equal((await esperar(api, "socio-041")).cuerpo.error.codigo, "YA_RESERVADA");
+  const primera = await esperar(api);
+  assert.equal(primera.status, 201);
+  assert.equal(primera.cuerpo.espera.estado, "activa");
+  assert.equal(primera.cuerpo.espera.posicion, 1);
+  assert.equal((await esperar(api)).cuerpo.error.codigo, "YA_EN_ESPERA");
+  assert.equal((await esperar(api, "socio-004", "2026-11-25T10:30")).status, 201);
+  assert.equal((await esperar(api, "socio-004", "2026-11-25T12:00")).cuerpo.error.codigo, "LIMITE_DE_ESPERAS");
+});
+
+test("esperas: posiciones, consultas y retirada por dueño o gestor", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  await reservar(api);
+  const a = (await esperar(api)).cuerpo.espera;
+  const b = (await esperar(api, "socio-002")).cuerpo.espera;
+  assert.equal(b.posicion, 2);
+  const listar = (socio: string, query = "") => api.pedir("GET", "/api/esperas" + query, { socio });
+  assert.deepEqual((await listar("socio-004")).cuerpo.esperas, [a]);
+  assert.deepEqual((await listar("socio-040", "?socio=socio-002")).cuerpo.esperas, [b]);
+  assert.equal((await listar("socio-004", "?socio=socio-002")).status, 403);
+  assert.equal((await api.pedir("DELETE", `/api/esperas/${a.id}`, { socio: "socio-002" })).status, 403);
+  assert.equal((await api.pedir("DELETE", "/api/esperas/no-existe", { socio: "socio-004" })).cuerpo.error.codigo, "ESPERA_NO_ENCONTRADA");
+  const retirada = await api.pedir("DELETE", `/api/esperas/${a.id}`, { socio: "socio-004" });
+  assert.equal(retirada.cuerpo.espera.estado, "retirada");
+  assert.equal("posicion" in retirada.cuerpo.espera, false);
+  assert.equal((await listar("socio-002")).cuerpo.esperas[0].posicion, 1);
+  const porGestor = await api.pedir("DELETE", `/api/esperas/${b.id}`, { socio: "socio-040" });
+  assert.equal(porGestor.cuerpo.espera.estado, "retirada");
+  assert.deepEqual((await listar("socio-002")).cuerpo.esperas, []);
+});
+
+test("esperas: asignación FIFO a precio completo y cancelación con o sin forzar", async (t) => {
+  for (const forzar of [false, true]) {
+    await t.test(String(forzar), async (t) => {
+      const api = await arrancarApi();
+      t.after(() => api.cerrar());
+      const original = (await reservar(api, inicio, "socio-041", "BIENVENIDA")).cuerpo.reserva;
+      const a = (await esperar(api)).cuerpo.espera;
+      await esperar(api, "socio-002");
+      if (forzar) {
+        await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T08:00" } });
+        const rechazada = await api.pedir("POST", `/api/reservas/${original.id}/cancelar`);
+        assert.equal(rechazada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+        assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-004" })).cuerpo.esperas.length, 1);
+      }
+      const cancelada = await api.pedir("POST", `/api/reservas/${original.id}/cancelar`, { cuerpo: { forzar } });
+      assert.equal(cancelada.status, 200);
+      assert.ok(cancelada.cuerpo.asignadaA);
+      assert.equal(cancelada.cuerpo.reserva.penalizacion, forzar ? 900 : undefined);
+      const nueva = (await api.pedir("GET", `/api/reservas/${cancelada.cuerpo.asignadaA}`)).cuerpo.reserva;
+      assert.equal(nueva.socioId, "socio-004");
+      assert.equal(nueva.estado, "confirmada");
+      assert.equal(nueva.inicio, inicio);
+      assert.equal(nueva.importe, 1800);
+      assert.equal(nueva.importeBase, 1800);
+      assert.equal(nueva.descuento, 0);
+      assert.equal(nueva.codigo, undefined);
+      assert.equal(nueva.notas, "Asignada desde la lista de espera");
+      const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+      assert.equal(estado.esperas.find((e: any) => e.id === a.id).estado, "asignada");
+      assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-002" })).cuerpo.esperas[0].posicion, 1);
+    });
+  }
