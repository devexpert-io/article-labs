+++ b/test/codigos-descuento.test.ts
@@ -0,0 +1,93 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const crear = (api: Api, inicio: string, codigo?: unknown, socioId = "socio-041", pistaId = "pista-1") =>
+  api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio, codigo } });
+const cancelar = (api: Api, id: string) => api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { forzar: true } });
+
+test("descuentos: sin código, formatos, prioridad de reglas e importes consultables", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const [codigo, error] of [[null, "DATOS_INVALIDOS"], [12, "DATOS_INVALIDOS"], [["CLUB10"], "DATOS_INVALIDOS"], ["", "CODIGO_INVALIDO"], ["otro", "CODIGO_INVALIDO"], ["CLUB10 MANANAS", "CODIGO_INVALIDO"]] as const) {
+    const r = await crear(api, "2026-11-25T09:00", codigo);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, error);
+  }
+  for (const [inicio, socio, pista, error] of [
+    ["2026-11-25T09:00", "socio-011", "pista-1", "CUOTA_INACTIVA"],
+    ["2026-11-25T09:00", "socio-041", "pista-4", "PISTA_CERRADA"],
+    ["2026-11-25T09:15", "socio-041", "pista-1", "FRANJA_INVALIDA"],
+    ["2026-11-18T09:00", "socio-041", "pista-1", "FRANJA_PASADA"],
+    ["2026-11-19T19:30", "socio-041", "pista-1", "FRANJA_NO_DISPONIBLE"],
+  ]) {
+    assert.equal((await crear(api, inicio!, "invalido", socio, pista)).cuerpo.error.codigo, error);
+  }
+  const r = (await crear(api, "2026-11-25T09:00")).cuerpo.reserva;
+  assert.equal(r.importeBase, 1800);
+  assert.equal(r.descuento, 0);
+  assert.equal(r.importe, 1800);
+  assert.equal("codigo" in r, false);
+  const conCodigo = (await crear(api, "2026-11-25T10:30", "  club10 ")).cuerpo.reserva;
+  assert.equal(conCodigo.codigo, "CLUB10");
+  assert.equal(conCodigo.descuento, 180);
+  assert.equal(conCodigo.importe, 1620);
+  assert.deepEqual((await api.pedir("GET", `/api/reservas/${conCodigo.id}`)).cuerpo.reserva, conCodigo);
+  assert.deepEqual((await api.pedir("GET", "/api/reservas?fecha=2026-11-25")).cuerpo.reservas.find((r: any) => r.id === conCodigo.id), conCodigo);
+  await crear(api, "2026-11-25T12:00");
+  assert.equal((await crear(api, "2026-11-25T13:30", 123)).cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+});
+
+test("BIENVENIDA: primera reserva, historial cancelado y fecha de solicitud", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  assert.equal((await crear(api, "2026-11-25T09:00", "BIENVENIDA", "socio-002")).cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-31T23:59" } });
+  const primera = await crear(api, "2027-01-04T09:00", " bienvenida ");
+  assert.equal(primera.status, 201);
+  assert.equal(primera.cuerpo.reserva.importe, 900);
+  assert.equal(primera.cuerpo.reserva.descuento, 900);
+  await cancelar(api, primera.cuerpo.reserva.id);
+  assert.equal((await crear(api, "2027-01-04T10:30", "BIENVENIDA")).cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  const otra = await arrancarApi({ AHORA: "2027-01-01T00:00" });
+  t.after(() => otra.cerrar());
+  assert.equal((await crear(otra, "2027-01-04T09:00", "BIENVENIDA")).cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("MANANAS: días, frontera de mediodía, disponibilidad y penalización", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const inicio of ["2026-11-28T09:00", "2026-11-29T10:30", "2026-11-25T12:00", "2026-11-25T18:00"]) {
+    assert.equal((await crear(api, inicio, "MANANAS")).cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }
+  for (const inicio of ["2026-11-25T09:00", "2026-11-26T10:30", "2026-11-27T09:00", "2026-11-30T09:00", "2026-12-01T09:00"]) {
+    const r = await crear(api, inicio, "MANANAS");
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.importe, 1400);
+    assert.equal(r.cuerpo.reserva.descuento, 400);
+    if (inicio === "2026-11-25T09:00") {
+      const disp = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-25&pista=pista-1")).cuerpo;
+      assert.equal(disp.pistas[0].franjas[0].precio, 1800);
+      await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-24T12:00" } });
+      assert.equal((await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`)).cuerpo.error.codigo, "FUERA_DE_PLAZO");
+      assert.equal((await cancelar(api, r.cuerpo.reserva.id)).cuerpo.reserva.penalizacion, 1400);
+    } else await cancelar(api, r.cuerpo.reserva.id);
+  }
+});
+
+test("CLUB10: tres usos históricos, cancelaciones liberan uso y confirmadas pasadas cuentan", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const ids: string[] = [];
+  for (const dia of ["25", "26", "27"]) {
+    const r = await crear(api, `2026-11-${dia}T09:00`, "CLUB10");
+    assert.equal(r.status, 201);
+    ids.push(r.cuerpo.reserva.id);
+  }
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T10:00" } });
+  assert.equal((await crear(api, "2026-11-28T09:00", "CLUB10")).cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  await cancelar(api, ids[1]!);
+  const nueva = await crear(api, "2026-11-28T09:00", "CLUB10");
+  assert.equal(nueva.status, 201);
+  assert.equal(nueva.cuerpo.reserva.importe, 2520);
+});
