+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi } from "./ayuda.ts";
+
+const cabecera = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas\r\n";
+test("CSV: permisos, validación de periodo y filtro", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const ruta = "/api/reservas/exportar";
+  for (const [socio, status, codigo] of [[undefined, 401, "NO_IDENTIFICADO"], ["socio-002", 403, "SIN_PERMISO"]] as const) {
+    const r = await api.pedir("GET", ruta, { socio });
+    assert.equal(r.status, status);
+    assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+  for (const query of ["", "?desde=2026-10-01", "?hasta=2026-10-31", "?desde=x&hasta=2026-10-31",
+    "?desde=2026-02-30&hasta=2026-03-01", "?desde=2026-11-01&hasta=2026-10-01",
+    "?desde=2026-10-01&hasta=2026-10-31&estado=", "?desde=2026-10-01&hasta=2026-10-31&estado=otro"]) {
+    const r = await api.pedir("GET", ruta + query, { socio: "socio-040" });
+    assert.equal(r.status, 400, query);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", query);
+  }
+  const largo = await api.pedir("GET", ruta + "?desde=2026-10-01&hasta=2027-01-01", { socio: "socio-040" });
+  assert.equal(largo.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+  assert.equal((await api.pedir("GET", ruta + "?desde=2026-10-01&hasta=2026-12-31", { socio: "socio-040" })).status, 200);
+  for (const estado of ["confirmada", "cancelada", "no_presentada"]) {
+    const r = await api.pedir("GET", ruta + "?desde=2026-10-01&hasta=2026-10-31&estado=" + estado, { socio: "socio-040" });
+    const esperado = (await api.pedir("GET", "/_estado")).cuerpo.reservas.filter((r: any) => r.inicio.startsWith("2026-10") && r.estado === estado);
+    assert.equal(r.texto.split("\r\n").length - 2, esperado.length);
+    assert.ok(r.texto.split("\r\n").slice(1, -1).every((fila) => fila.split(",")[6] === estado));
+  }
+});
+
+test("CSV: todas las filas, orden, cabeceras, euros, escapado y CRLF; listado intacto", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const antes = (await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=1")).cuerpo;
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-31", { socio: "socio-040" });
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-10-31.csv"');
+  assert.ok(r.texto.startsWith(cabecera));
+  assert.ok(r.texto.endsWith("\r\n"));
+  assert.equal(r.texto.replaceAll("\r\n", "").includes("\n"), false);
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const reservas = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+  assert.equal(reservas.length, 315);
+  const filas = r.texto.split("\r\n").slice(1, -1);
+  assert.deepEqual(filas.map((f) => f.split(",")[0]), reservas.map((r: any) => r.id));
+  const primera = reservas[0];
+  const socio = estado.socios.find((s: any) => s.id === primera.socioId);
+  assert.equal(filas[0], [primera.id, primera.inicio.slice(0, 10), primera.inicio.slice(11),
+    estado.pistas.find((p: any) => p.id === primera.pistaId).nombre, socio.nombre, socio.email,
+    primera.estado, (primera.importe / 100).toFixed(2), "", primera.notas].join(","));
+  assert.deepEqual((await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=1")).cuerpo, antes);
+  const notas = 'Una coma, "comillas"\ny otra línea\rfinal';
+  const nueva = (await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00", notas } })).cuerpo.reserva;
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T08:00" } });
+  await api.pedir("POST", `/api/reservas/${nueva.id}/cancelar`, { cuerpo: { forzar: true } });
+  const escapado = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-25&hasta=2026-11-25", { socio: "socio-040" });
+  assert.equal(escapado.texto, cabecera + `${nueva.id},2026-11-25,09:00,Pista 1,Nora Benítez,nora.benitez@example.com,cancelada,18.00,18.00,"Una coma, ""comillas""\ny otra línea\rfinal"\r\n`);
+  const vacio = await api.pedir("GET", "/api/reservas/exportar?desde=2028-01-01&hasta=2028-01-01", { socio: "socio-040" });
+  assert.equal(vacio.texto, cabecera);
+});
+
+test("CSV ordena reservas añadidas fuera de orden y desempata por pista", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const ids: string[] = [];
+  for (const [pistaId, inicio] of [["pista-1", "2026-11-26T10:30"], ["pista-2", "2026-11-25T09:00"], ["pista-1", "2026-11-25T09:00"]]) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId, inicio } });
+    assert.equal(r.status, 201);
+    ids.push(r.cuerpo.reserva.id);
+  }
+  const csv = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-25&hasta=2026-11-26", { socio: "socio-040" });
+  assert.deepEqual(csv.texto.split("\r\n").slice(1, -1).map((fila) => fila.split(",")[0]), [ids[2], ids[1], ids[0]]);
+});
