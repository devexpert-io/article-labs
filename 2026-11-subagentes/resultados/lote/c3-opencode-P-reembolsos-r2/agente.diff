+    assert.equal(normal.status, 409);
+    assert.equal(normal.cuerpo.error.codigo, "RESERVA_PASADA");
+  });
+});
+
+test("informe de caja: permisos y formato del mes", async () => {
+  await conApi({}, async (api) => {
+    const sinIdentificar = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
