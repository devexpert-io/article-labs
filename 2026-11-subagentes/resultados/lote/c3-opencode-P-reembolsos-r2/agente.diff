+/** Desfase en milisegundos entre UTC y Europe/Madrid en un instante dado. */
+function desfaseEnMadrid(instante: number): number {
+  const partes = new Intl.DateTimeFormat("en-US", { timeZone: ZONA, timeZoneName: "longOffset" })
+    .formatToParts(new Date(instante));
+  const nombre = partes.find((p) => p.type === "timeZoneName")?.value ?? "";
+  const coincidencia = /GMT([+-])(\d{2}):(\d{2})/.exec(nombre);
+  if (!coincidencia) return 0;
+  const signo = coincidencia[1] === "-" ? -1 : 1;
+  return signo * (Number(coincidencia[2]) * 60 + Number(coincidencia[3])) * 60_000;
+}
+
+/** Convierte una hora local del club (AAAA-MM-DDTHH:MM) al instante UTC correspondiente. */
+function aInstanteUTC(local: string): number {
+  const base = Date.parse(`${local}:00Z`);
+  let desfase = desfaseEnMadrid(base);
+  for (let i = 0; i < 3; i++) {
+    const nuevo = desfaseEnMadrid(base - desfase);
+    if (nuevo === desfase) break;
+    desfase = nuevo;
+  }
+  return base - desfase;
+}
+
+/** Horas reales en Madrid entre dos horas locales, contando el cambio de hora. */
 function horasEntre(desde: string, hasta: string): number {
