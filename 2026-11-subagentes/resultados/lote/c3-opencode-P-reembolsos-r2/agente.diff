+// La política de cancelación escalonada, la exención de un gestor y el informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-001";
+
+async function conApi(entorno: Record<string, string>, fn: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi(entorno);
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("tramos de penalización y reembolso", async () => {
+  await conApi({}, async (api) => {
+    // 50 horas de antelación (>= 48): sin penalización.
+    const lejos = await api.pedir("POST", "/api/reservas/R-0490/cancelar");
+    assert.equal(lejos.status, 200);
+    assert.equal(lejos.cuerpo.reserva.estado, "cancelada");
+    assert.equal(lejos.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(lejos.cuerpo.reembolso, 1200);
+
+    // 24,5 horas (>= 24 y < 48): 25 % del importe.
+    const media = await api.pedir("POST", "/api/reservas/R-0524/cancelar");
+    assert.equal(media.cuerpo.reserva.penalizacion, 450);
+    assert.equal(media.cuerpo.reembolso, 1350);
+
+    // Menos de 24 horas: sin forzar no se puede, con forzar es el 50 %.
+    const tarde = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(tarde.status, 409);
+    assert.equal(tarde.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+    assert.equal(forzada.cuerpo.reembolso, 600);
+  });
+});
+
+test("límites exactos: 48 horas justas sin penalización y 24 justas al 25 %", async () => {
+  await conApi({ AHORA: "2026-12-05T10:30" }, async (api) => {
+    const a48 = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIO, pistaId: "pista-1", inicio: "2026-12-07T10:30" } });
+    assert.equal(a48.status, 201);
+    const a24 = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIO, pistaId: "pista-2", inicio: "2026-12-06T10:30" } });
+    assert.equal(a24.status, 201);
+
+    const cancelada48 = await api.pedir("POST", `/api/reservas/${a48.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada48.cuerpo.reembolso, a48.cuerpo.reserva.importe);
+
+    const cancelada24 = await api.pedir("POST", `/api/reservas/${a24.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada24.cuerpo.reserva.penalizacion, Math.round(a24.cuerpo.reserva.importe * 0.25));
+    assert.equal(cancelada24.cuerpo.reembolso, a24.cuerpo.reserva.importe - Math.round(a24.cuerpo.reserva.importe * 0.25));
+  });
+});
+
+test("cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales, no 48,5.
+  await conApi({ AHORA: "2027-03-26T20:30" }, async (api) => {
+    const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIO, pistaId: "pista-1", inicio: "2027-03-28T21:00" } });
+    assert.equal(creada.status, 201);
+    const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, Math.round(creada.cuerpo.reserva.importe * 0.25));
+    assert.equal(cancelada.cuerpo.reembolso, creada.cuerpo.reserva.importe - Math.round(creada.cuerpo.reserva.importe * 0.25));
+  });
+});
+
+test("exención: un gestor exime sin penalización con un motivo válido", async () => {
