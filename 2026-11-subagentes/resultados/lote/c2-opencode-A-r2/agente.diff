+// Códigos de descuento al reservar, probados a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+test("sin código todo sigue igual", async () => {
+  const local = await arrancarApi();
+  try {
+    const r = await local.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-06T09:00" } });
+    assert.equal(r.status, 201);
+    const res = r.cuerpo.reserva;
+    assert.equal(res.importeBase, 1800);
+    assert.equal(res.descuento, 0);
+    assert.equal(res.importe, 1800);
+    assert.equal("codigo" in res, false);
+    const got = await local.pedir("GET", `/api/reservas/${res.id}`);
+    assert.equal(got.cuerpo.reserva.importeBase, res.importeBase);
+    assert.equal(got.cuerpo.reserva.descuento, 0);
+  } finally {
+    local.cerrar();
+  }
+});
+
+test("BIENVENIDA descuenta el 50 % solo en la primera reserva", async () => {
+  const local = await arrancarApi();
+  try {
+    const primera = await local.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-06T09:00", codigo: "BIENVENIDA" },
+    });
+    assert.equal(primera.status, 201);
+    assert.equal(primera.cuerpo.reserva.importeBase, 1800);
+    assert.equal(primera.cuerpo.reserva.descuento, 900);
+    assert.equal(primera.cuerpo.reserva.importe, 900);
+    assert.equal(primera.cuerpo.reserva.codigo, "BIENVENIDA");
+    // Ya tiene una reserva: la segunda BIENVENIDA no aplica.
+    const segunda = await local.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2027-01-06T10:30", codigo: "BIENVENIDA" },
+    });
+    assert.equal(segunda.status, 409);
+    assert.equal(segunda.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  } finally {
+    local.cerrar();
+  }
+});
+
+test("BIENVENIDA caduca a partir de 2027", async () => {
+  const local = await arrancarApi({ AHORA: "2027-01-15T10:00" });
+  try {
+    const r = await local.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-02-01T09:00", codigo: "BIENVENIDA" },
+    });
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  } finally {
+    local.cerrar();
+  }
+});
+
+test("MANANAS descuenta 4 € de lunes a viernes antes de las 12:00", async () => {
+  const local = await arrancarApi();
+  try {
+    // Miércoles 2027-01-06 a las 09:00.
+    const ok = await local.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2027-01-06T09:00", codigo: "MANANAS" },
+    });
+    assert.equal(ok.status, 201);
+    assert.equal(ok.cuerpo.reserva.importeBase, 1200);
+    assert.equal(ok.cuerpo.reserva.descuento, 400);
+    assert.equal(ok.cuerpo.reserva.importe, 800);
+    assert.equal(ok.cuerpo.reserva.codigo, "MANANAS");
+    // Fin de semana no aplica.
+    const sabado = await local.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2027-01-02T09:00", codigo: "MANANAS" },
+    });
+    assert.equal(sabado.status, 409);
+    assert.equal(sabado.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+    // A las 12:00 ya no es antes de las 12:00.
+    const mediodia = await local.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2027-01-06T12:00", codigo: "MANANAS" },
+    });
+    assert.equal(mediodia.status, 409);
+    assert.equal(mediodia.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  } finally {
+    local.cerrar();
+  }
+});
+
+test("CLUB10 descuenta el 10 %, con máximo 3 usos y las canceladas no cuentan", async () => {
+  const local = await arrancarApi();
+  try {
+    const primera = await local.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-06T09:00", codigo: "CLUB10" },
+    });
+    assert.equal(primera.cuerpo.reserva.importeBase, 1800);
+    assert.equal(primera.cuerpo.reserva.descuento, 180);
+    assert.equal(primera.cuerpo.reserva.importe, 1620);
+    const segunda = await local.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2027-01-06T10:30", codigo: "CLUB10" },
+    });
+    const tercera = await local.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2027-01-06T12:00", codigo: "CLUB10" },
+    });
+    assert.equal(tercera.status, 201);
+    // Cancela una: deja de contar, así que una cuarta CLUB10 cabe.
+    await local.pedir("POST", `/api/reservas/${segunda.cuerpo.reserva.id}/cancelar`);
+    const cuarta = await local.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2027-01-06T13:30", codigo: "CLUB10" },
+    });
+    assert.equal(cuarta.status, 201);
+    // Ahora hay tres confirmadas con CLUB10 (primera, tercera, cuarta). Mueve el reloj para liberar el cupo de futuras.
+    await local.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-09T09:00" } });
+    const quinta = await local.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-10T09:00", codigo: "CLUB10" },
+    });
+    assert.equal(quinta.status, 409);
+    assert.equal(quinta.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  } finally {
+    local.cerrar();
+  }
+});
+
+test("el formato del código no distingue mayúsculas ni espacios", async () => {
+  const local = await arrancarApi();
+  try {
+    const r = await local.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-06T09:00", codigo: "  club10 " },
+    });
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.codigo, "CLUB10");
+  } finally {
+    local.cerrar();
+  }
+});
+
+test("un código desconocido o no textual se rechaza", async () => {
+  const desconocido = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-06T09:00", codigo: "FOO" },
+  });
+  assert.equal(desconocido.status, 400);
+  assert.equal(desconocido.cuerpo.error.codigo, "CODIGO_INVALIDO");
+  const noTexto = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-06T09:00", codigo: 123 },
+  });
+  assert.equal(noTexto.status, 400);
+  assert.equal(noTexto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+});
+
+test("las reglas del club van antes que el código", async () => {
+  // socio-011 no tiene la cuota al día: gana CUOTA_INACTIVA, no CODIGO_NO_APLICABLE.
+  const sinCuota = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-011", pistaId: "pista-1", inicio: "2027-01-06T09:00", codigo: "BIENVENIDA" },
+  });
+  assert.equal(sinCuota.status, 409);
+  assert.equal(sinCuota.cuerpo.error.codigo, "CUOTA_INACTIVA");
+});
+
+test("la penalización fuera de plazo es el 100 % del importe con descuento", async () => {
+  const local = await arrancarApi();
+  try {
+    const r = await local.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-06T09:00", codigo: "BIENVENIDA" },
+    });
+    assert.equal(r.cuerpo.reserva.importe, 900);
+    await local.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-06T08:00" } });
+    const c = await local.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(c.cuerpo.reserva.penalizacion, 900);
+  } finally {
+    local.cerrar();
+  }
+});
+
+test("la disponibilidad sigue mostrando el precio sin descuento", async () => {
+  const d = await api.pedir("GET", "/api/disponibilidad?fecha=2027-01-06&pista=pista-1");
+  const franja = d.cuerpo.pistas[0].franjas.find((f: { inicio: string }) => f.inicio === "2027-01-06T09:00");
+  assert.equal(franja.precio, 1800);
+});
