+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+test("solo los gestores pueden exportar", async () => {
+  const sinSocio = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-18&hasta=2026-11-19");
+  assert.equal(sinSocio.status, 401);
+  assert.equal(sinSocio.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const noGestor = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-18&hasta=2026-11-19", { socio: "socio-001" });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+  const gestor = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-18&hasta=2026-11-19", { socio: "socio-040" });
+  assert.equal(gestor.status, 200);
+});
+
+test("responde el CSV con sus cabeceras y el periodo en el nombre", async () => {
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-18&hasta=2026-11-19", { socio: "socio-040" });
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-11-18-2026-11-19.csv"');
+  assert.ok(r.texto.startsWith("id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas\r\n"));
+});
+
+test("filas ordenadas, importes en euros y escapado RFC 4180", async () => {
+  const local = await arrancarApi();
+  try {
+    const nota = 'Uno, "dos"\nTres';
+    await local.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-05T09:00", notas: nota },
+    });
+    await local.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-002", pistaId: "pista-2", inicio: "2027-01-05T10:30" },
+    });
+    const r = await local.pedir("GET", "/api/reservas/exportar?desde=2027-01-05&hasta=2027-01-05", { socio: "socio-040" });
+    const lineas = r.texto.split("\r\n");
+    assert.equal(lineas[0], "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas");
+    // Nora (09:00) sale antes que Marta (10:30).
+    assert.ok(lineas[1].includes("2027-01-05,09:00,Pista 1,Nora Benítez,nora.benitez@example.com,confirmada,18.00,,"));
+    assert.ok(lineas[1].endsWith(`"${nota.replace(/"/g, '""')}"`));
+    assert.ok(lineas[2].includes("2027-01-05,10:30,Pista 2,Marta López"));
+    // Cada línea, también la última, termina en CRLF.
+    assert.equal(lineas[3], "");
+    assert.ok(r.texto.endsWith("\r\n"));
+  } finally {
+    local.cerrar();
+  }
+});
+
+test("la penalización también va en euros", async () => {
