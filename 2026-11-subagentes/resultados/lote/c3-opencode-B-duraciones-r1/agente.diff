+test("los huecos son los intervalos libres más largos entre las 09:00 y las 22:30", () =>
+  conApi(async (api) => {
+    const dia = "2026-12-02";
+    const inicio = `${dia}T09:00`;
+    const fin = `${dia}T22:30`;
+    const inicial = await api.pedir("GET", `/api/disponibilidad?fecha=${dia}&pista=pista-1`);
+    assert.deepEqual(inicial.cuerpo.pistas[0].huecos, [{ inicio, fin }]);
+
+    const primera = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${dia}T10:00`, duracion: 60 },
+    });
+    await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-006", pistaId: "pista-1", inicio: `${dia}T15:00`, duracion: 120 },
+    });
+    const conReservas = await api.pedir("GET", `/api/disponibilidad?fecha=${dia}&pista=pista-1`);
+    assert.deepEqual(conReservas.cuerpo.pistas[0].huecos, [
+      { inicio: `${dia}T09:00`, fin: `${dia}T10:00` },
+      { inicio: `${dia}T11:00`, fin: `${dia}T15:00` },
+      { inicio: `${dia}T17:00`, fin: `${dia}T22:30` },
+    ]);
+
+    await api.pedir("POST", `/api/reservas/${primera.cuerpo.reserva.id}/cancelar`);
+    const trasCancelar = await api.pedir("GET", `/api/disponibilidad?fecha=${dia}&pista=pista-1`);
+    assert.deepEqual(trasCancelar.cuerpo.pistas[0].huecos, [
+      { inicio: `${dia}T09:00`, fin: `${dia}T15:00` },
+      { inicio: `${dia}T17:00`, fin: `${dia}T22:30` },
+    ]);
+
+    // Una pista cerrada no tiene huecos.
+    const cerrada = await api.pedir("GET", `/api/disponibilidad?fecha=${dia}&pista=pista-4`);
+    assert.deepEqual(cerrada.cuerpo.pistas[0].huecos, []);
+
+    // Los huecos no dependen de la hora actual: un día ya pasado también los tiene.
+    const pasado = await api.pedir("GET", "/api/disponibilidad?fecha=2026-01-05&pista=pista-2");
+    assert.deepEqual(pasado.cuerpo.pistas[0].huecos, [{ inicio: "2026-01-05T09:00", fin: "2026-01-05T22:30" }]);
+  }));
