+// Las reservas de 60, 90 o 120 minutos: duraciones, inicios, solapes, precios y huecos.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("duracion es 60, 90 o 120; por defecto 90 y cualquier otro valor da DURACION_INVALIDA", () =>
+  conApi(async (api) => {
+    const porDefecto = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T09:00" },
+    });
+    assert.equal(porDefecto.status, 201);
+    assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+    assert.equal(porDefecto.cuerpo.reserva.fin, "2026-12-01T10:30");
+
+    const sesenta = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-006", pistaId: "pista-1", inicio: "2026-12-01T11:00", duracion: 60 },
+    });
+    assert.equal(sesenta.status, 201);
+    assert.equal(sesenta.cuerpo.reserva.duracion, 60);
+    assert.equal(sesenta.cuerpo.reserva.fin, "2026-12-01T12:00");
+
+    const cientoVeinte = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-016", pistaId: "pista-1", inicio: "2026-12-01T13:00", duracion: 120 },
+    });
+    assert.equal(cientoVeinte.status, 201);
+    assert.equal(cientoVeinte.cuerpo.reserva.duracion, 120);
+    assert.equal(cientoVeinte.cuerpo.reserva.fin, "2026-12-01T15:00");
+
+    for (const duracion of [45, 0, 150, "90", null]) {
+      const malo = await api.pedir("POST", "/api/reservas", {
+        cuerpo: { socioId: "socio-020", pistaId: "pista-1", inicio: "2026-12-01T16:00", duracion },
+      });
+      assert.equal(malo.status, 400, `duracion ${JSON.stringify(duracion)}`);
+      assert.equal(malo.cuerpo.error.codigo, "DURACION_INVALIDA");
+    }
+  }));
+
+test("los inicios son en punto o y media, desde las 09:00, y terminan como muy tarde a las 22:30", () =>
+  conApi(async (api) => {
+    const casosMalo = [
+      { inicio: "2026-12-02T11:15", duracion: 60 },
+      { inicio: "2026-12-02T08:30", duracion: 60 },
+      { inicio: "2026-12-02T22:00", duracion: 60 },
+      { inicio: "2026-12-02T21:00", duracion: 120 },
+    ];
+    for (const caso of casosMalo) {
+      const { inicio, duracion } = caso;
+      const malo = await api.pedir("POST", "/api/reservas", {
+        cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio, ...(duracion === undefined ? {} : { duracion }) },
+      });
+      assert.equal(malo.status, 400, inicio);
+      assert.equal(malo.cuerpo.error.codigo, "FRANJA_INVALIDA");
+    }
+    const sinMinutos = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-02T09" },
+    });
+    assert.equal(sinMinutos.cuerpo.error.codigo, "FRANJA_INVALIDA");
+
+    const hastaElCierre = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-02T21:30", duracion: 60 },
+    });
+    assert.equal(hastaElCierre.status, 201);
+    assert.equal(hastaElCierre.cuerpo.reserva.fin, "2026-12-02T22:30");
+
+    const noventaHastaElCierre = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-006", pistaId: "pista-2", inicio: "2026-12-02T21:00", duracion: 90 },
+    });
+    assert.equal(noventaHastaElCierre.status, 201);
+    assert.equal(noventaHastaElCierre.cuerpo.reserva.fin, "2026-12-02T22:30");
+  }));
+
+test("todas las reservas devuelven duracion, también las que ya existían", () =>
+  conApi(async (api) => {
+    const lista = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-01&limite=100");
+    assert.ok(lista.cuerpo.reservas.length > 0);
+    for (const reserva of lista.cuerpo.reservas) {
+      assert.equal(reserva.duracion, 90);
+    }
+    const una = await api.pedir("GET", `/api/reservas/${lista.cuerpo.reservas[0].id}`);
+    assert.equal(una.cuerpo.reserva.duracion, 90);
+  }));
+
+test("no hay solapes con reservas nuevas ni antiguas; tocar el borde no es solapar y las canceladas no ocupan", () =>
+  conApi(async (api) => {
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T10:00", duracion: 60 },
+    });
+    assert.equal(creada.status, 201);
+
+    const solapada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-006", pistaId: "pista-1", inicio: "2026-12-01T10:30", duracion: 60 },
