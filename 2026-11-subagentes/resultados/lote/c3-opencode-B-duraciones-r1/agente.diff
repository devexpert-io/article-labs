+function minutosDe(hora: string): number {
+  const [h, m] = hora.split(":").map(Number);
+  return h! * 60 + m!;
+}
+
+/** Suma minutos a una hora local `AAAA-MM-DDTHH:MM`. */
+export function sumarMinutos(inicio: string, minutos: number): string {
+  const total = minutosDe(inicio.slice(11)) + minutos;
   const hh = String(Math.floor(total / 60)).padStart(2, "0");
   const mm = String(total % 60).padStart(2, "0");
   return `${inicio.slice(0, 10)}T${hh}:${mm}`;
 }
 
+/**
+ * Precio de una reserva por minutos. Cada minuto vale el precio de la franja de 90 minutos
+ * de esa pista entre 90; valle de lunes a viernes antes de las 18:00 y punta el resto.
+ * Se redondea al céntimo más cercano, y el medio céntimo hacia arriba.
+ */
+export function importeReserva(pista: Pista, inicio: string, duracion: number): number {
+  const dia = diaDeLaSemana(inicio.slice(0, 10));
+  const inicioMin = minutosDe(inicio.slice(11));
+  const finMin = inicioMin + duracion;
+  let valle: number;
+  if (dia === 0 || dia === 6) {
+    valle = 0;
+  } else {
+    const corte = Math.min(Math.max(minutosDe("18:00"), inicioMin), finMin);
+    valle = corte - inicioMin;
+  }
+  const punta = duracion - valle;
+  return Math.floor((valle * pista.precioValle + punta * pista.precioPunta + 45) / 90);
+}
+
+export function finDeFranja(inicio: string): string {
+  return sumarMinutos(inicio, MINUTOS_FRANJA);
+}
