+      const asignadaA = estabaConfirmada ? asignarDesdeEspera(r.pistaId, r.inicio) : null;
+      return { reserva: r, asignadaA };
+    },
+
+    apuntarseAEspera(quien: Socio | undefined, datos: { pistaId?: unknown; inicio?: unknown }) {
+      const socio = exigirIdentidad(quien);
+      const { pistaId, inicio } = datos;
+      if (typeof pistaId !== "string" || typeof inicio !== "string") invalido("pistaId e inicio son obligatorios");
+      const p = pista(pistaId as string);
+      comprobarFranja(socio, p, inicio as string);
+      const reservada = estado.reservas.find((r) => r.pistaId === p.id && r.inicio === inicio && r.estado === "confirmada");
+      if (!reservada) throw new ErrorDelClub("FRANJA_LIBRE", "Esa franja está libre: se puede reservar directamente");
+      if (reservada.socioId === socio.id) throw new ErrorDelClub("YA_RESERVADA", `${socio.nombre} ya tiene reservada esa franja`);
+      if (listaDe(p.id, inicio as string).some((e) => e.socioId === socio.id)) {
+        throw new ErrorDelClub("YA_EN_ESPERA", `${socio.nombre} ya está en la lista de espera de esa franja`);
+      }
+      if (estado.esperas.filter((e) => vigente(e) && e.socioId === socio.id).length >= MAXIMO_ESPERAS_ACTIVAS) {
+        throw new ErrorDelClub("LIMITE_DE_ESPERAS", `${socio.nombre} ya tiene ${MAXIMO_ESPERAS_ACTIVAS} esperas activas`);
+      }
+      estado.contadorEsperas += 1;
+      const nueva: Espera = {
+        id: `E-${String(estado.contadorEsperas).padStart(4, "0")}`,
+        socioId: socio.id,
+        pistaId: p.id,
+        inicio: inicio as string,
+        estado: "activa",
+      };
+      estado.esperas.push(nueva);
+      return { espera: verEspera(nueva) };
+    },
+
+    listarEsperas(quien: Socio | undefined, socioId?: string) {
+      const socio = exigirIdentidad(quien);
+      const de = socioId ?? socio.id;
+      if (de !== socio.id && socio.rol !== "gestor") throw new ErrorDelClub("SIN_PERMISO", "Solo un gestor puede ver las esperas de otro socio", 403);
+      if (!estado.socios.some((s) => s.id === de)) throw new ErrorDelClub("SOCIO_NO_ENCONTRADO", `No existe el socio ${de}`, 404);
+      return { esperas: estado.esperas.filter((e) => vigente(e) && e.socioId === de).map(verEspera) };
+    },
+
+    retirarEspera(quien: Socio | undefined, id: string) {
+      const socio = exigirIdentidad(quien);
+      const e = espera(id);
+      if (e.socioId !== socio.id && socio.rol !== "gestor") throw new ErrorDelClub("SIN_PERMISO", "Solo su dueño o un gestor puede retirar esta espera", 403);
+      if (!vigente(e)) throw new ErrorDelClub("ESPERA_NO_ACTIVA", "Esa espera ya no está activa");
+      e.estado = "retirada";
+      return { espera: verEspera(e) };
     },
   };
 }
