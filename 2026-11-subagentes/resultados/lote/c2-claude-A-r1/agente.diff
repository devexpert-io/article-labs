+/** El id de la reserva confirmada de esa franja. */
+async function reservaDe(a: Api, pistaId: string, inicio: string): Promise<string> {
+  const r = await a.pedir("GET", `/api/reservas?fecha=${inicio.slice(0, 10)}&pista=${pistaId}&estado=confirmada`);
+  return r.cuerpo.reservas.find((x: { inicio: string }) => x.inicio === inicio).id;
