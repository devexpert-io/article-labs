+// Códigos de descuento al reservar (docs/specs/codigos-descuento.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Fechas sin reservas en la semilla. El 1 de diciembre de 2026 es martes y el 5, sábado.
+// Pista 1: valle 1800, punta 2800. Pista 3: valle 1200, punta 2000.
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const reservar = (a: Api, cuerpo: Record<string, unknown>) => a.pedir("POST", "/api/reservas", { cuerpo });
+
+test("sin código, la reserva se crea como antes", async () => {
+  const r = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T18:00" });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.importe, 2800);
+  assert.equal(r.cuerpo.reserva.importeBase, 2800);
+  assert.equal(r.cuerpo.reserva.descuento, 0);
+  assert.equal("codigo" in r.cuerpo.reserva, false);
+});
+
+test("BIENVENIDA: 50 % en la primera reserva del socio y nunca más", async () => {
+  // Las reglas del club van primero: si la reserva no se puede hacer, el código no cuenta como usado.
+  const pasada = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-18T09:00", codigo: "BIENVENIDA" });
+  assert.equal(pasada.status, 409);
+  assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+  const primera = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T19:30", codigo: "BIENVENIDA" });
+  assert.equal(primera.status, 201);
+  assert.equal(primera.cuerpo.reserva.importeBase, 2800);
+  assert.equal(primera.cuerpo.reserva.descuento, 1400);
+  assert.equal(primera.cuerpo.reserva.importe, 1400);
+  assert.equal(primera.cuerpo.reserva.codigo, "BIENVENIDA");
+  // Aunque la cancele, ya tiene una reserva anterior.
+  await api.pedir("POST", `/api/reservas/${primera.cuerpo.reserva.id}/cancelar`);
+  const segunda = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T21:00", codigo: "BIENVENIDA" });
+  assert.equal(segunda.status, 409);
+  assert.equal(segunda.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  const veterano = await reservar(api, { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-12-01T19:30", codigo: "BIENVENIDA" });
+  assert.equal(veterano.status, 409);
+  assert.equal(veterano.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("BIENVENIDA caduca después del 31 de diciembre de 2026, según la hora del club", async () => {
+  const otra = await arrancarApi({ AHORA: "2026-12-31T21:00" });
+  try {
+    const ultimoDia = await reservar(otra, { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-04T09:00", codigo: "BIENVENIDA" });
+    assert.equal(ultimoDia.status, 201);
+    assert.equal(ultimoDia.cuerpo.reserva.importe, 900);
+  } finally {
+    otra.cerrar();
+  }
+  const tarde = await arrancarApi({ AHORA: "2027-01-01T09:00" });
+  try {
+    const r = await reservar(tarde, { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-04T09:00", codigo: "BIENVENIDA" });
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  } finally {
+    tarde.cerrar();
+  }
+});
+
+test("MANANAS: 4,00 € en franjas de lunes a viernes que empiezan antes de las 12:00", async () => {
+  const r = await reservar(api, { socioId: "socio-006", pistaId: "pista-1", inicio: "2026-12-01T10:30", codigo: "MANANAS" });
+  assert.equal(r.status, 201);
+  assert.deepEqual([r.cuerpo.reserva.importeBase, r.cuerpo.reserva.descuento, r.cuerpo.reserva.importe], [1800, 400, 1400]);
+  assert.equal(r.cuerpo.reserva.codigo, "MANANAS");
+  for (const inicio of ["2026-12-01T12:00", "2026-12-05T09:00", "2026-12-06T10:30"]) {
+    const no = await reservar(api, { socioId: "socio-006", pistaId: "pista-3", inicio, codigo: "MANANAS" });
+    assert.equal(no.status, 409, inicio);
+    assert.equal(no.cuerpo.error.codigo, "CODIGO_NO_APLICABLE", inicio);
+  }
+});
+
+test("CLUB10: 10 %, como mucho en 3 reservas confirmadas o no presentadas; las canceladas no cuentan", async () => {
+  const otra = await arrancarApi();
+  try {
+    const ids: string[] = [];
+    for (const inicio of ["2026-12-01T09:00", "2026-12-01T10:30", "2026-12-01T12:00"]) {
+      const r = await reservar(otra, { socioId: "socio-006", pistaId: "pista-3", inicio, codigo: "CLUB10" });
+      assert.equal(r.status, 201, inicio);
+      assert.deepEqual([r.cuerpo.reserva.importeBase, r.cuerpo.reserva.descuento, r.cuerpo.reserva.importe], [1200, 120, 1080]);
+      ids.push(r.cuerpo.reserva.id);
+    }
+    // Una cancelada deja de contar.
+    await otra.pedir("POST", `/api/reservas/${ids[0]}/cancelar`);
+    const otraVez = await reservar(otra, { socioId: "socio-006", pistaId: "pista-1", inicio: "2026-12-01T19:30", codigo: "club10" });
+    assert.equal(otraVez.status, 201);
+    assert.deepEqual([otraVez.cuerpo.reserva.descuento, otraVez.cuerpo.reserva.importe], [280, 2520]);
+    // Cuando han pasado, siguen confirmadas y cuentan: el cuarto uso no se aplica.
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-02T10:00" } });
+    const cuarta = await reservar(otra, { socioId: "socio-006", pistaId: "pista-3", inicio: "2026-12-03T09:00", codigo: "CLUB10" });
+    assert.equal(cuarta.status, 409);
+    assert.equal(cuarta.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+    const sinCodigo = await reservar(otra, { socioId: "socio-006", pistaId: "pista-3", inicio: "2026-12-03T09:00" });
+    assert.equal(sinCodigo.status, 201);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("formato del código: mayúsculas y espacios dan igual, un solo código y que exista", async () => {
+  const r = await reservar(api, { socioId: "socio-020", pistaId: "pista-3", inicio: "2026-12-02T18:00", codigo: "  club10 " });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.codigo, "CLUB10");
+  assert.equal(r.cuerpo.reserva.importe, 1800);
+  for (const codigo of ["NAVIDAD", "", "CLUB10 MANANAS", "CLUB10,MANANAS"]) {
+    const mal = await reservar(api, { socioId: "socio-020", pistaId: "pista-3", inicio: "2026-12-02T19:30", codigo });
+    assert.equal(mal.status, 400, codigo);
+    assert.equal(mal.cuerpo.error.codigo, "CODIGO_INVALIDO", codigo);
+  }
+  for (const codigo of [10, true, null, ["CLUB10", "MANANAS"], { codigo: "CLUB10" }]) {
+    const mal = await reservar(api, { socioId: "socio-020", pistaId: "pista-3", inicio: "2026-12-02T19:30", codigo });
+    assert.equal(mal.status, 400, JSON.stringify(codigo));
+    assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS", JSON.stringify(codigo));
+  }
+});
+
+test("las reglas del club van primero", async () => {
+  // socio-011 no tiene la cuota al día.
+  const cuota = await reservar(api, { socioId: "socio-011", pistaId: "pista-3", inicio: "2026-12-02T09:00", codigo: "NAVIDAD" });
+  assert.equal(cuota.status, 409);
+  assert.equal(cuota.cuerpo.error.codigo, "CUOTA_INACTIVA");
+  const cerrada = await reservar(api, { socioId: "socio-003", pistaId: "pista-4", inicio: "2026-12-02T09:00", codigo: "MANANAS" });
+  assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+  const franja = await reservar(api, { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-12-02T09:15", codigo: "MANANAS" });
+  assert.equal(franja.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  // Irene tiene 1 reserva futura: con 2 más llega al límite.
+  for (const inicio of ["2026-12-04T09:00", "2026-12-04T10:30"]) {
+    assert.equal((await reservar(api, { socioId: "socio-004", pistaId: "pista-3", inicio, codigo: "CLUB10" })).status, 201);
+  }
+  const limite = await reservar(api, { socioId: "socio-004", pistaId: "pista-3", inicio: "2026-12-04T12:00", codigo: "CLUB10" });
+  assert.equal(limite.status, 409);
+  assert.equal(limite.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+  const usadas = (await api.pedir("GET", "/api/reservas?socio=socio-004&limite=100")).cuerpo.reservas.filter((x: any) => x.codigo === "CLUB10");
+  assert.equal(usadas.length, 2, "el intento fallido no cuenta como uso");
+});
+
+test("los importes se guardan y se devuelven al consultar", async () => {
+  const r = await reservar(api, { socioId: "socio-009", pistaId: "pista-1", inicio: "2026-12-03T10:30", codigo: "mananas" });
+  const id = r.cuerpo.reserva.id;
+  const una = (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva;
+  assert.deepEqual([una.importeBase, una.descuento, una.importe, una.codigo], [1800, 400, 1400, "MANANAS"]);
+  const lista = (await api.pedir("GET", "/api/reservas?fecha=2026-12-03&socio=socio-009")).cuerpo.reservas;
+  assert.deepEqual(lista, [una]);
+});
+
+test("la penalización es el 100 % de lo que paga el socio", async () => {
+  const otra = await arrancarApi({ AHORA: "2026-11-30T20:00" });
+  try {
+    const r = await reservar(otra, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T09:00", codigo: "BIENVENIDA" });
+    assert.equal(r.cuerpo.reserva.importe, 900);
+    const cancelada = await otra.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 900);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("la disponibilidad sigue mostrando el precio sin descuento", async () => {
+  const d = await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-01&pista=pista-1");
+  const franja = d.cuerpo.pistas[0].franjas.find((f: any) => f.inicio === "2026-12-01T10:30");
+  assert.equal(franja.estado, "reservada");
+  assert.equal(franja.precio, 1800);
+});
