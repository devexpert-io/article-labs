+const ZONA_HORARIA = "Europe/Madrid";
+
+/** Desfase (ms) de la zona horaria del club respecto de UTC en un instante dado. */
+function desfaseMs(instante: number): number {
+  const partes = new Intl.DateTimeFormat("en-US", {
+    timeZone: ZONA_HORARIA,
+    hourCycle: "h23",
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+    hour: "2-digit",
+    minute: "2-digit",
+    second: "2-digit",
+  }).formatToParts(new Date(instante));
+  const leer = (tipo: string) => Number(partes.find((p) => p.type === tipo)?.value ?? 0);
+  const comoUtc = Date.UTC(leer("year"), leer("month") - 1, leer("day"), leer("hour"), leer("minute"), leer("second"));
+  return comoUtc - instante;
+}
+
+/** Convierte una hora local del club (Europe/Madrid) al instante UTC real correspondiente. */
+function instanteMadrid(local: string): number {
+  const [fecha, hora] = local.split("T");
+  const [a, m, d] = fecha!.split("-").map(Number);
+  const [hh, mm] = hora!.split(":").map(Number);
+  const comoUtc = Date.UTC(a!, m! - 1, d!, hh!, mm!, 0);
+  let instante = comoUtc;
+  for (let i = 0; i < 3; i++) instante = comoUtc - desfaseMs(instante);
+  return instante;
+}
+
+/** Horas reales de Madrid entre dos horas locales, contando el cambio de hora. */
 function horasEntre(desde: string, hasta: string): number {
-  return (Date.parse(`${hasta}:00Z`) - Date.parse(`${desde}:00Z`)) / 3_600_000;
+  return (instanteMadrid(hasta) - instanteMadrid(desde)) / 3_600_000;
 }
 
