+// La política de cancelación escalonada, la exención y el informe de caja.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+async function crear(inicio: string, socioId = "socio-006", pistaId = "pista-1") {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+}
+
+test("tramos: gratis con 48 horas o más, 25 % entre 24 y 48, 50 % con menos de 24 (y forzar)", async () => {
+  // 48 horas o más: sin penalización y se devuelve el importe entero.
+  const lejos = await crear("2026-11-24T09:00");
+  const gratis = await api.pedir("POST", `/api/reservas/${lejos.id}/cancelar`);
+  assert.equal(gratis.status, 200);
+  assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.cuerpo.reembolso, lejos.importe);
+
+  // Entre 24 y 48 horas: 25 % del importe, sin necesidad de forzar.
+  const medio = await crear("2026-11-20T09:00");
+  const parcial = await api.pedir("POST", `/api/reservas/${medio.id}/cancelar`);
+  assert.equal(parcial.status, 200);
+  assert.equal(parcial.cuerpo.reserva.penalizacion, medio.importe / 4);
+  assert.equal(parcial.cuerpo.reembolso, medio.importe - medio.importe / 4);
+
+  // Menos de 24 horas: exige forzar y penaliza el 50 %.
+  const cerca = await crear("2026-11-19T09:00");
+  const sinForzar = await api.pedir("POST", `/api/reservas/${cerca.id}/cancelar`);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await api.pedir("POST", `/api/reservas/${cerca.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, cerca.importe / 2);
+  assert.equal(forzada.cuerpo.reembolso, cerca.importe - cerca.importe / 2);
+});
+
+test("límites exactos: 48 horas justas gratis y 24 horas justas al 25 %", async () => {
+  const otra = await arrancarApi({ AHORA: "2026-11-18T09:00" });
+  try {
+    const crearEn = async (inicio: string) => {
+      const r = await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-006", pistaId: "pista-1", inicio } });
+      assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+      return r.cuerpo.reserva;
+    };
+    const justo48 = await crearEn("2026-11-20T09:00");
+    const c48 = await otra.pedir("POST", `/api/reservas/${justo48.id}/cancelar`);
+    assert.equal(c48.status, 200);
+    assert.equal(c48.cuerpo.reserva.penalizacion, undefined);
+
+    const justo24 = await crearEn("2026-11-19T09:00");
+    const c24 = await otra.pedir("POST", `/api/reservas/${justo24.id}/cancelar`);
+    assert.equal(c24.status, 200);
+    assert.equal(c24.cuerpo.reserva.penalizacion, justo24.importe / 4);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("el cambio de hora se cuenta en horas reales de Madrid", async () => {
+  const otra = await arrancarApi({ AHORA: "2027-03-26T20:30" });
+  try {
