@@ -0,0 +1,162 @@
+// Códigos de descuento al reservar (docs/specs/codigos-descuento.md), probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { calcularImportes } from "../src/descuentos.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// socio-041 (Nora Benítez) no tiene reservas; socio-002 (Marta López) tiene historial y una reserva futura;
+// socio-011 no tiene la cuota al día. En diciembre la semilla no tiene reservas.
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const reservar = (api: Api, socioId: string, pistaId: string, inicio: string, codigo?: unknown) =>
+  api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio, ...(codigo === undefined ? {} : { codigo }) } });
+
+function error(r: { status: number; cuerpo: any }, status: number, codigo: string) {
+  assert.equal(r.status, status, JSON.stringify(r.cuerpo));
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+test("sin código, la reserva se crea como antes, sin descuento ni codigo", () => conApi(async (api) => {
+  const r = await reservar(api, "socio-002", "pista-1", "2026-12-01T12:00");
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.importeBase, 1800);
+  assert.equal(r.cuerpo.reserva.descuento, 0);
+  assert.equal(r.cuerpo.reserva.importe, 1800);
+  assert.equal("codigo" in r.cuerpo.reserva, false);
+}));
+
+test("BIENVENIDA descuenta el 50 % solo en la primera reserva del socio", () => conApi(async (api) => {
+  const primera = await reservar(api, "socio-041", "pista-1", "2026-12-05T18:00", "BIENVENIDA");
+  assert.equal(primera.status, 201);
+  assert.deepEqual(
+    [primera.cuerpo.reserva.importeBase, primera.cuerpo.reserva.descuento, primera.cuerpo.reserva.importe, primera.cuerpo.reserva.codigo],
+    [2800, 1400, 1400, "BIENVENIDA"],
+  );
+  error(await reservar(api, "socio-041", "pista-2", "2026-12-06T18:00", "BIENVENIDA"), 409, "CODIGO_NO_APLICABLE");
+  error(await reservar(api, "socio-002", "pista-2", "2026-12-06T18:00", "BIENVENIDA"), 409, "CODIGO_NO_APLICABLE");
+}));
+
+test("BIENVENIDA cuenta las reservas anteriores en cualquier estado, también las canceladas", () => conApi(async (api) => {
+  const sin = await reservar(api, "socio-041", "pista-1", "2026-12-05T18:00");
+  await api.pedir("POST", `/api/reservas/${sin.cuerpo.reserva.id}/cancelar`);
+  error(await reservar(api, "socio-041", "pista-2", "2026-12-06T18:00", "BIENVENIDA"), 409, "CODIGO_NO_APLICABLE");
+}));
+
+test("BIENVENIDA vale hasta el 31 de diciembre de 2026 incluido, según la hora del club", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "socio-041", "pista-1", "2027-01-05T12:00", "BIENVENIDA");
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.importe, 900);
+  }, { AHORA: "2026-12-31T23:30" });
+  await conApi(async (api) => {
+    error(await reservar(api, "socio-041", "pista-1", "2027-01-05T12:00", "BIENVENIDA"), 409, "CODIGO_NO_APLICABLE");
+  }, { AHORA: "2027-01-01T00:00" });
+});
+
+test("MANANAS descuenta 4,00 € de lunes a viernes en franjas que empiezan antes de las 12:00", () => conApi(async (api) => {
+  const lunes = await reservar(api, "socio-041", "pista-3", "2026-11-30T10:30", "MANANAS");
+  assert.equal(lunes.status, 201);
+  assert.deepEqual([lunes.cuerpo.reserva.importeBase, lunes.cuerpo.reserva.descuento, lunes.cuerpo.reserva.importe], [1200, 400, 800]);
+  const viernes = await reservar(api, "socio-041", "pista-1", "2026-12-04T09:00", "mananas");
+  assert.equal(viernes.status, 201);
+  assert.equal(viernes.cuerpo.reserva.importe, 1400);
+  error(await reservar(api, "socio-041", "pista-1", "2026-12-01T12:00", "MANANAS"), 409, "CODIGO_NO_APLICABLE");
+  error(await reservar(api, "socio-041", "pista-1", "2026-12-05T09:00", "MANANAS"), 409, "CODIGO_NO_APLICABLE");
+  error(await reservar(api, "socio-041", "pista-1", "2026-12-06T10:30", "MANANAS"), 409, "CODIGO_NO_APLICABLE");
+}));
+
+test("CLUB10 descuenta el 10 % hasta 3 reservas por socio, sin contar las canceladas", () => conApi(async (api) => {
+  const ids: string[] = [];
+  for (const dia of ["01", "02", "03"]) {
+    const r = await reservar(api, "socio-041", "pista-3", `2026-12-${dia}T12:00`, "CLUB10");
+    assert.equal(r.status, 201);
+    assert.deepEqual([r.cuerpo.reserva.importeBase, r.cuerpo.reserva.descuento, r.cuerpo.reserva.importe], [1200, 120, 1080]);
+    ids.push(r.cuerpo.reserva.id);
+  }
+  assert.equal((await api.pedir("POST", `/api/reservas/${ids[0]}/cancelar`)).cuerpo.reserva.estado, "cancelada");
+  const otra = await reservar(api, "socio-041", "pista-3", "2026-12-04T12:00", "CLUB10");
+  assert.equal(otra.status, 201);
+  // Las tres siguen confirmadas, aunque ya hayan pasado.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-10T10:00" } });
+  error(await reservar(api, "socio-041", "pista-3", "2026-12-15T12:00", "CLUB10"), 409, "CODIGO_NO_APLICABLE");
+  assert.equal((await reservar(api, "socio-041", "pista-3", "2026-12-15T12:00")).status, 201);
+}));
+
+test("CLUB10 cuenta las no presentadas y no las canceladas", () => {
+  // La API no marca reservas como no presentadas: se prueba la regla directamente sobre un estado.
+  const estado = crearSemilla();
+  const base = { socioId: "socio-041", pistaId: "pista-3", fin: "", notas: "", importe: 1080, importeBase: 1200, descuento: 120, codigo: "CLUB10" };
+  estado.reservas.push(
+    { ...base, id: "X-1", inicio: "2026-11-01T12:00", estado: "no_presentada" },
+    { ...base, id: "X-2", inicio: "2026-11-02T12:00", estado: "confirmada" },
+    { ...base, id: "X-3", inicio: "2026-11-03T12:00", estado: "cancelada" },
+  );
+  assert.equal(calcularImportes(estado, "socio-041", "2026-12-01T12:00", 1200, "CLUB10").importe, 1080);
+  estado.reservas.push({ ...base, id: "X-4", inicio: "2026-11-04T12:00", estado: "no_presentada" });
+  assert.throws(() => calcularImportes(estado, "socio-041", "2026-12-01T12:00", 1200, "CLUB10"), { codigo: "CODIGO_NO_APLICABLE" });
+});
+
+test("formato del código: mayúsculas y espacios dan igual; desconocido o no texto, 400", () => conApi(async (api) => {
+  const r = await reservar(api, "socio-041", "pista-3", "2026-12-01T12:00", "  club10 ");
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.codigo, "CLUB10");
+  error(await reservar(api, "socio-041", "pista-3", "2026-12-02T12:00", "VERANO"), 400, "CODIGO_INVALIDO");
+  error(await reservar(api, "socio-041", "pista-3", "2026-12-02T12:00", ""), 400, "CODIGO_INVALIDO");
+  error(await reservar(api, "socio-041", "pista-3", "2026-12-02T12:00", 10), 400, "DATOS_INVALIDOS");
+  error(await reservar(api, "socio-041", "pista-3", "2026-12-02T12:00", null), 400, "DATOS_INVALIDOS");
+}));
+
+test("un solo código por reserva: los descuentos no se acumulan", () => conApi(async (api) => {
+  error(await reservar(api, "socio-041", "pista-3", "2026-11-30T10:30", ["MANANAS", "CLUB10"]), 400, "DATOS_INVALIDOS");
+  error(await reservar(api, "socio-041", "pista-3", "2026-11-30T10:30", "MANANAS CLUB10"), 400, "CODIGO_INVALIDO");
+  const r = await reservar(api, "socio-041", "pista-3", "2026-11-30T10:30", "MANANAS");
+  assert.equal(r.cuerpo.reserva.descuento, 400);
+}));
+
+test("GET /api/reservas/:id y GET /api/reservas devuelven los importes y el código", () => conApi(async (api) => {
+  const creada = (await reservar(api, "socio-041", "pista-1", "2026-12-01T10:30", "MANANAS")).cuerpo.reserva;
+  const una = (await api.pedir("GET", `/api/reservas/${creada.id}`)).cuerpo.reserva;
+  assert.deepEqual([una.importeBase, una.descuento, una.importe, una.codigo], [1800, 400, 1400, "MANANAS"]);
+  const lista = (await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.reservas;
+  assert.deepEqual(lista, [una]);
+}));
+
+test("las reglas del club van primero y el código no cuenta como usado", () => conApi(async (api) => {
+  error(await reservar(api, "socio-011", "pista-1", "2026-12-01T12:00", "BIENVENIDA"), 409, "CUOTA_INACTIVA");
+  error(await reservar(api, "socio-041", "pista-4", "2026-12-01T12:00", "BIENVENIDA"), 409, "PISTA_CERRADA");
+  error(await reservar(api, "socio-041", "pista-1", "2026-11-18T09:00", "BIENVENIDA"), 409, "FRANJA_PASADA");
+  error(await reservar(api, "socio-041", "pista-1", "2026-11-19T19:30", "BIENVENIDA"), 409, "FRANJA_NO_DISPONIBLE");
+  error(await reservar(api, "socio-041", "pista-1", "2026-12-01T12:15", "BIENVENIDA"), 400, "FRANJA_INVALIDA");
+  error(await reservar(api, "socio-041", "pista-1", "2026-12-06T12:00", "MANANAS"), 409, "CODIGO_NO_APLICABLE");
+  const r = await reservar(api, "socio-041", "pista-1", "2026-12-01T12:00", "BIENVENIDA");
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.descuento, 900);
+  // Luis Martín ya tiene dos reservas futuras: con una más llega al límite y la cuarta falla por el límite, no por el código.
+  assert.equal((await reservar(api, "socio-005", "pista-3", "2026-12-01T12:00", "CLUB10")).status, 201);
+  error(await reservar(api, "socio-005", "pista-3", "2026-12-02T12:00", "CLUB10"), 409, "LIMITE_DE_RESERVAS");
+}));
+
+test("la penalización por cancelar fuera de plazo es el importe con descuento", () => conApi(async (api) => {
+  const r = (await reservar(api, "socio-041", "pista-1", "2026-12-01T09:00", "MANANAS")).cuerpo.reserva;
+  assert.equal(r.importe, 1400);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T12:00" } });
+  const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1400);
+}));
+
+test("la disponibilidad sigue mostrando el precio sin descuento", () => conApi(async (api) => {
+  assert.equal((await reservar(api, "socio-041", "pista-1", "2026-12-01T10:30", "BIENVENIDA")).status, 201);
+  const dia = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-01&pista=pista-1")).cuerpo;
+  const franja = dia.pistas[0].franjas.find((f: any) => f.inicio === "2026-12-01T10:30");
+  assert.equal(franja.estado, "reservada");
+  assert.equal(franja.precio, 1800);
+}));
diff --git a/test/exportar-csv.test.ts b/test/exportar-csv.test.ts
new file mode 100644
index 0000000..372ecba
--- /dev/null
+++ b/test/exportar-csv.test.ts
@@ -0,0 +1,154 @@
+// Exportar reservas a CSV (docs/specs/exportar-csv.md), probado a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const exportar = (consulta: string, socio = GESTOR) => api.pedir("GET", `/api/reservas/exportar?${consulta}`, { socio });
+const lineas = (texto: string) => texto.split("\r\n").slice(0, -1);
+
+test("permisos: solo exporta un gestor", async () => {
+  const anonimo = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19");
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await exportar("desde=2026-11-19&hasta=2026-11-19", "socio-001");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const desconocido = await exportar("desde=2026-11-19&hasta=2026-11-19", "socio-999");
+  assert.equal(desconocido.status, 401);
+  assert.equal(desconocido.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  assert.equal((await exportar("desde=2026-11-19&hasta=2026-11-19")).status, 200);
+});
+
+test("respuesta: 200 con content-type y content-disposition con el periodo", async () => {
+  const r = await exportar("desde=2026-10-01&hasta=2026-10-31");
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-10-31.csv"');
+});
+
+test("cabecera exacta y CRLF al final de cada línea, también la última", async () => {
+  const r = await exportar("desde=2026-11-19&hasta=2026-11-19");
+  assert.ok(r.texto.startsWith(`${CABECERA}\r\n`));
+  assert.ok(r.texto.endsWith("\r\n"));
+  assert.equal(r.texto.replaceAll("\r\n", "").includes("\n"), false, "no hay LF sueltos");
+  const vacio = await exportar("desde=2027-01-01&hasta=2027-01-01");
+  assert.equal(vacio.texto, `${CABECERA}\r\n`);
+});
+
+test("filas: una por reserva del periodo, en cualquier estado, ordenadas por inicio y pista", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const esperadas = estado.reservas.filter((r: any) => r.inicio >= "2026-10-01" && r.inicio.slice(0, 10) <= "2026-10-31");
+  const r = await exportar("desde=2026-10-01&hasta=2026-10-31");
+  const filas = lineas(r.texto).slice(1);
+  assert.equal(filas.length, 315);
+  assert.equal(filas.length, esperadas.length);
+  assert.deepEqual(new Set(filas.map((f) => f.split(",")[6])), new Set(["confirmada", "cancelada", "no_presentada"]));
+  const claves = filas.map((f) => { const c = f.split(","); return `${c[1]}T${c[2]}|${c[3]}`; });
+  assert.deepEqual(claves, [...claves].sort());
+  assert.ok(filas[0]!.split(",")[1] === "2026-10-01");
+  assert.ok(filas.at(-1)!.split(",")[1] === "2026-10-31");
+
+  // Columnas: fecha, hora, nombre de pista, nombre y email del socio.
+  const reserva = esperadas[0];
+  const socio = estado.socios.find((s: any) => s.id === reserva.socioId);
+  const pista = estado.pistas.find((p: any) => p.id === reserva.pistaId);
+  assert.equal(
+    filas[0],
+    [reserva.id, reserva.inicio.slice(0, 10), reserva.inicio.slice(11), pista.nombre, socio.nombre, socio.email, reserva.estado, (reserva.importe / 100).toFixed(2), "", ""].join(","),
+  );
+});
+
+test("filas: si empiezan a la vez, van por id de pista", async () => {
+  // Se crean en orden inverso de pista: la exportación las ordena igualmente.
+  for (const [socioId, pistaId] of [["socio-035", "pista-3"], ["socio-036", "pista-2"], ["socio-037", "pista-1"]]) {
+    const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio: "2026-12-10T10:30" } });
+    assert.equal(creada.status, 201);
+  }
+  const r = await exportar("desde=2026-12-10&hasta=2026-12-10");
+  const a1030 = lineas(r.texto).slice(1).filter((f) => f.split(",")[2] === "10:30").map((f) => f.split(",")[3]);
+  assert.deepEqual(a1030, ["Pista 1", "Pista 2", "Pista 3"]);
+});
+
+test("importes en euros con dos decimales; penalización vacía si no la hay", async () => {
+  const cancelada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1200);
+  const { inicio } = cancelada.cuerpo.reserva;
+  const dia = inicio.slice(0, 10);
+  const r = await exportar(`desde=${dia}&hasta=${dia}`);
+  const filas = lineas(r.texto).slice(1).map((f) => f.split(","));
+  const fila = filas.find((c) => c[0] === "R-0520")!;
+  assert.equal(fila[6], "cancelada");
+  assert.equal(fila[7], "12.00");
+  assert.equal(fila[8], "12.00");
+  for (const c of filas.filter((c) => c[0] !== "R-0520")) {
+    assert.match(c[7]!, /^\d+\.\d{2}$/);
+    assert.equal(c[8], "");
+  }
+});
+
+test("escapado RFC 4180: comas, comillas y saltos de línea", async () => {
+  const notas = ["Con palas, bolas y agua", 'Dice "urgente"', "Línea 1\nLínea 2", "Sin nada raro"];
+  const ids: string[] = [];
+  for (const [i, nota] of notas.entries()) {
+    const socioId = ["socio-030", "socio-031", "socio-032", "socio-034"][i]!;
+    const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-3", inicio: `2026-12-0${i + 1}T09:00`, notas: nota } });
+    assert.equal(creada.status, 201);
+    ids.push(creada.cuerpo.reserva.id);
+  }
+  const r = await exportar("desde=2026-12-01&hasta=2026-12-04");
+  assert.ok(r.texto.includes(`,"Con palas, bolas y agua"\r\n`));
+  assert.ok(r.texto.includes(`,"Dice ""urgente"""\r\n`));
+  assert.ok(r.texto.includes(`,"Línea 1\nLínea 2"\r\n`));
+  assert.ok(r.texto.includes(`,Sin nada raro\r\n`));
+  assert.ok(r.texto.includes(`${ids[3]},2026-12-04,09:00,Pista 3,`));
+  assert.equal(r.texto.replaceAll('"Línea 1\nLínea 2"', "").replace(/"Con palas, bolas y agua"|"Dice ""urgente"""/g, "").includes('"'), false, "el resto de campos va sin comillas");
+});
+
+test("periodo: obligatorio, con formato, ordenado y de 92 días como mucho", async () => {
+  for (const consulta of ["", "desde=2026-11-01", "hasta=2026-11-01", "desde=2026-11-1&hasta=2026-11-30", "desde=2026-11-01&hasta=30-11-2026", "desde=2026-02-30&hasta=2026-03-01", "desde=2026-11-30&hasta=2026-11-01"]) {
+    const r = await exportar(consulta);
+    assert.equal(r.status, 400, consulta);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", consulta);
+  }
+  // Del 1 de octubre al 31 de diciembre son 92 días contando los dos extremos.
+  assert.equal((await exportar("desde=2026-10-01&hasta=2026-12-31")).status, 200);
+  const grande = await exportar("desde=2026-10-01&hasta=2027-01-01");
+  assert.equal(grande.status, 400);
+  assert.equal(grande.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+});
+
+test("filtro por estado", async () => {
+  for (const estado of ["confirmada", "cancelada", "no_presentada"]) {
+    const r = await exportar(`desde=2026-10-01&hasta=2026-10-31&estado=${estado}`);
+    assert.equal(r.status, 200);
+    const filas = lineas(r.texto).slice(1);
+    assert.ok(filas.length > 0);
+    assert.ok(filas.every((f) => f.split(",")[6] === estado), estado);
+  }
+  const malo = await exportar("desde=2026-10-01&hasta=2026-10-31&estado=pendiente");
+  assert.equal(malo.status, 400);
+  assert.equal(malo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+});
+
+test("GET /api/reservas responde igual que antes", async () => {
+  const antes = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=100&pagina=2");
+  await exportar("desde=2026-10-01&hasta=2026-10-31");
+  const despues = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=100&pagina=2");
+  assert.equal(despues.status, 200);
+  assert.equal(despues.cabeceras.get("content-type"), "application/json; charset=utf-8");
+  assert.deepEqual(despues.cuerpo, antes.cuerpo);
+  assert.deepEqual(Object.keys(despues.cuerpo), ["total", "pagina", "paginas", "reservas"]);
+  assert.equal(despues.cuerpo.total, 315);
+  assert.equal(despues.cuerpo.reservas.length, 100);
+  assert.equal((await api.pedir("GET", "/api/reservas?limite=101")).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await api.pedir("GET", "/api/reservas/R-0001")).cuerpo.reserva.id, "R-0001");
+});
diff --git a/test/lista-espera.test.ts b/test/lista-espera.test.ts
