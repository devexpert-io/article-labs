+// Exportación de reservas a CSV (RFC 4180) para la recepción del club.
+import { ErrorDelClub } from "./nucleo.ts";
+import type { Estado, EstadoReserva, Reserva, Socio } from "./tipos.ts";
+
+const FECHA = /^\d{4}-\d{2}-\d{2}$/;
+const ESTADOS: EstadoReserva[] = ["confirmada", "cancelada", "no_presentada"];
+export const MAXIMO_DIAS_EXPORTACION = 92;
+export const CABECERA_CSV = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+
+/** Resultado que el servidor responde como fichero CSV en lugar de JSON. */
+export class RespuestaCsv {
+  nombreFichero: string;
+  contenido: string;
+  constructor(nombreFichero: string, contenido: string) {
+    this.nombreFichero = nombreFichero;
+    this.contenido = contenido;
+  }
+}
+
+export interface FiltrosExportacion {
+  desde?: string;
+  hasta?: string;
+  estado?: string;
+}
+
+function invalido(mensaje: string): never {
+  throw new ErrorDelClub("DATOS_INVALIDOS", mensaje, 400);
+}
+
+/** Días desde la época de una fecha AAAA-MM-DD, o undefined si no es una fecha real. */
+function dia(fecha: string | undefined): number | undefined {
+  if (fecha === undefined || !FECHA.test(fecha)) return undefined;
+  const ms = Date.parse(`${fecha}T00:00:00Z`);
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== fecha) return undefined;
+  return ms / 86_400_000;
+}
+
+function campo(valor: string): string {
+  return /[",\r\n]/.test(valor) ? `"${valor.replaceAll('"', '""')}"` : valor;
+}
+
+function euros(centimos: number | undefined): string {
+  return centimos === undefined ? "" : (centimos / 100).toFixed(2);
+}
+
+export function exportarReservas(estado: Estado, quien: Socio | undefined, f: FiltrosExportacion): RespuestaCsv {
+  if (!quien) throw new ErrorDelClub("NO_IDENTIFICADO", "Hace falta la cabecera X-Socio para exportar", 401);
+  if (quien.rol !== "gestor") throw new ErrorDelClub("SIN_PERMISO", "Solo los gestores pueden exportar reservas", 403);
+  const desde = dia(f.desde);
+  const hasta = dia(f.hasta);
+  if (desde === undefined) invalido("desde es obligatorio, con el formato AAAA-MM-DD");
+  if (hasta === undefined) invalido("hasta es obligatorio, con el formato AAAA-MM-DD");
+  if (desde > hasta) invalido("desde no puede ser posterior a hasta");
+  if (hasta - desde + 1 > MAXIMO_DIAS_EXPORTACION) {
+    throw new ErrorDelClub("RANGO_DEMASIADO_GRANDE", `El periodo puede abarcar como mucho ${MAXIMO_DIAS_EXPORTACION} días`, 400);
+  }
+  if (f.estado !== undefined && !ESTADOS.includes(f.estado as EstadoReserva)) {
+    invalido('estado debe ser "confirmada", "cancelada" o "no_presentada"');
+  }
+
+  const reservas = estado.reservas
+    .filter((r) => r.inicio.slice(0, 10) >= f.desde! && r.inicio.slice(0, 10) <= f.hasta! && (!f.estado || r.estado === f.estado))
+    .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.pistaId.localeCompare(b.pistaId, undefined, { numeric: true }));
+
+  const fila = (r: Reserva) => {
+    const pista = estado.pistas.find((p) => p.id === r.pistaId);
+    const socio = estado.socios.find((s) => s.id === r.socioId);
+    return [
+      r.id,
+      r.inicio.slice(0, 10),
+      r.inicio.slice(11, 16),
+      pista?.nombre ?? r.pistaId,
+      socio?.nombre ?? r.socioId,
+      socio?.email ?? "",
+      r.estado,
+      euros(r.importe),
+      euros(r.penalizacion),
+      r.notas,
+    ].map(campo).join(",");
+  };
+  const lineas = [CABECERA_CSV, ...reservas.map(fila)];
+  return new RespuestaCsv(`reservas-${f.desde}-${f.hasta}.csv`, lineas.map((l) => `${l}\r\n`).join(""));
+}
