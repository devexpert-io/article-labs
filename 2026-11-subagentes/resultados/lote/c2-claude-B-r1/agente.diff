@@ -0,0 +1,195 @@
+// Lista de espera de franjas (docs/specs/lista-espera.md), probada a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Franjas de la semilla:
+//   pista-1 2026-11-23T18:00: reservada por Irene (socio-004), lunes de punta (2800), cancelable gratis.
+//   pista-1 2026-11-21T15:00 y 16:30: reservadas por socio-009 y socio-015.
+//   pista-3 2026-11-19T09:00: reservada por Marta (socio-002), a 23 horas: solo se cancela con forzar.
+//   pista-2 2026-11-19T19:30: libre.
+//   pista-1 2026-11-22T10:30: reservada por Luis (socio-005), que tiene 2 reservas futuras.
+// Socios: socio-041 (Nora) sin reservas, socio-011 con la cuota sin pagar, socio-040 gestor.
+const LUNES = { pistaId: "pista-1", inicio: "2026-11-23T18:00" };
+const SABADO_15 = { pistaId: "pista-1", inicio: "2026-11-21T15:00" };
+const SABADO_1630 = { pistaId: "pista-1", inicio: "2026-11-21T16:30" };
+
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const apuntar = (api: Api, socio: string | undefined, cuerpo: unknown) => api.pedir("POST", "/api/esperas", { socio, cuerpo });
+
+test("apuntarse: 201 con la espera activa y su posición; sin X-Socio, 401", () => conApi(async (api) => {
+  const r = await apuntar(api, "socio-041", LUNES);
+  assert.equal(r.status, 201);
+  assert.deepEqual(
+    { ...r.cuerpo.espera, id: undefined },
+    { id: undefined, socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-23T18:00", estado: "activa", posicion: 1 },
+  );
+  assert.equal(typeof r.cuerpo.espera.id, "string");
+  const anonimo = await apuntar(api, undefined, LUNES);
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+}));
+
+test("solo se esperan franjas ocupadas, válidas y futuras, con la cuota al día", () => conApi(async (api) => {
+  const casos: [unknown, string, string, number][] = [
+    [{ pistaId: "pista-2", inicio: "2026-11-19T19:30" }, "socio-041", "FRANJA_LIBRE", 409],
+    [{ pistaId: "pista-9", inicio: "2026-11-23T18:00" }, "socio-041", "PISTA_NO_ENCONTRADA", 404],
+    [{ pistaId: "pista-4", inicio: "2026-11-23T18:00" }, "socio-041", "PISTA_CERRADA", 409],
+    [{ pistaId: "pista-1", inicio: "2026-11-23T18:15" }, "socio-041", "FRANJA_INVALIDA", 400],
+    [{ pistaId: "pista-1", inicio: "2026-11-18T09:00" }, "socio-041", "FRANJA_PASADA", 409],
+    [LUNES, "socio-011", "CUOTA_INACTIVA", 409],
+    [{ pistaId: "pista-1" }, "socio-041", "DATOS_INVALIDOS", 400],
+  ];
+  for (const [cuerpo, socio, codigo, http] of casos) {
+    const r = await apuntar(api, socio, cuerpo);
+    assert.equal(r.status, http, codigo);
+    assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+}));
+
+test("sin duplicados, sin esperar lo propio y como mucho 2 esperas activas", () => conApi(async (api) => {
+  assert.equal((await apuntar(api, "socio-041", LUNES)).status, 201);
+  const repetida = await apuntar(api, "socio-041", LUNES);
+  assert.equal(repetida.cuerpo.error.codigo, "YA_EN_ESPERA");
+  const propia = await apuntar(api, "socio-005", { pistaId: "pista-1", inicio: "2026-11-22T10:30" });
+  assert.equal(propia.status, 409);
+  assert.equal(propia.cuerpo.error.codigo, "YA_RESERVADA");
+  assert.equal((await apuntar(api, "socio-041", SABADO_15)).status, 201);
+  const tercera = await apuntar(api, "socio-041", SABADO_1630);
+  assert.equal(tercera.status, 409);
+  assert.equal(tercera.cuerpo.error.codigo, "LIMITE_DE_ESPERAS");
+}));
+
+test("posición por orden de llegada; GET lista las propias y un gestor, las de otro", () => conApi(async (api) => {
+  await apuntar(api, "socio-041", LUNES);
+  await apuntar(api, "socio-002", LUNES);
+  await apuntar(api, "socio-003", LUNES);
+  await apuntar(api, "socio-003", SABADO_15);
+  const mias = await api.pedir("GET", "/api/esperas", { socio: "socio-003" });
+  assert.equal(mias.status, 200);
+  assert.deepEqual(mias.cuerpo.esperas.map((e: any) => [e.inicio, e.posicion]), [["2026-11-23T18:00", 3], ["2026-11-21T15:00", 1]]);
+  const gestor = await api.pedir("GET", "/api/esperas?socio=socio-002", { socio: "socio-040" });
+  assert.deepEqual(gestor.cuerpo.esperas.map((e: any) => [e.socioId, e.posicion]), [["socio-002", 2]]);
+  const ajena = await api.pedir("GET", "/api/esperas?socio=socio-002", { socio: "socio-003" });
+  assert.equal(ajena.status, 403);
+  assert.equal(ajena.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("GET", "/api/esperas")).status, 401);
+}));
+
+test("retirarse: queda retirada, los de detrás suben y solo puede su dueño o un gestor", () => conApi(async (api) => {
+  const primera = (await apuntar(api, "socio-041", LUNES)).cuerpo.espera;
+  const segunda = (await apuntar(api, "socio-002", LUNES)).cuerpo.espera;
+  const tercera = (await apuntar(api, "socio-003", LUNES)).cuerpo.espera;
+  const ajena = await api.pedir("DELETE", `/api/esperas/${primera.id}`, { socio: "socio-002" });
+  assert.equal(ajena.status, 403);
+  assert.equal(ajena.cuerpo.error.codigo, "SIN_PERMISO");
+  const retirada = await api.pedir("DELETE", `/api/esperas/${primera.id}`, { socio: "socio-041" });
+  assert.equal(retirada.status, 200);
+  assert.equal(retirada.cuerpo.espera.estado, "retirada");
+  assert.equal(retirada.cuerpo.espera.posicion, undefined);
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-002" })).cuerpo.esperas[0].posicion, 1);
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-003" })).cuerpo.esperas[0].posicion, 2);
+  assert.deepEqual((await api.pedir("GET", "/api/esperas", { socio: "socio-041" })).cuerpo.esperas, []);
+  const porGestor = await api.pedir("DELETE", `/api/esperas/${segunda.id}`, { socio: "socio-040" });
+  assert.equal(porGestor.cuerpo.espera.estado, "retirada");
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-003" })).cuerpo.esperas[0].posicion, 1);
+  assert.ok(tercera.id);
+  const noExiste = await api.pedir("DELETE", "/api/esperas/E-9999", { socio: "socio-041" });
+  assert.equal(noExiste.status, 404);
+  assert.equal(noExiste.cuerpo.error.codigo, "ESPERA_NO_ENCONTRADA");
+  assert.equal((await api.pedir("DELETE", `/api/esperas/${tercera.id}`)).status, 401);
+}));
+
+test("al cancelar, la franja se asigna al primero de la lista", () => conApi(async (api) => {
+  const primera = (await apuntar(api, "socio-041", LUNES)).cuerpo.espera;
+  await apuntar(api, "socio-002", LUNES);
+  const irene = (await api.pedir("GET", "/api/reservas?socio=socio-004&fecha=2026-11-23&estado=confirmada")).cuerpo.reservas[0];
+  const cancelada = await api.pedir("POST", `/api/reservas/${irene.id}/cancelar`);
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+  const id = cancelada.cuerpo.asignadaA;
+  assert.equal(typeof id, "string");
+  const asignada = (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva;
+  assert.equal(asignada.socioId, "socio-041");
+  assert.equal(asignada.pistaId, "pista-1");
+  assert.equal(asignada.inicio, "2026-11-23T18:00");
+  assert.equal(asignada.fin, "2026-11-23T19:30");
+  assert.equal(asignada.estado, "confirmada");
+  assert.equal(asignada.importe, 2800);
+  assert.equal(asignada.importeBase, 2800);
+  assert.equal(asignada.descuento, 0);
+  assert.equal(asignada.codigo, undefined);
+  assert.equal(asignada.notas, "Asignada desde la lista de espera");
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.esperas.find((e: any) => e.id === primera.id).estado, "asignada");
+  // Marta sigue esperando y ahora es la primera.
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-002" })).cuerpo.esperas[0].posicion, 1);
+  assert.deepEqual((await api.pedir("GET", "/api/esperas", { socio: "socio-041" })).cuerpo.esperas, []);
+}));
+
+test("también se asigna al cancelar con forzar, y la penalización no cambia", () => conApi(async (api) => {
+  await apuntar(api, "socio-041", { pistaId: "pista-3", inicio: "2026-11-19T09:00" });
+  const marta = (await api.pedir("GET", "/api/reservas?socio=socio-002&fecha=2026-11-19")).cuerpo.reservas[0];
+  const sinForzar = await api.pedir("POST", `/api/reservas/${marta.id}/cancelar`);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await api.pedir("POST", `/api/reservas/${marta.id}/cancelar`, { cuerpo: { forzar: true } });
