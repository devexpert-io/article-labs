+  let instante = objetivo;
+  for (let i = 0; i < 3; i++) {
+    const partes = Object.fromEntries(formato.formatToParts(instante).map((p) => [p.type, p.value]));
+    const representado = Date.UTC(Number(partes.year), Number(partes.month) - 1, Number(partes.day), Number(partes.hour), Number(partes.minute));
+    instante += objetivo - representado;
+  }
+  return instante;
+}
