+// Reservas de 60, 90 o 120 minutos: validación, solapes, precio por minutos, disponibilidad y huecos.
+// Las fechas de estas pruebas (desde el 1 de diciembre) no tienen reservas en la semilla, salvo las
+// de 19 de noviembre que se usan para los solapes con reservas antiguas.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { importe } from "../src/semilla.ts";
+import type { Pista } from "../src/tipos.ts";
+
+let api: Api;
+// Reservas futuras confirmadas de cada socio elegible (cuota al día, rol socio). Se usa para no pasar del límite de tres.
+const cuenta: Record<string, number> = {};
+
+before(async () => {
+  api = await arrancarApi();
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  for (const s of estado.socios as { id: string; cuotaActiva: boolean; rol: string }[]) {
+    if (!s.cuotaActiva || s.rol !== "socio") continue;
+    cuenta[s.id] = (estado.reservas as { socioId: string; estado: string; inicio: string }[])
+      .filter((r) => r.socioId === s.id && r.estado === "confirmada" && r.inicio > estado.ahora).length;
+  }
+});
+after(() => api.cerrar());
+
+function elegir(): string {
+  const id = Object.keys(cuenta).find((s) => cuenta[s]! < 3);
+  assert.ok(id, "no quedan socios libres para la prueba");
+  return id;
+}
+
+async function reservar(cuerpo: Record<string, unknown>, socioId = elegir()) {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, ...cuerpo } });
+  if (respuesta.status === 201) cuenta[socioId] = cuenta[socioId]! + 1;
+  return respuesta;
+}
+
+test("la duración es 90 por defecto y 60, 90 o 120 son válidas", async () => {
+  const porDefecto = await reservar({ pistaId: "pista-1", inicio: "2026-12-01T09:00" });
+  assert.equal(porDefecto.status, 201);
+  assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+  assert.equal(porDefecto.cuerpo.reserva.fin, "2026-12-01T10:30");
+
+  const una = await reservar({ pistaId: "pista-1", inicio: "2026-12-01T12:00", duracion: 60 });
+  assert.equal(una.status, 201);
+  assert.equal(una.cuerpo.reserva.duracion, 60);
+  assert.equal(una.cuerpo.reserva.fin, "2026-12-01T13:00");
+
+  const dos = await reservar({ pistaId: "pista-1", inicio: "2026-12-01T14:00", duracion: 120 });
+  assert.equal(dos.status, 201);
+  assert.equal(dos.cuerpo.reserva.duracion, 120);
+  assert.equal(dos.cuerpo.reserva.fin, "2026-12-01T16:00");
+
+  const noventa = await reservar({ pistaId: "pista-1", inicio: "2026-12-01T16:30", duracion: 90 });
+  assert.equal(noventa.status, 201);
+  assert.equal(noventa.cuerpo.reserva.fin, "2026-12-01T18:00");
+});
+
+test("una duración distinta de 60, 90 o 120 responde 400 DURACION_INVALIDA", async () => {
+  for (const duracion of [45, 30, 0, 89.5, 150, "90", null, true]) {
+    const r = await reservar({ pistaId: "pista-1", inicio: "2026-12-02T10:00", duracion });
+    assert.equal(r.status, 400, `duracion ${JSON.stringify(duracion)}`);
+    assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA");
+  }
+});
+
+test("el inicio debe ser en punto o y media, no antes de las 09:00 y acabar como muy tarde a las 22:30", async () => {
+  const invalida = async (inicio: string, duracion: number) => {
+    const r = await reservar({ pistaId: "pista-3", inicio, duracion });
+    assert.equal(r.status, 400, `${inicio} de ${duracion}`);
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  };
+  await invalida("2026-12-02T10:15", 60);
+  await invalida("2026-12-02T08:30", 60);
+  await invalida("2026-12-02T22:00", 90);
+  await invalida("2026-12-02T21:00", 120);
