+test("el precio se calcula por minutos y cruza las 18:00 y el fin de semana", async () => {
+  // Martes, pistas 1 y 2 (valle 1800, punta 2800): 30 min de valle y 60 de punta. 2466,67 se cobra como 2467.
+  const cruza = await reservar({ pistaId: "pista-2", inicio: "2026-12-01T17:30", duracion: 90 });
+  assert.equal(cruza.cuerpo.reserva.importe, 2467);
+  // Martes a 60 minutos en valle, pista 3 (valle 1200): 60 x 1200 / 90 = 800.
+  const valle = await reservar({ pistaId: "pista-3", inicio: "2026-12-01T14:00", duracion: 60 });
+  assert.equal(valle.cuerpo.reserva.importe, 800);
+  // Miércoles, pista 3 (valle 1200, punta 2000): 16:30 a 18:30 son 90 min de valle y 30 de punta.
+  // (90 x 1200 + 30 x 2000) / 90 = 1866,67, que se cobra como 1867.
+  const cruzaDe120 = await reservar({ pistaId: "pista-3", inicio: "2026-12-02T16:30", duracion: 120 });
+  assert.equal(cruzaDe120.cuerpo.reserva.importe, 1867);
+  // Miércoles a partir de las 18:00 todo es punta: 120 x 2800 / 90 = 3733,33, que se cobra como 3733.
+  const puntaDe120 = await reservar({ pistaId: "pista-1", inicio: "2026-12-02T18:00", duracion: 120 });
+  assert.equal(puntaDe120.cuerpo.reserva.importe, 3733);
+  // Sábado es punta todo el día: 60 x 2000 / 90 = 1333,33, que se cobra como 1333.
+  const sabado = await reservar({ pistaId: "pista-3", inicio: "2026-12-05T10:00", duracion: 60 });
+  assert.equal(sabado.cuerpo.reserva.importe, 1333);
+  // Domingo, pista 1 a las 19:30: punta todo el día, 90 x 2800 / 90 = 2800.
+  const domingo = await reservar({ pistaId: "pista-1", inicio: "2026-12-06T19:30", duracion: 90 });
+  assert.equal(domingo.cuerpo.reserva.importe, 2800);
+});
