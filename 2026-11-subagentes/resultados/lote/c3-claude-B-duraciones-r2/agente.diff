+/** Los huecos libres de un día entre la apertura y el cierre, sin reservas confirmadas. Sin tener en cuenta la hora actual. */
+function huecosDelDia(estado: Estado, pistaId: string, fecha: string): { inicio: string; fin: string }[] {
+  const apertura = `${fecha}T${APERTURA}`;
+  const cierre = `${fecha}T${CIERRE}`;
+  const ocupadas = estado.reservas
+    .filter((r) => r.pistaId === pistaId && r.estado === "confirmada" && solapan(r.inicio, r.fin, apertura, cierre))
+    .sort((a, b) => (a.inicio < b.inicio ? -1 : a.inicio > b.inicio ? 1 : 0));
+  const huecos: { inicio: string; fin: string }[] = [];
+  let cursor = apertura;
+  for (const r of ocupadas) {
+    if (r.inicio > cursor) huecos.push({ inicio: cursor, fin: r.inicio });
+    if (r.fin > cursor) cursor = r.fin;
+  }
+  if (cierre > cursor) huecos.push({ inicio: cursor, fin: cierre });
+  return huecos;
+}
