+/** Intervalos [inicio, fin) que se solapan. Los textos AAAA-MM-DDTHH:MM se comparan en orden cronológico. */
+function solapan(inicioA: string, finA: string, inicioB: string, finB: string): boolean {
+  return inicioA < finB && inicioB < finA;
