diff --git a/test/codigos-descuento.test.ts b/test/codigos-descuento.test.ts
new file mode 100644
index 0000000..993b8d5
--- /dev/null
+++ b/test/codigos-descuento.test.ts
@@ -0,0 +1,119 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearClub, ErrorDelClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+const datos = (inicio = "2026-11-30T09:00", codigo?: unknown, socioId = "socio-041") => ({ socioId, pistaId: "pista-3", inicio, ...(codigo !== undefined ? { codigo } : {}) });
+const reservar = (api: Api, inicio?: string, codigo?: unknown, socioId?: string) => api.pedir("POST", "/api/reservas", { cuerpo: datos(inicio, codigo, socioId) });
+function error(r: { status: number; cuerpo: any }, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+test("sin código guarda desglose, se consulta y lista; la disponibilidad conserva el precio", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const antes = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-30&pista=pista-3");
+  const r = await reservar(api);
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.importeBase, 1200);
+  assert.equal(r.cuerpo.reserva.descuento, 0);
+  assert.equal(r.cuerpo.reserva.importe, 1200);
+  assert.equal(Object.hasOwn(r.cuerpo.reserva, "codigo"), false);
+  const consulta = await api.pedir("GET", `/api/reservas/${r.cuerpo.reserva.id}`);
+  const lista = await api.pedir("GET", "/api/reservas?socio=socio-041");
+  assert.deepEqual(consulta.cuerpo.reserva, r.cuerpo.reserva);
+  assert.deepEqual(lista.cuerpo.reservas, [r.cuerpo.reserva]);
+  const despues = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-30&pista=pista-3");
+  assert.equal(despues.cuerpo.pistas[0].franjas[0].precio, antes.cuerpo.pistas[0].franjas[0].precio);
+});
+
+test("BIENVENIDA: primera reserva y exclusión del historial incluso cancelado", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const r = await reservar(api, undefined, "bienvenida");
+  assert.equal(r.status, 201);
+  assert.deepEqual([r.cuerpo.reserva.importeBase, r.cuerpo.reserva.descuento, r.cuerpo.reserva.importe, r.cuerpo.reserva.codigo], [1200, 600, 600, "BIENVENIDA"]);
+  error(await reservar(api, "2026-11-30T10:30", "BIENVENIDA"), 409, "CODIGO_NO_APLICABLE");
+  await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`, { cuerpo: {} });
+  error(await reservar(api, "2026-11-30T10:30", "BIENVENIDA"), 409, "CODIGO_NO_APLICABLE");
+  error(await reservar(api, "2026-11-30T12:00", "BIENVENIDA", "socio-002"), 409, "CODIGO_NO_APLICABLE");
+});
+
+test("BIENVENIDA caduca por el reloj del club e incluye el 31 de diciembre completo", async (t) => {
+  const api = await arrancarApi({ AHORA: "2026-12-31T23:59" }); t.after(() => api.cerrar());
+  const r = await reservar(api, "2027-01-04T09:00", "BIENVENIDA");
+  assert.equal(r.status, 201);
+  const otra = await arrancarApi({ AHORA: "2027-01-01T00:00" }); t.after(() => otra.cerrar());
+  error(await reservar(otra, "2027-01-04T09:00", "BIENVENIDA"), 409, "CODIGO_NO_APLICABLE");
+});
+
+test("MANANAS admite lunes y viernes antes de las 12, rechaza mediodía y fines de semana", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  for (const inicio of ["2026-11-30T09:00", "2026-12-04T10:30"]) {
+    const r = await reservar(api, inicio, "MANANAS");
+    assert.equal(r.status, 201);
+    assert.deepEqual([r.cuerpo.reserva.descuento, r.cuerpo.reserva.importe], [400, 800]);
+  }
+  for (const inicio of ["2026-11-30T12:00", "2026-12-05T09:00", "2026-12-06T10:30"]) {
+    error(await reservar(api, inicio, "MANANAS"), 409, "CODIGO_NO_APLICABLE");
+  }
+  const disponibilidad = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-30&pista=pista-3");
+  assert.equal(disponibilidad.cuerpo.pistas[0].franjas[0].precio, 1200);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-01T08:00" } });
+  for (const inicio of ["2027-01-04T09:00", "2027-01-05T09:00"]) {
+    assert.equal((await reservar(api, inicio, "MANANAS")).status, 201);
+  }
+});
+
+test("CLUB10 normaliza el código, limita sus usos y libera usos cancelados", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  let primera = "";
+  for (let dia = 1; dia <= 3; dia++) {
+    const r = await reservar(api, `2026-12-0${dia}T18:00`, "  club10 ");
+    assert.equal(r.status, 201);
+    assert.deepEqual([r.cuerpo.reserva.importeBase, r.cuerpo.reserva.descuento, r.cuerpo.reserva.importe, r.cuerpo.reserva.codigo], [2000, 200, 1800, "CLUB10"]);
+    if (dia === 1) primera = r.cuerpo.reserva.id;
+  }
+  // Pasar las reservas evita que el límite de futuras oculte el límite del código.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-04T08:00" } });
+  error(await reservar(api, "2026-12-04T18:00", "CLUB10"), 409, "CODIGO_NO_APLICABLE");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:00" } });
+  assert.equal((await api.pedir("POST", `/api/reservas/${primera}/cancelar`, { cuerpo: {} })).status, 200);
+  assert.equal((await reservar(api, "2026-12-04T18:00", "CLUB10")).status, 201);
+});
+
+test("CLUB10 cuenta las no presentadas y BIENVENIDA también las excluye", () => {
+  const estado = crearSemilla();
+  const club = crearClub(estado);
+  for (let dia = 1; dia <= 3; dia++) {
+    club.crearReserva(datos(`2026-12-0${dia}T09:00`, "CLUB10")).reserva.estado = "no_presentada";
+  }
+  for (const codigo of ["CLUB10", "BIENVENIDA"]) {
+    assert.throws(() => club.crearReserva(datos("2026-12-04T09:00", codigo)), (e) => e instanceof ErrorDelClub && e.codigo === "CODIGO_NO_APLICABLE");
+  }
+});
+
+test("formato de código: desconocidos, vacíos y múltiples; exige texto", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  for (const codigo of ["NOEXISTE", "", "CLUB10,MANANAS"]) error(await reservar(api, undefined, codigo), 400, "CODIGO_INVALIDO");
+  for (const codigo of [null, 10, false, ["CLUB10", "MANANAS"], { codigo: "CLUB10" }]) error(await reservar(api, undefined, codigo), 400, "DATOS_INVALIDOS");
+  assert.equal((await reservar(api, undefined, "BIENVENIDA")).status, 201);
+});
+
+test("las reglas del club prevalecen sobre código inválido y no consumen usos", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  for (const codigo of [null, "NOEXISTE", "BIENVENIDA"]) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { ...datos(undefined, codigo), pistaId: "pista-4" } });
+    error(r, 409, "PISTA_CERRADA");
+  }
+  assert.equal((await reservar(api, undefined, "BIENVENIDA")).status, 201);
+});
+
+test("cancelación fuera de plazo penaliza solo el importe descontado", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const r = await reservar(api, undefined, "MANANAS");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-29T10:00" } });
+  const cancelacion = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelacion.status, 200);
+  assert.equal(cancelacion.cuerpo.reserva.penalizacion, 800);
+});
