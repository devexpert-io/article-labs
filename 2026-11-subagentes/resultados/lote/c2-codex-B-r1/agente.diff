+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado } from "../src/tipos.ts";
+
+let api: Api;
+const gestor = { socio: "socio-040" };
+const cabecera = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+before(async () => { api = await arrancarApi(); });
+after(() => api.cerrar());
+
+const exportar = (consulta: string) => api.pedir("GET", `/api/reservas/exportar?${consulta}`, gestor);
+
+test("CSV: solo los gestores pueden exportar", async () => {
+  for (const [socio, status, codigo] of [
+    [undefined, 401, "NO_IDENTIFICADO"], ["socio-041", 403, "SIN_PERMISO"],
+    ["socio-inexistente", 401, "NO_IDENTIFICADO"],
+  ] as const) {
+    const respuesta = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-31", { socio });
+    assert.equal(respuesta.status, status);
+    assert.equal(respuesta.cuerpo.error.codigo, codigo);
+  }
+});
+
+test("CSV: cabeceras HTTP, filas completas ordenadas y CRLF, sin alterar el listado JSON", async () => {
+  const consulta = "desde=2026-10-01&hasta=2026-10-31";
+  const listadoAntes = await api.pedir("GET", `/api/reservas?${consulta}&limite=2&pagina=2`);
+  const respuesta = await exportar(consulta);
+  assert.equal(respuesta.status, 200);
+  assert.equal(respuesta.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(respuesta.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-10-31.csv"');
+  assert.ok(respuesta.texto.endsWith("\r\n"));
+  assert.ok(!/(?<!\r)\n|\r(?!\n)/.test(respuesta.texto));
+  const lineas = respuesta.texto.split("\r\n");
+  assert.equal(lineas.shift(), cabecera);
+  assert.equal(lineas.pop(), "");
+  assert.equal(lineas.length, 315, "exporta más de una página de 100 reservas");
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const esperadas = estado.reservas.filter((r) => r.inicio >= "2026-10-01" && r.inicio < "2026-11-01")
+    .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.pistaId.localeCompare(b.pistaId));
+  assert.deepEqual(lineas.map((l) => l.split(",")[0]), esperadas.map((r) => r.id));
+  assert.ok(esperadas.some((r) => r.inicio.startsWith("2026-10-01")));
+  assert.ok(esperadas.some((r) => r.inicio.startsWith("2026-10-31")));
+  const primera = esperadas[0]!;
+  const socio = estado.socios.find((s) => s.id === primera.socioId)!;
+  const pista = estado.pistas.find((p) => p.id === primera.pistaId)!;
+  assert.equal(lineas[0], `${primera.id},${primera.inicio.slice(0, 10)},${primera.inicio.slice(11)},${pista.nombre},${socio.nombre},${socio.email},${primera.estado},${(primera.importe / 100).toFixed(2)},,`);
+  assert.deepEqual((await api.pedir("GET", `/api/reservas?${consulta}&limite=2&pagina=2`)).cuerpo, listadoAntes.cuerpo);
+});
+
+test("CSV: valida fechas obligatorias, reales, orden y máximo de 92 días inclusivos", async () => {
+  for (const consulta of ["", "desde=2026-10-01", "hasta=2026-10-31", "desde=&hasta=2026-10-31",
+    "desde=01-10-2026&hasta=2026-10-31", "desde=2026-10-01&hasta=2026-11-31",
+    "desde=2026-02-29&hasta=2026-03-01", "desde=2026-10-32&hasta=2026-11-01",
+    "desde=2026-10-02&hasta=2026-10-01"]) {
+    const respuesta = await exportar(consulta);
+    assert.equal(respuesta.status, 400, consulta);
+    assert.equal(respuesta.cuerpo.error.codigo, "DATOS_INVALIDOS", consulta);
+  }
+  assert.equal((await exportar("desde=2026-10-01&hasta=2026-12-31")).status, 200);
+  assert.equal((await exportar("desde=2028-02-29&hasta=2028-02-29")).status, 200);
+  const demasiado = await exportar("desde=2026-10-01&hasta=2027-01-01");
+  assert.equal(demasiado.status, 400);
+  assert.equal(demasiado.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+});
+
+test("CSV: filtra cada estado y rechaza estados desconocidos o vacíos", async () => {
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  for (const filtro of ["confirmada", "cancelada", "no_presentada"] as const) {
+    const respuesta = await exportar(`desde=2026-10-01&hasta=2026-10-31&estado=${filtro}`);
+    assert.equal(respuesta.status, 200);
+    const lineas = respuesta.texto.split("\r\n").slice(1, -1);
+    assert.equal(lineas.length, estado.reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado === filtro).length);
+    assert.ok(lineas.length > 0);
+    assert.ok(lineas.every((l) => l.split(",")[6] === filtro));
+  }
+  for (const filtro of ["desconocido", ""]) {
+    const respuesta = await exportar(`desde=2026-10-01&hasta=2026-10-31&estado=${filtro}`);
+    assert.equal(respuesta.status, 400);
+    assert.equal(respuesta.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await exportar("desde=2028-01-01&hasta=2028-01-01")).texto, cabecera + "\r\n");
+});
+
+test("CSV: escapa comas, comillas y saltos, ordena reservas nuevas y expresa penalización en euros", async () => {
+  const notas = ['Trae, bolas', 'Dice "hola"', "Primera línea\r\nSegunda línea"];
+  const reservas = [];
+  for (const [indice, pista] of ["pista-3", "pista-2", "pista-1"].entries()) {
+    const creada = await api.pedir("POST", "/api/reservas", { cuerpo: {
+      socioId: "socio-041", pistaId: pista, inicio: "2026-12-01T09:00", notas: notas[indice],
+    } });
+    assert.equal(creada.status, 201);
+    reservas.push(creada.cuerpo.reserva);
+  }
+  const respuesta = await exportar("desde=2026-12-01&hasta=2026-12-01");
+  assert.equal(respuesta.texto, cabecera + "\r\n" +
+    `${reservas[2].id},2026-12-01,09:00,Pista 1,Nora Benítez,nora.benitez@example.com,confirmada,18.00,,"Primera línea\r\nSegunda línea"\r\n` +
+    `${reservas[1].id},2026-12-01,09:00,Pista 2,Nora Benítez,nora.benitez@example.com,confirmada,18.00,,"Dice ""hola"""\r\n` +
+    `${reservas[0].id},2026-12-01,09:00,Pista 3,Nora Benítez,nora.benitez@example.com,confirmada,12.00,,"Trae, bolas"\r\n`);
+  const cancelada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  const penalizada = await exportar("desde=2026-11-19&hasta=2026-11-19&estado=cancelada");
+  assert.ok(penalizada.texto.includes("R-0520,2026-11-19,09:00,Pista 3,Marta López,marta.lopez@example.com,cancelada,12.00,12.00,\r\n"));
+});
