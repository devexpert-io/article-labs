+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi } from "./ayuda.ts";
+
+test("descuentos, lista de espera y CSV conservan los importes al cancelar y reasignar", async () => {
+  const api = await arrancarApi();
+  try {
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T09:00", codigo: "MANANAS" },
+    });
+    assert.equal(creada.status, 201);
+    const original = creada.cuerpo.reserva;
+    assert.equal(original.importeBase, 1800);
+    assert.equal(original.descuento, 400);
+    assert.equal(original.importe, 1400);
+
+    const espera = await api.pedir("POST", "/api/esperas", {
+      socio: "socio-004", cuerpo: { pistaId: "pista-1", inicio: original.inicio },
+    });
+    assert.equal(espera.status, 201);
+    const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T08:00" } });
+    assert.equal(reloj.status, 200);
+    const cancelada = await api.pedir("POST", `/api/reservas/${original.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 1400);
+    assert.equal(typeof cancelada.cuerpo.asignadaA, "string");
+
+    const asignada = await api.pedir("GET", `/api/reservas/${cancelada.cuerpo.asignadaA}`);
+    assert.equal(asignada.status, 200);
+    assert.equal(asignada.cuerpo.reserva.socioId, "socio-004");
+    assert.equal(asignada.cuerpo.reserva.importeBase, 1800);
+    assert.equal(asignada.cuerpo.reserva.descuento, 0);
+    assert.equal(asignada.cuerpo.reserva.importe, 1800);
+    assert.equal(asignada.cuerpo.reserva.codigo, undefined);
+    assert.equal(asignada.cuerpo.reserva.notas, "Asignada desde la lista de espera");
+    const esperas = await api.pedir("GET", "/api/esperas", { socio: "socio-004" });
+    assert.deepEqual(esperas.cuerpo.esperas, []);
+
+    const csv = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-26&hasta=2026-11-26", { socio: "socio-040" });
+    assert.equal(csv.status, 200);
+    const filas = csv.texto.trimEnd().split("\r\n").slice(1).map((linea) => linea.split(","));
+    assert.equal(filas.length, 2);
+    assert.deepEqual(filas.find((fila) => fila[0] === original.id)?.slice(6, 9), ["cancelada", "14.00", "14.00"]);
+    assert.deepEqual(filas.find((fila) => fila[0] === cancelada.cuerpo.asignadaA)?.slice(6, 10),
+      ["confirmada", "18.00", "", "Asignada desde la lista de espera"]);
+  } finally {
+    api.cerrar();
+  }
+});
