+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const franja = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+const apuntar = (api: Api, socio = "socio-041", cuerpo = franja) => api.pedir("POST", "/api/esperas", { socio, cuerpo });
+async function error(api: Api, cuerpo: unknown, codigo: string, status = 409, socio = "socio-041") {
+  const r = await api.pedir("POST", "/api/esperas", { socio, cuerpo });
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+test("esperas: identidad, validaciones, duplicados y límite", async () => {
+  const api = await arrancarApi();
+  try {
+    for (const metodo of ["GET", "POST", "DELETE"]) {
+      const r = await api.pedir(metodo, `/api/esperas${metodo === "DELETE" ? "/E-0001" : ""}`);
+      assert.equal(r.status, 401);
+      assert.equal(r.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    }
+    await error(api, { ...franja, pistaId: "ausente" }, "PISTA_NO_ENCONTRADA", 404);
