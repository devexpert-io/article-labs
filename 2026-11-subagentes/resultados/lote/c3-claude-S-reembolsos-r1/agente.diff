+test("informe de caja: solo para gestores, por pista y para todo el club", async () => {
+  const otra = await arrancarApi();
+  try {
+    const anonimo = await otra.pedir("GET", "/api/informes/caja?mes=2026-11");
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await otra.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-041" });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+    for (const mes of ["", "2026-13", "2026-1", "noviembre", "2026-11-01"]) {
+      const mal = await otra.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: GESTOR });
+      assert.equal(mal.status, 400, mes);
+      assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    assert.equal((await otra.pedir("GET", "/api/informes/caja", { socio: GESTOR })).status, 400);
+
+    // Una cancelación con penalización en noviembre: R-0520 (pista 3, faltan 23 horas) con forzar, 600 de penalización.
+    assert.equal((await otra.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } })).cuerpo.reserva.penalizacion, 600);
+
+    const informe = await otra.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR });
+    assert.equal(informe.status, 200);
+    const reservas = (await otra.pedir("GET", "/_estado")).cuerpo.reservas as any[];
+    const delMes = reservas.filter((r) => r.inicio.startsWith("2026-11"));
+    const esperado = (pistaId?: string) => {
+      const suyas = delMes.filter((r) => !pistaId || r.pistaId === pistaId);
+      const cobradas = suyas.filter((r) => r.estado === "confirmada" || r.estado === "no_presentada");
+      const ingresos = cobradas.reduce((s, r) => s + r.importe, 0);
+      const penalizaciones = suyas.filter((r) => r.estado === "cancelada").reduce((s, r) => s + (r.penalizacion ?? 0), 0);
+      return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    };
+    assert.equal(informe.cuerpo.mes, "2026-11");
+    assert.deepEqual(informe.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+    for (const p of informe.cuerpo.pistas) assert.deepEqual(p, { pistaId: p.pistaId, ...esperado(p.pistaId) });
+    assert.deepEqual(informe.cuerpo.total, esperado());
+    assert.equal(informe.cuerpo.pistas.find((p: any) => p.pistaId === "pista-3").penalizaciones, 600);
+    assert.equal(informe.cuerpo.total.penalizaciones, 600);
+    assert.ok(informe.cuerpo.total.reservas > 0);
+
+    // Un mes sin movimientos: todas las pistas, a cero.
+    const vacio = await otra.pedir("GET", "/api/informes/caja?mes=2030-01", { socio: GESTOR });
+    assert.equal(vacio.cuerpo.pistas.length, 4);
+    for (const p of vacio.cuerpo.pistas) assert.deepEqual(p, { pistaId: p.pistaId, reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+    assert.deepEqual(vacio.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+  } finally {
+    otra.cerrar();
+  }
+});
