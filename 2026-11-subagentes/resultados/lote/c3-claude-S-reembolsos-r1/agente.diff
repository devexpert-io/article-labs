+// Penalizaciones escalonadas, exención por un gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const GESTOR = "socio-040";
+
+/** Pone el reloj del club, crea una reserva y la cancela con esos datos. */
+async function cancelarCon(ahora: string, pistaId: string, inicio: string, cuerpo?: unknown, socio?: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId, inicio } });
+  assert.equal(creada.status, 201, JSON.stringify(creada.cuerpo));
+  const id = creada.cuerpo.reserva.id as string;
+  const respuesta = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+  return { id, importe: creada.cuerpo.reserva.importe as number, respuesta };
+}
+
+test("tramos: 48 h o más gratis, de 24 a 48 h un 25 %, menos de 24 h solo con forzar y un 50 %", async () => {
+  // Importe de valle en pista 3: 1200.
+  const gratis = await cancelarCon("2027-01-04T09:00", "pista-3", "2027-01-07T09:00");
+  assert.equal(gratis.respuesta.status, 200);
+  assert.equal(gratis.respuesta.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.respuesta.cuerpo.reembolso, 1200);
+
+  const reducida = await cancelarCon("2027-01-04T09:00", "pista-3", "2027-01-05T15:00");
+  assert.equal(reducida.respuesta.status, 200);
+  assert.equal(reducida.respuesta.cuerpo.reserva.penalizacion, 300);
+  assert.equal(reducida.respuesta.cuerpo.reembolso, 900);
+
+  const fuera = await cancelarCon("2027-01-04T09:00", "pista-3", "2027-01-04T15:00");
+  assert.equal(fuera.respuesta.status, 409);
+  assert.equal(fuera.respuesta.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await api.pedir("POST", `/api/reservas/${fuera.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+  assert.equal(forzada.cuerpo.reembolso, 600);
+});
+
+test("límites exactos: a 48 h justas no hay penalización y a 24 h justas se aplica el 25 % sin forzar", async () => {
+  const a48 = await cancelarCon("2027-01-11T09:00", "pista-2", "2027-01-13T09:00");
+  assert.equal(a48.respuesta.status, 200);
+  assert.equal(a48.respuesta.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(a48.respuesta.cuerpo.reembolso, 1800);
+
+  const pocoMenos48 = await cancelarCon("2027-01-11T09:01", "pista-2", "2027-01-13T09:00");
+  assert.equal(pocoMenos48.respuesta.cuerpo.reserva.penalizacion, 450, "47 h 59 min ya es el tramo del 25 %");
+
+  const a24 = await cancelarCon("2027-01-11T09:00", "pista-2", "2027-01-12T09:00");
+  assert.equal(a24.respuesta.status, 200);
+  assert.equal(a24.respuesta.cuerpo.reserva.penalizacion, 450);
+  assert.equal(a24.respuesta.cuerpo.reembolso, 1350);
+
+  const pocoMenos24 = await cancelarCon("2027-01-11T09:01", "pista-2", "2027-01-12T09:00");
+  assert.equal(pocoMenos24.respuesta.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+});
+
+test("cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales.
+  const primavera = await cancelarCon("2027-03-26T20:30", "pista-1", "2027-03-28T21:00");
+  assert.equal(primavera.respuesta.status, 200);
+  assert.equal(primavera.importe, 2800);
+  assert.equal(primavera.respuesta.cuerpo.reserva.penalizacion, 700);
+  assert.equal(primavera.respuesta.cuerpo.reembolso, 2100);
+
+  // En otoño los relojes se retrasan: del viernes 29 de octubre de 2027 a las 21:30 al domingo 31 a las 21:00 hay 48,5 horas.
+  const otono = await cancelarCon("2027-10-29T21:30", "pista-1", "2027-10-31T21:00");
+  assert.equal(otono.respuesta.status, 200);
+  assert.equal(otono.respuesta.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(otono.respuesta.cuerpo.reembolso, 2800);
+
+  // Y del sábado 30 a las 21:30 al domingo 31 a las 21:00 hay 24,5 horas, no 23,5.
+  const otono24 = await cancelarCon("2027-10-30T21:30", "pista-2", "2027-10-31T21:00");
+  assert.equal(otono24.respuesta.status, 200);
+  assert.equal(otono24.respuesta.cuerpo.reserva.penalizacion, 700);
+});
+
+test("exención: un gestor cancela sin penalización con un motivo de al menos 10 caracteres", async () => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-01T09:00" } });
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2027-02-01T10:30" } });
+  const id = creada.cuerpo.reserva.id;
+  const ruta = `/api/reservas/${id}/cancelar`;
+  const motivo = "Lesión justificada con parte médico";
+
+  const anonimo = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo } });
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo }, socio: "socio-041" });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const sinMotivo = await api.pedir("POST", ruta, { cuerpo: { exento: true }, socio: GESTOR });
+  assert.equal(sinMotivo.status, 400);
+  assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const corto = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo: "lesión" }, socio: GESTOR });
+  assert.equal(corto.status, 400);
+  assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva.estado, "confirmada");
+
+  // A hora y media del inicio, sin forzar.
+  const exenta = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo }, socio: GESTOR });
+  assert.equal(exenta.status, 200);
+  assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+  assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(exenta.cuerpo.reserva.motivoCancelacion, motivo);
+  assert.equal(exenta.cuerpo.reembolso, 1200);
+});
+
+test("reservas pasadas: no se cancelan, tampoco con exento", async () => {
