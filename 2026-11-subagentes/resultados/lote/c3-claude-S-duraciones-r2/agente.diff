+test("disponibilidad: una franja está reservada si cualquier reserva confirmada se solapa con ella", async () => {
+  const fecha = "2026-12-03";
+  const r = await reservar({ pistaId: "pista-2", inicio: `${fecha}T10:00`, duracion: 60 });
+  assert.equal(r.status, 201);
+  const estados = async () => {
+    const dia = (await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=pista-2`)).cuerpo;
+    return Object.fromEntries(dia.pistas[0].franjas.map((f: any) => [f.inicio.slice(11), f.estado]));
+  };
+  const ocupadas = await estados();
+  assert.equal(ocupadas["09:00"], "reservada");
+  assert.equal(ocupadas["10:30"], "reservada");
+  assert.equal(ocupadas["12:00"], "libre");
+  const dia = (await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=pista-2`)).cuerpo;
+  assert.equal(dia.pistas[0].franjas.length, 9);
+  await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+  const libres = await estados();
+  assert.ok(Object.values(libres).every((e) => e === "libre"));
+});
