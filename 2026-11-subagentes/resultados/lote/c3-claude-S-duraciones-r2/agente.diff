+test("disponibilidad: huecos libres más largos posibles, ordenados, sin mirar la hora actual; una pista cerrada no tiene", async () => {
+  const fecha = "2026-12-04";
+  const huecos = async (pista: string) =>
+    (await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pista}`)).cuerpo.pistas[0].huecos;
+  assert.deepEqual(await huecos("pista-1"), [{ inicio: `${fecha}T09:00`, fin: `${fecha}T22:30` }]);
+
+  const a = await reservar({ pistaId: "pista-1", inicio: `${fecha}T12:00`, duracion: 60 });
+  const b = await reservar({ pistaId: "pista-1", inicio: `${fecha}T13:00`, duracion: 90 });
+  const c = await reservar({ socioId: "socio-006", pistaId: "pista-1", inicio: `${fecha}T21:30`, duracion: 60 });
+  const d = await reservar({ socioId: "socio-006", pistaId: "pista-1", inicio: `${fecha}T09:00`, duracion: 60 });
+  const cancelada = await reservar({ socioId: "socio-006", pistaId: "pista-1", inicio: `${fecha}T17:00`, duracion: 120 });
+  await api.pedir("POST", `/api/reservas/${cancelada.cuerpo.reserva.id}/cancelar`);
+  assert.deepEqual(await huecos("pista-1"), [
+    { inicio: `${fecha}T10:00`, fin: `${fecha}T12:00` },
+    { inicio: `${fecha}T14:30`, fin: `${fecha}T21:30` },
+  ]);
+  for (const r of [a, b, c, d]) await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+
+  // Pista cerrada: sin huecos.
+  const cerrada = (await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`)).cuerpo.pistas.find((p: any) => p.pistaId === "pista-4");
+  assert.deepEqual(cerrada.huecos, []);
+
+  // Con reservas antiguas: jueves 19, pista 1, ocupada de 12:00 a 13:30, de 18:00 a 19:30 y de 19:30 a 21:00, entre otras.
+  const jueves = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-19&pista=pista-1")).cuerpo.pistas[0];
+  const confirmadas = (await api.pedir("GET", "/api/reservas?fecha=2026-11-19&pista=pista-1&estado=confirmada")).cuerpo.reservas;
+  for (const h of jueves.huecos) {
+    assert.ok(h.inicio < h.fin);
+    for (const r of confirmadas) assert.ok(!(r.inicio < h.fin && h.inicio < r.fin), `${h.inicio}-${h.fin} se solapa con ${r.id}`);
+  }
+  for (let i = 1; i < jueves.huecos.length; i++) assert.ok(jueves.huecos[i - 1].fin < jueves.huecos[i].inicio);
+  assert.ok(!jueves.huecos.some((h: any) => h.inicio < "2026-11-19T21:00" && h.fin > "2026-11-19T18:00"));
+  assert.ok(jueves.huecos.some((h: any) => h.inicio === "2026-11-19T21:00"));
+
+  // Hoy, aunque ya sean las 10:00, el primer hueco de la pista 1 empieza a las 09:00.
+  const hoy = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-18&pista=pista-1")).cuerpo.pistas[0];
+  assert.equal(hoy.huecos[0].inicio, "2026-11-18T09:00");
+});
