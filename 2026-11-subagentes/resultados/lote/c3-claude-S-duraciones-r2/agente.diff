+export const DURACIONES = [60, 90, 120];
+export const DURACION_POR_DEFECTO = 90;
+export const APERTURA = "09:00";
+export const CIERRE = "22:30";
+const INICIO_PUNTA = 18 * 60;
+
+/** Minutos desde medianoche de una hora `HH:MM`. */
+function minutosDelDia(hora: string): number {
+  const [h, m] = hora.split(":").map(Number);
+  return h! * 60 + m!;
+}
+
+function aFechaHora(fecha: string, minutos: number): string {
+  return `${fecha}T${String(Math.floor(minutos / 60)).padStart(2, "0")}:${String(minutos % 60).padStart(2, "0")}`;
+}
+
+/** Duración en minutos de una reserva (todas empiezan y terminan el mismo día). */
+function duracionDe(r: Reserva): number {
+  return minutosDelDia(r.fin.slice(11)) - minutosDelDia(r.inicio.slice(11));
+}
+
+function conDuracion(r: Reserva): Reserva & { duracion: number } {
+  return { ...r, duracion: duracionDe(r) };
+}
+
+/** Precio por minutos: cada minuto vale el precio de su franja de 90 minutos entre 90. Redondeo al céntimo, medio hacia arriba. */
+function importePorMinutos(p: Pista, inicio: string, duracion: number): number {
+  const dia = diaDeLaSemana(inicio.slice(0, 10));
+  const finDeSemana = dia === 0 || dia === 6;
+  const desde = minutosDelDia(inicio.slice(11));
+  const hasta = desde + duracion;
+  const valle = finDeSemana ? 0 : Math.max(0, Math.min(hasta, INICIO_PUNTA) - desde);
+  const punta = duracion - valle;
+  const noventaVeces = valle * p.precioValle + punta * p.precioPunta;
+  return Math.floor((2 * noventaVeces + 90) / 180);
+}
 
