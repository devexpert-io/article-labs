+++ b/test/duraciones.test.ts
@@ -0,0 +1,245 @@
+// Reservas de 60, 90 o 120 minutos (docs/specs/duraciones.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const HORAS = ["09:00", "10:30", "12:00", "13:30", "15:00", "16:30", "18:00", "19:30", "21:00"];
+
+async function reservar(cuerpo: Record<string, unknown>) {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", ...cuerpo } });
+}
+
+/** Reserva y la cancela enseguida (gratis, con más de 24 horas), para no agotar el límite de reservas futuras. */
+async function reservarYCancelar(cuerpo: Record<string, unknown>) {
+  const r = await reservar(cuerpo);
+  if (r.status === 201) {
+    const c = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+    assert.equal(c.status, 200);
+  }
+  return r;
+}
+
+test("duracion: 60, 90 o 120 minutos, 90 por defecto; cualquier otro valor es DURACION_INVALIDA", async () => {
+  for (const duracion of [60, 90, 120]) {
+    const r = await reservarYCancelar({ pistaId: "pista-1", inicio: "2026-12-01T12:00", duracion });
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.duracion, duracion);
+  }
+  const porDefecto = await reservarYCancelar({ pistaId: "pista-1", inicio: "2026-12-01T12:00" });
+  assert.equal(porDefecto.status, 201);
+  assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+  assert.equal(porDefecto.cuerpo.reserva.fin, "2026-12-01T13:30");
+  for (const duracion of [45, 30, 150, 0, -60, 90.5, "60", null, true]) {
+    const r = await reservar({ pistaId: "pista-1", inicio: "2026-12-01T12:00", duracion });
+    assert.equal(r.status, 400, `duracion ${JSON.stringify(duracion)}`);
+    assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA");
+  }
+});
+
+test("inicios válidos: en punto o y media, desde las 09:00 y terminando como muy tarde a las 22:30", async () => {
+  const validos: [string, number][] = [["09:00", 120], ["09:30", 60], ["11:00", 90], ["21:30", 60], ["21:00", 90], ["20:30", 120]];
+  for (const [hora, duracion] of validos) {
+    const r = await reservarYCancelar({ pistaId: "pista-2", inicio: `2026-12-01T${hora}`, duracion });
+    assert.equal(r.status, 201, `${hora} ${duracion}`);
+  }
+  const invalidos: [string, number][] = [
+    ["08:30", 60], ["08:00", 120], ["09:15", 60], ["10:45", 90], ["22:00", 60], ["21:30", 90], ["21:00", 120], ["22:30", 60], ["23:00", 60],
+  ];
+  for (const [hora, duracion] of invalidos) {
+    const r = await reservar({ pistaId: "pista-2", inicio: `2026-12-01T${hora}`, duracion });
+    assert.equal(r.status, 400, `${hora} ${duracion}`);
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  }
+  const malFormato = await reservar({ pistaId: "pista-2", inicio: "2026-12-01 10:00", duracion: 60 });
+  assert.equal(malFormato.cuerpo.error.codigo, "FRANJA_INVALIDA");
+});
+
+test("fin es inicio más la duración", async () => {
+  const casos: [string, number, string][] = [["10:00", 60, "11:00"], ["10:30", 90, "12:00"], ["17:30", 120, "19:30"], ["21:30", 60, "22:30"]];
+  for (const [hora, duracion, fin] of casos) {
+    const r = await reservarYCancelar({ pistaId: "pista-3", inicio: `2026-12-01T${hora}`, duracion });
+    assert.equal(r.cuerpo.reserva.inicio, `2026-12-01T${hora}`);
+    assert.equal(r.cuerpo.reserva.fin, `2026-12-01T${fin}`);
+  }
+});
+
+test("sin solapes con reservas confirmadas, nuevas o antiguas; tocarse no es solaparse y las canceladas no ocupan", async () => {
+  // Reserva antigua: pista 1, jueves 19 de 19:30 a 21:00 (y de 18:00 a 19:30).
+  for (const [hora, duracion] of [["20:30", 60], ["19:00", 60], ["20:00", 120], ["19:30", 90], ["18:30", 120]] as const) {
+    const r = await reservar({ pistaId: "pista-1", inicio: `2026-11-19T${hora}`, duracion });
+    assert.equal(r.status, 409, `${hora} ${duracion}`);
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  }
+  const justoDespues = await reservarYCancelar({ pistaId: "pista-1", inicio: "2026-11-19T21:00", duracion: 60 });
+  assert.equal(justoDespues.status, 201);
+
+  // Reservas nuevas entre sí.
+  const nueva = await reservar({ pistaId: "pista-2", inicio: "2026-12-02T12:00", duracion: 120 });
+  assert.equal(nueva.status, 201);
+  for (const [hora, duracion] of [["11:30", 60], ["13:30", 60], ["11:00", 90], ["12:30", 60]] as const) {
+    const r = await reservar({ pistaId: "pista-2", inicio: `2026-12-02T${hora}`, duracion });
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE", `${hora} ${duracion}`);
+  }
+  const antes = await reservarYCancelar({ pistaId: "pista-2", inicio: "2026-12-02T11:00", duracion: 60 });
+  assert.equal(antes.status, 201);
+  const despues = await reservarYCancelar({ pistaId: "pista-2", inicio: "2026-12-02T14:00", duracion: 90 });
+  assert.equal(despues.status, 201);
+  const otraPista = await reservarYCancelar({ pistaId: "pista-3", inicio: "2026-12-02T12:30", duracion: 60 });
+  assert.equal(otraPista.status, 201);
+
+  // Al cancelarla, deja la pista libre.
+  await api.pedir("POST", `/api/reservas/${nueva.cuerpo.reserva.id}/cancelar`);
+  const libre = await reservarYCancelar({ pistaId: "pista-2", inicio: "2026-12-02T12:30", duracion: 60 });
+  assert.equal(libre.status, 201);
+});
+
+test("precio por minutos, con su redondeo, al cruzar las 18:00 y en fin de semana", async () => {
+  const casos: [string, string, number, number][] = [
+    // Martes: 30 min de valle y 60 de punta = 600 + 1866,67.
+    ["pista-1", "2026-12-01T17:30", 90, 2467],
+    // Martes: 60 de valle + 60 de punta = 1200 + 1866,67.
+    ["pista-1", "2026-12-01T17:00", 120, 3067],
+    // Martes, todo valle y todo punta.
+    ["pista-1", "2026-12-01T10:00", 60, 1200],
+    ["pista-1", "2026-12-01T19:00", 120, 3733],
+    ["pista-3", "2026-12-01T17:30", 60, 1067],
+    ["pista-3", "2026-12-01T16:00", 120, 1600],
