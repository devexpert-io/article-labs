@@ -0,0 +1,189 @@
+// Penalizaciones escalonadas, exención de gestor e informe de caja.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+const GESTOR = "socio-040";
+const SOCIO = "socio-001";
+const NUEVA = "socio-041";
+
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+async function moverReloj(ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200, r.texto);
+}
+
+async function crear(socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.reserva as { id: string; importe: number };
+}
+
+test("tramos: sin penalización con 48 horas o más, 25 % entre 24 y 48 y 50 % por debajo de 24", async () => {
+  await moverReloj("2026-11-18T10:00");
+
+  const lejana = await crear(NUEVA, "pista-1", "2026-11-22T12:00");
+  const gratis = await api.pedir("POST", `/api/reservas/${lejana.id}/cancelar`);
+  assert.equal(gratis.status, 200);
+  assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.cuerpo.reembolso, lejana.importe);
+
+  // Jueves 19 a las 18:00: faltan 32 horas, tramo del 25 %.
+  const media = await crear(NUEVA, "pista-3", "2026-11-19T18:00");
+  const reducida = await api.pedir("POST", `/api/reservas/${media.id}/cancelar`);
+  assert.equal(reducida.status, 200, reducida.texto);
+  assert.equal(reducida.cuerpo.reserva.penalizacion, Math.round(media.importe * 0.25));
+  assert.equal(reducida.cuerpo.reembolso, media.importe - Math.round(media.importe * 0.25));
+
+  // R-0520 empieza en menos de 24 horas: sin forzar no se cancela.
+  const fuera = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+  assert.equal(fuera.status, 409);
+  assert.equal(fuera.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const sigue = (await api.pedir("GET", "/api/reservas/R-0520")).cuerpo.reserva;
+  assert.equal(sigue.estado, "confirmada");
+
+  const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+  assert.equal(forzada.cuerpo.reembolso, 600);
+});
+
+test("límites exactos: 48 horas no penaliza y 24 horas aplica el 25 % sin forzar", async () => {
+  await moverReloj("2026-11-18T10:30");
+
+  const a48 = await crear(NUEVA, "pista-1", "2026-11-20T10:30");
+  const sinPenalizacion = await api.pedir("POST", `/api/reservas/${a48.id}/cancelar`);
+  assert.equal(sinPenalizacion.status, 200, sinPenalizacion.texto);
+  assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(sinPenalizacion.cuerpo.reembolso, a48.importe);
+
+  const a24 = await crear(NUEVA, "pista-1", "2026-11-19T10:30");
+  const reducida = await api.pedir("POST", `/api/reservas/${a24.id}/cancelar`);
+  assert.equal(reducida.status, 200, reducida.texto);
+  assert.equal(reducida.cuerpo.reserva.penalizacion, Math.round(a24.importe * 0.25));
+  assert.equal(reducida.cuerpo.reembolso, a24.importe - Math.round(a24.importe * 0.25));
+
+  await moverReloj("2026-11-18T10:00");
+});
+
+test("la antelación se cuenta en horas reales de Madrid, con el cambio de hora", async () => {
+  // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas, no 48,5.
+  await moverReloj("2027-03-26T20:30");
+  const primavera = await crear(NUEVA, "pista-1", "2027-03-28T21:00");
+  const reducida = await api.pedir("POST", `/api/reservas/${primavera.id}/cancelar`);
+  assert.equal(reducida.status, 200, reducida.texto);
+  assert.equal(reducida.cuerpo.reserva.penalizacion, Math.round(primavera.importe * 0.25));
+  assert.equal(reducida.cuerpo.reembolso, primavera.importe - Math.round(primavera.importe * 0.25));
+
+  // Al revés, cuando los relojes se atrasan: 48 horas de calendario son 49 horas reales.
+  await moverReloj("2027-10-30T21:00");
+  const otono = await crear(NUEVA, "pista-1", "2027-11-01T21:00");
+  const gratis = await api.pedir("POST", `/api/reservas/${otono.id}/cancelar`);
+  assert.equal(gratis.status, 200, gratis.texto);
+  assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.cuerpo.reembolso, otono.importe);
+
+  await moverReloj("2026-11-18T10:00");
+});
+
+test("un gestor exime de la penalización con un motivo de al menos 10 caracteres", async () => {
+  await moverReloj("2026-11-18T10:00");
+  const reserva = await crear(NUEVA, "pista-1", "2026-11-19T09:00");
+  const ruta = `/api/reservas/${reserva.id}/cancelar`;
+  const motivo = "Lesión del socio";
+
+  const anonimo = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo } });
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const noGestor = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo }, socio: SOCIO });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const sinMotivo = await api.pedir("POST", ruta, { cuerpo: { exento: true }, socio: GESTOR });
+  assert.equal(sinMotivo.status, 400);
+  assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const corto = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo: "corto" }, socio: GESTOR });
+  assert.equal(corto.status, 400);
+  assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const eximida = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo }, socio: GESTOR });
+  assert.equal(eximida.status, 200, eximida.texto);
+  assert.equal(eximida.cuerpo.reserva.estado, "cancelada");
+  assert.equal(eximida.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(eximida.cuerpo.reserva.motivoCancelacion, motivo);
+  assert.equal(eximida.cuerpo.reembolso, reserva.importe);
+});
+
