+test("el informe de caja cuadra con las reservas del mes", async () => {
+  const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR });
+  assert.equal(informe.status, 200, informe.texto);
+  const { mes, pistas, total } = informe.cuerpo;
+  assert.equal(mes, "2026-11");
+  assert.deepEqual(pistas.map((p: { pistaId: string }) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const delMes = estado.reservas.filter((r: { inicio: string }) => r.inicio.slice(0, 7) === "2026-11");
+  const sumas = { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 };
+  for (const fila of pistas) {
+    const suyas = delMes.filter((r: { pistaId: string }) => r.pistaId === fila.pistaId);
+    const activas = suyas.filter((r: { estado: string }) => r.estado !== "cancelada");
+    const ingresos = activas.reduce((s: number, r: { importe: number }) => s + r.importe, 0);
+    const penalizaciones = suyas
+      .filter((r: { estado: string }) => r.estado === "cancelada")
+      .reduce((s: number, r: { penalizacion?: number }) => s + (r.penalizacion ?? 0), 0);
+    assert.equal(fila.reservas, activas.length, fila.pistaId);
+    assert.equal(fila.ingresos, ingresos, fila.pistaId);
+    assert.equal(fila.penalizaciones, penalizaciones, fila.pistaId);
+    assert.equal(fila.total, ingresos + penalizaciones, fila.pistaId);
+    sumas.reservas += fila.reservas;
+    sumas.ingresos += fila.ingresos;
+    sumas.penalizaciones += fila.penalizaciones;
+    sumas.total += fila.total;
+  }
+  assert.deepEqual(total, sumas);
+  // El tramo del 50 % de R-0520 está en el informe.
+  assert.equal(pistas.find((p: { pistaId: string }) => p.pistaId === "pista-3").penalizaciones >= 600, true);
+
+  const vacio = await api.pedir("GET", "/api/informes/caja?mes=2026-09", { socio: GESTOR });
+  assert.equal(vacio.status, 200);
+  assert.deepEqual(vacio.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+  for (const fila of vacio.cuerpo.pistas) {
+    assert.deepEqual({ ...fila, pistaId: undefined }, { pistaId: undefined, reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+  }
+  assert.deepEqual(vacio.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+});
