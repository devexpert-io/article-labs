@@ -0,0 +1,233 @@
+// Penalizaciones escalonadas, exención por un gestor e informe de caja (spec `reembolsos`).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function crear(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, `no se pudo crear la reserva de ${inicio}: ${r.texto}`);
+  return r.cuerpo.reserva as { id: string; importe: number };
+}
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200, r.texto);
+}
+
+test("tramos: 48 horas sin penalización, 25 % entre 24 y 48 y 50 % por debajo de 24 con forzar", async () => {
+  await conApi(async (api) => {
+    // Todas las franjas están libres: la semilla no llega a diciembre.
+    const a = await crear(api, "socio-003", "pista-1", "2026-12-01T10:30"); // 1800
+    const b = await crear(api, "socio-006", "pista-1", "2026-12-02T10:30"); // 1800
+    const c = await crear(api, "socio-008", "pista-1", "2026-12-03T10:30"); // 1800
+    const d = await crear(api, "socio-010", "pista-1", "2026-12-04T10:30"); // 1800
+    const e = await crear(api, "socio-013", "pista-1", "2026-12-07T10:30"); // 1800
+
+    // 48 horas justas: no hay penalización.
+    await reloj(api, "2026-11-29T10:30");
+    const sinPenalizacion = await api.pedir("POST", `/api/reservas/${a.id}/cancelar`);
+    assert.equal(sinPenalizacion.status, 200);
+    assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(sinPenalizacion.cuerpo.reembolso, 1800);
+
+    // 24 horas justas: 25 % y no hace falta forzar.
+    await reloj(api, "2026-12-01T10:30");
+    const justo = await api.pedir("POST", `/api/reservas/${b.id}/cancelar`);
+    assert.equal(justo.status, 200);
+    assert.equal(justo.cuerpo.reserva.penalizacion, 450);
+    assert.equal(justo.cuerpo.reembolso, 1350);
+
+    // 47,5 horas: todavía en el tramo del 25 %.
+    await reloj(api, "2026-12-01T11:00");
+    const casi = await api.pedir("POST", `/api/reservas/${c.id}/cancelar`);
+    assert.equal(casi.cuerpo.reserva.penalizacion, 450);
+    assert.equal(casi.cuerpo.reembolso, 1350);
+
+    // 23,5 horas: sin forzar no se cancela; con forzar, 50 %.
+    await reloj(api, "2026-12-03T11:00");
+    const fuera = await api.pedir("POST", `/api/reservas/${d.id}/cancelar`);
+    assert.equal(fuera.status, 409);
+    assert.equal(fuera.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${d.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+
+    // Con más de 48 horas vuelve a no haber penalización.
+    const lejana = await api.pedir("POST", `/api/reservas/${e.id}/cancelar`);
+    assert.equal(lejana.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(lejana.cuerpo.reembolso, 1800);
+  });
+});
+
+test("el cambio de hora se cuenta en horas reales de Madrid", async () => {
+  await conApi(async (api) => {
+    // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales
+    // (no 48,5), porque esa madrugada los relojes se adelantan una hora.
+    const r = await crear(api, "socio-003", "pista-1", "2027-03-28T21:00"); // 2800
+    await reloj(api, "2027-03-26T20:30");
+    const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(cancelada.status, 200, cancelada.texto);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  });
+});
+
+test("exención: solo un gestor, con motivo de 10 caracteres o más", async () => {
+  await conApi(async (api) => {
+    const r = await crear(api, "socio-003", "pista-2", "2026-12-10T10:30"); // 1800
+    // A menos de 24 horas haría falta forzar.
+    await reloj(api, "2026-12-09T20:00");
+    const ruta = `/api/reservas/${r.id}/cancelar`;
+    const motivo = "Lesión del socio titular";
+
+    const sinIdentificar = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo } });
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinPermiso = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo }, socio: "socio-003" });
+    assert.equal(sinPermiso.status, 403);
+    assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const sinMotivo = await api.pedir("POST", ruta, { cuerpo: { exento: true }, socio: GESTOR });
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const motivoCorto = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo: "corto" }, socio: GESTOR });
+    assert.equal(motivoCorto.status, 400);
+    assert.equal(motivoCorto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const sigueConfirmada = await api.pedir("GET", `/api/reservas/${r.id}`);
+    assert.equal(sigueConfirmada.cuerpo.reserva.estado, "confirmada");
+
+    const exenta = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo }, socio: GESTOR });
+    assert.equal(exenta.status, 200, exenta.texto);
+    assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exenta.cuerpo.reserva.motivoCancelacion, motivo);
+    assert.equal(exenta.cuerpo.reembolso, 1800);
+  });
+});
+
