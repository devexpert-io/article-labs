+test("el informe de caja recoge las penalizaciones del mes y las reservas canceladas las conservan", async () => {
+  await conApi(async (api) => {
+    const cancelada = await crear(api, "socio-003", "pista-2", "2026-12-02T10:30"); // 1800
+    const confirmada = await crear(api, "socio-006", "pista-3", "2026-12-03T10:30"); // 1200
+
+    // 24 horas justas: 25 % de 1800 = 450.
+    await reloj(api, "2026-12-01T10:30");
+    const r = await api.pedir("POST", `/api/reservas/${cancelada.id}/cancelar`);
+    assert.equal(r.cuerpo.reserva.penalizacion, 450);
+
+    // Volver a cancelar no la toca: la penalización se conserva.
+    const repetida = await api.pedir("POST", `/api/reservas/${cancelada.id}/cancelar`);
+    assert.equal(repetida.status, 409);
+    assert.equal(repetida.cuerpo.error.codigo, "YA_CANCELADA");
+    const despues = await api.pedir("GET", `/api/reservas/${cancelada.id}`);
+    assert.equal(despues.cuerpo.reserva.penalizacion, 450);
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: GESTOR });
+    assert.equal(informe.status, 200);
+    const porPista = Object.fromEntries(informe.cuerpo.pistas.map((p: any) => [p.pistaId, p]));
+    assert.deepEqual(porPista["pista-1"], { pistaId: "pista-1", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+    assert.deepEqual(porPista["pista-2"], { pistaId: "pista-2", reservas: 0, ingresos: 0, penalizaciones: 450, total: 450 });
+    assert.deepEqual(porPista["pista-3"], {
+      pistaId: "pista-3",
+      reservas: 1,
+      ingresos: confirmada.importe,
+      penalizaciones: 0,
+      total: confirmada.importe,
+    });
+    assert.deepEqual(informe.cuerpo.total, {
+      reservas: 1,
+      ingresos: confirmada.importe,
+      penalizaciones: 450,
+      total: confirmada.importe + 450,
+    });
+  });
+});
