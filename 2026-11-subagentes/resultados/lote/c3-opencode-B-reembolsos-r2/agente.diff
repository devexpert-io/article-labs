+test("el informe de caja suma ingresos y penalizaciones por pista y para todo el club", async () => {
+  await conApi(async (api) => {
+    // Un mes sin movimientos: todas las pistas del club, a cero, ordenadas por id.
+    const vacio = await api.pedir("GET", "/api/informes/caja?mes=2027-01", { socio: GESTOR });
+    assert.equal(vacio.status, 200);
+    assert.equal(vacio.cuerpo.mes, "2027-01");
+    assert.deepEqual(vacio.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+    for (const p of vacio.cuerpo.pistas) {
+      assert.deepEqual(p, { pistaId: p.pistaId, reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+    }
+    assert.deepEqual(vacio.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+
+    // Un mes con historial: los agregados coinciden con el estado del club.
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR });
+    assert.equal(informe.status, 200);
+    const delMes = estado.reservas.filter((r: any) => r.inicio.slice(0, 7) === "2026-10");
+    for (const p of informe.cuerpo.pistas) {
+      const suyas = delMes.filter((r: any) => r.pistaId === p.pistaId);
+      const reservas = suyas.filter((r: any) => r.estado === "confirmada" || r.estado === "no_presentada");
+      const ingresos = reservas.reduce((suma: number, r: any) => suma + r.importe, 0);
+      const penalizaciones = suyas
+        .filter((r: any) => r.estado === "cancelada")
+        .reduce((suma: number, r: any) => suma + (r.penalizacion ?? 0), 0);
+      assert.deepEqual(p, { pistaId: p.pistaId, reservas: reservas.length, ingresos, penalizaciones, total: ingresos + penalizaciones });
+    }
+    const total = informe.cuerpo.total;
+    assert.ok(total.reservas > 0);
+    assert.equal(total.ingresos, informe.cuerpo.pistas.reduce((s: number, p: any) => s + p.ingresos, 0));
+    assert.equal(total.penalizaciones, informe.cuerpo.pistas.reduce((s: number, p: any) => s + p.penalizaciones, 0));
+    assert.equal(total.total, total.ingresos + total.penalizaciones);
+  });
+});
