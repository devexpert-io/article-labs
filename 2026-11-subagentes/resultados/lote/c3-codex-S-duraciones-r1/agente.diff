+test("cancelación gratuita a 24 horas y penalización del importe completo después para cada duración", async (t) => {
+  const api = await preparar(t);
+  for (const [i, duracion] of [60, 90, 120].entries()) {
+    const inicio = `2026-12-0${i + 1}T17:30`;
+    const r = await crear(api, inicio, duracion);
+    assert.equal(r.status, 201);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: i === 0 ? "2026-11-30T17:30" : `2026-12-0${i}T17:30` } });
+    assert.equal((await cancelar(api, r.cuerpo.reserva.id)).penalizacion, undefined);
+    const nueva = await crear(api, inicio, duracion);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: i === 0 ? "2026-11-30T17:31" : `2026-12-0${i}T17:31` } });
+    error(await api.pedir("POST", `/api/reservas/${nueva.cuerpo.reserva.id}/cancelar`), 409, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${nueva.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.duracion, duracion);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, nueva.cuerpo.reserva.importe);
+  }
+});
