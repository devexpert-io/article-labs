+test("las reservas antiguas devuelven duración sin alterar los datos de la semilla", async (t) => {
+  const api = await preparar(t);
+  for (let pagina = 1; ; pagina++) {
+    const lista = (await api.pedir("GET", `/api/reservas?limite=100&pagina=${pagina}`)).cuerpo;
+    for (const r of lista.reservas) {
+      assert.equal(r.duracion, 90);
+      if (r.estado !== "confirmada") {
+        assert.equal((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva.duracion, 90);
+      }
+    }
+    if (pagina === lista.paginas) break;
+  }
+  const antigua = (await api.pedir("GET", "/api/reservas?fecha=2026-11-23&socio=socio-004")).cuerpo.reservas[0];
+  const cancelada = await cancelar(api, antigua.id);
+  assert.deepEqual(cancelada, { ...antigua, estado: "cancelada" });
+  assert.ok((await api.pedir("GET", "/_estado")).cuerpo.reservas.every((r: any) => r.duracion === 90));
+});
+
+async function disponibilidad(api: Api, fecha = "2026-12-01") {
+  return (await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`)).cuerpo.pistas;
+}
+
+test("disponibilidad: solapes parciales y huecos máximos, ordenados e independientes del reloj", async (t) => {
+  const api = await preparar(t);
+  const fecha = "2026-12-01";
+  const intervalo = (inicio: string, fin: string) => ({ inicio: `${fecha}T${inicio}`, fin: `${fecha}T${fin}` });
+  const primera = await crear(api, `${fecha}T09:30`, 60);
+  const segunda = await crear(api, `${fecha}T10:30`, 60);
+  const tercera = await crear(api, `${fecha}T17:30`, 120);
+  for (const r of [primera, segunda, tercera]) assert.equal(r.status, 201);
+  const pistas = await disponibilidad(api);
+  const p = pistas.find((p: any) => p.pistaId === "pista-1");
+  assert.deepEqual(p.huecos, [intervalo("09:00", "09:30"), intervalo("11:30", "17:30"), intervalo("19:30", "22:30")]);
+  assert.deepEqual(p.franjas.filter((f: any) => f.estado === "reservada").map((f: any) => f.inicio.slice(11)), ["09:00", "10:30", "16:30", "18:00"]);
+  assert.equal(p.franjas.length, 9);
+  assert.equal(p.franjas.find((f: any) => f.inicio.endsWith("18:00")).precio, 2800);
+  assert.deepEqual(pistas.find((p: any) => p.pistaId === "pista-2").huecos, [intervalo("09:00", "22:30")]);
+  const cerrada = pistas.find((p: any) => p.pistaId === "pista-4");
+  assert.deepEqual(cerrada.huecos, []);
+  assert.ok(cerrada.franjas.every((f: any) => f.estado === "cerrada"));
+  await cancelar(api, tercera.cuerpo.reserva.id);
+  const trasCancelar = await disponibilidad(api);
+  assert.deepEqual(trasCancelar[0].huecos, [intervalo("09:00", "09:30"), intervalo("11:30", "22:30")]);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: `${fecha}T20:00` } });
+  assert.deepEqual(await disponibilidad(api), trasCancelar);
+});
+
+test("sin huecos cuando todo el día está ocupado; las reservas antiguas también ocupan", async (t) => {
+  const api = await preparar(t);
+  const socios = ["socio-041", "socio-004", "socio-005"];
+  for (const socio of socios) {
+    const lista = (await api.pedir("GET", `/api/reservas?socio=${socio}&desde=2026-11-18&estado=confirmada`)).cuerpo.reservas;
+    for (const r of lista) {
+      const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { forzar: true } });
+      assert.equal(cancelada.status, 200);
+    }
+  }
+  for (const [i, hora] of ["09:00", "10:30", "12:00", "13:30", "15:00", "16:30", "18:00", "19:30", "21:00"].entries()) {
+    assert.equal((await crear(api, `2026-12-01T${hora}`, 90, "pista-1", socios[i % 3])).status, 201);
+  }
+  assert.deepEqual((await disponibilidad(api))[0].huecos, []);
+  const jueves = (await disponibilidad(api, "2026-11-19"))[0];
+  assert.equal(jueves.franjas.find((f: any) => f.inicio.endsWith("19:30")).estado, "reservada");
+  assert.ok(jueves.huecos.every((h: any) => h.fin <= "2026-11-19T19:30" || h.inicio >= "2026-11-19T21:00"));
+});
