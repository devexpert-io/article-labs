@@ -0,0 +1,208 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function preparar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+function crear(api: Api, inicio: string, duracion?: unknown, pistaId = "pista-1", socioId = "socio-041") {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { inicio, duracion, pistaId, socioId } });
+}
+
+function error(r: { status: number; cuerpo: any }, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+async function cancelar(api: Api, id: string) {
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(r.status, 200);
+  return r.cuerpo.reserva;
+}
+
+test("duraciones válidas, valor por defecto, fin y persistencia en las respuestas", async (t) => {
+  const api = await preparar(t);
+  for (const [i, duracion] of [undefined, 60, 90, 120].entries()) {
+    const r = await crear(api, `2026-12-0${i + 1}T10:30`, duracion);
+    assert.equal(r.status, 201);
+    const reserva = r.cuerpo.reserva;
+    assert.equal(reserva.duracion, duracion ?? 90);
+    assert.equal(reserva.fin, `2026-12-0${i + 1}T${duracion === 60 ? "11:30" : duracion === 120 ? "12:30" : "12:00"}`);
+    assert.deepEqual((await api.pedir("GET", `/api/reservas/${reserva.id}`)).cuerpo.reserva, reserva);
+    const lista = await api.pedir("GET", `/api/reservas?fecha=2026-12-0${i + 1}`);
+    assert.deepEqual(lista.cuerpo.reservas, [reserva]);
+    assert.equal((await cancelar(api, reserva.id)).duracion, duracion ?? 90);
+  }
+  for (const duracion of [null, "60", "90", true, false, 0, -60, 30, 61, 90.5, 180, [], {}]) {
+    error(await crear(api, "2026-12-01T10:00", duracion), 400, "DURACION_INVALIDA");
+  }
+});
+
+test("inicios en punto o y media y límites de apertura y cierre", async (t) => {
+  const api = await preparar(t);
+  for (const [hora, duracion] of [["09:00", 120], ["09:30", 60], ["21:30", 60], ["21:00", 90], ["20:30", 120]] as const) {
+    const r = await crear(api, `2026-12-01T${hora}`, duracion);
+    assert.equal(r.status, 201, r.texto);
+    await cancelar(api, r.cuerpo.reserva.id);
+  }
+  for (const [hora, duracion] of [["08:30", 60], ["10:15", 90], ["10:45", 60], ["22:00", 60], ["21:30", 90], ["21:00", 120], ["24:00", 60], ["99:30", 60], ["09:60", 60], ["9:00", 60], ["10:00:00", 60]] as const) {
+    error(await crear(api, `2026-12-01T${hora}`, duracion), 400, "FRANJA_INVALIDA");
+  }
+});
+
+test("solapes por ambos extremos, contención, igualdad y reservas contiguas", async (t) => {
+  const api = await preparar(t);
+  const central = await crear(api, "2026-12-01T12:00", 90);
+  assert.equal(central.status, 201);
+  for (const [hora, duracion] of [["11:30", 60], ["13:00", 60], ["11:30", 120], ["12:00", 60], ["12:00", 90], ["12:30", 60]] as const) {
+    error(await crear(api, `2026-12-01T${hora}`, duracion), 409, "FRANJA_NO_DISPONIBLE");
+  }
+  for (const hora of ["11:00", "13:30"]) {
+    const r = await crear(api, `2026-12-01T${hora}`, 60);
+    assert.equal(r.status, 201);
+    await cancelar(api, r.cuerpo.reserva.id);
+  }
+  const otraPista = await crear(api, "2026-12-01T12:00", 60, "pista-2");
+  assert.equal(otraPista.status, 201);
+  await cancelar(api, central.cuerpo.reserva.id);
+  assert.equal((await crear(api, "2026-12-01T12:30", 60)).status, 201);
+  // La reserva antigua del jueves a las 19:30 ocupa hasta las 21:00.
+  for (const hora of ["19:00", "20:30"]) {
+    error(await crear(api, `2026-11-19T${hora}`, 60), 409, "FRANJA_NO_DISPONIBLE");
+  }
+});
+
+test("precio por minutos, cruces de las 18:00, fines de semana y redondeo final", async (t) => {
+  const api = await preparar(t);
+  const casos = [
+    ["2026-12-01T12:00", 60, "pista-1", 1200],
+    ["2026-12-01T18:00", 60, "pista-1", 1867],
+    ["2026-12-01T17:30", 90, "pista-1", 2467],
+    ["2026-12-01T17:30", 60, "pista-1", 1533],
+    ["2026-12-01T17:00", 120, "pista-1", 3067],
+    ["2026-12-01T17:30", 120, "pista-3", 2400],
+    ["2026-12-05T09:00", 60, "pista-3", 1333],
+    ["2026-12-06T17:30", 120, "pista-1", 3733],
+    ["2026-12-01T09:00", 120, "pista-3", 1600],
+  ] as const;
+  for (const [inicio, duracion, pista, importe] of casos) {
+    const r = await crear(api, inicio, duracion, pista);
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.importe, importe, `${inicio}, ${duracion}, ${pista}`);
+    await cancelar(api, r.cuerpo.reserva.id);
+  }
+});
+
+test("las nueve franjas de siempre conservan su precio en todas las pistas", async (t) => {
+  const api = await preparar(t);
+  await api.pedir("PATCH", "/api/pistas/pista-4", { cuerpo: { estado: "operativa" } });
+  const pistas = (await api.pedir("GET", "/api/pistas")).cuerpo.pistas;
+  for (const fecha of ["2026-12-01", "2026-12-05", "2026-12-06"]) {
+    for (const pista of pistas) {
+      for (const hora of ["09:00", "10:30", "12:00", "13:30", "15:00", "16:30", "18:00", "19:30", "21:00"]) {
+        const r = await crear(api, `${fecha}T${hora}`, 90, pista.id);
+        assert.equal(r.status, 201);
+        assert.equal(r.cuerpo.reserva.importe, fecha !== "2026-12-01" || hora >= "18:00" ? pista.precioPunta : pista.precioValle);
+        await cancelar(api, r.cuerpo.reserva.id);
+      }
