+// La política de cancelación escalonada, la exención y el informe de caja, por la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Crea una reserva y devuelve la reserva creada. */
+async function reservar(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, `crear reserva ${inicio}: ${JSON.stringify(r.cuerpo)}`);
+  return r.cuerpo.reserva as { id: string; importe: number };
+}
+
+test("tramos de penalización y sus límites exactos", async () => {
+  const api = await arrancarApi({ AHORA: "2027-01-12T12:00" });
+  try {
+    // 48 horas justas: sin penalización.
+    const a48 = await reservar(api, "socio-006", "pista-1", "2027-01-14T12:00");
+    const c48 = await api.pedir("POST", `/api/reservas/${a48.id}/cancelar`);
+    assert.equal(c48.status, 200);
+    assert.equal(c48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c48.cuerpo.reembolso, a48.importe);
+
+    // Entre 24 y 48 horas: 25 %, sin necesidad de forzar.
+    const entre = await reservar(api, "socio-007", "pista-1", "2027-01-13T18:00");
+    const cEntre = await api.pedir("POST", `/api/reservas/${entre.id}/cancelar`);
+    assert.equal(cEntre.status, 200);
+    assert.equal(cEntre.cuerpo.reserva.penalizacion, Math.round(entre.importe * 0.25));
+    assert.equal(cEntre.cuerpo.reembolso, entre.importe - cEntre.cuerpo.reserva.penalizacion);
+
+    // 24 horas justas: 25 %, sin forzar.
+    const a24 = await reservar(api, "socio-008", "pista-1", "2027-01-13T12:00");
+    const c24 = await api.pedir("POST", `/api/reservas/${a24.id}/cancelar`);
+    assert.equal(c24.status, 200);
+    assert.equal(c24.cuerpo.reserva.penalizacion, Math.round(a24.importe * 0.25));
+
+    // Menos de 24 horas: 409 sin forzar, 50 % con forzar.
+    const menos = await reservar(api, "socio-009", "pista-1", "2027-01-13T09:00");
+    const sinForzar = await api.pedir("POST", `/api/reservas/${menos.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${menos.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, Math.round(menos.importe * 0.5));
+    assert.equal(forzada.cuerpo.reembolso, menos.importe - forzada.cuerpo.reserva.penalizacion);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("la antelación cuenta las horas reales de Madrid, con el cambio de hora", async () => {
+  const api = await arrancarApi({ AHORA: "2027-03-26T20:30" });
+  try {
+    // Del viernes 26/03 20:30 al domingo 28/03 21:00 hay 47,5 horas reales (esa madrugada
+    // se adelanta una hora), así que entra en el tramo del 25 % y no en el de 48 horas.
+    const r = await reservar(api, "socio-006", "pista-1", "2027-03-28T21:00");
+    const c = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, Math.round(r.importe * 0.25));
+    assert.equal(c.cuerpo.reembolso, r.importe - c.cuerpo.reserva.penalizacion);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("un gestor puede eximir de la penalización con un motivo", async () => {
+  const api = await arrancarApi({ AHORA: "2027-01-11T10:00" });
+  try {
+    // Faltan 23 horas: con la política normal haría falta forzar.
+    const r = await reservar(api, "socio-006", "pista-1", "2027-01-12T09:00");
+
+    // Sin cabecera X-Socio.
+    const anonimo = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { exento: true, motivo: "Avería en la pista" } });
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    // Socio sin rol de gestor.
+    const socio = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { exento: true, motivo: "Avería en la pista" }, socio: "socio-003" });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    // Motivo demasiado corto.
+    const corto = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { exento: true, motivo: "corto" }, socio: "socio-040" });
+    assert.equal(corto.status, 400);
+    assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // Sin motivo.
+    const sinMotivo = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { exento: true }, socio: "socio-040" });
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // Gestor con motivo válido: cancela sin penalización y sin forzar.
+    const ok = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { exento: true, motivo: "Avería en la pista" }, socio: "socio-040" });
+    assert.equal(ok.status, 200);
+    assert.equal(ok.cuerpo.reserva.estado, "cancelada");
+    assert.equal(ok.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(ok.cuerpo.reembolso, r.importe);
+    assert.equal(ok.cuerpo.reserva.motivoCancelacion, "Avería en la pista");
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("una reserva que ya ha empezado no se cancela, ni con exento", async () => {
+  const api = await arrancarApi({ AHORA: "2027-01-11T10:00" });
+  try {
+    const r = await reservar(api, "socio-006", "pista-1", "2027-01-12T09:00");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-12T10:00" } });
+    const c = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { exento: true, motivo: "Avería en la pista" }, socio: "socio-040" });
+    assert.equal(c.status, 409);
+    assert.equal(c.cuerpo.error.codigo, "RESERVA_PASADA");
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("el informe de caja es solo para gestores y suma por pista", async () => {
+  const api = await arrancarApi({ AHORA: "2027-01-11T10:00" });
