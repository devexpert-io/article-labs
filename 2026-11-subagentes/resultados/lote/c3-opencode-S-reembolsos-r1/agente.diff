+// La hora local del club es Europe/Madrid. Para medir la antelación en horas reales hay que
+// tener en cuenta el cambio de hora (el desfase con UTC pasa de +1 a +2 en verano y vuelve).
+const FORMATO_MADRID = new Intl.DateTimeFormat("en-US", {
+  timeZone: "Europe/Madrid",
+  hour12: false,
+  year: "numeric", month: "2-digit", day: "2-digit",
+  hour: "2-digit", minute: "2-digit", second: "2-digit",
+});
+
+/** Desfase de Madrid respecto a UTC en una marca de tiempo (en milisegundos). */
+function desfaseMadrid(marca: number): number {
+  const partes = FORMATO_MADRID.formatToParts(new Date(marca));
+  const valores: Record<string, string> = {};
+  for (const { type, value } of partes) valores[type] = value;
+  const hora = valores.hour === "24" ? 0 : Number(valores.hour);
+  const enMadrid = Date.UTC(
+    Number(valores.year), Number(valores.month) - 1, Number(valores.day),
+    hora, Number(valores.minute), Number(valores.second),
+  );
+  return enMadrid - marca;
+}
+
+/** Convierte una fecha-hora local de Madrid (AAAA-MM-DDTHH:MM) a una marca de tiempo UTC. */
+function epocaMadrid(fechaHora: string): number {
+  const [fecha, hora] = fechaHora.split("T");
+  const [anio, mes, dia] = fecha.split("-").map(Number);
+  const [h, m] = hora.split(":").map(Number);
+  const objetivo = Date.UTC(anio, mes - 1, dia, h, m, 0);
+  let marca = objetivo;
+  for (let i = 0; i < 3; i++) {
+    const siguiente = objetivo - desfaseMadrid(marca);
+    if (siguiente === marca) break;
+    marca = siguiente;
+  }
+  return marca;
+}
+
