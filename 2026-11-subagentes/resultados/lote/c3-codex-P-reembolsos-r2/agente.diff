+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function crear(api: Api, inicio = "2027-01-15T12:00", pistaId = "pista-1") {
+  const respuesta = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio },
+  });
+  assert.equal(respuesta.status, 201, respuesta.texto);
+  return respuesta.cuerpo.reserva;
+}
+
+test("tramos, límites exactos y reembolso de la cancelación", async () => {
+  const api = await arrancarApi();
+  try {
+    for (const [ahora, porcentaje] of [
+      ["2027-01-13T11:59", 0], ["2027-01-13T12:00", 0],
+      ["2027-01-13T12:01", 25], ["2027-01-14T00:00", 25],
+      ["2027-01-14T12:00", 25], ["2027-01-14T12:01", 50],
+    ] as const) {
+      await reloj(api, ahora);
+      const reserva = await crear(api);
+      const ruta = `/api/reservas/${reserva.id}/cancelar`;
+      if (porcentaje === 50) {
+        for (const cuerpo of [{}, { forzar: false }]) {
+          const fallo = await api.pedir("POST", ruta, { cuerpo });
+          assert.equal(fallo.status, 409);
+          assert.equal(fallo.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+          assert.equal((await api.pedir("GET", `/api/reservas/${reserva.id}`)).cuerpo.reserva.estado, "confirmada");
+        }
+      }
+      const cancelada = await api.pedir("POST", ruta, { cuerpo: { forzar: porcentaje === 50 } });
+      assert.equal(cancelada.status, 200, cancelada.texto);
+      assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+      assert.equal(cancelada.cuerpo.reserva.penalizacion ?? 0, reserva.importe * porcentaje / 100);
+      assert.equal(cancelada.cuerpo.reembolso, reserva.importe * (100 - porcentaje) / 100);
+    }
+  } finally { api.cerrar(); }
+});
+
