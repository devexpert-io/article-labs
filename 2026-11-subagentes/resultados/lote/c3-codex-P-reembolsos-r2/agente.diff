+      ["2027-03-27T20:30", "2027-03-28T21:00", 50], // 23,5 horas reales
+    ] as const) {
+      await reloj(api, ahora);
+      const reserva = await crear(api, inicio);
+      const respuesta = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+      assert.equal(respuesta.status, 200);
+      assert.equal(respuesta.cuerpo.reserva.penalizacion ?? 0, reserva.importe * porcentaje / 100);
+      assert.equal(respuesta.cuerpo.reembolso, reserva.importe * (100 - porcentaje) / 100);
