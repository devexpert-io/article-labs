+/** Convierte la hora local del club en un instante, usando el desfase vigente en Madrid. */
+function instanteMadrid(fecha: string): number {
+  const local = Date.parse(`${fecha}:00Z`);
+  let instante = local;
+  for (let i = 0; i < 2; i++) {
+    const zona = formatoMadrid.formatToParts(instante).find((p) => p.type === "timeZoneName")!.value;
+    const [, signo, horas, minutos] = /GMT([+-])(\d{2}):(\d{2})/.exec(zona)!;
+    const desfase = (Number(horas) * 60 + Number(minutos)) * (signo === "+" ? 1 : -1);
+    instante = local - desfase * 60_000;
+  }
+  return instante;
+}
