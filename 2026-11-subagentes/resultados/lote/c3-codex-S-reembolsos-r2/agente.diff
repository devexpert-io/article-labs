+import type { Estado, Reserva } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+
+async function crear(api: Api, inicio = "2027-01-20T21:00", pistaId = "pista-1"): Promise<Reserva> {
+  const respuesta = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio },
+  });
+  assert.equal(respuesta.status, 201);
+  return respuesta.cuerpo.reserva;
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+for (const [ahora, porcentaje] of [
+  ["2027-01-18T20:59", 0],
+  ["2027-01-18T21:00", 0],
+  ["2027-01-18T21:01", 0.25],
+  ["2027-01-19T20:59", 0.25],
+  ["2027-01-19T21:00", 0.25],
+  ["2027-01-19T21:01", 0.5],
+] as const) {
+  test(`tramos y límites: cancelar el 20 a las 21:00 desde ${ahora}`, async (t) => {
+    const api = await arrancarApi();
+    t.after(() => api.cerrar());
+    const reserva = await crear(api);
+    await reloj(api, ahora);
+    const ruta = `/api/reservas/${reserva.id}/cancelar`;
+    if (porcentaje === 0.5) {
+      for (const forzar of [undefined, false]) {
+        const denegada = await api.pedir("POST", ruta, { cuerpo: { forzar } });
+        assert.equal(denegada.status, 409);
+        assert.equal(denegada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+      }
+      assert.deepEqual((await api.pedir("GET", `/api/reservas/${reserva.id}`)).cuerpo.reserva, reserva);
+    }
+    const respuesta = await api.pedir("POST", ruta, { cuerpo: porcentaje === 0.5 ? { forzar: true } : {} });
+    assert.equal(respuesta.status, 200);
+    assert.equal(respuesta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(respuesta.cuerpo.reserva.penalizacion, reserva.importe * porcentaje);
+    assert.equal(respuesta.cuerpo.reembolso, reserva.importe * (1 - porcentaje));
