+// Lista de espera de franjas, probada a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+// Franja ocupada por socio-007 en la semilla (jueves 19 a las 19:30, pista 1).
+const FRANJA_OCUPADA = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+
+async function conApi(fn: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reservaDe(api: Api, pistaId: string, inicio: string, socioId: string): Promise<string> {
+  const lista = await api.pedir("GET", `/api/reservas?fecha=${inicio.slice(0, 10)}&pista=${pistaId}&socio=${socioId}`);
+  const r = lista.cuerpo.reservas.find((x: any) => x.inicio === inicio && x.estado === "confirmada");
+  assert.ok(r, `debe existir la reserva ${socioId} ${pistaId} ${inicio}`);
+  return r.id;
+}
+
+test("apuntarse crea una espera activa con su posición", async () => {
+  await conApi(async (api) => {
+    const r = await api.pedir("POST", "/api/esperas", { socio: "socio-003", cuerpo: FRANJA_OCUPADA });
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.espera.estado, "activa");
+    assert.equal(r.cuerpo.espera.posicion, 1);
+    assert.equal(r.cuerpo.espera.pistaId, "pista-1");
+    const sin = await api.pedir("POST", "/api/esperas", { cuerpo: FRANJA_OCUPADA });
+    assert.equal(sin.status, 401);
+    assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  });
+});
+
+test("solo se puede esperar una franja ocupada y válida", async () => {
+  await conApi(async (api) => {
+    const libre = await api.pedir("POST", "/api/esperas", { socio: "socio-003", cuerpo: { pistaId: "pista-2", inicio: "2026-11-19T19:30" } });
