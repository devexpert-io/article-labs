+
+const GESTOR = "socio-040";
+const SOCIO = "socio-001";
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+test("solo los gestores pueden exportar", async () => {
+  const ruta = "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-31";
+  const sin = await api.pedir("GET", ruta);
+  assert.equal(sin.status, 401);
+  assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("GET", ruta, { socio: SOCIO });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("GET", ruta, { socio: GESTOR })).status, 200);
+});
+
+test("responde CSV con las cabeceras y el nombre de fichero", async () => {
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-31", { socio: GESTOR });
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-10-31.csv"');
+});
+
+test("primera línea exacta y una fila por reserva del periodo", async () => {
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-31", { socio: GESTOR });
+  const lineas = r.texto.split("\r\n");
+  assert.equal(lineas[0], CABECERA);
+  assert.equal(lineas[lineas.length - 1], "", "termina en CRLF");
+  const filas = lineas.slice(1, -1);
