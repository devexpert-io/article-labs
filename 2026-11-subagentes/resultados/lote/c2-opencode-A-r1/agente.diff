+test("cada línea termina en CRLF", async () => {
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-01", { socio: GESTOR });
+  assert.ok(r.texto.endsWith("\r\n"));
