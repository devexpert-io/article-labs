+test("salta a quien ya tiene 3 reservas futuras y asigna al siguiente", async () => {
+  await conApi(async (api) => {
+    await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: FRANJA_OCUPADA });
+    await api.pedir("POST", "/api/esperas", { socio: "socio-004", cuerpo: FRANJA_OCUPADA });
+    // socio-041 (sin reservas) acumula 3 reservas futuras
+    for (const inicio of ["2026-11-25T09:00", "2026-11-25T10:30", "2026-11-25T12:00"]) {
+      const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio } });
+      assert.equal(r.status, 201);
+    }
+    const id = await reservaDe(api, "pista-1", "2026-11-19T19:30", "socio-007");
+    const cancelada = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+    const asignada = await api.pedir("GET", `/api/reservas/${cancelada.cuerpo.asignadaA}`);
+    assert.equal(asignada.cuerpo.reserva.socioId, "socio-004");
