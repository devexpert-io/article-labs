+// La política escalonada de cancelación, la exención y el informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Arranca una API aislada, ejecuta la prueba y la cierra. */
+async function conApi(entorno: Record<string, string> = {}, prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function crear(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+}
+
+test("tramos y límites exactos de la penalización", () =>
+  conApi({ AHORA: "2026-12-02T10:30" }, async (api) => {
+    // A 48 horas justas: sin penalización y sin forzar.
+    const limite48 = await crear(api, "socio-041", "pista-1", "2026-12-04T10:30");
+    const c48 = await api.pedir("POST", `/api/reservas/${limite48.id}/cancelar`);
+    assert.equal(c48.status, 200);
+    assert.equal(c48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c48.cuerpo.reembolso, 1800);
+
+    // Con más de 48 horas: tampoco hay penalización.
+    const mas48 = await crear(api, "socio-041", "pista-1", "2026-12-04T12:00");
+    const cmas48 = await api.pedir("POST", `/api/reservas/${mas48.id}/cancelar`);
+    assert.equal(cmas48.cuerpo.reembolso, 1800);
+
+    // A 24 horas justas: 25 % y no hace falta forzar.
+    const limite24 = await crear(api, "socio-041", "pista-1", "2026-12-03T10:30");
+    const c24 = await api.pedir("POST", `/api/reservas/${limite24.id}/cancelar`);
+    assert.equal(c24.status, 200);
+    assert.equal(c24.cuerpo.reserva.penalizacion, 450);
+    assert.equal(c24.cuerpo.reembolso, 1350);
+
+    // Entre 24 y 48 horas: 25 %.
+    const medio = await crear(api, "socio-041", "pista-1", "2026-12-03T12:00");
+    const cmedio = await api.pedir("POST", `/api/reservas/${medio.id}/cancelar`);
+    assert.equal(cmedio.cuerpo.reserva.penalizacion, 450);
+    assert.equal(cmedio.cuerpo.reembolso, 1350);
+
+    // A menos de 24 horas: solo con forzar, y 50 %.
+    const tarde = await crear(api, "socio-041", "pista-1", "2026-12-02T12:00");
+    const sinForzar = await api.pedir("POST", `/api/reservas/${tarde.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const conForzar = await api.pedir("POST", `/api/reservas/${tarde.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(conForzar.status, 200);
+    assert.equal(conForzar.cuerpo.reserva.penalizacion, 900);
+    assert.equal(conForzar.cuerpo.reembolso, 900);
+  }));
+
+test("la antelación cuenta horas reales de Madrid, con el cambio de hora", () =>
+  conApi({ AHORA: "2027-03-26T20:30" }, async (api) => {
+    // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales (no 48,5).
+    const reserva = await crear(api, "socio-041", "pista-1", "2027-03-28T21:00");
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  }));
+
+test("un gestor exime de la penalización con un motivo suficiente", () =>
+  conApi({}, async (api) => {
+    const r = await api.pedir("GET", "/api/reservas/R-0486");
+    const importe = r.cuerpo.reserva.importe;
+
+    // Sin identidad: 401.
+    const sinSocio = await api.pedir("POST", "/api/reservas/R-0486/cancelar", {
+      cuerpo: { exento: true, motivo: "Motivo suficientemente largo" },
+    });
