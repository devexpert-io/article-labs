+      cuerpo: { exento: true, motivo: "corto" },
+    });
+    assert.equal(corto.status, 400);
+    assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // Sin motivo: 400.
+    const sinMotivo = await api.pedir("POST", `/api/reservas/${futura.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true },
+    });
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }));
+
+test("una reserva pasada no se cancela, ni con exención", () =>
+  conApi({}, async (api) => {
+    const pasada = await api.pedir("POST", "/api/reservas/R-0001/cancelar", {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo: "Motivo suficientemente largo" },
+    });
+    assert.equal(pasada.status, 409);
+    assert.equal(pasada.cuerpo.error.codigo, "RESERVA_PASADA");
+  }));
+
+test("el informe de caja es solo para gestores y resume el mes por pista", () =>
+  conApi({ AHORA: "2026-12-02T10:30" }, async (api) => {
+    // Sin X-Socio: 401. Sin rol de gestor: 403. Mes con formato incorrecto: 400.
+    const sinSocio = await api.pedir("GET", "/api/informes/caja?mes=2026-12");
+    assert.equal(sinSocio.status, 401);
+    assert.equal(sinSocio.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const noGestor = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: "socio-001" });
+    assert.equal(noGestor.status, 403);
