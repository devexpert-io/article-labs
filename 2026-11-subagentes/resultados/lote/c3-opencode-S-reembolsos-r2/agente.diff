+    });
+    assert.equal(exenta.status, 200);
+    assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exenta.cuerpo.reembolso, importe);
+    assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "Avería en la pista a cargo del club");
+
+    // Motivo corto: 400 (la reserva queda sin cancelar).
