+    assert.equal(sinSocio.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    // Un socio sin rol de gestor: 403.
+    const noGestor = await api.pedir("POST", "/api/reservas/R-0486/cancelar", {
+      socio: "socio-001",
+      cuerpo: { exento: true, motivo: "Motivo suficientemente largo" },
+    });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
