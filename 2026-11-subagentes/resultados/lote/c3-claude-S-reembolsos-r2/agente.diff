--- /dev/null
+++ b/test/reembolsos.test.ts
@@ -0,0 +1,217 @@
+// Penalizaciones escalonadas, exención por un gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-041"; // Nora Benítez: sin reservas en la semilla.
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+async function reloj(ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+/** Crea una reserva de Nora con el reloj por defecto y deja el reloj en `ahora`. */
+async function reservaCon(inicio: string, ahora: string, pistaId = "pista-3") {
+  await reloj("2026-11-18T10:00");
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIO, pistaId, inicio } });
+  assert.equal(creada.status, 201, JSON.stringify(creada.cuerpo));
+  await reloj(ahora);
+  return creada.cuerpo.reserva as { id: string; importe: number };
+}
+
+const cancelar = (id: string, cuerpo: unknown = {}, socio?: string) =>
+  api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+
+test("tramos: sin penalización con 48 horas o más, 25 % con 24 a 48 y 50 % forzando con menos de 24", async () => {
+  // Pista 3 un miércoles a las 12:00: valle, 1200 céntimos.
+  let r = await reservaCon("2026-12-02T12:00", "2026-11-29T12:00");
+  let c = await cancelar(r.id);
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(c.cuerpo.reembolso, 1200);
+
+  r = await reservaCon("2026-12-02T12:00", "2026-12-01T00:00");
+  c = await cancelar(r.id);
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.penalizacion, 300);
+  assert.equal(c.cuerpo.reembolso, 900);
+
+  r = await reservaCon("2026-12-02T12:00", "2026-12-02T00:00");
+  c = await cancelar(r.id);
+  assert.equal(c.status, 409);
+  assert.equal(c.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  c = await cancelar(r.id, { forzar: true });
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.penalizacion, 600);
+  assert.equal(c.cuerpo.reembolso, 600);
+});
+
+test("límites exactos: a 48 horas no hay penalización y a 24 horas es el 25 % sin forzar", async () => {
+  let r = await reservaCon("2026-12-02T12:00", "2026-11-30T12:00");
+  let c = await cancelar(r.id);
+  assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(c.cuerpo.reembolso, 1200);
+
+  r = await reservaCon("2026-12-02T12:00", "2026-11-30T12:01");
+  c = await cancelar(r.id);
+  assert.equal(c.cuerpo.reserva.penalizacion, 300);
+
+  r = await reservaCon("2026-12-02T12:00", "2026-12-01T12:00");
+  c = await cancelar(r.id);
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.penalizacion, 300);
+  assert.equal(c.cuerpo.reembolso, 900);
+
+  r = await reservaCon("2026-12-02T12:00", "2026-12-01T12:01");
+  c = await cancelar(r.id);
+  assert.equal(c.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  await cancelar(r.id, { forzar: true });
+});
+
+test("cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  // Domingo 28 de marzo de 2027 a las 21:00 en la pista 3: punta, 2000 céntimos.
+  // Del viernes 26 a las 20:30 hay 47,5 horas reales (los relojes se adelantan esa madrugada).
+  let r = await reservaCon("2027-03-28T21:00", "2027-03-26T20:30");
+  let c = await cancelar(r.id);
+  assert.equal(c.cuerpo.reserva.penalizacion, 500);
+  assert.equal(c.cuerpo.reembolso, 1500);
+
+  // Del viernes 26 a las 20:00 hay 48 horas justas.
+  r = await reservaCon("2027-03-28T21:00", "2027-03-26T20:00");
+  c = await cancelar(r.id);
+  assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+
+  // Del sábado 27 a las 20:30 hay 23,5 horas: hace falta forzar.
+  r = await reservaCon("2027-03-28T21:00", "2027-03-27T20:30");
+  c = await cancelar(r.id);
+  assert.equal(c.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  await cancelar(r.id, { forzar: true });
+
+  // En octubre los relojes se atrasan: del sábado 30 de octubre de 2027 a las 21:30
+  // al lunes 1 de noviembre a las 21:00 hay 48,5 horas, no 47,5.
+  r = await reservaCon("2027-11-01T21:00", "2027-10-30T21:30");
+  c = await cancelar(r.id);
+  assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+});
+
+test("exención: un gestor cancela sin penalización con un motivo de 10 caracteres o más", async () => {
+  const r = await reservaCon("2026-12-02T12:00", "2026-12-02T11:00");
+  const motivo = "Lesión justificada";
+
+  let c = await cancelar(r.id, { exento: true, motivo });
+  assert.equal(c.status, 401);
+  assert.equal(c.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  c = await cancelar(r.id, { exento: true, motivo }, "socio-003");
+  assert.equal(c.status, 403);
+  assert.equal(c.cuerpo.error.codigo, "SIN_PERMISO");
+  c = await cancelar(r.id, { exento: true }, GESTOR);
+  assert.equal(c.status, 400);
+  assert.equal(c.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  c = await cancelar(r.id, { exento: true, motivo: "123456789" }, GESTOR);
+  assert.equal(c.status, 400);
+  assert.equal(c.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva.estado, "confirmada");
+
+  c = await cancelar(r.id, { exento: true, motivo: "1234567890" }, GESTOR);
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.estado, "cancelada");
+  assert.equal(c.cuerpo.reserva.penalizacion, undefined);
