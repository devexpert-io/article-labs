+test("informe de caja: reservas, ingresos y penalizaciones del mes por pista y en total", async () => {
+  const otra = await arrancarApi();
+  try {
+    // Dos cancelaciones de diciembre con penalización y una sin ella; una reserva confirmada.
+    await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIO, pistaId: "pista-1", inicio: "2026-12-02T12:00" } });
