+    const c = (await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIO, pistaId: "pista-3", inicio: "2026-12-05T12:00" } })).cuerpo.reserva;
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T12:00" } });
+    assert.equal((await otra.pedir("POST", `/api/reservas/${b.id}/cancelar`)).cuerpo.reserva.penalizacion, 300);
+    assert.equal((await otra.pedir("POST", `/api/reservas/${c.id}/cancelar`)).cuerpo.reserva.penalizacion, undefined);
+    const otraMas = (await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIO, pistaId: "pista-2", inicio: "2026-12-02T09:00" } })).cuerpo.reserva;
