+    assert.deepEqual(dic.cuerpo, {
+      mes: "2026-12",
+      pistas: [
+        { pistaId: "pista-1", reservas: 1, ingresos: 1800, penalizaciones: 0, total: 1800 },
+        { pistaId: "pista-2", reservas: 0, ingresos: 0, penalizaciones: 900, total: 900 },
+        { pistaId: "pista-3", reservas: 0, ingresos: 0, penalizaciones: 300, total: 300 },
+        { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+      ],
+      total: { reservas: 1, ingresos: 1800, penalizaciones: 1200, total: 3000 },
