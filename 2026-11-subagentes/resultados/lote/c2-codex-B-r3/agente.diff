+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const datos = (inicio = "2026-11-25T09:00", codigo?: unknown) => ({ socioId: "socio-041", pistaId: "pista-1", inicio, ...(codigo !== undefined ? { codigo } : {}) });
+const reservar = (api: Api, inicio?: string, codigo?: unknown) => api.pedir("POST", "/api/reservas", { cuerpo: datos(inicio, codigo) });
+
+test("sin código guarda base y descuento, y los devuelve en detalle y listado", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const r = await reservar(api);
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.importeBase, 1800);
+  assert.equal(r.cuerpo.reserva.descuento, 0);
+  assert.equal(r.cuerpo.reserva.importe, 1800);
+  assert.equal(Object.hasOwn(r.cuerpo.reserva, "codigo"), false);
+  const detalle = await api.pedir("GET", `/api/reservas/${r.cuerpo.reserva.id}`);
+  const lista = await api.pedir("GET", "/api/reservas?fecha=2026-11-25&socio=socio-041");
+  assert.deepEqual(detalle.cuerpo.reserva, r.cuerpo.reserva);
+  assert.deepEqual(lista.cuerpo.reservas, [r.cuerpo.reserva]);
+});
+
+test("BIENVENIDA descuenta 50 % y cualquier reserva anterior, incluso cancelada, impide reutilizarlo", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const r = await reservar(api, undefined, "BIENVENIDA");
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.importeBase, 1800);
+  assert.equal(r.cuerpo.reserva.descuento, 900);
+  assert.equal(r.cuerpo.reserva.importe, 900);
+  assert.equal(r.cuerpo.reserva.codigo, "BIENVENIDA");
+  const detalle = await api.pedir("GET", `/api/reservas/${r.cuerpo.reserva.id}`);
+  assert.deepEqual(detalle.cuerpo.reserva, r.cuerpo.reserva);
+  assert.deepEqual((await api.pedir("GET", "/api/reservas?fecha=2026-11-25&socio=socio-041")).cuerpo.reservas, [r.cuerpo.reserva]);
+  assert.equal((await reservar(api, "2026-11-26T09:00", "BIENVENIDA")).cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+  const repetido = await reservar(api, "2026-11-26T09:00", "BIENVENIDA");
+  assert.equal(repetido.status, 409);
+  assert.equal(repetido.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("BIENVENIDA usa la fecha del club con el 31 de diciembre incluido", async (t) => {
+  for (const [ahora, status] of [["2026-12-31T23:59", 201], ["2027-01-01T00:00", 409]] as const) {
+    const api = await arrancarApi({ AHORA: ahora }); t.after(() => api.cerrar());
+    const r = await reservar(api, "2027-01-04T09:00", "BIENVENIDA");
+    assert.equal(r.status, status);
+    if (status === 409) assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }
+});
+
+test("MANANAS solo vale de lunes a viernes antes de las 12 y no caduca", async (t) => {
+  const api = await arrancarApi({ AHORA: "2027-01-01T00:00" }); t.after(() => api.cerrar());
+  for (const inicio of ["2027-01-04T09:00", "2027-01-08T10:30"]) {
+    const r = await reservar(api, inicio, "MANANAS");
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.descuento, 400);
+    assert.equal(r.cuerpo.reserva.importe, 1400);
+  }
+  for (const inicio of ["2027-01-04T12:00", "2027-01-09T09:00", "2027-01-10T10:30"]) {
+    const r = await reservar(api, inicio, "MANANAS");
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }
+});
+
+test("CLUB10 normaliza código, limita tres usos históricos y libera los cancelados", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const reservas = [];
+  for (const inicio of ["2026-11-25T09:00", "2026-11-26T18:00", "2026-11-28T09:00"]) {
+    const r = await reservar(api, inicio, "  club10 ");
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.codigo, "CLUB10");
+    assert.equal(r.cuerpo.reserva.descuento, r.cuerpo.reserva.importeBase / 10);
+    reservas.push(r.cuerpo.reserva);
+  }
+  // Antes de agotar el cupón se sigue aplicando el límite ordinario de reservas.
+  assert.equal((await reservar(api, "2026-12-01T09:00", "CLUB10")).cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+  await api.pedir("POST", `/api/reservas/${reservas[2].id}/cancelar`);
+  assert.equal((await reservar(api, "2026-12-01T09:00", "CLUB10")).status, 201);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-02T00:00" } });
+  const agotado = await reservar(api, "2026-12-03T09:00", "CLUB10");
+  assert.equal(agotado.status, 409);
+  assert.equal(agotado.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("CLUB10 cuenta las no presentadas y BIENVENIDA también las considera historial", () => {
+  // No existe una ruta para marcar no presentadas: se verifica ese estado en el núcleo.
+  const estado = crearSemilla();
+  const club = crearClub(estado);
+  for (const inicio of ["2026-11-25T09:00", "2026-11-26T09:00", "2026-11-27T09:00"]) {
+    club.crearReserva(datos(inicio, "CLUB10")).reserva.estado = "no_presentada";
+  }
+  for (const codigo of ["CLUB10", "BIENVENIDA"]) {
+    assert.throws(() => club.crearReserva(datos("2026-12-01T09:00", codigo)), { codigo: "CODIGO_NO_APLICABLE", http: 409 });
+  }
+});
+
+test("rechaza códigos desconocidos, no textuales y varios códigos sin consumir la primera reserva", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  for (const codigo of ["INEXISTENTE", "", "CLUB10,MANANAS"]) {
+    const r = await reservar(api, undefined, codigo);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_INVALIDO");
+  }
+  for (const codigo of [null, 10, false, ["CLUB10", "MANANAS"], { codigo: "CLUB10" }]) {
+    const r = await reservar(api, undefined, codigo);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await reservar(api, undefined, "BIENVENIDA")).status, 201);
+});
+
+test("las reglas del club tienen prioridad y un fallo no consume el código", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const casos = [
+    [{ socioId: "socio-011" }, "CUOTA_INACTIVA"],
+    [{ pistaId: "pista-4" }, "PISTA_CERRADA"],
+    [{ pistaId: "no-existe" }, "PISTA_NO_ENCONTRADA"],
+    [{ inicio: "2026-11-25T09:15" }, "FRANJA_INVALIDA"],
+    [{ inicio: "2026-11-18T09:00" }, "FRANJA_PASADA"],
+    [{ inicio: "2026-11-19T19:30" }, "FRANJA_NO_DISPONIBLE"],
+  ] as const;
+  for (const [cambios, error] of casos) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { ...datos(undefined, "inexistente"), ...cambios } });
+    assert.equal(r.cuerpo.error.codigo, error);
+  }
+  assert.equal((await reservar(api, undefined, "BIENVENIDA")).status, 201);
+});
+
+test("la cancelación tardía cobra el importe descontado y disponibilidad conserva el precio base", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const r = await reservar(api, "2026-11-25T09:00", "MANANAS");
+  assert.equal(r.status, 201);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-24T10:00" } });
+  const cancelada = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1400);
+  const disponibilidad = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-25&pista=pista-1");
+  assert.equal(disponibilidad.cuerpo.pistas[0].franjas[0].precio, 1800);
+});
