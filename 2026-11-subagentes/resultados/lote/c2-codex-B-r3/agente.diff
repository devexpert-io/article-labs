+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado } from "../src/tipos.ts";
+
+let api: Api;
+before(async () => { api = await arrancarApi(); });
+after(() => api.cerrar());
+const gestor = { socio: "socio-040" };
+const cabecera = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+const ruta = "/api/reservas/exportar?desde=2026-10-01&hasta=2026-11-24";
+
+test("CSV exige identidad de gestor", async () => {
+  for (const [opciones, status, codigo] of [
+    [{}, 401, "NO_IDENTIFICADO"],
+    [{ socio: "socio-001" }, 403, "SIN_PERMISO"],
+    [{ socio: "socio-desconocido" }, 401, "NO_IDENTIFICADO"],
+  ] as const) {
+    const respuesta = await api.pedir("GET", ruta, opciones);
+    assert.equal(respuesta.status, status);
+    assert.equal(respuesta.cuerpo.error.codigo, codigo);
+  }
+});
+
+test("CSV devuelve cabeceras, todas las filas ordenadas e importes en euros con CRLF", async () => {
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const listadoAntes = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-11-24&limite=100&pagina=2");
+  const respuesta = await api.pedir("GET", ruta, gestor);
+  assert.equal(respuesta.status, 200);
+  assert.equal(respuesta.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(respuesta.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-11-24.csv"');
+  const lineas = respuesta.texto.split("\r\n");
+  assert.equal(lineas.shift(), cabecera);
+  assert.equal(lineas.pop(), "", "la última línea termina en CRLF");
+  assert.ok(lineas.length > 100, "no se aplica paginación");
+  assert.equal(respuesta.texto.replaceAll("\r\n", "").includes("\n"), false);
+  const esperadas = estado.reservas.filter((r) => r.inicio >= "2026-10-01" && r.inicio < "2026-11-25")
+    .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.pistaId.localeCompare(b.pistaId));
+  assert.deepEqual(lineas.map((l) => l.split(",")[0]), esperadas.map((r) => r.id));
+  assert.deepEqual(new Set(lineas.map((l) => l.split(",")[6])), new Set(["confirmada", "cancelada", "no_presentada"]));
+  for (const [i, r] of esperadas.entries()) {
+    const campos = lineas[i]!.split(",");
+    const socio = estado.socios.find((s) => s.id === r.socioId)!;
+    assert.deepEqual(campos.slice(1, 7), [r.inicio.slice(0, 10), r.inicio.slice(11),
+      estado.pistas.find((p) => p.id === r.pistaId)!.nombre, socio.nombre, socio.email, r.estado]);
+    assert.equal(campos[7], (r.importe / 100).toFixed(2));
+    assert.equal(campos[8], "");
+  }
+  const listadoDespues = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-11-24&limite=100&pagina=2");
+  assert.equal(listadoAntes.status, 200);
+  assert.deepEqual(listadoDespues.cuerpo, listadoAntes.cuerpo);
+  assert.equal(listadoDespues.cabeceras.get("content-type"), "application/json; charset=utf-8");
+});
+
+test("CSV incluye los dos extremos del periodo y permite filtrar cada estado", async () => {
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  for (const filtro of ["confirmada", "cancelada", "no_presentada"]) {
+    const respuesta = await api.pedir("GET", `/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-02&estado=${filtro}`, gestor);
+    const filas = respuesta.texto.split("\r\n").slice(1, -1);
+    const esperadas = estado.reservas.filter((r) => r.inicio.slice(0, 10) >= "2026-10-01" &&
+      r.inicio.slice(0, 10) <= "2026-10-02" && r.estado === filtro);
+    assert.equal(respuesta.status, 200);
+    assert.deepEqual(filas.map((l) => l.split(",")[0]), esperadas.map((r) => r.id));
+  }
+  const vacio = await api.pedir("GET", "/api/reservas/exportar?desde=2027-01-01&hasta=2027-01-01", gestor);
+  assert.equal(vacio.texto, cabecera + "\r\n");
+});
+
+test("CSV valida fechas, orden, estado y el máximo inclusivo de 92 días", async () => {
+  for (const consulta of [
+    "", "desde=2026-10-01", "hasta=2026-10-31", "desde=&hasta=2026-10-31",
+    "desde=01-10-2026&hasta=2026-10-31", "desde=2026-10-32&hasta=2026-11-01",
+    "desde=2026-02-30&hasta=2026-03-01", "desde=2026-11-01&hasta=2026-10-31",
+    "desde=2026-10-01&hasta=2026-10-31&estado=pendiente", "desde=2026-10-01&hasta=2026-10-31&estado=",
+  ]) {
+    const respuesta = await api.pedir("GET", `/api/reservas/exportar?${consulta}`, gestor);
+    assert.equal(respuesta.status, 400, consulta);
+    assert.equal(respuesta.cuerpo.error.codigo, "DATOS_INVALIDOS", consulta);
+  }
+  assert.equal((await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2026-12-31", gestor)).status, 200);
+  const excesivo = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2027-01-01", gestor);
+  assert.equal(excesivo.status, 400);
+  assert.equal(excesivo.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+});
+
+test("CSV escapa comas, comillas y saltos de línea y muestra la penalización", async () => {
+  const notas = ['Trae, bolas', 'Dice "hola"', "Primera línea\nSegunda línea\r\nTercera línea"];
+  const notasCsv = ['"Trae, bolas"', '"Dice ""hola"""', '"Primera línea\nSegunda línea\r\nTercera línea"'];
+  for (let i = 0; i < notas.length; i++) {
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `2027-01-0${i + 1}T09:00`, notas: notas[i] },
+    });
+    assert.equal(creada.status, 201);
+    const exportada = await api.pedir("GET", `/api/reservas/exportar?desde=2027-01-0${i + 1}&hasta=2027-01-0${i + 1}`, gestor);
+    assert.equal(exportada.texto, `${cabecera}\r\n${creada.cuerpo.reserva.id},2027-01-0${i + 1},09:00,Pista 1,Nora Benítez,nora.benitez@example.com,confirmada,${i === 0 ? "18.00" : "28.00"},,${notasCsv[i]}\r\n`);
+  }
+  const cancelada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  const exportada = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19&estado=cancelada", gestor);
+  assert.ok(exportada.texto.includes("R-0520,2026-11-19,09:00,Pista 3,Marta López,marta.lopez@example.com,cancelada,12.00,12.00,\r\n"));
+});
