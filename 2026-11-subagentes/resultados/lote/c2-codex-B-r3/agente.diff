+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi } from "./ayuda.ts";
+
+test("cancelar una reserva con descuento asigna el precio base y exporta los importes de ambas", async () => {
+  const api = await arrancarApi();
+  try {
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T09:00", codigo: "BIENVENIDA" },
+    });
+    assert.equal(creada.status, 201);
+    assert.equal(creada.cuerpo.reserva.importe, 900);
+    const espera = await api.pedir("POST", "/api/esperas", {
+      socio: "socio-002", cuerpo: { pistaId: "pista-1", inicio: "2026-11-26T09:00" },
+    });
+    assert.equal(espera.status, 201);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T08:00" } });
+    const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`, {
+      cuerpo: { forzar: true },
+    });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 900);
+    assert.ok(cancelada.cuerpo.asignadaA);
+    const asignada = await api.pedir("GET", `/api/reservas/${cancelada.cuerpo.asignadaA}`);
+    assert.equal(asignada.cuerpo.reserva.socioId, "socio-002");
+    assert.equal(asignada.cuerpo.reserva.importeBase, 1800);
+    assert.equal(asignada.cuerpo.reserva.descuento, 0);
+    assert.equal(asignada.cuerpo.reserva.importe, 1800);
+    assert.equal(asignada.cuerpo.reserva.codigo, undefined);
+    const csv = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-26&hasta=2026-11-26", { socio: "socio-040" });
+    assert.equal(csv.status, 200);
+    const filas = csv.texto.split("\r\n");
+    assert.ok(filas.some((fila) => fila.startsWith(`${creada.cuerpo.reserva.id},`) && fila.includes(",cancelada,9.00,9.00,")));
+    assert.ok(filas.some((fila) => fila.startsWith(`${cancelada.cuerpo.asignadaA},`) && fila.endsWith(",confirmada,18.00,,Asignada desde la lista de espera")));
+    assert.deepEqual((await api.pedir("GET", "/api/esperas", { socio: "socio-002" })).cuerpo.esperas, []);
+  } finally {
+    api.cerrar();
+  }
+});
