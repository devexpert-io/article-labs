+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+const franja = { pistaId: "pista-1", inicio: "2026-12-01T18:00" };
+const nora = "socio-041";
+const marta = "socio-002";
+async function ocupar(api: Api, inicio = franja.inicio) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { ...franja, inicio, socioId: nora } });
+  assert.equal(r.status, 201);
+  return r.cuerpo.reserva;
+}
+async function apuntar(api: Api, socio = marta, inicio = franja.inicio) {
+  return api.pedir("POST", "/api/esperas", { socio, cuerpo: { ...franja, inicio } });
+}
+
+test("esperas: identificación, comprobaciones de reserva, duplicados y límite", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const r = await ocupar(api);
+  for (const metodo of ["GET", "POST", "DELETE"]) {
+    const respuesta = await api.pedir(metodo, metodo === "DELETE" ? "/api/esperas/E-0001" : "/api/esperas", { cuerpo: metodo === "POST" ? franja : undefined });
+    assert.equal(respuesta.status, 401); assert.equal(respuesta.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  }
