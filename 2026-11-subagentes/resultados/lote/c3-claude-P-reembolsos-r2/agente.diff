+++ b/test/reembolsos.test.ts
@@ -0,0 +1,201 @@
+// Penalizaciones escalonadas, exención por un gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+// Marta López, jueves 19 a las 09:00 en la pista 3 (1200 céntimos): faltan 23 horas.
+const DE_MARTA = "R-0520";
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function reservar(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, `reservar ${pistaId} ${inicio}: ${r.texto}`);
+  return r.cuerpo.reserva as { id: string; importe: number };
+}
+
+const cancelar = (api: Api, id: string, cuerpo: unknown = {}, socio?: string) =>
+  api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+
+test("tramos: sin penalización con 48 horas o más, 25 % entre 24 y 48, 50 % y forzar con menos de 24", () =>
+  conApi(async (api) => {
+    const lejana = await reservar(api, "socio-041", "pista-3", "2026-11-24T12:00");
+    const media = await reservar(api, "socio-041", "pista-3", "2026-11-24T13:30");
+    // 49,5 horas antes: gratis.
+    await reloj(api, "2026-11-22T10:30");
+    const gratis = await cancelar(api, lejana.id);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.estado, "cancelada");
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, 1200);
+    // 47 horas antes: 25 %, sin forzar.
+    await reloj(api, "2026-11-22T14:30");
+    const reducida = await cancelar(api, media.id);
+    assert.equal(reducida.status, 200);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, 300);
+    assert.equal(reducida.cuerpo.reembolso, 900);
+  }));
+
+test("tramos: con menos de 24 horas hace falta forzar y la penalización es el 50 %", () =>
+  conApi(async (api) => {
+    const sinForzar = await cancelar(api, DE_MARTA);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await cancelar(api, DE_MARTA, { forzar: true });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+    assert.equal(forzada.cuerpo.reembolso, 600);
+  }));
+
+test("límites exactos: a 48 horas justas no hay penalización y a 24 justas es el 25 % sin forzar", () =>
+  conApi(async (api) => {
+    const a48 = await reservar(api, "socio-041", "pista-3", "2026-11-24T12:00");
+    const a24 = await reservar(api, "socio-041", "pista-3", "2026-11-24T13:30");
+    await reloj(api, "2026-11-22T12:00");
+    const justa48 = await cancelar(api, a48.id);
+    assert.equal(justa48.status, 200);
+    assert.equal(justa48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(justa48.cuerpo.reembolso, 1200);
+    await reloj(api, "2026-11-23T13:30");
+    const justa24 = await cancelar(api, a24.id);
+    assert.equal(justa24.status, 200);
+    assert.equal(justa24.cuerpo.reserva.penalizacion, 300);
+    assert.equal(justa24.cuerpo.reembolso, 900);
+  }));
+
+test("cambio de hora: la antelación se cuenta en horas reales de Madrid", () =>
+  conApi(async (api) => {
+    // Primavera: del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales.
+    await reloj(api, "2027-03-26T20:30");
+    const primavera = await reservar(api, "socio-041", "pista-3", "2027-03-28T21:00");
+    const cancelada = await cancelar(api, primavera.id);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, primavera.importe / 4);
+    assert.equal(cancelada.cuerpo.reembolso, primavera.importe - primavera.importe / 4);
+    // Otoño: del viernes 29 de octubre de 2027 a las 21:30 al domingo 31 a las 21:00 hay 48,5 horas reales.
+    await reloj(api, "2027-10-29T21:30");
+    const otono = await reservar(api, "socio-041", "pista-3", "2027-10-31T21:00");
+    const gratis = await cancelar(api, otono.id);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, otono.importe);
+  }));
+
+test("exención: un gestor cancela sin penalización con un motivo, sin forzar", () =>
+  conApi(async (api) => {
+    const sinIdentificar = await cancelar(api, DE_MARTA, { exento: true, motivo: "Lesión con parte médico" });
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await cancelar(api, DE_MARTA, { exento: true, motivo: "Lesión con parte médico" }, "socio-002");
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+    const sinMotivo = await cancelar(api, DE_MARTA, { exento: true }, GESTOR);
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const corto = await cancelar(api, DE_MARTA, { exento: true, motivo: "Lesión" }, GESTOR);
+    assert.equal(corto.status, 400);
+    assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const sigue = await api.pedir("GET", `/api/reservas/${DE_MARTA}`);
+    assert.equal(sigue.cuerpo.reserva.estado, "confirmada");
+    const exenta = await cancelar(api, DE_MARTA, { exento: true, motivo: "Lesión con parte médico" }, GESTOR);
+    assert.equal(exenta.status, 200);
+    assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "Lesión con parte médico");
+    assert.equal(exenta.cuerpo.reembolso, 1200);
+  }));
+
+test("reservas pasadas: no se cancelan, tampoco con exento", () =>
+  conApi(async (api) => {
+    const pasadas = await api.pedir("GET", "/api/reservas?fecha=2026-11-17&estado=confirmada&limite=1");
+    const id = pasadas.cuerpo.reservas[0].id;
+    const normal = await cancelar(api, id, { forzar: true });
+    assert.equal(normal.status, 409);
+    assert.equal(normal.cuerpo.error.codigo, "RESERVA_PASADA");
+    const exenta = await cancelar(api, id, { exento: true, motivo: "Lesión con parte médico" }, GESTOR);
+    assert.equal(exenta.status, 409);
+    assert.equal(exenta.cuerpo.error.codigo, "RESERVA_PASADA");
+  }));
+
+test("informe de caja: solo para gestores y con mes AAAA-MM", () =>
+  conApi(async (api) => {
+    const sinIdentificar = await api.pedir("GET", "/api/informes/caja?mes=2026-10");
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
