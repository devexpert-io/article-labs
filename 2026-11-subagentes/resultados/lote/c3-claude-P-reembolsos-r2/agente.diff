+test("informe de caja: reservas, ingresos y penalizaciones por pista y del club", () =>
+  conApi(async (api) => {
+    // Una penalización en noviembre (50 % de 1200) y otra que cuenta en diciembre.
+    await cancelar(api, DE_MARTA, { forzar: true });
+    const diciembre = await reservar(api, "socio-041", "pista-1", "2026-12-01T19:30");
+    await reloj(api, "2026-11-30T20:00");
+    await cancelar(api, diciembre.id, { forzar: true });
+
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    for (const mes of ["2026-10", "2026-11", "2026-12", "2027-01"]) {
