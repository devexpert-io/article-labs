+test("lo demás no cambia: las reservas ya canceladas conservan su penalización", () =>
+  conApi(async (api) => {
+    const antes = (await api.pedir("GET", "/_estado")).cuerpo.reservas.filter((r: any) => r.estado === "cancelada");
