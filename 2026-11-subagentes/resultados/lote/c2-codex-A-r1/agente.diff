+    const r = await api.pedir(metodo!, ruta!);
+    assert.equal(r.status, 401);
+    assert.equal(r.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  }
+  for (const [cuerpo, socio, codigo, status] of [
+    [{}, "socio-041", "DATOS_INVALIDOS", 400],
+    [{ ...franja, pistaId: "no-existe" }, "socio-041", "PISTA_NO_ENCONTRADA", 404],
+    [{ ...franja, pistaId: "pista-4" }, "socio-041", "PISTA_CERRADA", 409],
+    [{ ...franja, inicio: "2026-11-19T11:00" }, "socio-041", "FRANJA_INVALIDA", 400],
+    [{ ...franja, inicio: "2026-11-18T09:00" }, "socio-041", "FRANJA_PASADA", 409],
+    [{ ...franja, pistaId: "pista-2" }, "socio-041", "FRANJA_LIBRE", 409],
+    [franja, "socio-011", "CUOTA_INACTIVA", 409],
+    [franja, "socio-007", "YA_RESERVADA", 409],
