+  t.after(() => api.cerrar());
+  await apuntar(api, "socio-041");
+  await apuntar(api, "socio-041", { pistaId: "pista-1", inicio: "2026-11-23T18:00" });
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: franja.inicio } });
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-041" })).cuerpo.esperas.length, 1);
+  assert.equal((await apuntar(api, "socio-041", { pistaId: "pista-2", inicio: "2026-11-20T18:00" })).status, 201);
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.esperas[0].estado, "descartada");
+  const original = estado.reservas.find((r: any) => r.pistaId === franja.pistaId && r.inicio === franja.inicio);
+  const cancelada = await api.pedir("POST", "/api/reservas/" + original.id + "/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(cancelada.cuerpo.error.codigo, "RESERVA_PASADA");
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.reservas.length, estado.reservas.length);
+});
