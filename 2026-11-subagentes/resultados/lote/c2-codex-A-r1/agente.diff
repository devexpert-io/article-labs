+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi } from "./ayuda.ts";
+
+test("descuentos: sin código, normalización, errores y reglas antes que códigos", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const datos = { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T09:00" };
+  for (const [codigo, error] of [[42, "DATOS_INVALIDOS"], [null, "DATOS_INVALIDOS"], [["CLUB10", "MANANAS"], "DATOS_INVALIDOS"], ["", "CODIGO_INVALIDO"], ["CLUB10,MANANAS", "CODIGO_INVALIDO"]] as const) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { ...datos, codigo } });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, error);
+  }
+  const cerrada = await api.pedir("POST", "/api/reservas", { cuerpo: { ...datos, pistaId: "pista-4", codigo: "inexistente" } });
+  assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+  const nueva = (await api.pedir("POST", "/api/reservas", { cuerpo: datos })).cuerpo.reserva;
+  assert.equal(nueva.importeBase, 1800);
+  assert.equal(nueva.importe, 1800);
+  assert.equal(nueva.descuento, 0);
+  assert.equal("codigo" in nueva, false);
+  const club = (await api.pedir("POST", "/api/reservas", { cuerpo: { ...datos, inicio: "2026-12-01T10:30", codigo: "  club10 " } })).cuerpo.reserva;
+  assert.equal(club.codigo, "CLUB10");
+  assert.equal(club.descuento, 180);
+  assert.deepEqual((await api.pedir("GET", "/api/reservas/" + club.id)).cuerpo.reserva, club);
+  assert.deepEqual((await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.reservas, [nueva, club]);
+  const disponibilidad = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-01&pista=pista-1")).cuerpo;
+  assert.equal(disponibilidad.pistas[0].franjas[0].precio, 1800);
+});
+
+test("BIENVENIDA: primera reserva, historial cancelado, caducidad y penalización", async (t) => {
+  const api = await arrancarApi({ AHORA: "2026-12-31T23:59" });
+  t.after(() => api.cerrar());
+  const datos = { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-01T09:00", codigo: "bienvenida" };
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: datos });
+  assert.equal(creada.status, 201);
+  assert.equal(creada.cuerpo.reserva.importeBase, 1800);
+  assert.equal(creada.cuerpo.reserva.descuento, 900);
+  assert.equal(creada.cuerpo.reserva.importe, 900);
+  const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 900);
+  assert.equal((await api.pedir("POST", "/api/reservas", { cuerpo: datos })).cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  const historial = await api.pedir("POST", "/api/reservas", { cuerpo: { ...datos, socioId: "socio-004" } });
+  assert.equal(historial.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  const otra = await arrancarApi({ AHORA: "2027-01-01T00:00" });
+  t.after(() => otra.cerrar());
+  assert.equal((await otra.pedir("POST", "/api/reservas", { cuerpo: datos })).cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("MANANAS: días laborables y límite de mediodía", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const inicio of ["2026-12-01T12:00", "2026-12-05T09:00", "2026-12-06T10:30", "2026-12-01T18:00"]) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio, codigo: "MANANAS" } });
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }
+  for (const inicio of ["2026-12-01T09:00", "2026-12-04T10:30"]) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio, codigo: "MANANAS" } });
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.descuento, 400);
+    assert.equal(r.cuerpo.reserva.importe, 800);
+  }
+});
+
+test("CLUB10: tres usos, cancelaciones liberan usos y errores no los consumen", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const ids: string[] = [];
+  for (const dia of ["01", "02", "03"]) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `2026-12-${dia}T09:00`, codigo: "CLUB10" } });
+    assert.equal(r.status, 201);
+    ids.push(r.cuerpo.reserva.id);
+  }
+  const datos = { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-10T09:00", codigo: "CLUB10" };
+  assert.equal((await api.pedir("POST", "/api/reservas", { cuerpo: datos })).cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-04T10:00" } });
+  assert.equal((await api.pedir("POST", "/api/reservas", { cuerpo: datos })).cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  // El reloj de pruebas permite cancelar una de las reservas anteriores.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:00" } });
+  await api.pedir("POST", `/api/reservas/${ids[0]}/cancelar`);
+  assert.equal((await api.pedir("POST", "/api/reservas", { cuerpo: datos })).status, 201);
+});
