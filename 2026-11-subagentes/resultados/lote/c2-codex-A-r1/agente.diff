+    const siguiente = await api.pedir("POST", "/api/reservas/" + nueva.id + "/cancelar", { cuerpo: { forzar: true } });
+    assert.equal((await api.pedir("GET", "/api/reservas/" + siguiente.cuerpo.asignadaA)).cuerpo.reserva.socioId, "socio-004");
+    const ultima = await api.pedir("POST", "/api/reservas/" + siguiente.cuerpo.asignadaA + "/cancelar", { cuerpo: { forzar: true } });
