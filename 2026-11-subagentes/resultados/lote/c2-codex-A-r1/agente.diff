+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-31", { socio: "socio-040" });
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-10-31.csv"');
+  const filas = r.texto.split("\r\n");
+  assert.equal(filas.shift(), "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas");
+  assert.equal(filas.pop(), "");
+  const reservas = estado.reservas.filter((r: any) => r.inicio >= "2026-10-01" && r.inicio < "2026-11-01");
+  assert.equal(filas.length, 315);
+  assert.deepEqual(filas, reservas.map((r: any) => {
+    const socio = estado.socios.find((s: any) => s.id === r.socioId);
+    const pista = estado.pistas.find((p: any) => p.id === r.pistaId);
+    return [r.id, r.inicio.slice(0, 10), r.inicio.slice(11), pista.nombre, socio.nombre, socio.email, r.estado, (r.importe / 100).toFixed(2), "", r.notas].join(",");
