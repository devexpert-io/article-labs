+// Casos con cambios de cuota y no presentación: no hay endpoints para simularlos.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { crearClub, ErrorDelClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+test("asignación: una cuota que deja de estar activa descarta la espera", () => {
+  for (const conSiguiente of [false, true]) {
+    const estado = crearSemilla();
+    const club = crearClub(estado);
+    const nora = estado.socios.find((s) => s.id === "socio-041")!;
+    const irene = estado.socios.find((s) => s.id === "socio-004")!;
+    const original = estado.reservas.find((r) => r.pistaId === "pista-1" && r.inicio === "2026-11-19T19:30")!;
+    club.crearEspera(nora, original);
+    if (conSiguiente) club.crearEspera(irene, original);
+    nora.cuotaActiva = false;
+    const resultado = club.cancelarReserva(original.id, {});
+    assert.equal(estado.esperas[0]!.estado, "descartada");
+    if (conSiguiente) {
+      assert.equal(estado.reservas.find((r) => r.id === resultado.asignadaA)!.socioId, irene.id);
+    } else {
+      assert.equal(resultado.asignadaA, null);
+    }
+  }
+});
+
+test("CLUB10 cuenta las no presentadas y BIENVENIDA también rechaza ese historial", () => {
+  const estado = crearSemilla();
+  const club = crearClub(estado);
+  for (const dia of ["01", "02", "03"]) {
+    const { reserva } = club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: `2026-12-${dia}T09:00`, codigo: "CLUB10" });
+    reserva.estado = "no_presentada";
+  }
+  for (const codigo of ["CLUB10", "BIENVENIDA"]) {
+    assert.throws(() => club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-04T09:00", codigo }),
+      (error) => error instanceof ErrorDelClub && error.codigo === "CODIGO_NO_APLICABLE");
+  }
+});
+
+test("el descuento fijo nunca deja un importe negativo", () => {
+  const estado = crearSemilla();
+  estado.pistas[0]!.precioValle = 300;
+  const club = crearClub(estado);
+  const { reserva } = club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T09:00", codigo: "MANANAS" });
+  assert.equal(reserva.importeBase, 300);
+  assert.equal(reserva.descuento, 300);
+  assert.equal(reserva.importe, 0);
+});
