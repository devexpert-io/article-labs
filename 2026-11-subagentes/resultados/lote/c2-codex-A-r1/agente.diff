+    const r = await api.pedir("POST", "/api/esperas", { socio, cuerpo });
+    assert.equal(r.status, status);
+    assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+  assert.equal((await apuntar(api, "socio-041")).status, 201);
+  assert.equal((await apuntar(api, "socio-041")).cuerpo.error.codigo, "YA_EN_ESPERA");
+  assert.equal((await apuntar(api, "socio-041", { pistaId: "pista-1", inicio: "2026-11-23T18:00" })).status, 201);
+  assert.equal((await apuntar(api, "socio-041", { pistaId: "pista-2", inicio: "2026-11-20T18:00" })).cuerpo.error.codigo, "LIMITE_DE_ESPERAS");
