+    assert.equal(filtrado.texto.split("\r\n").length - 2, reservas.filter((r: any) => r.estado === filtro).length);
+  }
+  assert.deepEqual((await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31")).cuerpo, antes);
+  const nueva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T09:00", notas: 'Hola, "Nora"\nsegunda\rlínea' } });
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T08:00" } });
+  await api.pedir("POST", `/api/reservas/${nueva.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  const especial = await api.pedir("GET", "/api/reservas/exportar?desde=2026-12-01&hasta=2026-12-01", { socio: "socio-040" });
+  assert.equal(especial.texto, 'id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas\r\n' +
+    `${nueva.cuerpo.reserva.id},2026-12-01,09:00,Pista 1,Nora Benítez,nora.benitez@example.com,cancelada,18.00,18.00,"Hola, ""Nora""\nsegunda\rlínea"\r\n`);
+  const vacio = await api.pedir("GET", "/api/reservas/exportar?desde=2027-01-01&hasta=2027-01-01", { socio: "socio-040" });
+  assert.equal(vacio.texto, "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas\r\n");
+});
