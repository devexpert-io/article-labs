+        .sort((a, b) => a.id.localeCompare(b.id))
+        .map(conPosicion);
+      return { esperas };
+    },
+
+    retirarEspera(quien: Socio, id: string) {
+      const espera = estado.esperas.find((e) => e.id === id);
+      if (!espera) throw new ErrorDelClub("ESPERA_NO_ENCONTRADA", `No existe la espera ${id}`, 404);
+      if (espera.socioId !== quien.id && quien.rol !== "gestor") {
+        throw new ErrorDelClub("SIN_PERMISO", "No puedes retirar la espera de otro socio", 403);
+      }
+      espera.estado = "retirada";
+      return { espera: conPosicion(espera) };
     },
   };
 }
