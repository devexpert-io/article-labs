@@ -0,0 +1,113 @@
+// Exportar reservas a CSV, probado a través de la API.
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+beforeEach(async () => {
+  api = await arrancarApi();
+});
+afterEach(() => api.cerrar());
+
+const gestor = "socio-040";
+const ruta = (q: string) => `/api/reservas/exportar?${q}`;
+
+test("solo un gestor puede exportar", async () => {
+  const sinIdentidad = await api.pedir("GET", ruta("desde=2026-11-01&hasta=2026-11-30"));
+  assert.equal(sinIdentidad.status, 401);
+  assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const sinPermiso = await api.pedir("GET", ruta("desde=2026-11-01&hasta=2026-11-30"), { socio: "socio-001" });
+  assert.equal(sinPermiso.status, 403);
+  assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const ok = await api.pedir("GET", ruta("desde=2026-11-01&hasta=2026-11-30"), { socio: gestor });
+  assert.equal(ok.status, 200);
+});
+
+test("responde con el content-type y el content-disposition del periodo", async () => {
+  const r = await api.pedir("GET", ruta("desde=2026-11-01&hasta=2026-11-30"), { socio: gestor });
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-11-01-2026-11-30.csv"');
+});
+
+test("la primera línea es la cabecera exacta y todo termina en CRLF", async () => {
+  const r = await api.pedir("GET", ruta("desde=2026-11-01&hasta=2026-11-30"), { socio: gestor });
+  const lineas = r.texto.split("\r\n");
+  assert.equal(lineas[0], "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas");
+  assert.ok(r.texto.endsWith("\r\n"));
+});
+
+test("hay una fila por reserva del periodo, en cualquier estado", async () => {
+  const r = await api.pedir("GET", ruta("desde=2026-11-01&hasta=2026-11-30"), { socio: gestor });
+  const lista = await api.pedir("GET", "/api/reservas?desde=2026-11-01&hasta=2026-11-30&limite=1");
+  const lineas = r.texto.split("\r\n").filter((l) => l !== "");
+  assert.equal(lineas.length - 1, lista.cuerpo.total, "una fila por reserva más la cabecera");
+});
+
+test("una fila concreta lleva nombre, email y los importes en euros", async () => {
+  const r = await api.pedir("GET", ruta("desde=2026-11-23&hasta=2026-11-23"), { socio: gestor });
+  const fila = r.texto.split("\r\n").find((l) => l.includes(",2026-11-23,18:00,"));
+  assert.ok(fila, "debe existir la reserva de Irene del 23 a las 18:00");
+  const campos = fila.split(",");
+  assert.equal(campos[1], "2026-11-23");
+  assert.equal(campos[2], "18:00");
+  assert.equal(campos[3], "Pista 1");
+  assert.equal(campos[4], "Irene Sanz");
+  assert.equal(campos[5], "irene.sanz@example.com");
+  assert.equal(campos[6], "confirmada");
+  assert.equal(campos[7], "28.00");
+  assert.equal(campos[8], "", "sin penalización el campo va vacío");
+  assert.equal(campos[9], "");
+});
+
+test("los campos con comas, comillas o saltos de línea se escapan", async () => {
+  const notas = 'Trae palas, "propias"\ny toallas';
+  const creada = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00", notas },
+  });
+  assert.equal(creada.status, 201);
+  const r = await api.pedir("GET", ruta("desde=2026-11-25&hasta=2026-11-25"), { socio: gestor });
+  assert.ok(r.texto.includes('"Trae palas, ""propias""\ny toallas"'));
+});
+
+test("valida el periodo: obligatorio, formato, orden y máximo de 92 días", async () => {
+  const falta = await api.pedir("GET", ruta("hasta=2026-11-30"), { socio: gestor });
+  assert.equal(falta.status, 400);
+  assert.equal(falta.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const malFormato = await api.pedir("GET", ruta("desde=2026-11-01&hasta=hola"), { socio: gestor });
+  assert.equal(malFormato.status, 400);
+  assert.equal(malFormato.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const invertido = await api.pedir("GET", ruta("desde=2026-11-30&hasta=2026-11-01"), { socio: gestor });
+  assert.equal(invertido.status, 400);
+  assert.equal(invertido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const grande = await api.pedir("GET", ruta("desde=2026-01-01&hasta=2026-12-31"), { socio: gestor });
+  assert.equal(grande.status, 400);
+  assert.equal(grande.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+
+  // 92 días contando los dos extremos vale.
+  const exacto = await api.pedir("GET", ruta("desde=2026-01-01&hasta=2026-04-02"), { socio: gestor });
+  assert.equal(exacto.status, 200);
+});
+
+test("el filtro de estado valida su valor y filtra las filas", async () => {
+  const invalido = await api.pedir("GET", ruta("desde=2026-11-23&hasta=2026-11-23&estado=en_juego"), { socio: gestor });
+  assert.equal(invalido.status, 400);
+  assert.equal(invalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const confirmadas = await api.pedir("GET", ruta("desde=2026-11-23&hasta=2026-11-23&estado=confirmada"), { socio: gestor });
+  for (const linea of confirmadas.texto.split("\r\n").filter((l) => l !== "").slice(1)) {
+    assert.equal(linea.split(",")[6], "confirmada");
+  }
+});
+
+test("GET /api/reservas sigue respondiendo igual que antes", async () => {
+  const lista = await api.pedir("GET", "/api/reservas?desde=2026-11-01&hasta=2026-11-30&limite=1");
+  assert.equal(lista.status, 200);
+  assert.ok(typeof lista.cuerpo.total === "number");
+  assert.ok(Array.isArray(lista.cuerpo.reservas));
+});
diff --git a/test/lista-espera.test.ts b/test/lista-espera.test.ts
