diff --git a/test/codigos-descuento.test.ts b/test/codigos-descuento.test.ts
new file mode 100644
index 0000000..a299ac1
--- /dev/null
+++ b/test/codigos-descuento.test.ts
@@ -0,0 +1,140 @@
+// Códigos de descuento al reservar, probado a través de la API.
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+beforeEach(async () => {
+  api = await arrancarApi();
+});
+afterEach(() => api.cerrar());
+
+const reserva = (cuerpo: Record<string, unknown>) => api.pedir("POST", "/api/reservas", { cuerpo });
+
+test("sin código, la reserva se crea como antes", async () => {
+  const r = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00" });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.importeBase, 1800);
+  assert.equal(r.cuerpo.reserva.descuento, 0);
+  assert.equal(r.cuerpo.reserva.importe, 1800);
+  assert.equal(r.cuerpo.reserva.codigo, undefined);
+});
+
+test("BIENVENIDA descuenta el 50 % solo en la primera reserva", async () => {
+  const r = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "BIENVENIDA" });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.importeBase, 1800);
+  assert.equal(r.cuerpo.reserva.descuento, 900);
+  assert.equal(r.cuerpo.reserva.importe, 900);
+  assert.equal(r.cuerpo.reserva.codigo, "BIENVENIDA");
+
+  const segunda = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T09:00", codigo: "BIENVENIDA" });
+  assert.equal(segunda.status, 409);
+  assert.equal(segunda.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("BIENVENIDA caduca después del 31 de diciembre de 2026", async () => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-01T10:00" } });
+  const r = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-02T09:00", codigo: "BIENVENIDA" });
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("MANANAS descuenta 4 € solo en laborables antes de las 12:00", async () => {
+  const ok = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "MANANAS" });
+  assert.equal(ok.status, 201);
+  assert.equal(ok.cuerpo.reserva.importeBase, 1800);
+  assert.equal(ok.cuerpo.reserva.descuento, 400);
+  assert.equal(ok.cuerpo.reserva.importe, 1400);
+
+  const mediodia = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T12:00", codigo: "MANANAS" });
+  assert.equal(mediodia.status, 409);
+  assert.equal(mediodia.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+
+  const finde = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-28T09:00", codigo: "MANANAS" });
+  assert.equal(finde.status, 409);
+  assert.equal(finde.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("CLUB10 descuenta el 10 % y tiene límite de 3 reservas por socio", async () => {
+  const ok = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "CLUB10" });
+  assert.equal(ok.status, 201);
+  assert.equal(ok.cuerpo.reserva.importeBase, 1800);
+  assert.equal(ok.cuerpo.reserva.descuento, 180);
+  assert.equal(ok.cuerpo.reserva.importe, 1620);
+
+  await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T09:00", codigo: "CLUB10" });
+  await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-27T09:00", codigo: "CLUB10" });
+
+  // Mueve el reloj para que la primera deje de ser futura y no bloquee el límite de reservas.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T00:00" } });
+  const cuarta = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-28T09:00", codigo: "CLUB10" });
+  assert.equal(cuarta.status, 409);
+  assert.equal(cuarta.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("CLUB10: las reservas canceladas no cuentan para el límite", async () => {
+  const primera = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "CLUB10" });
+  await api.pedir("POST", `/api/reservas/${primera.cuerpo.reserva.id}/cancelar`);
+  for (const inicio of ["2026-11-26T09:00", "2026-11-27T09:00", "2026-11-28T09:00"]) {
+    const r = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio, codigo: "CLUB10" });
+    assert.equal(r.status, 201, `esperaba poder crear ${inicio}`);
+  }
+});
+
+test("el código no distingue mayúsculas ni espacios y valida su formato", async () => {
+  const conEspacios = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "  club10 " });
+  assert.equal(conEspacios.status, 201);
+  assert.equal(conEspacios.cuerpo.reserva.codigo, "CLUB10");
+
+  const desconocido = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T09:00", codigo: "INVENTADO" });
+  assert.equal(desconocido.status, 400);
+  assert.equal(desconocido.cuerpo.error.codigo, "CODIGO_INVALIDO");
+
+  const noTexto = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T09:00", codigo: 123 });
+  assert.equal(noTexto.status, 400);
+  assert.equal(noTexto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+});
+
+test("si la reserva no se puede hacer, el código no cuenta como usado", async () => {
+  const cerrada = await reserva({ socioId: "socio-041", pistaId: "pista-4", inicio: "2026-11-25T09:00", codigo: "BIENVENIDA" });
+  assert.equal(cerrada.status, 409);
+  assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+
+  const ok = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "BIENVENIDA" });
+  assert.equal(ok.status, 201);
+  assert.equal(ok.cuerpo.reserva.descuento, 900);
+});
+
+test("la penalización por cancelar fuera de plazo es el importe con descuento", async () => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T00:00" } });
+  const r = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "MANANAS" });
+  assert.equal(r.cuerpo.reserva.importe, 1400);
+  const cancelada = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1400);
+});
+
+test("GET devuelve importeBase, descuento, importe y codigo", async () => {
+  const r = await reserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "CLUB10" });
+  const id = r.cuerpo.reserva.id;
+
+  const una = await api.pedir("GET", `/api/reservas/${id}`);
+  assert.equal(una.cuerpo.reserva.importeBase, 1800);
+  assert.equal(una.cuerpo.reserva.descuento, 180);
+  assert.equal(una.cuerpo.reserva.importe, 1620);
+  assert.equal(una.cuerpo.reserva.codigo, "CLUB10");
+
+  const lista = await api.pedir("GET", "/api/reservas?socio=socio-041&limite=100");
+  const encontrada = lista.cuerpo.reservas.find((x: any) => x.id === id);
+  assert.equal(encontrada.importeBase, 1800);
+  assert.equal(encontrada.descuento, 180);
+  assert.equal(encontrada.importe, 1620);
+  assert.equal(encontrada.codigo, "CLUB10");
+});
+
+test("la disponibilidad sigue mostrando el precio sin descuento", async () => {
+  const d = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-25&pista=pista-1");
+  const franja = d.cuerpo.pistas[0].franjas.find((f: any) => f.inicio === "2026-11-25T09:00");
+  assert.equal(franja.precio, 1800);
+});
