+// Lista de espera de franjas, probado a través de la API.
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+beforeEach(async () => {
+  api = await arrancarApi();
+});
+afterEach(() => api.cerrar());
+
+const esperar = (cuerpo: Record<string, unknown>, socio: string) => api.pedir("POST", "/api/esperas", { cuerpo, socio });
+
+async function reservaDe(socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("GET", `/api/reservas?socio=${socioId}&pista=${pistaId}&fecha=${inicio.slice(0, 10)}&limite=100`);
+  const encontrada = r.cuerpo.reservas.find((x: any) => x.inicio === inicio && x.estado === "confirmada");
+  assert.ok(encontrada, `falta la reserva de ${socioId} en ${pistaId} ${inicio}`);
+  return encontrada;
+}
+
+test("un socio se apunta a una franja ocupada y queda activo con su posición", async () => {
+  const sin = await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-1", inicio: "2026-11-19T18:00" } });
+  assert.equal(sin.status, 401);
+  assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const r = await esperar({ pistaId: "pista-1", inicio: "2026-11-19T18:00" }, "socio-041");
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.espera.estado, "activa");
+  assert.equal(r.cuerpo.espera.posicion, 1);
+  assert.equal(r.cuerpo.espera.pistaId, "pista-1");
+  assert.equal(r.cuerpo.espera.socioId, "socio-041");
+});
+
+test("solo se puede esperar una franja ocupada y válida", async () => {
+  const libre = await esperar({ pistaId: "pista-1", inicio: "2026-11-25T09:00" }, "socio-041");
+  assert.equal(libre.status, 409);
+  assert.equal(libre.cuerpo.error.codigo, "FRANJA_LIBRE");
+
+  const pista = await esperar({ pistaId: "pista-99", inicio: "2026-11-19T18:00" }, "socio-041");
+  assert.equal(pista.status, 404);
+  assert.equal(pista.cuerpo.error.codigo, "PISTA_NO_ENCONTRADA");
+
+  const cerrada = await esperar({ pistaId: "pista-4", inicio: "2026-11-19T18:00" }, "socio-041");
+  assert.equal(cerrada.status, 409);
+  assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+
+  const invalida = await esperar({ pistaId: "pista-1", inicio: "2026-11-19T10:00" }, "socio-041");
+  assert.equal(invalida.status, 400);
+  assert.equal(invalida.cuerpo.error.codigo, "FRANJA_INVALIDA");
+
+  const pasada = await esperar({ pistaId: "pista-1", inicio: "2026-11-18T09:00" }, "socio-041");
+  assert.equal(pasada.status, 409);
+  assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+
+  const cuota = await esperar({ pistaId: "pista-1", inicio: "2026-11-19T18:00" }, "socio-011");
+  assert.equal(cuota.status, 409);
+  assert.equal(cuota.cuerpo.error.codigo, "CUOTA_INACTIVA");
+});
+
+test("no se puede duplicar, esperar lo ya reservado ni superar 2 esperas", async () => {
+  await esperar({ pistaId: "pista-1", inicio: "2026-11-19T18:00" }, "socio-041");
+  const duplicada = await esperar({ pistaId: "pista-1", inicio: "2026-11-19T18:00" }, "socio-041");
+  assert.equal(duplicada.status, 409);
+  assert.equal(duplicada.cuerpo.error.codigo, "YA_EN_ESPERA");
+
+  // socio-007 ya tiene reservada esa franja.
+  const reservada = await esperar({ pistaId: "pista-1", inicio: "2026-11-19T19:30" }, "socio-007");
+  assert.equal(reservada.status, 409);
+  assert.equal(reservada.cuerpo.error.codigo, "YA_RESERVADA");
+
+  await esperar({ pistaId: "pista-2", inicio: "2026-11-19T10:30" }, "socio-003");
+  await esperar({ pistaId: "pista-1", inicio: "2026-11-19T12:00" }, "socio-003");
+  const limite = await esperar({ pistaId: "pista-1", inicio: "2026-11-19T19:30" }, "socio-003");
+  assert.equal(limite.status, 409);
+  assert.equal(limite.cuerpo.error.codigo, "LIMITE_DE_ESPERAS");
+});
+
+test("la posición es el orden de llegada y el gestor puede consultar otras", async () => {
+  await esperar({ pistaId: "pista-1", inicio: "2026-11-19T18:00" }, "socio-041");
+  await esperar({ pistaId: "pista-1", inicio: "2026-11-19T18:00" }, "socio-003");
+
+  const mias = await api.pedir("GET", "/api/esperas", { socio: "socio-003" });
+  assert.equal(mias.status, 200);
+  assert.equal(mias.cuerpo.esperas.length, 1);
+  assert.equal(mias.cuerpo.esperas[0].posicion, 2);
+
+  const delGestor = await api.pedir("GET", "/api/esperas?socio=socio-041", { socio: "socio-040" });
+  assert.equal(delGestor.cuerpo.esperas.length, 1);
+  assert.equal(delGestor.cuerpo.esperas[0].socioId, "socio-041");
+  assert.equal(delGestor.cuerpo.esperas[0].posicion, 1);
+
+  const ajeno = await api.pedir("GET", "/api/esperas?socio=socio-041", { socio: "socio-003" });
+  assert.equal(ajeno.status, 403);
+  assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+});
+
+test("retirarse deja la espera retirada y sube a los de detrás", async () => {
+  const e1 = await esperar({ pistaId: "pista-1", inicio: "2026-11-19T18:00" }, "socio-041");
+  await esperar({ pistaId: "pista-1", inicio: "2026-11-19T18:00" }, "socio-003");
+  const id = e1.cuerpo.espera.id;
+
+  const ajeno = await api.pedir("DELETE", `/api/esperas/${id}`, { socio: "socio-005" });
+  assert.equal(ajeno.status, 403);
+  assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const retirada = await api.pedir("DELETE", `/api/esperas/${id}`, { socio: "socio-041" });
+  assert.equal(retirada.status, 200);
+  assert.equal(retirada.cuerpo.espera.estado, "retirada");
+
+  const mias = await api.pedir("GET", "/api/esperas", { socio: "socio-003" });
+  assert.equal(mias.cuerpo.esperas[0].posicion, 1);
+
+  const noExiste = await api.pedir("DELETE", "/api/esperas/E-9999", { socio: "socio-041" });
+  assert.equal(noExiste.status, 404);
+  assert.equal(noExiste.cuerpo.error.codigo, "ESPERA_NO_ENCONTRADA");
+});
+
+test("al cancelar, la franja se asigna al primero de la lista", async () => {
+  const r = await reservaDe("socio-011", "pista-1", "2026-11-19T18:00");
+  await esperar({ pistaId: "pista-1", inicio: "2026-11-19T18:00" }, "socio-041");
+
+  const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+  assert.equal(cancelada.status, 200);
+  assert.ok(cancelada.cuerpo.asignadaA);
+
+  const nueva = await api.pedir("GET", `/api/reservas/${cancelada.cuerpo.asignadaA}`);
+  assert.equal(nueva.cuerpo.reserva.socioId, "socio-041");
+  assert.equal(nueva.cuerpo.reserva.pistaId, "pista-1");
+  assert.equal(nueva.cuerpo.reserva.inicio, "2026-11-19T18:00");
+  assert.equal(nueva.cuerpo.reserva.estado, "confirmada");
+  assert.equal(nueva.cuerpo.reserva.notas, "Asignada desde la lista de espera");
+  assert.equal(nueva.cuerpo.reserva.importe, nueva.cuerpo.reserva.importeBase);
+
+  const estado = await api.pedir("GET", "/_estado");
+  assert.equal(estado.cuerpo.esperas.find((e: any) => e.socioId === "socio-041").estado, "asignada");
+});
+
+test("cancelar sin lista de espera devuelve asignadaA: null", async () => {
+  const r = await reservaDe("socio-007", "pista-1", "2026-11-19T19:30");
+  const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.asignadaA, null);
+});
+
+test("se salta a quien ya no puede reservar y se asigna al siguiente", async () => {
+  const r = await reservaDe("socio-011", "pista-1", "2026-11-19T18:00");
+  await esperar({ pistaId: "pista-1", inicio: "2026-11-19T18:00" }, "socio-041");
+  await esperar({ pistaId: "pista-1", inicio: "2026-11-19T18:00" }, "socio-002");
+
+  // socio-041 se hace con 3 reservas futuras y ya no le dejan reservar.
+  for (const inicio of ["2026-11-25T09:00", "2026-11-25T10:30", "2026-11-25T12:00"]) {
+    const c = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio } });
+    assert.equal(c.status, 201);
+  }
+
+  const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+  const nueva = await api.pedir("GET", `/api/reservas/${cancelada.cuerpo.asignadaA}`);
+  assert.equal(nueva.cuerpo.reserva.socioId, "socio-002");
+
+  const estado = await api.pedir("GET", "/_estado");
+  assert.equal(estado.cuerpo.esperas.find((e: any) => e.socioId === "socio-041").estado, "descartada");
+  assert.equal(estado.cuerpo.esperas.find((e: any) => e.socioId === "socio-002").estado, "asignada");
+});
+
+test("cuando la franja empieza, sus esperas caducan", async () => {
+  await esperar({ pistaId: "pista-1", inicio: "2026-11-19T18:00" }, "socio-041");
+  let mias = await api.pedir("GET", "/api/esperas", { socio: "socio-041" });
+  assert.equal(mias.cuerpo.esperas.length, 1);
+
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-19T18:01" } });
+  mias = await api.pedir("GET", "/api/esperas", { socio: "socio-041" });
+  assert.equal(mias.cuerpo.esperas.length, 0);
+
+  // La espera caducada ya no cuenta para el límite de 2.
+  const otra1 = await esperar({ pistaId: "pista-2", inicio: "2026-11-20T18:00" }, "socio-041");
+  assert.equal(otra1.status, 201);
+  const otra2 = await esperar({ pistaId: "pista-1", inicio: "2026-11-21T15:00" }, "socio-041");
+  assert.equal(otra2.status, 201);
+});
