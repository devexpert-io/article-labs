+export function precioPorMinutos(pista: Pista, inicio: string, duracion: number): number {
+  const dia = diaDeLaSemana(inicio.slice(0, 10));
+  const desde = minutosDelDia(inicio);
+  const hasta = desde + duracion;
+  const inicioPunta = dia === 0 || dia === 6 ? 0 : PUNTA_DESDE;
+  const valle = Math.max(0, Math.min(hasta, inicioPunta) - desde);
+  const punta = duracion - valle;
+  // Importe exacto = suma / 90. Redondeo con enteros: floor(suma / 90 + 1/2).
+  const suma = valle * pista.precioValle + punta * pista.precioPunta;
+  return Math.floor((2 * suma + MINUTOS_FRANJA) / (2 * MINUTOS_FRANJA));
