+test("5. el total se redondea al céntimo más cercano", () => {
+  // Con duraciones e inicios de media en media hora la suma de minutos × precio es múltiplo de 30, así que el resto
+  // entre 90 nunca es exactamente medio céntimo; comprobamos el redondeo contra el cálculo exacto con muchos precios.
+  const base: Pista = { id: "x", nombre: "X", tipo: "muro", cubierta: false, estado: "operativa", precioValle: 0, precioPunta: 0 };
+  for (let valle = 1; valle <= 200; valle++) {
+    for (const punta of [valle, valle + 1, valle + 7]) {
+      const pista = { ...base, precioValle: valle, precioPunta: punta };
+      for (const [inicio, duracion, mValle, mPunta] of [
+        ["2026-12-01T17:30", 60, 30, 30], ["2026-12-01T17:00", 90, 60, 30], ["2026-12-01T17:30", 120, 30, 90],
+      ] as const) {
+        const exacto = (mValle * valle + mPunta * punta) / 90;
+        const esperado = Math.floor(exacto) + (exacto - Math.floor(exacto) >= 0.5 - 1e-9 ? 1 : 0);
+        assert.equal(precioPorMinutos(pista, inicio, duracion), esperado, `${valle}/${punta} ${inicio} ${duracion}`);
+      }
+    }
+  }
+});
