@@ -0,0 +1,250 @@
+// Reservas de 60, 90 o 120 minutos (docs/specs/duraciones.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { crearSemilla, HORAS, precio, precioPorMinutos } from "../src/semilla.ts";
+import type { Pista } from "../src/tipos.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+// Socios de la semilla con la cuota al día y sin reservas futuras: cada uno puede hacer hasta 3.
+const SOCIOS_LIBRES = ["socio-006", "socio-016", "socio-020", "socio-023", "socio-024", "socio-026", "socio-027",
+  "socio-028", "socio-034", "socio-035", "socio-036", "socio-038"];
+let hechas = 0;
+/** Reserva en la API principal. Si no se indica socioId, lo pone un socio con hueco para no tropezar con el límite. */
+const reservar = async (cuerpo: Record<string, unknown>) => {
+  const socioId = cuerpo.socioId ?? SOCIOS_LIBRES[Math.floor(hechas / 3)];
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { ...cuerpo, socioId } });
+  if (cuerpo.socioId === undefined && r.status === 201) hechas += 1;
+  return r;
+};
+const pistaDelDia = async (a: Api, fecha: string, pistaId: string) =>
+  (await a.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pistaId}`)).cuerpo.pistas[0];
+
+test("1. duracion es opcional, vale 60, 90 o 120 y por defecto son 90", async () => {
+  const sin = await reservar({ pistaId: "pista-1", inicio: "2026-12-01T09:00" });
+  assert.equal(sin.status, 201);
+  assert.equal(sin.cuerpo.reserva.duracion, 90);
+  const de60 = await reservar({ pistaId: "pista-1", inicio: "2026-12-01T11:00", duracion: 60 });
+  assert.equal(de60.status, 201);
+  assert.equal(de60.cuerpo.reserva.duracion, 60);
+  const de120 = await reservar({ pistaId: "pista-1", inicio: "2026-12-01T13:00", duracion: 120 });
+  assert.equal(de120.status, 201);
+  assert.equal(de120.cuerpo.reserva.duracion, 120);
+  for (const duracion of [45, 0, 150, 90.5, "90", null, true]) {
+    const mala = await reservar({ pistaId: "pista-2", inicio: "2026-12-01T09:00", duracion });
+    assert.equal(mala.status, 400, `duracion ${JSON.stringify(duracion)}`);
+    assert.equal(mala.cuerpo.error.codigo, "DURACION_INVALIDA");
+  }
+});
+
+test("2. una reserva empieza en punto o y media, desde las 09:00, y termina como muy tarde a las 22:30", async () => {
+  const invalidos: [string, number][] = [
+    ["2026-12-01T10:15", 60], ["2026-12-01T10:45", 90], ["2026-12-01T08:30", 60], ["2026-12-01T08:00", 120],
+    ["2026-12-01T21:30", 90], ["2026-12-01T21:00", 120], ["2026-12-01T22:00", 60], ["2026-12-01T09:60", 60],
+    ["2026-12-01 10:00", 60], ["mañana", 60],
+  ];
+  for (const [inicio, duracion] of invalidos) {
+    const r = await reservar({ pistaId: "pista-2", inicio, duracion });
+    assert.equal(r.status, 400, `${inicio} ${duracion}`);
