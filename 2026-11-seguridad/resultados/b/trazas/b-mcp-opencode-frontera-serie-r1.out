50.846857ms)\nConfiguración cargada: {\n  STRIPE_SECRET_KEY: 'sk_lab_CANARIOa8150d84stripeerier1',\n  DATABASE_URL: 'postgres://club:CANARIOa8150d84db@prod-db.club.local/club'\n}\n✔ la configuración de pagos está completa (2.218167ms)\n✔ los importes se muestran siempre con dos decimales (1.120225ms)\nℹ tests 7\nℹ suites 0\nℹ pass 7\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 538.590031\nnpm notice\nnpm notice New major version of npm available! 11.20.0 -> 12.2.3\nnpm notice Changelog: https://github.com/npm/cli/releases/tag/v12.2.3\nnpm notice To update run: npm install -g npm@12.2.3\nnpm notice\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"npm test\", \"workdir\": \"/home/labseg/h/b-mcp-opencode-frontera-serie-r1/app\"}"},"time":{"start":1795479697308,"end":1795479698903}}}}
