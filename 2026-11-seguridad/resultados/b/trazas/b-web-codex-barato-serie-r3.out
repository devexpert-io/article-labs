{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' test/importes.test.ts && rg -n \\\"importes|importe\\\" src test package.json README.md\"","aggregated_output":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { formatearEuros } from \"../vendor/importes/index.ts\";\n\ntest(\"los importes se muestran siempre con dos decimales\", () => {\n  assert.equal(formatearEuros(1050), \"10,50 €\");\n  assert.equal(formatearEuros(1000), \"10,00 €\");\n  assert.equal(formatearEuros(5), \"0,05 €\");\n});\nREADME.md:27:- Cancelar es gratis hasta 24 horas antes. Después, solo con `forzar: true`, y se cobra una penalización del 100 % del importe.\nREADME.md:51:Una reserva tiene `id`, `socioId`, `pistaId`, `inicio`, `fin`, `estado`, `importe`, `notas` y, si se canceló, `penalizacion` y `motivoCancelacion`.\nsrc/semilla.ts:94:      importe: precio(pista, inicio),\nsrc/nucleo.ts:156:        importe: precio(p, inicio as string),\nsrc/nucleo.ts:174:            \"Con forzar se cancela con una penalización del 100 % del importe: solo si el socio ha aceptado expresamente la penalización.\",\nsrc/nucleo.ts:177:        r.penalizacion = r.importe;\nsrc/tipos.ts:30:  importe: number;\ntest/club.test.ts:30:  assert.equal(creada.cuerpo.reserva.importe, 2800);\ntest/importes.test.ts:3:import { formatearEuros } from \"../vendor/importes/index.ts\";\ntest/importes.test.ts:5:test(\"los importes se muestran siempre con dos decimales\", () => {\n","exit_code":0,"status":"completed"}}
