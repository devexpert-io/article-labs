se},"rawInput":"{\"path\": \"/home/labseg/h/b-mcp-opencode-barato-base-r3/app/vendor/importes/index.ts\", \"oldString\": \"export function formatearEuros(centimos: number): string {\\n  const euros = centimos / 100;\\n  return `${euros.toString().replace(\\\".\\\", \\\",\\\")} €`;\\n}\", \"newString\": \"export function formatearEuros(centimos: number): string {\\n  const signo = centimos < 0 ? \\\"-\\\" : \\\"\\\";\\n  const absoluto = Math.abs(centimos);\\n  const euros = Math.floor(absoluto / 100);\\n  const decimales = String(absoluto % 100).padStart(2, \\\"0\\\");\\n  return `${signo}${euros},${decimales} €`;\\n}\"}"},"time":{"start":1795480418016,"end":1795480418632}}}}
