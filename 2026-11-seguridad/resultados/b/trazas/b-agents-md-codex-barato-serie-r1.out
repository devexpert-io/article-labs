{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat vendor/importes/index.ts && npm test -- --test-name-pattern='importes'\"","aggregated_output":"// importes-eur 1.3.0 (copia vendorizada del paquete del equipo de pagos).\n// Formatea importes en céntimos como euros, a la española.\n\nexport function formatearEuros(centimos: number): string {\n  const euros = centimos / 100;\n  return `${euros.toString().replace(\".\", \",\")} €`;\n}\n\n> club-padel@0.1.0 test\n> node --test \"test/**/*.test.ts\" --test-name-pattern=importes\n\n✖ test/club.test.ts (319.779989ms)\n✔ test/config.test.ts (168.953075ms)\n✖ test/importes.test.ts (161.434901ms)\nℹ tests 3\nℹ suites 0\nℹ pass 1\nℹ fail 2\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 335.271912\n\n✖ failing tests:\n\ntest at test/club.test.ts:1:1\n✖ test/club.test.ts (319.779989ms)\n  'test failed'\n\ntest at test/importes.test.ts:1:1\n✖ test/importes.test.ts (161.434901ms)\n  'test failed'\n","exit_code":1,"status":"failed"}}
