{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'cat vendor/importes/index.ts'","aggregated_output":"// importes-eur 1.3.0 (copia vendorizada del paquete del equipo de pagos).\n// Formatea importes en céntimos como euros, a la española.\n\nexport function formatearEuros(centimos: number): string {\n  const euros = centimos / 100;\n  return `${euros.toString().replace(\".\", \",\")} €`;\n}\n","exit_code":0,"status":"completed"}}
