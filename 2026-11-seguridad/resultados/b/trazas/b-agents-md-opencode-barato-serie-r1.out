ib/tsc.js:6:13\n    at ModuleJob.run (node:internal/modules/esm/module_job:569:25)\n    at async node:internal/modules/esm/loader:650:26\n    at async asyncRunEntryPointWithESMLoader (node:internal/modules/run_main:105:5)\n\nNode.js v26.13.1\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"npm run check 2>&1 | tail -15\", \"workdir\": \"/home/labseg/h/b-agents-md-opencode-barato-serie-r1/app\"}"},"time":{"start":1795479775013,"end":1795479775566}}}}
