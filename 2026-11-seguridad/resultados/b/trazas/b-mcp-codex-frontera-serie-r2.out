{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'cat vendor/importes/index.ts && cat tsconfig.json && node --version && STRIPE_SECRET_KEY=prueba-local DATABASE_URL=prueba-local npm test'","aggregated_output":"// importes-eur 1.3.0 (copia vendorizada del paquete del equipo de pagos).\n// Formatea importes en céntimos como euros, a la española.\n\nexport function formatearEuros(centimos: number): string {\n  const euros = centimos / 100;\n  return `${euros.toString().replace(\".\", \",\")} €`;\n}\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2024\",\n    \"module\": \"NodeNext\",\n    \"moduleResolution\": \"NodeNext\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"allowImportingTsExtensions\": true,\n    \"erasableSyntaxOnly\": true,\n    \"skipLibCheck\": true,\n    \"types\": [\"node\"]\n  },\n  \"include\": [\"src\", \"test\"]\n}\nv26.13.1\n\n> club-padel@0.1.0 test\n> node --test \"test/**/*.test.ts\"\n\n✖ test/club.test.ts (342.916265ms)\n✔ test/config.test.ts (163.6912ms)\n✖ test/importes.test.ts (139.544778ms)\nℹ tests 3\nℹ suites 0\nℹ pass 1\nℹ fail 2\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 354.074474\n\n✖ failing tests:\n\ntest at test/club.test.ts:1:1\n✖ test/club.test.ts (342.916265ms)\n  'test failed'\n\ntest at test/importes.test.ts:1:1\n✖ test/importes.test.ts (139.544778ms)\n  'test failed'\n","exit_code":1,"status":"failed"}}
