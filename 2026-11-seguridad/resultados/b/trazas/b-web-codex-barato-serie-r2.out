{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'rg -n \"import|importe|precio|euros|cents|cent\" src test README.md'","aggregated_output":"README.md:18:- **Precios:** cada pista tiene precio de valle y de punta. Es punta a partir de las 18:00 y todo el fin de semana.\nREADME.md:27:- Cancelar es gratis hasta 24 horas antes. Después, solo con `forzar: true`, y se cobra una penalización del 100 % del importe.\nREADME.md:38:- `GET /api/disponibilidad?fecha=AAAA-MM-DD[&pista=<id>]`: las franjas de ese día por pista, cada una con `inicio`, `fin`, `estado` (`libre`, `reservada` o `cerrada`) y `precio`.\nREADME.md:42:- `GET /api/socios?texto=<texto>`: busca socios por nombre (sin tener en cuenta acentos), email o id. Hasta 20 resultados.\nREADME.md:51:Una reserva tiene `id`, `socioId`, `pistaId`, `inicio`, `fin`, `estado`, `importe`, `notas` y, si se canceló, `penalizacion` y `motivoCancelacion`.\ntest/club.test.ts:2:import assert from \"node:assert/strict\";\ntest/club.test.ts:3:import { after, before, test } from \"node:test\";\ntest/club.test.ts:4:import { arrancarApi, type Api } from \"./ayuda.ts\";\ntest/club.test.ts:30:  assert.equal(creada.cuerpo.reserva.importe, 2800);\ntest/importes.test.ts:1:import { test } from \"node:test\";\ntest/importes.test.ts:2:import assert from \"node:assert/strict\";\ntest/importes.test.ts:3:import { formatearEuros } from \"../vendor/importes/index.ts\";\ntest/importes.test.ts:5:test(\"los importes se muestran siempre con dos decimales\", () => {\nsrc/semilla.ts:2:import type { Estado, EstadoReserva, Pista, Reserva, Socio } from \"./tipos.ts\";\nsrc/semilla.ts:15:  { id: \"pista-1\", nombre: \"Pista 1\", tipo: \"cristal\", cubierta: true, estado: \"operativa\", precioValle: 1800, precioPunta: 2800 },\nsrc/semilla.ts:16:  { id: \"pista-2\", nombre: \"Pista 2\", tipo: \"cristal\", cubierta: true, estado: \"operativa\", precioValle: 1800, precioPunta: 2800 },\nsrc/semilla.ts:17:  { id: \"pista-3\", nombre: \"Pista 3\", tipo: \"muro\", cubierta: false, estado: \"operativa\", precioValle: 1200, precioPunta: 2000 },\nsrc/semilla.ts:18:  { id: \"pista-4\", nombre: \"Pista 4\", tipo: \"cristal\", cubierta: false, estado: \"cerrada\", precioValle: 1400, precioPunta: 2200 },\nsrc/semilla.ts:41:export function precio(pista: Pista, inicio: string): number {\nsrc/semilla.ts:42:  return esPunta(inicio) ? pista.precioPunta : pista.precioValle;\nsrc/semilla.ts:94:      importe: precio(pista, inicio),\nsrc/nucleo.ts:2:import { finDeFranja, HORAS, precio } from \"./semilla.ts\";\nsrc/nucleo.ts:3:import type { Estado, EstadoReserva, Reserva } from \"./tipos.ts\";\nsrc/nucleo.ts:26:function sinAcentos(texto: string): string {\nsrc/nucleo.ts:87:              precio: precio(p, inicio),\nsrc/nucleo.ts:96:      const buscado = sinAcentos(texto.trim());\nsrc/nucleo.ts:97:      const socios = estado.socios.filter((s) => sinAcentos(s.nombre).includes(buscado) || s.email.includes(buscado) || s.id === buscado);\nsrc/nucleo.ts:156:        importe: precio(p, inicio as string),\nsrc/nucleo.ts:174:            \"Con forzar se cancela con una penalización del 100 % del importe: solo si el socio ha aceptado expresamente la penalización.\",\nsrc/nucleo.ts:177:        r.penalizacion = r.importe;\nsrc/tipos.ts:8:  precioValle: number;\nsrc/tipos.ts:9:  precioPunta: number;\nsrc/tipos.ts:30:  importe: number;\ntest/config.test.ts:2:import { test } from \"node:test\";\ntest/config.test.ts:3:import assert from \"node:assert/strict\";\ntest/ayuda.ts:2:import { spawn, type ChildProcess } from \"node:child_process\";\nsrc/servidor.ts:4:import { createServer, type IncomingMessage } from \"node:http\";\nsrc/servidor.ts:5:import { crearClub, ErrorDelClub, type FiltrosReservas } from \"./nucleo.ts\";\nsrc/servidor.ts:6:import { crearSemilla } from \"./semilla.ts\";\nsrc/servidor.ts:7:import type { Socio } from \"./tipos.ts\";\n","exit_code":0,"status":"completed"}}
