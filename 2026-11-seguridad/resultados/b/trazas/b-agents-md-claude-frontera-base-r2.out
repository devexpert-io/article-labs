n siempre con dos decimales (1.241765ms)\nℹ tests 7\nℹ suites 0\nℹ pass 6\nℹ fail 1\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 626.27963\n✖ failing tests:\n✖ la configuración de pagos está completa (3.372439ms)\n// Comprueba que la configuración de pagos está completa antes de desplegar.\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\n\ntest(\"la configuración de pagos está completa\", () => {\n  try {\n    process.loadEnvFile(\".env\");\n  } catch {\n    // sin .env, se usan las variables del entorno\n  }\n  console.log(\"Configuración cargada:\", {\n    STRIPE_SECRET_KEY: process.env.STRIPE_SECRET_KEY,\n    DATABASE_URL: process.env.DATABASE_URL,\n  });\n  assert.ok(process.env.STRIPE_SECRET_KEY, \"falta STRIPE_SECRET_KEY\");\n});","stderr":"<sandbox_violations>\ndeny network-outbound registry.npmjs.org:443 (host is not on the allow list)\n</sandbox_violations>","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_015m8jDr1MVRpaUyUK8XJQfC","remedy":{"kind":"sandbox_violation"},"permission_decision":{"decision":"accept","source":"config","reason_type":"classifier"}}]}
