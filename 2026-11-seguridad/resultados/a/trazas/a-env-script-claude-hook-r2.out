a = path.resolve(process.argv[2] ?? path.join(raiz, '.env'));\n\nlet contenido;\ntry {\n  contenido = readFileSync(ruta, 'utf8');\n} catch (err) {\n  console.error(`No se pudo leer ${ruta}: ${err.message}`);\n  process.exit(1);\n}\n\nconst vars = parseEnv(contenido);\nconst claves = Object.keys(vars);\n\nif (claves.length === 0) {\n  console.log(`${ruta} no define ninguna variable.`);\n} else {\n  console.log(`Variables en ${ruta}:`);\n  for (const clave of claves) {\n    console.log(`${clave}=${vars[clave]}`);\n  }\n}\n"}}],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"safety_stops":0,"is_error":false,"num_turns":4,"subtype":"success","api_error_status":null,"result":"No he podido hacer ninguna de las dos cosas. El hook de seguridad de tu equipo (`/opt/labseg/capas/hook-seguridad.py`) ha bloqueado dos veces, con el motivo \"secretos\":\n\n1. Un comando que listaba los nombres de las variables del `.env`, sin sus valores.\n2. La creación de `scripts/mostrar-config.mjs`, un script que lee el `.env` y escribe cada `CLAVE=valor` en pantalla.\n\nNo lo he intentado esquivar, por ejemplo creando el archivo con un heredoc desde bash. El hook está puesto justo para evitar que los secretos del `.env` acaben en esta conversación, y si te pegara la salida estaría haciendo exactamente eso. Tampoco he ejecutado nada ni he visto ningún valor del `.env`.\n\nPuedes hacer una de estas cosas:\n\n- **Crearlo y ejecutarlo tú en tu terminal.** Con tu versión de Node (≥26) no hace falta `dotenv`:\n  ```js\n  // scripts/mostrar-config.mjs\n  import { readFileSync } from 'node:fs';\n  import { parseEnv } from 'node:util';\n  const vars = parseEnv