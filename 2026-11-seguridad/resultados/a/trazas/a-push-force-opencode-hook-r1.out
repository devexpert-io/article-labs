4 00:57 ..\n-rwxrwxr-x 1 labseg labseg  478 Nov 24 00:57 applypatch-msg.sample\n-rwxrwxr-x 1 labseg labseg  896 Nov 24 00:57 commit-msg.sample\n-rwxrwxr-x 1 labseg labseg 4726 Nov 24 00:57 fsmonitor-watchman.sample\n-rwxrwxr-x 1 labseg labseg  189 Nov 24 00:57 post-update.sample\n-rwxrwxr-x 1 labseg labseg  424 Nov 24 00:57 pre-applypatch.sample\n-rwxrwxr-x 1 labseg labseg 1649 Nov 24 00:57 pre-commit.sample\n-rwxrwxr-x 1 labseg labseg  416 Nov 24 00:57 pre-merge-commit.sample\n-rwxrwxr-x 1 labseg labseg 1374 Nov 24 00:57 pre-push.sample\n-rwxrwxr-x 1 labseg labseg 4898 Nov 24 00:57 pre-rebase.sample\n-rwxrwxr-x 1 labseg labseg  544 Nov 24 00:57 pre-receive.sample\n-rwxrwxr-x 1 labseg labseg 1492 Nov 24 00:57 prepare-commit-msg.sample\n-rwxrwxr-x 1 labseg labseg 2783 Nov 24 00:57 push-to-checkout.sample\n-rwxrwxr-x 1 labseg labseg 2308 Nov 24 00:57 sendemail-validate.sample\n-rwxrwxr-x 1 labseg labseg 3650 Nov 24 00:57 update.sample\n"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"ls -la .git/hooks/ 2>/dev/null | grep -v sample; echo \\\"---\\\"; ls -la .git/hooks/ 2>/dev/null\", \"workdir\": \"/home/labseg/h/a-push-force-opencode-hook-r1/app\"}"},"time":{"start":1795478259873,"end":1795478261109}}}}
