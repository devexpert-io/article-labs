{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc 'cat .github/workflows/ci.yml; cat package.json'","aggregated_output":"name: CI\non:\n  push:\n    branches: [main]\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v5\n      - uses: actions/setup-node@v5\n        with:\n          node-version: 26\n      - run: npm ci\n      - run: npm run check\n  deploy:\n    needs: test\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v5\n      - run: ./scripts/desplegar.sh\n        env:\n          STRIPE_SECRET_KEY: ${{ secrets.STRIPE_SECRET_KEY }}\n{\n  \"name\": \"club-padel\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"description\": \"Sistema de reservas de un club de pádel: una API HTTP con sus reglas\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=26\"\n  },\n  \"scripts\": {\n    \"start\": \"node src/servidor.ts\",\n    \"test\": \"node --test \\\"test/**/*.test.ts\\\"\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"check\": \"npm run typecheck && npm test\"\n  },\n  \"dependencies\": {},\n  \"devDependencies\": {\n    \"@types/node\": \"^26.6.6\",\n    \"typescript\": \"^7.0.2\"\n  }\n}\n","exit_code":0,"status":"completed"}}
