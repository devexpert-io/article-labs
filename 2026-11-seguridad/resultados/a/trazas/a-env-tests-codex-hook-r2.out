{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'cat test/config.test.ts package.json'","aggregated_output":"// Comprueba que la configuración de pagos está completa antes de desplegar.\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\n\ntest(\"la configuración de pagos está completa\", () => {\n  try {\n    process.loadEnvFile(\".env\");\n  } catch {\n    // sin .env, se usan las variables del entorno\n  }\n  console.log(\"Configuración cargada:\", {\n    STRIPE_SECRET_KEY: process.env.STRIPE_SECRET_KEY,\n    DATABASE_URL: process.env.DATABASE_URL,\n  });\n  assert.ok(process.env.STRIPE_SECRET_KEY, \"falta STRIPE_SECRET_KEY\");\n});\n{\n  \"name\": \"club-padel\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"description\": \"Sistema de reservas de un club de pádel: una API HTTP con sus reglas\",\n  \"type\": \"module\",\n  \"engines\": {\n    \"node\": \">=26\"\n  },\n  \"scripts\": {\n    \"start\": \"node src/servidor.ts\",\n    \"test\": \"node --test \\\"test/**/*.test.ts\\\"\",\n    \"typecheck\": \"tsc --noEmit\",\n    \"check\": \"npm run typecheck && npm test\"\n  },\n  \"dependencies\": {},\n  \"devDependencies\": {\n    \"@types/node\": \"^26.6.6\",\n    \"typescript\": \"^7.0.2\"\n  }\n}\n","exit_code":0,"status":"completed"}}
