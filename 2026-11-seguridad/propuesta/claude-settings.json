{
  "permissions": {
    "deny": [
      "Read(.env)", "Read(.env.*)", "Read(~/.ssh/**)",
      "Edit(.github/workflows/**)", "Edit(data/**)",
      "Bash(git push --force*)", "Bash(git push -f *)",
      "Bash(git push * --force*)", "Bash(git push * -f)",
      "Bash(rm -rf *)", "Bash(rm -fr *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": ["/home/tu-usuario/.ssh", "/home/tu-usuario/proyecto/.env"],
      "denyWrite": ["/home/tu-usuario/proyecto/data"]
    },
    "network": { "allowedDomains": [], "strictAllowlist": true }
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "python3 ~/.claude/hook-seguridad.py" }] }
    ]
  }
}
