+test("el informe de octubre cuadra con las reservas de la semilla, incluidas las no presentadas", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const informe = (await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR })).cuerpo;
+  assert.equal(informe.mes, "2026-10");
+  assert.deepEqual(informe.pistas.map((p: { pistaId: string }) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+
+  for (const fila of informe.pistas) {
+    const delMes = estado.reservas.filter((r: any) => r.pistaId === fila.pistaId && r.inicio.startsWith("2026-10"));
+    const cobradas = delMes.filter((r: any) => r.estado !== "cancelada");
+    const ingresos = cobradas.reduce((s: number, r: any) => s + r.importe, 0);
+    assert.equal(fila.reservas, cobradas.length, fila.pistaId);
+    assert.equal(fila.ingresos, ingresos, fila.pistaId);
+    assert.equal(fila.penalizaciones, 0, "la semilla no tiene penalizaciones");
+    assert.equal(fila.total, ingresos, fila.pistaId);
+  }
+  assert.ok(estado.reservas.some((r: any) => r.estado === "no_presentada" && r.inicio.startsWith("2026-10")), "la semilla tiene no presentadas en octubre");
+  const suma = (campo: string) => informe.pistas.reduce((s: number, p: any) => s + p[campo], 0);
+  assert.deepEqual(informe.total, {
+    reservas: suma("reservas"),
+    ingresos: suma("ingresos"),
+    penalizaciones: suma("penalizaciones"),
+    total: suma("total"),
+  });
+});
