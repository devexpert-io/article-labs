+// Reloj de pared de Madrid: los formatos de fecha/hora del club se leen como hora local de Europe/Madrid.
+const RELOJ_MADRID = new Intl.DateTimeFormat("en-GB", {
+  timeZone: "Europe/Madrid",
+  hourCycle: "h23",
+  year: "numeric",
+  month: "2-digit",
+  day: "2-digit",
+  hour: "2-digit",
+  minute: "2-digit",
+  second: "2-digit",
+});
+
+/** Lo que marca el reloj de Madrid en el instante dado, expresado como si fuera UTC (milisegundos). */
+function relojDeMadrid(instante: number): number {
+  const partes = Object.fromEntries(RELOJ_MADRID.formatToParts(instante).map((p) => [p.type, p.value]));
+  return Date.UTC(+partes.year!, +partes.month! - 1, +partes.day!, +partes.hour!, +partes.minute!, +partes.second!);
+}
+
+/** Instante real (milisegundos UTC) de una hora local de Madrid `AAAA-MM-DDTHH:MM`, con el cambio de hora. */
+function instanteDeMadrid(local: string): number {
+  const comoUtc = Date.parse(`${local}:00Z`);
+  let instante = comoUtc;
+  for (let i = 0; i < 2; i++) instante = comoUtc - (relojDeMadrid(instante) - instante);
+  return instante;
+}
+
+/** Horas reales entre dos horas locales de Madrid. */
 function horasEntre(desde: string, hasta: string): number {
-  return (Date.parse(`${hasta}:00Z`) - Date.parse(`${desde}:00Z`)) / 3_600_000;
+  return (instanteDeMadrid(hasta) - instanteDeMadrid(desde)) / 3_600_000;
+}
+
