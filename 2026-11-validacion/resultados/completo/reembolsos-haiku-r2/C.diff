diff --git a/test/reembolsos.test.ts b/test/reembolsos.test.ts
new file mode 100644
index 0000000..c33d4ea
--- /dev/null
+++ b/test/reembolsos.test.ts
@@ -0,0 +1,207 @@
+// Penalizaciones escalonadas, exención de un gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-003";
+const MOTIVO = "Lluvia y pista mojada";
+
+let api: Api;
+beforeEach(async () => {
+  api = await arrancarApi();
+});
+afterEach(() => api.cerrar());
+
+/** Mueve el reloj del club y crea una reserva en pista-1 a esa hora (jueves 10:30 es franja valle, 1800 céntimos). */
+async function reservar(ahora: string, inicio: string, socio = SOCIO, pistaId = "pista-1"): Promise<string> {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: socio, pistaId, inicio } });
+  assert.equal(creada.status, 201, JSON.stringify(creada.cuerpo));
+  return creada.cuerpo.reserva.id;
+}
+
+/** Mueve el reloj a `ahora` y pide la cancelación. */
+async function cancelar(id: string, ahora: string, cuerpo: Record<string, unknown> = {}, socio?: string) {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+// --- Tramos y límites ---------------------------------------------------------
+
+test("con 48 horas o más de antelación no hay penalización", async () => {
+  const id = await reservar("2026-12-01T10:30", "2026-12-03T10:30");
+  const r = await cancelar(id, "2026-12-01T10:30");
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 1800);
+});
+
+test("entre 24 y 48 horas la penalización es el 25 % y no hace falta forzar", async () => {
+  const id = await reservar("2026-12-01T11:00", "2026-12-03T10:30");
+  const r = await cancelar(id, "2026-12-01T11:00"); // 47,5 horas
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 450);
+  assert.equal(r.cuerpo.reembolso, 1350);
+});
+
+test("a 24 horas justas se aplica el 25 % sin forzar", async () => {
+  const id = await reservar("2026-12-01T10:30", "2026-12-03T10:30");
+  const r = await cancelar(id, "2026-12-02T10:30");
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 450);
+  assert.equal(r.cuerpo.reembolso, 1350);
+});
+
+test("con menos de 24 horas, sin forzar es FUERA_DE_PLAZO; con forzar, el 50 %", async () => {
+  const id = await reservar("2026-12-01T10:30", "2026-12-03T10:30");
+  const sinForzar = await cancelar(id, "2026-12-02T11:00"); // 23,5 horas
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const reserva = (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva;
+  assert.equal(reserva.estado, "confirmada", "un rechazo no cancela la reserva");
+
+  const forzada = await cancelar(id, "2026-12-02T11:00", { forzar: true });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+  assert.equal(forzada.cuerpo.reembolso, 900);
+});
+
+// --- Cambio de hora ----------------------------------------------------------
+
+test("la antelación se cuenta en horas reales de Madrid: el 28 de marzo de 2027 se adelanta el reloj", async () => {
+  // Del viernes 20:30 al domingo 21:00 hay 47,5 horas reales (y 48,5 si se contara sin el cambio de hora).
+  const id = await reservar("2027-03-20T10:00", "2027-03-28T21:00", SOCIO, "pista-1");
+  const r = await cancelar(id, "2027-03-26T20:30");
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 700, "domingo es punta: 2800 × 25 %");
+  assert.equal(r.cuerpo.reembolso, 2100);
+});
+
+test("el cambio de hora de octubre también cuenta: sábado 22:00 a domingo 21:00 son 24 horas reales", async () => {
+  // El domingo 25 de octubre de 2026 se atrasa el reloj una hora: 22:00 del sábado y 21:00 del domingo distan 24 horas.
+  // socio-041 (Nora Benítez) no tiene reservas en la semilla, así que no hay límite de reservas futuras que la frene.
+  const id = await reservar("2026-10-20T10:00", "2026-10-25T21:00", "socio-041", "pista-2");
+  const r = await cancelar(id, "2026-10-24T22:00");
+  assert.equal(r.status, 200, JSON.stringify(r.cuerpo));
+  assert.equal(r.cuerpo.reserva.penalizacion, Math.round(r.cuerpo.reserva.importe * 0.25));
+});
+
+// --- Exención de un gestor ---------------------------------------------------
+
+test("un gestor exime de la penalización con motivo, sin forzar y en cualquier momento antes del inicio", async () => {
+  const id = await reservar("2026-12-01T10:30", "2026-12-03T10:30");
+  const r = await cancelar(id, "2026-12-02T11:00", { exento: true, motivo: MOTIVO }, GESTOR); // 23,5 horas
+  assert.equal(r.status, 200, JSON.stringify(r.cuerpo));
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reserva.motivoCancelacion, MOTIVO);
+  assert.equal(r.cuerpo.reembolso, 1800);
+});
+
+test("la exención exige un motivo de al menos 10 caracteres", async () => {
+  const id = await reservar("2026-12-01T10:30", "2026-12-03T10:30");
+  const sinMotivo = await cancelar(id, "2026-12-02T11:00", { exento: true }, GESTOR);
+  assert.equal(sinMotivo.status, 400);
+  assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const corto = await cancelar(id, "2026-12-02T11:00", { exento: true, motivo: "Lluvia" }, GESTOR);
+  assert.equal(corto.status, 400);
+  assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const sigueConfirmada = (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva;
+  assert.equal(sigueConfirmada.estado, "confirmada");
+});
+
+test("un socio que no es gestor no puede eximir: 403 SIN_PERMISO", async () => {
+  const id = await reservar("2026-12-01T10:30", "2026-12-03T10:30");
+  const r = await cancelar(id, "2026-12-02T11:00", { exento: true, motivo: MOTIVO }, SOCIO);
+  assert.equal(r.status, 403);
+  assert.equal(r.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva.estado, "confirmada");
+});
+
