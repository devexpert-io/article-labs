+  assert.deepEqual(fila("pista-3"), { pistaId: "pista-3", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+  assert.deepEqual(informe.total, { reservas: 1, ingresos: 1800, penalizaciones: 900, total: 2700 });
