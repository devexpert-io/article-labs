+export function importe(pista: Pista, inicio: string, duracion: number): number {
+  const dia = diaDeLaSemana(inicio.slice(0, 10));
+  const desde = minutosDelDia(inicio);
+  const hasta = desde + duracion;
+  const finDeSemana = dia === 0 || dia === 6;
+  const valle = finDeSemana ? 0 : Math.max(0, Math.min(hasta, INICIO_PUNTA) - desde);
+  const punta = duracion - valle;
+  const numerador = valle * pista.precioValle + punta * pista.precioPunta;
+  // round(numerador / 90) con medio céntimo hacia arriba, en enteros.
+  return Math.floor((2 * numerador + MINUTOS_FRANJA) / (2 * MINUTOS_FRANJA));
