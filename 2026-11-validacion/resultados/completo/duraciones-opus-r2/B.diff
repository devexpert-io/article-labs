+      ["socio-016", "pista-3", `${MARTES}T17:00`, 120, 2133], // 60 × 1200 / 90 + 60 × 2000 / 90 = 2133,33
+      ["socio-016", "pista-3", "2026-11-23T17:30", 60, 1067], // 30 × 1200 / 90 + 30 × 2000 / 90 = 1066,67
+      ["socio-020", "pista-2", `${SABADO}T09:00`, 60, 1867],
