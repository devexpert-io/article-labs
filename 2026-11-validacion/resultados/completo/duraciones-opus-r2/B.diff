+// Reservas de 60, 90 o 120 minutos (docs/specs/duraciones.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearSemilla, HORAS, importe, precio } from "../src/semilla.ts";
+
+// El martes 24 de noviembre la pista 1 está libre todo el día y la pista 2 tiene reservas de 18:00 a 22:30.
+const MARTES = "2026-11-24";
+const SABADO = "2026-11-21";
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const reservar = (api: Api, cuerpo: Record<string, unknown>) =>
+  api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", ...cuerpo } });
+
+test("duracion: opcional, 60, 90 o 120, y 90 por defecto", () =>
+  conApi(async (api) => {
+    const porDefecto = await reservar(api, { socioId: "socio-006", inicio: `${MARTES}T09:00` });
+    assert.equal(porDefecto.status, 201);
+    assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+    assert.equal(porDefecto.cuerpo.reserva.fin, `${MARTES}T10:30`);
+    const sesenta = await reservar(api, { socioId: "socio-006", inicio: `${MARTES}T11:00`, duracion: 60 });
+    assert.equal(sesenta.status, 201);
+    assert.equal(sesenta.cuerpo.reserva.duracion, 60);
+    assert.equal(sesenta.cuerpo.reserva.fin, `${MARTES}T12:00`);
+    const ciento20 = await reservar(api, { socioId: "socio-006", inicio: `${MARTES}T12:30`, duracion: 120 });
+    assert.equal(ciento20.status, 201);
+    assert.equal(ciento20.cuerpo.reserva.duracion, 120);
+    assert.equal(ciento20.cuerpo.reserva.fin, `${MARTES}T14:30`);
+    for (const duracion of [0, 30, 45, 91, 150, 60.5, -60, "90", null, true, [90]]) {
+      const mala = await reservar(api, { inicio: `${MARTES}T15:00`, duracion });
+      assert.equal(mala.status, 400, `duracion ${JSON.stringify(duracion)}`);
+      assert.equal(mala.cuerpo.error.codigo, "DURACION_INVALIDA", `duracion ${JSON.stringify(duracion)}`);
+    }
+  }));
+
+test("inicios: en punto o y media, desde las 09:00 y terminando como muy tarde a las 22:30", () =>
+  conApi(async (api) => {
+    const malos: [string, number][] = [
+      ["08:30", 60], ["08:00", 120], ["09:15", 60], ["10:45", 90], ["10:60", 60], ["24:00", 60],
+      ["21:00", 120], ["21:30", 90], ["22:00", 60], ["22:30", 60], ["21:31", 60],
+    ];
+    for (const [hora, duracion] of malos) {
+      const r = await reservar(api, { inicio: `${MARTES}T${hora}`, duracion });
+      assert.equal(r.status, 400, `${hora} + ${duracion}`);
+      assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA", `${hora} + ${duracion}`);
+    }
+    assert.equal((await reservar(api, { inicio: "24-11-2026 10:00", duracion: 60 })).cuerpo.error.codigo, "FRANJA_INVALIDA");
+    const ultimas: [string, number, string][] = [["21:30", 60, "22:30"], ["19:00", 120, "21:00"], ["09:30", 60, "10:30"]];
+    for (const [hora, duracion, fin] of ultimas) {
+      const r = await reservar(api, { socioId: "socio-006", inicio: `${MARTES}T${hora}`, duracion });
+      assert.equal(r.status, 201, `${hora} + ${duracion}`);
+      assert.equal(r.cuerpo.reserva.fin, `${MARTES}T${fin}`);
+    }
+  }));
+
+test("sin solapes con reservas confirmadas, nuevas o antiguas; terminar justo al empezar otra no es solaparse", () =>
+  conApi(async (api) => {
+    // Con las antiguas de 90 minutos: la pista 2 está reservada de 18:00 a 22:30.
+    const antes = await reservar(api, { socioId: "socio-006", pistaId: "pista-2", inicio: `${MARTES}T17:00`, duracion: 60 });
+    assert.equal(antes.status, 201);
+    for (const [hora, duracion] of [["17:00", 90], ["16:30", 120], ["18:30", 60], ["19:00", 120], ["21:30", 60]] as const) {
+      const r = await reservar(api, { pistaId: "pista-2", inicio: `${MARTES}T${hora}`, duracion });
+      assert.equal(r.status, 409, `${hora} + ${duracion}`);
+      assert.equal(r.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+    }
+    // Con las nuevas: 09:00 a 11:00.
+    assert.equal((await reservar(api, { socioId: "socio-016", inicio: `${MARTES}T09:00`, duracion: 120 })).status, 201);
+    for (const [hora, duracion] of [["09:00", 60], ["10:30", 60], ["09:30", 90]] as const) {
+      const r = await reservar(api, { inicio: `${MARTES}T${hora}`, duracion });
+      assert.equal(r.status, 409, `${hora} + ${duracion}`);
+      assert.equal(r.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+    }
+    // La franja de siempre de las 10:30 también se solapa con la nueva.
+    assert.equal((await reservar(api, { inicio: `${MARTES}T10:30` })).cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+    const justo = await reservar(api, { socioId: "socio-016", inicio: `${MARTES}T11:00`, duracion: 60 });
+    assert.equal(justo.status, 201);
+    // Las canceladas no ocupan la pista.
