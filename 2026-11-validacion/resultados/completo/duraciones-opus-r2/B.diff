+/** Minutos desde medianoche de una hora `HH:MM` o de una fecha y hora `AAAA-MM-DDTHH:MM`. */
+export function minutosDelDia(horaOFechaHora: string): number {
+  const [h, m] = horaOFechaHora.slice(-5).split(":").map(Number);
+  return h! * 60 + m!;
+}
+
+function sumarMinutos(inicio: string, minutos: number): string {
