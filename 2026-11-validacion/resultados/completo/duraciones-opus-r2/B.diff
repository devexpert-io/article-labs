+test("disponibilidad: una franja está reservada si se solapa en parte con una reserva confirmada, y trae huecos", () =>
+  conApi(async (api) => {
+    await reservar(api, { socioId: "socio-006", inicio: `${MARTES}T11:00`, duracion: 60 });
+    const tarde = await reservar(api, { socioId: "socio-016", inicio: `${MARTES}T12:30`, duracion: 60 });
+    const d = (await api.pedir("GET", `/api/disponibilidad?fecha=${MARTES}`)).cuerpo;
+    const pista = (id: string) => d.pistas.find((p: any) => p.pistaId === id);
+    const estados = Object.fromEntries(pista("pista-1").franjas.map((f: any) => [f.inicio.slice(11), f.estado]));
+    assert.deepEqual(estados, {
+      "09:00": "libre", "10:30": "reservada", "12:00": "reservada", "13:30": "libre", "15:00": "libre",
+      "16:30": "libre", "18:00": "libre", "19:30": "libre", "21:00": "libre",
+    });
+    assert.equal(pista("pista-1").franjas.length, 9);
+    assert.equal(pista("pista-1").franjas[0].fin, `${MARTES}T10:30`);
+    assert.deepEqual(pista("pista-1").huecos, [
+      { inicio: `${MARTES}T09:00`, fin: `${MARTES}T11:00` },
+      { inicio: `${MARTES}T12:00`, fin: `${MARTES}T12:30` },
+      { inicio: `${MARTES}T13:30`, fin: `${MARTES}T22:30` },
+    ]);
+    // Las reservas antiguas contiguas forman un único intervalo ocupado.
+    assert.deepEqual(pista("pista-2").huecos, [{ inicio: `${MARTES}T09:00`, fin: `${MARTES}T18:00` }]);
+    assert.deepEqual(pista("pista-3").huecos, [{ inicio: `${MARTES}T09:00`, fin: `${MARTES}T21:00` }]);
+    // Una pista cerrada no tiene huecos.
+    assert.deepEqual(pista("pista-4").huecos, []);
+    assert.ok(pista("pista-4").franjas.every((f: any) => f.estado === "cerrada"));
+    // Las canceladas no ocupan la pista.
+    await api.pedir("POST", `/api/reservas/${tarde.cuerpo.reserva.id}/cancelar`);
+    const otra = (await api.pedir("GET", `/api/disponibilidad?fecha=${MARTES}&pista=pista-1`)).cuerpo.pistas[0];
+    assert.deepEqual(otra.huecos, [
+      { inicio: `${MARTES}T09:00`, fin: `${MARTES}T11:00` },
+      { inicio: `${MARTES}T12:00`, fin: `${MARTES}T22:30` },
+    ]);
+    assert.equal(otra.franjas.find((f: any) => f.inicio.endsWith("12:00")).estado, "libre");
+  }));
