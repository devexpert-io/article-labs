+ * no cumplen sus condiciones. Se llama después de las reglas del club, para que un código no cuente
+ * como usado si la reserva no se puede hacer.
+ */
+function descuentoDe(
+  codigo: Codigo,
+  reserva: { socio: Socio; inicio: string; base: number; reservas: Reserva[]; ahora: string },
+): number {
+  const { socio, inicio, base, reservas, ahora } = reserva;
+  const noAplica = (motivo: string) => new ErrorDelClub("CODIGO_NO_APLICABLE", `El código ${codigo} no aplica: ${motivo}`);
+  switch (codigo) {
+    case "BIENVENIDA": {
+      if (ahora.slice(0, 10) > ULTIMO_DIA_BIENVENIDA) throw noAplica("caducó el 31 de diciembre de 2026");
+      if (reservas.some((r) => r.socioId === socio.id)) throw noAplica("solo vale en la primera reserva del socio");
+      return Math.round((base * 50) / 100);
+    }
+    case "MANANAS": {
+      const dia = diaDeLaSemana(inicio.slice(0, 10));
+      const entreSemana = dia >= 1 && dia <= 5;
+      if (!entreSemana || inicio.slice(11) >= "12:00") {
+        throw noAplica("solo en franjas de lunes a viernes que empiezan antes de las 12:00");
+      }
+      return DESCUENTO_MANANAS;
+    }
+    case "CLUB10": {
+      const usadas = reservas.filter((r) => r.socioId === socio.id && r.codigo === "CLUB10" && r.estado !== "cancelada").length;
+      if (usadas >= MAXIMO_RESERVAS_CLUB10) throw noAplica(`ya tienes ${MAXIMO_RESERVAS_CLUB10} reservas con este código`);
+      return Math.round((base * 10) / 100);
+    }
+  }
+}
+
 function sinAcentos(texto: string): string {
   return texto.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
 }
