@@ -0,0 +1,161 @@
+// Códigos de descuento al reservar, probados a través de la API. Cada test arranca su propia API
+// para que las reservas y el reloj de un caso no afecten a otro.
+// Nora Benítez (socio-041) se dio de alta esta semana: no tiene reservas, así que sirve para la primera reserva.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const NORA = "socio-041";
+
+async function con(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function reservar(api: Api, socioId: string, pistaId: string, inicio: string, codigo?: unknown) {
+  return api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId, pistaId, inicio, ...(codigo === undefined ? {} : { codigo }) },
+  });
+}
+
+test("sin código, la reserva se crea como antes y los importes cuadran", async () => {
+  await con({}, async (api) => {
+    const r = await reservar(api, NORA, "pista-1", "2026-11-25T10:30");
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.importeBase, 1800);
+    assert.equal(r.cuerpo.reserva.descuento, 0);
+    assert.equal(r.cuerpo.reserva.importe, 1800);
+    assert.equal("codigo" in r.cuerpo.reserva, false);
+  });
+});
+
+test("BIENVENIDA: 50 % en la primera reserva, y no en la segunda ni si hubo una cancelada", async () => {
+  await con({}, async (api) => {
+    const primera = await reservar(api, NORA, "pista-1", "2026-11-25T19:30", "  bienvenida ");
+    assert.equal(primera.status, 201);
+    assert.equal(primera.cuerpo.reserva.codigo, "BIENVENIDA");
+    assert.equal(primera.cuerpo.reserva.importeBase, 2800);
+    assert.equal(primera.cuerpo.reserva.descuento, 1400);
+    assert.equal(primera.cuerpo.reserva.importe, 1400);
+    const segunda = await reservar(api, NORA, "pista-2", "2026-11-26T10:30", "BIENVENIDA");
+    assert.equal(segunda.status, 409);
+    assert.equal(segunda.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  });
+
+  await con({}, async (api) => {
+    const previa = await reservar(api, NORA, "pista-1", "2026-11-25T19:30");
+    await api.pedir("POST", `/api/reservas/${previa.cuerpo.reserva.id}/cancelar`);
+    const r = await reservar(api, NORA, "pista-2", "2026-11-26T10:30", "BIENVENIDA");
+    assert.equal(r.status, 409, "una reserva cancelada también cuenta como anterior");
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  });
+});
+
+test("BIENVENIDA caduca el 31 de diciembre de 2026 según la hora del club", async () => {
+  await con({ AHORA: "2027-01-02T10:00" }, async (api) => {
+    const r = await reservar(api, NORA, "pista-1", "2027-01-05T10:30", "BIENVENIDA");
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  });
+  await con({ AHORA: "2026-12-31T23:00" }, async (api) => {
+    const r = await reservar(api, NORA, "pista-1", "2027-01-01T10:30", "BIENVENIDA");
+    assert.equal(r.status, 201, "la reserva se hace el 31 de diciembre, aunque la franja sea otro día");
+  });
+});
+
+test("MANANAS: 4,00 € solo de lunes a viernes antes de las 12:00", async () => {
+  await con({}, async (api) => {
+    const entre = await reservar(api, NORA, "pista-1", "2026-11-25T10:30", "mananas");
+    assert.equal(entre.status, 201);
+    assert.equal(entre.cuerpo.reserva.descuento, 400);
+    assert.equal(entre.cuerpo.reserva.importe, 1400);
+    const lunes = await reservar(api, NORA, "pista-2", "2026-11-30T09:00", "MANANAS");
+    assert.equal(lunes.status, 201, "lunes también vale");
+    const sabado = await reservar(api, NORA, "pista-1", "2026-11-28T10:30", "MANANAS");
+    assert.equal(sabado.status, 409);
+    assert.equal(sabado.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+    const mediodia = await reservar(api, NORA, "pista-1", "2026-11-25T12:00", "MANANAS");
+    assert.equal(mediodia.status, 409, "a las 12:00 ya no vale");
+    assert.equal(mediodia.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  });
+});
+
+test("CLUB10: 10 % en cualquier franja; las canceladas no cuentan, las confirmadas sí", async () => {
+  await con({}, async (api) => {
+    const a = await reservar(api, NORA, "pista-1", "2026-11-25T19:30", "CLUB10");
+    assert.equal(a.status, 201);
+    assert.equal(a.cuerpo.reserva.descuento, 280);
+    assert.equal(a.cuerpo.reserva.importe, 2520);
+    assert.equal((await api.pedir("POST", `/api/reservas/${a.cuerpo.reserva.id}/cancelar`)).status, 200);
+    assert.equal((await reservar(api, NORA, "pista-2", "2026-11-25T19:30", "CLUB10")).status, 201);
+    assert.equal((await reservar(api, NORA, "pista-1", "2026-11-26T19:30", "CLUB10")).status, 201);
+    assert.equal((await reservar(api, NORA, "pista-2", "2026-11-26T19:30", "CLUB10")).status, 201, "tercera confirmada con el código");
+    // Mover el reloj deja las tres reservas en el pasado: ya no cuentan como futuras, pero sí como usos del código.
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-27T08:00" } })).status, 200);
+    const cuarta = await reservar(api, NORA, "pista-1", "2026-11-28T19:30", "CLUB10");
+    assert.equal(cuarta.status, 409);
+    assert.equal(cuarta.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  });
+});
+
+test("códigos desconocidos y no textos responden 400", async () => {
+  await con({}, async (api) => {
+    const desconocido = await reservar(api, NORA, "pista-1", "2026-11-25T10:30", "NOEXISTE");
+    assert.equal(desconocido.status, 400);
+    assert.equal(desconocido.cuerpo.error.codigo, "CODIGO_INVALIDO");
+    const numero = await reservar(api, NORA, "pista-1", "2026-11-25T10:30", 123);
+    assert.equal(numero.status, 400);
+    assert.equal(numero.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const lista = await reservar(api, NORA, "pista-1", "2026-11-25T10:30", ["CLUB10", "MANANAS"]);
+    assert.equal(lista.status, 400, "solo se acepta un código por reserva");
+    assert.equal(lista.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  });
+});
+
+test("las reglas del club van primero: si la reserva falla, el código no cuenta como usado", async () => {
+  await con({}, async (api) => {
+    const cerrada = await reservar(api, NORA, "pista-4", "2026-11-25T19:30", "BIENVENIDA");
+    assert.equal(cerrada.status, 409);
+    assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+    const despues = await reservar(api, NORA, "pista-1", "2026-11-25T19:30", "BIENVENIDA");
+    assert.equal(despues.status, 201, "el fallo anterior no ha consumido la primera reserva");
+    assert.equal(despues.cuerpo.reserva.descuento, 1400);
+  });
+});
+
+test("las reservas guardan y devuelven los importes y el código", async () => {
+  await con({}, async (api) => {
+    const creada = await reservar(api, NORA, "pista-1", "2026-11-25T10:30", "MANANAS");
+    const id = creada.cuerpo.reserva.id;
+    const una = (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva;
+    assert.deepEqual([una.importeBase, una.descuento, una.importe, una.codigo], [1800, 400, 1400, "MANANAS"]);
+    const lista = (await api.pedir("GET", `/api/reservas?socio=${NORA}`)).cuerpo.reservas;
+    assert.equal(lista.find((r: { id: string }) => r.id === id).codigo, "MANANAS");
+  });
+});
+
+test("cancelar fuera de plazo cobra el 100 % de lo que pagó el socio, con el descuento", async () => {
+  await con({ AHORA: "2026-11-25T08:00" }, async (api) => {
+    // Pista 1 a las 12:00 entre semana: 1800 €, con CLUB10 paga 1620.
+    const r = await reservar(api, NORA, "pista-1", "2026-11-25T12:00", "CLUB10");
+    assert.equal(r.cuerpo.reserva.importe, 1620);
+    const sinForzar = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 1620);
+  });
+});
+
+test("la disponibilidad sigue mostrando el precio sin descuento", async () => {
+  await con({}, async (api) => {
+    assert.equal((await reservar(api, NORA, "pista-1", "2026-11-25T10:30", "MANANAS")).status, 201);
+    const dia = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-25&pista=pista-1");
+    const franja = dia.cuerpo.pistas[0].franjas.find((f: { inicio: string }) => f.inicio.endsWith("10:30"));
+    assert.equal(franja.estado, "reservada");
+    assert.equal(franja.precio, 1800);
+  });
+});
