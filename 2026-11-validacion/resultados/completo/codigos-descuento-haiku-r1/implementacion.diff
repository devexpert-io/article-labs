+/** Pasa a mayúsculas y quita los espacios de alrededor. Un código fuera del catálogo es un error de datos. */
+function normalizarCodigo(texto: string): Codigo {
+  const limpio = texto.trim().toUpperCase();
+  const encontrado = CATALOGO.find((c) => c === limpio);
+  if (!encontrado) throw new ErrorDelClub("CODIGO_INVALIDO", `No existe el código ${limpio}`, 400);
+  return encontrado;
+}
+
+/**
