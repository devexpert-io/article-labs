+
+test("exportar CSV aplica permisos, formato, filtro y deja intacto el listado", async () => {
+  const ruta = "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19";
+  const anonima = await api.pedir("GET", ruta);
+  assert.equal(anonima.status, 401);
+  assert.equal(anonima.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("GET", ruta, { socio: "socio-001" });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const csv = await api.pedir("GET", ruta, { socio: "socio-040" });
+  assert.equal(csv.status, 200);
+  assert.equal(csv.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(csv.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-11-19-2026-11-19.csv"');
+  assert.ok(csv.texto.startsWith("id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas\r\n"));
+  assert.ok(csv.texto.endsWith("\r\n"));
+  assert.match(csv.texto, /,Pista 1,/);
+  assert.match(csv.texto, /,18\.00,|,28\.00,/);
+  const filtrado = await api.pedir("GET", `${ruta}&estado=confirmada`, { socio: "socio-040" });
+  assert.ok(filtrado.texto.split("\r\n").slice(1).filter(Boolean).every((f: string) => f.split(",")[6] === "confirmada"));
+  const json = await api.pedir("GET", "/api/reservas?desde=2026-11-19&hasta=2026-11-19");
+  assert.equal(json.cabeceras.get("content-type"), "application/json; charset=utf-8");
+  assert.equal(typeof json.cuerpo.reservas, "object");
+});
+
