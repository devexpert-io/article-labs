+test("cancelar una serie: gratis con 24 horas o más, pendientes si faltan menos y penalización con forzar", async () => {
+  const club = await arrancarApi({ AHORA: "2026-12-10T10:00" });
+  try {
+    // Viernes 11 a las 09:00 faltan 23 horas; los siguientes viernes, 7 días.
+    const creada = await club.pedir("POST", "/api/series", {
+      cuerpo: { socioId: SOCIO, pistaId: "pista-2", inicio: "2026-12-11T09:00", semanas: 3 },
+      socio: GESTOR,
+    });
+    const [r1, r2, r3] = creada.cuerpo.serie.reservas as string[];
+    const ruta = `/api/series/${creada.cuerpo.serie.id}/cancelar`;
+
+    const mal = await club.pedir("POST", ruta, { cuerpo: { forzar: "si" }, socio: GESTOR });
+    assert.equal(mal.status, 400);
+
+    const sinForzar = await club.pedir("POST", ruta, { cuerpo: {}, socio: GESTOR });
+    assert.equal(sinForzar.status, 200);
+    assert.deepEqual(sinForzar.cuerpo.canceladas, [r2, r3]);
+    assert.deepEqual(sinForzar.cuerpo.pendientes, [r1]);
+    assert.equal((await club.pedir("GET", `/api/reservas/${r1}`)).cuerpo.reserva.estado, "confirmada");
+    assert.equal((await club.pedir("GET", `/api/reservas/${r2}`)).cuerpo.reserva.estado, "cancelada");
+    assert.equal((await club.pedir("GET", `/api/reservas/${r2}`)).cuerpo.reserva.penalizacion, undefined);
+
+    const forzada = await club.pedir("POST", ruta, { cuerpo: { forzar: true }, socio: GESTOR });
+    assert.deepEqual(forzada.cuerpo.canceladas, [r1]);
+    assert.deepEqual(forzada.cuerpo.pendientes, []);
+    const penalizada = (await club.pedir("GET", `/api/reservas/${r1}`)).cuerpo.reserva;
+    assert.equal(penalizada.estado, "cancelada");
+    assert.equal(penalizada.penalizacion, 1800, "el 100 % del importe");
+
+    const otra = await club.pedir("POST", ruta, { cuerpo: {}, socio: GESTOR });
+    assert.deepEqual(otra.cuerpo.canceladas, []);
+    assert.deepEqual(otra.cuerpo.pendientes, []);
+
+    // Una reserva que ya ha empezado no se toca, ni con forzar.
+    const empezada = await club.pedir("POST", "/api/series", {
+      cuerpo: { socioId: SOCIO, pistaId: "pista-3", inicio: "2026-12-18T16:30", semanas: 2 },
+      socio: GESTOR,
+    });
+    const [ra, rb] = empezada.cuerpo.serie.reservas as string[];
+    assert.equal((await club.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-18T17:00" } })).status, 200);
+    const tras = await club.pedir("POST", `/api/series/${empezada.cuerpo.serie.id}/cancelar`, { cuerpo: { forzar: true }, socio: GESTOR });
+    assert.deepEqual(tras.cuerpo.canceladas, [rb]);
+    const intacta = (await club.pedir("GET", `/api/reservas/${ra}`)).cuerpo.reserva;
+    assert.equal(intacta.estado, "confirmada");
+    assert.equal(intacta.penalizacion, undefined);
+  } finally {
+    club.cerrar();
+  }
+});
