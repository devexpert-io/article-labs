+// Las reservas fijas (series semanales), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040"; // La recepción del club.
+const SOCIO = "socio-003"; // Socio normal: no puede gestionar series.
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+async function estadoClub(a: Api) {
+  const estado = (await a.pedir("GET", "/_estado")).cuerpo;
+  return { series: estado.series.length, reservas: estado.reservas.length, contador: estado.contador };
+}
+
+test("solo un gestor crea, consulta y cancela series", async () => {
+  const cuerpo = { socioId: SOCIO, pistaId: "pista-3", inicio: "2026-12-01T19:30", semanas: 3 };
+  const sin = await api.pedir("POST", "/api/series", { cuerpo });
+  assert.equal(sin.status, 401);
+  assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const desconocido = await api.pedir("POST", "/api/series", { cuerpo, socio: "socio-999" });
+  assert.equal(desconocido.status, 401);
+  assert.equal(desconocido.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("POST", "/api/series", { cuerpo, socio: SOCIO });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+  assert.equal((await api.pedir("GET", "/api/series/S-0001")).status, 401);
+  assert.equal((await api.pedir("GET", "/api/series/S-0001", { socio: SOCIO })).status, 403);
+  assert.equal((await api.pedir("POST", "/api/series/S-0001/cancelar", { cuerpo: {} })).status, 401);
+  assert.equal((await api.pedir("POST", "/api/series/S-0001/cancelar", { cuerpo: {}, socio: SOCIO })).status, 403);
+
+  const creada = await api.pedir("POST", "/api/series", { cuerpo, socio: GESTOR });
+  assert.equal(creada.status, 201);
+  assert.equal(creada.cuerpo.serie.id, "S-0001");
+  assert.equal(creada.cuerpo.serie.reservas.length, 3);
+  assert.deepEqual(creada.cuerpo.serie.saltadas, []);
+});
+
+test("los datos de la serie se validan", async () => {
+  const base = { socioId: "socio-006", pistaId: "pista-2", inicio: "2026-12-07T21:00", semanas: 2 };
+  const pedir = (cambios: Record<string, unknown>) =>
+    api.pedir("POST", "/api/series", { cuerpo: { ...base, ...cambios }, socio: GESTOR });
+
+  for (const semanas of [1, 13, "3", 2.5]) {
+    const r = await pedir({ semanas });
+    assert.equal(r.status, 400, `semanas ${String(semanas)}`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  let r = await pedir({ socioId: "socio-999" });
+  assert.equal(r.cuerpo.error.codigo, "SOCIO_NO_ENCONTRADO");
+  assert.equal(r.status, 404);
+  r = await pedir({ pistaId: "pista-9" });
+  assert.equal(r.cuerpo.error.codigo, "PISTA_NO_ENCONTRADA");
+  assert.equal(r.status, 404);
+  r = await pedir({ inicio: "2026-12-07T11:00" });
+  assert.equal(r.status, 400);
+  assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  r = await pedir({ inicio: "2026-11-18T09:00" });
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "FRANJA_PASADA");
+
+  // Los límites, 2 y 12 semanas, son válidos.
+  assert.equal((await pedir({ semanas: 2 })).status, 201);
+  const doce = await pedir({ pistaId: "pista-1", semanas: 12 });
+  assert.equal(doce.status, 201);
+  assert.equal(doce.cuerpo.serie.reservas.length, 12);
+});
+
+test("una reserva por semana, a la misma pista y hora", async () => {
+  const serie = (await api.pedir("GET", "/api/series/S-0001", { socio: GESTOR })).cuerpo.serie;
+  assert.deepEqual(serie.reservas.map((r: any) => r.inicio), ["2026-12-01T19:30", "2026-12-08T19:30", "2026-12-15T19:30"]);
+  for (const r of serie.reservas) {
+    assert.equal(r.pistaId, "pista-3");
+    assert.equal(r.estado, "confirmada");
+    assert.equal(r.serieId, "S-0001");
+    assert.equal(r.importe, 2000, "punta de pista 3, sin descuento con 3 semanas");
+  }
+});
+
+test("las semanas ocupadas se saltan y el resto se reserva", async () => {
