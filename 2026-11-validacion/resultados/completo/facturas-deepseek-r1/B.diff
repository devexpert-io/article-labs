@@ -0,0 +1,232 @@
+// Facturas mensuales: permisos, mes cerrado, líneas, total e IVA, numeración y consultas.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+/** Reservas que entran en una factura. */
+function facturable(r: { estado: string; penalizacion?: number }): boolean {
+  return r.estado === "confirmada" || r.estado === "no_presentada" || (r.estado === "cancelada" && r.penalizacion !== undefined);
+}
+
+/** Base imponible: total / 1,21 redondeado al céntimo con medio céntimo hacia arriba. */
+function baseEsperada(total: number): number {
+  return Math.floor((200 * total + 121) / 242);
+}
+
+function conCeros(n: number): string {
+  return String(n).padStart(4, "0");
+}
+
+test("solo un gestor genera y consulta facturas", async () => {
+  const generarSin = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+  assert.equal(generarSin.status, 401);
+  assert.equal(generarSin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const generarSocio = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+  assert.equal(generarSocio.status, 403);
+  assert.equal(generarSocio.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const listarSin = await api.pedir("GET", "/api/facturas?mes=2026-10");
+  assert.equal(listarSin.status, 401);
+  assert.equal(listarSin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const listarSocio = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" });
+  assert.equal(listarSocio.status, 403);
+  assert.equal(listarSocio.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const detalleSocio = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: "socio-001" });
+  assert.equal(detalleSocio.status, 403);
+  assert.equal(detalleSocio.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const listarGestor = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(listarGestor.status, 200);
+  assert.deepEqual(listarGestor.cuerpo.facturas, []);
+});
+
+test("el mes debe tener el formato AAAA-MM y estar cerrado", async () => {
+  for (const mes of ["2026-1", "2026-13", "2026-10-01", "octubre", 202610]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 400, `mes ${String(mes)}`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  const sinMes = await api.pedir("POST", "/api/facturas", { cuerpo: {}, socio: GESTOR });
+  assert.equal(sinMes.status, 400);
+  assert.equal(sinMes.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const mesEnCurso = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+  assert.equal(mesEnCurso.status, 409);
+  assert.equal(mesEnCurso.cuerpo.error.codigo, "MES_ABIERTO");
+
+  const mesFuturo = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+  assert.equal(mesFuturo.status, 409);
+  assert.equal(mesFuturo.cuerpo.error.codigo, "MES_ABIERTO");
+});
+
+test("genera una factura por socio con algo que facturar, con las líneas y totales esperados", async () => {
+  const generado = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(generado.status, 201);
+  const facturas = generado.cuerpo.facturas as any[];
+  assert.equal(facturas.length, 40, "octubre factura a 40 socios");
+
+  const ids = facturas.map((f) => f.socioId);
+  assert.deepEqual(ids, [...ids].sort(), "las facturas van ordenadas por id de socio");
+  assert.equal(new Set(ids).size, ids.length, "una factura por socio");
+  assert.ok(!ids.includes("socio-041"), "Nora Benítez no tiene reservas y no se factura");
+
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const sociosEsperados = [...new Set(
+    estado.reservas
+      .filter((r: any) => r.inicio.startsWith("2026-10") && facturable(r))
+      .map((r: any) => r.socioId),
+  )].sort();
+  assert.deepEqual(ids, sociosEsperados);
+
+  for (const factura of facturas) {
+    const esperadas = estado.reservas
+      .filter((r: any) => r.socioId === factura.socioId && r.inicio.startsWith("2026-10") && facturable(r))
+      .sort((a: any, b: any) => (a.inicio === b.inicio ? a.id.localeCompare(b.id) : a.inicio.localeCompare(b.inicio)))
+      .map((r: any) => ({
+        reservaId: r.id,
+        concepto: r.estado === "cancelada" ? "Penalización" : "Reserva",
+        importe: r.estado === "cancelada" ? r.penalizacion : r.importe,
+      }));
+    assert.deepEqual(factura.lineas, esperadas, `líneas de ${factura.socioId}`);
+
+    const total = esperadas.reduce((suma: number, l: any) => suma + l.importe, 0);
+    assert.equal(factura.total, total, `total de ${factura.socioId}`);
+    assert.equal(factura.base, baseEsperada(total), `base de ${factura.socioId}`);
+    assert.equal(factura.iva, total - factura.base, `IVA de ${factura.socioId}`);
+    assert.equal(factura.base + factura.iva, factura.total);
+    assert.equal(factura.mes, "2026-10");
+    assert.match(factura.numero, /^F2026-\d{4}$/);
+  }
+
+  // Valores concretos de la primera factura (socio-001).
+  assert.equal(facturas[0].numero, "F2026-0001");
+  assert.equal(facturas[0].lineas.length, 3);
+  assert.equal(facturas[0].total, 6800);
+  assert.equal(facturas[0].base, 5620);
+  assert.equal(facturas[0].iva, 1180);
+});
