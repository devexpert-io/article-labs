+test("factura las cancelaciones con penalización y no las canceladas sin penalización", async () => {
+  const otro = await arrancarApi({ AHORA: "2026-12-01T09:00" });
+  try {
+    // Nora Benítez no tiene reservas en la semilla.
+    const conPenalizacion = await otro.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-02T19:30" } });
+    assert.equal(conPenalizacion.status, 201);
+    const importe = conPenalizacion.cuerpo.reserva.importe;
+
+    // Cancelada de lejos, sin penalización: no se factura.
+    const sinPenalizacion = await otro.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-12-10T10:30" } });
+    const gratuita = await otro.pedir("POST", `/api/reservas/${sinPenalizacion.cuerpo.reserva.id}/cancelar`);
+    assert.equal(gratuita.cuerpo.reserva.estado, "cancelada");
+    assert.equal(gratuita.cuerpo.reserva.penalizacion, undefined);
+
+    // Cancelada dentro de 24 horas con forzar: penalización del 100 % del importe.
+    assert.equal((await otro.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-02T00:00" } })).status, 200);
+    const forzada = await otro.pedir("POST", `/api/reservas/${conPenalizacion.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, importe);
+
+    // Con el mes de diciembre cerrado, la factura solo tiene la penalización.
+    assert.equal((await otro.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-05T10:00" } })).status, 200);
+    const generado = await otro.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+    assert.equal(generado.status, 201);
+    const facturas = generado.cuerpo.facturas as any[];
+    assert.equal(facturas.length, 1);
+    assert.equal(facturas[0].socioId, "socio-041");
+    assert.deepEqual(facturas[0].lineas, [
+      { reservaId: conPenalizacion.cuerpo.reserva.id, concepto: "Penalización", importe },
+    ]);
+    assert.equal(facturas[0].total, importe);
+    assert.equal(facturas[0].base, baseEsperada(importe));
+    assert.equal(facturas[0].iva, importe - facturas[0].base);
+  } finally {
+    otro.cerrar();
+  }
