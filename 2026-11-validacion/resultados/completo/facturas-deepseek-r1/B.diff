+test("la numeración es correlativa por año, no cambia al regenerar y cada año empieza en 0001", async () => {
+  const octubre = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  const facturasOctubre = octubre.cuerpo.facturas as any[];
+  assert.equal(facturasOctubre[0].numero, "F2026-0001");
+  assert.equal(facturasOctubre.at(-1).numero, `F2026-${conCeros(facturasOctubre.length)}`);
+  assert.deepEqual(facturasOctubre.map((f) => f.numero), facturasOctubre.map((_, i) => `F2026-${conCeros(i + 1)}`));
+
+  // Generar otra vez devuelve las mismas facturas, con 200.
+  const repetida = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo.facturas, facturasOctubre);
+
+  // Septiembre no tiene reservas: se genera vacío y no consume numeración.
+  const septiembre = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-09" }, socio: GESTOR });
+  assert.equal(septiembre.status, 201);
+  assert.deepEqual(septiembre.cuerpo.facturas, []);
+
+  // Noviembre, ya cerrado con el reloj movido, sigue donde lo dejó octubre.
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-15T10:00" } })).status, 200);
+  const noviembre = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+  assert.equal(noviembre.status, 201);
+  assert.equal(noviembre.cuerpo.facturas[0].numero, `F2026-${conCeros(facturasOctubre.length + 1)}`);
+  const totalNoviembre = (noviembre.cuerpo.facturas as any[]).length;
+
+  // Una reserva de diciembre de 2026, facturada cuando el mes esté cerrado.
+  const diciembreReserva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-20T10:30" } });
+  assert.equal(diciembreReserva.status, 201);
+
+  // Diciembre de 2026 se genera en 2027 y sigue la numeración de 2026.
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-15T10:00" } })).status, 200);
+  const diciembre = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+  assert.equal(diciembre.status, 201);
+  assert.equal(diciembre.cuerpo.facturas[0].numero, `F2026-${conCeros(facturasOctubre.length + totalNoviembre + 1)}`);
+
+  // Enero de 2027 estrena la numeración del año.
+  const eneroReserva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-20T10:30" } });
+  assert.equal(eneroReserva.status, 201);
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-15T10:00" } })).status, 200);
+  const enero = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2027-01" }, socio: GESTOR });
+  assert.equal(enero.status, 201);
+  assert.equal(enero.cuerpo.facturas.length, 1);
+  assert.equal(enero.cuerpo.facturas[0].numero, "F2027-0001");
+  assert.equal(enero.cuerpo.facturas[0].socioId, "socio-041");
+});
