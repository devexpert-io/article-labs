@@ -0,0 +1,143 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado, Factura } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+async function iniciar(t: TestContext): Promise<Api> {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+const generar = (api: Api, mes: unknown) => api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+const consultar = (api: Api, mes: string) => api.pedir("GET", `/api/facturas?mes=${mes}`, { socio: gestor });
+const reloj = (api: Api, ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+
+test("solo un gestor puede generar y consultar facturas", async (t) => {
+  const api = await iniciar(t);
+  for (const [metodo, ruta] of [["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F2026-0001"]]) {
+    for (const socio of [undefined, "socio-001", "socio-999"]) {
+      const r = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      assert.equal(r.status, socio === "socio-001" ? 403 : 401);
+      assert.equal(r.cuerpo.error.codigo, socio === "socio-001" ? "SIN_PERMISO" : "NO_IDENTIFICADO");
+    }
+  }
+  assert.equal((await generar(api, "2026-10")).status, 201);
+  assert.equal((await consultar(api, "2026-10")).status, 200);
+  assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001", { socio: gestor })).status, 200);
+});
+
+test("valida el mes y usa el reloj del club para exigir un mes cerrado", async (t) => {
+  const api = await iniciar(t);
+  for (const mes of [undefined, null, 202610, "", "2026-1", "2026-00", "2026-13", "2026-10-01", " 2026-10", "2026-10\n"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const lectura = await api.pedir("GET", `/api/facturas${mes === undefined ? "" : `?mes=${encodeURIComponent(String(mes))}`}`, { socio: gestor });
+    assert.equal(lectura.status, 400);
+    assert.equal(lectura.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  assert.deepEqual((await consultar(api, "2026-11")).cuerpo, { facturas: [] });
+  await reloj(api, "2026-11-30T23:59");
+  assert.equal((await generar(api, "2026-11")).status, 409);
+  await reloj(api, "2026-12-01T00:00");
+  const noviembre = await generar(api, "2026-11");
+  assert.equal(noviembre.status, 201);
+  assert.equal(noviembre.cuerpo.facturas[0].numero, "F2026-0001");
+});
+
+test("octubre: socios, líneas ordenadas, totales, consulta y repetición", async (t) => {
+  const api = await iniciar(t);
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.deepEqual((await consultar(api, "2026-10")).cuerpo, { facturas: [] });
+  const r = await generar(api, "2026-10");
+  assert.equal(r.status, 201);
+  const facturas: Factura[] = r.cuerpo.facturas;
+  const reservas = estado.reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(reservas.some((r) => r.estado === "no_presentada"));
+  const socios = [...new Set(reservas.map((r) => r.socioId))].sort();
+  assert.deepEqual(facturas.map((f) => f.socioId), socios);
+  assert.ok(!socios.includes("socio-041"));
+  for (const [i, factura] of facturas.entries()) {
+    const propias = reservas.filter((r) => r.socioId === factura.socioId).sort((a, b) => a.inicio.localeCompare(b.inicio));
+    const total = propias.reduce((suma, r) => suma + r.importe, 0);
+    assert.deepEqual(factura, {
+      numero: `F2026-${String(i + 1).padStart(4, "0")}`, mes: "2026-10", socioId: socios[i],
+      lineas: propias.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })),
+      total, base: Math.round(total / 1.21), iva: total - Math.round(total / 1.21),
+    });
+    const individual = await api.pedir("GET", `/api/facturas/${factura.numero}`, { socio: gestor });
+    assert.equal(individual.status, 200);
+    assert.deepEqual(individual.cuerpo, { factura });
+  }
+  const repetida = await generar(api, "2026-10");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo, r.cuerpo);
+  assert.deepEqual((await consultar(api, "2026-10")).cuerpo, r.cuerpo);
+  const desconocida = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: gestor });
+  assert.equal(desconocida.status, 404);
+  assert.equal(desconocida.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("factura reservas y penalizaciones, excluye cancelaciones gratuitas y redondea sobre el total", async (t) => {
+  const api = await iniciar(t);
+  const crear = async (inicio: string) => {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio } });
+    assert.equal(r.status, 201);
+    return r.cuerpo.reserva;
+  };
+  const penalizada = await crear("2026-11-26T09:00");
+  const confirmada = await crear("2026-11-25T09:00");
+  const gratuita = await crear("2026-11-27T09:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratuita.id}/cancelar`)).status, 200);
+  await reloj(api, "2026-11-26T08:00");
+  const cancelada = await api.pedir("POST", `/api/reservas/${penalizada.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1800);
+  await reloj(api, "2026-12-01T00:00");
+  const generadas = await generar(api, "2026-11");
+  assert.equal(generadas.status, 201);
+  const factura = generadas.cuerpo.facturas.find((f: Factura) => f.socioId === "socio-041");
+  assert.deepEqual(factura.lineas, [
+    { reservaId: confirmada.id, concepto: "Reserva", importe: 1800 },
+    { reservaId: penalizada.id, concepto: "Penalización", importe: 1800 },
+  ]);
+  assert.equal(factura.total, 3600);
+  assert.equal(factura.base, 2975);
+  assert.equal(factura.iva, 625);
+  const pasada = await api.pedir("POST", `/api/reservas/${confirmada.id}/cancelar`);
+  assert.equal(pasada.status, 409);
+  assert.equal(pasada.cuerpo.error.codigo, "RESERVA_PASADA");
+  assert.equal((await api.pedir("GET", `/api/reservas/${confirmada.id}`)).cuerpo.reserva.estado, "confirmada");
+  assert.deepEqual((await generar(api, "2026-11")).cuerpo, generadas.cuerpo);
+});
+
+test("numeración continua por orden de generación, independiente por año y sin consumir números al repetir o generar vacío", async (t) => {
+  const api = await iniciar(t);
+  const vacio = await generar(api, "2026-09");
+  assert.equal(vacio.status, 201);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  assert.equal((await generar(api, "2026-09")).status, 200);
+  await reloj(api, "2026-12-01T00:00");
+  const noviembre = (await generar(api, "2026-11")).cuerpo.facturas;
+  assert.equal(noviembre[0].numero, "F2026-0001");
+  await generar(api, "2026-11");
+  const octubre = (await generar(api, "2026-10")).cuerpo.facturas;
+  assert.equal(octubre[0].numero, `F2026-${String(noviembre.length + 1).padStart(4, "0")}`);
+  await reloj(api, "2027-01-01T00:00");
+  const reserva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-04T09:00" } });
+  assert.equal(reserva.status, 201);
+  await reloj(api, "2027-02-01T00:00");
+  const enero = await generar(api, "2027-01");
+  assert.equal(enero.status, 201);
+  assert.deepEqual(enero.cuerpo.facturas.map((f: Factura) => f.numero), ["F2027-0001"]);
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const numeros = Object.values(estado.facturasPorMes).flat().map((f) => f.numero);
+  assert.equal(new Set(numeros).size, numeros.length);
+  assert.deepEqual((await consultar(api, "2026-11")).cuerpo.facturas, noviembre);
+});
