     estado.reservas.some((r) => r.pistaId === pistaId && r.inicio === inicio && r.estado === "confirmada");
 
   return {
+    generarFacturas(mes: unknown) {
+      validarMes(mes);
+      const existentes = estado.facturasPorMes[mes];
+      if (existentes) return { facturas: existentes, creada: false };
+      if (mes >= estado.ahora.slice(0, 7)) {
