@@ -0,0 +1,312 @@
+// Reservas fijas semanales (docs/specs/reservas-fijas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+/** Los importes de las reservas de una serie, leídos con GET /api/series/:id. */
+async function importes(respuesta: any, a: Api = api) {
+  const consulta = await a.pedir("GET", `/api/series/${respuesta.cuerpo.serie.id}`, { socio: GESTOR });
+  return consulta.cuerpo.serie.reservas.map((r: any) => r.importe);
+}
+
+const crearSerie = (cuerpo: unknown, socio: string | null = GESTOR, a: Api = api) =>
+  a.pedir("POST", "/api/series", { cuerpo, socio: socio ?? undefined });
+
+/** Arranca una API aparte (para mover el reloj o tocar el estado sin afectar a los demás tests). */
+async function conApiAparte(prueba: (a: Api) => Promise<void>) {
+  const otra = await arrancarApi();
+  try {
+    await prueba(otra);
+  } finally {
+    otra.cerrar();
+  }
+}
+
+test("permisos: solo un gestor crea, consulta y cancela series", async () => {
+  const datos = { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T09:00", semanas: 2 };
+  const sinIdentificar = await crearSerie(datos, null);
+  assert.equal(sinIdentificar.status, 401);
+  assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await crearSerie(datos, "socio-003");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const creada = await crearSerie(datos);
+  assert.equal(creada.status, 201);
+  const id = creada.cuerpo.serie.id;
+  for (const [metodo, ruta] of [["GET", `/api/series/${id}`], ["POST", `/api/series/${id}/cancelar`]] as const) {
+    const anonimo = await api.pedir(metodo, ruta);
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const noGestor = await api.pedir(metodo, ruta, { socio: "socio-003" });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  // Nada se ha cancelado por las peticiones sin permiso.
+  const consulta = await api.pedir("GET", `/api/series/${id}`, { socio: GESTOR });
+  assert.ok(consulta.cuerpo.serie.reservas.every((r: any) => r.estado === "confirmada"));
+});
+
+test("datos: semanas, socio, pista y franja", async () => {
+  const base = { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-02T09:00", semanas: 4 };
+  for (const semanas of [1, 13, 2.5, "4", undefined, 0]) {
+    const r = await crearSerie({ ...base, semanas });
+    assert.equal(r.status, 400, `semanas=${semanas}`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  const sinSocio = await crearSerie({ ...base, socioId: "socio-999" });
+  assert.equal(sinSocio.status, 404);
+  assert.equal(sinSocio.cuerpo.error.codigo, "SOCIO_NO_ENCONTRADO");
+  const sinPista = await crearSerie({ ...base, pistaId: "pista-9" });
+  assert.equal(sinPista.status, 404);
+  assert.equal(sinPista.cuerpo.error.codigo, "PISTA_NO_ENCONTRADA");
+  for (const inicio of ["2026-12-02T09:15", "2026-12-02 09:00", "mañana"]) {
+    const r = await crearSerie({ ...base, inicio });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  }
+  // Fechas que no existen en el calendario: no se crea ninguna reserva.
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+  for (const inicio of ["2027-02-30T19:30", "2026-13-01T09:00"]) {
+    const r = await crearSerie({ ...base, inicio });
+    assert.equal(r.status, 400, inicio);
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  }
+  const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(despues.reservas.length, antes.reservas.length);
