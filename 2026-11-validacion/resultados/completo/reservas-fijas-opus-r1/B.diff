+test("cancelar la serie: gratis con 24 horas o más, pendientes las cercanas salvo con forzar", async () => {
+  await conApiAparte(async (a) => {
+    const r = await crearSerie({ socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T09:00", semanas: 5 }, GESTOR, a);
+    const [primera, segunda, tercera, cuarta, quinta] = r.cuerpo.serie.reservas;
+    // La cuarta se cancela antes como reserva suelta.
+    assert.equal((await a.pedir("POST", `/api/reservas/${cuarta}/cancelar`)).cuerpo.reserva.estado, "cancelada");
+    // El 14 de diciembre a las 12:00, la primera y la segunda ya han pasado y la tercera (15 dic 09:00) está a 21 horas.
+    await a.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-14T12:00" } });
+    const sinForzar = await a.pedir("POST", `/api/series/${r.cuerpo.serie.id}/cancelar`, { socio: GESTOR });
+    assert.equal(sinForzar.status, 200);
+    assert.equal(sinForzar.cuerpo.serie.id, r.cuerpo.serie.id);
+    assert.deepEqual(sinForzar.cuerpo.canceladas.map((x: any) => x.id), [quinta]);
+    assert.equal(sinForzar.cuerpo.canceladas[0].estado, "cancelada");
+    assert.equal(sinForzar.cuerpo.canceladas[0].penalizacion, undefined);
+    assert.deepEqual(sinForzar.cuerpo.pendientes.map((x: any) => x.id), [tercera]);
+    assert.equal(sinForzar.cuerpo.pendientes[0].estado, "confirmada");
+
+    const forzada = await a.pedir("POST", `/api/series/${r.cuerpo.serie.id}/cancelar`, { socio: GESTOR, cuerpo: { forzar: true } });
+    assert.deepEqual(forzada.cuerpo.canceladas.map((x: any) => x.id), [tercera]);
+    assert.equal(forzada.cuerpo.canceladas[0].penalizacion, 1800);
+    assert.deepEqual(forzada.cuerpo.pendientes, []);
+
+    // Las ya pasadas y la cancelada antes no se tocan.
+    const serie = (await a.pedir("GET", `/api/series/${r.cuerpo.serie.id}`, { socio: GESTOR })).cuerpo.serie;
+    const porId = Object.fromEntries(serie.reservas.map((x: any) => [x.id, x]));
+    assert.equal(porId[primera].estado, "confirmada");
+    assert.equal(porId[segunda].estado, "confirmada");
+    assert.equal(porId[cuarta].penalizacion, undefined);
+
+    const mal = await a.pedir("POST", `/api/series/${r.cuerpo.serie.id}/cancelar`, { socio: GESTOR, cuerpo: { forzar: "sí" } });
+    assert.equal(mal.status, 400);
+    assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  });
+});
