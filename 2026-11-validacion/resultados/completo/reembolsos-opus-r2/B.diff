+// Penalizaciones escalonadas, exención de un gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const MOTIVO = "Lesión justificada con parte médico";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+async function reservar(socioId: string, pistaId: string, inicio: string): Promise<string> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva.id;
+}
+
+async function reloj(ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+test("tramos y límites exactos: 48 h gratis, de 24 a 48 h el 25 %, con menos de 24 h el 50 % y solo con forzar", async () => {
+  await reloj("2026-11-18T10:00");
+  // Lunes 30 de noviembre, horas de valle en la pista 3: 1200 céntimos cada una.
+  const a48 = await reservar("socio-006", "pista-3", "2026-11-30T12:00");
+  const a47 = await reservar("socio-007", "pista-3", "2026-11-30T13:30");
+  const a24 = await reservar("socio-008", "pista-3", "2026-11-30T15:00");
+  const menos24 = await reservar("socio-009", "pista-3", "2026-11-30T16:30");
+
+  await reloj("2026-11-28T12:00"); // 48 horas justas
+  const gratis = await api.pedir("POST", `/api/reservas/${a48}/cancelar`);
+  assert.equal(gratis.status, 200);
+  assert.equal(gratis.cuerpo.reserva.estado, "cancelada");
+  assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.cuerpo.reembolso, 1200);
+
+  await reloj("2026-11-28T14:00"); // 47,5 horas
+  const cuarto = await api.pedir("POST", `/api/reservas/${a47}/cancelar`);
+  assert.equal(cuarto.status, 200);
+  assert.equal(cuarto.cuerpo.reserva.penalizacion, 300);
+  assert.equal(cuarto.cuerpo.reembolso, 900);
+
+  await reloj("2026-11-29T15:00"); // 24 horas justas: 25 % y sin forzar
+  const justas = await api.pedir("POST", `/api/reservas/${a24}/cancelar`);
+  assert.equal(justas.status, 200);
+  assert.equal(justas.cuerpo.reserva.penalizacion, 300);
+  assert.equal(justas.cuerpo.reembolso, 900);
+
+  await reloj("2026-11-29T16:31"); // un minuto menos de 24 horas
+  const sinForzar = await api.pedir("POST", `/api/reservas/${menos24}/cancelar`);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await api.pedir("POST", `/api/reservas/${menos24}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+  assert.equal(forzada.cuerpo.reembolso, 600);
+  await reloj("2026-11-18T10:00");
+});
+
+test("cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  await reloj("2026-11-18T10:00");
+  // Domingo 28 de marzo de 2027 a las 21:00, punta: 2800 céntimos en las pistas 1 y 2.
+  const id = await reservar("socio-012", "pista-2", "2027-03-28T21:00");
+  const otra = await reservar("socio-013", "pista-1", "2027-03-28T21:00");
+
+  await reloj("2027-03-26T20:30"); // 47,5 horas reales (no 48,5)
+  const cancelada = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+  assert.equal(cancelada.cuerpo.reembolso, 2100);
+
+  await reloj("2027-03-26T20:00"); // 48 horas reales justas (49 en el reloj)
+  const gratis = await api.pedir("POST", `/api/reservas/${otra}/cancelar`);
+  assert.equal(gratis.status, 200);
+  assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.cuerpo.reembolso, 2800);
+  await reloj("2026-11-18T10:00");
+});
+
+test("exención: solo un gestor, con motivo de al menos 10 caracteres y sin forzar", async () => {
+  await reloj("2026-11-18T10:00");
+  // R-0520: Marta López, jueves 19 a las 09:00, faltan 23 horas.
+  const ruta = "/api/reservas/R-0520/cancelar";
+  const anonimo = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo: MOTIVO } });
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo: MOTIVO }, socio: "socio-002" });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const sinMotivo = await api.pedir("POST", ruta, { cuerpo: { exento: true }, socio: GESTOR });
+  assert.equal(sinMotivo.status, 400);
+  assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const corto = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo: "123456789" }, socio: GESTOR });
