+test("informe de caja: una entrada por pista, ordenadas, con reservas, ingresos, penalizaciones y total", async () => {
+  const otra = await arrancarApi();
+  try {
+    const vacio = await otra.pedir("GET", "/api/informes/caja?mes=2027-01", { socio: GESTOR });
+    assert.equal(vacio.status, 200);
+    const cero = { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 };
+    assert.deepEqual(vacio.cuerpo, {
+      mes: "2027-01",
+      pistas: ["pista-1", "pista-2", "pista-3", "pista-4"].map((pistaId) => ({ pistaId, ...cero })),
+      total: cero,
+    });
+
+    // Una cancelación con penalización en noviembre: R-0520 (pista 3, 1200 céntimos) forzada, 600.
+    assert.equal((await otra.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } })).cuerpo.reserva.penalizacion, 600);
+    const informe = await otra.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR });
+    assert.equal(informe.status, 200);
+
+    const estado = (await otra.pedir("GET", "/_estado")).cuerpo;
+    const delMes = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-11"));
+    const calcular = (rs: any[]) => {
+      const cobradas = rs.filter((r) => r.estado === "confirmada" || r.estado === "no_presentada");
+      const ingresos = cobradas.reduce((s, r) => s + r.importe, 0);
+      const penalizaciones = rs.filter((r) => r.estado === "cancelada").reduce((s, r) => s + (r.penalizacion ?? 0), 0);
+      return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    };
+    assert.deepEqual(informe.cuerpo, {
+      mes: "2026-11",
+      pistas: ["pista-1", "pista-2", "pista-3", "pista-4"].map((pistaId) => ({ pistaId, ...calcular(delMes.filter((r: any) => r.pistaId === pistaId)) })),
+      total: calcular(delMes),
+    });
+    assert.equal(informe.cuerpo.total.penalizaciones, 600);
+    assert.equal(informe.cuerpo.pistas[2].penalizaciones, 600);
+    assert.ok(informe.cuerpo.total.reservas > 0);
+    assert.equal(informe.cuerpo.total.total, informe.cuerpo.total.ingresos + 600);
+  } finally {
+    otra.cerrar();
+  }
+});
