+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-11", { socio: GESTOR })).cuerpo, { facturas: [] });
+
+  const generadas = (await generar(api, "2026-10")).cuerpo.facturas;
+  const lista = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.deepEqual(lista.cuerpo.facturas, generadas);
+
+  const una = await api.pedir("GET", "/api/facturas/F2026-0003", { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo.factura, generadas[2]);
+
+  for (const numero of ["F2026-9999", "F2027-0001", "nada"]) {
