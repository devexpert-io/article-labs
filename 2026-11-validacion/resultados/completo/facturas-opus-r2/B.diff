diff --git a/test/facturas.test.ts b/test/facturas.test.ts
new file mode 100644
index 0000000..b24f98d
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,208 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const generar = (api: Api, mes: unknown, socio: string | undefined = GESTOR) =>
+  api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio });
+
+test("permisos: solo un gestor genera y consulta facturas", () => conApi(async (api) => {
+  const llamadas = [
+    () => api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } }),
+    () => api.pedir("GET", "/api/facturas?mes=2026-10"),
+    () => api.pedir("GET", "/api/facturas/F2026-0001"),
+  ];
+  for (const llamar of llamadas) {
+    const r = await llamar();
+    assert.equal(r.status, 401);
+    assert.equal(r.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  }
+  const socio = [
+    () => generar(api, "2026-10", "socio-004"),
+    () => api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-004" }),
+    () => api.pedir("GET", "/api/facturas/F2026-0001", { socio: "socio-004" }),
+  ];
+  for (const llamar of socio) {
+    const r = await llamar();
+    assert.equal(r.status, 403);
+    assert.equal(r.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  const desconocido = await generar(api, "2026-10", "socio-999");
+  assert.equal(desconocido.status, 401);
+  // Ningún intento anterior ha generado nada.
+  assert.equal((await generar(api, "2026-10")).status, 201);
+}));
+
+test("mes cerrado: formato AAAA-MM y solo meses terminados", () => conApi(async (api) => {
+  for (const mes of [undefined, "2026-1", "2026-13", "2026-00", "2026-10-01", "octubre", 202610]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400, `mes ${mes}`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-1", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await api.pedir("GET", "/api/facturas", { socio: GESTOR })).status, 400);
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  // El 30 de noviembre a última hora, noviembre sigue abierto; el 1 de diciembre ya está cerrado.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T23:59" } });
+  assert.equal((await generar(api, "2026-11")).cuerpo.error.codigo, "MES_ABIERTO");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T00:00" } });
+  assert.equal((await generar(api, "2026-11")).status, 201);
+}));
+
+test("octubre de 2026: una factura por socio, con sus líneas, total, base e IVA", () => conApi(async (api) => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const r = await generar(api, "2026-10");
+  assert.equal(r.status, 201);
+  const facturas = r.cuerpo.facturas;
+
+  // Lo que se espera, calculado a partir de las reservas de octubre.
+  const octubre = estado.reservas.filter((x: any) => x.inicio.startsWith("2026-10"));
+  const facturables = octubre.filter((x: any) => x.estado !== "cancelada" || x.penalizacion > 0);
+  const socios = [...new Set<string>(facturables.map((x: any) => x.socioId))].sort();
+  assert.ok(octubre.some((x: any) => x.estado === "no_presentada"));
+  assert.ok(octubre.some((x: any) => x.estado === "cancelada"));
+
+  assert.deepEqual(facturas.map((f: any) => f.socioId), socios, "una por socio con algo que facturar, por id de socio");
+  assert.ok(!facturas.some((f: any) => f.socioId === "socio-041"));
+  facturas.forEach((f: any, i: number) => {
+    assert.equal(f.mes, "2026-10");
+    assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+    const suyas = facturables.filter((x: any) => x.socioId === f.socioId).sort((a: any, b: any) => a.inicio.localeCompare(b.inicio));
+    assert.deepEqual(f.lineas, suyas.map((x: any) => ({ reservaId: x.id, concepto: "Reserva", importe: x.importe })));
+    assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+    assert.equal(f.base, Math.round(f.total / 1.21));
+    assert.equal(f.iva, f.total - f.base);
+  });
+  // Las canceladas sin penalización no aparecen.
+  const lineas = new Set(facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId)));
+  for (const x of octubre.filter((x: any) => x.estado === "cancelada")) assert.ok(!lineas.has(x.id));
+
+  // Marta López (socio-002): la base sale del total, no de sumar la de cada línea.
+  const marta = facturas.find((f: any) => f.socioId === "socio-002");
+  assert.equal(marta.total, 20400);
+  assert.equal(marta.base, 16860); // 20400 / 1,21 = 16859,50…
+  assert.equal(marta.iva, 3540);
+  const lineaALinea = marta.lineas.reduce((s: number, l: any) => s + Math.round(l.importe / 1.21), 0);
+  assert.notEqual(lineaALinea, marta.base);
+}));
+
+test("penalizaciones: las canceladas con penalización se facturan con su concepto", () => conApi(async (api) => {
+  // R-0520 es de Marta López el jueves 19 a las 09:00: cancelarla ahora cuesta 1200.
+  const cancelada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1200);
+  // Una cancelación gratuita del mismo mes no se factura.
+  const nueva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-25T12:00" } });
+  await api.pedir("POST", `/api/reservas/${nueva.cuerpo.reserva.id}/cancelar`);
+
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T10:00" } });
+  const facturas = (await generar(api, "2026-11")).cuerpo.facturas;
+  const marta = facturas.find((f: any) => f.socioId === "socio-002");
+  const linea = marta.lineas.find((l: any) => l.reservaId === "R-0520");
+  assert.deepEqual(linea, { reservaId: "R-0520", concepto: "Penalización", importe: 1200 });
+  const inicios = (await api.pedir("GET", "/_estado")).cuerpo.reservas;
+  const inicio = (id: string) => inicios.find((x: any) => x.id === id).inicio;
+  const ordenadas = [...marta.lineas].sort((a: any, b: any) => inicio(a.reservaId).localeCompare(inicio(b.reservaId)));
+  assert.deepEqual(marta.lineas, ordenadas, "líneas ordenadas por inicio");
+  assert.equal(marta.total, marta.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+  assert.ok(!facturas.some((f: any) => f.socioId === "socio-041"), "Nora solo tiene una cancelación gratuita");
+}));
+
+test("numeración: sigue entre meses del mismo año y empieza en 0001 cada año; generar dos veces no crea nada", () => conApi(async (api) => {
+  const octubre = await generar(api, "2026-10");
+  const n = octubre.cuerpo.facturas.length;
+  assert.equal(octubre.cuerpo.facturas[n - 1].numero, `F2026-${String(n).padStart(4, "0")}`);
+
+  // Repetir devuelve lo mismo con 200.
+  const otraVez = await generar(api, "2026-10");
+  assert.equal(otraVez.status, 200);
+  assert.deepEqual(otraVez.cuerpo, octubre.cuerpo);
+
+  // Septiembre no tiene reservas: se genera vacío y no consume números.
+  const septiembre = await generar(api, "2026-09");
+  assert.equal(septiembre.status, 201);
+  assert.deepEqual(septiembre.cuerpo.facturas, []);
+  assert.equal((await generar(api, "2026-09")).status, 200);
+
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-02T10:00" } });
+  const noviembre = (await generar(api, "2026-11")).cuerpo.facturas;
+  assert.equal(noviembre[0].numero, `F2026-${String(n + 1).padStart(4, "0")}`);
