+test("cancelar no cambia; los huecos ignoran la hora actual", async () => {
+  const otra = await arrancarApi({ AHORA: "2026-11-27T10:00" });
+  try {
+    const dia = "2026-11-27";
+    const creada = await otra.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: `${dia}T13:00`, duracion: 120 },
+    });
+    assert.equal(creada.status, 201);
+    assert.equal(creada.cuerpo.reserva.importe, 1600, "120 minutos de valle en pista 3: 1200 × 120 / 90");
+    const id = creada.cuerpo.reserva.id;
+
+    // Son las 10:00, pero los huecos empiezan a las 09:00.
+    const huecosDePista3 = async () => (await otra.pedir("GET", `/api/disponibilidad?fecha=${dia}&pista=pista-3`)).cuerpo.pistas[0].huecos;
+    assert.deepEqual(await huecosDePista3(), [
+      { inicio: `${dia}T09:00`, fin: `${dia}T13:00` },
+      { inicio: `${dia}T15:00`, fin: `${dia}T22:30` },
+    ]);
+
+    // A tres horas: sin forzar no se cancela; con forzar, penalización del 100 % del importe.
+    const sinForzar = await otra.pedir("POST", `/api/reservas/${id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await otra.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 1600);
+    assert.deepEqual(await huecosDePista3(), [{ inicio: `${dia}T09:00`, fin: `${dia}T22:30` }], "la cancelada libera el día");
+
+    // A más de 24 horas, gratis, también para una de 60 minutos.
+    const lejana = await otra.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-29T09:00", duracion: 60 },
+    });
+    assert.equal(lejana.status, 201);
+    const gratis = await otra.pedir("POST", `/api/reservas/${lejana.cuerpo.reserva.id}/cancelar`);
+    assert.equal(gratis.cuerpo.reserva.estado, "cancelada");
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  } finally {
+    otra.cerrar();
+  }
+});
