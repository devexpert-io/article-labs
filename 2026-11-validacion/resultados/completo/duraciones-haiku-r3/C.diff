+test("precio por minutos: punta desde las 18:00 y todo el fin de semana; lo de siempre cuesta lo mismo", async () => {
+  const casos: [string, string, number, number][] = [
+    ["pista-1", `${DIA}T17:30`, 90, 2467], // 30 min de valle y 60 de punta: 600 + 1866,67 → 2467
+    ["pista-3", `${DIA}T16:30`, 90, 1200], // lo de siempre, todo de valle
+    ["pista-3", `${DIA}T18:00`, 90, 2000], // lo de siempre, todo de punta
+    ["pista-2", `${DIA}T17:00`, 60, 1200], // 17:00 a 18:00, todo de valle
+    ["pista-2", `${DIA}T18:00`, 60, 1867], // 2800 × 60 / 90 = 1866,67 → 1867
+    ["pista-2", `${DIA}T13:30`, 90, 1800],
+    ["pista-2", `${DIA}T15:00`, 90, 1800],
+    ["pista-2", `${DIA}T21:00`, 90, 2800],
+    ["pista-1", "2026-11-28T09:00", 90, 2800], // sábado: todo de punta
+    ["pista-2", "2026-11-28T10:30", 90, 2800],
+    ["pista-2", "2026-11-28T17:00", 120, 3733], // sábado: 2800 × 120 / 90 = 3733,33 → 3733
+  ];
+  for (const [pista, inicio, duracion, importe] of casos) {
+    const r = await reservar(pista, inicio, { duracion });
+    assert.equal(r.status, 201, `${pista} ${inicio}`);
+    assert.equal(r.cuerpo.reserva.importe, importe, `${pista} ${inicio} ${duracion} min`);
+  }
+});
