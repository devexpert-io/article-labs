+// Reservas de 60, 90 o 120 minutos: validación, solapes, precio por minutos, disponibilidad y huecos.
+// Los días de los tests (25 a 29 de noviembre) no tienen reservas en la semilla, salvo que se diga lo contrario.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const DIA = "2026-11-25"; // miércoles
+
+let api: Api;
+let socios: string[] = [];
+let turno = 0;
+
+/** Un socio distinto por reserva, sin contar el último de la lista, que se reserva para los tests de límite. */
+const socio = () => socios[turno++ % (socios.length - 1)]!;
+const ultimoSocio = () => socios[socios.length - 1]!;
+
+const reservar = (pistaId: string, inicio: string, extra: Record<string, unknown> = {}, quien: string = socio()) =>
+  api.pedir("POST", "/api/reservas", { cuerpo: { socioId: quien, pistaId, inicio, ...extra } });
+
+before(async () => {
+  api = await arrancarApi();
+  // Con el reloj en el 25 de noviembre, ninguna reserva de la semilla es futura: cada socio puede reservar.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: `${DIA}T00:00` } });
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  socios = estado.socios.filter((s: any) => s.cuotaActiva && s.rol === "socio").map((s: any) => s.id);
+});
+after(() => api.cerrar());
+
+test("duración: 60, 90 o 120 minutos, 90 por defecto; cualquier otro valor da DURACION_INVALIDA", async () => {
+  const porDefecto = await reservar("pista-1", `${DIA}T10:00`);
+  assert.equal(porDefecto.status, 201);
+  assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+  assert.equal(porDefecto.cuerpo.reserva.fin, `${DIA}T11:30`);
+
+  const una = await reservar("pista-2", `${DIA}T10:00`, { duracion: 60 });
+  assert.equal(una.status, 201);
+  assert.equal(una.cuerpo.reserva.duracion, 60);
+  assert.equal(una.cuerpo.reserva.fin, `${DIA}T11:00`);
+
+  const dos = await reservar("pista-3", `${DIA}T10:00`, { duracion: 120 });
+  assert.equal(dos.status, 201);
+  assert.equal(dos.cuerpo.reserva.duracion, 120);
+  assert.equal(dos.cuerpo.reserva.fin, `${DIA}T12:00`);
+
+  for (const duracion of [45, 0, 150, "90", "60", null, true]) {
+    const r = await reservar("pista-1", `${DIA}T15:00`, { duracion });
+    assert.equal(r.status, 400, `duracion ${JSON.stringify(duracion)}`);
+    assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA", `duracion ${JSON.stringify(duracion)}`);
+  }
+});
+
+test("inicios: en punto o y media, no antes de las 09:00 y terminando como muy tarde a las 22:30", async () => {
+  const dia = "2026-11-26"; // jueves
+  const malos: [string, number][] = [
+    ["08:30", 60], // antes de las 09:00
+    ["10:15", 60], // ni en punto ni y media
+    ["09:60", 60], // los minutos tienen que ser 00 o 30, no vale que sumen un múltiplo de 30
+    ["10:90", 60], // idem
+    ["21:00", 120], // termina a las 23:00
+    ["22:00", 60], // termina a las 23:00
+    ["22:30", 60], // termina a las 23:30
+  ];
+  for (const [hora, duracion] of malos) {
+    const r = await reservar("pista-2", `${dia}T${hora}`, { duracion });
+    assert.equal(r.status, 400, hora);
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA", hora);
+  }
+
+  const a = await reservar("pista-2", `${dia}T09:00`, { duracion: 60 });
+  assert.equal(a.status, 201);
+  assert.equal(a.cuerpo.reserva.fin, `${dia}T10:00`);
+  const b = await reservar("pista-2", `${dia}T20:30`, { duracion: 120 });
+  assert.equal(b.status, 201);
+  assert.equal(b.cuerpo.reserva.fin, `${dia}T22:30`);
+  const c = await reservar("pista-1", `${dia}T21:30`, { duracion: 60 });
+  assert.equal(c.status, 201);
+  assert.equal(c.cuerpo.reserva.fin, `${dia}T22:30`);
+  const d = await reservar("pista-3", `${dia}T21:00`); // 90 por defecto: termina justo a las 22:30
+  assert.equal(d.status, 201);
+  assert.equal(d.cuerpo.reserva.fin, `${dia}T22:30`);
+});
+
+test("solapes con reservas nuevas: tocarse no es solaparse, y las canceladas no ocupan la pista", async () => {
+  // La reserva del primer test de pista 1 ocupa de 10:00 a 11:30.
+  const junto = await reservar("pista-1", `${DIA}T11:30`, { duracion: 60 });
+  assert.equal(junto.status, 201, "empezar cuando otra termina no es solaparse");
+  const pisa = await reservar("pista-1", `${DIA}T09:30`, { duracion: 60 });
+  assert.equal(pisa.status, 409);
+  assert.equal(pisa.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  const pisaDos = await reservar("pista-1", `${DIA}T12:00`, { duracion: 120 });
+  assert.equal(pisaDos.status, 409, "12:00 a 14:00 pisa la de 11:30 a 12:30");
+  assert.equal(pisaDos.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  const despuesJunto = await reservar("pista-1", `${DIA}T12:30`, { duracion: 60 });
