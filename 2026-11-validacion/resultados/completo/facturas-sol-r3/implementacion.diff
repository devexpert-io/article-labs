@@ -0,0 +1,174 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado, Factura } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+
+async function iniciar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+function generar(api: Api, mes: unknown) {
+  return api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function reservar(api: Api, inicio: string, pistaId = "pista-1") {
+  const respuesta = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio },
+  });
+  assert.equal(respuesta.status, 201, respuesta.texto);
+  return respuesta.cuerpo.reserva;
+}
+
+test("solo el gestor puede generar, listar y consultar facturas", async (t) => {
+  const api = await iniciar(t);
+  for (const [metodo, ruta] of [
+    ["POST", "/api/facturas"],
+    ["GET", "/api/facturas?mes=2026-10"],
+    ["GET", "/api/facturas/F2026-0001"],
+  ]) {
+    for (const [socio, status, codigo] of [
+      [undefined, 401, "NO_IDENTIFICADO"],
+      ["socio-999", 401, "NO_IDENTIFICADO"],
+      ["socio-001", 403, "SIN_PERMISO"],
+    ] as const) {
+      const r = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      assert.equal(r.status, status);
+      assert.equal(r.cuerpo.error.codigo, codigo);
+    }
+  }
+  assert.equal((await generar(api, "2026-10")).status, 201);
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).status, 200);
+  assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001", { socio: gestor })).status, 200);
+});
+
+test("valida el mes y solo genera meses terminados según el reloj del club", async (t) => {
+  const api = await iniciar(t);
+  for (const mes of [undefined, null, 202610, {}, [], "", "2026-1", "26-10", "2026-00", "2026-13", "2026-10-01", " 2026-10"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400, JSON.stringify(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const ruta of ["/api/facturas", "/api/facturas?mes=2026-13", "/api/facturas?mes=2026-1"]) {
+    const r = await api.pedir("GET", ruta, { socio: gestor });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj(api, "2026-11-30T23:59");
+  assert.equal((await generar(api, "2026-11")).cuerpo.error.codigo, "MES_ABIERTO");
+  await reloj(api, "2026-12-01T00:00");
+  const r = await generar(api, "2026-11");
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.facturas[0].numero, "F2026-0001");
+});
+
+test("octubre: una factura por socio, líneas ordenadas, totales y consultas", async (t) => {
+  const api = await iniciar(t);
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const reservas = estado.reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(reservas.some((r) => r.estado === "no_presentada"));
+  assert.ok(estado.reservas.some((r) => r.inicio.startsWith("2026-10") && r.estado === "cancelada"));
+  const r = await generar(api, "2026-10");
+  assert.equal(r.status, 201);
+  const facturas: Factura[] = r.cuerpo.facturas;
+  assert.deepEqual(facturas.map((f) => f.socioId), [...new Set(reservas.map((r) => r.socioId))].sort());
+  assert.ok(!facturas.some((f) => f.socioId === "socio-041"));
+  for (const [i, f] of facturas.entries()) {
+    const delSocio = reservas.filter((r) => r.socioId === f.socioId).sort((a, b) => a.inicio.localeCompare(b.inicio));
+    const total = delSocio.reduce((suma, r) => suma + r.importe, 0);
+    assert.deepEqual(f, {
+      numero: `F2026-${String(i + 1).padStart(4, "0")}`, mes: "2026-10", socioId: f.socioId,
+      lineas: delSocio.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })),
+      total, base: Math.round(total / 1.21), iva: total - Math.round(total / 1.21),
+    });
+  }
+  const listado = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor });
+  assert.equal(listado.status, 200);
+  assert.deepEqual(listado.cuerpo, { facturas });
+  const detalle = await api.pedir("GET", `/api/facturas/${facturas[0]!.numero}`, { socio: gestor });
+  assert.equal(detalle.status, 200);
+  assert.deepEqual(detalle.cuerpo, { factura: facturas[0] });
+  const desconocida = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: gestor });
+  assert.equal(desconocida.status, 404);
+  assert.equal(desconocida.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-11", { socio: gestor })).cuerpo, { facturas: [] });
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, estado.reservas);
+});
+
+test("las cancelaciones con penalización se facturan y las gratuitas se excluyen", async (t) => {
+  const api = await iniciar(t);
+  const reservas: Estado["reservas"] = (await api.pedir("GET", "/_estado")).cuerpo.reservas;
+  const marta = reservas.find((r) => r.socioId === "socio-002" && r.inicio === "2026-11-19T09:00")!;
+  const forzada = await api.pedir("POST", `/api/reservas/${marta.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1200);
+  const nora = await reservar(api, "2026-11-25T09:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${nora.id}/cancelar`)).status, 200);
+  await reloj(api, "2026-12-01T00:00");
+  const facturas: Factura[] = (await generar(api, "2026-11")).cuerpo.facturas;
+  const factura = facturas.find((f) => f.socioId === "socio-002")!;
+  assert.deepEqual(factura.lineas.find((l) => l.reservaId === marta.id), {
+    reservaId: marta.id, concepto: "Penalización", importe: 1200,
+  });
+  assert.ok(!facturas.some((f) => f.socioId === "socio-041"));
+  const pasada = await api.pedir("POST", `/api/reservas/${marta.id}/cancelar`);
+  assert.equal(pasada.cuerpo.error.codigo, "YA_CANCELADA");
+});
+
+test("el IVA se redondea sobre el total, con líneas en orden de inicio", async (t) => {
+  const api = await iniciar(t);
+  const segunda = await reservar(api, "2026-12-02T09:00");
+  const primera = await reservar(api, "2026-12-01T09:00");
+  await reloj(api, "2027-01-01T00:00");
+  const r = await generar(api, "2026-12");
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.cuerpo.facturas, [{
+    numero: "F2026-0001", mes: "2026-12", socioId: "socio-041",
+    lineas: [primera, segunda].map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: 1800 })),
+    total: 3600, base: 2975, iva: 625,
+  }]);
+  const pasada = await api.pedir("POST", `/api/reservas/${primera.id}/cancelar`);
+  assert.equal(pasada.status, 409);
+  assert.equal(pasada.cuerpo.error.codigo, "RESERVA_PASADA");
+});
+
+test("numeración anual sin huecos, meses vacíos y generación repetida o simultánea", async (t) => {
+  const api = await iniciar(t);
+  const vacio = await generar(api, "2026-09");
+  assert.equal(vacio.status, 201);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  assert.equal((await generar(api, "2026-09")).status, 200);
+  await reservar(api, "2026-12-01T09:00");
+  await reloj(api, "2027-01-01T00:00");
+  // El orden de generación puede ser distinto del orden cronológico.
+  const diciembre = await generar(api, "2026-12");
+  assert.equal(diciembre.cuerpo.facturas[0].numero, "F2026-0001");
+  const simultaneas = await Promise.all([generar(api, "2026-10"), generar(api, "2026-10")]);
+  assert.deepEqual(simultaneas.map((r) => r.status).sort(), [200, 201]);
+  assert.deepEqual(simultaneas[0]!.cuerpo, simultaneas[1]!.cuerpo);
+  const octubre: Factura[] = simultaneas[0]!.cuerpo.facturas;
+  assert.equal(octubre[0]!.numero, "F2026-0002");
+  const repetida = await generar(api, "2026-12");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo, diciembre.cuerpo);
+  const noviembre = await generar(api, "2026-11");
+  assert.equal(noviembre.cuerpo.facturas[0].numero, `F2026-${String(octubre.length + 2).padStart(4, "0")}`);
+  await reservar(api, "2027-01-05T09:00");
+  await reloj(api, "2027-02-01T00:00");
+  const enero = await generar(api, "2027-01");
+  assert.equal(enero.status, 201);
+  assert.equal(enero.cuerpo.facturas[0].numero, "F2027-0001");
+  assert.deepEqual((await generar(api, "2026-10")).cuerpo.facturas, octubre);
+});
