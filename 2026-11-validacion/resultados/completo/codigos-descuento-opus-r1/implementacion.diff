@@ -0,0 +1,177 @@
+// Códigos de descuento al reservar (docs/specs/codigos-descuento.md), probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Desde el 25 de noviembre de 2026 la semilla no tiene reservas: todas las franjas están libres.
+// Miércoles 25: valle 1800 en pista 1 y 2, 1200 en pista 3. Sábado 28: punta 2800 en pista 1.
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const reservar = (api: Api, cuerpo: Record<string, unknown>) => api.pedir("POST", "/api/reservas", { cuerpo });
+
+test("sin código, la reserva se crea como antes", () => conApi(async (api) => {
+  const r = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-25T18:00" });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.importeBase, 2800);
+  assert.equal(r.cuerpo.reserva.descuento, 0);
+  assert.equal(r.cuerpo.reserva.importe, 2800);
+  assert.equal("codigo" in r.cuerpo.reserva, false);
+}));
+
+test("BIENVENIDA: 50 % en la primera reserva del socio", () => conApi(async (api) => {
+  const r = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-28T10:30", codigo: "BIENVENIDA" });
+  assert.equal(r.status, 201);
+  assert.deepEqual(
+    { importeBase: r.cuerpo.reserva.importeBase, descuento: r.cuerpo.reserva.descuento, importe: r.cuerpo.reserva.importe, codigo: r.cuerpo.reserva.codigo },
+    { importeBase: 2800, descuento: 1400, importe: 1400, codigo: "BIENVENIDA" },
+  );
+  const segunda = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-28T12:00", codigo: "BIENVENIDA" });
+  assert.equal(segunda.status, 409);
+  assert.equal(segunda.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  // Un socio con historial tampoco puede usarlo.
+  const veterano = await reservar(api, { socioId: "socio-003", pistaId: "pista-2", inicio: "2026-11-28T12:00", codigo: "BIENVENIDA" });
+  assert.equal(veterano.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+}));
+
+test("BIENVENIDA: una reserva cancelada también cuenta como reserva anterior", () => conApi(async (api) => {
+  const r = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-28T10:30" });
+  assert.equal((await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`)).cuerpo.reserva.estado, "cancelada");
+  const otra = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-28T12:00", codigo: "BIENVENIDA" });
+  assert.equal(otra.status, 409);
+  assert.equal(otra.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+}));
+
+test("BIENVENIDA: vale hasta el 31 de diciembre de 2026 según la hora del club", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-02T10:30", codigo: "BIENVENIDA" });
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.descuento, 1400);
+  }, { AHORA: "2026-12-31T23:30" });
+  await conApi(async (api) => {
+    const r = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-02T10:30", codigo: "BIENVENIDA" });
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }, { AHORA: "2027-01-01T00:00" });
+});
+
+test("MANANAS: 4,00 € de lunes a viernes en franjas que empiezan antes de las 12:00", () => conApi(async (api) => {
+  const nueve = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-25T09:00", codigo: "MANANAS" });
+  assert.equal(nueve.status, 201);
+  assert.deepEqual([nueve.cuerpo.reserva.importeBase, nueve.cuerpo.reserva.descuento, nueve.cuerpo.reserva.importe], [1800, 400, 1400]);
+  assert.equal(nueve.cuerpo.reserva.codigo, "MANANAS");
+  const diezYMedia = await reservar(api, { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-27T10:30", codigo: "MANANAS" });
+  assert.equal(diezYMedia.status, 201);
+  assert.equal(diezYMedia.cuerpo.reserva.importe, 800);
+  for (const inicio of ["2026-11-25T12:00", "2026-11-25T18:00", "2026-11-28T09:00", "2026-11-29T10:30"]) {
+    const r = await reservar(api, { socioId: "socio-006", pistaId: "pista-1", inicio, codigo: "MANANAS" });
+    assert.equal(r.status, 409, inicio);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE", inicio);
+  }
+}));
+
+test("CLUB10: 10 %, como mucho 3 reservas por socio sin contar las canceladas", () => conApi(async (api) => {
+  const socioId = "socio-041";
+  const ids: string[] = [];
+  for (const inicio of ["2026-11-25T09:00", "2026-11-25T10:30", "2026-11-25T12:00"]) {
+    const r = await reservar(api, { socioId, pistaId: "pista-1", inicio, codigo: "CLUB10" });
+    assert.equal(r.status, 201, inicio);
+    assert.deepEqual([r.cuerpo.reserva.importeBase, r.cuerpo.reserva.descuento, r.cuerpo.reserva.importe], [1800, 180, 1620]);
+    ids.push(r.cuerpo.reserva.id);
+  }
+  // La cancelada deja de contar y libera un uso.
+  assert.equal((await api.pedir("POST", `/api/reservas/${ids[0]}/cancelar`)).status, 200);
+  const cuarta = await reservar(api, { socioId, pistaId: "pista-1", inicio: "2026-11-25T13:30", codigo: "CLUB10" });
+  assert.equal(cuarta.status, 201);
+  // Pasadas las reservas, siguen contando: ya hay 3 confirmadas con CLUB10.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T08:00" } });
+  const quinta = await reservar(api, { socioId, pistaId: "pista-1", inicio: "2026-11-27T09:00", codigo: "CLUB10" });
+  assert.equal(quinta.status, 409);
+  assert.equal(quinta.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  // Otro código sí vale, y otro socio puede usar CLUB10.
+  assert.equal((await reservar(api, { socioId, pistaId: "pista-1", inicio: "2026-11-27T09:00", codigo: "MANANAS" })).status, 201);
+  assert.equal((await reservar(api, { socioId: "socio-003", pistaId: "pista-2", inicio: "2026-11-27T09:00", codigo: "CLUB10" })).status, 201);
+}));
+
+test("formato del código: mayúsculas, espacios y errores", () => conApi(async (api) => {
+  const r = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-25T18:00", codigo: "  club10 " });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.codigo, "CLUB10");
+  assert.equal(r.cuerpo.reserva.importe, 2520);
+  for (const codigo of ["DESCUENTO", "", "CLUB10 MANANAS", "CLUB10,MANANAS"]) {
+    const mal = await reservar(api, { socioId: "socio-003", pistaId: "pista-2", inicio: "2026-11-25T18:00", codigo });
+    assert.equal(mal.status, 400, codigo);
+    assert.equal(mal.cuerpo.error.codigo, "CODIGO_INVALIDO", codigo);
+  }
+  for (const codigo of [10, null, true, ["CLUB10", "MANANAS"], { codigo: "CLUB10" }]) {
+    const mal = await reservar(api, { socioId: "socio-003", pistaId: "pista-2", inicio: "2026-11-25T18:00", codigo });
+    assert.equal(mal.status, 400, JSON.stringify(codigo));
+    assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS", JSON.stringify(codigo));
+  }
+}));
+
+test("la reserva guarda los importes y la API los devuelve", () => conApi(async (api) => {
+  const creada = (await reservar(api, { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-25T09:00", codigo: "mananas" })).cuerpo.reserva;
+  const esperado = { importeBase: 1200, descuento: 400, importe: 800, codigo: "MANANAS" };
+  const una = (await api.pedir("GET", `/api/reservas/${creada.id}`)).cuerpo.reserva;
+  assert.deepEqual({ importeBase: una.importeBase, descuento: una.descuento, importe: una.importe, codigo: una.codigo }, esperado);
+  const lista = (await api.pedir("GET", "/api/reservas?fecha=2026-11-25")).cuerpo.reservas;
+  const enLista = lista.find((r: { id: string }) => r.id === creada.id);
+  assert.deepEqual({ importeBase: enLista.importeBase, descuento: enLista.descuento, importe: enLista.importe, codigo: enLista.codigo }, esperado);
+}));
+
+test("las reglas del club van primero y el código no cuenta como usado", () => conApi(async (api) => {
+  const casos: [Record<string, unknown>, string][] = [
+    [{ socioId: "socio-041", pistaId: "pista-4", inicio: "2026-11-25T09:00" }, "PISTA_CERRADA"],
+    [{ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:15" }, "FRANJA_INVALIDA"],
+    [{ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-18T09:00" }, "FRANJA_PASADA"],
+    [{ socioId: "socio-041", pistaId: "pista-9", inicio: "2026-11-25T09:00" }, "PISTA_NO_ENCONTRADA"],
+    [{ socioId: "socio-011", pistaId: "pista-1", inicio: "2026-11-25T09:00" }, "CUOTA_INACTIVA"],
+  ];
+  for (const [cuerpo, error] of casos) {
+    const r = await reservar(api, { ...cuerpo, codigo: "BIENVENIDA" });
+    assert.equal(r.cuerpo.error.codigo, error);
+  }
+  // Ocupada: la franja de la primera reserva de Nora.
+  const ocupada = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-25T10:30" });
+  assert.equal(ocupada.status, 201);
+  const repetida = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T10:30", codigo: "BIENVENIDA" });
+  assert.equal(repetida.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  // Las reglas del club ganan incluso a un código que no aplicaría o no existe.
