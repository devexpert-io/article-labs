+test("el informe del mes cuadra con las reservas del estado", async () => {
+  await conApi({}, async (api) => {
+    const mes = "2026-11";
+    const informe = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: GESTOR });
+    assert.equal(informe.status, 200);
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const delMes = estado.reservas.filter((r: any) => r.inicio.slice(0, 7) === mes);
+
+    const sumar = (pistaId: string) => {
+      const cobradas = delMes.filter((r: any) => r.pistaId === pistaId && r.estado !== "cancelada");
+      const canceladas = delMes.filter((r: any) => r.pistaId === pistaId && r.estado === "cancelada");
+      const ingresos = cobradas.reduce((suma: number, r: any) => suma + r.importe, 0);
+      const penalizaciones = canceladas.reduce((suma: number, r: any) => suma + (r.penalizacion ?? 0), 0);
+      return { pistaId, reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    };
+
+    assert.deepEqual(informe.cuerpo.pistas, estado.pistas.map((p: any) => p.id).sort().map(sumar));
+    const total = informe.cuerpo.pistas.reduce(
+      (suma: any, p: any) => ({
+        reservas: suma.reservas + p.reservas,
+        ingresos: suma.ingresos + p.ingresos,
+        penalizaciones: suma.penalizaciones + p.penalizaciones,
+        total: suma.total + p.total,
+      }),
+      { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    );
+    assert.deepEqual(informe.cuerpo.total, total);
+  });
+});
