+++ b/test/reembolsos.test.ts
@@ -0,0 +1,264 @@
+// La política de cancelación escalonada, la exención de gestores y el informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIA = "socio-041"; // Nora Benítez: cuota al día y sin reservas en la semilla.
+
+/** Arranca una API limpia para cada prueba y la cierra al terminar. */
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+/** Resta horas a una hora local del club, como texto AAAA-MM-DDTHH:MM. */
+function restarHoras(inicio: string, horas: number): string {
+  return new Date(Date.parse(`${inicio}:00Z`) - horas * 3_600_000).toISOString().slice(0, 16);
+}
+
+/** La primera franja libre de la pista 1 ese día. */
+async function primeraFranjaLibre(api: Api, fecha: string): Promise<string> {
+  const dia = (await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`)).cuerpo;
+  const pista = dia.pistas.find((p: any) => p.pistaId === "pista-1");
+  const franja = pista.franjas.find((f: any) => f.estado === "libre");
+  assert.ok(franja, `la pista 1 debe tener una franja libre el ${fecha}`);
+  return franja.inicio;
+}
+
+/** Crea una reserva de Nora en la pista 1 y mueve el reloj para que falten esas horas. */
+async function reservarConAntelacion(api: Api, fecha: string, antelacion: number) {
+  const inicio = await primeraFranjaLibre(api, fecha);
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIA, pistaId: "pista-1", inicio } });
+  assert.equal(creada.status, 201);
+  const cuando = restarHoras(inicio, antelacion);
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: cuando } })).status, 200);
+  return creada.cuerpo.reserva as { id: string; importe: number; inicio: string };
+}
+
+test("con 48 horas o más de antelación cancelar no cuesta nada y no hace falta forzar", async () => {
+  await conApi({}, async (api) => {
+    for (const antelacion of [48, 72]) {
+      const reserva = await reservarConAntelacion(api, "2026-11-23", antelacion);
+      const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+      assert.equal(cancelada.status, 200);
+      assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+      assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+      assert.equal(cancelada.cuerpo.reembolso, reserva.importe);
+    }
+  });
+});
+
+test("entre 24 y 48 horas la penalización es el 25 % del importe", async () => {
+  await conApi({}, async (api) => {
+    for (const antelacion of [47.5, 30, 24]) {
+      const reserva = await reservarConAntelacion(api, "2026-11-23", antelacion);
+      const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+      assert.equal(cancelada.status, 200, `con ${antelacion} horas debería cancelarse sin forzar`);
+      const penalizacion = Math.round((reserva.importe * 25) / 100);
+      assert.equal(cancelada.cuerpo.reserva.penalizacion, penalizacion);
+      assert.equal(cancelada.cuerpo.reembolso, reserva.importe - penalizacion);
+    }
+  });
+});
+
+test("con menos de 24 horas solo se cancela con forzar y la penalización es el 50 %", async () => {
+  await conApi({}, async (api) => {
+    const reserva = await reservarConAntelacion(api, "2026-11-23", 23);
+    const sinForzar = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    assert.equal((await api.pedir("GET", `/api/reservas/${reserva.id}`)).cuerpo.reserva.estado, "confirmada");
+
+    const forzada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    const penalizacion = Math.round((reserva.importe * 50) / 100);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, penalizacion);
+    assert.equal(forzada.cuerpo.reembolso, reserva.importe - penalizacion);
+  });
+});
+
+test("a 24 horas justas se aplica el 25 % y no hace falta forzar", async () => {
+  await conApi({}, async (api) => {
+    const reserva = await reservarConAntelacion(api, "2026-11-23", 24);
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, Math.round((reserva.importe * 25) / 100));
+  });
+});
+
+test("la antelación se cuenta en horas reales de Madrid, con el cambio de hora", async () => {
+  // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales,
+  // aunque en el reloj de pared parezcan 48,5: esa madrugada los relojes se adelantan una hora.
+  await conApi({ AHORA: "2027-03-26T20:30" }, async (api) => {
+    const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIA, pistaId: "pista-1", inicio: "2027-03-28T21:00" } });
+    assert.equal(creada.status, 201);
+    const reserva = creada.cuerpo.reserva;
+    assert.equal(reserva.importe, 2800, "el domingo a las 21:00 es punta");
+
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700, "47,5 horas reales caen en el tramo del 25 %");
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  });
+});
+
+test("un gestor exime de la penalización con exento y un motivo, sin forzar", async () => {
+  await conApi({}, async (api) => {
+    const reserva = await reservarConAntelacion(api, "2026-11-23", 10);
+    const motivo = "Avería en la pista";
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo },
+      socio: GESTOR,
+    });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada.cuerpo.reserva.motivoCancelacion, motivo);
+    assert.equal(cancelada.cuerpo.reembolso, reserva.importe);
+  });
+});
+
+test("eximir pide gestor identificado y un motivo de 10 caracteres o más", async () => {
+  await conApi({}, async (api) => {
+    const reserva = await reservarConAntelacion(api, "2026-11-23", 10);
+    const eximir = (socio: string | undefined, cuerpo: unknown) =>
+      api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo, socio });
+
