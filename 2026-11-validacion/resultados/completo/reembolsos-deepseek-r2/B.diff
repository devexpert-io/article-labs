+test("el informe de caja suma reservas, ingresos y penalizaciones de cada pista", async () => {
+  await conApi({}, async (api) => {
+    // Dos reservas en diciembre (mes sin historial en la semilla), una de ellas cancelada en el tramo del 25 %.
+    const primera = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIA, pistaId: "pista-1", inicio: "2026-12-01T09:00" } });
+    const segunda = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIA, pistaId: "pista-1", inicio: "2026-12-01T10:30" } });
+    assert.equal(primera.status, 201);
+    assert.equal(segunda.status, 201);
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T09:00" } })).status, 200);
+    const cancelada = await api.pedir("POST", `/api/reservas/${primera.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    const penalizacion = Math.round((primera.cuerpo.reserva.importe * 25) / 100);
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: GESTOR });
+    assert.equal(informe.status, 200);
+    assert.equal(informe.cuerpo.mes, "2026-12");
+    assert.deepEqual(informe.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+    assert.deepEqual(informe.cuerpo.pistas[0], {
+      pistaId: "pista-1",
+      reservas: 1,
+      ingresos: segunda.cuerpo.reserva.importe,
+      penalizaciones: penalizacion,
+      total: segunda.cuerpo.reserva.importe + penalizacion,
+    });
+    for (const pista of informe.cuerpo.pistas.slice(1)) {
+      assert.deepEqual(pista, { pistaId: pista.pistaId, reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+    }
+    assert.deepEqual(informe.cuerpo.total, {
+      reservas: 1,
+      ingresos: segunda.cuerpo.reserva.importe,
+      penalizaciones: penalizacion,
+      total: segunda.cuerpo.reserva.importe + penalizacion,
+    });
+  });
+});
