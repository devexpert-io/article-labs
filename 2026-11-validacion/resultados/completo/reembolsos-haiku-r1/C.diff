+// Política de cancelación escalonada, exención de gestores e informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-003";
+const SIN_RESERVAS = "socio-041";
+
+async function conApi(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function moverReloj(api: Api, ahora: string): Promise<void> {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function reservar(api: Api, inicio: string, pistaId = "pista-1", socioId = SIN_RESERVAS): Promise<any> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+}
+
+function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+test("sin penalización a 48 horas o más, también a 48 horas justas", async () => {
+  await conApi(async (api) => {
+    await moverReloj(api, "2026-11-18T09:00");
+    const r = await reservar(api, "2026-11-20T09:00"); // viernes, 48 horas exactas
+    const cancelada = await cancelar(api, r.id);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada.cuerpo.reembolso, r.importe);
+  });
+});
+
+test("entre 24 y 48 horas la penalización es el 25 %; a 24 horas justas no hace falta forzar", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "2026-11-20T09:00"); // 47 horas desde las 10:00 del miércoles
+    const cancelada = await cancelar(api, r.id);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 450, "25 % de 1800");
+    assert.equal(cancelada.cuerpo.reembolso, 1350);
+  });
+  await conApi(async (api) => {
+    await moverReloj(api, "2026-11-18T09:00");
+    const r = await reservar(api, "2026-11-19T09:00"); // exactamente 24 horas
+    const cancelada = await cancelar(api, r.id);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 450);
+    assert.equal(cancelada.cuerpo.reembolso, 1350);
+  });
+});
+
+test("a menos de 24 horas, sin forzar no se cancela; con forzar, la penalización es el 50 %", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "2026-11-19T09:00"); // 23 horas
+    const sinForzar = await cancelar(api, r.id);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    assert.equal((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva.estado, "confirmada");
+    const forzada = await cancelar(api, r.id, { forzar: true });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900, "50 % de 1800");
+    assert.equal(forzada.cuerpo.reembolso, 900);
+  });
+});
+
+test("la antelación se cuenta en horas reales de Madrid, con el cambio de hora", async () => {
+  await conApi(async (api) => {
+    // Domingo 28 de marzo de 2027 a las 21:00 (punta, 2800). Desde el viernes 26 a las 20:30 hay 47,5 horas reales.
+    const r = await reservar(api, "2027-03-28T21:00", "pista-1");
+    await moverReloj(api, "2027-03-26T20:30");
+    const cancelada = await cancelar(api, r.id);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700, "25 % de 2800: con 47,5 horas no hay tramo gratuito");
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  });
+});
+
+test("un gestor exime de la penalización con un motivo, sin forzar", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "2026-11-19T09:00"); // 23 horas
+    const eximida = await cancelar(api, r.id, { exento: true, motivo: "Lluvia torrencial en todo el barrio" }, GESTOR);
+    assert.equal(eximida.status, 200);
+    assert.equal(eximida.cuerpo.reserva.estado, "cancelada");
+    assert.equal(eximida.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(eximida.cuerpo.reserva.motivoCancelacion, "Lluvia torrencial en todo el barrio");
+    assert.equal(eximida.cuerpo.reembolso, r.importe);
+  });
+});
+
+test("la exención necesita un motivo de al menos 10 caracteres", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "2026-11-19T09:00");
+    const corto = await cancelar(api, r.id, { exento: true, motivo: "corto ya" }, GESTOR);
+    assert.equal(corto.status, 400);
+    assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const sinMotivo = await cancelar(api, r.id, { exento: true }, GESTOR);
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    assert.equal((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva.estado, "confirmada");
+  });
+});
+
+test("solo un gestor puede eximir: 403 si es socio y 401 si no se sabe quién es", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "2026-11-19T09:00");
+    const motivo = { exento: true, motivo: "Lesión de un jugador acreditada" };
+    const socio = await cancelar(api, r.id, motivo, SOCIO);
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+    const anonimo = await cancelar(api, r.id, motivo);
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    assert.equal((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva.estado, "confirmada");
+  });
+});
+
+test("una reserva que ya ha empezado no se cancela, tampoco con exención", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "2026-11-19T09:00");
+    await moverReloj(api, "2026-11-19T10:00");
+    const pasada = await cancelar(api, r.id, { exento: true, motivo: "Motivo de sobra largo" }, GESTOR);
+    assert.equal(pasada.status, 409);
