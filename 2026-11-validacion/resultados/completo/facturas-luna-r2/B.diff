diff --git a/test/facturas.test.ts b/test/facturas.test.ts
new file mode 100644
index 0000000..1ae014c
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,90 @@
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => { api = await arrancarApi(); });
+after(() => api.cerrar());
+const gestor = { socio: "socio-040" };
+
+test("facturas exige gestor, valida el mes cerrado y genera octubre de forma idempotente", async () => {
+  const estadoSinIdentidad = await api.pedir("GET", "/_estado");
+  assert.equal(estadoSinIdentidad.status, 200);
+  assert.equal(Object.hasOwn(estadoSinIdentidad.cuerpo, "facturas"), false);
+  const sinIdentidad = await api.pedir("GET", "/api/facturas?mes=2026-10");
+  assert.equal(sinIdentidad.status, 401);
+  assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("POST", "/api/facturas", { socio: "socio-001", cuerpo: { mes: "2026-10" } });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const invalido = await api.pedir("POST", "/api/facturas", { ...gestor, cuerpo: { mes: "2026-13" } });
+  assert.equal(invalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-02-30", "2026-04-31"]) {
+    const imposible = await api.pedir("POST", "/api/facturas", { ...gestor, cuerpo: { mes } });
+    assert.equal(imposible.status, 400);
+    assert.equal(imposible.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  const abierto = await api.pedir("POST", "/api/facturas", { ...gestor, cuerpo: { mes: "2026-11" } });
+  assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+
+  const primera = await api.pedir("POST", "/api/facturas", { ...gestor, cuerpo: { mes: "2026-10" } });
+  assert.equal(primera.status, 201);
+  assert.ok(primera.cuerpo.facturas.length > 0);
+  const estadoGestor = await api.pedir("GET", "/_estado", gestor);
+  assert.equal(estadoGestor.status, 200);
+  assert.equal(Object.hasOwn(estadoGestor.cuerpo, "facturas"), false);
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", gestor)).cuerpo.facturas.length, primera.cuerpo.facturas.length);
+  assert.deepEqual(primera.cuerpo.facturas.map((f: any) => f.socioId), [...primera.cuerpo.facturas.map((f: any) => f.socioId)].sort());
+  for (const f of primera.cuerpo.facturas) {
+    assert.equal(f.total, f.lineas.reduce((n: number, l: any) => n + l.importe, 0));
+    assert.equal(f.base, Math.floor(f.total * 100 / 121 + 0.5));
+    assert.equal(f.iva, f.total - f.base);
+    assert.ok(f.lineas.every((l: any) => l.concepto === "Reserva"));
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-11", gestor)).cuerpo.facturas.length, 0);
+  const repetida = await api.pedir("POST", "/api/facturas", { ...gestor, cuerpo: { mes: "2026-10" } });
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo.facturas, primera.cuerpo.facturas);
+  const consultada = await api.pedir("GET", `/api/facturas/${primera.cuerpo.facturas[0].numero}`, gestor);
+  assert.deepEqual(consultada.cuerpo.factura, primera.cuerpo.facturas[0]);
+  const ausente = await api.pedir("GET", "/api/facturas/F2026-9999", gestor);
+  assert.equal(ausente.status, 404);
+  assert.equal(ausente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("penaliza líneas y mantiene la secuencia entre meses y años", async () => {
+  const otra = await arrancarApi({ AHORA: "2026-10-01T08:00" });
+  try {
+    const estado = (await otra.pedir("GET", "/_estado")).cuerpo;
+    // Una reserva histórica de la semilla se convierte en penalizada antes de que termine octubre.
+    const candidato = estado.reservas.find((r: any) => r.inicio.startsWith("2026-10-") && r.estado === "confirmada" && r.inicio > "2026-10-01T08:00");
+    assert.ok(candidato);
+    assert.equal((await otra.pedir("POST", `/api/reservas/${candidato.id}/cancelar`, { socio: "socio-040", cuerpo: { forzar: true } })).status, 200);
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-01T00:00" } });
+    const oct = await otra.pedir("POST", "/api/facturas", { ...gestor, cuerpo: { mes: "2026-10" } });
+    const penalizada = oct.cuerpo.facturas.flatMap((f: any) => f.lineas).find((l: any) => l.reservaId === candidato.id);
+    assert.equal(penalizada.concepto, "Penalización");
+    assert.equal(penalizada.importe, candidato.importe);
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T00:00" } });
+    const siguienteMes = await otra.pedir("POST", "/api/facturas", { ...gestor, cuerpo: { mes: "2026-11" } });
+    assert.ok(siguienteMes.cuerpo.facturas.length > 0);
+    const primerNumeroNuevo = Number(siguienteMes.cuerpo.facturas[0].numero.slice(-4));
+    assert.equal(primerNumeroNuevo, oct.cuerpo.facturas.length + 1);
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-01T00:00" } });
+    const reserva2027 = await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-02-10T19:30" } });
+    assert.equal(reserva2027.status, 201);
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-01T00:00" } });
+    const febrero = await otra.pedir("POST", "/api/facturas", { ...gestor, cuerpo: { mes: "2027-02" } });
+    assert.ok(febrero.cuerpo.facturas.every((f: any) => f.numero.startsWith("F2027-")));
+    assert.equal(febrero.cuerpo.facturas[0].numero, "F2027-0001");
+  } finally { otra.cerrar(); }
+});
+
+test("febrero sigue abierto durante todo su último día", async () => {
+  const febrero = await arrancarApi({ AHORA: "2026-02-28T23:59" });
+  try {
+    const respuesta = await febrero.pedir("POST", "/api/facturas", { ...gestor, cuerpo: { mes: "2026-02" } });
+    assert.equal(respuesta.status, 409);
+    assert.equal(respuesta.cuerpo.error.codigo, "MES_ABIERTO");
+  } finally { febrero.cerrar(); }
+});
