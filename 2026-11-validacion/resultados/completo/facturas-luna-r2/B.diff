+        const total = lineas.reduce((s, l) => s + l.importe, 0);
+        const base = Math.floor(total * 100 / 121 + 0.5);
+        return { numero: `F${anio}-${String(siguiente + i).padStart(4, "0")}`, mes, socioId, lineas, total, base, iva: total - base };
+      });
