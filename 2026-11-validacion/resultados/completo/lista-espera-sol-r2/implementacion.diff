+test("la cancelación forzada conserva la penalización y asigna solo al tener éxito", async () => {
+  const datos = { pistaId: "pista-3", inicio: "2026-11-19T09:00" };
+  await apuntar("socio-041", datos);
+  error(await cancelar(datos), 409, "FUERA_DE_PLAZO");
+  assert.equal((await listar()).cuerpo.esperas[0].estado, "activa");
+  const r = await cancelar(datos, { forzar: true, motivo: "No puede asistir" });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 1200);
+  assert.equal(r.cuerpo.reserva.motivoCancelacion, "No puede asistir");
+  const nueva = (await api.pedir("GET", `/api/reservas/${r.cuerpo.asignadaA}`)).cuerpo.reserva;
+  assert.equal(nueva.importe, 1200);
+  assert.equal(nueva.socioId, "socio-041");
+  assert.equal(nueva.penalizacion, undefined);
+  error(await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`), 409, "YA_CANCELADA");
+});
+
+async function llenarReservas(socioId: string) {
+  for (const inicio of ["2026-12-01T09:00", "2026-12-02T09:00", "2026-12-03T09:00"]) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-2", inicio } });
+    assert.equal(r.status, 201, r.texto);
+  }
+}
+
+test("salta y descarta a quien alcanza el límite de reservas", async () => {
+  await apuntar();
+  await apuntar("socio-004");
+  await llenarReservas("socio-041");
+  error(await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-12-04T09:00" } }), 409, "LIMITE_DE_RESERVAS");
+  const r = await cancelar();
+  assert.equal(r.status, 200);
+  assert.equal((await api.pedir("GET", `/api/reservas/${r.cuerpo.asignadaA}`)).cuerpo.reserva.socioId, "socio-004");
+  assert.deepEqual((await estado()).esperas.map((e) => e.estado), ["descartada", "asignada"]);
+  assert.deepEqual((await listar()).cuerpo.esperas, []);
+});
+
+test("sin candidatos aptos o sin lista, cancelar devuelve asignadaA null", async () => {
+  const sinLista = await cancelar(otraFranja);
+  assert.equal(sinLista.status, 200);
+  assert.equal(sinLista.cuerpo.asignadaA, null);
+  await llenarReservas("socio-041");
