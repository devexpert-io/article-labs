@@ -0,0 +1,191 @@
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import type { Estado } from "../src/tipos.ts";
+
+let api: Api;
+beforeEach(async () => { api = await arrancarApi(); });
+afterEach(() => api.cerrar());
+const franja = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+const otraFranja = { pistaId: "pista-1", inicio: "2026-11-21T15:00" };
+const terceraFranja = { pistaId: "pista-2", inicio: "2026-11-21T15:00" };
+const apuntar = (socio = "socio-041", cuerpo: unknown = franja) => api.pedir("POST", "/api/esperas", { socio, cuerpo });
+const listar = (socio = "socio-041", filtro = "") => api.pedir("GET", `/api/esperas${filtro}`, { socio });
+const estado = async (): Promise<Estado> => (await api.pedir("GET", "/_estado")).cuerpo;
+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status, r.texto);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+async function cancelar(datos = franja, cuerpo: unknown = {}) {
+  const r = (await estado()).reservas.find((r) => r.estado === "confirmada" && r.pistaId === datos.pistaId && r.inicio === datos.inicio)!;
+  return api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo });
+}
+
+test("apuntarse requiere identidad, devuelve la espera y usa a quien llama", async () => {
+  error(await api.pedir("POST", "/api/esperas", { cuerpo: franja }), 401, "NO_IDENTIFICADO");
+  error(await api.pedir("GET", "/api/esperas"), 401, "NO_IDENTIFICADO");
+  error(await api.pedir("DELETE", "/api/esperas/E-0001"), 401, "NO_IDENTIFICADO");
+  error(await apuntar("socio-999"), 401, "NO_IDENTIFICADO");
+  const r = await apuntar("socio-041", { ...franja, socioId: "socio-004" });
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.cuerpo.espera, { id: "E-0001", socioId: "socio-041", ...franja, estado: "activa", posicion: 1 });
+  assert.deepEqual((await listar()).cuerpo.esperas, [r.cuerpo.espera]);
+});
+
+test("se aplican las comprobaciones de pista, franja, cuota y ocupación", async () => {
+  const casos: [unknown, string, number, string][] = [
+    [{ ...franja, pistaId: "inexistente" }, "socio-041", 404, "PISTA_NO_ENCONTRADA"],
+    [{ ...franja, pistaId: "pista-4" }, "socio-041", 409, "PISTA_CERRADA"],
+    [{ ...franja, inicio: "2026-11-19T19:00" }, "socio-041", 400, "FRANJA_INVALIDA"],
+    [{ ...franja, inicio: "mañana" }, "socio-041", 400, "FRANJA_INVALIDA"],
+    [{ ...franja, inicio: "2026-11-18T09:00" }, "socio-041", 409, "FRANJA_PASADA"],
+    [{ ...franja, pistaId: "pista-2" }, "socio-041", 409, "FRANJA_LIBRE"],
+    [franja, "socio-011", 409, "CUOTA_INACTIVA"],
+    [{}, "socio-041", 400, "DATOS_INVALIDOS"],
+    [{ ...franja, inicio: 12 }, "socio-041", 400, "DATOS_INVALIDOS"],
+  ];
+  for (const [datos, socio, status, codigo] of casos) error(await apuntar(socio, datos), status, codigo);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: franja.inicio } });
+  error(await apuntar(), 409, "FRANJA_PASADA");
+  assert.equal((await estado()).esperas.length, 0);
+});
+
+test("sin duplicados ni esperas propias y como máximo dos activas", async () => {
+  error(await apuntar("socio-007"), 409, "YA_RESERVADA");
+  assert.equal((await apuntar()).status, 201);
+  error(await apuntar(), 409, "YA_EN_ESPERA");
+  assert.equal((await apuntar("socio-041", otraFranja)).status, 201);
+  error(await apuntar("socio-041", terceraFranja), 409, "LIMITE_DE_ESPERAS");
+  assert.equal((await listar()).cuerpo.esperas.length, 2);
+});
+
+test("posiciones por franja, permisos de consulta y retirada y reingreso al final", async () => {
+  const primera = (await apuntar()).cuerpo.espera;
+  const segunda = (await apuntar("socio-004")).cuerpo.espera;
+  assert.equal(segunda.posicion, 2);
+  assert.equal((await apuntar("socio-002", otraFranja)).cuerpo.espera.posicion, 1);
+  error(await listar("socio-004", "?socio=socio-041"), 403, "SIN_PERMISO");
+  assert.deepEqual((await listar("socio-040", "?socio=socio-041")).cuerpo.esperas, [primera]);
+  assert.deepEqual((await listar("socio-040")).cuerpo.esperas, []);
+  error(await api.pedir("DELETE", `/api/esperas/${primera.id}`, { socio: "socio-004" }), 403, "SIN_PERMISO");
+  error(await api.pedir("DELETE", "/api/esperas/no-existe", { socio: "socio-041" }), 404, "ESPERA_NO_ENCONTRADA");
+  const retirada = await api.pedir("DELETE", `/api/esperas/${primera.id}`, { socio: "socio-041" });
+  assert.equal(retirada.status, 200);
+  assert.equal(retirada.cuerpo.espera.estado, "retirada");
+  assert.equal("posicion" in retirada.cuerpo.espera, false);
+  assert.deepEqual((await listar()).cuerpo.esperas, []);
+  assert.equal((await listar("socio-004")).cuerpo.esperas[0].posicion, 1);
+  const nueva = (await apuntar()).cuerpo.espera;
+  assert.notEqual(nueva.id, primera.id);
+  assert.equal(nueva.posicion, 2);
+  const gestor = await api.pedir("DELETE", `/api/esperas/${segunda.id}`, { socio: "socio-040" });
+  assert.equal(gestor.cuerpo.espera.estado, "retirada");
+  assert.equal((await listar()).cuerpo.esperas[0].posicion, 1);
+});
+
+test("cancelar asigna por orden, con precio, nota y disponibilidad correctos", async () => {
+  const primera = (await apuntar()).cuerpo.espera;
+  await apuntar("socio-004");
