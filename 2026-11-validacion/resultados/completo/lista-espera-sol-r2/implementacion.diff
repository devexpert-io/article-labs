+test("las esperas caducan al empezar y dejan de contar para el límite", async () => {
+  await apuntar();
+  await apuntar("socio-041", otraFranja);
+  const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora: franja.inicio } });
+  assert.equal(reloj.status, 200);
+  const activas = (await listar()).cuerpo.esperas;
+  assert.equal(activas.length, 1);
+  assert.equal(activas[0].inicio, otraFranja.inicio);
+  assert.equal((await estado()).esperas[0].estado, "descartada");
+  error(await cancelar(franja, { forzar: true }), 409, "RESERVA_PASADA");
+  assert.equal((await apuntar("socio-041", terceraFranja)).status, 201);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-22T00:00" } });
+  assert.deepEqual((await listar()).cuerpo.esperas, []);
+  // Una espera caducada no revive aunque se atrase el reloj de pruebas.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:00" } });
+  assert.equal((await cancelar()).cuerpo.asignadaA, null);
+});
