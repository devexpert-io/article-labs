+test("el precio se calcula por minutos, con el recargo de punta desde las 18:00 y en fin de semana", () =>
+  conApi({}, async (api) => {
+    // Pista 1: valle 1800, punta 2800. Pista 3: valle 1200, punta 2000.
+    const enValle = await reservar(api, "socio-001", "pista-1", `${MARTES}T10:00`, 60);
+    assert.equal(enValle.cuerpo.reserva.importe, 1200);
+    // Ejemplo de la spec: 30 minutos de valle y 60 de punta = 2466,67 -> 2467.
+    const cruzaLas18 = await reservar(api, "socio-002", "pista-2", `${MARTES}T17:30`, 90);
+    assert.equal(cruzaLas18.cuerpo.reserva.importe, 2467);
+    // 60 minutos de valle y 60 de punta = 3066,67 -> 3067.
+    assert.equal((await reservar(api, "socio-003", "pista-1", `${MARTES}T17:00`, 120)).cuerpo.reserva.importe, 3067);
+    // Todo de punta: 60 × 2000 / 90 = 1333,33 -> 1333.
+    assert.equal((await reservar(api, "socio-004", "pista-3", `${MARTES}T18:00`, 60)).cuerpo.reserva.importe, 1333);
+    // Fin de semana: todo a precio de punta. 90 × 2000 / 90 = 2000; 120 × 2800 / 90 = 3733,33 -> 3733.
+    assert.equal((await reservar(api, "socio-005", "pista-3", `${SABADO}T10:00`, 90)).cuerpo.reserva.importe, 2000);
+    assert.equal((await reservar(api, "socio-006", "pista-1", `${SABADO}T10:00`, 120)).cuerpo.reserva.importe, 3733);
+    // Entre semana, antes de las 18:00 y todo de valle: 60 × 1200 / 90 = 800.
+    assert.equal((await reservar(api, "socio-007", "pista-3", `${MARTES}T10:00`, 60)).cuerpo.reserva.importe, 800);
