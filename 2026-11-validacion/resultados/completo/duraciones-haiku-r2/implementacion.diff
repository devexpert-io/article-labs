+test("en la disponibilidad, una franja de 90 minutos está reservada si se solapa en parte con una reserva", () =>
+  conApi({}, async (api) => {
+    // 120 minutos desde las 12:00: ocupan las franjas de las 12:00 y de las 13:30, y no la de las 10:30 ni la de las 15:00.
+    assert.equal((await reservar(api, "socio-001", "pista-3", `${MARTES}T12:00`, 120)).status, 201);
+    // 60 minutos desde las 10:30: ocupan la franja de las 10:30, pero no la de las 09:00 (que acaba justo a las 10:30).
+    assert.equal((await reservar(api, "socio-002", "pista-1", `${MARTES}T10:30`, 60)).status, 201);
+
+    const r = await api.pedir("GET", `/api/disponibilidad?fecha=${MARTES}`);
+    const estados = (pista: string) =>
+      Object.fromEntries(r.cuerpo.pistas.find((p: { pistaId: string }) => p.pistaId === pista).franjas.map((f: { inicio: string; estado: string }) => [f.inicio.slice(11), f.estado]));
+    const pista3 = estados("pista-3");
+    assert.equal(pista3["09:00"], "libre");
+    assert.equal(pista3["10:30"], "libre");
+    assert.equal(pista3["12:00"], "reservada");
+    assert.equal(pista3["13:30"], "reservada");
+    assert.equal(pista3["15:00"], "libre");
+    const pista1 = estados("pista-1");
+    assert.equal(pista1["09:00"], "libre");
+    assert.equal(pista1["10:30"], "reservada");
+    assert.equal(pista1["12:00"], "libre");
+  }));
