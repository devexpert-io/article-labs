+++ b/test/duraciones.test.ts
@@ -0,0 +1,224 @@
+// Reservas de 60, 90 o 120 minutos: duración, inicios, solapes, precio por minutos, disponibilidad y huecos.
+// Cada prueba arranca su propia API para que los límites y las franjas no se mezclen entre pruebas.
+// El martes 1 de diciembre de 2026 y el sábado 5 no tienen reservas en la semilla (que acaba el 24 de noviembre).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const MARTES = "2026-12-01";
+const SABADO = "2026-12-05";
+
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function reservar(api: Api, socioId: string, pistaId: string, inicio: string, duracion?: unknown) {
+  const cuerpo: Record<string, unknown> = { socioId, pistaId, inicio };
+  if (duracion !== undefined) cuerpo.duracion = duracion;
+  return api.pedir("POST", "/api/reservas", { cuerpo });
+}
+
+test("la duración es 60, 90 o 120 minutos, y 90 por defecto", () =>
+  conApi({}, async (api) => {
+    const una = await reservar(api, "socio-001", "pista-1", `${MARTES}T10:30`, 60);
+    assert.equal(una.status, 201);
+    assert.equal(una.cuerpo.reserva.duracion, 60);
+    assert.equal(una.cuerpo.reserva.fin, `${MARTES}T11:30`);
+
+    const porDefecto = await reservar(api, "socio-002", "pista-1", `${MARTES}T12:00`);
+    assert.equal(porDefecto.status, 201);
+    assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+    assert.equal(porDefecto.cuerpo.reserva.fin, `${MARTES}T13:30`);
+
+    const larga = await reservar(api, "socio-003", "pista-1", `${MARTES}T14:00`, 120);
+    assert.equal(larga.status, 201);
+    assert.equal(larga.cuerpo.reserva.duracion, 120);
+    assert.equal(larga.cuerpo.reserva.fin, `${MARTES}T16:00`);
+  }));
+
+test("una duración distinta de 60, 90 o 120 responde DURACION_INVALIDA", () =>
+  conApi({}, async (api) => {
+    for (const duracion of [45, 0, 150, "90", null, true]) {
+      const r = await reservar(api, "socio-004", "pista-2", `${MARTES}T10:00`, duracion);
+      assert.equal(r.status, 400, `duracion ${JSON.stringify(duracion)}`);
+      assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA");
+    }
+    assert.equal((await api.pedir("GET", "/_estado")).cuerpo.reservas.filter((r: { pistaId: string; inicio: string }) => r.pistaId === "pista-2" && r.inicio.startsWith(MARTES)).length, 0);
+  }));
+
+test("una reserva empieza en punto o y media, no antes de las 09:00 y termina como muy tarde a las 22:30", () =>
+  conApi({}, async (api) => {
+    const sinMedia = await reservar(api, "socio-005", "pista-2", `${MARTES}T10:15`, 60);
+    assert.equal(sinMedia.cuerpo.error.codigo, "FRANJA_INVALIDA");
+    assert.equal((await reservar(api, "socio-005", "pista-2", `${MARTES}T13:45`, 90)).cuerpo.error.codigo, "FRANJA_INVALIDA");
+    assert.equal((await reservar(api, "socio-005", "pista-2", `${MARTES}T08:30`, 90)).cuerpo.error.codigo, "FRANJA_INVALIDA");
+    assert.equal((await reservar(api, "socio-005", "pista-2", `${MARTES}T21:30`, 90)).cuerpo.error.codigo, "FRANJA_INVALIDA");
+    assert.equal((await reservar(api, "socio-005", "pista-2", `${MARTES}T22:00`, 60)).cuerpo.error.codigo, "FRANJA_INVALIDA");
+    assert.equal((await reservar(api, "socio-005", "pista-2", `${MARTES}T21:00`, 120)).cuerpo.error.codigo, "FRANJA_INVALIDA");
+
+    const ultima = await reservar(api, "socio-005", "pista-2", `${MARTES}T21:30`, 60);
+    assert.equal(ultima.status, 201);
+    assert.equal(ultima.cuerpo.reserva.fin, `${MARTES}T22:30`);
+    const primera = await reservar(api, "socio-006", "pista-2", `${MARTES}T09:00`, 120);
+    assert.equal(primera.status, 201);
+    assert.equal(primera.cuerpo.reserva.fin, `${MARTES}T11:00`);
+  }));
+
+test("una reserva no se solapa con otra confirmada de la misma pista, nueva o de la semilla", () =>
+  conApi({}, async (api) => {
+    assert.equal((await reservar(api, "socio-007", "pista-3", `${MARTES}T12:00`, 120)).status, 201);
+    assert.equal((await reservar(api, "socio-008", "pista-3", `${MARTES}T13:30`, 60)).cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+    assert.equal((await reservar(api, "socio-008", "pista-3", `${MARTES}T11:30`, 90)).cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+    // Terminar justo cuando empieza otra no es solaparse.
