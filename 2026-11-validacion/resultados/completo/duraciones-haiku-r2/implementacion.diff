+test("una reserva de 90 minutos a una hora de siempre cuesta lo mismo que la franja", () =>
+  conApi({}, async (api) => {
+    const disponibilidad = await api.pedir("GET", `/api/disponibilidad?fecha=${MARTES}&pista=pista-2`);
+    const franjas = disponibilidad.cuerpo.pistas[0].franjas as { inicio: string; precio: number }[];
+    const horas = ["09:00", "10:30", "12:00", "13:30", "15:00", "16:30", "18:00", "19:30", "21:00"];
+    const esperados = Object.fromEntries(horas.map((h) => [h, h >= "18:00" ? 2800 : 1800]));
+    assert.equal(franjas.length, horas.length);
+    for (const franja of franjas) {
+      assert.equal(franja.precio, esperados[franja.inicio.slice(11)]);
+    }
+    const socios = ["socio-001", "socio-002", "socio-003", "socio-004", "socio-005", "socio-006", "socio-007", "socio-008", "socio-009"];
+    for (const [i, hora] of horas.entries()) {
+      const r = await reservar(api, socios[i]!, "pista-2", `${MARTES}T${hora}`);
+      assert.equal(r.status, 201, hora);
+      assert.equal(r.cuerpo.reserva.duracion, 90);
+      assert.equal(r.cuerpo.reserva.importe, franjas[i]!.precio, `importe de ${hora}`);
+    }
+  }));
