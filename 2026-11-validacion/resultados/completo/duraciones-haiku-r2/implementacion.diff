+test("huecos: los intervalos libres del día entre las 09:00 y las 22:30, en cada pista", () =>
+  conApi({}, async (api) => {
+    assert.equal((await reservar(api, "socio-001", "pista-3", `${MARTES}T12:00`, 120)).status, 201);
+    assert.equal((await reservar(api, "socio-002", "pista-1", `${MARTES}T09:30`, 60)).status, 201);
+    assert.equal((await reservar(api, "socio-003", "pista-1", `${MARTES}T10:30`, 60)).status, 201);
+    assert.equal((await reservar(api, "socio-004", "pista-1", `${MARTES}T21:30`, 60)).status, 201);
+
+    const r = await api.pedir("GET", `/api/disponibilidad?fecha=${MARTES}`);
+    const huecos = (pista: string) => r.cuerpo.pistas.find((p: { pistaId: string }) => p.pistaId === pista).huecos;
+    // Pista 3: antes de la reserva de 12:00 y después de que acabe a las 14:00.
+    assert.deepEqual(huecos("pista-3"), [
+      { inicio: `${MARTES}T09:00`, fin: `${MARTES}T12:00` },
+      { inicio: `${MARTES}T14:00`, fin: `${MARTES}T22:30` },
+    ]);
+    // Pista 1: media hora libre al principio (las reservas pegadas no dejan hueco), y todo lo demás hasta las 21:30.
+    assert.deepEqual(huecos("pista-1"), [
+      { inicio: `${MARTES}T09:00`, fin: `${MARTES}T09:30` },
+      { inicio: `${MARTES}T11:30`, fin: `${MARTES}T21:30` },
+    ]);
+    // Pista 2, libre todo el día.
+    assert.deepEqual(huecos("pista-2"), [{ inicio: `${MARTES}T09:00`, fin: `${MARTES}T22:30` }]);
+    // Pista 4, cerrada: sin huecos.
+    assert.deepEqual(huecos("pista-4"), []);
+  }));
