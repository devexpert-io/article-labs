+    for (const fecha of ["2026-11-25", "2026-11-28"]) {
+      for (const pista of [{ id: "pista-1", valle: 1800, punta: 2800 }, { id: "pista-3", valle: 1200, punta: 2000 }]) {
+        const franjas = (await disponibilidad(api, fecha, pista.id)).franjas;
+        for (const hora of horas) {
+          const esperado = fecha === "2026-11-28" || hora >= "18:00" ? pista.punta : pista.valle;
+          const r = await reservar(api, { socioId: "socio-006", pistaId: pista.id, inicio: `${fecha}T${hora}` });
