+test("6. una reserva de 90 minutos a una hora de siempre cuesta lo mismo que antes", () =>
+  conApi(async (api) => {
+    const horas = ["09:00", "10:30", "12:00", "13:30", "15:00", "16:30", "18:00", "19:30", "21:00"];
