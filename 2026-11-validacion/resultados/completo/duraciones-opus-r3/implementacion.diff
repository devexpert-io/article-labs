+ */
+export function importeReserva(pista: Pista, inicio: string, duracion: number): number {
+  const dia = diaDeLaSemana(inicio.slice(0, 10));
+  const desde = minutosDelDia(inicio);
+  const hasta = desde + duracion;
+  const finDeSemana = dia === 0 || dia === 6;
+  const minutosValle = finDeSemana ? 0 : Math.max(0, Math.min(hasta, INICIO_PUNTA) - desde);
+  const minutosPunta = duracion - minutosValle;
+  const numerador = minutosValle * pista.precioValle + minutosPunta * pista.precioPunta;
+  // Redondeo de numerador / 90 con medio hacia arriba, en enteros para no arrastrar decimales.
+  return Math.floor((2 * numerador + MINUTOS_FRANJA) / (2 * MINUTOS_FRANJA));
