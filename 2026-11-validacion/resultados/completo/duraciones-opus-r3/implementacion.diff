+// Reservas de 60, 90 o 120 minutos (docs/specs/duraciones.md), probadas a través de la API.
+// Cada test arranca su propia API para partir siempre de la semilla.
+// En la semilla no hay ninguna reserva a partir del miércoles 25 de noviembre.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const reservar = (api: Api, cuerpo: Record<string, unknown>) => api.pedir("POST", "/api/reservas", { cuerpo });
+
+const disponibilidad = async (api: Api, fecha: string, pista: string) =>
+  (await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pista}`)).cuerpo.pistas[0];
+
+test("1. duracion es opcional, vale 60, 90 o 120 y por defecto son 90", () =>
+  conApi(async (api) => {
+    const porDefecto = await reservar(api, { socioId: "socio-006", pistaId: "pista-1", inicio: "2026-11-25T09:00" });
+    assert.equal(porDefecto.status, 201);
+    assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+    assert.equal(porDefecto.cuerpo.reserva.fin, "2026-11-25T10:30");
+    const de60 = await reservar(api, { socioId: "socio-006", pistaId: "pista-2", inicio: "2026-11-25T09:00", duracion: 60 });
+    assert.equal(de60.status, 201);
+    assert.equal(de60.cuerpo.reserva.duracion, 60);
+    const de120 = await reservar(api, { socioId: "socio-006", pistaId: "pista-3", inicio: "2026-11-25T09:00", duracion: 120 });
+    assert.equal(de120.status, 201);
+    assert.equal(de120.cuerpo.reserva.duracion, 120);
+    for (const duracion of [45, 0, 150, 90.5, "90", null, true]) {
+      const r = await reservar(api, { socioId: "socio-016", pistaId: "pista-1", inicio: "2026-11-26T09:00", duracion });
+      assert.equal(r.status, 400, `duracion ${JSON.stringify(duracion)}`);
+      assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA");
+    }
+  }));
+
+test("2. una reserva empieza en punto o y media, desde las 09:00, y termina como muy tarde a las 22:30", () =>
+  conApi(async (api) => {
+    const validas: [string, number, string][] = [
+      ["pista-1", 60, "2026-11-25T09:30"],
+      ["pista-2", 120, "2026-11-25T14:00"],
+      ["pista-3", 60, "2026-11-25T21:30"],
+      ["pista-1", 120, "2026-11-26T20:30"],
+      ["pista-2", 90, "2026-11-26T21:00"],
+    ];
+    const socios = ["socio-006", "socio-016", "socio-020", "socio-023", "socio-024"];
+    for (const [i, [pistaId, duracion, inicio]] of validas.entries()) {
+      const r = await reservar(api, { socioId: socios[i], pistaId, inicio, duracion });
+      assert.equal(r.status, 201, `${inicio} ${duracion}`);
+    }
+    const invalidas: [number, string][] = [
+      [60, "2026-11-27T10:15"],
+      [60, "2026-11-27T10:45"],
+      [90, "2026-11-27T08:30"],
+      [60, "2026-11-27T08:00"],
+      [60, "2026-11-27T22:00"],
+      [90, "2026-11-27T21:30"],
+      [120, "2026-11-27T21:00"],
+      [60, "2026-11-27T23:00"],
+      [60, "2026-11-27 10:00"],
+      [60, "2026-11-27T1000"],
+    ];
+    for (const [duracion, inicio] of invalidas) {
+      const r = await reservar(api, { socioId: "socio-026", pistaId: "pista-1", inicio, duracion });
+      assert.equal(r.status, 400, `${inicio} ${duracion}`);
+      assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA");
+    }
+  }));
+
+test("3. fin es inicio más la duración", () =>
+  conApi(async (api) => {
+    const casos: [number, string, string][] = [
+      [60, "2026-11-25T09:30", "2026-11-25T10:30"],
+      [90, "2026-11-25T12:30", "2026-11-25T14:00"],
+      [120, "2026-11-25T20:30", "2026-11-25T22:30"],
+    ];
+    for (const [duracion, inicio, fin] of casos) {
+      const r = await reservar(api, { socioId: "socio-006", pistaId: "pista-1", inicio, duracion });
+      assert.equal(r.cuerpo.reserva.fin, fin);
+    }
+  }));
+
+test("4. no se puede solapar con reservas confirmadas, nuevas o antiguas; tocarse no es solaparse", () =>
