+/** Minutos desde las 00:00 de una hora `HH:MM` o de un `AAAA-MM-DDTHH:MM`. */
+export function minutosDelDia(fechaHora: string): number {
+  const [h, m] = fechaHora.slice(-5).split(":").map(Number);
+  return h! * 60 + m!;
+}
+
+/** `AAAA-MM-DDTHH:MM` del día `fecha` a los `minutos` desde las 00:00. */
+export function aFechaHora(fecha: string, minutos: number): string {
+  const hh = String(Math.floor(minutos / 60)).padStart(2, "0");
+  const mm = String(minutos % 60).padStart(2, "0");
+  return `${fecha}T${hh}:${mm}`;
+}
+
+export function sumarMinutos(inicio: string, minutos: number): string {
+  return aFechaHora(inicio.slice(0, 10), minutosDelDia(inicio) + minutos);
+}
