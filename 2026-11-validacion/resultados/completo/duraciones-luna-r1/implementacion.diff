+function minutos(fechaHora: string): number {
+  const [h, m] = fechaHora.slice(11).split(":").map(Number);
+  return h! * 60 + m!;
+}
+
+function finConDuracion(inicio: string, duracion: number): string {
+  const total = minutos(inicio) + duracion;
+  return `${inicio.slice(0, 10)}T${String(Math.floor(total / 60)).padStart(2, "0")}:${String(total % 60).padStart(2, "0")}`;
+}
+
+function importe(p: { precioValle: number; precioPunta: number }, inicio: string, duracion: number): number {
+  let total = 0;
+  for (let i = 0; i < duracion; i++) {
+    const hora = minutos(inicio) + i;
+    const punta = new Date(`${inicio.slice(0, 10)}T12:00:00Z`).getUTCDay() % 6 === 0 || hora >= 18 * 60;
+    total += (punta ? p.precioPunta : p.precioValle) / 90;
+  }
+  return Math.floor(total + 0.5);
+}
+
+function solapa(aInicio: string, aFin: string, bInicio: string, bFin: string): boolean {
+  return aInicio < bFin && bInicio < aFin;
+}
