@@ -0,0 +1,145 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const crear = (api: Api, inicio: string, duracion?: unknown, pistaId = "pista-1", socioId = "socio-041") =>
+  api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio, ...(duracion === undefined ? {} : { duracion }) } });
+
+async function conApi(probar: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try { await probar(api); } finally { api.cerrar(); }
+}
+
+function error(r: any, status: number, codigo: string) {
+  assert.equal(r.status, status, r.texto);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+test("duración opcional, fin y duración en creación, consulta, listado y cancelación", async () => conApi(async (api) => {
+  for (const [i, duracion] of [undefined, 60, 90, 120].entries()) {
+    const fecha = `2026-12-0${i + 1}`;
+    const r = await crear(api, `${fecha}T09:30`, duracion);
+    assert.equal(r.status, 201, r.texto);
+    const reserva = r.cuerpo.reserva;
+    assert.equal(reserva.duracion, duracion ?? 90);
+    assert.equal(reserva.fin, `${fecha}T${duracion === 60 ? "10:30" : duracion === 120 ? "11:30" : "11:00"}`);
+    assert.deepEqual((await api.pedir("GET", `/api/reservas/${reserva.id}`)).cuerpo.reserva, reserva);
+    assert.deepEqual((await api.pedir("GET", `/api/reservas?fecha=${fecha}`)).cuerpo.reservas, [reserva]);
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.cuerpo.reserva.duracion, duracion ?? 90);
+  }
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  for (const r of estado.reservas.filter((r: any) => r.inicio < "2026-12")) assert.equal(r.duracion, 90);
+  const antigua = (await api.pedir("GET", "/api/reservas?limite=1")).cuerpo.reservas[0];
+  assert.equal(antigua.duracion, 90);
+  assert.equal((await api.pedir("GET", `/api/reservas/${antigua.id}`)).cuerpo.reserva.duracion, 90);
+}));
+
+test("rechaza duraciones y horas inválidas y respeta apertura y cierre", async () => conApi(async (api) => {
+  for (const duracion of [null, "60", true, false, 0, -60, 30, 61, 90.5, 180, [], {}]) {
+    error(await crear(api, "2026-12-01T09:00", duracion), 400, "DURACION_INVALIDA");
+  }
+  for (const [hora, duracion] of [["08:30", 120], ["09:15", 60], ["21:30", 90], ["21:00", 120], ["22:00", 60], ["24:00", 60], ["99:30", 60], ["10:60", 60], ["9:00", 60], ["invalida", 60]] as const) {
+    error(await crear(api, `2026-12-01T${hora}`, duracion), 400, "FRANJA_INVALIDA");
+  }
+  for (const [i, [hora, duracion]] of [["09:00", 60], ["21:30", 60], ["21:00", 90], ["20:30", 120]].entries()) {
+    const r = await crear(api, `2026-12-0${i + 1}T${hora}`, duracion);
+    assert.equal(r.status, 201, r.texto);
+    await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+  }
+}));
+
+test("solapes parciales, inclusión, reservas antiguas, adyacencia y canceladas", async () => conApi(async (api) => {
+  error(await crear(api, "2026-11-19T19:00", 60), 409, "FRANJA_NO_DISPONIBLE");
+  error(await crear(api, "2026-11-19T20:30", 60), 409, "FRANJA_NO_DISPONIBLE");
+  const r = await crear(api, "2026-12-01T10:00", 120);
+  assert.equal(r.status, 201);
+  for (const [hora, duracion] of [["09:30", 60], ["11:30", 60], ["10:30", 60], ["10:00", 120], ["09:30", 120]] as const) {
+    error(await crear(api, `2026-12-01T${hora}`, duracion), 409, "FRANJA_NO_DISPONIBLE");
+  }
+  assert.equal((await crear(api, "2026-12-01T09:00", 60)).status, 201);
+  assert.equal((await crear(api, "2026-12-01T12:00", 60)).status, 201);
+  await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+  assert.equal((await crear(api, "2026-12-01T10:00", 120)).status, 201);
+}));
+
+test("precio por minutos, cruces de las 18:00, redondeo, fines de semana y precios tradicionales", async () => conApi(async (api) => {
+  const casos: [string, number, string, number][] = [
+    ["2026-12-01T17:30", 90, "pista-1", 2467],
+    ["2026-12-01T17:30", 60, "pista-1", 1533],
+    ["2026-12-01T17:00", 120, "pista-1", 3067],
+    ["2026-12-01T09:00", 60, "pista-3", 800],
+    ["2026-12-01T18:00", 120, "pista-3", 2667],
+    ["2026-12-05T09:00", 60, "pista-1", 1867],
+    ["2026-12-06T16:30", 120, "pista-3", 2667],
+  ];
+  for (const pista of ["pista-1", "pista-3"]) {
+    for (const fecha of ["2026-12-01", "2026-12-05", "2026-12-06"]) {
+      for (const hora of ["09:00", "10:30", "12:00", "13:30", "15:00", "16:30", "18:00", "19:30", "21:00"]) {
+        const punta = fecha !== "2026-12-01" || hora >= "18:00";
+        casos.push([`${fecha}T${hora}`, 90, pista, pista === "pista-1" ? (punta ? 2800 : 1800) : (punta ? 2000 : 1200)]);
+      }
+    }
+  }
+  for (const [inicio, duracion, pista, importe] of casos) {
+    const r = await crear(api, inicio, duracion, pista);
+    assert.equal(r.status, 201, r.texto);
+    assert.equal(r.cuerpo.reserva.importe, importe, `${inicio}, ${duracion}, ${pista}`);
+    await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+  }
+}));
+
+test("disponibilidad marca cualquier solape y devuelve huecos máximos ordenados sin mirar el reloj", async () => conApi(async (api) => {
+  const reservas = [];
+  for (const [hora, duracion] of [["10:00", 60], ["11:00", 90], ["20:30", 120]] as const) {
+    const r = await crear(api, `2026-12-01T${hora}`, duracion);
+    assert.equal(r.status, 201);
+    reservas.push(r.cuerpo.reserva);
+  }
+  const ruta = "/api/disponibilidad?fecha=2026-12-01";
+  const datos = (await api.pedir("GET", ruta)).cuerpo;
+  const pista = datos.pistas.find((p: any) => p.pistaId === "pista-1");
+  assert.equal(pista.franjas.length, 9);
+  assert.deepEqual(pista.franjas.map((f: any) => f.estado), ["reservada", "reservada", "reservada", "libre", "libre", "libre", "libre", "reservada", "reservada"]);
+  assert.deepEqual(pista.huecos, [
+    { inicio: "2026-12-01T09:00", fin: "2026-12-01T10:00" },
+    { inicio: "2026-12-01T12:30", fin: "2026-12-01T20:30" },
+  ]);
+  assert.deepEqual(datos.pistas.find((p: any) => p.pistaId === "pista-2").huecos, [{ inicio: "2026-12-01T09:00", fin: "2026-12-01T22:30" }]);
+  assert.deepEqual(datos.pistas.find((p: any) => p.pistaId === "pista-4").huecos, []);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T12:00" } });
+  assert.deepEqual((await api.pedir("GET", ruta)).cuerpo, datos);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:00" } });
+  for (const r of reservas) await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+  assert.deepEqual((await api.pedir("GET", `${ruta}&pista=pista-1`)).cuerpo.pistas[0].huecos, [{ inicio: "2026-12-01T09:00", fin: "2026-12-01T22:30" }]);
+}));
+
+test("las duraciones respetan cuota, cierre, reloj y máximo de tres reservas", async () => conApi(async (api) => {
+  for (const duracion of [60, 90, 120]) {
+    error(await crear(api, "2026-12-01T09:00", duracion, "pista-1", "socio-011"), 409, "CUOTA_INACTIVA");
+    error(await crear(api, "2026-12-01T09:00", duracion, "pista-4"), 409, "PISTA_CERRADA");
+    error(await crear(api, "2026-11-18T10:00", duracion), 409, "FRANJA_PASADA");
+    assert.equal((await crear(api, `2026-12-0${duracion / 30}T09:00`, duracion)).status, 201);
+  }
+  error(await crear(api, "2026-12-09T09:00", 60), 409, "LIMITE_DE_RESERVAS");
+}));
+
+test("cancelación gratis a 24 horas y penalización completa fuera de plazo para cada duración", async () => conApi(async (api) => {
+  for (const [i, duracion] of [60, 90, 120].entries()) {
+    const fecha = `2026-12-0${i + 1}`;
+    const r = await crear(api, `${fecha}T17:30`, duracion);
+    assert.equal(r.status, 201);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: `${fecha}T09:00` } });
+    error(await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`), 409, "FUERA_DE_PLAZO");
+    const cancelada = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, r.cuerpo.reserva.importe);
+    assert.equal(cancelada.cuerpo.reserva.duracion, duracion);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:00" } });
+    const gratis = await crear(api, `${fecha}T17:30`, duracion);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: `2026-11-30T17:30` } });
+    const cancelacion = await api.pedir("POST", `/api/reservas/${gratis.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelacion.status, 200);
+    assert.equal(cancelacion.cuerpo.reserva.penalizacion, undefined);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:00" } });
+  }
+}));
