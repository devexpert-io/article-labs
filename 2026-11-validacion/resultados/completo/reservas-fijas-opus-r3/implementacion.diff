@@ -0,0 +1,239 @@
+// Reservas fijas semanales (docs/specs/reservas-fijas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const crearSerie = (cuerpo: unknown, socio = GESTOR) => api.pedir("POST", "/api/series", { cuerpo, socio });
+const contar = async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  return { reservas: estado.reservas.length, series: estado.series.length, contador: estado.contador };
+};
+
+test("solo un gestor crea, consulta y cancela series", async () => {
+  const datos = { socioId: "socio-003", pistaId: "pista-2", inicio: "2027-01-04T09:00", semanas: 2 };
+  const sinCabecera = await api.pedir("POST", "/api/series", { cuerpo: datos });
+  assert.equal(sinCabecera.status, 401);
+  assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await crearSerie(datos, "socio-003");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const creada = await crearSerie(datos);
+  assert.equal(creada.status, 201);
+  const id = creada.cuerpo.serie.id;
+  for (const [metodo, ruta] of [["GET", `/api/series/${id}`], ["POST", `/api/series/${id}/cancelar`]] as const) {
+    const anonimo = await api.pedir(metodo, ruta);
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const noGestor = await api.pedir(metodo, ruta, { socio: "socio-003" });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  const intactas = await api.pedir("GET", `/api/series/${id}`, { socio: GESTOR });
+  assert.ok(intactas.cuerpo.serie.reservas.every((r: any) => r.estado === "confirmada"));
+});
+
+test("valida semanas, socio, pista e inicio", async () => {
+  const base = { socioId: "socio-003", pistaId: "pista-2", inicio: "2027-01-04T10:30", semanas: 4 };
+  for (const semanas of [1, 13, 2.5, "4", undefined, 0]) {
+    const r = await crearSerie({ ...base, semanas });
+    assert.equal(r.status, 400, `semanas=${semanas}`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  const casos: [Record<string, unknown>, number, string][] = [
+    [{ socioId: "socio-999" }, 404, "SOCIO_NO_ENCONTRADO"],
+    [{ pistaId: "pista-9" }, 404, "PISTA_NO_ENCONTRADA"],
+    [{ inicio: "2027-01-04T10:00" }, 400, "FRANJA_INVALIDA"],
+    [{ inicio: "4 de enero" }, 400, "FRANJA_INVALIDA"],
+    [{ inicio: "2026-11-18T09:00" }, 409, "FRANJA_PASADA"],
+    [{ inicio: "2026-11-18T10:00" }, 400, "FRANJA_INVALIDA"],
+  ];
+  const antes = await contar();
+  for (const [cambio, http, codigo] of casos) {
+    const r = await crearSerie({ ...base, ...cambio });
+    assert.equal(r.status, http, JSON.stringify(cambio));
+    assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+  assert.deepEqual(await contar(), antes);
+});
+
+test("una reserva cada 7 días a la misma hora local, también con cambio de hora", async () => {
+  const r = await crearSerie({ socioId: "socio-003", pistaId: "pista-2", inicio: "2027-03-23T19:30", semanas: 3 });
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.cuerpo.serie.reservas.map((x: any) => x.inicio), ["2027-03-23T19:30", "2027-03-30T19:30", "2027-04-06T19:30"]);
+  assert.deepEqual(r.cuerpo.serie.reservas.map((x: any) => x.fin), ["2027-03-23T21:00", "2027-03-30T21:00", "2027-04-06T21:00"]);
+  for (const x of r.cuerpo.serie.reservas) {
