+test("cancelar la serie: gratis con 24 horas o más, pendientes las de menos salvo con forzar", async () => {
+  const otra = await arrancarApi();
+  try {
+    const gestor = { socio: GESTOR };
+    // Miércoles 25 de noviembre a 23 de diciembre a las 19:30 (punta, pista 3: 2000).
+    const creada = await otra.pedir("POST", "/api/series", { ...gestor, cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-25T19:30", semanas: 5 } });
+    assert.equal(creada.status, 201);
+    const [s1, s2, s3, s4, s5] = creada.cuerpo.serie.reservas.map((x: any) => x.id);
+    const id = creada.cuerpo.serie.id;
+
+    // Una reserva de la serie se cancela sola, con las reglas de siempre.
+    const suelta = await otra.pedir("POST", `/api/reservas/${s4}/cancelar`, { cuerpo: { motivo: "vacaciones" } });
+    assert.equal(suelta.status, 200);
+    assert.equal(suelta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(suelta.cuerpo.reserva.penalizacion, undefined);
+    const sigue = await otra.pedir("GET", `/api/series/${id}`, gestor);
+    assert.deepEqual(sigue.cuerpo.serie.reservas.map((x: any) => x.estado), ["confirmada", "confirmada", "confirmada", "cancelada", "confirmada"]);
+
+    // Martes 8 de diciembre a las 20:00: s1 y s2 ya pasaron, a s3 le faltan 23,5 horas y a s5, más de 24.
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-08T20:00" } });
+    const malForzar = await otra.pedir("POST", `/api/series/${id}/cancelar`, { ...gestor, cuerpo: { forzar: "si" } });
+    assert.equal(malForzar.status, 400);
+    const r = await otra.pedir("POST", `/api/series/${id}/cancelar`, gestor);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.serie.id, id);
+    assert.deepEqual(r.cuerpo.canceladas.map((x: any) => x.id), [s5]);
+    assert.equal(r.cuerpo.canceladas[0].estado, "cancelada");
+    assert.equal(r.cuerpo.canceladas[0].penalizacion, undefined);
+    assert.deepEqual(r.cuerpo.pendientes.map((x: any) => x.id), [s3]);
+    assert.equal(r.cuerpo.pendientes[0].estado, "confirmada");
+
+    const forzada = await otra.pedir("POST", `/api/series/${id}/cancelar`, { ...gestor, cuerpo: { forzar: true } });
+    assert.deepEqual(forzada.cuerpo.canceladas.map((x: any) => x.id), [s3]);
+    assert.equal(forzada.cuerpo.canceladas[0].penalizacion, 2000);
+    assert.deepEqual(forzada.cuerpo.pendientes, []);
+
+    const final = await otra.pedir("GET", `/api/series/${id}`, gestor);
+    const porId = Object.fromEntries(final.cuerpo.serie.reservas.map((x: any) => [x.id, x]));
+    assert.equal(porId[s1].estado, "confirmada", "las ya empezadas no se tocan");
+    assert.equal(porId[s2].estado, "confirmada");
+    assert.equal(porId[s4].motivoCancelacion, "vacaciones", "las ya canceladas no se tocan");
+    assert.equal(porId[s4].penalizacion, undefined);
+
+    // Una reserva suelta de serie a menos de 24 horas necesita forzar, como cualquier otra.
+    const otraSerie = await otra.pedir("POST", "/api/series", { ...gestor, cuerpo: { socioId: "socio-003", pistaId: "pista-2", inicio: "2026-12-09T12:00", semanas: 2 } });
+    const primera = otraSerie.cuerpo.serie.reservas[0].id;
