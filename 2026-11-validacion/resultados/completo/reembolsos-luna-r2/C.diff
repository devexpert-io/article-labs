+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+test("un informe mantiene la penalización histórica de reservas canceladas", () => {
+  const estado = crearSemilla();
+  const historica = estado.reservas.find((r) => r.estado === "cancelada")!;
+  historica.penalizacion = 375;
+  const informe = crearClub(estado).informeCaja(historica.inicio.slice(0, 7));
+  const pista = informe.pistas.find((p) => p.pistaId === historica.pistaId)!;
+  assert.equal(historica.penalizacion, 375);
+  assert.equal(pista.penalizaciones, 375);
+  assert.equal(informe.total.penalizaciones, 375);
+});
