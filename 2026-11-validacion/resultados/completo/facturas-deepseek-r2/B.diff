+test("la numeración es correlativa dentro del año y cada año empieza en 0001", async () => {
+  await conApi(async (api) => {
+    // Reservas para meses que todavía no han llegado (los tres socios fuera de la ocupación al azar).
+    assert.equal((await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-002", pistaId: "pista-1", inicio: "2026-12-10T19:30" } })).status, 201);
+    assert.equal((await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-004", pistaId: "pista-1", inicio: "2027-01-09T12:00" } })).status, 201);
+
+    const octubre = await generar(api, "2026-10");
+    assert.equal(octubre.status, 201);
+    const cuantasOctubre = octubre.cuerpo.facturas.length;
+    assert.equal(octubre.cuerpo.facturas[0].numero, "F2026-0001");
+    assert.equal(octubre.cuerpo.facturas.at(-1).numero, `F2026-${String(cuantasOctubre).padStart(4, "0")}`);
+
+    // Noviembre se genera después y sigue la numeración donde la dejó octubre.
+    assert.equal((await moverReloj(api, "2026-12-05T10:00")).status, 200);
+    const noviembre = await generar(api, "2026-11");
+    assert.equal(noviembre.status, 201);
+    assert.equal(noviembre.cuerpo.facturas[0].numero, `F2026-${String(cuantasOctubre + 1).padStart(4, "0")}`);
+
+    // Diciembre se genera más tarde, ya en 2027, y sigue la numeración de 2026.
+    assert.equal((await moverReloj(api, "2027-01-08T10:00")).status, 200);
+    const diciembre = await generar(api, "2026-12");
+    assert.equal(diciembre.status, 201);
+    assert.deepEqual(diciembre.cuerpo.facturas.map((f: any) => f.socioId), ["socio-002"]);
+    assert.equal(
+      diciembre.cuerpo.facturas[0].numero,
+      `F2026-${String(cuantasOctubre + noviembre.cuerpo.facturas.length + 1).padStart(4, "0")}`,
+    );
+
+    // Enero de 2027 empieza en 0001.
+    assert.equal((await moverReloj(api, "2027-02-05T10:00")).status, 200);
+    const enero = await generar(api, "2027-01");
+    assert.equal(enero.status, 201);
+    assert.deepEqual(enero.cuerpo.facturas.map((f: any) => ({ numero: f.numero, socioId: f.socioId })), [
+      { numero: "F2027-0001", socioId: "socio-004" },
+    ]);
+
+    // Sin huecos ni repetidos en todo el año 2026.
+    const del2026 = [...octubre.cuerpo.facturas, ...noviembre.cuerpo.facturas, ...diciembre.cuerpo.facturas];
+    assert.ok(del2026.every((f: any) => f.numero.startsWith("F2026-")));
+    const numeros = del2026.map((f: any) => Number(f.numero.slice("F2026-".length))).sort((a, b) => a - b);
+    assert.deepEqual(numeros, Array.from({ length: numeros.length }, (_, i) => i + 1));
+  });
+});
