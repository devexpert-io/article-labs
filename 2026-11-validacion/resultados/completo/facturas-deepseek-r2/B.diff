@@ -0,0 +1,257 @@
+// Facturas mensuales: permisos, qué se factura, IVA y numeración.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-001";
+
+/** Cada prueba arranca su propia API: las facturas y el reloj cambian el estado. */
+async function conApi(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function generar(api: Api, mes: string) {
+  return api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+}
+
+function moverReloj(api: Api, ahora: string) {
+  return api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+}
+
+/** Base imponible de un total con IVA incluido, al céntimo más cercano (medio céntimo hacia arriba). */
+function baseDe(total: number): number {
+  return Math.round(total / 1.21);
+}
+
+function esFacturable(r: any): boolean {
+  return r.estado !== "cancelada" || r.penalizacion !== undefined;
+}
+
+test("solo un gestor genera y consulta facturas", async () => {
+  await conApi(async (api) => {
+    const sinIdentificar = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinPermiso = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: SOCIO });
+    assert.equal(sinPermiso.status, 403);
+    assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+    for (const ruta of ["/api/facturas?mes=2026-10", "/api/facturas/F2026-0001"]) {
+      assert.equal((await api.pedir("GET", ruta)).status, 401);
+      assert.equal((await api.pedir("GET", ruta, { socio: SOCIO })).status, 403);
+    }
+
+    assert.equal((await generar(api, "2026-10")).status, 201);
+    assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).status, 200);
+    assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001", { socio: GESTOR })).status, 200);
+  });
+});
+
+test("solo se factura un mes cerrado y con el formato AAAA-MM", async () => {
+  await conApi(async (api) => {
+    for (const mes of ["2026-1", "2026-13", "2026-00", "2026-10-01", "", "octubre", undefined]) {
+      const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+      assert.equal(r.status, 400, `el mes ${String(mes)} no es válido`);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+
+    // En el club es 2026-11-18: noviembre sigue abierto y diciembre no ha llegado.
+    const enCurso = await generar(api, "2026-11");
+    assert.equal(enCurso.status, 409);
+    assert.equal(enCurso.cuerpo.error.codigo, "MES_ABIERTO");
+    const futuro = await generar(api, "2026-12");
+    assert.equal(futuro.status, 409);
+    assert.equal(futuro.cuerpo.error.codigo, "MES_ABIERTO");
+
+    assert.equal((await generar(api, "2026-10")).status, 201);
+  });
+});
+
+test("una factura por socio, con una línea por reserva facturable ordenada por inicio", async () => {
+  await conApi(async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const { status, cuerpo } = await generar(api, "2026-10");
+    assert.equal(status, 201);
+
+    const delMes = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10") && esFacturable(r));
+    const socios = [...new Set(delMes.map((r: any) => r.socioId as string))].sort();
+    assert.deepEqual(cuerpo.facturas.map((f: any) => f.socioId), socios);
+
+    for (const factura of cuerpo.facturas) {
+      assert.equal(factura.mes, "2026-10");
+      const suyas = delMes
+        .filter((r: any) => r.socioId === factura.socioId)
+        .sort((a: any, b: any) => (a.inicio === b.inicio ? a.id.localeCompare(b.id) : a.inicio.localeCompare(b.inicio)));
+      assert.deepEqual(
+        factura.lineas,
+        suyas.map((r: any) => ({
+          reservaId: r.id,
+          concepto: r.estado === "cancelada" ? "Penalización" : "Reserva",
+          importe: r.estado === "cancelada" ? r.penalizacion : r.importe,
+        })),
+      );
+    }
+
+    // Las no presentadas se facturan como una reserva más.
+    const noPresentada = delMes.find((r: any) => r.estado === "no_presentada");
+    const linea = cuerpo.facturas.flatMap((f: any) => f.lineas).find((l: any) => l.reservaId === noPresentada.id);
+    assert.deepEqual(linea, { reservaId: noPresentada.id, concepto: "Reserva", importe: noPresentada.importe });
+
+    // Quien no tiene nada que facturar ese mes no recibe factura.
+    const sinNada = estado.socios.filter((s: any) => !socios.includes(s.id)).map((s: any) => s.id);
+    assert.ok(sinNada.includes("socio-041"), "Nora Benítez no tiene reservas");
+    for (const socioId of sinNada) {
+      assert.ok(!cuerpo.facturas.some((f: any) => f.socioId === socioId), `${socioId} no debe tener factura`);
+    }
+  });
+});
+
+test("las cancelaciones gratuitas no se facturan y las penalizaciones sí", async () => {
+  await conApi(async (api) => {
+    const gratis = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-002", pistaId: "pista-2", inicio: "2026-11-28T10:30" } });
+    assert.equal(gratis.status, 201);
+    const penalizada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-005", pistaId: "pista-1", inicio: "2026-11-30T19:30" } });
+    assert.equal(penalizada.status, 201);
+    const idGratis = gratis.cuerpo.reserva.id;
+    const idPenalizada = penalizada.cuerpo.reserva.id;
+
+    const canceladaGratis = await api.pedir("POST", `/api/reservas/${idGratis}/cancelar`);
+    assert.equal(canceladaGratis.cuerpo.reserva.estado, "cancelada");
+    assert.equal(canceladaGratis.cuerpo.reserva.penalizacion, undefined);
+
+    // El día de la reserva ya no hay plazo gratuito: se cancela con penalización.
+    assert.equal((await moverReloj(api, "2026-11-30T10:00")).status, 200);
+    const canceladaConPenalizacion = await api.pedir("POST", `/api/reservas/${idPenalizada}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(canceladaConPenalizacion.cuerpo.reserva.penalizacion, penalizada.cuerpo.reserva.importe);
+
+    // Diciembre: noviembre ya ha terminado.
+    assert.equal((await moverReloj(api, "2026-12-02T09:00")).status, 200);
+    const { status, cuerpo } = await generar(api, "2026-11");
+    assert.equal(status, 201);
+
+    const lineas = cuerpo.facturas.flatMap((f: any) => f.lineas);
+    assert.ok(!lineas.some((l: any) => l.reservaId === idGratis), "una cancelación gratuita no se factura");
+    assert.deepEqual(lineas.find((l: any) => l.reservaId === idPenalizada), {
+      reservaId: idPenalizada,
+      concepto: "Penalización",
+      importe: canceladaConPenalizacion.cuerpo.reserva.penalizacion,
+    });
+  });
+});
