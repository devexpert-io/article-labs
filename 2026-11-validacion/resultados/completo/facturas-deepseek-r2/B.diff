+test("el IVA se desglosa sobre el total de la factura, con el medio céntimo hacia arriba", async () => {
+  await conApi(async (api) => {
+    assert.equal(baseDe(6800), 5620, "6800 / 1,21 = 5619,83 → 5620");
+
+    const { cuerpo } = await generar(api, "2026-10");
+    const redondeos = new Set<"arriba" | "abajo">();
+    for (const factura of cuerpo.facturas) {
+      const total = factura.lineas.reduce((suma: number, l: any) => suma + l.importe, 0);
+      assert.equal(factura.total, total);
+      assert.equal(factura.base, baseDe(total));
+      assert.equal(factura.iva, total - factura.base);
+      const resto = (total * 100) % 121;
+      redondeos.add(resto * 2 >= 121 ? "arriba" : "abajo");
+    }
+    // Con el historial de octubre se dan los dos sentidos del redondeo.
+    assert.deepEqual([...redondeos].sort(), ["abajo", "arriba"]);
+  });
+});
