+test("generar dos veces el mismo mes devuelve las mismas facturas y no crea ninguna nueva", async () => {
+  await conApi(async (api) => {
+    const primera = await generar(api, "2026-10");
+    assert.equal(primera.status, 201);
+    const antes = (await api.pedir("GET", "/_estado")).cuerpo.facturas.length;
+    assert.ok(antes > 0);
+
+    const segunda = await generar(api, "2026-10");
+    assert.equal(segunda.status, 200);
+    assert.deepEqual(segunda.cuerpo, primera.cuerpo);
+    assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, antes);
+
+    // La repetición no gasta números: el mes siguiente continúa justo después.
+    assert.equal((await moverReloj(api, "2026-12-05T10:00")).status, 200);
+    const noviembre = await generar(api, "2026-11");
+    assert.equal(noviembre.cuerpo.facturas[0].numero, `F2026-${String(antes + 1).padStart(4, "0")}`);
+  });
+});
