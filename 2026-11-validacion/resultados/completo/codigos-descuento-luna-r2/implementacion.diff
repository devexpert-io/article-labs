diff --git a/test/codigos-descuento.test.ts b/test/codigos-descuento.test.ts
new file mode 100644
index 0000000..9d9dd60
--- /dev/null
+++ b/test/codigos-descuento.test.ts
@@ -0,0 +1,36 @@
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => { api = await arrancarApi(); });
+after(() => api.cerrar());
+
+test("BIENVENIDA descuenta la mitad en primera reserva y no se puede repetir", async () => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-19T12:00", codigo: " bienvenida " } });
+  assert.equal(r.status, 201);
+  assert.deepEqual([r.cuerpo.reserva.importeBase, r.cuerpo.reserva.descuento, r.cuerpo.reserva.importe, r.cuerpo.reserva.codigo], [1200, 600, 600, "BIENVENIDA"]);
+  assert.equal((await api.pedir("GET", `/api/reservas/${r.cuerpo.reserva.id}`)).cuerpo.reserva.descuento, 600);
+  const otra = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-19T13:30", codigo: "BIENVENIDA" } });
+  assert.equal(otra.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("MANANAS y CLUB10 calculan importes y la disponibilidad conserva el precio base", async () => {
+  const manana = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-20T09:00", codigo: "MANANAS" } });
+  assert.deepEqual([manana.cuerpo.reserva.importeBase, manana.cuerpo.reserva.descuento, manana.cuerpo.reserva.importe], [1800, 400, 1400]);
+  const club = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-030", pistaId: "pista-3", inicio: "2026-11-25T09:00", codigo: "club10" } });
+  assert.deepEqual([club.cuerpo.reserva.importeBase, club.cuerpo.reserva.descuento, club.cuerpo.reserva.importe], [1200, 120, 1080]);
+  const disponibilidad = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-20&pista=pista-1");
+  assert.equal(disponibilidad.cuerpo.pistas[0].franjas.find((f: any) => f.inicio.endsWith("09:00")).precio, 1800);
+});
+
+test("errores de código y descuento aplicado a la penalización", async () => {
+  const desconocido = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-26T12:00", codigo: "NOPE" } });
+  assert.equal(desconocido.cuerpo.error.codigo, "CODIGO_INVALIDO");
+  const tipo = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-26T12:00", codigo: 5 } });
+  assert.equal(tipo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T12:01" } });
+  const reservada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-26T12:00", codigo: "CLUB10" } });
+  const cancelada = await api.pedir("POST", `/api/reservas/${reservada.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, reservada.cuerpo.reserva.importe);
+});
