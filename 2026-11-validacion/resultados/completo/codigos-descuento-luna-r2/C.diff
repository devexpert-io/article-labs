index 0000000..59e9e19
--- /dev/null
+++ b/test/codigos-descuento.test.ts
@@ -0,0 +1,101 @@
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => { api = await arrancarApi(); });
+after(() => api.cerrar());
+
+test("BIENVENIDA descuenta la mitad en primera reserva y no se puede repetir", async () => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-19T12:00", codigo: " bienvenida " } });
+  assert.equal(r.status, 201);
+  assert.deepEqual([r.cuerpo.reserva.importeBase, r.cuerpo.reserva.descuento, r.cuerpo.reserva.importe, r.cuerpo.reserva.codigo], [1200, 600, 600, "BIENVENIDA"]);
+  assert.equal((await api.pedir("GET", `/api/reservas/${r.cuerpo.reserva.id}`)).cuerpo.reserva.descuento, 600);
+  const otra = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-19T13:30", codigo: "BIENVENIDA" } });
+  assert.equal(otra.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("MANANAS y CLUB10 calculan importes y la disponibilidad conserva el precio base", async () => {
+  const manana = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-20T09:00", codigo: "MANANAS" } });
+  assert.deepEqual([manana.cuerpo.reserva.importeBase, manana.cuerpo.reserva.descuento, manana.cuerpo.reserva.importe], [1800, 400, 1400]);
+  const club = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-030", pistaId: "pista-3", inicio: "2026-11-25T09:00", codigo: "club10" } });
+  assert.deepEqual([club.cuerpo.reserva.importeBase, club.cuerpo.reserva.descuento, club.cuerpo.reserva.importe], [1200, 120, 1080]);
+  const disponibilidad = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-20&pista=pista-1");
+  assert.equal(disponibilidad.cuerpo.pistas[0].franjas.find((f: any) => f.inicio.endsWith("09:00")).precio, 1800);
+});
+
+test("errores de código y descuento aplicado a la penalización", async () => {
+  const desconocido = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-26T12:00", codigo: "NOPE" } });
+  assert.equal(desconocido.status, 400);
+  assert.equal(desconocido.cuerpo.error.codigo, "CODIGO_INVALIDO");
+  const tipo = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-26T12:00", codigo: 5 } });
+  assert.equal(tipo.status, 400);
+  assert.equal(tipo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T12:01" } });
+  const reservada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-26T12:00", codigo: "CLUB10" } });
+  const cancelada = await api.pedir("POST", `/api/reservas/${reservada.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, reservada.cuerpo.reserva.importe);
+});
+
+test("codigo vacío y espacios son inválidos y no crean reservas", async () => {
+  for (const [i, codigo] of ["", "   "].entries()) {
+    const antes = (await api.pedir("GET", "/_estado")).cuerpo.reservas.length;
+    const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: `2026-11-27T${i ? "13:30" : "12:00"}`, codigo } });
+    assert.equal(respuesta.status, 400);
+    assert.equal(respuesta.cuerpo.error.codigo, "CODIGO_INVALIDO");
+    assert.equal((await api.pedir("GET", "/_estado")).cuerpo.reservas.length, antes);
+  }
+});
+
+test("sin código guarda importes iguales y GET de lista y detalle los conserva", async () => {
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-28T09:00" } });
+  assert.equal(creada.status, 201);
+  const r = creada.cuerpo.reserva;
+  assert.deepEqual([r.importeBase, r.descuento, r.importe], [2000, 0, 2000]);
+  assert.equal("codigo" in r, false);
+  const detalle = await api.pedir("GET", `/api/reservas/${r.id}`);
+  assert.deepEqual([detalle.status, detalle.cuerpo.reserva.importeBase, detalle.cuerpo.reserva.descuento, detalle.cuerpo.reserva.importe], [200, 2000, 0, 2000]);
+  const lista = await api.pedir("GET", `/api/reservas?socio=${r.socioId}`);
+  const persistida = lista.cuerpo.reservas.find((x: any) => x.id === r.id);
+  assert.deepEqual([lista.status, persistida.importeBase, persistida.descuento, persistida.importe], [200, 2000, 0, 2000]);
+});
+
+test("BIENVENIDA caduca después del 31 de diciembre según el reloj del club", async () => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-01T00:00" } });
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2027-01-02T09:00", codigo: "BIENVENIDA" } });
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T12:01" } });
+});
+
+test("MANANAS rechaza fin de semana y una franja que empieza a las 12", async () => {
+  const finSemana = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-038", pistaId: "pista-3", inicio: "2026-12-05T09:00", codigo: "MANANAS" } });
+  assert.equal(finSemana.status, 409);
+  assert.equal(finSemana.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  const mediodia = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-038", pistaId: "pista-3", inicio: "2026-12-06T12:00", codigo: "MANANAS" } });
+  assert.equal(mediodia.status, 409);
+  assert.equal(mediodia.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("las reglas del club tienen prioridad sobre la validación del código", async () => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-011", pistaId: "pista-1", inicio: "2026-11-27T09:00", codigo: "NO_EXISTE" } });
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "CUOTA_INACTIVA");
+  const invalido = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-27T09:00", codigo: "NO_EXISTE" } });
+  assert.equal(invalido.status, 400);
+  assert.equal(invalido.cuerpo.error.codigo, "CODIGO_INVALIDO");
+});
+
+test("un error de aplicabilidad no consume BIENVENIDA", async () => {
+  const limpia = await arrancarApi();
+  try {
+    const inadecuado = await limpia.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-28T09:00", codigo: "MANANAS" } });
+    assert.equal(inadecuado.status, 409);
+    assert.equal(inadecuado.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+    const correcta = await limpia.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-27T10:30", codigo: "BIENVENIDA" } });
+    assert.equal(correcta.status, 201);
+    assert.equal(correcta.cuerpo.reserva.codigo, "BIENVENIDA");
+  } finally {
+    limpia.cerrar();
+  }
+});
