@@ -0,0 +1,33 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { crearClub, ErrorDelClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import type { Reserva } from "../src/tipos.ts";
+
+function fallo(fn: () => unknown, http: number, codigo: string) {
+  assert.throws(fn, (error: unknown) => error instanceof ErrorDelClub && error.http === http && error.codigo === codigo);
+}
+function reserva(socioId: string, estado: Reserva["estado"], codigo?: string): Reserva {
+  return { id: `test-${socioId}-${estado}-${codigo ?? "sin"}`, socioId, pistaId: "pista-1", inicio: "2026-10-01T09:00", fin: "2026-10-01T10:30", estado, importe: 1800, codigo, notas: "" };
+}
+
+test("CLUB10 cuenta confirmadas pasadas y no presentadas, excluye canceladas y bloquea el cuarto uso", () => {
+  const estado = crearSemilla();
+  estado.reservas = [reserva("socio-041", "confirmada", "CLUB10"), reserva("socio-041", "no_presentada", "CLUB10"), reserva("socio-041", "cancelada", "CLUB10")];
+  const club = crearClub(estado);
+  const creada = club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-27T09:00", codigo: "CLUB10" }).reserva;
+  assert.equal(creada.descuento, 180);
+  estado.reservas.push(reserva("socio-041", "confirmada", "CLUB10"));
+  fallo(() => club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-27T10:30", codigo: "CLUB10" }), 409, "CODIGO_NO_APLICABLE");
+});
+
+test("BIENVENIDA rechaza historial en cualquier estado y puede usarse en la fecha límite del reloj", () => {
+  const estado = crearSemilla();
+  estado.reservas = [reserva("socio-041", "cancelada")];
+  const club = crearClub(estado);
+  fallo(() => club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-31T09:00", codigo: "BIENVENIDA" }), 409, "CODIGO_NO_APLICABLE");
+  estado.reservas = [];
+  estado.ahora = "2026-12-31T23:59";
+  const creada = club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-01T09:00", codigo: "BIENVENIDA" }).reserva;
+  assert.equal(creada.descuento, 900);
+});
