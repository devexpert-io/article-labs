+// Códigos de descuento al reservar (docs/specs/codigos-descuento.md).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const reservar = (api: Api, cuerpo: Record<string, unknown>) => api.pedir("POST", "/api/reservas", { cuerpo });
+
+// Franjas libres de la semilla (no hay reservas después del 24 de noviembre).
+// 25 = miércoles, 26 = jueves, 27 = viernes, 28 = sábado.
+// Pista 1: valle 1800, punta 2800. Pista 3: valle 1200, punta 2000.
+
+test("sin código, la reserva se crea como antes", () => conApi(async (api) => {
+  const r = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-25T10:30" });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.importeBase, 1800);
+  assert.equal(r.cuerpo.reserva.descuento, 0);
+  assert.equal(r.cuerpo.reserva.importe, 1800);
+  assert.equal("codigo" in r.cuerpo.reserva, false);
+}));
+
+test("BIENVENIDA descuenta el 50 % solo en la primera reserva del socio", () => conApi(async (api) => {
+  const primera = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-28T18:00", codigo: "BIENVENIDA" });
+  assert.equal(primera.status, 201);
+  assert.deepEqual(
+    [primera.cuerpo.reserva.importeBase, primera.cuerpo.reserva.descuento, primera.cuerpo.reserva.importe, primera.cuerpo.reserva.codigo],
+    [2800, 1400, 1400, "BIENVENIDA"],
+  );
+  // Ya tiene una reserva, aunque esté cancelada.
+  await api.pedir("POST", `/api/reservas/${primera.cuerpo.reserva.id}/cancelar`);
+  const segunda = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-28T19:30", codigo: "BIENVENIDA" });
+  assert.equal(segunda.status, 409);
+  assert.equal(segunda.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  // Un socio con historial tampoco puede usarlo.
+  const veterano = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-28T19:30", codigo: "BIENVENIDA" });
+  assert.equal(veterano.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+}));
+
+test("BIENVENIDA vale hasta el 31 de diciembre de 2026 según la hora del club", () => conApi(async (api) => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-01T00:00" } });
+  const tarde = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-04T10:30", codigo: "BIENVENIDA" });
+  assert.equal(tarde.status, 409);
+  assert.equal(tarde.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-31T23:59" } });
+  const aTiempo = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-04T10:30", codigo: "BIENVENIDA" });
+  assert.equal(aTiempo.status, 201);
+  assert.equal(aTiempo.cuerpo.reserva.importe, 900);
+}));
+
+test("MANANAS descuenta 4 € de lunes a viernes antes de las 12:00", () => conApi(async (api) => {
+  const ok = await reservar(api, { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-27T10:30", codigo: "MANANAS" });
+  assert.equal(ok.status, 201);
+  assert.deepEqual([ok.cuerpo.reserva.importeBase, ok.cuerpo.reserva.descuento, ok.cuerpo.reserva.importe], [1200, 400, 800]);
+  for (const inicio of ["2026-11-27T12:00", "2026-11-28T09:00", "2026-11-29T10:30"]) {
+    const no = await reservar(api, { socioId: "socio-003", pistaId: "pista-3", inicio, codigo: "MANANAS" });
+    assert.equal(no.status, 409, inicio);
+    assert.equal(no.cuerpo.error.codigo, "CODIGO_NO_APLICABLE", inicio);
+  }
+}));
+
+test("CLUB10 descuenta el 10 % hasta 3 reservas por socio; las canceladas no cuentan", () => conApi(async (api) => {
+  const socioId = "socio-041";
+  const ids: string[] = [];
+  for (const inicio of ["2026-11-25T10:30", "2026-11-26T10:30", "2026-11-27T10:30"]) {
+    const r = await reservar(api, { socioId, pistaId: "pista-1", inicio, codigo: "CLUB10" });
+    assert.equal(r.status, 201);
+    assert.deepEqual([r.cuerpo.reserva.importeBase, r.cuerpo.reserva.descuento, r.cuerpo.reserva.importe], [1800, 180, 1620]);
+    ids.push(r.cuerpo.reserva.id);
+  }
+  // La regla del club va primero: ya tiene 3 reservas futuras.
+  const cuarta = await reservar(api, { socioId, pistaId: "pista-1", inicio: "2026-11-30T10:30", codigo: "CLUB10" });
+  assert.equal(cuarta.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+  // Cancelada, deja de contar.
+  await api.pedir("POST", `/api/reservas/${ids[0]}/cancelar`);
+  const otra = await reservar(api, { socioId, pistaId: "pista-1", inicio: "2026-11-30T10:30", codigo: "CLUB10" });
+  assert.equal(otra.status, 201);
+  // Pasado el tiempo, las 3 confirmadas siguen contando aunque ya no sean futuras.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T10:00" } });
+  const agotado = await reservar(api, { socioId, pistaId: "pista-1", inicio: "2026-12-02T10:30", codigo: "CLUB10" });
+  assert.equal(agotado.status, 409);
+  assert.equal(agotado.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  const sinCodigo = await reservar(api, { socioId, pistaId: "pista-1", inicio: "2026-12-02T10:30" });
+  assert.equal(sinCodigo.status, 201);
+}));
+
+test("el código no distingue mayúsculas ni espacios y se valida", () => conApi(async (api) => {
+  const r = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-28T18:00", codigo: "  club10 " });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.codigo, "CLUB10");
+  assert.equal(r.cuerpo.reserva.importe, 2520);
+  const desconocido = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-28T19:30", codigo: "GRATIS" });
+  assert.equal(desconocido.status, 400);
+  assert.equal(desconocido.cuerpo.error.codigo, "CODIGO_INVALIDO");
+  for (const codigo of [10, null, ["CLUB10"], { codigo: "CLUB10" }]) {
+    const malo = await reservar(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-28T19:30", codigo });
+    assert.equal(malo.status, 400, JSON.stringify(codigo));
+    assert.equal(malo.cuerpo.error.codigo, "DATOS_INVALIDOS", JSON.stringify(codigo));
+  }
+}));
+
+test("solo un código por reserva: los descuentos no se acumulan", () => conApi(async (api) => {
+  const juntos = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T10:30", codigo: "BIENVENIDA MANANAS" });
+  assert.equal(juntos.cuerpo.error.codigo, "CODIGO_INVALIDO");
+  const lista = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T10:30", codigo: ["BIENVENIDA", "MANANAS"] });
+  assert.equal(lista.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const uno = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T10:30", codigo: "MANANAS" });
+  assert.equal(uno.cuerpo.reserva.descuento, 400);
+}));
+
+test("las reservas guardan los importes y el código y la API los devuelve", () => conApi(async (api) => {
+  const creada = await reservar(api, { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-26T09:00", codigo: "mananas" });
+  const id = creada.cuerpo.reserva.id;
+  const una = await api.pedir("GET", `/api/reservas/${id}`);
+  assert.deepEqual(
+    [una.cuerpo.reserva.importeBase, una.cuerpo.reserva.descuento, una.cuerpo.reserva.importe, una.cuerpo.reserva.codigo],
+    [1200, 400, 800, "MANANAS"],
+  );
+  const lista = await api.pedir("GET", "/api/reservas?socio=socio-041");
+  assert.deepEqual(lista.cuerpo.reservas, [una.cuerpo.reserva]);
+}));
+
+test("las reglas del club van primero y el código no cuenta como usado", () => conApi(async (api) => {
+  const ocupada = (await api.pedir("GET", "/api/reservas?fecha=2026-11-19&pista=pista-1")).cuerpo.reservas.find((r: any) => r.estado === "confirmada");
+  const casos: [Record<string, unknown>, string][] = [
+    [{ socioId: "socio-041", pistaId: "pista-4", inicio: "2026-11-25T10:30" }, "PISTA_CERRADA"],
+    [{ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T10:00" }, "FRANJA_INVALIDA"],
+    [{ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-18T09:00" }, "FRANJA_PASADA"],
+    [{ socioId: "socio-041", pistaId: "pista-9", inicio: "2026-11-25T10:30" }, "PISTA_NO_ENCONTRADA"],
+    [{ socioId: "socio-011", pistaId: "pista-1", inicio: "2026-11-25T10:30" }, "CUOTA_INACTIVA"],
+    [{ socioId: "socio-041", pistaId: "pista-1", inicio: ocupada.inicio }, "FRANJA_NO_DISPONIBLE"],
+  ];
+  for (const [datos, error] of casos) {
+    for (const codigo of ["BIENVENIDA", "GRATIS", "MANANAS"]) {
+      const r = await reservar(api, { ...datos, codigo });
