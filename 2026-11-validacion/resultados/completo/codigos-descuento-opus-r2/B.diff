+    }
+  }
+  // Nora sigue sin reservas, así que BIENVENIDA aún vale.
+  const bienvenida = await reservar(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T10:30", codigo: "BIENVENIDA" });
+  assert.equal(bienvenida.status, 201);
