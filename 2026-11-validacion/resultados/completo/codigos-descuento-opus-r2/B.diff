+export const MAXIMO_USOS_CLUB10 = 3;
+export const FIN_BIENVENIDA = "2026-12-31";
+
+/** El catálogo fijo de códigos de descuento. */
+interface CodigoDescuento {
+  /** Lanza CODIGO_NO_APLICABLE si el código no vale para esta reserva. */
+  comprobar(socio: Socio, inicio: string): void;
+  /** Céntimos que se descuentan sobre el precio de la franja. */
+  descuento(base: number): number;
+}
+
+function crearCatalogo(estado: Estado): Record<string, CodigoDescuento> {
+  const noAplicable = (mensaje: string): never => {
+    throw new ErrorDelClub("CODIGO_NO_APLICABLE", mensaje);
+  };
+  return {
+    BIENVENIDA: {
+      comprobar(socio) {
+        if (estado.ahora.slice(0, 10) > FIN_BIENVENIDA) noAplicable("BIENVENIDA solo se puede usar hasta el 31 de diciembre de 2026");
+        if (estado.reservas.some((r) => r.socioId === socio.id)) noAplicable("BIENVENIDA solo vale en la primera reserva del socio");
+      },
+      descuento: (base) => Math.round(base * 0.5),
+    },
+    MANANAS: {
+      comprobar(_socio, inicio) {
+        const dia = diaDeLaSemana(inicio.slice(0, 10));
+        if (dia === 0 || dia === 6 || inicio.slice(11) >= "12:00") {
+          noAplicable("MANANAS solo vale en franjas de lunes a viernes que empiezan antes de las 12:00");
+        }
+      },
+      descuento: () => 400,
+    },
+    CLUB10: {
+      comprobar(socio) {
+        const usos = estado.reservas.filter((r) => r.socioId === socio.id && r.codigo === "CLUB10" && r.estado !== "cancelada").length;
+        if (usos >= MAXIMO_USOS_CLUB10) noAplicable(`CLUB10 se puede usar como mucho en ${MAXIMO_USOS_CLUB10} reservas por socio`);
+      },
+      descuento: (base) => Math.round(base * 0.1),
+    },
+  };
+}
+
 function invalido(mensaje: string): never {
   throw new ErrorDelClub("DATOS_INVALIDOS", mensaje, 400);
 }
