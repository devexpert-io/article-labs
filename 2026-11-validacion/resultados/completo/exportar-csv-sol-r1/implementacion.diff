diff --git a/test/exportar-csv.test.ts b/test/exportar-csv.test.ts
new file mode 100644
index 0000000..b4c3d2c
--- /dev/null
+++ b/test/exportar-csv.test.ts
@@ -0,0 +1,125 @@
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado } from "../src/tipos.ts";
+
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas\r\n";
+const GESTOR = { socio: "socio-040" };
+const RUTA = "/api/reservas/exportar";
+let api: Api;
+before(async () => { api = await arrancarApi(); });
+after(() => api.cerrar());
+
+test("exportar exige identidad de gestor, también antes de validar el periodo", async () => {
+  for (const [socio, status, codigo] of [
+    [undefined, 401, "NO_IDENTIFICADO"],
+    ["socio-999", 401, "NO_IDENTIFICADO"],
+    ["socio-001", 403, "SIN_PERMISO"],
+  ] as const) {
+    const r = await api.pedir("GET", RUTA, { socio });
+    assert.equal(r.status, status);
+    assert.equal(r.cuerpo.error.codigo, codigo);
+    assert.match(r.cabeceras.get("content-type")!, /application\/json/);
+  }
+});
+
+test("exporta todo el periodo inclusivo, con cabeceras, columnas, orden y CRLF", async () => {
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const r = await api.pedir("GET", `${RUTA}?desde=2026-10-01&hasta=2026-10-31`, GESTOR);
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-10-31.csv"');
+  const reservas = estado.reservas.filter((r) => r.inicio >= "2026-10-01" && r.inicio < "2026-11-01")
+    .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.pistaId.localeCompare(b.pistaId));
+  assert.equal(reservas.length, 315, "supera el máximo de 100 del listado JSON");
+  const filas = r.texto.split("\r\n");
+  assert.equal(filas.shift() + "\r\n", CABECERA);
+  assert.equal(filas.pop(), "", "la última fila termina en CRLF");
+  assert.equal(filas.length, reservas.length);
+  for (const [i, reserva] of reservas.entries()) {
+    const socio = estado.socios.find((s) => s.id === reserva.socioId)!;
+    const pista = estado.pistas.find((p) => p.id === reserva.pistaId)!;
+    assert.equal(filas[i], [reserva.id, reserva.inicio.slice(0, 10), reserva.inicio.slice(11),
+      pista.nombre, socio.nombre, socio.email, reserva.estado, (reserva.importe / 100).toFixed(2), "", reserva.notas].join(","));
+  }
+  assert.ok(reservas.some((r) => r.inicio.startsWith("2026-10-01")));
+  assert.ok(reservas.some((r) => r.inicio.startsWith("2026-10-31")));
+  assert.deepEqual([...new Set(reservas.map((r) => r.estado))].sort(), ["cancelada", "confirmada", "no_presentada"]);
+  assert.doesNotMatch(r.texto.replaceAll("\r\n", ""), /[\r\n]/);
+});
+
+test("filtra cada estado y conserva la cabecera cuando no hay reservas", async () => {
+  for (const estado of ["confirmada", "cancelada", "no_presentada"]) {
+    const r = await api.pedir("GET", `${RUTA}?desde=2026-10-01&hasta=2026-10-31&estado=${estado}`, GESTOR);
+    assert.equal(r.status, 200);
+    const listado = await api.pedir("GET", `/api/reservas?desde=2026-10-01&hasta=2026-10-31&estado=${estado}&limite=1`);
+    const filas = r.texto.slice(CABECERA.length).trimEnd().split("\r\n");
+    assert.equal(filas.length, listado.cuerpo.total);
+    assert.ok(filas.every((fila) => fila.split(",")[6] === estado));
+  }
+  const vacia = await api.pedir("GET", `${RUTA}?desde=2027-01-01&hasta=2027-01-01`, GESTOR);
+  assert.equal(vacia.status, 200);
+  assert.equal(vacia.texto, CABECERA);
+});
+
+test("rechaza periodos ausentes, mal formados, imposibles o invertidos y estados inválidos", async () => {
+  for (const consulta of [
+    "", "desde=2026-10-01", "hasta=2026-10-31", "desde=&hasta=2026-10-31",
+    "desde=2026-1-01&hasta=2026-10-31", "desde=2026-10-01&hasta=31-10-2026",
+    "desde=2026-02-29&hasta=2026-03-01", "desde=2026-02-30&hasta=2026-03-01",
+    "desde=2026-13-01&hasta=2026-13-02", "desde=2026-10-02&hasta=2026-10-01",
+    "desde=2026-10-01&hasta=2026-10-31&estado=pendiente", "desde=2026-10-01&hasta=2026-10-31&estado=",
+  ]) {
+    const r = await api.pedir("GET", `${RUTA}?${consulta}`, GESTOR);
+    assert.equal(r.status, 400, consulta);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", consulta);
+  }
+});
+
+test("el máximo son 92 días inclusivos, también al cruzar años o febrero bisiesto", async () => {
+  for (const [desde, hasta, status] of [
+    ["2026-10-01", "2026-12-31", 200], ["2026-10-01", "2027-01-01", 400],
+    ["2026-12-01", "2027-03-02", 200], ["2026-12-01", "2027-03-03", 400],
+    ["2028-02-01", "2028-05-02", 200], ["2028-02-01", "2028-05-03", 400],
+  ] as const) {
+    const r = await api.pedir("GET", `${RUTA}?desde=${desde}&hasta=${hasta}`, GESTOR);
+    assert.equal(r.status, status, `${desde} a ${hasta}`);
+    if (status === 400) assert.equal(r.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+  }
+});
+
+test("escapa notas según RFC 4180 y exporta penalizaciones en euros", async () => {
+  const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T10:00" } });
+  assert.equal(reloj.status, 200);
+  const notas = ["Sin signos", "Traer palas, bolas", 'Dice "hola"', "Una línea\notra", "Una\rotra", "Una\r\notra"];
+  const escapadas = ["Sin signos", '"Traer palas, bolas"', '"Dice ""hola"""', '"Una línea\notra"', '"Una\rotra"', '"Una\r\notra"'];
+  const ids: string[] = [];
+  for (const [i, nota] of notas.entries()) {
+    const creada = await api.pedir("POST", "/api/reservas", { cuerpo: {
+      socioId: i < 3 ? "socio-041" : "socio-002", pistaId: "pista-2",
+      inicio: `2026-12-0${i + 1}T09:00`, notas: nota,
+    } });
+    assert.equal(creada.status, 201);
+    ids.push(creada.cuerpo.reserva.id);
+  }
+  const cancelada = await api.pedir("POST", `/api/reservas/${ids[0]}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  const r = await api.pedir("GET", `${RUTA}?desde=2026-12-01&hasta=2026-12-06`, GESTOR);
+  assert.equal(r.status, 200);
+  const esperadas = ids.map((id, i) => `${id},2026-12-0${i + 1},09:00,Pista 2,${i < 3 ? "Nora Benítez,nora.benitez" : "Marta López,marta.lopez"}@example.com,${i === 0 ? "cancelada" : "confirmada"},${i < 4 ? "18.00" : "28.00"},${i === 0 ? "18.00" : ""},${escapadas[i]}\r\n`);
+  assert.equal(r.texto, CABECERA + esperadas.join(""));
+});
+
+test("exportar no modifica las reservas ni el formato, filtros o paginación del listado", async () => {
+  const ruta = "/api/reservas?desde=2026-10-01&hasta=2026-10-31&estado=confirmada&pista=pista-1&limite=2&pagina=2";
+  const antes = await api.pedir("GET", ruta);
+  const estadoAntes: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  await api.pedir("GET", `${RUTA}?desde=2026-10-01&hasta=2026-10-31`, GESTOR);
+  const despues = await api.pedir("GET", ruta);
+  assert.equal(despues.status, 200);
+  assert.equal(despues.texto, antes.texto);
+  assert.deepEqual(Object.keys(despues.cuerpo), ["total", "pagina", "paginas", "reservas"]);
+  assert.equal(despues.cuerpo.pagina, 2);
+  assert.equal(despues.cuerpo.reservas.length, 2);
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, estadoAntes.reservas);
+});
