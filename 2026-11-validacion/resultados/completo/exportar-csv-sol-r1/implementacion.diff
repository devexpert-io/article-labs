+            r.penalizacion === undefined ? "" : (r.penalizacion / 100).toFixed(2), r.notas]
+            .map(escapar).join(",");
+        });
+      return ["id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas", ...filas].join("\r\n") + "\r\n";
+    },
