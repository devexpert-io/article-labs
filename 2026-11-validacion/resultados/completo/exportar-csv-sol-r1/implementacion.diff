+      const escapar = (campo: string) => /[,"\r\n]/.test(campo) ? `"${campo.replace(/"/g, '""')}"` : campo;
+      const filas = estado.reservas
+        .filter((r) => r.inicio.slice(0, 10) >= desde && r.inicio.slice(0, 10) <= hasta &&
+          (f.estado === undefined || r.estado === f.estado))
+        .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.pistaId.localeCompare(b.pistaId))
