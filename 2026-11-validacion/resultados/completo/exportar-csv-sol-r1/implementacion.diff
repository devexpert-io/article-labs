+    exportarReservas(f: { desde?: string; hasta?: string; estado?: string }) {
+      const { desde, hasta } = f;
+      if (!desde || !hasta) invalido("desde y hasta son obligatorios, con el formato AAAA-MM-DD");
+      for (const fecha of [desde, hasta]) {
+        if (!FECHA.test(fecha)) invalido("desde y hasta deben tener el formato AAAA-MM-DD");
+        const dia = new Date(`${fecha}T00:00:00Z`);
+        if (!Number.isFinite(dia.getTime()) || dia.toISOString().slice(0, 10) !== fecha) invalido("La fecha no es válida");
+      }
+      if (desde > hasta) invalido("desde no puede ser posterior a hasta");
+      const dias = (Date.parse(`${hasta}T00:00:00Z`) - Date.parse(`${desde}T00:00:00Z`)) / 86_400_000 + 1;
+      if (dias > 92) throw new ErrorDelClub("RANGO_DEMASIADO_GRANDE", "El periodo no puede superar 92 días", 400);
+      if (f.estado !== undefined && !["confirmada", "cancelada", "no_presentada"].includes(f.estado)) {
+        invalido('estado debe ser "confirmada", "cancelada" o "no_presentada"');
