+  assert.equal(codigo(ajena), "SIN_PERMISO");
+  assert.equal((await api.pedir("DELETE", `/api/esperas/${primera.id}`)).status, 401);
+  const noExiste = await api.pedir("DELETE", "/api/esperas/E-9999", { socio: "socio-041" });
+  assert.equal(noExiste.status, 404);
+  assert.equal(codigo(noExiste), "ESPERA_NO_ENCONTRADA");
+
+  const retirada = await api.pedir("DELETE", `/api/esperas/${primera.id}`, { socio: "socio-004" });
+  assert.equal(retirada.status, 200);
+  assert.equal(retirada.cuerpo.espera.estado, "retirada");
+  assert.equal(retirada.cuerpo.espera.posicion, undefined);
+  const deNora = await api.pedir("GET", "/api/esperas", { socio: "socio-041" });
+  assert.equal(deNora.cuerpo.esperas.find((e: any) => e.id === segunda.id).posicion, 1);
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-004" })).cuerpo.esperas.length, 0);
+
+  const porGestor = await api.pedir("DELETE", `/api/esperas/${segunda.id}`, { socio: "socio-040" });
+  assert.equal(porGestor.status, 200);
+  assert.equal(porGestor.cuerpo.espera.estado, "retirada");
+  const delTercero = await api.pedir("GET", "/api/esperas", { socio: "socio-001" });
+  assert.equal(delTercero.cuerpo.esperas[0].id, tercera.id);
+  assert.equal(delTercero.cuerpo.esperas[0].posicion, 1);
+}));
