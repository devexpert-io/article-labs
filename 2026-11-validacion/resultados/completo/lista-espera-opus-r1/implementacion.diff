@@ -0,0 +1,209 @@
+// La lista de espera de franjas, probada a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { crearClub, NOTA_ASIGNADA } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Franjas ocupadas de la semilla (a más de 24 horas del 18 a las 10:00).
+const P2_22_1930 = { pistaId: "pista-2", inicio: "2026-11-22T19:30" }; // R-0503, de socio-003
+const P1_22_1930 = { pistaId: "pista-1", inicio: "2026-11-22T19:30" }; // R-0497
+const P1_22_2100 = { pistaId: "pista-1", inicio: "2026-11-22T21:00" }; // R-0498
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const apuntar = (api: Api, socio: string | undefined, cuerpo: unknown) => api.pedir("POST", "/api/esperas", { socio, cuerpo });
+const codigo = (r: { cuerpo: any }) => r.cuerpo.error?.codigo;
+
+test("apuntarse: 201 con la espera activa y su posición; sin X-Socio, 401", () => conApi(async (api) => {
+  const sin = await apuntar(api, undefined, P2_22_1930);
+  assert.equal(sin.status, 401);
+  assert.equal(codigo(sin), "NO_IDENTIFICADO");
+  const r = await apuntar(api, "socio-041", P2_22_1930);
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.espera.socioId, "socio-041");
+  assert.equal(r.cuerpo.espera.pistaId, "pista-2");
+  assert.equal(r.cuerpo.espera.inicio, "2026-11-22T19:30");
+  assert.equal(r.cuerpo.espera.estado, "activa");
+  assert.equal(r.cuerpo.espera.posicion, 1);
