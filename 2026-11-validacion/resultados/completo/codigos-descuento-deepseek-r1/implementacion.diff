 export const MAXIMO_RESERVAS_FUTURAS = 3;
 export const HORAS_CANCELACION_GRATUITA = 24;
 
+/** BIENVENIDA vale para reservas hechas hasta esta fecha incluida, según la hora del club. */
+export const ULTIMO_DIA_BIENVENIDA = "2026-12-31";
+/** Descuento fijo de MANANAS, en céntimos de euro. */
+export const DESCUENTO_MANANAS = 400;
+/** Usos de CLUB10 por socio, contando confirmadas y no presentadas. */
+export const MAXIMO_USOS_CLUB10 = 3;
+
+interface Descuento {
+  importeBase: number;
+  descuento: number;
+  importe: number;
+  codigo?: string;
+}
+
+function porcentaje(base: number, tanto: number): number {
+  return Math.round((base * tanto) / 100);
+}
+
+/**
+ * Aplica un código ya normalizado a una reserva que las reglas del club permiten.
+ * Lanza CODIGO_INVALIDO si no está en el catálogo y CODIGO_NO_APLICABLE si sus condiciones no se cumplen.
+ */
+function aplicarCodigo(codigo: string | undefined, socioId: string, inicio: string, base: number, estado: Estado): Descuento {
+  if (codigo === undefined) return { importeBase: base, descuento: 0, importe: base };
+
+  let bruto: number;
+  if (codigo === "BIENVENIDA") {
+    const yaTieneReserva = estado.reservas.some((r) => r.socioId === socioId);
+    if (yaTieneReserva || estado.ahora.slice(0, 10) > ULTIMO_DIA_BIENVENIDA) {
+      throw new ErrorDelClub("CODIGO_NO_APLICABLE", "BIENVENIDA solo vale para la primera reserva del socio y hasta el 31 de diciembre de 2026");
+    }
+    bruto = porcentaje(base, 50);
+  } else if (codigo === "MANANAS") {
+    const dia = diaDeLaSemana(inicio.slice(0, 10));
+    const entreSemana = dia >= 1 && dia <= 5;
+    if (!entreSemana || inicio.slice(11) >= "12:00") {
+      throw new ErrorDelClub("CODIGO_NO_APLICABLE", "MANANAS solo vale de lunes a viernes en franjas que empiezan antes de las 12:00");
+    }
+    bruto = DESCUENTO_MANANAS;
+  } else if (codigo === "CLUB10") {
+    const usos = estado.reservas.filter(
+      (r) => r.socioId === socioId && r.codigo === "CLUB10" && (r.estado === "confirmada" || r.estado === "no_presentada"),
+    ).length;
+    if (usos >= MAXIMO_USOS_CLUB10) {
+      throw new ErrorDelClub("CODIGO_NO_APLICABLE", `CLUB10 ya se ha usado ${MAXIMO_USOS_CLUB10} veces por este socio`);
+    }
+    bruto = porcentaje(base, 10);
+  } else {
+    throw new ErrorDelClub("CODIGO_INVALIDO", `El código ${codigo} no existe`, 400);
+  }
+
+  const descuento = Math.min(base, bruto);
+  return { importeBase: base, descuento, importe: base - descuento, codigo };
+}
+
 function invalido(mensaje: string): never {
   throw new ErrorDelClub("DATOS_INVALIDOS", mensaje, 400);
 }
