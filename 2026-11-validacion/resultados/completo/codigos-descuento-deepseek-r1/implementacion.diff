@@ -0,0 +1,214 @@
+// Los códigos de descuento al reservar, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { crearClub, ErrorDelClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Arranca una API limpia para cada prueba y la cierra al terminar. */
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function reservar(api: Api, inicio: string, codigo?: unknown) {
+  return api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio, ...(codigo === undefined ? {} : { codigo }) },
+  });
+}
+
+test("sin código la reserva se crea como antes", () =>
+  conApi({}, async (api) => {
+    const creada = await reservar(api, "2026-11-25T12:00");
+    assert.equal(creada.status, 201);
+    const r = creada.cuerpo.reserva;
+    assert.equal(r.importeBase, 1800);
+    assert.equal(r.descuento, 0);
+    assert.equal(r.importe, 1800);
+    assert.equal("codigo" in r, false);
+    assert.equal(r.importeBase, r.importe);
+
+    const una = await api.pedir("GET", `/api/reservas/${r.id}`);
+    assert.deepEqual(una.cuerpo.reserva, r);
+    const lista = await api.pedir("GET", "/api/reservas?socio=socio-041");
+    assert.equal(lista.cuerpo.total, 1);
+    assert.equal(lista.cuerpo.reservas[0].importeBase, 1800);
+    assert.equal(lista.cuerpo.reservas[0].descuento, 0);
+  }));
+
+test("BIENVENIDA descuenta el 50 % en la primera reserva del socio", () =>
+  conApi({}, async (api) => {
+    const primera = await reservar(api, "2026-11-25T12:00", "bienvenida");
+    assert.equal(primera.status, 201);
+    assert.equal(primera.cuerpo.reserva.importeBase, 1800);
+    assert.equal(primera.cuerpo.reserva.descuento, 900);
+    assert.equal(primera.cuerpo.reserva.importe, 900);
+    assert.equal(primera.cuerpo.reserva.codigo, "BIENVENIDA");
+
+    const segunda = await reservar(api, "2026-11-26T12:00", "BIENVENIDA");
+    assert.equal(segunda.status, 409);
+    assert.equal(segunda.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }));
+
+test("BIENVENIDA no vale si el socio ya tiene cualquier reserva", () =>
+  conApi({}, async (api) => {
+    // socio-002 tiene historial y una reserva futura.
+    const r = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-002", pistaId: "pista-1", inicio: "2026-11-25T12:00", codigo: "BIENVENIDA" },
+    });
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }));
+
+test("BIENVENIDA vale hasta el 31 de diciembre de 2026 incluido", () =>
+  conApi({ AHORA: "2026-12-31T10:00" }, async (api) => {
+    const ultimoDia = await reservar(api, "2027-01-04T12:00", "BIENVENIDA");
+    assert.equal(ultimoDia.status, 201);
+    assert.equal(ultimoDia.cuerpo.reserva.descuento, 900);
+  }));
+
+test("BIENVENIDA caduca a partir del 1 de enero de 2027", () =>
+  conApi({ AHORA: "2027-01-05T10:00" }, async (api) => {
+    const r = await reservar(api, "2027-01-06T12:00", "BIENVENIDA");
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }));
+
+test("MANANAS descuenta 4 € de lunes a viernes antes de las 12:00", () =>
+  conApi({}, async (api) => {
+    const manana = await reservar(api, "2026-11-26T09:00", "MANANAS");
+    assert.equal(manana.status, 201);
+    assert.equal(manana.cuerpo.reserva.importeBase, 1800);
+    assert.equal(manana.cuerpo.reserva.descuento, 400);
+    assert.equal(manana.cuerpo.reserva.importe, 1400);
+    assert.equal(manana.cuerpo.reserva.codigo, "MANANAS");
+
+    const tarde = await reservar(api, "2026-11-26T12:00", "MANANAS");
+    assert.equal(tarde.status, 409);
+    assert.equal(tarde.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+
+    const sabado = await reservar(api, "2026-11-28T09:00", "MANANAS");
+    assert.equal(sabado.status, 409);
+    assert.equal(sabado.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }));
+
+test("CLUB10 descuenta el 10 % en cualquier franja", () =>
+  conApi({}, async (api) => {
+    const r = await reservar(api, "2026-11-26T15:00", "CLUB10");
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.importeBase, 1800);
+    assert.equal(r.cuerpo.reserva.descuento, 180);
+    assert.equal(r.cuerpo.reserva.importe, 1620);
+    assert.equal(r.cuerpo.reserva.codigo, "CLUB10");
+
+    // También en fin de semana (precio de punta).
+    const sabado = await reservar(api, "2026-11-28T18:00", "CLUB10");
+    assert.equal(sabado.status, 201);
+    assert.equal(sabado.cuerpo.reserva.importeBase, 2800);
+    assert.equal(sabado.cuerpo.reserva.descuento, 280);
+    assert.equal(sabado.cuerpo.reserva.importe, 2520);
+  }));
+
+test("CLUB10 admite como mucho 3 usos por socio entre confirmadas y no presentadas", () =>
+  conApi({}, async (api) => {
+    for (const inicio of ["2026-11-26T09:00", "2026-11-26T10:30", "2026-11-26T12:00"]) {
+      assert.equal((await reservar(api, inicio, "CLUB10")).status, 201);
+    }
+    // El reloj avanza para que esas tres reservas dejen de ser futuras.
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-27T10:00" } })).status, 200);
+    const cuarta = await reservar(api, "2026-11-30T09:00", "CLUB10");
+    assert.equal(cuarta.status, 409);
+    assert.equal(cuarta.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  }));
+
+test("CLUB10 no cuenta las reservas canceladas", () =>
+  conApi({}, async (api) => {
+    for (const inicio of ["2026-11-26T09:00", "2026-11-26T10:30", "2026-11-26T12:00"]) {
+      const r = await reservar(api, inicio, "CLUB10");
+      assert.equal(r.status, 201);
+      const cancelada = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+      assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    }
+    const otra = await reservar(api, "2026-11-30T09:00", "CLUB10");
+    assert.equal(otra.status, 201);
+  }));
+
+test("CLUB10 cuenta también las reservas no presentadas", () => {
+  const estado = crearSemilla();
+  const club = crearClub(estado);
+  for (const hora of ["09:00", "10:30", "12:00"]) {
+    const { reserva } = club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: `2026-11-26T${hora}`, codigo: "CLUB10" });
+    reserva.estado = "no_presentada";
+  }
+  assert.throws(
+    () => club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-30T09:00", codigo: "CLUB10" }),
+    (error: unknown) => error instanceof ErrorDelClub && error.codigo === "CODIGO_NO_APLICABLE",
+  );
+});
+
+test("el código no distingue mayúsculas ni espacios de alrededor", () =>
+  conApi({}, async (api) => {
+    const r = await reservar(api, "2026-11-25T12:00", "  club10 ");
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.codigo, "CLUB10");
+  }));
+
+test("un código desconocido responde CODIGO_INVALIDO", () =>
+  conApi({}, async (api) => {
+    const r = await reservar(api, "2026-11-25T12:00", "VERANO");
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_INVALIDO");
+  }));
+
+test("un código que no es texto responde DATOS_INVALIDOS", () =>
+  conApi({}, async (api) => {
+    for (const codigo of [123, null, ["CLUB10", "MANANAS"]]) {
+      const r = await reservar(api, "2026-11-25T12:00", codigo);
+      assert.equal(r.status, 400);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+  }));
+
+test("las reglas del club van antes que el código y no gastan su uso", () =>
+  conApi({}, async (api) => {
+    // Cuota inactiva.
+    const cuota = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-011", pistaId: "pista-1", inicio: "2026-11-25T12:00", codigo: "CLUB10" },
+    });
+    assert.equal(cuota.status, 409);
+    assert.equal(cuota.cuerpo.error.codigo, "CUOTA_INACTIVA");
+
+    // Franja ya reservada (pista 1, jueves 19 a las 19:30).
+    const ocupada = await reservar(api, "2026-11-19T19:30", "CLUB10");
+    assert.equal(ocupada.status, 409);
+    assert.equal(ocupada.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+
+    // Ningún intento fallido ha creado reservas ni gastado el código.
+    assert.equal((await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.total, 0);
+    assert.equal((await reservar(api, "2026-11-25T12:00", "CLUB10")).status, 201);
+  }));
+
+test("la penalización es el 100 % de lo que paga el socio, con descuento", () =>
+  conApi({}, async (api) => {
+    // Jueves 19 a las 09:00: faltan 23 horas, fuera del plazo de cancelación gratuita.
+    const creada = await reservar(api, "2026-11-19T09:00", "MANANAS");
+    assert.equal(creada.status, 201);
+    assert.equal(creada.cuerpo.reserva.importe, 1400);
+
+    const forzada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 1400);
+  }));
+
+test("la disponibilidad sigue mostrando el precio sin descuento", () =>
+  conApi({}, async (api) => {
+    assert.equal((await reservar(api, "2026-11-26T09:00", "MANANAS")).status, 201);
+    const disp = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-26&pista=pista-1");
+    const franja = disp.cuerpo.pistas[0].franjas.find((f: { inicio: string }) => f.inicio === "2026-11-26T09:00");
+    assert.equal(franja.estado, "reservada");
+    assert.equal(franja.precio, 1800);
+  }));
