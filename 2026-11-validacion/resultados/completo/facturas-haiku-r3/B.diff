@@ -0,0 +1,224 @@
+// Las facturas mensuales, probadas a través de la API (docs/specs/facturas.md).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-001";
+
+/** Cálculo independiente de las facturas de un mes a partir del estado completo del club. */
+function esperadas(estado: any, mes: string, primerNumero = 1): any[] {
+  const reservas = estado.reservas
+    .filter((r: any) => r.inicio.slice(0, 7) === mes)
+    .sort((a: any, b: any) => (a.inicio !== b.inicio ? (a.inicio < b.inicio ? -1 : 1) : a.id < b.id ? -1 : 1));
+  const porSocio = new Map<string, any[]>();
+  for (const r of reservas) {
+    let linea: any;
+    if (r.estado !== "cancelada") linea = { reservaId: r.id, concepto: "Reserva", importe: r.importe };
+    else if (r.penalizacion > 0) linea = { reservaId: r.id, concepto: "Penalización", importe: r.penalizacion };
+    if (linea) porSocio.set(r.socioId, [...(porSocio.get(r.socioId) ?? []), linea]);
+  }
+  return [...porSocio.keys()].sort().map((socioId, i) => {
+    const lineas = porSocio.get(socioId)!;
+    const total = lineas.reduce((suma, l) => suma + l.importe, 0);
+    const base = Math.round(total / 1.21);
+    return {
+      numero: `F${mes.slice(0, 4)}-${String(primerNumero + i).padStart(4, "0")}`,
+      mes,
+      socioId,
+      lineas,
+      total,
+      base,
+      iva: total - base,
+    };
+  });
+}
+
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("solo un gestor genera y consulta facturas", () =>
+  conApi({}, async (api) => {
+    const sinCabecera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+    assert.equal(sinCabecera.status, 401);
+    assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10")).status, 401);
+    assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001")).status, 401);
+    assert.equal((await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-999" })).status, 401);
+
+    // El permiso se comprueba antes que los datos y que el mes.
+    const socio = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: SOCIO });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+    assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: SOCIO })).cuerpo.error.codigo, "SIN_PERMISO");
+    assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001", { socio: SOCIO })).status, 403);
+
+    const consulta = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.equal(consulta.status, 200);
+    assert.deepEqual(consulta.cuerpo, { facturas: [] });
+  }));
+
+test("solo se factura un mes ya terminado, y el mes tiene que tener formato AAAA-MM", () =>
+  conApi({}, async (api) => {
+    for (const mes of [undefined, "2026-1", "octubre", "2026/10", "2026-13", "2026-00"]) {
+      const r = await api.pedir("POST", "/api/facturas", { cuerpo: mes === undefined ? {} : { mes }, socio: GESTOR });
+      assert.equal(r.status, 400, `mes ${mes}`);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-1", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+    assert.equal((await api.pedir("GET", "/api/facturas", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // El club es el 18 de noviembre: ni noviembre ni diciembre han terminado.
+    for (const mes of ["2026-11", "2026-12"]) {
+      const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+      assert.equal(abierto.status, 409);
+      assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+    }
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T23:59" } })).status, 200);
+    assert.equal((await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).cuerpo.error.codigo, "MES_ABIERTO");
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T00:00" } })).status, 200);
+    assert.equal((await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).status, 201);
+  }));
+
+test("octubre: una factura por socio, con sus líneas, sus totales y su IVA; repetir no crea nada", () =>
+  conApi({}, async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const sinGenerar = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.deepEqual(sinGenerar.cuerpo, { facturas: [] });
+
+    const primera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(primera.status, 201);
+    const facturas = primera.cuerpo.facturas;
+    const oraculo = esperadas(estado, "2026-10");
+    assert.ok(facturas.length > 10, "octubre tiene historial de sobra");
+    assert.deepEqual(facturas, oraculo);
+    assert.equal(facturas[0].numero, "F2026-0001");
+    // Valores fijos, comprobados a mano: no dependen solo del cálculo duplicado de esperadas().
+    const primeraFija = facturas.find((f: any) => f.numero === "F2026-0001");
+    assert.equal(primeraFija.socioId, "socio-001");
+    assert.equal(primeraFija.total, 6800);
+    assert.equal(primeraFija.base, 5620);
+    assert.equal(primeraFija.iva, 1180);
+    const cuarentaFija = facturas.find((f: any) => f.numero === "F2026-0040");
+    assert.ok(cuarentaFija, "la factura F2026-0040 existe");
+    assert.equal(cuarentaFija.socioId, "socio-040");
+    assert.equal(cuarentaFija.lineas.length, 11);
+    assert.deepEqual(facturas.map((f: any) => f.socioId), [...facturas.map((f: any) => f.socioId)].sort());
+    for (const f of facturas) {
+      assert.equal(f.total, f.lineas.reduce((suma: number, l: any) => suma + l.importe, 0));
+      assert.equal(f.iva, f.total - f.base);
+      assert.equal(f.base, Math.round(f.total / 1.21));
+    }
+
+    const lista = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.equal(lista.status, 200);
+    assert.deepEqual(lista.cuerpo, { facturas });
+
+    const una = await api.pedir("GET", `/api/facturas/${facturas[2].numero}`, { socio: GESTOR });
+    assert.deepEqual(una.cuerpo, { factura: facturas[2] });
+    const inexistente = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+    assert.equal(inexistente.status, 404);
+    assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+
+    const repetida = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(repetida.status, 200);
+    assert.deepEqual(repetida.cuerpo, { facturas });
+    assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas, facturas);
+  }));
+
+test("un mes generado no cambia aunque el reloj del club retroceda antes de ese mes", () =>
+  conApi({}, async (api) => {
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T00:00" } })).status, 200);
+    const primera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(primera.status, 201);
+
+    // El club vuelve a 15 de octubre: octubre ya no está terminado, pero ya estaba generado.
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-10-15T10:00" } })).status, 200);
+    const repetida = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(repetida.status, 200);
+    assert.deepEqual(repetida.cuerpo, primera.cuerpo);
+
+    // Un mes que no se ha generado sigue sin poder generarse con el reloj en octubre.
+    const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    assert.equal(abierto.status, 409);
+    assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+  }));
+
+test("penalizaciones: se facturan; las canceladas sin penalización no; el IVA se calcula sobre el total", () =>
+  conApi({}, async (api) => {
+    // Nora Benítez no tiene reservas. Reserva para el lunes 30 de noviembre.
+    const reservar = async (pistaId: string, inicio: string) => {
+      const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId, inicio } });
+      assert.equal(r.status, 201);
+      return r.cuerpo.reserva.id as string;
+    };
+    const r1 = await reservar("pista-1", "2026-11-30T12:00"); // 1.800 €
+    const r2 = await reservar("pista-3", "2026-11-30T13:30"); // 1.200 €
+    const r3 = await reservar("pista-3", "2026-11-30T15:00");
+    const cancelada = await api.pedir("POST", `/api/reservas/${r3}/cancelar`);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined, "cancelada con 12 días de antelación: sin penalización");
+    const r4 = await reservar("pista-2", "2026-11-30T16:30"); // 1.800 €
+
+    // Ya quedan menos de 24 horas para r4: se cancela con forzar y penaliza el 100 %.
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T09:00" } })).status, 200);
+    const penalizada = await api.pedir("POST", `/api/reservas/${r4}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(penalizada.cuerpo.reserva.penalizacion, 1800);
+
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T00:00" } })).status, 200);
+    const generada = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    assert.equal(generada.status, 201);
+
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    assert.deepEqual(generada.cuerpo.facturas, esperadas(estado, "2026-11"));
+
+    const nora = generada.cuerpo.facturas.find((f: any) => f.socioId === "socio-041");
+    assert.deepEqual(nora.lineas, [
+      { reservaId: r1, concepto: "Reserva", importe: 1800 },
+      { reservaId: r2, concepto: "Reserva", importe: 1200 },
+      { reservaId: r4, concepto: "Penalización", importe: 1800 },
+    ]);
+    assert.equal(nora.total, 4800);
+    // 4.800 céntimos / 1,21 = 3.966,94 → base de 3.967 céntimos; IVA, la diferencia.
+    assert.equal(nora.base, 3967);
+    assert.equal(nora.iva, 833);
+    assert.ok(!nora.lineas.some((l: any) => l.reservaId === r3), "la cancelada sin penalización no se factura");
+  }));
+
+test("la numeración sigue entre meses en el orden en que se generan, y cada año empieza en 0001", () =>
+  conApi({}, async (api) => {
+    // Nora tiene una reserva en diciembre y otra en enero, para cruzar el año.
+    for (const inicio of ["2026-12-05T10:30", "2027-01-10T10:30"]) {
+      const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio } });
+      assert.equal(r.status, 201);
+    }
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-01T00:00" } })).status, 200);
+
+    // Primero noviembre, luego octubre: octubre sigue donde dejó noviembre.
+    const noviembre = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    assert.equal(noviembre.status, 201);
+    const octubre = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(octubre.status, 201);
+    const diciembre = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+    assert.equal(diciembre.status, 201);
+    assert.deepEqual(diciembre.cuerpo.facturas.map((f: any) => f.socioId), ["socio-041"]);
+
+    const numerosDe2026 = [...noviembre.cuerpo.facturas, ...octubre.cuerpo.facturas, ...diciembre.cuerpo.facturas].map((f: any) => f.numero);
+    const esperadosDe2026 = numerosDe2026.map((_: string, i: number) => `F2026-${String(i + 1).padStart(4, "0")}`);
+    assert.deepEqual(numerosDe2026, esperadosDe2026, "sin huecos ni repetidos dentro del año");
+
+    const enero = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2027-01" }, socio: GESTOR });
+    assert.equal(enero.status, 201);
+    assert.deepEqual(enero.cuerpo.facturas.map((f: any) => f.numero), ["F2027-0001"]);
+
+    // Repetir noviembre devuelve las mismas facturas con los mismos números.
+    const repetida = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    assert.equal(repetida.status, 200);
+    assert.deepEqual(repetida.cuerpo, noviembre.cuerpo);
+  }));
