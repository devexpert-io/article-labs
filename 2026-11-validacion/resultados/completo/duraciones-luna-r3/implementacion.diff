+/** Precio de un intervalo: cada minuto cuesta 1/90 del precio de su franja. */
+export function precioPorDuracion(pista: Pista, inicio: string, duracion: number): number {
+  const [hora, minuto] = inicio.slice(11).split(":").map(Number);
+  let totalNumerador = 0;
+  for (let desplazamiento = 0; desplazamiento < duracion; desplazamiento++) {
+    const minutosDia = hora! * 60 + minuto! + desplazamiento;
+    const horaTexto = `${String(Math.floor(minutosDia / 60)).padStart(2, "0")}:${String(minutosDia % 60).padStart(2, "0")}`;
+    const importeFranja = precio(pista, `${inicio.slice(0, 10)}T${horaTexto}`);
+    totalNumerador += importeFranja;
+  }
+  return Math.floor((totalNumerador + 45) / 90);
+}
+
+export function finDeDuracion(inicio: string, duracion: number): string {
+  const [h, m] = inicio.slice(11).split(":").map(Number);
+  const total = h! * 60 + m! + duracion;
+  return `${inicio.slice(0, 10)}T${String(Math.floor(total / 60)).padStart(2, "0")}:${String(total % 60).padStart(2, "0")}`;
+}
+
