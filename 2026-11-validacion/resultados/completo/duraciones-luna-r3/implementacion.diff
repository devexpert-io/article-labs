+  assert.ok(estado.reservas.every((r: any) => r.duracion === 90));
+
+  const crear = (inicio: string, duracion: number, pistaId = "pista-1") => api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio, duracion },
+  });
+  const unaHora = await crear("2026-11-30T17:30", 60);
+  assert.equal(unaHora.status, 201);
+  assert.equal(unaHora.cuerpo.reserva.fin, "2026-11-30T18:30");
+  assert.equal(unaHora.cuerpo.reserva.importe, 1533);
+  const cruzaLasSeis = await crear("2026-11-30T17:30", 90, "pista-2");
+  assert.equal(cruzaLasSeis.cuerpo.reserva.importe, 2467);
+  assert.equal((await crear("2026-11-30T18:00", 120)).cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  assert.equal((await crear("2026-11-30T21:00", 120, "pista-2")).cuerpo.error.codigo, "FRANJA_INVALIDA");
+  assert.equal((await api.pedir("POST", "/api/reservas", { cuerpo: {
