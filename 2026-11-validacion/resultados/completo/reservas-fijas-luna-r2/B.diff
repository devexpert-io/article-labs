+
+// Interpreta AAAA-MM-DDTHH:MM como hora civil de Madrid y la convierte a UTC.
+// Las franjas del club nunca caen en la hora ambigua/inexistente del cambio.
+function instanteMadrid(fechaHora: string): number {
+  const local = Date.parse(`${fechaHora}:00Z`);
+  const partes = new Intl.DateTimeFormat("en-GB", {
+    timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit",
+    hour: "2-digit", minute: "2-digit", second: "2-digit", hourCycle: "h23",
+  }).formatToParts(new Date(local));
+  const valor = (tipo: string) => Number(partes.find((p) => p.type === tipo)!.value);
+  const representado = Date.UTC(valor("year"), valor("month") - 1, valor("day"), valor("hour"), valor("minute"), valor("second"));
+  return local - (representado - local);
+}
+
+function fechaCalendarioValida(fecha: string): boolean {
+  const [anyo, mes, dia] = fecha.split("-").map(Number);
+  const d = new Date(Date.UTC(anyo, mes - 1, dia));
+  return d.getUTCFullYear() === anyo && d.getUTCMonth() === mes - 1 && d.getUTCDate() === dia;
 }
 
