+// Convierte una fecha-hora local del club a un instante, sin depender del huso
+// horario del proceso. La aproximación inicial usa UTC y se corrige con el
+// desfase que Intl calcula para Europe/Madrid en ese instante.
+function instanteMadrid(fechaHora: string): number {
+  const pared = Date.parse(`${fechaHora}:00Z`);
+  const formato = new Intl.DateTimeFormat("en-GB", {
+    timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit",
+    hour: "2-digit", minute: "2-digit", second: "2-digit", hourCycle: "h23",
+  });
+  let instante = pared;
+  for (let i = 0; i < 3; i++) {
+    const partes = Object.fromEntries(formato.formatToParts(new Date(instante)).map((p) => [p.type, p.value]));
+    const representado = Date.UTC(Number(partes.year), Number(partes.month) - 1, Number(partes.day), Number(partes.hour), Number(partes.minute), Number(partes.second));
+    const desfase = representado - instante;
+    const corregido = pared - desfase;
+    if (corregido === instante) break;
+    instante = corregido;
+  }
+  return instante;
+}
+
+function horasRealesMadrid(desde: string, hasta: string): number {
+  return (instanteMadrid(hasta) - instanteMadrid(desde)) / 3_600_000;
+}
