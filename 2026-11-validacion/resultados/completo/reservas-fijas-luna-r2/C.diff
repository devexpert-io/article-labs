+    assert.equal((await otra.pedir("GET", "/api/series/S-9999", { socio })).cuerpo.error.codigo, "SERIE_NO_ENCONTRADA");
+
+    const reloj = (await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-22T17:59" } })).cuerpo.ahora;
+    assert.equal(reloj, "2026-11-22T17:59");
+    const cancel = await otra.pedir("POST", "/api/series", { socio, cuerpo: { ...datos, inicio: "2026-11-23T18:00", semanas: 3 } });
+    const resultado = await otra.pedir("POST", `/api/series/${cancel.cuerpo.serie.id}/cancelar`, { socio });
+    assert.equal(resultado.cuerpo.canceladas.length, cancel.cuerpo.serie.reservas.length); assert.equal(resultado.cuerpo.pendientes.length, 0);
+
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-09T19:00" } });
+    const cercana = await otra.pedir("POST", "/api/series", { socio, cuerpo: { ...datos, inicio: "2026-12-10T18:00", semanas: 2 } });
+    const pendientes = await otra.pedir("POST", `/api/series/${cercana.cuerpo.serie.id}/cancelar`, { socio });
+    assert.ok(pendientes.cuerpo.pendientes.length >= 1);
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-23T19:00" } });
+    const forzada = await otra.pedir("POST", "/api/series", { socio, cuerpo: { ...datos, inicio: "2026-12-24T18:00", semanas: 2 } });
+    const forzar = await otra.pedir("POST", `/api/series/${forzada.cuerpo.serie.id}/cancelar`, { socio, cuerpo: { forzar: true } });
+    assert.equal(forzar.cuerpo.canceladas.length, forzada.cuerpo.serie.reservas.length);
+    assert.ok(forzar.cuerpo.canceladas.some((r: any) => r.inicio === "2026-12-24T18:00" && r.penalizacion === r.importe));
+
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-09T10:00" } });
+    const individual = await otra.pedir("POST", "/api/series", { socio, cuerpo: { ...datos, inicio: "2027-01-05T19:30", semanas: 2 } });
+    const rid = individual.cuerpo.serie.reservas[0];
+    assert.equal((await otra.pedir("POST", `/api/reservas/${rid}/cancelar`)).status, 200);
+    const estadoSerie = await otra.pedir("GET", `/api/series/${individual.cuerpo.serie.id}`, { socio });
+    assert.equal(estadoSerie.cuerpo.serie.reservas[0].estado, "cancelada");
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-15T20:00" } });
+    const yaPasada = await otra.pedir("POST", `/api/series/${individual.cuerpo.serie.id}/cancelar`, { socio });
+    assert.equal(yaPasada.cuerpo.canceladas.length, 1);
+  } finally { otra.cerrar(); }
