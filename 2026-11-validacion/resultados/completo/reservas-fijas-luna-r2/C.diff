+test("cancelar series calcula horas reales al cambiar el horario de Madrid", async () => {
+  const socio = "socio-040";
+  const crear = (otra: Api, inicio: string) => otra.pedir("POST", "/api/series", {
+    socio, cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio, semanas: 2 },
+  });
+
+  // En primavera, las 10:30 del día siguiente están a 23 horas reales.
+  for (const forzar of [false, true]) {
+    const otra = await arrancarApi({ AHORA: "2027-03-27T10:30" });
+    try {
+      const serie = (await crear(otra, "2027-03-28T10:30")).cuerpo.serie;
+      const respuesta = await otra.pedir("POST", `/api/series/${serie.id}/cancelar`, {
+        socio, cuerpo: forzar ? { forzar: true } : {},
+      });
+      if (forzar) {
+        assert.equal(respuesta.cuerpo.canceladas[0].inicio, "2027-03-28T10:30");
+        assert.equal(respuesta.cuerpo.canceladas[0].penalizacion, respuesta.cuerpo.canceladas[0].importe);
+      } else {
+        assert.ok(respuesta.cuerpo.pendientes.some((r: any) => r.inicio === "2027-03-28T10:30"));
+      }
+    } finally { otra.cerrar(); }
+  }
+
+  // En otoño, las 10:30 del día siguiente están a 25 horas reales: gratis siempre.
+  for (const forzar of [false, true]) {
+    const otra = await arrancarApi({ AHORA: "2027-10-30T11:00" });
+    try {
+      const serie = (await crear(otra, "2027-10-31T10:30")).cuerpo.serie;
+      const respuesta = await otra.pedir("POST", `/api/series/${serie.id}/cancelar`, {
+        socio, cuerpo: forzar ? { forzar: true } : {},
+      });
+      const cancelada = respuesta.cuerpo.canceladas.find((r: any) => r.inicio === "2027-10-31T10:30");
+      assert.ok(cancelada);
+      assert.equal(cancelada.penalizacion, undefined);
+    } finally { otra.cerrar(); }
+  }
+
+  // El umbral es inclusivo: exactamente 24 horas sigue siendo gratuito.
+  const exacta = await arrancarApi({ AHORA: "2027-02-01T10:30" });
+  try {
+    const serie = (await crear(exacta, "2027-02-02T10:30")).cuerpo.serie;
+    const respuesta = await exacta.pedir("POST", `/api/series/${serie.id}/cancelar`, { socio });
+    const cancelada = respuesta.cuerpo.canceladas.find((r: any) => r.inicio === "2027-02-02T10:30");
+    assert.ok(cancelada);
+    assert.equal(cancelada.penalizacion, undefined);
+  } finally { exacta.cerrar(); }
+});
