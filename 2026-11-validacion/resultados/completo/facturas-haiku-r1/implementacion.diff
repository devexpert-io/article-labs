diff --git a/test/facturas.test.ts b/test/facturas.test.ts
new file mode 100644
index 0000000..fadbdf2
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,195 @@
+// Facturas mensuales: permisos, mes cerrado, líneas, IVA, numeración y repetición.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { baseDeTotal } from "../src/nucleo.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-001";
+
+let api: Api;
+let tiempo: Api;
+before(async () => {
+  api = await arrancarApi();
+  tiempo = await arrancarApi({ AHORA: "2026-11-18T10:00" });
+});
+after(() => {
+  api.cerrar();
+  tiempo.cerrar();
+});
+
+/** Las líneas que deben salir para un mes, calculadas a partir del estado con las reglas de la spec. */
+function esperadasPorSocio(estado: any, mes: string) {
+  const porSocio = new Map<string, unknown[]>();
+  const reservas = estado.reservas
+    .filter((r: any) => r.inicio.slice(0, 7) === mes)
+    .sort((a: any, b: any) => (a.inicio === b.inicio ? a.id.localeCompare(b.id) : a.inicio.localeCompare(b.inicio)));
+  for (const r of reservas) {
+    let linea: unknown;
+    if (r.estado === "confirmada" || r.estado === "no_presentada") {
+      linea = { reservaId: r.id, concepto: "Reserva", importe: r.importe };
+    } else if (r.penalizacion !== undefined) {
+      linea = { reservaId: r.id, concepto: "Penalización", importe: r.penalizacion };
+    }
+    if (linea) porSocio.set(r.socioId, [...(porSocio.get(r.socioId) ?? []), linea]);
+  }
+  return [...porSocio.keys()].sort().map((socioId) => ({ socioId, lineas: porSocio.get(socioId) }));
+}
+
+/** Comprueba que las facturas de un mes son las que dicen las reglas: socios, líneas, total, base e IVA. */
+function comprobarFacturas(facturas: any[], estado: any, mes: string) {
+  const esperadas = esperadasPorSocio(estado, mes);
+  assert.deepEqual(facturas.map((f) => f.socioId), esperadas.map((e) => e.socioId), `socios de ${mes}`);
+  facturas.forEach((f, i) => {
+    assert.equal(f.mes, mes);
+    assert.deepEqual(f.lineas, esperadas[i]!.lineas, `líneas de ${f.numero}`);
+    const total = f.lineas.reduce((suma: number, l: any) => suma + l.importe, 0);
+    assert.equal(f.total, total, `total de ${f.numero}`);
+    assert.equal(f.base, baseDeTotal(total), `base de ${f.numero}`);
+    assert.equal(f.iva, total - f.base, `iva de ${f.numero}`);
+  });
+}
+
+test("solo un gestor genera y consulta facturas", async () => {
+  const casos: [string, string, unknown][] = [
+    ["POST", "/api/facturas", { mes: "2026-10" }],
+    ["GET", "/api/facturas?mes=2026-10", undefined],
+    ["GET", "/api/facturas/F2026-0001", undefined],
+  ];
+  for (const [metodo, ruta, cuerpo] of casos) {
+    const sin = await api.pedir(metodo, ruta, { cuerpo });
+    assert.equal(sin.status, 401, `${metodo} ${ruta} sin X-Socio`);
+    assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo, socio: SOCIO });
+    assert.equal(socio.status, 403, `${metodo} ${ruta} de un socio`);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+});
+
+test("el mes tiene formato AAAA-MM y tiene que haber terminado", async () => {
+  for (const mes of ["2026-1", "2026/10", "octubre", "2026-13", "2026-00", undefined]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 400, `mes ${mes}`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  // El club está en noviembre: noviembre y los meses siguientes todavía no han terminado.
+  for (const mes of ["2026-11", "2026-12"]) {
+    const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(abierto.status, 409, mes);
+    assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+});
+
+test("consultar un mes que no se ha generado devuelve una lista vacía", async () => {
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo, { facturas: [] });
+  const inexistente = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: GESTOR });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+let octubre: any[];
+test("octubre: una factura por socio con algo que facturar, ordenadas por socio, con sus líneas", async () => {
+  const generada = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(generada.status, 201);
+  octubre = generada.cuerpo.facturas;
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  comprobarFacturas(octubre, estado, "2026-10");
+  // Los números son correlativos en el orden de socio.
+  assert.deepEqual(octubre.map((f) => f.numero), octubre.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+  // Las canceladas sin penalización no aparecen en ninguna línea.
+  const canceladas = new Set(estado.reservas.filter((r: any) => r.estado === "cancelada").map((r: any) => r.id));
+  for (const f of octubre) for (const l of f.lineas) assert.equal(canceladas.has(l.reservaId), false);
+  // Socio 001: tres reservas (1800 + 2800 + 2200).
+  const primera = octubre[0];
+  assert.equal(primera.numero, "F2026-0001");
+  assert.equal(primera.socioId, "socio-001");
+  assert.equal(primera.lineas.length, 3);
+  assert.equal(primera.total, 6800);
+});
+
+test("el IVA se calcula sobre el total de la factura, con el redondeo de la spec", () => {
+  const casos: [number, number][] = [[0, 0], [1, 1], [3, 2], [121, 100], [2800, 2314], [6800, 5620], [20400, 16860]];
+  for (const [total, base] of casos) assert.equal(baseDeTotal(total), base, `base de ${total}`);
+  // Socio 002: total 20400 → base 16860 (16859,50 redondeado hacia arriba), IVA 3540.
+  const socio002 = octubre.find((f) => f.socioId === "socio-002");
+  assert.deepEqual([socio002.total, socio002.base, socio002.iva], [20400, 16860, 3540]);
+});
+
+test("generar un mes dos veces devuelve las mismas facturas y no crea ninguna nueva", async () => {
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo.facturas.length;
+  const repetida = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo.facturas, octubre);
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, antes);
+});
+
+test("consultar: la lista del mes y una factura por número", async () => {
+  const lista = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(lista.status, 200);
+  assert.deepEqual(lista.cuerpo, { facturas: octubre });
