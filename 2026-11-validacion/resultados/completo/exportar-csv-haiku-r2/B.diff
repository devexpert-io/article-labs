+/** RFC 4180: los campos con coma, comillas o saltos de línea van entre comillas, y las comillas se duplican. */
+function celdaCsv(valor: string): string {
+  return /[",\r\n]/.test(valor) ? `"${valor.replace(/"/g, '""')}"` : valor;
+}
+
+/** Céntimos enteros a euros con dos decimales y punto: 1800 es "18.00". */
+function euros(centimos: number): string {
+  return (centimos / 100).toFixed(2);
+}
+
+/** Fecha AAAA-MM-DD que existe en el calendario (rechaza, p. ej., 2026-02-30). */
+function fechaExiste(fecha: string): boolean {
+  if (!FECHA.test(fecha)) return false;
+  const d = new Date(`${fecha}T00:00:00Z`);
+  // Mes o día fuera de rango (2027-13-01, 2027-00-10) dan una fecha inválida, y toISOString() lanzaría.
+  return !Number.isNaN(d.getTime()) && d.toISOString().slice(0, 10) === fecha;
+}
+
+function compararReservasParaExportar(a: Reserva, b: Reserva): number {
+  if (a.inicio !== b.inicio) return a.inicio < b.inicio ? -1 : 1;
+  if (a.pistaId !== b.pistaId) return a.pistaId < b.pistaId ? -1 : 1;
+  return 0;
+}
+
 function sinAcentos(texto: string): string {
   return texto.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
 }
