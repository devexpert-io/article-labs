diff --git a/test/exportar-csv.test.ts b/test/exportar-csv.test.ts
new file mode 100644
index 0000000..39f7037
--- /dev/null
+++ b/test/exportar-csv.test.ts
@@ -0,0 +1,131 @@
+// Exportación de reservas a CSV (docs/specs/exportar-csv.md), probada a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+const EXPORTAR = "/api/reservas/exportar";
+
+let api: Api;
+// Reservas creadas en el arranque. Son del 10 y 11 de marzo de 2027, fechas sin datos de la semilla.
+const r: Record<string, string> = {};
+
+before(async () => {
+  api = await arrancarApi();
+  const crear = async (clave: string, socioId: string, pistaId: string, inicio: string, notas?: string) => {
+    const cuerpo: Record<string, string> = { socioId, pistaId, inicio };
+    if (notas !== undefined) cuerpo.notas = notas;
+    const creada = await api.pedir("POST", "/api/reservas", { cuerpo });
+    assert.equal(creada.status, 201, `crear ${clave}: ${creada.texto}`);
+    r[clave] = creada.cuerpo.reserva.id;
+  };
+  // Fuera del periodo: el día anterior.
+  await crear("R1", "socio-002", "pista-3", "2027-03-09T10:30");
+  // Con coma, comillas y salto de línea en las notas.
+  await crear("R2", "socio-004", "pista-2", "2027-03-10T16:30", 'Caja, "VIP"\nrevisar');
+  await crear("R3", "socio-016", "pista-1", "2027-03-10T09:00");
+  // Misma hora en dos pistas, creadas en orden inverso a su id de pista.
+  await crear("R4", "socio-002", "pista-2", "2027-03-10T12:00");
+  await crear("R5", "socio-016", "pista-1", "2027-03-10T12:00");
+  // Punta: a partir de las 18:00.
+  await crear("R6", "socio-001", "pista-3", "2027-03-11T18:00");
+  // Fuera del periodo: el día siguiente al último.
+  await crear("R7", "socio-016", "pista-2", "2027-03-12T09:00");
+  await crear("R8", "socio-001", "pista-1", "2027-03-11T10:30");
+  // R2 se cancela con más de 24 horas de antelación: sin penalización.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-01T10:00" } });
+  assert.equal((await api.pedir("POST", `/api/reservas/${r.R2}/cancelar`)).status, 200);
+  // R8 se cancela a menos de 24 horas, con forzar: penalización del 100 %.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-11T08:00" } });
+  const forzada = await api.pedir("POST", `/api/reservas/${r.R8}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1800);
+});
+after(() => api.cerrar());
+
+test("solo exporta un gestor", async () => {
+  const sinCabecera = await api.pedir("GET", `${EXPORTAR}?desde=2027-03-10&hasta=2027-03-11`);
+  assert.equal(sinCabecera.status, 401);
+  assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const desconocido = await api.pedir("GET", `${EXPORTAR}?desde=2027-03-10&hasta=2027-03-11`, { socio: "socio-999" });
+  assert.equal(desconocido.status, 401);
+  const socio = await api.pedir("GET", `${EXPORTAR}?desde=2027-03-10&hasta=2027-03-11`, { socio: "socio-002" });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const gestor = await api.pedir("GET", `${EXPORTAR}?desde=2027-03-10&hasta=2027-03-11`, { socio: "socio-040" });
+  assert.equal(gestor.status, 200);
+});
+
+test("responde CSV con el content-type y el content-disposition del periodo", async () => {
+  const respuesta = await api.pedir("GET", `${EXPORTAR}?desde=2027-03-10&hasta=2027-03-11`, { socio: "socio-040" });
+  assert.equal(respuesta.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(respuesta.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2027-03-10-2027-03-11.csv"');
+  assert.equal(respuesta.texto.split("\r\n")[0], CABECERA);
+});
+
+test("filas, orden, importes, penalización y escapado RFC 4180 con CRLF", async () => {
+  const respuesta = await api.pedir("GET", `${EXPORTAR}?desde=2027-03-10&hasta=2027-03-11`, { socio: "socio-040" });
+  const esperado = [
+    CABECERA,
+    `${r.R3},2027-03-10,09:00,Pista 1,Paula Díaz,paula.diaz@example.com,confirmada,18.00,,`,
+    `${r.R5},2027-03-10,12:00,Pista 1,Paula Díaz,paula.diaz@example.com,confirmada,18.00,,`,
+    `${r.R4},2027-03-10,12:00,Pista 2,Marta López,marta.lopez@example.com,confirmada,18.00,,`,
+    `${r.R2},2027-03-10,16:30,Pista 2,Irene Sanz,irene.sanz@example.com,cancelada,18.00,,"Caja, ""VIP""\nrevisar"`,
+    `${r.R8},2027-03-11,10:30,Pista 1,Ana García,ana.garcia@example.com,cancelada,18.00,18.00,`,
+    `${r.R6},2027-03-11,18:00,Pista 3,Ana García,ana.garcia@example.com,confirmada,20.00,,`,
+  ].map((linea) => `${linea}\r\n`).join("");
+  assert.equal(respuesta.texto, esperado);
+});
+
+test("el filtro por estado deja solo las reservas de ese estado", async () => {
+  const respuesta = await api.pedir("GET", `${EXPORTAR}?desde=2027-03-10&hasta=2027-03-11&estado=cancelada`, { socio: "socio-040" });
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.texto.split("\r\n").slice(0, 3).map((l) => l.split(",")[0]), [CABECERA.split(",")[0], r.R2, r.R8]);
+});
+
+test("un periodo sin reservas devuelve solo la cabecera", async () => {
+  const respuesta = await api.pedir("GET", `${EXPORTAR}?desde=2027-06-01&hasta=2027-06-01`, { socio: "socio-040" });
+  assert.equal(respuesta.status, 200);
+  assert.equal(respuesta.texto, `${CABECERA}\r\n`);
+});
+
+test("desde y hasta son obligatorios, con formato AAAA-MM-DD y en orden", async () => {
+  const gestor = { socio: "socio-040" };
+  const casos = [
+    `${EXPORTAR}?hasta=2027-03-11`,
+    `${EXPORTAR}?desde=2027-03-10`,
+    `${EXPORTAR}?desde=2027-3-10&hasta=2027-03-11`,
+    `${EXPORTAR}?desde=2027-02-30&hasta=2027-03-11`,
+    `${EXPORTAR}?desde=2027-13-01&hasta=2027-03-11`,
+    `${EXPORTAR}?desde=2027-00-10&hasta=2027-03-11`,
+    `${EXPORTAR}?desde=2027-02-00&hasta=2027-03-11`,
+    `${EXPORTAR}?desde=2027-03-10&hasta=2027-13-11`,
+    `${EXPORTAR}?desde=2027-03-10&hasta=2027-00-11`,
+    `${EXPORTAR}?desde=2027-03-10&hasta=2027-03-00`,
+    `${EXPORTAR}?desde=2027-03-11&hasta=2027-03-10`,
+    `${EXPORTAR}?desde=2027-03-10&hasta=2027-03-11&estado=pagada`,
+    `${EXPORTAR}?desde=2027-03-10&hasta=2027-03-11&estado=`,
+  ];
+  for (const ruta of casos) {
+    const respuesta = await api.pedir("GET", ruta, gestor);
+    assert.equal(respuesta.status, 400, ruta);
+    assert.equal(respuesta.cuerpo.error.codigo, "DATOS_INVALIDOS", ruta);
+  }
+});
+
+test("el periodo abarca como mucho 92 días, contando los dos extremos", async () => {
+  const gestor = { socio: "socio-040" };
+  const en92 = await api.pedir("GET", `${EXPORTAR}?desde=2027-01-01&hasta=2027-04-02`, gestor);
+  assert.equal(en92.status, 200);
+  const en93 = await api.pedir("GET", `${EXPORTAR}?desde=2027-01-01&hasta=2027-04-03`, gestor);
+  assert.equal(en93.status, 400);
+  assert.equal(en93.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+});
+
+test("el listado de reservas no cambia", async () => {
+  const respuesta = await api.pedir("GET", "/api/reservas?desde=2027-03-10&hasta=2027-03-11&limite=2");
+  assert.equal(respuesta.status, 200);
+  assert.match(respuesta.cabeceras.get("content-type") ?? "", /^application\/json/);
+  assert.equal(respuesta.cuerpo.total, 6);
+  assert.equal(respuesta.cuerpo.reservas.length, 2);
+  assert.equal((await api.pedir("GET", `/api/reservas/${r.R3}`)).cuerpo.reserva.id, r.R3);
+});
