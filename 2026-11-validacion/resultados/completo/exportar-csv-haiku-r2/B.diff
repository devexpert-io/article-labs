+    /** CSV de las reservas que empiezan entre `desde` y `hasta` (ambos incluidos). Los permisos los comprueba la API HTTP. */
+    exportarReservas(f: { desde?: unknown; hasta?: unknown; estado?: unknown }) {
+      const { desde, hasta, estado: filtroEstado } = f;
+      if (typeof desde !== "string" || typeof hasta !== "string" || !fechaExiste(desde) || !fechaExiste(hasta)) {
+        invalido("desde y hasta son obligatorios, con el formato AAAA-MM-DD");
+      }
+      if (desde > hasta) invalido("desde no puede ser posterior a hasta");
+      if (filtroEstado !== undefined && (typeof filtroEstado !== "string" || !ESTADOS_RESERVA.includes(filtroEstado))) {
+        invalido('estado debe ser "confirmada", "cancelada" o "no_presentada"');
+      }
+      const dias = (Date.parse(`${hasta}T00:00:00Z`) - Date.parse(`${desde}T00:00:00Z`)) / 86_400_000 + 1;
+      if (dias > DIAS_MAXIMOS_EXPORTACION) {
+        throw new ErrorDelClub(
+          "RANGO_DEMASIADO_GRANDE",
+          `El periodo abarca ${dias} días y el máximo es ${DIAS_MAXIMOS_EXPORTACION}`,
+          400,
+        );
+      }
+      const filas = estado.reservas
+        .filter((r) =>
+          r.inicio.slice(0, 10) >= desde &&
+          r.inicio.slice(0, 10) <= hasta &&
+          (filtroEstado === undefined || r.estado === filtroEstado))
+        .sort(compararReservasParaExportar)
+        .map((r) => {
+          const socio = estado.socios.find((s) => s.id === r.socioId);
+          return [
+            r.id,
+            r.inicio.slice(0, 10),
+            r.inicio.slice(11),
+            pista(r.pistaId).nombre,
+            socio?.nombre ?? "",
+            socio?.email ?? "",
+            r.estado,
+            euros(r.importe),
+            r.penalizacion === undefined ? "" : euros(r.penalizacion),
+            r.notas,
+          ].map(celdaCsv).join(",");
+        });
+      const csv = [CABECERA_CSV, ...filas].map((linea) => `${linea}\r\n`).join("");
+      return { nombreFichero: `reservas-${desde}-${hasta}.csv`, csv };
+    },
+
     obtenerReserva(id: string) {
       return { reserva: reserva(id) };
     },
