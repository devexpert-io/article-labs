@@ -0,0 +1,222 @@
+// La lista de espera de franjas, probada a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Franjas de la semilla: A está ocupada por socio-007 y B por socio-005.
+const A = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+const B = { pistaId: "pista-2", inicio: "2026-11-20T18:00" };
+const C = { pistaId: "pista-1", inicio: "2026-11-23T18:00" };
+
+async function conApi(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function esperar(api: Api, socio: string, franja: { pistaId: string; inicio: string }, esperado = 201) {
+  return api.pedir("POST", "/api/esperas", { cuerpo: franja, socio }).then((r) => {
+    assert.equal(r.status, esperado, `apuntarse a ${franja.pistaId} ${franja.inicio}: ${r.texto}`);
+    return r;
+  });
+}
+
+test("apuntarse a una franja ocupada devuelve 201 con la posición", async () => {
+  await conApi(async (api) => {
+    const sinIdentidad = await api.pedir("POST", "/api/esperas", { cuerpo: A });
+    assert.equal(sinIdentidad.status, 401);
+    assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const creada = await esperar(api, "socio-003", A);
+    assert.deepEqual(creada.cuerpo.espera, {
+      id: "E-0001",
+      socioId: "socio-003",
+      pistaId: "pista-1",
+      inicio: "2026-11-19T19:30",
+      estado: "activa",
+      posicion: 1,
+    });
+  });
+});
+
+test("solo se pueden esperar franjas que se pueden reservar", async () => {
+  await conApi(async (api) => {
+    const casos: Array<{ franja: { pistaId: string; inicio: string }; esperado: number; codigo: string; socio?: string }> = [
+      { franja: { pistaId: "pista-9", inicio: "2026-11-19T19:30" }, esperado: 404, codigo: "PISTA_NO_ENCONTRADA" },
+      { franja: { pistaId: "pista-4", inicio: "2026-11-19T19:30" }, esperado: 409, codigo: "PISTA_CERRADA" },
+      { franja: { pistaId: "pista-1", inicio: "2026-11-19T20:00" }, esperado: 400, codigo: "FRANJA_INVALIDA" },
+      { franja: { pistaId: "pista-1", inicio: "2026-11-18T09:00" }, esperado: 409, codigo: "FRANJA_PASADA" },
+      { franja: A, esperado: 409, codigo: "CUOTA_INACTIVA", socio: "socio-022" },
+      { franja: { pistaId: "pista-2", inicio: "2026-11-19T19:30" }, esperado: 409, codigo: "FRANJA_LIBRE" },
+    ];
+    for (const caso of casos) {
+      const r = await api.pedir("POST", "/api/esperas", { cuerpo: caso.franja, socio: caso.socio ?? "socio-003" });
+      assert.equal(r.status, caso.esperado, `${caso.codigo}: ${r.texto}`);
+      assert.equal(r.cuerpo.error.codigo, caso.codigo);
+    }
+  });
+});
+
+test("sin duplicados, sin esperar lo que ya está reservado y con un límite de dos", async () => {
+  await conApi(async (api) => {
+    await esperar(api, "socio-003", A);
+
+    const repetida = await esperar(api, "socio-003", A, 409);
+    assert.equal(repetida.cuerpo.error.codigo, "YA_EN_ESPERA");
+
+    const reservada = await esperar(api, "socio-007", A, 409);
+    assert.equal(reservada.cuerpo.error.codigo, "YA_RESERVADA");
+
+    await esperar(api, "socio-003", B);
+    const tercera = await esperar(api, "socio-003", C, 409);
+    assert.equal(tercera.cuerpo.error.codigo, "LIMITE_DE_ESPERAS");
+  });
+});
+
+test("la posición es el orden de llegada y un gestor puede consultar las de otro socio", async () => {
+  await conApi(async (api) => {
+    await esperar(api, "socio-003", A);
+    await esperar(api, "socio-005", A);
+    await esperar(api, "socio-004", A);
+
+    const propias = await api.pedir("GET", "/api/esperas", { socio: "socio-003" });
+    assert.equal(propias.status, 200);
+    assert.deepEqual(propias.cuerpo.esperas.map((e: any) => [e.socioId, e.posicion]), [["socio-003", 1]]);
+
+    const gestor = await api.pedir("GET", "/api/esperas?socio=socio-004", { socio: "socio-040" });
+    assert.equal(gestor.status, 200);
+    assert.deepEqual(gestor.cuerpo.esperas.map((e: any) => [e.socioId, e.posicion]), [["socio-004", 3]]);
+
+    const ajeno = await api.pedir("GET", "/api/esperas?socio=socio-004", { socio: "socio-003" });
+    assert.equal(ajeno.status, 403);
+    assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const sinIdentidad = await api.pedir("GET", "/api/esperas");
