+function instanteMadrid(fechaHora: string): number {
+  const objetivo = Date.parse(`${fechaHora}:00Z`);
+  const partes = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", second: "2-digit", hourCycle: "h23" })
+    .formatToParts(new Date(objetivo));
+  const valores = Object.fromEntries(partes.map((p) => [p.type, p.value]));
+  const representado = Date.UTC(Number(valores.year), Number(valores.month) - 1, Number(valores.day), Number(valores.hour), Number(valores.minute), Number(valores.second));
+  return objetivo - (representado - objetivo);
+}
+
+function fechaHoraReal(inicio: string): boolean {
+  if (!FECHA_HORA.test(inicio)) return false;
+  const fecha = inicio.slice(0, 10);
+  const d = new Date(`${fecha}T00:00:00Z`);
+  return Number.isFinite(d.getTime()) && d.toISOString().slice(0, 10) === fecha;
+}
+
+function horasRealesEntre(desde: string, hasta: string): number {
+  return (instanteMadrid(hasta) - instanteMadrid(desde)) / 3_600_000;
+}
