+test("cancelar fuera de plazo con forzar también asigna la franja", async () => {
+  const forzado = await arrancarApi({ AHORA: "2026-11-25T10:00" });
+  try {
+    const reserva = await reservar(forzado, "socio-039", "pista-2", "2026-11-25T19:30");
