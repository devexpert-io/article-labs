+// La lista de espera de franjas, probada a través de la API (docs/specs/lista-espera.md).
+// Las franjas de los tests son del 25 de noviembre de 2026: la semilla no tiene reservas ese día.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const reservar = async (a: Api, socioId: string, pistaId: string, inicio: string): Promise<string> => {
+  const r = await a.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.reserva.id;
+};
+const apuntar = (a: Api, socio: string, pistaId: string, inicio: string) =>
+  a.pedir("POST", "/api/esperas", { socio, cuerpo: { pistaId, inicio } });
+const cancelar = (a: Api, reservaId: string, cuerpo?: unknown) =>
+  a.pedir("POST", `/api/reservas/${reservaId}/cancelar`, { cuerpo });
+const esperasDe = async (a: Api, socio: string, consultado?: string): Promise<any[]> => {
+  const ruta = consultado ? `/api/esperas?socio=${consultado}` : "/api/esperas";
+  const r = await a.pedir("GET", ruta, { socio });
+  assert.equal(r.status, 200, r.texto);
+  return r.cuerpo.esperas;
+};
+const estadoDeEspera = async (a: Api, id: string): Promise<string> => {
+  const estado = (await a.pedir("GET", "/_estado")).cuerpo;
+  return estado.esperas.find((e: { id: string }) => e.id === id).estado;
+};
+
+test("apuntarse solo en franjas ocupadas, con las comprobaciones de reservar", async () => {
+  await reservar(api, "socio-030", "pista-1", "2026-11-25T19:30");
+
+  const sinCabecera = await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-1", inicio: "2026-11-25T19:30" } });
+  assert.equal(sinCabecera.status, 401);
+  assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const alta = await apuntar(api, "socio-003", "pista-1", "2026-11-25T19:30");
+  assert.equal(alta.status, 201);
+  assert.equal(alta.cuerpo.espera.estado, "activa");
+  assert.equal(alta.cuerpo.espera.posicion, 1);
+  assert.equal(alta.cuerpo.espera.socioId, "socio-003");
+  assert.equal(alta.cuerpo.espera.pistaId, "pista-1");
+  assert.equal(alta.cuerpo.espera.inicio, "2026-11-25T19:30");
+
+  const rechazos: [string, string, string, number, string][] = [
+    ["socio-003", "pista-1", "2026-11-25T19:30", 409, "YA_EN_ESPERA"],
+    ["socio-030", "pista-1", "2026-11-25T19:30", 409, "YA_RESERVADA"],
+    ["socio-011", "pista-1", "2026-11-25T19:30", 409, "CUOTA_INACTIVA"],
+    ["socio-003", "pista-9", "2026-11-25T19:30", 404, "PISTA_NO_ENCONTRADA"],
