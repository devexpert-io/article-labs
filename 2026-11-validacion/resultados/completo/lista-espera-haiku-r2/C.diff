+test("la posición es el orden de llegada y se recalcula al retirarse alguien", async () => {
+  await reservar(api, "socio-035", "pista-3", "2026-11-25T15:00");
+  const uno = await apuntar(api, "socio-001", "pista-3", "2026-11-25T15:00");
+  const dos = await apuntar(api, "socio-002", "pista-3", "2026-11-25T15:00");
+  const tres = await apuntar(api, "socio-004", "pista-3", "2026-11-25T15:00");
+  assert.deepEqual([uno.cuerpo.espera.posicion, dos.cuerpo.espera.posicion, tres.cuerpo.espera.posicion], [1, 2, 3]);
+
+  const mirarLista = await esperasDe(api, "socio-004");
+  assert.equal(mirarLista[0].posicion, 3);
+
+  // Sin permiso: un socio no ve ni retira las esperas de otro.
+  const ajena = await api.pedir("GET", "/api/esperas?socio=socio-001", { socio: "socio-002" });
+  assert.equal(ajena.status, 403);
+  assert.equal(ajena.cuerpo.error.codigo, "SIN_PERMISO");
+  const retiradaAjena = await api.pedir("DELETE", `/api/esperas/${uno.cuerpo.espera.id}`, { socio: "socio-002" });
+  assert.equal(retiradaAjena.status, 403);
+  assert.equal(retiradaAjena.cuerpo.error.codigo, "SIN_PERMISO");
+
+  // Retirarse: queda como retirada y los de detrás suben.
+  const retirada = await api.pedir("DELETE", `/api/esperas/${uno.cuerpo.espera.id}`, { socio: "socio-001" });
+  assert.equal(retirada.status, 200);
+  assert.equal(retirada.cuerpo.espera.estado, "retirada");
+  assert.equal(retirada.cuerpo.espera.posicion, undefined);
+  assert.deepEqual(await esperasDe(api, "socio-001"), []);
+  assert.equal((await esperasDe(api, "socio-002"))[0].posicion, 1);
+  assert.equal((await esperasDe(api, "socio-004"))[0].posicion, 2);
+
+  // Un gestor puede consultar y retirar las de cualquiera.
+  assert.equal((await esperasDe(api, "socio-040", "socio-004"))[0].posicion, 2);
+  const retiradaGestor = await api.pedir("DELETE", `/api/esperas/${dos.cuerpo.espera.id}`, { socio: "socio-040" });
+  assert.equal(retiradaGestor.status, 200);
+  assert.equal((await esperasDe(api, "socio-004"))[0].posicion, 1);
+
+  const otraVez = await api.pedir("DELETE", `/api/esperas/${uno.cuerpo.espera.id}`, { socio: "socio-001" });
+  assert.equal(otraVez.status, 409);
+  assert.equal(otraVez.cuerpo.error.codigo, "ESPERA_NO_ACTIVA");
+  const inexistente = await api.pedir("DELETE", "/api/esperas/E-9999", { socio: "socio-001" });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "ESPERA_NO_ENCONTRADA");
+
+  const sinCabeceraLista = await api.pedir("GET", "/api/esperas");
+  assert.equal(sinCabeceraLista.status, 401);
+  const sinCabeceraBorrar = await api.pedir("DELETE", `/api/esperas/${tres.cuerpo.espera.id}`);
+  assert.equal(sinCabeceraBorrar.status, 401);
+  assert.equal(sinCabeceraBorrar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+});
