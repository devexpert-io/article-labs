+    const conForzar = await cancelar(forzado, reserva, { forzar: true });
+    assert.equal(conForzar.status, 200);
+    assert.equal(conForzar.cuerpo.reserva.penalizacion, 2800);
+    const asignada = (await forzado.pedir("GET", `/api/reservas/${conForzar.cuerpo.asignadaA}`)).cuerpo.reserva;
+    assert.equal(asignada.socioId, "socio-016");
+    assert.equal(asignada.importe, 2800);
+  } finally {
