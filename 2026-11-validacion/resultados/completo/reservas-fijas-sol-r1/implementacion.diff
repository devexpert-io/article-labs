+// La API no permite marcar una reserva como no presentada ni cambiar las tarifas.
+// Estos dos casos se verifican directamente sobre el núcleo.
+test("no toca reservas no presentadas o ya empezadas y redondea el descuento hacia abajo", () => {
+  const estado = crearSemilla();
+  estado.pistas[0]!.precioPunta = 2801;
+  const club = crearClub(estado);
+  const { serie } = club.crearSerie({ ...datos, semanas: 8 });
+  const reservas = club.obtenerSerie(serie.id).serie.reservas;
+  assert.ok(reservas.every((r) => r.importe === 2520));
+  reservas[1]!.estado = "no_presentada";
+  estado.ahora = datos.inicio;
+  const antes = reservas.slice(0, 2).map((r) => ({ ...r }));
+  const resultado = club.cancelarSerie(serie.id, { forzar: true });
+  assert.equal(resultado.canceladas.length, 6);
+  assert.deepEqual(reservas.slice(0, 2), antes);
