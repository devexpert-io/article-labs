+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+const datos = { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-03-23T19:30", semanas: 2 };
+const gestor = "socio-040";
+const crear = (api: Api, cambios = {}) => api.pedir("POST", "/api/series", { socio: gestor, cuerpo: { ...datos, ...cambios } });
+const consultar = (api: Api, id: string) => api.pedir("GET", `/api/series/${id}`, { socio: gestor });
+const cancelar = (api: Api, id: string, cuerpo = {}) => api.pedir("POST", `/api/series/${id}/cancelar`, { socio: gestor, cuerpo });
+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+test("solo el gestor crea, consulta y cancela series", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const s = (await crear(api)).cuerpo.serie;
+  for (const [metodo, ruta] of [["POST", "/api/series"], ["GET", `/api/series/${s.id}`], ["POST", `/api/series/${s.id}/cancelar`]]) {
+    error(await api.pedir(metodo!, ruta!, { cuerpo: metodo === "POST" ? datos : undefined }), 401, "NO_IDENTIFICADO");
+    error(await api.pedir(metodo!, ruta!, { socio: "socio-041", cuerpo: metodo === "POST" ? datos : undefined }), 403, "SIN_PERMISO");
+  }
+  assert.equal((await consultar(api, s.id)).status, 200);
+  assert.equal((await cancelar(api, s.id)).status, 200);
+});
+
+test("valida los datos y las reglas globales sin crear reservas ni series", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+  for (const semanas of [undefined, null, "2", 1, 13, 2.5]) error(await crear(api, { semanas }), 400, "DATOS_INVALIDOS");
+  error(await crear(api, { socioId: "inexistente" }), 404, "SOCIO_NO_ENCONTRADO");
+  error(await crear(api, { pistaId: "inexistente" }), 404, "PISTA_NO_ENCONTRADA");
+  for (const inicio of [undefined, 123, "incorrecto", "2027-03-23T19:00", "2027-02-30T19:30"]) {
+    error(await crear(api, { inicio }), 400, "FRANJA_INVALIDA");
+  }
+  for (const inicio of ["2026-11-18T09:00", "2026-11-17T19:30"]) error(await crear(api, { inicio }), 409, "FRANJA_PASADA");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: datos.inicio } });
+  error(await crear(api), 409, "FRANJA_PASADA");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: antes.ahora } });
+  error(await crear(api, { socioId: "socio-011" }), 409, "CUOTA_INACTIVA");
+  error(await crear(api, { pistaId: "pista-4" }), 409, "PISTA_CERRADA");
+  const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.deepEqual(despues.reservas, antes.reservas);
+  assert.deepEqual(despues.series, []);
+  assert.equal(despues.contador, antes.contador);
+  error(await consultar(api, "inexistente"), 404, "SERIE_NO_ENCONTRADA");
+  error(await cancelar(api, "inexistente"), 404, "SERIE_NO_ENCONTRADA");
+});
+
+test("crea reservas semanales a la misma hora local al cambiar la hora y devuelve ids y reservas completas", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-22T10:00" } });
+  const r = await crear(api, { semanas: 3 });
+  assert.equal(r.status, 201);
+  const s = r.cuerpo.serie;
+  assert.deepEqual(s, { ...datos, semanas: 3, id: s.id, reservas: s.reservas, saltadas: [] });
+  assert.equal(s.reservas.length, 3);
+  assert.ok(s.reservas.every((id: unknown) => typeof id === "string"));
+  const consulta = await consultar(api, s.id);
+  const reservas = consulta.cuerpo.serie.reservas;
+  assert.deepEqual(reservas.map((r: any) => r.inicio), ["2027-03-23T19:30", "2027-03-30T19:30", "2027-04-06T19:30"]);
+  assert.deepEqual(reservas.map((r: any) => r.id), s.reservas);
+  for (const reserva of reservas) {
+    assert.equal(reserva.serieId, s.id);
+    assert.equal(reserva.estado, "confirmada");
+    assert.equal(reserva.socioId, datos.socioId);
+    assert.equal(reserva.pistaId, datos.pistaId);
+    assert.equal(reserva.fin, `${reserva.inicio.slice(0, 10)}T21:00`);
+    assert.equal(reserva.importe, 2800);
+    assert.deepEqual((await api.pedir("GET", `/api/reservas/${reserva.id}`)).cuerpo.reserva, reserva);
+  }
+});
+
+test("salta semanas ocupadas, aplica el descuento según la duración solicitada y rechaza series vacías sin mutaciones", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const primera = (await crear(api, { semanas: 7 })).cuerpo.serie;
+  assert.ok((await consultar(api, primera.id)).cuerpo.serie.reservas.every((r: any) => r.importe === 2800));
+  const segunda = await crear(api, { semanas: 8 });
+  assert.equal(segunda.status, 201);
+  assert.equal(segunda.cuerpo.serie.reservas.length, 1);
+  const saltadas = (await consultar(api, primera.id)).cuerpo.serie.reservas.map((r: any) => ({ inicio: r.inicio, codigo: "FRANJA_NO_DISPONIBLE" }));
+  assert.deepEqual(segunda.cuerpo.serie.saltadas, saltadas);
+  assert.equal((await consultar(api, segunda.cuerpo.serie.id)).cuerpo.serie.reservas[0].importe, 2520);
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+  error(await crear(api), 409, "SERIE_VACIA");
+  const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.deepEqual(despues.reservas, antes.reservas);
+  assert.deepEqual(despues.series, antes.series);
+  assert.equal(despues.contador, antes.contador);
+  const valle = await crear(api, { inicio: "2027-12-28T09:00", semanas: 12 });
+  assert.equal(valle.status, 201);
+  assert.equal((await consultar(api, valle.cuerpo.serie.id)).cuerpo.serie.reservas.length, 12);
+  assert.ok((await consultar(api, valle.cuerpo.serie.id)).cuerpo.serie.reservas.every((r: any) => r.importe === 1620));
+});
+
+test("las series quedan fuera del límite de tres y las reservas normales mantienen su límite", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const serie = (await crear(api, { semanas: 8 })).cuerpo.serie;
+  for (const inicio of ["2027-05-01T09:00", "2027-05-02T09:00", "2027-05-03T09:00"]) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { ...datos, inicio } });
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.serieId, undefined);
+  }
+  error(await api.pedir("POST", "/api/reservas", { cuerpo: { ...datos, inicio: "2027-05-04T09:00" } }), 409, "LIMITE_DE_RESERVAS");
+  assert.equal((await crear(api, { inicio: "2027-06-01T19:30" })).status, 201);
+  assert.equal((await consultar(api, serie.id)).cuerpo.serie.reservas.length, 8);
+});
+
+test("cancelación parcial, forzada, a las 24 horas exactas e individual con las reglas habituales", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const s = (await crear(api, { semanas: 8 })).cuerpo.serie;
+  const [pasada, cercana, , suelta] = s.reservas;
+  const individual = await api.pedir("POST", `/api/reservas/${suelta}/cancelar`);
+  assert.equal(individual.status, 200);
+  assert.equal(individual.cuerpo.reserva.penalizacion, undefined);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-29T20:00" } });
+  const antes = (await consultar(api, s.id)).cuerpo.serie;
+  error(await cancelar(api, s.id, { forzar: "true" }), 400, "DATOS_INVALIDOS");
+  assert.deepEqual((await consultar(api, s.id)).cuerpo.serie, antes);
+  error(await api.pedir("POST", `/api/reservas/${cercana}/cancelar`), 409, "FUERA_DE_PLAZO");
+  const parcial = await cancelar(api, s.id);
+  assert.equal(parcial.status, 200);
+  assert.deepEqual(parcial.cuerpo.pendientes.map((r: any) => r.id), [cercana]);
+  assert.deepEqual(parcial.cuerpo.canceladas.map((r: any) => r.id), s.reservas.filter((id: string) => ![pasada, cercana, suelta].includes(id)));
+  assert.ok(parcial.cuerpo.canceladas.every((r: any) => r.estado === "cancelada" && r.penalizacion === undefined));
+  const forzada = await cancelar(api, s.id, { forzar: true });
+  assert.deepEqual(forzada.cuerpo.pendientes, []);
+  assert.equal(forzada.cuerpo.canceladas[0].id, cercana);
+  assert.equal(forzada.cuerpo.canceladas[0].penalizacion, 2520);
+  assert.equal((await consultar(api, s.id)).cuerpo.serie.reservas[0].estado, "confirmada");
+  assert.deepEqual((await cancelar(api, s.id, { forzar: true })).cuerpo.canceladas, []);
+
+  const otra = (await crear(api, { inicio: "2027-07-06T19:30" })).cuerpo.serie;
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-07-05T19:30" } });
+  const exacta = await cancelar(api, otra.id);
+  assert.equal(exacta.cuerpo.canceladas.length, 2);
+  assert.deepEqual(exacta.cuerpo.pendientes, []);
+  assert.ok(exacta.cuerpo.canceladas.every((r: any) => r.penalizacion === undefined));
+});
