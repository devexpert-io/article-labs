+test("una cancelación individual forzada conserva la serie y penaliza el importe descontado", async (t) => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const s = (await crear(api, { semanas: 8 })).cuerpo.serie;
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-23T10:00" } });
+  const r = await api.pedir("POST", `/api/reservas/${s.reservas[0]}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 2520);
+  const reservas = (await consultar(api, s.id)).cuerpo.serie.reservas;
+  assert.equal(reservas[0].estado, "cancelada");
+  assert.ok(reservas.slice(1).every((r: any) => r.estado === "confirmada"));
+});
