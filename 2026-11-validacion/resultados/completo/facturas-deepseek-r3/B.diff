+test("las canceladas con penalización se facturan como penalización y las gratuitas no se facturan", async () => {
+  const api = await arrancarApi();
+  try {
+    // R-0520 empieza el 19 de noviembre: se cancela fuera de plazo y con penalización.
+    const cancelada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 1200);
+    assert.equal((await moverReloj(api, "2026-12-01T10:00")).status, 200);
+
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const respuesta = await generar(api, "2026-11");
+    assert.equal(respuesta.status, 201);
+    const facturas = respuesta.cuerpo.facturas;
+    assert.deepEqual(facturas, facturasEsperadas(estado, "2026-11"));
+
+    // La penalización de R-0520 entra en la factura de su socio (socio-002).
+    const deSocio002 = facturas.find((f: any) => f.socioId === "socio-002");
+    assert.deepEqual(deSocio002!.lineas.find((l: Linea) => l.reservaId === "R-0520"), {
+      reservaId: "R-0520",
+      concepto: "Penalización",
+      importe: 1200,
+    });
+    // Ninguna reserva confirmada del mes se factura dos veces ni como reserva y penalización.
+    const dePenalizacion = facturas.flatMap((f: any) => f.lineas).filter((l: Linea) => l.concepto === "Penalización");
+    assert.deepEqual(dePenalizacion, [{ reservaId: "R-0520", concepto: "Penalización", importe: 1200 }]);
+
+    // R-0327 se canceló sin penalización: no aparece en ninguna factura.
+    const canceladaGratis = estado.reservas.find((r: any) => r.id === "R-0327");
+    assert.equal(canceladaGratis.estado, "cancelada");
+    assert.equal(canceladaGratis.penalizacion, undefined);
+    assert.ok(!facturas.some((f: any) => f.lineas.some((l: Linea) => l.reservaId === "R-0327")));
+
+    // Una no presentada sí se factura por su importe, como reserva.
+    const noPresentada = estado.reservas.find((r: any) => r.estado === "no_presentada" && r.inicio.startsWith("2026-11"));
+    const linea = facturas.flatMap((f: any) => f.lineas).find((l: Linea) => l.reservaId === noPresentada.id);
+    assert.deepEqual(linea, { reservaId: noPresentada.id, concepto: "Reserva", importe: noPresentada.importe });
+  } finally {
+    api.cerrar();
+  }
+});
