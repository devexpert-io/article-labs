+test("la numeración es correlativa en el año y sigue donde la dejó el mes anterior", async () => {
+  const api = await arrancarApi();
+  try {
+    const octubre = await generar(api, "2026-10");
+    assert.equal(octubre.status, 201);
+    assert.equal(octubre.cuerpo.facturas[0].numero, "F2026-0001");
+    assert.equal(octubre.cuerpo.facturas.at(-1).numero, "F2026-0040");
+
+    // En diciembre, noviembre ya ha terminado y se puede facturar.
+    assert.equal((await moverReloj(api, "2026-12-01T10:00")).status, 200);
+    const noviembre = await generar(api, "2026-11");
+    assert.equal(noviembre.status, 201);
+    assert.equal(noviembre.cuerpo.facturas[0].numero, "F2026-0041");
+    const total2026 = octubre.cuerpo.facturas.length + noviembre.cuerpo.facturas.length;
+    assert.deepEqual(
+      [...numeros(octubre.cuerpo.facturas), ...numeros(noviembre.cuerpo.facturas)],
+      Array.from({ length: total2026 }, (_, i) => i + 1),
+      "sin huecos ni repetidos",
+    );
+
+    // Volver a generar no cambia nada: mismas facturas, mismos números y 200.
+    const repetida = await generar(api, "2026-11");
+    assert.equal(repetida.status, 200);
+    assert.deepEqual(repetida.cuerpo.facturas, noviembre.cuerpo.facturas);
+
+    // Un mes sin nada que facturar no consume numeración.
+    assert.equal((await generar(api, "2026-12")).status, 409, "diciembre todavía no ha terminado");
+    assert.equal((await moverReloj(api, "2027-01-05T10:00")).status, 200);
+    const diciembre = await generar(api, "2026-12");
+    assert.equal(diciembre.status, 201);
+    assert.deepEqual(diciembre.cuerpo.facturas, []);
+    assert.equal((await generar(api, "2026-12")).status, 200);
+
+    // Un año nuevo empieza en 0001, aunque sea un mes que se genera después.
+    const nueva = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-12T10:30" },
+    });
+    assert.equal(nueva.status, 201);
+    assert.equal((await moverReloj(api, "2027-02-01T10:00")).status, 200);
+    const enero = await generar(api, "2027-01");
+    assert.equal(enero.status, 201);
+    assert.deepEqual(enero.cuerpo.facturas.map((f: any) => f.numero), ["F2027-0001"]);
+    assert.equal(enero.cuerpo.facturas[0].socioId, "socio-041");
+    assert.equal(enero.cuerpo.facturas[0].total, 1800);
+    assert.equal(enero.cuerpo.facturas[0].base, 1488);
+    assert.equal(enero.cuerpo.facturas[0].iva, 312);
+    assert.equal((await generar(api, "2027-01")).status, 200);
+
+    // Las facturas de 2026 siguen igual.
+    assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas, octubre.cuerpo.facturas);
+  } finally {
+    api.cerrar();
+  }
+});
