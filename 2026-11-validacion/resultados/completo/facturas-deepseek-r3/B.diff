+test("un mes que se genera después sigue la numeración del último mes generado del año", async () => {
+  const api = await arrancarApi({ AHORA: "2027-02-01T10:00" });
+  try {
+    // Se genera primero noviembre y luego octubre: octubre va detrás en la numeración.
+    const noviembre = await generar(api, "2026-11");
+    assert.equal(noviembre.status, 201);
+    const octubre = await generar(api, "2026-10");
+    assert.equal(octubre.status, 201);
+    const siguiente = noviembre.cuerpo.facturas.length + 1;
+    assert.equal(octubre.cuerpo.facturas[0].numero, `F2026-${String(siguiente).padStart(4, "0")}`);
+    const todos = numeros([...noviembre.cuerpo.facturas, ...octubre.cuerpo.facturas]);
+    assert.deepEqual(todos, Array.from({ length: todos.length }, (_, i) => i + 1));
+  } finally {
+    api.cerrar();
+  }
+});
