@@ -0,0 +1,305 @@
+// Las facturas mensuales, probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+function generar(api: Api, mes: string, socio = GESTOR) {
+  return api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio });
+}
+
+function moverReloj(api: Api, ahora: string) {
+  return api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+}
+
+interface Linea {
+  reservaId: string;
+  concepto: "Reserva" | "Penalización";
+  importe: number;
+}
+
+/** Las facturas que la spec dice que debe haber, calculadas desde el estado del club. */
+function facturasEsperadas(estado: any, mes: string) {
+  const porSocio = new Map<string, Linea[]>();
+  const reservas = estado.reservas
+    .filter((r: any) => r.inicio.slice(0, 7) === mes)
+    .sort((a: any, b: any) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+  for (const r of reservas) {
+    const linea: Linea | undefined =
+      r.estado === "confirmada" || r.estado === "no_presentada"
+        ? { reservaId: r.id, concepto: "Reserva", importe: r.importe }
+        : r.estado === "cancelada" && r.penalizacion !== undefined
+          ? { reservaId: r.id, concepto: "Penalización", importe: r.penalizacion }
+          : undefined;
+    if (!linea) continue;
+    const suyas = porSocio.get(r.socioId) ?? [];
+    suyas.push(linea);
+    porSocio.set(r.socioId, suyas);
+  }
+  return [...porSocio.keys()].sort().map((socioId, i) => {
+    const lineas = porSocio.get(socioId)!;
+    const total = lineas.reduce((suma, l) => suma + l.importe, 0);
+    // La base se redondea al céntimo más cercano, con el medio céntimo hacia arriba.
+    const base = Math.round(total / 1.21);
+    return {
+      numero: `F${mes.slice(0, 4)}-${String(i + 1).padStart(4, "0")}`,
+      mes,
+      socioId,
+      lineas,
+      total,
+      base,
+      iva: total - base,
+    };
+  });
+}
+
+function numeros(facturas: { numero: string }[]): number[] {
+  return facturas.map((f) => Number(f.numero.slice(6)));
+}
+
+test("solo un gestor puede generar y consultar facturas", async () => {
+  const api = await arrancarApi();
+  try {
+    const casos: [string, string, unknown][] = [
+      ["POST", "/api/facturas", { mes: "2026-10" }],
+      ["GET", "/api/facturas?mes=2026-10", undefined],
+      ["GET", "/api/facturas/F2026-0001", undefined],
+    ];
+    for (const [metodo, ruta, cuerpo] of casos) {
+      const sin = await api.pedir(metodo, ruta, { cuerpo });
+      assert.equal(sin.status, 401, `${metodo} ${ruta} sin X-Socio`);
+      assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+      const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-001" });
+      assert.equal(socio.status, 403, `${metodo} ${ruta} con un socio normal`);
+      assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+    }
+    // Con el gestor, los tres endpoints funcionan.
+    assert.equal((await generar(api, "2026-10")).status, 201);
+    assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).status, 200);
+    assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001", { socio: GESTOR })).status, 200);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("solo se facturan meses cerrados y con el formato AAAA-MM", async () => {
+  const api = await arrancarApi();
+  try {
+    for (const mes of ["2026-1", "2026-13", "octubre", "2026-10-01", ""]) {
+      const r = await generar(api, mes);
+      assert.equal(r.status, 400, `mes ${JSON.stringify(mes)}`);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    const sinMes = await api.pedir("POST", "/api/facturas", { cuerpo: {}, socio: GESTOR });
+    assert.equal(sinMes.status, 400);
+    assert.equal(sinMes.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    // El club está en noviembre de 2026: noviembre, diciembre y 2027 siguen abiertos.
+    for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+      const r = await generar(api, mes);
+      assert.equal(r.status, 409, mes);
+      assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+    }
+    // Cuando el club llega a diciembre, noviembre ya está cerrado; diciembre todavía no.
+    assert.equal((await moverReloj(api, "2026-12-01T10:00")).status, 200);
+    assert.equal((await generar(api, "2026-11")).status, 201);
+    assert.equal((await generar(api, "2026-12")).cuerpo.error.codigo, "MES_ABIERTO");
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("octubre de 2026: una factura por socio, con sus líneas y su IVA", async () => {
+  const api = await arrancarApi();
+  try {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const respuesta = await generar(api, "2026-10");
+    assert.equal(respuesta.status, 201);
+    const facturas = respuesta.cuerpo.facturas;
+
+    assert.equal(facturas.length, 40, "hay 40 socios con algo que facturar en octubre");
+    assert.deepEqual(facturas, facturasEsperadas(estado, "2026-10"));
+
+    // Las facturas van ordenadas por id de socio, de socio-001 a socio-040.
+    assert.deepEqual(facturas.map((f: any) => f.socioId), [...facturas.map((f: any) => f.socioId)].sort());
+    assert.equal(facturas.at(-1)!.socioId, "socio-040");
+    assert.ok(!facturas.some((f: any) => f.socioId === "socio-041"), "Nora Benítez no tiene nada que facturar");
+
+    // Importes conocidos y el IVA desglosado.
+    const primera = facturas[0];
+    assert.equal(primera.numero, "F2026-0001");
+    assert.equal(primera.mes, "2026-10");
+    assert.equal(primera.socioId, "socio-001");
+    assert.equal(primera.lineas.length, 3);
+    assert.equal(primera.total, 6800);
+    assert.equal(primera.base, 5620);
+    assert.equal(primera.iva, 1180);
+    assert.equal(facturas[1].total, 20400);
+    assert.equal(facturas[1].base, 16860);
+    assert.equal(facturas[1].iva, 3540);
+
+    for (const factura of facturas) {
+      assert.equal(factura.total, factura.lineas.reduce((suma: number, l: Linea) => suma + l.importe, 0));
+      assert.equal(factura.base + factura.iva, factura.total);
+      assert.equal(factura.base, Math.round(factura.total / 1.21));
+      for (const linea of factura.lineas) {
+        assert.ok(["Reserva", "Penalización"].includes(linea.concepto));
+        assert.equal(typeof linea.reservaId, "string");
+        assert.equal(typeof linea.importe, "number");
+      }
+    }
+
+    // Las líneas van ordenadas por el inicio de su reserva.
+    const inicios = new Map(estado.reservas.map((r: any) => [r.id, r.inicio]));
+    for (const factura of facturas) {
+      const orden = factura.lineas.map((l: Linea) => inicios.get(l.reservaId));
+      assert.deepEqual(orden, [...orden].sort(), `${factura.numero} debe ir ordenada por inicio`);
+    }
+  } finally {
+    api.cerrar();
+  }
+});
