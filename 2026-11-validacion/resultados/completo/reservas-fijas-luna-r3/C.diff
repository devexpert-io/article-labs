+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { arrancarApi } from "./ayuda.ts";
+
+test("series: permisos, semanas/DST, descuento, consulta y cancelación", async () => {
+  const api = await arrancarApi({ AHORA: "2027-03-20T10:00" });
+  try {
+    const datos = { socioId: "socio-001", pistaId: "pista-2", inicio: "2027-03-23T19:30", semanas: 8 };
+    assert.equal((await api.pedir("POST", "/api/series", { cuerpo: datos })).cuerpo.error.codigo, "NO_IDENTIFICADO");
+    assert.equal((await api.pedir("POST", "/api/series", { socio: "socio-001", cuerpo: datos })).cuerpo.error.codigo, "SIN_PERMISO");
+    const creada = await api.pedir("POST", "/api/series", { socio: "socio-040", cuerpo: datos });
+    assert.equal(creada.status, 201);
+    const s = creada.cuerpo.serie;
+    assert.equal(s.reservas.length, 8);
+    assert.ok(s.reservas.every((id: unknown) => typeof id === "string"));
+    const consulta = await api.pedir("GET", `/api/series/${s.id}`, { socio: "socio-040" });
+    const reservas = consulta.cuerpo.serie.reservas;
+    const fechas = reservas.map((r: any) => r.inicio);
+    assert.ok(fechas.includes("2027-03-30T19:30"));
+    assert.ok(fechas.every((f: string) => f.endsWith("T19:30")));
+    assert.ok(reservas.every((r: any) => r.serieId === s.id && r.importe === 2520));
+    assert.equal(reservas.length, 8);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-23T00:00" } });
+    const canc = await api.pedir("POST", `/api/series/${s.id}/cancelar`, { socio: "socio-040", cuerpo: {} });
+    assert.equal(canc.cuerpo.canceladas.length, 7);
+    assert.equal(canc.cuerpo.pendientes.length, 1);
+  } finally { api.cerrar(); }
+});
+
+test("series: fechas de calendario inválidas se rechazan sin mutar el estado", async () => {
+  const api = await arrancarApi();
+  try {
+    for (const inicio of ["2027-02-29T19:30", "2026-02-30T19:30", "2026-13-01T19:30", "2027-02-29T19:30"]) {
+      const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+      const r = await api.pedir("POST", "/api/series", { socio: "socio-040", cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio, semanas: 2 } });
+      assert.equal(r.status, 400);
+      assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA");
+      const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+      assert.equal(despues.series.length, antes.series.length);
+      assert.equal(despues.reservas.length, antes.reservas.length);
+      assert.equal(despues.contador, antes.contador);
+    }
+    const bisiesto = await api.pedir("POST", "/api/series", { socio: "socio-040", cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2028-02-29T19:30", semanas: 2 } });
+    assert.equal(bisiesto.status, 201);
+  } finally { api.cerrar(); }
