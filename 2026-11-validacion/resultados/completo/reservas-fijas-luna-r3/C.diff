+
+test("cancelación forzada penaliza las reservas dentro de 24 horas", async () => {
+  const api = await arrancarApi({ AHORA: "2026-11-25T20:00" });
+  try {
+    const r = await api.pedir("POST", "/api/series", { socio: "socio-040", cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-11-26T19:30", semanas: 2 } });
+    const c = await api.pedir("POST", `/api/series/${r.cuerpo.serie.id}/cancelar`, { socio: "socio-040", cuerpo: { forzar: true } });
