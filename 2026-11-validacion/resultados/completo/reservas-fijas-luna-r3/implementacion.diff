@@ -0,0 +1,38 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { arrancarApi } from "./ayuda.ts";
+
+test("series: permisos, semanas/DST, descuento, consulta y cancelación", async () => {
+  const api = await arrancarApi({ AHORA: "2027-03-20T10:00" });
+  try {
+    const datos = { socioId: "socio-001", pistaId: "pista-2", inicio: "2027-03-23T19:30", semanas: 8 };
+    assert.equal((await api.pedir("POST", "/api/series", { cuerpo: datos })).cuerpo.error.codigo, "NO_IDENTIFICADO");
+    assert.equal((await api.pedir("POST", "/api/series", { socio: "socio-001", cuerpo: datos })).cuerpo.error.codigo, "SIN_PERMISO");
+    const creada = await api.pedir("POST", "/api/series", { socio: "socio-040", cuerpo: datos });
+    assert.equal(creada.status, 201);
+    const s = creada.cuerpo.serie;
+    assert.equal(s.reservas.length, 8);
+    const fechas = s.reservas.map((r: any) => r.inicio);
+    assert.ok(fechas.includes("2027-03-30T19:30"));
+    assert.ok(fechas.every((f: string) => f.endsWith("T19:30")));
+    assert.ok(s.reservas.every((r: any) => r.serieId === s.id && r.importe === 2520));
+    assert.equal((await api.pedir("GET", `/api/series/${s.id}`, { socio: "socio-040" })).cuerpo.serie.reservas.length, 8);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-23T00:00" } });
+    const canc = await api.pedir("POST", `/api/series/${s.id}/cancelar`, { socio: "socio-040", cuerpo: {} });
+    assert.equal(canc.cuerpo.canceladas.length, 7);
+    assert.equal(canc.cuerpo.pendientes.length, 1);
+  } finally { api.cerrar(); }
+});
+
+test("series: semanas ocupadas se saltan y valida semanas y serie inexistente", async () => {
+  const api = await arrancarApi();
+  try {
+    const base = { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-19T19:30", semanas: 2 };
+    assert.equal((await api.pedir("POST", "/api/series", { socio: "socio-040", cuerpo: { ...base, semanas: 1 } })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const r = await api.pedir("POST", "/api/series", { socio: "socio-040", cuerpo: base });
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.serie.saltadas[0].codigo, "FRANJA_NO_DISPONIBLE");
+    assert.equal(r.cuerpo.serie.reservas.length, 1);
+    assert.equal((await api.pedir("GET", "/api/series/no-existe", { socio: "socio-040" })).cuerpo.error.codigo, "SERIE_NO_ENCONTRADA");
+  } finally { api.cerrar(); }
+});
