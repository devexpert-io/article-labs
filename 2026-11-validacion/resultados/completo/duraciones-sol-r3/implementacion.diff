+  for (let pagina = 1; ; pagina++) {
+    const r = (await api.pedir("GET", `/api/reservas?limite=100&pagina=${pagina}`)).cuerpo;
+    assert.ok(r.reservas.every((reserva: any) => reserva.duracion === 90 || reserva.id === nueva.id));
+    if (pagina === r.paginas) break;
+  }
+});
