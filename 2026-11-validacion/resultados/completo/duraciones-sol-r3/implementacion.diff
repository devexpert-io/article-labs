+test("disponibilidad marca solapes parciales y devuelve los huecos máximos del día", async (t) => {
+  const api = await iniciar(t);
+  const disponibilidad = async (fecha = "2026-12-01") => (await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`)).cuerpo.pistas;
+  const intervalo = (inicio: string, fin: string) => ({ inicio: `2026-12-01T${inicio}`, fin: `2026-12-01T${fin}` });
+  let pistas = await disponibilidad();
+  assert.deepEqual(pistas[0].huecos, [intervalo("09:00", "22:30")]);
+  assert.deepEqual(pistas[3].huecos, []);
+  assert.ok(pistas[3].franjas.every((f: any) => f.estado === "cerrada"));
+  const r = await crear(api, "2026-12-01T10:00", { duracion: 60 });
+  const contigua = await crear(api, "2026-12-01T11:00", { duracion: 120 });
+  const tarde = await crear(api, "2026-12-01T21:30", { duracion: 60 });
+  for (const reserva of [r, contigua, tarde]) assert.equal(reserva.status, 201);
+  pistas = await disponibilidad();
+  assert.deepEqual(pistas[0].huecos, [intervalo("09:00", "10:00"), intervalo("13:00", "21:30")]);
+  assert.deepEqual(pistas[0].franjas.map((f: any) => f.estado), ["reservada", "reservada", "reservada", "libre", "libre", "libre", "libre", "libre", "reservada"]);
+  assert.deepEqual(pistas[1].huecos, [intervalo("09:00", "22:30")]);
+  await cancelar(api, contigua.cuerpo.reserva.id);
+  pistas = await disponibilidad();
+  assert.deepEqual(pistas[0].huecos, [intervalo("09:00", "10:00"), intervalo("11:00", "21:30")]);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-02T10:00" } });
+  assert.deepEqual(await disponibilidad(), pistas, "el reloj no recorta los huecos");
+
+  // Contrasta los huecos y las franjas con reservas antiguas, incluidas las canceladas y no presentadas.
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const fecha = "2026-10-01";
+  for (const p of await disponibilidad(fecha)) {
+    if (p.estado === "cerrada") continue;
+    const confirmadas = estado.reservas.filter((r: any) => r.pistaId === p.pistaId && r.inicio.startsWith(fecha) && r.estado === "confirmada");
+    for (const franja of p.franjas) {
+      const ocupada = confirmadas.some((r: any) => r.inicio < franja.fin && franja.inicio < r.fin);
+      assert.equal(franja.estado, ocupada ? "reservada" : "libre");
+    }
+    // Cada minuto del horario pertenece a una reserva confirmada o a un único hueco.
+    for (let minuto = 9 * 60; minuto < 22 * 60 + 30; minuto++) {
+      const instante = `${fecha}T${String(Math.floor(minuto / 60)).padStart(2, "0")}:${String(minuto % 60).padStart(2, "0")}`;
+      const ocupada = confirmadas.some((r: any) => r.inicio <= instante && instante < r.fin);
+      assert.equal(p.huecos.filter((h: any) => h.inicio <= instante && instante < h.fin).length, ocupada ? 0 : 1);
+    }
+  }
+});
