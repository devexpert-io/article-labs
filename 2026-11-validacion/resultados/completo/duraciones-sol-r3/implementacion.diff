+++ b/test/duraciones.test.ts
@@ -0,0 +1,204 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { HORAS } from "../src/semilla.ts";
+
+async function iniciar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+function crear(api: Api, inicio: string, extras: Record<string, unknown> = {}) {
+  return api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio, ...extras },
+  });
+}
+
+function error(respuesta: any, status: number, codigo: string) {
+  assert.equal(respuesta.status, status);
+  assert.equal(respuesta.cuerpo.error.codigo, codigo);
+}
+
+async function cancelar(api: Api, id: string) {
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(r.status, 200);
+  return r.cuerpo.reserva;
+}
+
+test("duraciones válidas, valor por defecto y fin calculado", async (t) => {
+  const api = await iniciar(t);
+  for (const [duracion, hora, fin] of [[60, "09:00", "10:00"], [90, "10:00", "11:30"], [120, "20:30", "22:30"], [undefined, "12:30", "14:00"]] as const) {
+    const r = await crear(api, `2026-12-01T${hora}`, duracion === undefined ? {} : { duracion });
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.duracion, duracion ?? 90);
+    assert.equal(r.cuerpo.reserva.fin, `2026-12-01T${fin}`);
+    await cancelar(api, r.cuerpo.reserva.id);
+  }
+  for (const duracion of [null, "60", "90", true, false, 0, -60, 30, 61, 90.5, 180, [], {}]) {
+    error(await crear(api, "2026-12-01T09:00", { duracion }), 400, "DURACION_INVALIDA");
+  }
+});
+
+test("inicios en punto o y media, dentro del horario y con fin hasta las 22:30", async (t) => {
+  const api = await iniciar(t);
+  for (const inicio of ["08:30", "09:15", "10:45", "12:60", "22:00", "23:00", "99:00"]) {
+    error(await crear(api, `2026-12-01T${inicio}`, { duracion: 60 }), 400, "FRANJA_INVALIDA");
+  }
+  for (const inicio of ["2026-12-01", "2026-12-01T9:00", "2026-12-01T09:00:00"]) {
+    error(await crear(api, inicio), 400, "FRANJA_INVALIDA");
+  }
+  for (const [duracion, hora] of [[60, "21:30"], [90, "21:00"], [120, "20:30"]]) {
+    const r = await crear(api, `2026-12-01T${hora}`, { duracion });
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.fin, "2026-12-01T22:30");
+    await cancelar(api, r.cuerpo.reserva.id);
+    error(await crear(api, `2026-12-01T${duracion === 60 ? "22:00" : duracion === 90 ? "21:30" : "21:00"}`, { duracion }), 400, "FRANJA_INVALIDA");
+  }
+});
+
+test("solapes parciales, interiores y envolventes; extremos contiguos y canceladas libres", async (t) => {
+  const api = await iniciar(t);
+  const central = await crear(api, "2026-12-01T11:00", { duracion: 60 });
+  assert.equal(central.status, 201);
+  for (const [hora, duracion] of [["10:30", 60], ["11:30", 60], ["11:00", 60], ["10:30", 120]] as const) {
+    error(await crear(api, `2026-12-01T${hora}`, { duracion }), 409, "FRANJA_NO_DISPONIBLE");
+  }
+  const antes = await crear(api, "2026-12-01T09:00", { duracion: 120 });
+  const despues = await crear(api, "2026-12-01T12:00", { duracion: 90 });
+  assert.equal(antes.status, 201);
+  assert.equal(despues.status, 201);
+  await cancelar(api, central.cuerpo.reserva.id);
+  assert.equal((await crear(api, "2026-12-01T11:00", { duracion: 60 })).status, 201);
+
+  // Reserva de la semilla: pista 1, jueves 19, 19:30–21:00.
+  for (const hora of ["19:00", "20:00", "20:30"]) {
+    error(await crear(api, `2026-11-19T${hora}`, { duracion: 60 }), 409, "FRANJA_NO_DISPONIBLE");
+  }
+});
+
+test("precios por minutos, cruce de las 18:00, fin de semana y precios tradicionales", async (t) => {
+  const api = await iniciar(t);
+  const casos: [string, number, number, string?][] = [
+    ["2026-12-01T17:30", 90, 2467],
+    ["2026-12-01T17:30", 60, 1533],
+    ["2026-12-01T17:00", 120, 3067],
+    ["2026-12-01T09:30", 60, 1200],
+    ["2026-12-01T18:00", 120, 3733],
+    ["2026-12-05T09:00", 60, 1867],
+    ["2026-12-06T17:30", 120, 3733],
+    ["2026-12-01T17:30", 90, 1733, "pista-3"],
+  ];
+  for (const [inicio, duracion, importe, pistaId = "pista-1"] of casos) {
+    const r = await crear(api, inicio, { duracion, pistaId });
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.importe, importe, inicio);
+    await cancelar(api, r.cuerpo.reserva.id);
+  }
+  for (const pistaId of ["pista-1", "pista-3"]) {
+    for (const fecha of ["2026-12-01", "2026-12-05", "2026-12-06"]) {
+      for (const hora of HORAS) {
+        const r = await crear(api, `${fecha}T${hora}`, { pistaId });
+        assert.equal(r.status, 201);
+        const punta = fecha !== "2026-12-01" || hora >= "18:00";
+        assert.equal(r.cuerpo.reserva.importe, pistaId === "pista-1" ? (punta ? 2800 : 1800) : (punta ? 2000 : 1200));
+        await cancelar(api, r.cuerpo.reserva.id);
+      }
+    }
+  }
+});
+
+test("las reservas antiguas y nuevas devuelven duración en todas las respuestas", async (t) => {
+  const api = await iniciar(t);
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.ok(estado.reservas.length > 0);
+  assert.ok(estado.reservas.every((r: any) => r.duracion === 90));
+  const antigua = estado.reservas.find((r: any) => r.socioId === "socio-004" && r.inicio > estado.ahora);
+  const detalle = await api.pedir("GET", `/api/reservas/${antigua.id}`);
+  assert.equal(detalle.cuerpo.reserva.duracion, 90);
+  assert.equal((await cancelar(api, antigua.id)).duracion, 90);
+  const nueva = (await crear(api, "2026-12-01T09:30", { duracion: 120 })).cuerpo.reserva;
+  assert.equal((await api.pedir("GET", `/api/reservas/${nueva.id}`)).cuerpo.reserva.duracion, 120);
+  const lista = (await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.reservas;
+  assert.equal(lista[0].duracion, 120);
