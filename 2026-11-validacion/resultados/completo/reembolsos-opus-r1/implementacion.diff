+test("límites exactos: a 48 horas justas no hay penalización; a 24 justas, 25 % sin forzar", async () => {
+  const a48 = await reservar("pista-1", "2026-11-30T12:00");
+  const justo48 = await cancelar(a48.id, "2026-11-28T12:00");
