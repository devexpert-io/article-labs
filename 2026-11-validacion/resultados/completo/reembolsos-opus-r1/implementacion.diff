+// Penalizaciones escalonadas, exención por un gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const GESTOR = "socio-040";
+const MOTIVO = "Lesión justificada con parte médico";
+
+async function reloj(ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+let siguienteSocio = 1;
+/** Crea una reserva con un socio distinto cada vez (con la cuota al día) para no chocar con el límite. */
+async function reservar(pistaId: string, inicio: string, ahora = "2026-11-25T00:00"): Promise<{ id: string; importe: number }> {
+  await reloj(ahora);
+  let socioId: string;
+  do {
+    socioId = `socio-${String(siguienteSocio++).padStart(3, "0")}`;
+  } while (["socio-002", "socio-004", "socio-005", "socio-011", "socio-022", "socio-033"].includes(socioId));
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+}
+
+async function cancelar(id: string, ahora: string, cuerpo: Record<string, unknown> = {}, socio?: string) {
+  await reloj(ahora);
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+test("tramos: sin penalización con 48 horas o más, 25 % entre 24 y 48, 50 % con menos de 24 y forzar", async () => {
+  const lejos = await reservar("pista-2", "2026-11-30T12:00");
+  const r1 = await cancelar(lejos.id, "2026-11-27T12:00");
+  assert.equal(r1.status, 200);
+  assert.equal(r1.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r1.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r1.cuerpo.reembolso, 1800);
+
+  const media = await reservar("pista-2", "2026-11-30T13:30");
+  const r2 = await cancelar(media.id, "2026-11-29T00:00");
+  assert.equal(r2.status, 200);
+  assert.equal(r2.cuerpo.reserva.penalizacion, 450);
+  assert.equal(r2.cuerpo.reembolso, 1350);
+
+  const cerca = await reservar("pista-2", "2026-11-30T15:00");
+  const sinForzar = await cancelar(cerca.id, "2026-11-30T10:00");
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  assert.equal((await api.pedir("GET", `/api/reservas/${cerca.id}`)).cuerpo.reserva.estado, "confirmada");
+  const forzada = await cancelar(cerca.id, "2026-11-30T10:00", { forzar: true });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+  assert.equal(forzada.cuerpo.reembolso, 900);
+});
