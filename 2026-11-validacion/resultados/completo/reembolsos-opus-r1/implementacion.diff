+test("informe de caja: reservas, ingresos y penalizaciones por pista y del club", async () => {
+  // Un mes sin movimientos: todas las pistas, a cero.
+  const vacio = await api.pedir("GET", "/api/informes/caja?mes=2028-01", { socio: GESTOR });
+  assert.equal(vacio.status, 200);
+  const cero = { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 };
+  assert.deepEqual(vacio.cuerpo, {
+    mes: "2028-01",
+    pistas: ["pista-1", "pista-2", "pista-3", "pista-4"].map((pistaId) => ({ pistaId, ...cero })),
+    total: cero,
+  });
+
+  // Enero de 2028: una confirmada, una cancelada con penalización y otra gratis.
+  const confirmada = await reservar("pista-1", "2028-01-10T18:00", "2028-01-01T10:00"); // 2800
+  const penalizada = await reservar("pista-3", "2028-01-10T12:00", "2028-01-01T10:00"); // 1200
+  const gratis = await reservar("pista-2", "2028-01-20T12:00", "2028-01-01T10:00");
+  await cancelar(penalizada.id, "2028-01-09T12:00"); // 25 %: 300
+  await cancelar(gratis.id, "2028-01-01T12:00");
+  const enero = (await api.pedir("GET", "/api/informes/caja?mes=2028-01", { socio: GESTOR })).cuerpo;
+  assert.deepEqual(enero.pistas, [
+    { pistaId: "pista-1", reservas: 1, ingresos: confirmada.importe, penalizaciones: 0, total: 2800 },
+    { pistaId: "pista-2", ...cero },
+    { pistaId: "pista-3", reservas: 0, ingresos: 0, penalizaciones: 300, total: 300 },
+    { pistaId: "pista-4", ...cero },
+  ]);
+  assert.deepEqual(enero.total, { reservas: 1, ingresos: 2800, penalizaciones: 300, total: 3100 });
+
+  // Octubre de 2026, de la semilla: cuenta confirmadas y no presentadas.
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const octubre = (await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR })).cuerpo;
+  assert.equal(octubre.mes, "2026-10");
+  assert.equal(octubre.pistas.length, 4);
+  for (const fila of octubre.pistas) {
+    const cobradas = estado.reservas.filter((r: any) =>
+      r.pistaId === fila.pistaId && r.inicio.startsWith("2026-10") && (r.estado === "confirmada" || r.estado === "no_presentada"));
+    assert.equal(fila.reservas, cobradas.length);
+    assert.equal(fila.ingresos, cobradas.reduce((s: number, r: any) => s + r.importe, 0));
+    assert.equal(fila.penalizaciones, 0);
+    assert.equal(fila.total, fila.ingresos);
+  }
+  const suma = (campo: string) => octubre.pistas.reduce((s: number, p: any) => s + p[campo], 0);
+  assert.deepEqual(octubre.total, { reservas: suma("reservas"), ingresos: suma("ingresos"), penalizaciones: 0, total: suma("total") });
+  assert.ok(octubre.total.reservas > 0);
+  assert.ok(estado.reservas.some((r: any) => r.inicio.startsWith("2026-10") && r.estado === "no_presentada"));
+});
