+
+test("exención: un gestor cancela sin penalización y con motivo en cualquier momento antes del inicio", async () => {
+  const r = await reservar("pista-3", "2026-12-01T12:00");
+  const ahora = "2026-12-01T11:00";
+
+  const anonimo = await cancelar(r.id, ahora, { exento: true, motivo: MOTIVO });
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
