+test("cancelación gratuita a las 24 horas y pendientes que se pueden forzar", async (t) => {
+  const api = await iniciar(t);
+  const serie = await crear(api, { semanas: 3 });
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T10:00" } });
+  const ruta = `/api/series/${serie.id}/cancelar`;
+  error(await api.pedir("POST", ruta, { socio: gestor, cuerpo: { forzar: "true" } }), 400, "DATOS_INVALIDOS");
+  const parcial = await api.pedir("POST", ruta, { socio: gestor });
+  assert.equal(parcial.status, 200);
+  assert.deepEqual(parcial.cuerpo.canceladas.map((r: Reserva) => r.id), serie.reservas.slice(1));
+  assert.deepEqual(parcial.cuerpo.pendientes.map((r: Reserva) => r.id), serie.reservas.slice(0, 1));
+  assert.ok(parcial.cuerpo.canceladas.every((r: Reserva) => r.estado === "cancelada" && !r.penalizacion));
+  assert.equal(parcial.cuerpo.pendientes[0].estado, "confirmada");
+  const forzada = await api.pedir("POST", ruta, { socio: gestor, cuerpo: { forzar: true } });
+  assert.equal(forzada.cuerpo.canceladas[0].penalizacion, 2800);
+  assert.deepEqual(forzada.cuerpo.pendientes, []);
+  const repetida = await api.pedir("POST", ruta, { socio: gestor, cuerpo: { forzar: true } });
+  assert.deepEqual(repetida.cuerpo.canceladas, []);
+  assert.deepEqual(repetida.cuerpo.pendientes, []);
+  const otra = await crear(api, { inicio: "2026-12-02T10:30" });
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T10:30" } });
+  const limite = await api.pedir("POST", `/api/series/${otra.id}/cancelar`, { socio: gestor, cuerpo: { forzar: true } });
+  assert.equal(limite.cuerpo.canceladas.length, 2);
+  assert.ok(limite.cuerpo.canceladas.every((r: Reserva) => r.penalizacion === undefined));
+});
+
+const cambiosDeHora = [
+  { nombre: "primavera", ahora: "2027-03-27T19:00", inicio: "2027-03-28T19:30", fueraDePlazo: true },
+  { nombre: "otoño", ahora: "2027-10-30T20:00", inicio: "2027-10-31T19:30", fueraDePlazo: false },
+];
+
+for (const { nombre, ahora, inicio, fueraDePlazo } of cambiosDeHora) {
+  for (const forzar of [false, true]) {
+    test(`cancelar serie en ${nombre}, forzar=${forzar}, cuenta las horas reales de Madrid`, async (t) => {
+      const api = await iniciar(t);
+      const serie = await crear(api, { pistaId: "pista-3", inicio });
+      assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+      const resultado = await api.pedir("POST", `/api/series/${serie.id}/cancelar`, {
+        socio: gestor, cuerpo: { forzar },
+      });
+      assert.equal(resultado.status, 200, resultado.texto);
+      const pendiente = fueraDePlazo && !forzar;
+      assert.deepEqual(resultado.cuerpo.pendientes.map((r: Reserva) => r.id), pendiente ? [serie.reservas[0]] : []);
+      assert.deepEqual(resultado.cuerpo.canceladas.map((r: Reserva) => r.id), serie.reservas.slice(pendiente ? 1 : 0));
+      const consulta = await api.pedir("GET", `/api/series/${serie.id}`, { socio: gestor });
+      const [primera, segunda] = consulta.cuerpo.serie.reservas as Reserva[];
+      assert.equal(primera!.importe, 2000);
+      assert.equal(primera!.estado, pendiente ? "confirmada" : "cancelada");
+      assert.equal(primera!.penalizacion, fueraDePlazo && forzar ? primera!.importe : undefined);
+      assert.equal(segunda!.estado, "cancelada");
+      assert.equal(segunda!.penalizacion, undefined);
+    });
+  }
+
+  test(`cancelación individual en ${nombre}: corrige series y conserva reservas normales`, async (t) => {
+    const api = await iniciar(t);
+    const serie = await crear(api, { pistaId: "pista-3", inicio });
+    const normal = await api.pedir("POST", "/api/reservas", { cuerpo: { ...datos, inicio } });
+    assert.equal(normal.status, 201, normal.texto);
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+    for (const [id, penalizada] of [[serie.reservas[0], fueraDePlazo], [normal.cuerpo.reserva.id, !fueraDePlazo]] as const) {
+      const ruta = `/api/reservas/${id}/cancelar`;
+      const resultado = await api.pedir("POST", ruta);
+      if (penalizada) {
+        error(resultado, 409, "FUERA_DE_PLAZO");
+        const forzada = await api.pedir("POST", ruta, { cuerpo: { forzar: true } });
+        assert.equal(forzada.status, 200, forzada.texto);
+        assert.equal(forzada.cuerpo.reserva.estado, "cancelada");
+        assert.equal(forzada.cuerpo.reserva.penalizacion, forzada.cuerpo.reserva.importe);
+      } else {
+        assert.equal(resultado.status, 200, resultado.texto);
+        assert.equal(resultado.cuerpo.reserva.estado, "cancelada");
+        assert.equal(resultado.cuerpo.reserva.penalizacion, undefined);
+      }
+    }
+  });
+}
