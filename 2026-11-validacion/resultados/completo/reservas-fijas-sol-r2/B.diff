+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import type { Reserva } from "../src/tipos.ts";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+
+const datos = { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T19:30", semanas: 2 };
+const gestor = "socio-040";
+
+async function iniciar(t: TestContext): Promise<Api> {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status, r.texto);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+async function crear(api: Api, cambios: Record<string, unknown> = {}) {
+  const r = await api.pedir("POST", "/api/series", { socio: gestor, cuerpo: { ...datos, ...cambios } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.serie;
+}
+
+test("solo el gestor puede crear, consultar y cancelar series", async (t) => {
+  const api = await iniciar(t);
+  const serie = await crear(api);
+  for (const [metodo, ruta] of [
+    ["POST", "/api/series"], ["GET", `/api/series/${serie.id}`], ["POST", `/api/series/${serie.id}/cancelar`],
+  ]) {
+    for (const socio of [undefined, "socio-999", "socio-041"]) {
+      error(await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? datos : undefined }),
+        socio === "socio-041" ? 403 : 401, socio === "socio-041" ? "SIN_PERMISO" : "NO_IDENTIFICADO");
+    }
+  }
+  const consultada = await api.pedir("GET", `/api/series/${serie.id}`, { socio: gestor });
+  assert.equal(consultada.status, 200);
+  assert.ok(consultada.cuerpo.serie.reservas.every((r: Reserva) => r.estado === "confirmada"));
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.series.length, 1);
+});
+
+test("valida datos y reglas antes de crear reservas o consumir ids", async (t) => {
+  const api = await iniciar(t);
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+  const casos: [Record<string, unknown>, number, string][] = [
+    ...[undefined, null, "2", 1, 13, 2.5, true].map((semanas): [Record<string, unknown>, number, string] =>
+      [{ semanas }, 400, "DATOS_INVALIDOS"]),
+    [{ socioId: undefined }, 400, "DATOS_INVALIDOS"],
+    [{ pistaId: undefined }, 400, "DATOS_INVALIDOS"],
+    [{ inicio: undefined }, 400, "DATOS_INVALIDOS"],
+    [{ socioId: "no-existe" }, 404, "SOCIO_NO_ENCONTRADO"],
+    [{ pistaId: "no-existe" }, 404, "PISTA_NO_ENCONTRADA"],
+    ...["mal", "2026-12-01T19:00", "2026-02-30T19:30", "2026-13-01T19:30"].map((inicio): [Record<string, unknown>, number, string] =>
+      [{ inicio }, 400, "FRANJA_INVALIDA"]),
+    [{ inicio: "2026-11-18T09:00" }, 409, "FRANJA_PASADA"],
+    [{ socioId: "socio-011" }, 409, "CUOTA_INACTIVA"],
+    [{ pistaId: "pista-4" }, 409, "PISTA_CERRADA"],
