+const horarioMadrid = new Intl.DateTimeFormat("en-GB", {
+  timeZone: "Europe/Madrid", timeZoneName: "longOffset",
+});
+
+function instanteMadrid(fecha: string): number {
+  const local = Date.parse(`${fecha}:00Z`);
+  let instante = local;
+  // Recalcular el desplazamiento tras ajustar el instante, por si cruza el cambio de hora.
+  for (let paso = 0; paso < 2; paso++) {
+    const zona = horarioMadrid.formatToParts(instante).find((p) => p.type === "timeZoneName")!.value;
+    const [, signo, horas, minutos] = /^GMT([+-])(\d{2}):(\d{2})$/.exec(zona)!;
+    const desplazamiento = (Number(horas) * 60 + Number(minutos)) * (signo === "+" ? 1 : -1);
+    instante = local - desplazamiento * 60_000;
+  }
+  return instante;
+}
+
+function horasHastaReserva(ahora: string, reserva: Reserva): number {
+  // Las reservas normales conservan su cálculo anterior.
+  return reserva.serieId
+    ? (instanteMadrid(reserva.inicio) - instanteMadrid(ahora)) / 3_600_000
+    : horasEntre(ahora, reserva.inicio);
+}
