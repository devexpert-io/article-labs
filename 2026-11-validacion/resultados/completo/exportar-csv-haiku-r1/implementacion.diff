+// Exportación de reservas a CSV (docs/specs/exportar-csv.md), probada a través de la API.
+// Las reservas de las pruebas caen en enero de 2027, fuera de la semilla.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-003";
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+const RUTA = "/api/reservas/exportar";
+
+let api: Api;
+let nombres: Record<string, { nombre: string; email: string }> = {};
+const ids: Record<string, string> = {};
+
+async function crear(clave: string, socioId: string, pistaId: string, inicio: string, notas?: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio, ...(notas !== undefined ? { notas } : {}) } });
+  assert.equal(r.status, 201, `no se pudo crear ${clave}: ${r.texto}`);
+  ids[clave] = r.cuerpo.reserva.id;
+}
+
+/** Línea CSV de una reserva de la semilla de la prueba, con sus datos de socio. */
+function fila(...campos: string[]) {
+  return campos.join(",");
+}
+
+before(async () => {
+  api = await arrancarApi();
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  nombres = Object.fromEntries(estado.socios.map((s: { id: string; nombre: string; email: string }) => [s.id, { nombre: s.nombre, email: s.email }]));
+
+  // B y C empiezan a las 09:00 (B en pista 1, C en pista 3). A es de tarde y tiene notas difíciles.
+  await crear("B", "socio-004", "pista-1", "2027-01-11T09:00");
+  await crear("C", "socio-005", "pista-3", "2027-01-11T09:00");
+  await crear("A", SOCIO, "pista-2", "2027-01-11T18:00", 'Pagan en "efectivo", y piden factura\nprobar');
+  await crear("F", "socio-007", "pista-2", "2027-01-12T12:00");
+  await crear("D", "socio-006", "pista-1", "2027-01-13T10:30");
+  await crear("E", "socio-008", "pista-1", "2027-01-14T09:00"); // fuera del periodo de las pruebas
+
+  // D se cancela sin penalización (con más de 24 horas de margen).
+  await api.pedir("POST", `/api/reservas/${ids.D}/cancelar`);
+  // F se cancela con forzar y penalización: hay que mover el reloj a menos de 24 horas.
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-12T09:00" } })).status, 200);
+  const penalizada = await api.pedir("POST", `/api/reservas/${ids.F}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(penalizada.cuerpo.reserva.penalizacion, 1800);
+});
+after(() => api.cerrar());
+
+test("permisos: sin X-Socio, 401; con un socio que no es gestor, 403; con el gestor, 200", async () => {
+  const anonimo = await api.pedir("GET", `${RUTA}?desde=2027-01-11&hasta=2027-01-13`);
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const desconocido = await api.pedir("GET", `${RUTA}?desde=2027-01-11&hasta=2027-01-13`, { socio: "socio-999" });
+  assert.equal(desconocido.status, 401);
+  assert.equal(desconocido.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const socio = await api.pedir("GET", `${RUTA}?desde=2027-01-11&hasta=2027-01-13`, { socio: SOCIO });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const gestor = await api.pedir("GET", `${RUTA}?desde=2027-01-11&hasta=2027-01-13`, { socio: GESTOR });
+  assert.equal(gestor.status, 200);
+});
+
+test("respuesta: CSV con content-type y content-disposition, y el periodo en el nombre", async () => {
+  const r = await api.pedir("GET", `${RUTA}?desde=2027-01-11&hasta=2027-01-13`, { socio: GESTOR });
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2027-01-11-2027-01-13.csv"');
+  assert.equal(typeof r.cuerpo, "string", "el cuerpo es texto CSV, no JSON");
+});
+
+test("cabecera exacta como primera línea", async () => {
+  const r = await api.pedir("GET", `${RUTA}?desde=2027-01-10&hasta=2027-01-10`, { socio: GESTOR });
+  assert.equal(r.texto, `${CABECERA}\r\n`);
+});
+
+test("filas: ambos días incluidos, ordenadas por inicio y pista, con los datos del socio y la pista", async () => {
+  const r = await api.pedir("GET", `${RUTA}?desde=2027-01-11&hasta=2027-01-13`, { socio: GESTOR });
+  const esperado = [
+    CABECERA,
+    fila(ids.B, "2027-01-11", "09:00", "Pista 1", nombres["socio-004"]!.nombre, nombres["socio-004"]!.email, "confirmada", "18.00", "", ""),
+    fila(ids.C, "2027-01-11", "09:00", "Pista 3", nombres["socio-005"]!.nombre, nombres["socio-005"]!.email, "confirmada", "12.00", "", ""),
+    `${ids.A},2027-01-11,18:00,Pista 2,${nombres[SOCIO]!.nombre},${nombres[SOCIO]!.email},confirmada,28.00,,"Pagan en ""efectivo"", y piden factura\nprobar"`,
+    fila(ids.F, "2027-01-12", "12:00", "Pista 2", nombres["socio-007"]!.nombre, nombres["socio-007"]!.email, "cancelada", "18.00", "18.00", ""),
+    fila(ids.D, "2027-01-13", "10:30", "Pista 1", nombres["socio-006"]!.nombre, nombres["socio-006"]!.email, "cancelada", "18.00", "", ""),
+  ];
+  assert.equal(r.texto, esperado.map((l) => `${l}\r\n`).join(""));
+});
+
+test("el día de hasta incluido y el de desde incluido; la reserva del día siguiente queda fuera", async () => {
+  const soloUno = await api.pedir("GET", `${RUTA}?desde=2027-01-11&hasta=2027-01-11`, { socio: GESTOR });
+  assert.equal(soloUno.texto.split("\r\n").filter(Boolean).length, 4, "cabecera + B, C y A");
+  assert.ok(!soloUno.texto.includes(ids.E), "E es del día 14");
+  const sinReservas = await api.pedir("GET", `${RUTA}?desde=2027-01-10&hasta=2027-01-10`, { socio: GESTOR });
+  assert.equal(sinReservas.texto, `${CABECERA}\r\n`);
+});
+
+test("importes en euros con dos decimales; penalización vacía si no hay", async () => {
+  const r = await api.pedir("GET", `${RUTA}?desde=2027-01-12&hasta=2027-01-12`, { socio: GESTOR });
+  assert.equal(r.texto, `${CABECERA}\r\n${ids.F},2027-01-12,12:00,Pista 2,${nombres["socio-007"]!.nombre},${nombres["socio-007"]!.email},cancelada,18.00,18.00,\r\n`);
+  const sinPenalizacion = await api.pedir("GET", `${RUTA}?desde=2027-01-13&hasta=2027-01-13`, { socio: GESTOR });
+  assert.ok(sinPenalizacion.texto.includes(`,cancelada,18.00,,\r\n`));
+});
+
+test("escapado RFC 4180: comas, comillas y saltos de línea van entre comillas, y las comillas se duplican", async () => {
+  const r = await api.pedir("GET", `${RUTA}?desde=2027-01-11&hasta=2027-01-11&estado=confirmada`, { socio: GESTOR });
+  assert.ok(r.texto.includes(',"Pagan en ""efectivo"", y piden factura\nprobar"\r\n'));
+  // Los campos sin comas, comillas ni saltos no llevan comillas.
+  const lineaB = r.texto.split("\r\n")[1]!;
+  assert.ok(!lineaB.includes('"'));
+});
+
+test("fin de línea: CRLF en cada línea, también en la cabecera y la última", async () => {
+  const r = await api.pedir("GET", `${RUTA}?desde=2027-01-12&hasta=2027-01-13`, { socio: GESTOR });
+  assert.ok(r.texto.endsWith("\r\n"));
+  assert.equal(r.texto.split("\r\n").length, 4, "cabecera + F + D y el hueco final");
+  assert.ok(!/(^|[^\r])\n/.test(r.texto), "ningún \\n sin \\r delante");
+});
+
+test("filtro por estado: confirmada, cancelada y no_presentada", async () => {
+  const confirmadas = await api.pedir("GET", `${RUTA}?desde=2027-01-11&hasta=2027-01-13&estado=confirmada`, { socio: GESTOR });
+  assert.equal(confirmadas.status, 200);
+  assert.equal(confirmadas.texto.split("\r\n").filter(Boolean).length, 4, "cabecera + B, C y A");
+  const canceladas = await api.pedir("GET", `${RUTA}?desde=2027-01-11&hasta=2027-01-13&estado=cancelada`, { socio: GESTOR });
+  assert.ok(canceladas.texto.includes(ids.F) && canceladas.texto.includes(ids.D));
+  assert.ok(!canceladas.texto.includes(ids.B));
+  const noPresentadas = await api.pedir("GET", `${RUTA}?desde=2027-01-11&hasta=2027-01-13&estado=no_presentada`, { socio: GESTOR });
