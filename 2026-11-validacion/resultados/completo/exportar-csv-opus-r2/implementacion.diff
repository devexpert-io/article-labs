+++ b/test/exportar.test.ts
@@ -0,0 +1,139 @@
+// Exportar reservas a CSV (docs/specs/exportar-csv.md), probado a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+/** Exporta como gestor salvo que se indique otro socio; con null, sin cabecera X-Socio. */
+const exportar = (consulta: string, socio: string | null = GESTOR) =>
+  api.pedir("GET", `/api/reservas/exportar?${consulta}`, { socio: socio ?? undefined });
+
+/** Las líneas del CSV, sin el CRLF final de cada una. */
+function lineas(texto: string): string[] {
+  assert.ok(texto.endsWith("\r\n"), "la última línea termina en CRLF");
+  return texto.slice(0, -2).split("\r\n");
+}
+
+test("solo exporta un gestor", async () => {
+  const sinSocio = await exportar("desde=2026-11-19&hasta=2026-11-19", null);
+  assert.equal(sinSocio.status, 401);
+  assert.equal(sinSocio.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await exportar("desde=2026-11-19&hasta=2026-11-19", "socio-004");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const desconocido = await exportar("desde=2026-11-19&hasta=2026-11-19", "socio-999");
+  assert.equal(desconocido.status, 401);
+  assert.equal(desconocido.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  assert.equal((await exportar("desde=2026-11-19&hasta=2026-11-19")).status, 200);
+});
+
+test("responde 200 con CSV, como adjunto con el periodo en el nombre", async () => {
+  const r = await exportar("desde=2026-11-01&hasta=2026-11-30");
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-11-01-2026-11-30.csv"');
+});
+
+test("la primera línea es la cabecera exacta y todas las líneas acaban en CRLF", async () => {
+  const r = await exportar("desde=2026-11-19&hasta=2026-11-19");
+  assert.ok(r.texto.startsWith(`${CABECERA}\r\n`));
+  const sinCrlf = r.texto.replaceAll("\r\n", "");
+  assert.ok(!sinCrlf.includes("\n") && !sinCrlf.includes("\r"), "no hay saltos de línea sueltos");
+  const vacio = await exportar("desde=2027-06-01&hasta=2027-06-01");
+  assert.equal(vacio.texto, `${CABECERA}\r\n`);
+});
+
+test("una fila por reserva del periodo, ordenadas por inicio y por pista, con sus columnas", async () => {
+  const r = await exportar("desde=2026-11-19&hasta=2026-11-19");
+  const [, ...filas] = lineas(r.texto);
+  assert.deepEqual(filas.map((f) => f.split(",")[0]), ["R-0520", "R-0524", "R-0525", "R-0488", "R-0523", "R-0489", "R-0515"]);
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const reserva = estado.reservas.find((x: any) => x.id === "R-0523");
+  const socio = estado.socios.find((s: any) => s.id === reserva.socioId);
+  assert.equal(filas[4], `R-0523,2026-11-19,18:00,Pista 1,${socio.nombre},${socio.email},confirmada,28.00,,${reserva.notas}`);
+
+  // Ambos extremos incluidos, en cualquier estado: las mismas que GET /api/reservas.
+  const csv = lineas((await exportar("desde=2026-10-01&hasta=2026-10-31")).texto).slice(1);
+  assert.equal(csv.length, 315);
+  const listado = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=100&pagina=1");
+  assert.equal(listado.cuerpo.total, 315);
+  const inicios = csv.map((f) => f.split(",").slice(1, 3).join("T"));
+  assert.deepEqual(inicios, [...inicios].sort());
+  assert.ok(inicios[0]!.startsWith("2026-10-01") && inicios.at(-1)!.startsWith("2026-10-31"));
+});
+
+test("importes en euros con dos decimales y penalización vacía si no la hay", async () => {
+  const nueva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-005", pistaId: "pista-3", inicio: "2026-11-18T19:30" } });
+  assert.equal(nueva.status, 201);
+  const id = nueva.cuerpo.reserva.id;
+  await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { forzar: true } });
+  const filas = lineas((await exportar("desde=2026-11-18&hasta=2026-11-18")).texto);
+  const fila = filas.find((f) => f.startsWith(`${id},`))!.split(",");
+  assert.deepEqual(fila.slice(6, 9), ["cancelada", "20.00", "20.00"]);
+  const otra = filas.find((f) => f.includes(",confirmada,"))!.split(",");
+  assert.match(otra[7]!, /^\d+\.\d{2}$/);
+  assert.equal(otra[8], "");
+});
+
+test("escapa las notas con comas, comillas y saltos de línea según el RFC 4180", async () => {
+  const notas = ["Con coma, sí", 'Dice "hola"', "Dos\nlíneas", "Sin nada raro"];
+  const ids: string[] = [];
+  for (const [i, nota] of notas.entries()) {
+    const socioId = ["socio-002", "socio-003", "socio-006", "socio-007"][i]!;
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-2", inicio: `2026-12-0${i + 1}T12:00`, notas: nota } });
+    assert.equal(r.status, 201);
+    ids.push(r.cuerpo.reserva.id);
+  }
+  const texto = (await exportar("desde=2026-12-01&hasta=2026-12-04")).texto;
+  assert.ok(texto.includes(',"Con coma, sí"\r\n'));
+  assert.ok(texto.includes(',"Dice ""hola"""\r\n'));
+  assert.ok(texto.includes(',"Dos\nlíneas"\r\n'));
+  assert.ok(texto.includes(",Sin nada raro\r\n"));
+  assert.ok(texto.includes(`${ids[0]},2026-12-01,12:00,Pista 2,`), "los demás campos van sin comillas");
+});
+
+test("desde y hasta son obligatorios, válidos y ordenados; como mucho 92 días", async () => {
+  for (const consulta of ["hasta=2026-11-30", "desde=2026-11-01", "", "desde=2026-11-1&hasta=2026-11-30",
+    "desde=2026-11-01&hasta=30-11-2026", "desde=2026-02-30&hasta=2026-03-01", "desde=2026-11-30&hasta=2026-11-01"]) {
+    const r = await exportar(consulta);
+    assert.equal(r.status, 400, consulta);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", consulta);
+  }
+  // Del 1 de octubre al 31 de diciembre son 92 días; uno más ya no vale.
+  assert.equal((await exportar("desde=2026-10-01&hasta=2026-12-31")).status, 200);
+  const grande = await exportar("desde=2026-10-01&hasta=2027-01-01");
+  assert.equal(grande.status, 400);
+  assert.equal(grande.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+});
+
+test("filtra por estado y rechaza estados desconocidos", async () => {
+  const todas = lineas((await exportar("desde=2026-10-01&hasta=2026-11-30")).texto).slice(1);
+  for (const estado of ["confirmada", "cancelada", "no_presentada"]) {
+    const filas = lineas((await exportar(`desde=2026-10-01&hasta=2026-11-30&estado=${estado}`)).texto).slice(1);
+    assert.ok(filas.length > 0, estado);
+    assert.ok(filas.every((f) => f.split(",")[6] === estado), estado);
+    assert.equal(filas.length, todas.filter((f) => f.split(",")[6] === estado).length, estado);
+  }
+  const mal = await exportar("desde=2026-10-01&hasta=2026-11-30&estado=pagada");
+  assert.equal(mal.status, 400);
+  assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+});
+
+test("GET /api/reservas no cambia", async () => {
+  const r = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=2", { socio: GESTOR });
+  assert.equal(r.status, 200);
+  assert.match(r.cabeceras.get("content-type")!, /^application\/json/);
+  assert.deepEqual(Object.keys(r.cuerpo), ["total", "pagina", "paginas", "reservas"]);
+  assert.equal(r.cuerpo.total, 315);
+  assert.equal(r.cuerpo.reservas.length, 2);
+  assert.equal((await api.pedir("GET", "/api/reservas?limite=101")).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await api.pedir("GET", "/api/reservas/R-0520")).cuerpo.reserva.id, "R-0520");
+});
