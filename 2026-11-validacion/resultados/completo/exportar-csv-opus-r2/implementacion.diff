+/** Una fecha AAAA-MM-DD que existe en el calendario. */
+function fechaValida(fecha: unknown): fecha is string {
+  if (typeof fecha !== "string" || !FECHA.test(fecha)) return false;
+  const d = new Date(`${fecha}T12:00:00Z`);
+  return !Number.isNaN(d.getTime()) && d.toISOString().slice(0, 10) === fecha;
+}
+
+/** Días entre dos fechas AAAA-MM-DD, contando los dos extremos. */
+function diasIncluidos(desde: string, hasta: string): number {
+  return Math.round((Date.parse(`${hasta}T12:00:00Z`) - Date.parse(`${desde}T12:00:00Z`)) / 86_400_000) + 1;
+}
+
+function euros(centimos: number): string {
+  return (centimos / 100).toFixed(2);
+}
+
+/** Un campo CSV según el RFC 4180: entre comillas solo si lleva coma, comillas o salto de línea. */
+function campoCsv(valor: string): string {
+  return /[",\r\n]/.test(valor) ? `"${valor.replaceAll('"', '""')}"` : valor;
+}
+
+export interface FiltrosExportacion {
+  desde?: string;
+  hasta?: string;
+  estado?: string;
+}
 
