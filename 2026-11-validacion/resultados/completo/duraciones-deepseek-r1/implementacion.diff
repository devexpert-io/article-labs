+test("criterio 8: una franja está reservada si cualquier reserva confirmada se solapa con ella", async () => {
+  const fecha = "2026-12-06"; // domingo, sin reservas en la semilla
+  const sesenta = await reservar({ pistaId: "pista-2", inicio: `${fecha}T10:00`, duracion: 60 });
+  assert.equal(sesenta.status, 201);
+
+  let dia = await disponibilidad(fecha);
+  let pista = pistaDe(dia, "pista-2");
+  const porHora = (hora: string) => pista.franjas.find((f: any) => f.inicio === `${fecha}T${hora}`);
+  assert.equal(porHora("09:00").estado, "reservada", "la franja 09:00-10:30 se solapa en parte");
+  assert.equal(porHora("10:30").estado, "reservada", "la franja 10:30-12:00 se solapa en parte");
+  assert.equal(porHora("12:00").estado, "libre");
+
+  const otra = await reservar({ pistaId: "pista-2", inicio: `${fecha}T11:00`, duracion: 60 });
+  assert.equal(otra.status, 201);
+  dia = await disponibilidad(fecha);
+  pista = pistaDe(dia, "pista-2");
+  assert.equal(pista.franjas.find((f: any) => f.inicio === `${fecha}T10:30`).estado, "reservada");
+  assert.equal(pista.franjas.find((f: any) => f.inicio === `${fecha}T12:00`).estado, "libre");
+});
