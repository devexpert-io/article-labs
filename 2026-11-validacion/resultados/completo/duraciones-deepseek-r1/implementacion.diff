+test("criterio 9: los huecos son los intervalos libres máximos, ordenados y sin mirar la hora actual", async () => {
+  const fecha = "2026-12-07"; // lunes
+  await reservar({ pistaId: "pista-1", inicio: `${fecha}T10:00`, duracion: 60 });
