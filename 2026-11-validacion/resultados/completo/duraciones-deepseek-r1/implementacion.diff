+// Reservas de 60, 90 o 120 minutos, inicios en punto o y media, precio por minutos y huecos.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { HORAS } from "../src/semilla.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+/** Un socio con la cuota al día y menos de tres reservas futuras confirmadas. */
+async function socioLibre(): Promise<string> {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const futuras = new Map<string, number>();
+  for (const r of estado.reservas) {
+    if (r.estado === "confirmada" && r.inicio > estado.ahora) {
+      futuras.set(r.socioId, (futuras.get(r.socioId) ?? 0) + 1);
+    }
+  }
+  const socio = estado.socios.find((s: any) => s.cuotaActiva && (futuras.get(s.id) ?? 0) < 3);
+  assert.ok(socio, "debe quedar algún socio con menos de tres reservas futuras");
+  return socio.id;
+}
+
+async function reservar(cuerpo: Record<string, unknown>) {
+  const socioId = (cuerpo.socioId as string | undefined) ?? (await socioLibre());
+  return api.pedir("POST", "/api/reservas", { cuerpo: { ...cuerpo, socioId } });
+}
+
+async function disponibilidad(fecha: string) {
+  const respuesta = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`);
+  assert.equal(respuesta.status, 200);
+  return respuesta.cuerpo;
+}
+
+function pistaDe(dia: any, pistaId: string) {
+  return dia.pistas.find((p: any) => p.pistaId === pistaId);
+}
+
+test("criterio 1: la duración es opcional, solo 60, 90 o 120, y 90 por defecto", async () => {
+  const porDefecto = await reservar({ pistaId: "pista-1", inicio: "2026-12-01T09:00" });
+  assert.equal(porDefecto.status, 201);
+  assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+  assert.equal(porDefecto.cuerpo.reserva.fin, "2026-12-01T10:30");
+
+  const sesenta = await reservar({ pistaId: "pista-2", inicio: "2026-12-01T09:00", duracion: 60 });
+  assert.equal(sesenta.status, 201);
+  assert.equal(sesenta.cuerpo.reserva.duracion, 60);
+  assert.equal(sesenta.cuerpo.reserva.fin, "2026-12-01T10:00");
+
+  const cientoVeinte = await reservar({ pistaId: "pista-3", inicio: "2026-12-01T09:00", duracion: 120 });
+  assert.equal(cientoVeinte.status, 201);
+  assert.equal(cientoVeinte.cuerpo.reserva.duracion, 120);
+  assert.equal(cientoVeinte.cuerpo.reserva.fin, "2026-12-01T11:00");
+
+  for (const duracion of [45, 0, 150, 90.5, "90", null]) {
+    const mala = await reservar({ pistaId: "pista-1", inicio: "2026-12-01T12:00", duracion });
+    assert.equal(mala.status, 400, `duracion ${JSON.stringify(duracion)} debe dar 400`);
+    assert.equal(mala.cuerpo.error.codigo, "DURACION_INVALIDA");
+  }
+});
+
+test("criterio 2: el inicio es en punto o y media, no antes de las 09:00, y termina como muy tarde a las 22:30", async () => {
+  const casos: { inicio: string; duracion?: number }[] = [
+    { inicio: "2026-12-02T09:15" },
+    { inicio: "2026-12-02T10:45" },
+    { inicio: "2026-12-02T08:30" },
+    { inicio: "2026-12-02T22:00", duracion: 60 },
+    { inicio: "2026-12-02T21:00", duracion: 120 },
+  ];
+  for (const caso of casos) {
+    const mala = await reservar({ pistaId: "pista-1", ...caso });
+    assert.equal(mala.status, 400, `${caso.inicio} (${caso.duracion ?? 90} min) debe dar 400`);
+    assert.equal(mala.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  }
+
+  const pronto = await reservar({ pistaId: "pista-2", inicio: "2026-12-02T09:00", duracion: 120 });
+  assert.equal(pronto.status, 201);
+  const ultima = await reservar({ pistaId: "pista-3", inicio: "2026-12-02T21:30", duracion: 60 });
+  assert.equal(ultima.status, 201);
+  assert.equal(ultima.cuerpo.reserva.fin, "2026-12-02T22:30");
+});
+
+test("criterio 4: sin solapes, ni con las reservas nuevas ni con las de 90 minutos de siempre", async () => {
+  const primera = await reservar({ pistaId: "pista-1", inicio: "2026-12-03T10:00", duracion: 60 });
+  assert.equal(primera.status, 201);
+
+  const solapada = await reservar({ pistaId: "pista-1", inicio: "2026-12-03T10:30", duracion: 60 });
+  assert.equal(solapada.status, 409);
+  assert.equal(solapada.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+
+  const pegada = await reservar({ pistaId: "pista-1", inicio: "2026-12-03T11:00", duracion: 60 });
