+
+  const dia = await disponibilidad(fecha);
+  assert.deepEqual(pistaDe(dia, "pista-1").huecos, [
+    { inicio: `${fecha}T09:00`, fin: `${fecha}T10:00` },
+    { inicio: `${fecha}T11:00`, fin: `${fecha}T15:00` },
+    { inicio: `${fecha}T16:30`, fin: `${fecha}T22:30` },
+  ]);
+
+  assert.deepEqual(pistaDe(dia, "pista-2").huecos, [{ inicio: `${fecha}T09:00`, fin: `${fecha}T22:30` }], "un día libre es un solo hueco");
