+// Las reservas fijas semanales (docs/specs/reservas-fijas.md), probadas a través de la API.
+// Cada test arranca su propia API para partir del estado de la semilla.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-003"; // cuota al día, sin reservas futuras en la semilla
+const SIN_CUOTA = "socio-011";
+const IRENE = "socio-004"; // ya tiene una reserva futura en la semilla
+
+async function conApi(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function crear(api: Api, cuerpo: Record<string, unknown>, socio = GESTOR) {
+  return api.pedir("POST", "/api/series", { cuerpo, socio });
+}
+
+async function reservasDe(api: Api, serieId: string) {
+  return (await api.pedir("GET", `/api/series/${serieId}`, { socio: GESTOR })).cuerpo.serie.reservas as any[];
+}
+
+test("series: solo un gestor crea, consulta y cancela", () =>
+  conApi(async (api) => {
+    const datos = { socioId: SOCIO, pistaId: "pista-3", inicio: "2026-12-01T10:30", semanas: 2 };
+
+    const sinCabecera = await api.pedir("POST", "/api/series", { cuerpo: datos });
+    assert.equal(sinCabecera.status, 401);
+    assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const desconocido = await crear(api, datos, "socio-999");
+    assert.equal(desconocido.status, 401);
+    assert.equal(desconocido.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const socio = await crear(api, datos, SOCIO);
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const creada = await crear(api, datos);
+    assert.equal(creada.status, 201);
+    const id = creada.cuerpo.serie.id;
+
+    assert.equal((await api.pedir("GET", `/api/series/${id}`)).status, 401);
+    assert.equal((await api.pedir("GET", `/api/series/${id}`, { socio: SOCIO })).cuerpo.error.codigo, "SIN_PERMISO");
+    assert.equal((await api.pedir("GET", `/api/series/${id}`, { socio: GESTOR })).status, 200);
+
+    assert.equal((await api.pedir("POST", `/api/series/${id}/cancelar`, { cuerpo: {} })).status, 401);
+    assert.equal((await api.pedir("POST", `/api/series/${id}/cancelar`, { cuerpo: {}, socio: SOCIO })).status, 403);
+  }));
+
+test("series: datos, franja y socio/pista válidos", () =>
+  conApi(async (api) => {
+    const base = { socioId: SOCIO, pistaId: "pista-3", inicio: "2026-12-01T10:30", semanas: 2 };
+    for (const semanas of [1, 13, 2.5, "3", undefined]) {
+      const r = await crear(api, { ...base, semanas });
+      assert.equal(r.status, 400, `semanas=${semanas}`);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    assert.equal((await crear(api, { ...base, socioId: "socio-999" })).cuerpo.error.codigo, "SOCIO_NO_ENCONTRADO");
+    assert.equal((await crear(api, { ...base, pistaId: "pista-9" })).cuerpo.error.codigo, "PISTA_NO_ENCONTRADA");
+    const fuera = await crear(api, { ...base, inicio: "2026-12-01T09:30" });
+    assert.equal(fuera.status, 400);
+    assert.equal(fuera.cuerpo.error.codigo, "FRANJA_INVALIDA");
+    const pasada = await crear(api, { ...base, inicio: "2026-11-18T09:00" });
+    assert.equal(pasada.status, 409);
+    assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+    assert.equal((await api.pedir("GET", "/_estado")).cuerpo.series.length, 0, "ninguna serie se ha creado");
+  }));
+
+test("series: una reserva cada 7 días, a la misma hora local aunque cambie la hora del verano", () =>
+  conApi(async (api) => {
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-01T10:00" } });
+    const creada = await crear(api, { socioId: SOCIO, pistaId: "pista-2", inicio: "2027-03-23T19:30", semanas: 2 });
