+test("series: cancelar la serie respeta las 24 horas, la penalización con forzar y lo ya empezado", () =>
+  conApi(async (api) => {
+    const creada = await crear(api, { socioId: SOCIO, pistaId: "pista-3", inicio: "2026-12-01T10:30", semanas: 3 });
+    const id = creada.cuerpo.serie.id;
+    const [primera, segunda, tercera] = creada.cuerpo.serie.reservas as string[];
+    // Un socio cancela la tercera por su cuenta: la serie no debe contarla otra vez.
+    await api.pedir("POST", `/api/reservas/${tercera}/cancelar`);
+
+    // Faltan 23,5 horas para la primera: está dentro de las 24 horas.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T11:00" } });
+    const sinForzar = await api.pedir("POST", `/api/series/${id}/cancelar`, { cuerpo: {}, socio: GESTOR });
+    assert.equal(sinForzar.status, 200);
+    assert.deepEqual(sinForzar.cuerpo.canceladas.map((r: any) => r.id), [segunda], "la semana de dentro de 7 días sí es gratis");
+    assert.equal(sinForzar.cuerpo.canceladas[0].penalizacion, undefined);
+    assert.deepEqual(sinForzar.cuerpo.pendientes.map((r: any) => r.id), [primera]);
+    assert.equal(sinForzar.cuerpo.pendientes[0].estado, "confirmada");
+
+    const conForzar = await api.pedir("POST", `/api/series/${id}/cancelar`, { cuerpo: { forzar: true }, socio: GESTOR });
+    assert.deepEqual(conForzar.cuerpo.canceladas.map((r: any) => r.id), [primera]);
+    assert.equal(conForzar.cuerpo.canceladas[0].penalizacion, 1200);
+    assert.deepEqual(conForzar.cuerpo.pendientes, []);
+    assert.equal(conForzar.cuerpo.serie.id, id);
+
+    const otraVez = await api.pedir("POST", `/api/series/${id}/cancelar`, { cuerpo: {}, socio: GESTOR });
+    assert.deepEqual(otraVez.cuerpo.canceladas, []);
+    assert.deepEqual(otraVez.cuerpo.pendientes, []);
+    assert.equal((await api.pedir("GET", `/api/reservas/${segunda}`)).cuerpo.reserva.estado, "cancelada");
+  }));
