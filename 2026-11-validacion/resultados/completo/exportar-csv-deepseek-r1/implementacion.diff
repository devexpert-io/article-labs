diff --git a/test/exportar-csv.test.ts b/test/exportar-csv.test.ts
new file mode 100644
index 0000000..c73563a
--- /dev/null
+++ b/test/exportar-csv.test.ts
@@ -0,0 +1,185 @@
+// La exportación de reservas a CSV, probada a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+/** Parser CSV mínimo (RFC 4180) para comprobar el cuerpo sin depender de cómo se generó. */
+function parsearCsv(texto: string): string[][] {
+  const filas: string[][] = [];
+  let fila: string[] = [];
+  let campo = "";
+  let entreComillas = false;
+  for (let i = 0; i < texto.length; i++) {
+    const c = texto[i]!;
+    if (entreComillas) {
+      if (c === '"') {
+        if (texto[i + 1] === '"') {
+          campo += '"';
+          i++;
+        } else {
+          entreComillas = false;
+        }
+      } else {
+        campo += c;
+      }
+    } else if (c === '"') {
+      entreComillas = true;
+    } else if (c === ",") {
+      fila.push(campo);
+      campo = "";
+    } else if (c === "\r" && texto[i + 1] === "\n") {
+      fila.push(campo);
+      filas.push(fila);
+      fila = [];
+      campo = "";
+      i++;
+    } else {
+      campo += c;
+    }
+  }
+  assert.equal(campo, "", "el CSV debe terminar con CRLF");
+  assert.equal(entreComillas, false, "el CSV no puede acabar dentro de un campo entrecomillado");
+  return filas;
+}
+
+function exportar(consulta: string, socio?: string) {
+  return api.pedir("GET", `/api/reservas/exportar${consulta}`, socio ? { socio } : {});
+}
+
+test("solo un gestor puede exportar", async () => {
+  const sinIdentificar = await exportar("?desde=2026-11-19&hasta=2026-11-19");
+  assert.equal(sinIdentificar.status, 401);
+  assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const socio = await exportar("?desde=2026-11-19&hasta=2026-11-19", "socio-001");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const gestor = await exportar("?desde=2026-11-19&hasta=2026-11-19", GESTOR);
+  assert.equal(gestor.status, 200);
+});
+
+test("la respuesta es un CSV adjunto con las fechas del periodo en el nombre", async () => {
+  const r = await exportar("?desde=2026-11-18&hasta=2026-11-24", GESTOR);
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-11-18-2026-11-24.csv"');
+  assert.equal(parsearCsv(r.texto)[0]!.join(","), CABECERA);
+});
+
+test("hay una fila por reserva del periodo, ordenadas por inicio y pista", async () => {
+  const r = await exportar("?desde=2026-11-19&hasta=2026-11-19", GESTOR);
+  assert.equal(r.status, 200);
+  // Sin notas con saltos de línea, cada línea debe acabar en CRLF: ni un LF suelto.
+  assert.ok(r.texto.endsWith("\r\n"));
+  assert.doesNotMatch(r.texto, /(?<!\r)\n/);
+
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const esperadas = estado.reservas
+    .filter((reserva: { inicio: string }) => reserva.inicio.slice(0, 10) === "2026-11-19")
+    .sort((a: { inicio: string; pistaId: string }, b: { inicio: string; pistaId: string }) =>
+      a.inicio === b.inicio ? a.pistaId.localeCompare(b.pistaId) : a.inicio.localeCompare(b.inicio));
+
+  const filas = parsearCsv(r.texto).slice(1);
+  assert.equal(filas.length, esperadas.length);
+  assert.deepEqual(filas.map((fila) => fila[0]), esperadas.map((reserva: { id: string }) => reserva.id));
+
+  // La primera es R-0520: pista 3, Marta López, 09:00, 12.00 € y sin penalización.
+  assert.deepEqual(filas[0], [
+    "R-0520",
+    "2026-11-19",
+    "09:00",
+    "Pista 3",
+    "Marta López",
+    "marta.lopez@example.com",
+    "confirmada",
+    "12.00",
+    "",
+    "",
+  ]);
+  // R-0488 y R-0523 comparten día pero no hora; R-0523 y R-0489 empiezan a las 18:00 y van por pista.
+  const ids = filas.map((fila) => fila[0]);
+  assert.ok(ids.indexOf("R-0523") < ids.indexOf("R-0489"), "a la misma hora, primero la pista 1");
+});
+
+test("los importes van en euros y la penalización vacía si no la hay", async () => {
+  const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1200);
+
+  const r = await exportar("?desde=2026-11-19&hasta=2026-11-19", GESTOR);
+  const filas = parsearCsv(r.texto).slice(1);
+  const cancelada = filas.find((fila) => fila[0] === "R-0520")!;
+  assert.equal(cancelada[6], "cancelada");
+  assert.equal(cancelada[7], "12.00");
+  assert.equal(cancelada[8], "12.00");
+  const sinPenalizacion = filas.find((fila) => fila[0] === "R-0524")!;
+  assert.equal(sinPenalizacion[7], "18.00");
+  assert.equal(sinPenalizacion[8], "");
+});
+
+test("el escapado sigue el RFC 4180 con comas, comillas y saltos de línea", async () => {
+  const notas = 'Pista "central", con\nsalto de línea';
+  const creada = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-24T09:00", notas },
+  });
+  assert.equal(creada.status, 201);
+
+  const r = await exportar("?desde=2026-11-24&hasta=2026-11-24", GESTOR);
+  assert.ok(r.texto.includes('"Pista ""central"", con\nsalto de línea"'), "el campo debe ir entrecomillado y con comillas duplicadas");
+  const fila = parsearCsv(r.texto).slice(1).find((f) => f[0] === creada.cuerpo.reserva.id)!;
+  assert.equal(fila[9], notas);
+  // Las columnas que no llevan caracteres especiales no se entrecomillan.
+  assert.equal(fila.slice(0, 8).some((campo) => campo.startsWith('"')), false);
+});
+
+test("el periodo es obligatorio, válido, coherente y de 92 días como mucho", async () => {
+  for (const consulta of [
+    "?hasta=2026-11-19",
+    "?desde=2026-11-19",
+    "?desde=19-11-2026&hasta=2026-11-19",
+    "?desde=2026-11-20&hasta=2026-11-19",
+  ]) {
+    const r = await exportar(consulta, GESTOR);
+    assert.equal(r.status, 400, consulta);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", consulta);
+  }
+
+  const alLimite = await exportar("?desde=2026-09-01&hasta=2026-12-01", GESTOR);
+  assert.equal(alLimite.status, 200, "92 días contando los dos extremos");
+
+  const demasiado = await exportar("?desde=2026-09-01&hasta=2026-12-02", GESTOR);
+  assert.equal(demasiado.status, 400);
+  assert.equal(demasiado.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+});
+
+test("el filtro por estado es opcional y solo admite los estados del club", async () => {
+  const canceladas = await exportar("?desde=2026-11-19&hasta=2026-11-19&estado=cancelada", GESTOR);
+  assert.equal(canceladas.status, 200);
+  const filas = parsearCsv(canceladas.texto).slice(1);
+  assert.deepEqual(filas.map((fila) => fila[0]), ["R-0520"]);
+
+  const confirmadas = await exportar("?desde=2026-11-19&hasta=2026-11-19&estado=confirmada", GESTOR);
+  assert.ok(parsearCsv(confirmadas.texto).slice(1).every((fila) => fila[6] === "confirmada"));
+
+  const invalido = await exportar("?desde=2026-11-19&hasta=2026-11-19&estado=pendiente", GESTOR);
+  assert.equal(invalido.status, 400);
+  assert.equal(invalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+});
+
+test("GET /api/reservas sigue respondiendo igual que antes", async () => {
+  const lista = await api.pedir("GET", "/api/reservas?desde=2026-11-19&hasta=2026-11-19&limite=100");
+  assert.equal(lista.status, 200);
+  assert.equal(lista.cabeceras.get("content-type"), "application/json; charset=utf-8");
+  assert.equal(lista.cuerpo.total, 7);
+  assert.equal(lista.cuerpo.reservas.length, 7);
+});
