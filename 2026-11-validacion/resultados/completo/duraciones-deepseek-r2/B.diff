+// Las reservas de 60, 90 o 120 minutos: duraciones, inicios, solapes, precios, huecos y las reglas de siempre.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const crear = (cuerpo: Record<string, unknown>) => api.pedir("POST", "/api/reservas", { cuerpo });
+const reservar = async (socioId: string, pistaId: string, inicio: string, duracion?: number) => {
+  const respuesta = await crear({ socioId, pistaId, inicio, ...(duracion === undefined ? {} : { duracion }) });
+  assert.equal(respuesta.status, 201, respuesta.texto);
+  return respuesta.cuerpo.reserva;
+};
+const disponibilidad = async (fecha: string, pistaId?: string) =>
+  (await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}${pistaId ? `&pista=${pistaId}` : ""}`)).cuerpo.pistas;
+
+test("todas las reservas devuelven su duración; las que ya existían son de 90 minutos", async () => {
+  const lista = (await api.pedir("GET", "/api/reservas?limite=100")).cuerpo.reservas;
+  assert.ok(lista.length > 0);
+  for (const reserva of lista) assert.equal(reserva.duracion, 90);
+  const una = (await api.pedir("GET", "/api/reservas/R-0001")).cuerpo.reserva;
+  assert.equal(una.duracion, 90);
+  assert.equal(una.fin, "2026-10-01T10:30");
+});
+
+test("la duración es opcional, vale 60, 90 o 120 y por defecto son 90", async () => {
+  const porDefecto = await reservar("socio-003", "pista-1", "2026-11-25T09:00");
+  assert.equal(porDefecto.duracion, 90);
+  assert.equal(porDefecto.fin, "2026-11-25T10:30");
+  assert.equal(porDefecto.importe, 1800);
+
+  const sesenta = await reservar("socio-006", "pista-1", "2026-11-25T10:30", 60);
+  assert.equal(sesenta.duracion, 60);
+  assert.equal(sesenta.fin, "2026-11-25T11:30");
+  assert.equal(sesenta.importe, 1200);
+
+  const cientoVeinte = await reservar("socio-008", "pista-1", "2026-11-25T12:00", 120);
+  assert.equal(cientoVeinte.duracion, 120);
+  assert.equal(cientoVeinte.fin, "2026-11-25T14:00");
+  assert.equal(cientoVeinte.importe, 2400);
+
+  for (const duracion of [45, 75, 150, 0, -60, 90.5, "90", null, true]) {
+    const respuesta = await crear({ socioId: "socio-010", pistaId: "pista-1", inicio: "2026-11-30T15:00", duracion });
+    assert.equal(respuesta.status, 400, `duracion ${JSON.stringify(duracion)} debe dar 400`);
+    assert.equal(respuesta.cuerpo.error.codigo, "DURACION_INVALIDA");
+  }
+});
+
+test("el inicio empieza en punto o y media, no antes de las 09:00 y termina como muy tarde a las 22:30", async () => {
+  const invalidos = [
+    "2026-11-26T08:30", // antes de la apertura
+    "2026-11-26T10:15", // no es en punto ni y media
+    "2026-11-26T21:31",
+    "2026-11-26T22:00", // terminaría a las 23:00
+    "2026-11-26", // sin hora
+    "2026-02-30T10:00", // esa fecha no existe
+    "2026-13-01T10:00",
+    "2026-11-26T10:60", // los minutos no existen
+    "2026-11-26T09:90",
+    "2026-11-26T08:60",
+    "2026-11-26T20:90",
+  ];
+  const antes = (await api.pedir("GET", "/api/reservas?limite=100")).cuerpo.total;
+  for (const inicio of invalidos) {
+    const respuesta = await crear({ socioId: "socio-010", pistaId: "pista-1", inicio });
+    assert.equal(respuesta.status, 400, `${inicio} debe dar 400`);
+    assert.equal(respuesta.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  }
+  const despues = (await api.pedir("GET", "/api/reservas?limite=100")).cuerpo.total;
+  assert.equal(despues, antes, "ningún inicio inválido debe crear una reserva");
+  const dosHoras = await crear({ socioId: "socio-010", pistaId: "pista-1", inicio: "2026-11-26T21:00", duracion: 120 });
+  assert.equal(dosHoras.status, 400);
+  assert.equal(dosHoras.cuerpo.error.codigo, "FRANJA_INVALIDA");
