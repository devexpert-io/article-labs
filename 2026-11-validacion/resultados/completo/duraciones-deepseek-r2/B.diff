+test("una franja de 90 minutos está reservada si una reserva se solapa con ella en parte", async () => {
+  const antes = await disponibilidad("2026-12-01", "pista-3");
+  assert.deepEqual(antes[0].franjas.map((f: any) => f.estado), Array(9).fill("libre"));
+
+  const corta = await reservar("socio-032", "pista-3", "2026-12-01T10:30", 60); // 10:30–11:30
+  const pista = (await disponibilidad("2026-12-01", "pista-3"))[0];
+  const estado = (hora: string) => pista.franjas.find((f: any) => f.inicio.endsWith(hora)).estado;
+  assert.equal(estado("10:30"), "reservada");
+  assert.equal(estado("09:00"), "libre");
+  assert.equal(estado("12:00"), "libre");
+  assert.deepEqual(pista.huecos, [
+    { inicio: "2026-12-01T09:00", fin: "2026-12-01T10:30" },
+    { inicio: "2026-12-01T11:30", fin: "2026-12-01T22:30" },
+  ]);
+
+  // Una reserva cancelada deja de ocupar la pista.
+  const cancelada = (await api.pedir("POST", `/api/reservas/${corta.id}/cancelar`)).cuerpo.reserva;
+  assert.equal(cancelada.estado, "cancelada");
+  const trasCancelar = (await disponibilidad("2026-12-01", "pista-3"))[0];
+  assert.equal(trasCancelar.franjas.find((f: any) => f.inicio.endsWith("10:30")).estado, "libre");
+  assert.deepEqual(trasCancelar.huecos, [{ inicio: "2026-12-01T09:00", fin: "2026-12-01T22:30" }]);
+});
