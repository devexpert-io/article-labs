+test("el informe de caja suma reservas e ingresos por pista y para todo el club", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const delMes = estado.reservas.filter((r: { inicio: string }) => r.inicio.startsWith("2026-10"));
+  const porPista = new Map<string, { reservas: number; ingresos: number; penalizaciones: number; total: number }>();
+  for (const pista of estado.pistas) {
+    porPista.set(pista.id, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+  }
+  for (const r of delMes as { pistaId: string; estado: string; importe: number; penalizacion?: number }[]) {
+    const fila = porPista.get(r.pistaId)!;
+    if (r.estado === "cancelada") {
+      fila.penalizaciones += r.penalizacion ?? 0;
+    } else {
+      fila.reservas += 1;
+      fila.ingresos += r.importe;
+    }
+  }
+  const esperadas = [...porPista.entries()]
+    .map(([pistaId, fila]) => ({ pistaId, ...fila, total: fila.ingresos + fila.penalizaciones }))
+    .sort((a, b) => a.pistaId.localeCompare(b.pistaId));
+
+  const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR });
+  assert.equal(informe.status, 200);
+  assert.equal(informe.cuerpo.mes, "2026-10");
+  assert.deepEqual(informe.cuerpo.pistas, esperadas);
+  assert.deepEqual(informe.cuerpo.total, {
+    reservas: esperadas.reduce((s, p) => s + p.reservas, 0),
+    ingresos: esperadas.reduce((s, p) => s + p.ingresos, 0),
+    penalizaciones: esperadas.reduce((s, p) => s + p.penalizaciones, 0),
+    total: esperadas.reduce((s, p) => s + p.total, 0),
+  });
+  // Entran todas las pistas del club, ordenadas por id, también la que estuvo cerrada.
+  assert.deepEqual(informe.cuerpo.pistas.map((p: { pistaId: string }) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+  assert.ok(informe.cuerpo.total.ingresos > 0);
+});
+
+test("el informe de caja tiene en cuenta las penalizaciones cobradas y los meses sin movimientos", async () => {
