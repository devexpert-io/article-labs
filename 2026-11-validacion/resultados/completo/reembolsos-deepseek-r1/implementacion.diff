+// La política escalonada de cancelación, la exención de un gestor y el informe de caja.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-041";
+
+async function crear(socioId: string, pistaId: string, inicio: string): Promise<any> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.reserva;
+}
+
+async function moverReloj(ahora: string): Promise<void> {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200, r.texto);
+}
+
+test("los tramos: sin penalización con 48 horas o más, el 25 % entre 24 y 48 y el 50 % con menos de 24", async () => {
+  // 96 horas: sin penalización y se devuelve el importe entero.
+  const lejana = await crear(SOCIO, "pista-3", "2026-11-22T10:30");
+  const gratis = await api.pedir("POST", `/api/reservas/${lejana.id}/cancelar`);
+  assert.equal(gratis.status, 200);
+  assert.equal(gratis.cuerpo.reserva.estado, "cancelada");
+  assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.cuerpo.reembolso, lejana.importe);
+
+  // 26 horas: el 25 % del importe, sin forzar.
+  const media = await crear(SOCIO, "pista-2", "2026-11-19T12:00");
+  const reducida = await api.pedir("POST", `/api/reservas/${media.id}/cancelar`);
+  assert.equal(reducida.status, 200);
+  assert.equal(reducida.cuerpo.reserva.penalizacion, 450);
+  assert.equal(reducida.cuerpo.reembolso, 1350);
+
+  // 23 horas: sin forzar, fuera de plazo.
+  const cercana = await crear(SOCIO, "pista-1", "2026-11-19T09:00");
+  const fuera = await api.pedir("POST", `/api/reservas/${cercana.id}/cancelar`);
+  assert.equal(fuera.status, 409);
+  assert.equal(fuera.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  // Con forzar, el 50 %.
+  const forzada = await api.pedir("POST", `/api/reservas/${cercana.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+  assert.equal(forzada.cuerpo.reembolso, 900);
+});
+
+test("los límites exactos: a 48 horas no hay penalización y a 24 horas se aplica el 25 % sin forzar", async () => {
+  await moverReloj("2026-11-18T12:00");
+  try {
+    const a48 = await crear(SOCIO, "pista-1", "2026-11-20T12:00");
+    const sinPenalizacion = await api.pedir("POST", `/api/reservas/${a48.id}/cancelar`);
+    assert.equal(sinPenalizacion.status, 200);
+    assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(sinPenalizacion.cuerpo.reembolso, a48.importe);
+
+    const a24 = await crear(SOCIO, "pista-3", "2026-11-19T12:00");
+    const reducida = await api.pedir("POST", `/api/reservas/${a24.id}/cancelar`);
+    assert.equal(reducida.status, 200);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, 300);
+    assert.equal(reducida.cuerpo.reembolso, a24.importe - 300);
+  } finally {
+    await moverReloj("2026-11-18T10:00");
+  }
+});
+
+test("la antelación se cuenta en horas reales de Madrid, con el cambio de hora", async () => {
+  try {
+    // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas
+    // (los relojes se adelantan esa madrugada), no 48,5: toca el 25 %.
+    await moverReloj("2027-03-26T20:30");
+    const deCambio = await crear(SOCIO, "pista-1", "2027-03-28T21:00");
+    assert.equal(deCambio.importe, 2800);
+    const cancelada = await api.pedir("POST", `/api/reservas/${deCambio.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+
+    // A las 20:00 del viernes 26 faltan 48 horas exactas hasta el domingo a las 21:00: sin penalización.
+    await moverReloj("2027-03-26T20:00");
+    const justa = await crear(SOCIO, "pista-2", "2027-03-28T21:00");
+    const gratis = await api.pedir("POST", `/api/reservas/${justa.id}/cancelar`);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+
+    // En cambio, al final de octubre los relojes se atrasan: 48,5 horas reales cuentan como 48 o más.
+    await moverReloj("2027-10-29T21:30");
+    const otono = await crear(SOCIO, "pista-3", "2027-10-31T21:00");
+    const otonoSinPenalizacion = await api.pedir("POST", `/api/reservas/${otono.id}/cancelar`);
+    assert.equal(otonoSinPenalizacion.status, 200);
+    assert.equal(otonoSinPenalizacion.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(otonoSinPenalizacion.cuerpo.reembolso, otono.importe);
+  } finally {
+    await moverReloj("2026-11-18T10:00");
+  }
+});
+
+test("un gestor exime de la penalización con un motivo de al menos 10 caracteres", async () => {
+  const reserva = await crear(SOCIO, "pista-1", "2026-11-19T09:00");
+  const camino = `/api/reservas/${reserva.id}/cancelar`;
+
+  const sinMotivo = await api.pedir("POST", camino, { socio: GESTOR, cuerpo: { exento: true } });
