+test("exportar reservas genera CSV RFC 4180 para gestores", async () => {
+  const aislada = await arrancarApi();
+  try {
+  const casos = [
+    { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-25T09:00", notas: "Nota ordinaria" },
+    { socioId: "socio-006", pistaId: "pista-2", inicio: "2026-11-25T10:30", notas: "Trae agua, fruta y bolas" },
+    { socioId: "socio-007", pistaId: "pista-3", inicio: "2026-11-25T12:00", notas: 'Dice "llego tarde"' },
+    { socioId: "socio-008", pistaId: "pista-1", inicio: "2026-11-25T13:30", notas: "Primera línea\nsegunda línea" },
+    { socioId: "socio-009", pistaId: "pista-2", inicio: "2026-11-25T15:00", notas: "Primera línea\r\nsegunda línea" },
+  ];
+  const creadas = [];
+  for (const caso of casos) {
+    const respuesta = await aislada.pedir("POST", "/api/reservas", { cuerpo: caso });
+    assert.equal(respuesta.status, 201);
+    creadas.push(respuesta.cuerpo.reserva);
+  }
+  const estadoInicial = (await aislada.pedir("GET", "/_estado")).cuerpo;
+  const sociosIniciales = new Map(estadoInicial.socios.map((s: any) => [s.id, s]));
+  const pistasIniciales = new Map(estadoInicial.pistas.map((p: any) => [p.id, p]));
+  const csvNotas = await aislada.pedir("GET", "/api/reservas/exportar?desde=2026-11-25&hasta=2026-11-25", { socio: "socio-040" });
+  assert.equal(csvNotas.status, 200);
+  const cabeceraCsv = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas\r\n";
+  const filasNotasEsperadas = creadas.map((r: any, i) => {
+    const s: any = sociosIniciales.get(r.socioId);
+    const p: any = pistasIniciales.get(r.pistaId);
+    const precio = `${Math.floor(r.importe / 100)}.${String(r.importe % 100).padStart(2, "0")}`;
+    const notaCsv = [
+      "Nota ordinaria",
+      '"Trae agua, fruta y bolas"',
+      '"Dice ""llego tarde"""',
+      '"Primera línea\nsegunda línea"',
+      '"Primera línea\r\nsegunda línea"',
+    ][i];
+    // Se ensamblan campos conocidos; la expectativa del escapado de notas es literal.
+    return `${r.id},2026-11-25,${r.inicio.slice(11)},${p.nombre},${s.nombre},${s.email},confirmada,${precio},,${notaCsv}\r\n`;
+  });
+  assert.equal(csvNotas.texto, cabeceraCsv + filasNotasEsperadas.join(""), "notas escapadas literalmente y registros terminados en CRLF");
+  assert.ok(!filasNotasEsperadas[0].includes('"Nota ordinaria"'), "los campos ordinarios no llevan comillas innecesarias");
+
+  const ruta = "/api/reservas/exportar?desde=2026-10-01&hasta=2026-11-19";
+  assert.equal((await aislada.pedir("GET", ruta)).cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await aislada.pedir("GET", ruta, { socio: "socio-003" });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const csv = await aislada.pedir("GET", ruta, { socio: "socio-040" });
+  assert.equal(csv.status, 200);
+  assert.equal(csv.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(csv.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-11-19.csv"');
+  assert.equal(csv.texto.split("\r\n")[0], "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas");
+  assert.ok(csv.texto.endsWith("\r\n"));
+  assert.ok(!csv.texto.replace(/\r\n/g, "").includes("\n"));
+  const estado = (await aislada.pedir("GET", "/_estado")).cuerpo;
+  const reservas = estado.reservas.filter((r: any) => r.inicio.slice(0, 10) >= "2026-10-01" && r.inicio.slice(0, 10) <= "2026-11-19")
+    .sort((a: any, b: any) => a.inicio.localeCompare(b.inicio) || a.pistaId.localeCompare(b.pistaId));
+  assert.ok(reservas.length > 100);
+  const encabezado = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+  const escape = (v: string) => /[,\"\r\n]/.test(v) ? `"${v.replace(/"/g, '""')}"` : v;
+  const euros = (n: number) => `${Math.floor(n / 100)}.${String(n % 100).padStart(2, "0")}`;
+  const esperado = [encabezado, ...reservas.map((r: any) => {
+    const s = estado.socios.find((x: any) => x.id === r.socioId);
+    const p = estado.pistas.find((x: any) => x.id === r.pistaId);
+    return [r.id, r.inicio.slice(0, 10), r.inicio.slice(11), p.nombre, s.nombre, s.email, r.estado, euros(r.importe), r.penalizacion === undefined ? "" : euros(r.penalizacion), r.notas].map(escape).join(",");
+  }), ""].join("\r\n");
+  assert.equal(csv.texto, esperado, "conjunto íntegro, extremos incluidos, orden, importes, penalizaciones y escapado exacto");
+  assert.match(csv.texto, /Traen sus propias palas\. Piden bolas nuevas\./);
+  assert.ok(reservas.some((r: any) => r.penalizacion === undefined));
+  for (const estadoFiltro of ["confirmada", "cancelada", "no_presentada"]) {
+    const filtrada = await aislada.pedir("GET", `${ruta}&estado=${estadoFiltro}`, { socio: "socio-040" });
+    const esperadas = reservas.filter((r: any) => r.estado === estadoFiltro);
+    assert.ok(esperadas.length > 0, `la semilla debe tener reservas ${estadoFiltro}`);
+    const ids = filtrada.texto.split("\r\n").slice(1, -1).map((fila) => fila.slice(0, fila.indexOf(",")));
+    assert.deepEqual(ids, esperadas.map((r: any) => r.id));
+  }
+  // La ruta JSON existente conserva su paginación y su resultado.
+  const listado = await aislada.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-11-19&limite=100");
+  assert.equal(listado.cuerpo.total, reservas.length);
+  assert.equal(listado.cuerpo.reservas.length, 100);
+  const cancelada = await aislada.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1200);
+  const dia = cancelada.cuerpo.reserva.inicio.slice(0, 10);
+  const penalizada = await aislada.pedir("GET", `/api/reservas/exportar?desde=${dia}&hasta=${dia}`, { socio: "socio-040" });
+  assert.ok(penalizada.texto.includes(",cancelada,"));
+  assert.ok(penalizada.texto.includes(",12.00,"));
+  } finally { aislada.cerrar(); }
+});
