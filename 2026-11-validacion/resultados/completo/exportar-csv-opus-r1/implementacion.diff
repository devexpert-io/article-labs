@@ -0,0 +1,155 @@
+// Exportar reservas a CSV (docs/specs/exportar-csv.md), probado a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const exportar = (consulta: string, socio: string | null = GESTOR) =>
+  api.pedir("GET", `/api/reservas/exportar${consulta}`, { socio: socio ?? undefined });
+
+/** Separa un CSV en filas y campos siguiendo el RFC 4180. */
+function leerCsv(texto: string): string[][] {
+  const filas: string[][] = [];
+  let fila: string[] = [];
+  let campo = "";
+  let comillas = false;
+  for (let i = 0; i < texto.length; i++) {
+    const c = texto[i];
+    if (comillas) {
+      if (c === '"' && texto[i + 1] === '"') { campo += '"'; i++; }
+      else if (c === '"') comillas = false;
+      else campo += c;
+    } else if (c === '"') comillas = true;
+    else if (c === ",") { fila.push(campo); campo = ""; }
+    else if (c === "\r" && texto[i + 1] === "\n") { fila.push(campo); filas.push(fila); fila = []; campo = ""; i++; }
+    else campo += c;
+  }
+  assert.equal(campo + fila.join(""), "", "el CSV debe terminar en CRLF");
+  return filas;
+}
+
+test("1. permisos: solo exporta un gestor", async () => {
+  const sin = await exportar("?desde=2026-11-01&hasta=2026-11-30", null);
+  assert.equal(sin.status, 401);
+  assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await exportar("?desde=2026-11-01&hasta=2026-11-30", "socio-004");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await exportar("?desde=2026-11-01&hasta=2026-11-30")).status, 200);
+});
+
+test("2. respuesta: 200, content-type y content-disposition con el periodo", async () => {
+  const r = await exportar("?desde=2026-10-01&hasta=2026-10-31");
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-10-31.csv"');
+});
+
+test("3 y 7. cabecera exacta y todas las líneas en CRLF", async () => {
+  const { texto } = await exportar("?desde=2026-11-19&hasta=2026-11-19");
+  assert.ok(texto.startsWith(`${CABECERA}\r\n`));
+  assert.ok(texto.endsWith("\r\n"));
+  assert.equal(texto.replaceAll("\r\n", "").includes("\n"), false, "no hay LF sueltos");
+  const vacio = await exportar("?desde=2026-12-20&hasta=2026-12-21");
+  assert.equal(vacio.texto, `${CABECERA}\r\n`);
+});
+
+test("4. filas: una por reserva del periodo, en cualquier estado, ordenadas por inicio y pista", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const esperadas = estado.reservas
+    .filter((r: any) => r.inicio >= "2026-10-01" && r.inicio.slice(0, 10) <= "2026-10-31")
+    .sort((a: any, b: any) => (a.inicio === b.inicio ? a.pistaId.localeCompare(b.pistaId) : a.inicio.localeCompare(b.inicio)));
+  const filas = leerCsv((await exportar("?desde=2026-10-01&hasta=2026-10-31")).texto).slice(1);
+  assert.equal(filas.length, 315);
+  assert.deepEqual(filas.map((f) => f[0]), esperadas.map((r: any) => r.id));
+  assert.deepEqual(new Set(filas.map((f) => f[6])), new Set(["confirmada", "cancelada", "no_presentada"]));
+  // Los extremos van incluidos.
+  assert.equal(filas[0]![1], "2026-10-01");
+  assert.equal(filas.at(-1)![1], "2026-10-31");
+  // Columnas de una reserva conocida.
+  const jueves = leerCsv((await exportar("?desde=2026-11-19&hasta=2026-11-19")).texto);
+  const fila = jueves.find((f) => f[9] === "Traen sus propias palas. Piden bolas nuevas.")!;
+  const reserva = estado.reservas.find((r: any) => r.id === fila[0]);
+  const socio = estado.socios.find((s: any) => s.id === reserva.socioId);
+  assert.deepEqual(fila.slice(1), ["2026-11-19", "18:00", "Pista 1", socio.nombre, socio.email, "confirmada", (reserva.importe / 100).toFixed(2), "", reserva.notas]);
+  // Mismo inicio: por id de pista.
+  const a1930 = jueves.filter((f) => f[2] === "19:30").map((f) => f[3]);
+  assert.deepEqual(a1930, [...a1930].sort());
+});
+
+test("5 y 6. importes en euros, penalización vacía o con valor y escapado RFC 4180", async () => {
+  const otra = await arrancarApi();
+  try {
+    const notas = ['Con coma, y "comillas"', "Línea uno\nLínea dos", "Sin nada raro"];
+    const ids: string[] = [];
+    for (const [i, nota] of notas.entries()) {
+      const r = await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: `2026-12-0${i + 1}T19:30`, notas: nota } });
+      assert.equal(r.status, 201);
+      ids.push(r.cuerpo.reserva.id);
+    }
+    // R-0520 es de Marta López el jueves 19 a las 09:00 en pista 3 (1200 céntimos).
+    await otra.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+
+    const { texto } = await otra.pedir("GET", "/api/reservas/exportar?desde=2026-12-01&hasta=2026-12-03", { socio: GESTOR });
+    const lineas = texto.split("\r\n");
+    assert.ok(lineas[1]!.endsWith(',confirmada,28.00,,"Con coma, y ""comillas"""'), lineas[1]);
+    assert.equal(lineas[2]!.endsWith(',confirmada,28.00,,"Línea uno\nLínea dos"'), true, lineas[2]);
+    assert.ok(lineas[3]!.endsWith(",confirmada,28.00,,Sin nada raro"), lineas[3]);
+    assert.ok(lineas[1]!.startsWith(`${ids[0]},2026-12-01,19:30,Pista 2,Nora Benítez,nora.benitez@example.com,`));
+    assert.deepEqual(leerCsv(texto).slice(1).map((f) => f[9]), notas);
+
+    const jueves = leerCsv((await otra.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19&estado=cancelada", { socio: GESTOR })).texto);
+    const cancelada = jueves.find((f) => f[0] === "R-0520")!;
+    assert.deepEqual(cancelada.slice(1, 9), ["2026-11-19", "09:00", "Pista 3", "Marta López", "marta.lopez@example.com", "cancelada", "12.00", "12.00"]);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("8. periodo: obligatorio, con formato, ordenado y de 92 días como mucho", async () => {
+  for (const consulta of [
+    "", "?desde=2026-11-01", "?hasta=2026-11-30", "?desde=2026-11-1&hasta=2026-11-30",
+    "?desde=2026-11-01&hasta=30-11-2026", "?desde=2026-02-30&hasta=2026-03-01", "?desde=2026-11-30&hasta=2026-11-01",
+  ]) {
+    const r = await exportar(consulta);
+    assert.equal(r.status, 400, consulta);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", consulta);
+  }
+  // Del 1 de septiembre al 1 de diciembre son 92 días contando los dos extremos.
+  assert.equal((await exportar("?desde=2026-09-01&hasta=2026-12-01")).status, 200);
+  const grande = await exportar("?desde=2026-09-01&hasta=2026-12-02");
+  assert.equal(grande.status, 400);
+  assert.equal(grande.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+});
+
+test("9. filtro por estado", async () => {
+  for (const estado of ["confirmada", "cancelada", "no_presentada"]) {
+    const filas = leerCsv((await exportar(`?desde=2026-10-01&hasta=2026-10-31&estado=${estado}`)).texto).slice(1);
+    assert.ok(filas.length > 0);
+    assert.ok(filas.every((f) => f[6] === estado), estado);
+  }
+  const mal = await exportar("?desde=2026-10-01&hasta=2026-10-31&estado=pendiente");
+  assert.equal(mal.status, 400);
+  assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+});
+
+test("10. GET /api/reservas responde igual que antes", async () => {
+  const r = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=2&pagina=3");
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "application/json; charset=utf-8");
+  assert.deepEqual(Object.keys(r.cuerpo), ["total", "pagina", "paginas", "reservas"]);
+  assert.equal(r.cuerpo.total, 315);
+  assert.equal(r.cuerpo.paginas, 158);
+  assert.equal(r.cuerpo.reservas.length, 2);
+  assert.equal((await api.pedir("GET", "/api/reservas?limite=101")).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const una = await api.pedir("GET", "/api/reservas/R-0001");
+  assert.equal(una.cuerpo.reserva.id, "R-0001");
+});
