+/** Un día real con el formato AAAA-MM-DD. Devuelve sus milisegundos UTC o undefined si no vale. */
+function diaValido(texto: unknown): number | undefined {
+  if (typeof texto !== "string" || !FECHA.test(texto)) return undefined;
+  const ms = Date.parse(`${texto}T00:00:00Z`);
+  if (Number.isNaN(ms) || new Date(ms).toISOString().slice(0, 10) !== texto) return undefined;
