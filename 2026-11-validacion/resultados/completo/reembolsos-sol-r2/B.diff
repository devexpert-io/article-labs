+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+async function crear(api: Api, inicio = "2027-03-28T21:00", pistaId = "pista-1") {
+  const r = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio },
+  });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.reserva;
+}
+
+test("tramos, límites exactos y cambios de hora de Madrid", async (t) => {
+  const casos = [
+    { ahora: "2027-03-26T19:59", porcentaje: 0 },
+    { ahora: "2027-03-26T20:00", porcentaje: 0 }, // 48 horas reales
+    { ahora: "2027-03-26T20:01", porcentaje: 0.25 },
+    { ahora: "2027-03-26T20:30", porcentaje: 0.25 }, // ejemplo de la spec: 47,5 h
+    { ahora: "2027-03-27T20:00", porcentaje: 0.25 }, // 24 horas reales
+    { ahora: "2027-03-27T20:01", porcentaje: 0.5 },
+    { ahora: "2027-03-28T20:59", porcentaje: 0.5 },
+    { ahora: "2027-10-29T21:30", inicio: "2027-10-31T21:00", porcentaje: 0 }, // 48,5 h
+    { ahora: "2027-10-30T21:30", inicio: "2027-10-31T21:00", porcentaje: 0.25 }, // 24,5 h
+  ];
+  for (const caso of casos) await t.test(caso.ahora, async () => {
+    const api = await arrancarApi();
+    try {
+      const r = await crear(api, caso.inicio);
+      assert.equal(r.importe, 2800);
+      await reloj(api, caso.ahora);
+      const ruta = `/api/reservas/${r.id}/cancelar`;
+      if (caso.porcentaje === 0.5) {
+        for (const cuerpo of [{}, { forzar: false }]) {
+          const fallo = await api.pedir("POST", ruta, { cuerpo });
+          assert.equal(fallo.status, 409);
+          assert.equal(fallo.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+        }
+        assert.equal((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva.estado, "confirmada");
+      }
+      const cancelada = await api.pedir("POST", ruta, { cuerpo: { forzar: caso.porcentaje === 0.5 } });
+      assert.equal(cancelada.status, 200);
+      assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+      assert.equal(cancelada.cuerpo.reserva.penalizacion, r.importe * caso.porcentaje);
+      assert.equal(cancelada.cuerpo.reembolso, r.importe * (1 - caso.porcentaje));
+    } finally { api.cerrar(); }
+  });
+});
+
+test("exención: permisos, motivo y conservación de una cancelación", async () => {
+  const api = await arrancarApi();
+  try {
+    const r = await crear(api);
+    await reloj(api, "2027-03-28T20:59");
+    const ruta = `/api/reservas/${r.id}/cancelar`;
+    const motivo = "Lesión durante el entrenamiento";
+    for (const [socio, status, codigo] of [
+      [undefined, 401, "NO_IDENTIFICADO"], ["socio-999", 401, "NO_IDENTIFICADO"],
+      ["socio-041", 403, "SIN_PERMISO"],
+    ] as const) {
+      const fallo = await api.pedir("POST", ruta, { socio, cuerpo: { exento: true, motivo } });
+      assert.equal(fallo.status, status);
+      assert.equal(fallo.cuerpo.error.codigo, codigo);
+    }
+    for (const motivo of [undefined, "corto", "         ", 123]) {
+      const fallo = await api.pedir("POST", ruta, { socio: gestor, cuerpo: { exento: true, motivo } });
+      assert.equal(fallo.status, 400);
+      assert.equal(fallo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    for (const cuerpo of [{ exento: "true" }, { forzar: "true" }]) {
+      assert.equal((await api.pedir("POST", ruta, { socio: gestor, cuerpo })).status, 400);
+    }
+    const cancelada = await api.pedir("POST", ruta, { socio: gestor, cuerpo: { exento: true, motivo } });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 0);
+    assert.equal(cancelada.cuerpo.reserva.motivoCancelacion, motivo);
+    assert.equal(cancelada.cuerpo.reembolso, r.importe);
+    const repetida = await api.pedir("POST", ruta, { cuerpo: { forzar: true } });
+    assert.equal(repetida.status, 409);
+    assert.equal(repetida.cuerpo.error.codigo, "YA_CANCELADA");
+    assert.deepEqual((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva, cancelada.cuerpo.reserva);
+  } finally { api.cerrar(); }
+});
+
+test("una reserva empezada o pasada no se cancela, tampoco con exención", async () => {
+  const api = await arrancarApi();
+  try {
+    const r = await crear(api);
+    for (const ahora of [r.inicio, "2027-03-29T10:00"]) {
