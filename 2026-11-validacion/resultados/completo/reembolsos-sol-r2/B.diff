+    const repetida = await api.pedir("POST", `/api/reservas/${cancelada.id}/cancelar`, { socio: gestor, cuerpo: { exento: true, motivo: "Cambio posterior del motivo" } });
+    assert.equal(repetida.cuerpo.error.codigo, "YA_CANCELADA");
+    const marzo = await api.pedir("GET", "/api/informes/caja?mes=2027-03", { socio: gestor });
+    assert.deepEqual(marzo.cuerpo.total, { reservas: 1, ingresos: confirmada.importe, penalizaciones: 900, total: confirmada.importe + 900 });
+    assert.deepEqual(marzo.cuerpo.pistas[1], { pistaId: "pista-2", reservas: 0, ingresos: 0, penalizaciones: 900, total: 900 });
