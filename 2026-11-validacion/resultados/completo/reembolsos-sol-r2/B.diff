+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    assert.equal((await api.pedir("GET", "/api/informes/caja", { socio: gestor })).status, 400);
+    const r = await api.pedir("GET", "/api/informes/caja?mes=2030-01", { socio: gestor });
+    const cero = { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 };
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, { mes: "2030-01", pistas: [1, 2, 3, 4].map((n) => ({ pistaId: `pista-${n}`, ...cero })), total: cero });
+  } finally { api.cerrar(); }
+});
+
+test("caja agrega ingresos y penalizaciones por inicio, conservando el historial", async () => {
+  const api = await arrancarApi();
+  try {
+    const inicial: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    // Movimientos de marzo cancelados en febrero: la caja los cuenta en marzo.
+    const confirmada = await crear(api, "2027-03-01T09:00");
+    const cancelada = await crear(api, "2027-03-01T10:30", "pista-2");
