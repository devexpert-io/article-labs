+test("cancelación de serie respeta las 24 horas y solo fuerza las futuras con penalización", async (t) => {
+  const api = await preparar(t);
+  const creada = await crear(api, { semanas: 4 });
+  const id = creada.cuerpo.serie.id;
+  const ruta = `/api/series/${id}/cancelar`;
+  const originales = await consultar(api, id);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-18T19:30" } });
+  error(await api.pedir("POST", ruta, { socio: "socio-040", cuerpo: { forzar: "true" } }), 400, "DATOS_INVALIDOS");
+  assert.deepEqual(await consultar(api, id), originales);
+  // Primeras dos ya empezadas; la tercera está exactamente a 24 horas.
+  const cancelada = await api.pedir("POST", ruta, { socio: "socio-040" });
+  assert.equal(cancelada.status, 200);
+  assert.deepEqual(cancelada.cuerpo.canceladas.map((r: Reserva) => r.id), originales.slice(2).map((r) => r.id));
+  assert.deepEqual(cancelada.cuerpo.pendientes, []);
+  assert.ok(cancelada.cuerpo.canceladas.every((r: Reserva) => r.estado === "cancelada" && r.penalizacion === undefined));
+  assert.deepEqual((await consultar(api, id)).slice(0, 2), originales.slice(0, 2));
+  const otra = await crear(api, { inicio: "2027-02-02T19:30", semanas: 2 });
+  const otroId = otra.cuerpo.serie.id;
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-01T19:31" } });
+  const parcial = await api.pedir("POST", `/api/series/${otroId}/cancelar`, { socio: "socio-040", cuerpo: { forzar: false } });
+  assert.equal(parcial.cuerpo.canceladas.length, 1);
+  assert.equal(parcial.cuerpo.pendientes.length, 1);
+  assert.equal(parcial.cuerpo.pendientes[0].estado, "confirmada");
+  const forzada = await api.pedir("POST", `/api/series/${otroId}/cancelar`, { socio: "socio-040", cuerpo: { forzar: true } });
+  assert.equal(forzada.cuerpo.canceladas.length, 1);
+  assert.deepEqual(forzada.cuerpo.pendientes, []);
+  assert.equal(forzada.cuerpo.canceladas[0].penalizacion, 2800);
+  const repetida = await api.pedir("POST", `/api/series/${otroId}/cancelar`, { socio: "socio-040", cuerpo: { forzar: true } });
+  assert.deepEqual(repetida.cuerpo.canceladas, []);
+  assert.deepEqual(repetida.cuerpo.pendientes, []);
+});
