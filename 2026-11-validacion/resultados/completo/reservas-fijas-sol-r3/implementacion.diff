+  assert.equal(despues[0]!.estado, "cancelada");
+  assert.equal(despues[1]!.estado, "cancelada");
+  assert.deepEqual(despues[2], originales[2]);
+  const todas = await api.pedir("POST", `/api/series/${id}/cancelar`, { socio: "socio-040" });
+  assert.equal(todas.cuerpo.canceladas.length, 1);
+  assert.equal((await consultar(api, id))[1]!.penalizacion, segunda.importe);
