+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import type { Reserva } from "../src/tipos.ts";
+
+const datos = { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-05T19:30", semanas: 2 };
+async function preparar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+function crear(api: Api, cambios: Record<string, unknown> = {}) {
+  return api.pedir("POST", "/api/series", { socio: "socio-040", cuerpo: { ...datos, ...cambios } });
+}
+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status, r.texto);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+async function consultar(api: Api, id: string): Promise<Reserva[]> {
+  const r = await api.pedir("GET", `/api/series/${id}`, { socio: "socio-040" });
+  assert.equal(r.status, 200);
+  return r.cuerpo.serie.reservas;
+}
+
+test("solo el gestor puede crear, consultar y cancelar series", async (t) => {
+  const api = await preparar(t);
+  const creada = await crear(api);
+  assert.equal(creada.status, 201);
+  const id = creada.cuerpo.serie.id;
+  for (const [metodo, ruta] of [["POST", "/api/series"], ["GET", `/api/series/${id}`], ["POST", `/api/series/${id}/cancelar`]]) {
+    for (const socio of [undefined, "socio-041", "desconocido"]) {
+      error(await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? datos : undefined }),
+        socio === "socio-041" ? 403 : 401, socio === "socio-041" ? "SIN_PERMISO" : "NO_IDENTIFICADO");
+    }
+  }
+  assert.equal((await consultar(api, id)).length, 2);
+  assert.equal((await api.pedir("POST", `/api/series/${id}/cancelar`, { socio: "socio-040" })).status, 200);
+});
+
+test("validación de datos y reglas de toda la serie sin cambios parciales", async (t) => {
+  const api = await preparar(t);
