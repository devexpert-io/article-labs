+  error(await api.pedir("POST", `/api/reservas/${segunda.id}/cancelar`), 409, "FUERA_DE_PLAZO");
+  const forzada = await api.pedir("POST", `/api/reservas/${segunda.id}/cancelar`, { cuerpo: { forzar: true } });
