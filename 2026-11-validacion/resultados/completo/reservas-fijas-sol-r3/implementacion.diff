+  for (const semanas of [undefined, null, "2", 1, 13, 2.5, 0]) {
+    error(await crear(api, { semanas }), 400, "DATOS_INVALIDOS");
+  }
+  error(await crear(api, { socioId: undefined }), 400, "DATOS_INVALIDOS");
+  error(await crear(api, { socioId: "nadie" }), 404, "SOCIO_NO_ENCONTRADO");
+  error(await crear(api, { pistaId: "ninguna" }), 404, "PISTA_NO_ENCONTRADA");
