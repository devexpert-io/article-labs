@@ -0,0 +1,189 @@
+// La exportación de reservas a CSV: permisos, formato y validación del periodo.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+/** Trocea un CSV de líneas simples (sin saltos de línea dentro de campos) y comprueba el CRLF final. */
+function lineas(csv: string): string[] {
+  assert.ok(csv.endsWith("\r\n"), "el CSV debe terminar en CRLF");
+  const trozos = csv.split("\r\n");
+  assert.equal(trozos.at(-1), "", "no debe quedar nada después del último CRLF");
+  return trozos.slice(0, -1);
+}
+
+function exportar(consulta: string) {
+  return api.pedir("GET", `/api/reservas/exportar?${consulta}`, { socio: GESTOR });
+}
+
+test("solo un gestor puede exportar", async () => {
+  const sinSocio = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19");
+  assert.equal(sinSocio.status, 401);
+  assert.equal(sinSocio.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const noGestor = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19", { socio: "socio-004" });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const desconocido = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19", { socio: "socio-999" });
+  assert.equal(desconocido.status, 401);
+  assert.equal(desconocido.cuerpo.error.codigo, "NO_IDENTIFICADO");
+});
+
+test("responde 200 con el CSV y su nombre de fichero", async () => {
+  const r = await exportar("desde=2026-11-01&hasta=2026-11-07");
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-11-01-2026-11-07.csv"');
+  assert.equal(typeof r.cuerpo, "string", "el cuerpo no es JSON");
+  assert.ok(r.texto.startsWith(CABECERA + "\r\n"));
+});
+
+test("la cabecera es exacta y cada línea termina en CRLF", async () => {
+  const csv = (await exportar("desde=2026-11-19&hasta=2026-11-19")).texto;
+  const filas = lineas(csv);
+  assert.equal(filas[0], CABECERA);
+  assert.deepEqual(filas[0]!.split(","), ["id", "fecha", "hora", "pista", "socio", "email", "estado", "importe", "penalizacion", "notas"]);
+  assert.equal(csv.split("\r\n").length - 1, filas.length, "no hay saltos de línea sueltos");
+});
+
+test("hay una fila por reserva del periodo, ordenadas por inicio y pista", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const esperadas = estado.reservas
+    .filter((r: any) => r.inicio.slice(0, 10) >= "2026-11-19" && r.inicio.slice(0, 10) <= "2026-11-21")
+    .sort((a: any, b: any) => (a.inicio === b.inicio ? a.pistaId.localeCompare(b.pistaId) : a.inicio.localeCompare(b.inicio)));
+
+  const filas = lineas((await exportar("desde=2026-11-19&hasta=2026-11-21")).texto).slice(1);
+  assert.deepEqual(filas.map((f) => f.split(",")[0]), esperadas.map((r: any) => r.id));
+
+  // `pista` lleva el nombre de la pista, no su id.
+  const nombres = esperadas.map((r: any) => `,${estado.pistas.find((p: any) => p.id === r.pistaId).nombre},`);
+  filas.forEach((fila, i) => assert.ok(fila.includes(nombres[i]!), `${fila} debe incluir el nombre de la pista`));
+});
+
+test("los importes van en euros con dos decimales y la penalización vacía si no la hay", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const filas = lineas((await exportar("desde=2026-11-19&hasta=2026-11-19")).texto).slice(1);
+  for (const fila of filas) {
+    const campos = fila.split(",");
+    const reserva = estado.reservas.find((r: any) => r.id === campos[0]);
+    assert.equal(campos[7], (reserva.importe / 100).toFixed(2), `${reserva.id}: importe en euros`);
+    assert.equal(campos[8], reserva.penalizacion === undefined ? "" : (reserva.penalizacion / 100).toFixed(2), `${reserva.id}: penalización`);
+  }
+  // El 09:00 del jueves en la pista 3 vale 12,00 € y no tiene penalización.
+  const marta = estado.reservas.find((r: any) => r.inicio === "2026-11-19T09:00" && r.pistaId === "pista-3");
+  const suya = filas.find((f) => f.startsWith(`${marta.id},`))!;
+  assert.equal(suya.split(",")[7], "12.00");
+  assert.equal(suya.split(",")[8], "");
+});
+
+test("una cancelación con penalización sale en euros", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  // Una reserva de las próximas 24 horas: se cancela solo con forzar y con penalización.
+  const candidata = estado.reservas.find((r: any) => r.estado === "confirmada" && r.inicio > "2026-11-18T10:00" && r.inicio < "2026-11-19T10:00");
+  const cancelada = await api.pedir("POST", `/api/reservas/${candidata.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+
+  const dia = candidata.inicio.slice(0, 10);
+  const filas = lineas((await exportar(`desde=${dia}&hasta=${dia}`)).texto).slice(1);
+  const campos = filas.find((f) => f.startsWith(`${candidata.id},`))!.split(",");
+  assert.equal(campos[6], "cancelada");
+  assert.equal(campos[8], (candidata.importe / 100).toFixed(2));
+});
+
+test("los campos con comas, comillas o saltos de línea se escapan según el RFC 4180", async () => {
+  const disponibilidad = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-24&pista=pista-1")).cuerpo;
+  const libre = disponibilidad.pistas[0].franjas.find((f: any) => f.estado === "libre");
+  const notas = 'Palas, bolas "nuevas"\ny red';
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: libre.inicio, notas } });
+  assert.equal(creada.status, 201);
+
+  const csv = (await exportar("desde=2026-11-24&hasta=2026-11-24")).texto;
+  const fila = `${creada.cuerpo.reserva.id},2026-11-24,${libre.inicio.slice(11)},Pista 1,Nora Benítez,nora.benitez@example.com,confirmada,${(creada.cuerpo.reserva.importe / 100).toFixed(2)},,"Palas, bolas ""nuevas""\ny red"`;
+  assert.ok(csv.includes(fila + "\r\n"), csv);
+  // Los campos que no lo necesitan van sin comillas.
+  assert.ok(csv.includes(`,Pista 1,Nora Benítez,nora.benitez@example.com,confirmada,`), csv);
+});
+
+test("las notas que parecen fórmulas no se ejecutan al abrir el CSV", async () => {
+  const disponibilidad = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-25&pista=pista-1")).cuerpo;
+  const libre = disponibilidad.pistas[0].franjas.find((f: any) => f.estado === "libre");
+  const notas = '=HYPERLINK("http://example.com","pulsa")';
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: libre.inicio, notas } });
+  assert.equal(creada.status, 201);
+
+  const csv = (await exportar("desde=2026-11-25&hasta=2026-11-25")).texto;
+  const fila = lineas(csv).find((f) => f.startsWith(`${creada.cuerpo.reserva.id},`))!;
+  // La nota va prefijada con un apóstrofo para que la hoja de cálculo la trate como texto, y luego escapada.
+  assert.ok(fila.endsWith(`,"'=HYPERLINK(""http://example.com"",""pulsa"")"`), fila);
+  assert.ok(!csv.includes(",=HYPERLINK"), "la fórmula no puede salir tal cual");
+});
+
+test("desde y hasta son obligatorios, válidos y en orden", async () => {
+  for (const consulta of ["", "hasta=2026-11-19", "desde=2026-11-19", "desde=2026-1-9&hasta=2026-11-19", "desde=2026-11-20&hasta=2026-11-19"]) {
+    const r = await exportar(consulta);
+    assert.equal(r.status, 400, `«${consulta}» debe dar 400`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", `«${consulta}»`);
+  }
+});
+
+test("las fechas del periodo tienen que existir en el calendario", async () => {
+  for (const fecha of ["2026-02-30", "2026-02-29", "2026-04-31", "2026-09-31", "2026-11-31"]) {
+    const r = await exportar(`desde=${fecha}&hasta=${fecha}`);
+    assert.equal(r.status, 400, `«${fecha}» no existe y no puede dar 200`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", `«${fecha}»`);
