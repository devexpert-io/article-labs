+    ["2026-11-30T18:00", 120, "pista-3", 2667],
+    ["2026-12-01T17:30", 90, "pista-1", 2467],
+    ["2026-11-30T17:30", 60, "pista-3", 1067],
+    ["2026-11-30T17:00", 120, "pista-1", 3067],
+    ["2026-11-30T17:00", 60, "pista-1", 1200],
+    ["2026-11-28T09:00", 60, "pista-1", 1867],
+    ["2026-11-29T17:30", 120, "pista-1", 3733],
+  ] as const;
+  for (const [inicio, duracion, pista, importe] of casos) {
+    await t.test(`${inicio}/${duracion}/${pista}`, async (t) => {
+      const api = await preparar(t);
+      const r = await reservar(api, inicio, duracion, pista);
