index 0000000..75d7a22
--- /dev/null
+++ b/test/duraciones.test.ts
@@ -0,0 +1,188 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function preparar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+function reservar(api: Api, inicio: string, duracion?: unknown, pistaId = "pista-1", socioId = "socio-041") {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio, duracion } });
+}
+
+async function error(respuesta: ReturnType<typeof reservar>, status: number, codigo: string) {
+  const r = await respuesta;
+  assert.equal(r.status, status, r.texto);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+async function disponibilidad(api: Api, fecha = "2026-11-30", pista = "pista-1") {
+  const r = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pista}`);
+  assert.equal(r.status, 200);
+  return r.cuerpo.pistas[0];
+}
+
+test("duraciones válidas, valor por defecto y fin", async (t) => {
+  for (const [duracion, fin] of [[60, "10:00"], [90, "10:30"], [120, "11:00"], [undefined, "10:30"]] as const) {
+    await t.test(String(duracion), async (t) => {
+      const api = await preparar(t);
+      const r = await reservar(api, "2026-11-30T09:00", duracion);
+      assert.equal(r.status, 201, r.texto);
+      assert.equal(r.cuerpo.reserva.duracion, duracion ?? 90);
+      assert.equal(r.cuerpo.reserva.fin, `2026-11-30T${fin}`);
+    });
+  }
+});
+
+test("duraciones inválidas responden 400 DURACION_INVALIDA", async (t) => {
+  const api = await preparar(t);
+  for (const duracion of [null, 0, -60, 30, 61, 90.5, 180, "60", "90", true, {}, [], [60]]) {
+    await error(reservar(api, "2026-11-30T09:00", duracion), 400, "DURACION_INVALIDA");
+  }
+});
+
+test("inicios en punto o y media y límites de apertura y cierre", async (t) => {
+  const api = await preparar(t);
+  for (const inicio of ["08:30", "09:15", "10:45", "22:00", "22:30", "23:00", "24:00", "10:60"]) {
+    await error(reservar(api, `2026-11-30T${inicio}`, 60), 400, "FRANJA_INVALIDA");
+  }
+  await error(reservar(api, "2026-11-30 10:00", 60), 400, "FRANJA_INVALIDA");
+  for (const [inicio, duracion] of [["21:30", 90], ["21:00", 120]] as const) {
+    await error(reservar(api, `2026-11-30T${inicio}`, duracion), 400, "FRANJA_INVALIDA");
+  }
+  for (const [dia, inicio, duracion] of [["30", "21:30", 60], ["29", "21:00", 90], ["28", "20:30", 120]] as const) {
+    const r = await reservar(api, `2026-11-${dia}T${inicio}`, duracion);
+    assert.equal(r.status, 201, r.texto);
+    assert.equal(r.cuerpo.reserva.fin, `2026-11-${dia}T22:30`);
+  }
+});
+
+test("solapes parciales, inclusión, extremos consecutivos y canceladas", async (t) => {
+  const api = await preparar(t);
+  const creada = await reservar(api, "2026-11-30T10:00", 120);
+  assert.equal(creada.status, 201);
+  for (const [inicio, duracion] of [["09:30", 60], ["10:00", 60], ["10:30", 60], ["11:30", 90], ["09:30", 120]] as const) {
+    await error(reservar(api, `2026-11-30T${inicio}`, duracion), 409, "FRANJA_NO_DISPONIBLE");
+  }
+  assert.equal((await reservar(api, "2026-11-30T09:00", 60)).status, 201);
+  assert.equal((await reservar(api, "2026-11-30T12:00", 60)).status, 201);
+  assert.equal((await reservar(api, "2026-11-30T10:00", 60, "pista-2", "socio-002")).status, 201);
+  const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.duracion, 120);
+  assert.equal((await reservar(api, "2026-11-30T10:30", 60)).status, 201);
+});
+
+test("solapes con reservas antiguas y duración en listado, detalle y cancelación", async (t) => {
+  const api = await preparar(t);
+  await error(reservar(api, "2026-11-19T19:00", 60), 409, "FRANJA_NO_DISPONIBLE");
+  await error(reservar(api, "2026-11-19T20:30", 60), 409, "FRANJA_NO_DISPONIBLE");
+  const listado = await api.pedir("GET", "/api/reservas?fecha=2026-11-19&pista=pista-1");
+  assert.ok(listado.cuerpo.reservas.length > 0);
