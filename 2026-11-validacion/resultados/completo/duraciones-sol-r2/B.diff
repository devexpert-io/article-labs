+  }
+});
+
+test("todas las franjas tradicionales mantienen su precio en cada pista", async (t) => {
+  const api = await preparar(t);
+  for (const fecha of ["2026-11-30", "2026-11-28", "2026-11-29"]) {
+    const respuesta = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`);
+    for (const pista of respuesta.cuerpo.pistas) {
