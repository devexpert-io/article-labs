+  }
+  const antigua = listado.cuerpo.reservas.find((r: any) => r.inicio.endsWith("19:30"));
+  const cancelada = await api.pedir("POST", `/api/reservas/${antigua.id}/cancelar`);
+  assert.equal(cancelada.cuerpo.reserva.duracion, 90);
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.ok(estado.reservas.every((r: any) => r.duracion === 90));
+});
+
+test("precio por minutos: valle, punta, cruce y fines de semana", async (t) => {
+  const casos = [
+    ["2026-11-30T12:00", 60, "pista-1", 1200],
+    ["2026-11-30T12:00", 120, "pista-3", 1600],
