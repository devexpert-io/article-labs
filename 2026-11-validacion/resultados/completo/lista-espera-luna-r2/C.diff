+test("asignación descarta cuota inactiva y tres reservas futuras antes del siguiente elegible", () => {
+  const estado = crearSemilla();
+  estado.ahora = "2026-11-18T10:00";
+  const objetivo = estado.reservas.find((r) => r.estado === "confirmada" && r.inicio > estado.ahora)!;
+  // Aísla el hueco objetivo y tres reservas futuras que hacen inelegible al primer socio.
+  estado.reservas = [objetivo];
+  estado.socios.find((s) => s.id === "socio-011")!.cuotaActiva = true;
+  const club = crearClub(estado);
+  club.crearEspera({ socioId: "socio-011", pistaId: objetivo.pistaId, inicio: objetivo.inicio });
+  club.crearEspera({ socioId: "socio-014", pistaId: objetivo.pistaId, inicio: objetivo.inicio });
+  club.crearEspera({ socioId: "socio-003", pistaId: objetivo.pistaId, inicio: objetivo.inicio });
+  // La cuota puede cambiar entre apuntarse y la cancelación.
+  estado.socios.find((s) => s.id === "socio-011")!.cuotaActiva = false;
+  for (let n = 0; n < 3; n++) {
+    estado.reservas.push({ ...objetivo, id: `R-extra-${n}`, socioId: "socio-014", inicio: `2026-11-${20 + n}T12:00`, fin: `2026-11-${20 + n}T13:30` });
+  }
+
+  const resultado = club.cancelarReserva(objetivo.id, { forzar: true });
+  const esperas = estado.esperas;
+  assert.deepEqual(esperas.map((e) => e.estado), ["descartada", "descartada", "asignada"]);
+  assert.equal(esperas[2]?.socioId, "socio-003");
+  const destino = estado.reservas.find((r) => r.id === resultado.asignadaA);
+  assert.equal(destino?.socioId, "socio-003");
+});
