+test("dos esperas caducadas liberan las dos plazas del límite", async () => {
+  const otra = await arrancarApi({ AHORA: "2026-11-18T10:00" });
+  try {
+    const estado = (await otra.pedir("GET", "/_estado")).cuerpo;
+    const ocupadas = estado.reservas.filter((r: any) => r.estado === "confirmada" && r.inicio > estado.ahora && r.socioId !== "socio-041");
+    const primera = ocupadas[0];
+    const segunda = ocupadas.find((r: any) => r.inicio !== primera.inicio);
+    assert.ok(primera && segunda);
+    for (const r of [primera, segunda]) {
+      assert.equal((await otra.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: { pistaId: r.pistaId, inicio: r.inicio } })).status, 201);
+    }
+    const vencimiento = primera.inicio > segunda.inicio ? primera.inicio : segunda.inicio;
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: vencimiento } });
+    const futuras = ocupadas.filter((r: any) => r.inicio > vencimiento).slice(0, 2);
+    assert.equal(futuras.length, 2);
+    for (const r of futuras) {
+      assert.equal((await otra.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: { pistaId: r.pistaId, inicio: r.inicio } })).status, 201);
+    }
+  } finally {
+    otra.cerrar();
+  }
+});
