+test("5. el redondeo es al céntimo más cercano, con medio céntimo hacia arriba", () => {
+  const pista = (precioValle: number, precioPunta: number): Pista =>
+    ({ id: "p", nombre: "P", tipo: "cristal", cubierta: true, estado: "operativa", precioValle, precioPunta });
+  // Martes: 30 minutos de valle a 1801 son 600,33 → 600; a 1802, 600,67 → 601.
+  assert.equal(precioPorMinutos(pista(1801, 0), "2026-11-24T17:30", 30), 600);
+  assert.equal(precioPorMinutos(pista(1802, 0), "2026-11-24T17:30", 30), 601);
+  // Con bloques de 30 minutos y precios enteros no sale nunca medio céntimo, así que se prueba con 1 minuto.
+  assert.equal(precioPorMinutos(pista(45, 45), "2026-11-24T10:00", 1), 1);
+  assert.equal(precioPorMinutos(pista(135, 135), "2026-11-24T10:00", 1), 2); // 1,5 → 2
+  assert.equal(precioPorMinutos(pista(44, 44), "2026-11-24T10:00", 1), 0); // 0,49 → 0
+});
