+test("5. el importe se calcula por minutos, también al cruzar las 18:00 y en fin de semana", async () => {
+  const casos: [string, string, string, number, number][] = [
+    // pista, fecha, hora, duración, importe
+    ["pista-1", MARTES, "17:30", 90, 2467], // 600 + 1866,67
+    ["pista-1", MARTES, "09:00", 60, 1200],
+    ["pista-1", MARTES, "10:00", 120, 2400],
+    ["pista-1", MARTES, "15:30", 120, 2400], // termina a las 17:30, todo valle
+    ["pista-1", MARTES, "20:30", 120, 3733], // 3733,33
+    ["pista-3", "2026-11-19", "17:00", 120, 2133], // 60 × 1200/90 + 60 × 2000/90 = 800 + 1333,33
+    ["pista-3", MARTES, "16:30", 120, 1867], // 90 × 1200/90 + 30 × 2000/90 = 1200 + 666,67
+    ["pista-2", "2026-11-21", "09:00", 60, 1867], // sábado: 1866,67
+    ["pista-2", "2026-11-21", "12:00", 120, 3733], // sábado: 3733,33
+    ["pista-3", "2026-11-22", "14:00", 90, 2000], // domingo
+  ];
+  // Socios con la cuota al día y sin reservas futuras que les acerquen al límite.
+  const socios = ["socio-003", "socio-006", "socio-007", "socio-008", "socio-009", "socio-010", "socio-012", "socio-013", "socio-014", "socio-016"];
+  for (const [i, [pistaId, fecha, hora, duracion, importe]] of casos.entries()) {
+    const socioId = socios[i]!;
+    const r = await reservar({ socioId, pistaId, inicio: `${fecha}T${hora}`, duracion });
+    assert.equal(r.status, 201, `${pistaId} ${fecha} ${hora}: ${JSON.stringify(r.cuerpo)}`);
+    assert.equal(r.cuerpo.reserva.importe, importe, `${pistaId} ${fecha} ${hora} + ${duracion}`);
+  }
+});
