+test("9. huecos: los intervalos libres más largos del día, ordenados y sin tener en cuenta la hora actual", async () => {
+  const h = (p: any) => p.huecos.map((x: any) => `${x.inicio.slice(11)}-${x.fin.slice(11)}`);
+  assert.deepEqual(h(await franjas(MARTES, "pista-1")), ["09:00-22:30"]);
+  await reservar({ socioId: "socio-003", pistaId: "pista-1", inicio: `${MARTES}T14:00`, duracion: 60 });
+  await reservar({ socioId: "socio-006", pistaId: "pista-1", inicio: `${MARTES}T09:00`, duracion: 120 });
+  await reservar({ socioId: "socio-007", pistaId: "pista-1", inicio: `${MARTES}T15:00`, duracion: 90 });
+  await reservar({ socioId: "socio-008", pistaId: "pista-1", inicio: `${MARTES}T21:30`, duracion: 60 });
+  const cancelada = await reservar({ socioId: "socio-009", pistaId: "pista-1", inicio: `${MARTES}T19:00`, duracion: 60 });
+  await api.pedir("POST", `/api/reservas/${cancelada.cuerpo.reserva.id}/cancelar`);
+  const pista1 = await franjas(MARTES, "pista-1");
+  assert.deepEqual(h(pista1), ["11:00-14:00", "16:30-21:30"]);
+  assert.deepEqual(pista1.huecos[0], { inicio: `${MARTES}T11:00`, fin: `${MARTES}T14:00` });
+  // Hoy (miércoles 18, 10:00) también cuenta lo que ya ha pasado.
+  const hoy = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-18");
+  for (const p of hoy.cuerpo.pistas.filter((p: any) => p.estado === "operativa")) {
+    assert.ok(p.huecos.length > 0);
+    const libresAntes = p.franjas.filter((f: any) => f.inicio.endsWith("09:00") && f.estado === "libre").length;
+    if (libresAntes) assert.equal(p.huecos[0].inicio, "2026-11-18T09:00");
+  }
+  // Una pista cerrada no tiene huecos.
+  assert.deepEqual((await franjas(MARTES, "pista-4")).huecos, []);
+  // Las mismas franjas de 90 minutos de siempre.
+  assert.deepEqual(pista1.franjas.map((f: any) => f.inicio.slice(11)), HORAS);
+});
