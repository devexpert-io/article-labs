+/** Minutos desde las 00:00 de una hora `HH:MM` o de una fecha y hora `AAAA-MM-DDTHH:MM`. */
+export function minutosDelDia(hora: string): number {
+  const [h, m] = hora.slice(-5).split(":").map(Number);
+  return h! * 60 + m!;
+}
+
+/** Suma minutos a una fecha y hora del mismo día. */
+export function sumarMinutos(inicio: string, minutos: number): string {
+  const total = minutosDelDia(inicio) + minutos;
   const hh = String(Math.floor(total / 60)).padStart(2, "0");
   const mm = String(total % 60).padStart(2, "0");
   return `${inicio.slice(0, 10)}T${hh}:${mm}`;
 }
 
+export function finDeFranja(inicio: string): string {
+  return sumarMinutos(inicio, MINUTOS_FRANJA);
+}
+
+/**
+ * Precio por minutos: cada minuto vale el precio de la franja de 90 minutos entre 90, a valle
+ * de lunes a viernes antes de las 18:00 y a punta el resto. Se redondea al céntimo, medio hacia arriba.
+ */
+export function precioPorMinutos(pista: Pista, inicio: string, duracion: number): number {
+  const dia = diaDeLaSemana(inicio.slice(0, 10));
+  const desde = minutosDelDia(inicio);
+  const hasta = desde + duracion;
+  const finDeSemana = dia === 0 || dia === 6;
+  const corte = minutosDelDia("18:00");
+  const valle = finDeSemana ? 0 : Math.max(0, Math.min(hasta, corte) - desde);
+  const punta = duracion - valle;
+  // Céntimos × 90, en enteros, para redondear sin errores de coma flotante.
+  const total = valle * pista.precioValle + punta * pista.precioPunta;
+  return Math.floor((2 * total + MINUTOS_FRANJA) / (2 * MINUTOS_FRANJA));
+}
