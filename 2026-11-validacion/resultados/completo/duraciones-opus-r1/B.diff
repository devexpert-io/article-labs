+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Cada test parte de la semilla recién arrancada.
+let api: Api;
+beforeEach(async () => {
+  api = await arrancarApi();
+});
+afterEach(() => api.cerrar());
+
+const reservar = (cuerpo: Record<string, unknown>) => api.pedir("POST", "/api/reservas", { cuerpo });
+const franjas = async (fecha: string, pista: string) =>
+  (await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pista}`)).cuerpo.pistas[0];
+
+// El martes 24 de noviembre la pista 1 está libre todo el día.
+const MARTES = "2026-11-24";
+
+test("1. duracion es opcional, vale 60, 90 o 120 y por defecto son 90", async () => {
+  for (const [duracion, inicio, fin] of [[60, "09:00", "10:00"], [90, "10:00", "11:30"], [120, "11:30", "13:30"]] as const) {
+    const r = await reservar({ socioId: `socio-00${duracion / 30}`, pistaId: "pista-1", inicio: `${MARTES}T${inicio}`, duracion });
+    assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+    assert.equal(r.cuerpo.reserva.duracion, duracion);
+    assert.equal(r.cuerpo.reserva.fin, `${MARTES}T${fin}`);
+  }
+  const porDefecto = await reservar({ socioId: "socio-003", pistaId: "pista-1", inicio: `${MARTES}T15:00` });
+  assert.equal(porDefecto.status, 201);
+  assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+  assert.equal(porDefecto.cuerpo.reserva.fin, `${MARTES}T16:30`);
+  for (const duracion of [0, 30, 45, 61, 150, "90", null, true, 90.5]) {
+    const r = await reservar({ socioId: "socio-006", pistaId: "pista-1", inicio: `${MARTES}T18:00`, duracion });
+    assert.equal(r.status, 400, `duracion ${JSON.stringify(duracion)}`);
+    assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA");
+  }
+});
+
+test("2. una reserva empieza en punto o y media, desde las 09:00, y termina como muy tarde a las 22:30", async () => {
+  const invalidos: [string, number][] = [
+    ["09:15", 60], ["10:45", 90], ["08:30", 60], ["08:00", 120], ["21:30", 90], ["21:00", 120], ["22:00", 60], ["22:30", 60], ["24:00", 60],
