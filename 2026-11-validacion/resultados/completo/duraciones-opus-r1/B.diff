+test("6. una reserva de 90 minutos a una hora de siempre cuesta lo mismo que antes", async () => {
+  const p: Pista = { id: "p", nombre: "P", tipo: "cristal", cubierta: true, estado: "operativa", precioValle: 1234, precioPunta: 2345 };
