+++ b/test/codigos-descuento.test.ts
@@ -0,0 +1,193 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { crearClub, ErrorDelClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+
+async function iniciar(t: TestContext, ahora?: string) {
+  const api = await arrancarApi(ahora ? { AHORA: ahora } : {});
+  t.after(() => api.cerrar());
+  return api;
+}
+
+function reservar(api: Api, codigo?: unknown, inicio = "2026-11-30T09:00", socioId = "socio-041", pistaId = "pista-1") {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio, codigo } });
+}
+
+function error(respuesta: Respuesta, status: number, codigo: string) {
+  assert.equal(respuesta.status, status, respuesta.texto);
+  assert.equal(respuesta.cuerpo.error.codigo, codigo);
+}
+
+function importes(respuesta: Respuesta, base: number, descuento: number, codigo?: string) {
+  assert.equal(respuesta.status, 201, respuesta.texto);
+  const r = respuesta.cuerpo.reserva;
+  assert.equal(r.importeBase, base);
+  assert.equal(r.descuento, descuento);
+  assert.equal(r.importe, base - descuento);
+  assert.equal(r.codigo, codigo);
+  if (codigo === undefined) assert.equal(Object.hasOwn(r, "codigo"), false);
+}
+
+test("sin código: guarda los importes, los devuelve en ambas consultas y no cambia el historial", async (t) => {
+  const api = await iniciar(t);
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo.reservas;
+  const creada = await reservar(api);
+  importes(creada, 1800, 0);
+  const r = creada.cuerpo.reserva;
+  assert.deepEqual((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva, r);
+  assert.deepEqual((await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.reservas, [r]);
+  const despues = (await api.pedir("GET", "/_estado")).cuerpo.reservas;
+  assert.deepEqual(despues.slice(0, -1), antes);
+});
+
+test("BIENVENIDA: primera reserva, código normalizado y datos persistidos", async (t) => {
+  const api = await iniciar(t);
+  const creada = await reservar(api, " bienvenida ", "2026-11-30T18:00");
+  importes(creada, 2800, 1400, "BIENVENIDA");
+  const r = creada.cuerpo.reserva;
+  assert.deepEqual((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva, r);
+  assert.deepEqual((await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.reservas, [r]);
+  error(await reservar(api, "BIENVENIDA", "2026-12-01T09:00"), 409, "CODIGO_NO_APLICABLE");
+  await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+  error(await reservar(api, "BIENVENIDA", "2026-12-01T09:00"), 409, "CODIGO_NO_APLICABLE");
+  // El historial de un socio también impide usar BIENVENIDA.
+  error(await reservar(api, "BIENVENIDA", "2026-12-01T09:00", "socio-004"), 409, "CODIGO_NO_APLICABLE");
+});
+
+test("BIENVENIDA: caduca según el reloj del club, con el 31 de diciembre incluido", async (t) => {
+  const api = await iniciar(t, "2026-12-31T23:59");
+  importes(await reservar(api, "BIENVENIDA", "2027-01-04T09:00"), 1800, 900, "BIENVENIDA");
+  const caducada = await iniciar(t, "2027-01-01T00:00");
+  error(await reservar(caducada, "BIENVENIDA", "2027-01-04T09:00"), 409, "CODIGO_NO_APLICABLE");
+  // Un fallo por caducidad no consume la primera reserva.
+  await caducada.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-31T23:59" } });
+  importes(await reservar(caducada, "BIENVENIDA", "2027-01-04T09:00"), 1800, 900, "BIENVENIDA");
+});
+
+test("MANANAS: lunes a viernes antes de las 12, sin límite de usos ni caducidad", async (t) => {
+  const api = await iniciar(t);
+  for (const inicio of ["2026-11-30T09:00", "2026-12-01T10:30", "2026-12-02T09:00", "2026-12-03T10:30", "2026-12-04T09:00", "2027-01-04T09:00"]) {
+    const creada = await reservar(api, "MANANAS", inicio, "socio-041", "pista-3");
+    importes(creada, 1200, 400, "MANANAS");
+    await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+  }
+  for (const inicio of ["2026-11-28T09:00", "2026-11-29T10:30", "2026-11-30T12:00", "2026-11-30T18:00"]) {
+    error(await reservar(api, "MANANAS", inicio), 409, "CODIGO_NO_APLICABLE");
+  }
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-01T10:00" } });
+  importes(await reservar(api, "MANANAS", "2027-01-04T10:30"), 1800, 400, "MANANAS");
+});
+
+test("CLUB10: tres usos por socio, incluso pasados, y las canceladas liberan un uso", async (t) => {
+  const api = await iniciar(t);
+  const creadas = [];
+  for (const inicio of ["2026-11-28T18:00", "2026-11-30T09:00", "2026-12-01T18:00"]) {
+    const creada = await reservar(api, "  club10 ", inicio);
+    const base = inicio.endsWith("09:00") ? 1800 : 2800;
+    importes(creada, base, base / 10, "CLUB10");
+    creadas.push(creada.cuerpo.reserva);
+  }
+  // El límite de reservas se aplica antes que el límite de usos del código.
+  error(await reservar(api, "CLUB10", "2026-12-02T09:00"), 409, "LIMITE_DE_RESERVAS");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-29T10:00" } });
+  error(await reservar(api, "CLUB10", "2026-12-02T09:00"), 409, "CODIGO_NO_APLICABLE");
+  importes(await reservar(api, "CLUB10", "2026-12-02T09:00", "socio-004", "pista-2"), 1800, 180, "CLUB10");
+  const cancelada = await api.pedir("POST", `/api/reservas/${creadas[2].id}/cancelar`);
+  assert.equal(cancelada.status, 200);
+  importes(await reservar(api, "CLUB10", "2026-12-02T09:00"), 1800, 180, "CLUB10");
+  error(await reservar(api, "CLUB10", "2026-12-03T09:00"), 409, "CODIGO_NO_APLICABLE");
+});
+
+test("formato: rechaza códigos desconocidos, vacíos, no textuales y combinaciones", async (t) => {
+  const api = await iniciar(t);
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+  for (const codigo of ["NO_EXISTE", "", "  ", "CLUB10 MANANAS", "CLUB10,MANANAS"]) {
+    error(await reservar(api, codigo), 400, "CODIGO_INVALIDO");
+  }
+  for (const codigo of [null, 10, true, {}, ["CLUB10"], ["CLUB10", "MANANAS"]]) {
+    error(await reservar(api, codigo), 400, "DATOS_INVALIDOS");
+  }
+  const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(despues.contador, antes.contador);
+  assert.deepEqual(despues.reservas, antes.reservas);
+  // Ningún intento fallido gastó BIENVENIDA.
+  importes(await reservar(api, "BIENVENIDA"), 1800, 900, "BIENVENIDA");
+});
+
+test("las reglas del club preceden incluso a un código inválido y los fallos no lo consumen", async (t) => {
+  const api = await iniciar(t);
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+  const casos = [
+    { socioId: "no-existe", pistaId: "pista-1", inicio: "2026-11-30T09:00", status: 404, error: "SOCIO_NO_ENCONTRADO" },
+    { socioId: "socio-041", pistaId: "no-existe", inicio: "2026-11-30T09:00", status: 404, error: "PISTA_NO_ENCONTRADA" },
+    { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-30T11:00", status: 400, error: "FRANJA_INVALIDA" },
+    { socioId: "socio-011", pistaId: "pista-1", inicio: "2026-11-30T09:00", status: 409, error: "CUOTA_INACTIVA" },
+    { socioId: "socio-041", pistaId: "pista-4", inicio: "2026-11-30T09:00", status: 409, error: "PISTA_CERRADA" },
+    { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-18T09:00", status: 409, error: "FRANJA_PASADA" },
+    { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-19T19:30", status: 409, error: "FRANJA_NO_DISPONIBLE" },
+  ];
+  for (const caso of casos) {
+    for (const codigo of ["BIENVENIDA", "INVALIDO", null]) {
+      error(await reservar(api, codigo, caso.inicio, caso.socioId, caso.pistaId), caso.status, caso.error);
+    }
+  }
+  const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(despues.contador, antes.contador);
+  assert.deepEqual(despues.reservas, antes.reservas);
+  importes(await reservar(api, "BIENVENIDA"), 1800, 900, "BIENVENIDA");
+  await reservar(api, undefined, "2026-12-01T09:00");
+  await reservar(api, undefined, "2026-12-02T09:00");
+  error(await reservar(api, "INVALIDO", "2026-12-03T09:00"), 409, "LIMITE_DE_RESERVAS");
+});
+
+test("la penalización usa el importe descontado y la disponibilidad conserva el precio base", async (t) => {
+  const api = await iniciar(t);
+  const ruta = "/api/disponibilidad?fecha=2026-11-30&pista=pista-1";
+  const antes = (await api.pedir("GET", ruta)).cuerpo;
+  const creada = await reservar(api, "BIENVENIDA");
+  importes(creada, 1800, 900, "BIENVENIDA");
+  const despues = (await api.pedir("GET", ruta)).cuerpo;
+  const precios = (datos: any) => datos.pistas[0].franjas.map((f: any) => f.precio);
+  assert.deepEqual(precios(despues), precios(antes));
+  assert.equal(despues.pistas[0].franjas[0].precio, 1800);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-29T10:00" } });
+  const rutaCancelar = `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`;
+  error(await api.pedir("POST", rutaCancelar), 409, "FUERA_DE_PLAZO");
+  const cancelada = await api.pedir("POST", rutaCancelar, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 900);
+  assert.equal(cancelada.cuerpo.reserva.importeBase, 1800);
+  assert.equal(cancelada.cuerpo.reserva.descuento, 900);
+  assert.equal(cancelada.cuerpo.reserva.codigo, "BIENVENIDA");
+});
+
+// La API no permite marcar no presentadas ni cambiar precios. Se prueban estas
+// condiciones con estados del dominio, sin añadir rutas fuera de la spec.
+test("CLUB10 cuenta las no presentadas y BIENVENIDA rechaza cualquier estado anterior", () => {
+  for (const estadoAnterior of ["confirmada", "cancelada", "no_presentada"] as const) {
+    const estado = crearSemilla();
+    estado.reservas = [{ ...estado.reservas[0]!, socioId: "socio-041", estado: estadoAnterior }];
+    const club = crearClub(estado);
+    assert.throws(() => club.crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-30T09:00", codigo: "BIENVENIDA" }),
+      (e: unknown) => e instanceof ErrorDelClub && e.http === 409 && e.codigo === "CODIGO_NO_APLICABLE");
+  }
+  const estado = crearSemilla();
+  estado.reservas = estado.reservas.slice(0, 3).map((r) => ({ ...r, socioId: "socio-041", estado: "no_presentada", codigo: "CLUB10" }));
+  const club = crearClub(estado);
+  const datos = { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-30T09:00", codigo: "CLUB10" };
+  assert.throws(() => club.crearReserva(datos), (e: unknown) => e instanceof ErrorDelClub && e.http === 409 && e.codigo === "CODIGO_NO_APLICABLE");
+  estado.reservas[0]!.estado = "cancelada";
+  assert.equal(club.crearReserva(datos).reserva.importe, 1620);
+});
+
+test("el descuento nunca supera el precio y los porcentajes se guardan en céntimos enteros", () => {
+  for (const [codigo, descuento] of [["MANANAS", 101], ["BIENVENIDA", 51], ["CLUB10", 10]] as const) {
+    const estado = crearSemilla();
+    estado.pistas[0]!.precioValle = 101;
+    const reserva = crearClub(estado).crearReserva({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-30T09:00", codigo }).reserva;
+    assert.equal(reserva.importeBase, 101);
+    assert.equal(reserva.descuento, descuento);
+    assert.equal(reserva.importe, 101 - descuento);
+  }
+});
