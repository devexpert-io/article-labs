+test("cancelar la serie: gratis a partir de 24 horas, pendientes las de menos plazo y forzar con penalización", async () => {
+  try {
+    assert.equal((await fijarReloj("2026-11-25T10:00")).status, 200);
+
+    // Empieza mañana a las 09:00: faltan 23 horas.
+    const creada = await crearSerie({ socioId: "socio-041", pistaId: "pista-2", inicio: "2026-11-26T09:00", semanas: 3 });
+    assert.equal(creada.status, 201);
+    const [primera, segunda, tercera] = creada.cuerpo.serie.reservas;
+    const cancelacion = await api.pedir("POST", `/api/series/${creada.cuerpo.serie.id}/cancelar`, { socio: GESTOR });
+    assert.equal(cancelacion.status, 200);
+    assert.equal(cancelacion.cuerpo.serie.id, creada.cuerpo.serie.id);
+    assert.deepEqual(cancelacion.cuerpo.canceladas, [segunda, tercera]);
+    assert.deepEqual(cancelacion.cuerpo.pendientes, [primera]);
+
+    const pendiente = await api.pedir("GET", `/api/reservas/${primera}`);
+    assert.equal(pendiente.cuerpo.reserva.estado, "confirmada");
+    for (const id of [segunda, tercera]) {
+      const reserva = (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva;
+      assert.equal(reserva.estado, "cancelada");
+      assert.equal(reserva.penalizacion, undefined, "la cancelación de la serie no tiene penalización");
+    }
+
+    // Con forzar también se cancela la que está a menos de 24 horas, con el 100 % de penalización.
+    const forzada = await crearSerie({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T09:00", semanas: 2 });
+    const [cara, siguiente] = forzada.cuerpo.serie.reservas;
+    const conPenalizacion = await api.pedir("POST", `/api/series/${forzada.cuerpo.serie.id}/cancelar`, {
+      socio: GESTOR,
+      cuerpo: { forzar: true },
+    });
+    assert.equal(conPenalizacion.status, 200);
+    assert.deepEqual(conPenalizacion.cuerpo.canceladas, [cara, siguiente]);
+    assert.deepEqual(conPenalizacion.cuerpo.pendientes, []);
+    const penalizada = (await api.pedir("GET", `/api/reservas/${cara}`)).cuerpo.reserva;
+    assert.equal(penalizada.estado, "cancelada");
+    assert.equal(penalizada.penalizacion, 1800);
+    const gratis = (await api.pedir("GET", `/api/reservas/${siguiente}`)).cuerpo.reserva;
+    assert.equal(gratis.estado, "cancelada");
+    assert.equal(gratis.penalizacion, undefined);
+
+    // Las que ya han empezado no se tocan: no salen ni en canceladas ni en pendientes.
+    const empezada = await crearSerie({ socioId: "socio-041", pistaId: "pista-3", inicio: "2026-12-01T09:00", semanas: 2 });
+    assert.equal(empezada.status, 201);
+    const [yaEmpezada, futura] = empezada.cuerpo.serie.reservas;
+    assert.equal((await fijarReloj("2026-12-02T10:00")).status, 200);
+    const tarde = await api.pedir("POST", `/api/series/${empezada.cuerpo.serie.id}/cancelar`, { socio: GESTOR });
+    assert.equal(tarde.status, 200);
+    assert.deepEqual(tarde.cuerpo.canceladas, [futura]);
+    assert.deepEqual(tarde.cuerpo.pendientes, []);
+    assert.equal((await api.pedir("GET", `/api/reservas/${yaEmpezada}`)).cuerpo.reserva.estado, "confirmada");
+  } finally {
+    await fijarReloj("2026-11-18T10:00");
+  }
+});
