+
+  // Con todas las semanas ocupadas no se crea nada.
+  for (const inicio of ["2027-05-04T12:00", "2027-05-11T12:00"]) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio } });
+    assert.equal(r.status, 201);
+  }
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+  const vacia = await crearSerie({ socioId: "socio-041", pistaId: "pista-1", inicio: "2027-05-04T12:00", semanas: 2 });
+  assert.equal(vacia.status, 409);
