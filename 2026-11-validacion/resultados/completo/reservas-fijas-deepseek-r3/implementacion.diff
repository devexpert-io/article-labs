+test("las series no cuentan para el límite de 3 reservas futuras", async () => {
+  const normal = (inicio: string, pistaId = "pista-3") =>
+    api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-005", pistaId, inicio } });
+
+  // Luis Martín ya tenía dos reservas futuras: con esta llega a tres.
+  const terceraNormal = await normal("2026-11-24T12:00");
+  assert.equal(terceraNormal.status, 201);
+  const serie = await crearSerie({ socioId: "socio-005", pistaId: "pista-3", inicio: "2026-12-01T12:00", semanas: 2 });
+  assert.equal(serie.status, 201, "la serie se crea aunque el socio ya tenga tres reservas futuras");
+
+  const cuarta = await normal("2026-12-09T12:00");
+  assert.equal(cuarta.status, 409);
+  assert.equal(cuarta.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+
+  // Al cancelar una reserva normal el socio vuelve a tener sitio, aunque siga con la serie.
+  const cancelada = await api.pedir("POST", `/api/reservas/${terceraNormal.cuerpo.reserva.id}/cancelar`);
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+
+  const otraSerie = await crearSerie({ socioId: "socio-005", pistaId: "pista-2", inicio: "2026-12-02T12:00", semanas: 3 });
+  assert.equal(otraSerie.status, 201);
+  const suelta = await normal("2026-12-10T12:00", "pista-1");
+  assert.equal(suelta.status, 201, "las reservas de una serie no impiden reservar con las reglas de siempre");
+});
