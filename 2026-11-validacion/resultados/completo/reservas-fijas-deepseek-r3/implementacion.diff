+test("semanas ocupadas se saltan; si no cabe ninguna, 409 SERIE_VACIA sin crear nada", async () => {
+  // Ocupa la segunda semana de la serie con una reserva normal.
+  const ocupada = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2027-04-14T12:00" },
+  });
+  assert.equal(ocupada.status, 201);
+
+  const creada = await crearSerie({ socioId: "socio-041", pistaId: "pista-2", inicio: "2027-04-07T12:00", semanas: 3 });
+  assert.equal(creada.status, 201);
+  assert.equal(creada.cuerpo.serie.reservas.length, 2);
+  assert.deepEqual(creada.cuerpo.serie.saltadas, [
+    { inicio: "2027-04-14T12:00", codigo: "FRANJA_NO_DISPONIBLE" },
+  ]);
+  const serie = (await api.pedir("GET", `/api/series/${creada.cuerpo.serie.id}`, { socio: GESTOR })).cuerpo.serie;
