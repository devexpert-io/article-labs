+// Las reservas fijas semanales: series que crea la recepción y cancela entera.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+const GESTOR = "socio-040";
+const SOCIO = "socio-003";
+
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+function crearSerie(datos: unknown, socio = GESTOR) {
+  return api.pedir("POST", "/api/series", { cuerpo: datos, socio });
+}
+
+function fijarReloj(ahora: string) {
+  return api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+}
+
+test("permisos: sin X-Socio, 401; con un socio normal, 403", async () => {
+  const cuerpo = { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-05-18T12:00", semanas: 2 };
+  const sinIdentificar = await api.pedir("POST", "/api/series", { cuerpo });
+  assert.equal(sinIdentificar.status, 401);
+  assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const socioNormal = await crearSerie(cuerpo, SOCIO);
+  assert.equal(socioNormal.status, 403);
+  assert.equal(socioNormal.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const consultaSin = await api.pedir("GET", "/api/series/S-0001");
+  assert.equal(consultaSin.status, 401);
+  assert.equal(consultaSin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const consultaSocio = await api.pedir("GET", "/api/series/S-0001", { socio: SOCIO });
+  assert.equal(consultaSocio.status, 403);
+  assert.equal(consultaSocio.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const cancelarSin = await api.pedir("POST", "/api/series/S-0001/cancelar");
+  assert.equal(cancelarSin.status, 401);
+  assert.equal(cancelarSin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const cancelarSocio = await api.pedir("POST", "/api/series/S-0001/cancelar", { socio: SOCIO });
+  assert.equal(cancelarSocio.status, 403);
+  assert.equal(cancelarSocio.cuerpo.error.codigo, "SIN_PERMISO");
+});
+
+test("datos: semanas entre 2 y 12, socio y pista existentes y franja válida y futura", async () => {
+  const base = { socioId: "socio-041", pistaId: "pista-3", inicio: "2027-04-06T12:00", semanas: 2 };
+  for (const semanas of [1, 13, 2.5, "3", null, undefined]) {
+    const r = await crearSerie({ ...base, semanas });
+    assert.equal(r.status, 400, `semanas=${String(semanas)} debe ser 400`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  const sinSemanas = await crearSerie({ socioId: "socio-041", pistaId: "pista-3", inicio: "2027-04-06T12:00" });
+  assert.equal(sinSemanas.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const sinSocio = await crearSerie({ ...base, socioId: "socio-999" });
+  assert.equal(sinSocio.status, 404);
+  assert.equal(sinSocio.cuerpo.error.codigo, "SOCIO_NO_ENCONTRADO");
+
+  const sinPista = await crearSerie({ ...base, pistaId: "pista-9" });
+  assert.equal(sinPista.status, 404);
+  assert.equal(sinPista.cuerpo.error.codigo, "PISTA_NO_ENCONTRADA");
+
+  for (const inicio of ["2027-04-06T12:45", "2027-04-06", "2027-04-06T25:00"]) {
+    const r = await crearSerie({ ...base, inicio });
+    assert.equal(r.status, 400, `inicio=${inicio} debe ser 400`);
+    assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  }
+
+  const pasada = await crearSerie({ ...base, inicio: "2026-11-18T09:00" });
+  assert.equal(pasada.status, 409);
+  assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+});
+
+test("una reserva por semana, a la misma hora local aunque cambie la hora", async () => {
+  // Del martes 23 de marzo de 2027 al 6 de abril: el 28 de marzo cambia la hora en Europa/Madrid.
+  const primavera = await crearSerie({ socioId: "socio-041", pistaId: "pista-1", inicio: "2027-03-23T19:30", semanas: 3 });
+  assert.equal(primavera.status, 201);
+  const id = primavera.cuerpo.serie.id;
+  assert.match(id, /^S-/);
+  assert.equal(primavera.cuerpo.serie.socioId, "socio-041");
+  assert.equal(primavera.cuerpo.serie.pistaId, "pista-1");
+  assert.equal(primavera.cuerpo.serie.inicio, "2027-03-23T19:30");
+  assert.equal(primavera.cuerpo.serie.semanas, 3);
+  assert.deepEqual(primavera.cuerpo.serie.saltadas, []);
