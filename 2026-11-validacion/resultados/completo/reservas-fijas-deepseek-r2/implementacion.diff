@@ -0,0 +1,295 @@
+// Las reservas fijas semanales (series), probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SERIE = { socioId: "socio-041", pistaId: "pista-2", inicio: "2027-03-23T19:30", semanas: 3 };
+
+/** Arranca una API limpia para el test y la cierra al terminar. */
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function crear(api: Api, datos: Record<string, unknown>) {
+  return api.pedir("POST", "/api/series", { cuerpo: datos, socio: GESTOR });
+}
+
+test("solo un gestor crea, consulta y cancela series", async () => {
+  await conApi(async (api) => {
+    const sinIdentificar = await api.pedir("POST", "/api/series", { cuerpo: SERIE });
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const socio = await api.pedir("POST", "/api/series", { cuerpo: SERIE, socio: "socio-003" });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    assert.equal((await api.pedir("GET", "/api/series/S-0001")).status, 401);
+    assert.equal((await api.pedir("GET", "/api/series/S-0001", { socio: "socio-003" })).status, 403);
+    assert.equal((await api.pedir("POST", "/api/series/S-0001/cancelar")).status, 401);
+    assert.equal((await api.pedir("POST", "/api/series/S-0001/cancelar", { socio: "socio-003" })).status, 403);
+
+    // El gestor sí puede (la serie no existe, pero ya no es cuestión de permisos).
+    const gestor = await api.pedir("GET", "/api/series/S-0001", { socio: GESTOR });
+    assert.equal(gestor.status, 404);
+    assert.equal(gestor.cuerpo.error.codigo, "SERIE_NO_ENCONTRADA");
+  });
+});
+
+test("datos: semanas entre 2 y 12, socio y pista existentes y franja válida y futura", async () => {
+  await conApi(async (api) => {
+    for (const semanas of [1, 13, 0, -2, 2.5, "3", undefined]) {
+      const r = await crear(api, { ...SERIE, semanas });
+      assert.equal(r.status, 400, `semanas=${semanas}`);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    const sinSocio = await crear(api, { ...SERIE, socioId: "socio-999" });
+    assert.equal(sinSocio.status, 404);
+    assert.equal(sinSocio.cuerpo.error.codigo, "SOCIO_NO_ENCONTRADO");
+    const sinPista = await crear(api, { ...SERIE, pistaId: "pista-99" });
+    assert.equal(sinPista.status, 404);
+    assert.equal(sinPista.cuerpo.error.codigo, "PISTA_NO_ENCONTRADA");
+    const malaFranja = await crear(api, { ...SERIE, inicio: "2027-03-23T11:15" });
+    assert.equal(malaFranja.status, 400);
+    assert.equal(malaFranja.cuerpo.error.codigo, "FRANJA_INVALIDA");
+    const pasada = await crear(api, { ...SERIE, inicio: "2026-11-18T09:00" });
+    assert.equal(pasada.status, 409);
+    assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+  });
+});
+
+test("una reserva por semana, a la misma hora local aunque cambie la hora", async () => {
+  await conApi(async (api) => {
+    const creada = await crear(api, SERIE);
+    assert.equal(creada.status, 201);
+    assert.equal(creada.cuerpo.serie.semanas, 3);
+    assert.equal(creada.cuerpo.serie.reservas.length, 3);
+
