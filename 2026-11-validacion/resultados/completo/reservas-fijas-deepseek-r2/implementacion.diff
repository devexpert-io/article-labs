+test("cancelar la serie no toca las que ya han empezado, las canceladas ni las no presentadas", async () => {
+  await conApi(async (api) => {
+    const creada = await crear(api, { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-19T12:00", semanas: 4 });
+    const serie = (await api.pedir("GET", `/api/series/${creada.cuerpo.serie.id}`, { socio: GESTOR })).cuerpo.serie;
+    // Una de las reservas se cancela suelta antes.
+    const suelta = serie.reservas[1];
+    assert.equal((await api.pedir("POST", `/api/reservas/${suelta.id}/cancelar`)).status, 200);
+    // Otra ya ha empezado cuando se cancela la serie.
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-19T13:00" } })).status, 200);
+
+    const r = await api.pedir("POST", `/api/series/${creada.cuerpo.serie.id}/cancelar`, { socio: GESTOR });
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.canceladas.length, 2);
+    assert.equal(r.cuerpo.pendientes.length, 0);
+    const idsTocadas = new Set([...r.cuerpo.canceladas, ...r.cuerpo.pendientes].map((x: any) => x.id));
+    assert.equal(idsTocadas.has(serie.reservas[0].id), false, "la que ya ha empezado no se toca");
+    assert.equal(idsTocadas.has(suelta.id), false, "la cancelada suelta no se toca");
+  });
+});
