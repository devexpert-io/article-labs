+test("la posición es el orden de llegada; el gestor puede consultar las esperas de otro socio", async () => {
+  await conApi(async (api) => {
+    await api.pedir("POST", "/api/esperas", { socio: NORA, cuerpo: { pistaId: "pista-1", inicio: OCUPADA } });
+    await api.pedir("POST", "/api/esperas", { socio: PABLO, cuerpo: { pistaId: "pista-1", inicio: OCUPADA } });
+
+    const propias = await api.pedir("GET", "/api/esperas", { socio: PABLO });
+    assert.equal(propias.status, 200);
+    assert.equal(propias.cuerpo.esperas.length, 1);
+    assert.equal(propias.cuerpo.esperas[0].posicion, 2);
+
+    const delGestor = await api.pedir("GET", `/api/esperas?socio=${NORA}`, { socio: GESTOR });
+    assert.equal(delGestor.status, 200);
+    assert.equal(delGestor.cuerpo.esperas.length, 1);
+    assert.equal(delGestor.cuerpo.esperas[0].posicion, 1);
+
+    const ajeno = await api.pedir("GET", `/api/esperas?socio=${NORA}`, { socio: PABLO });
+    assert.equal(ajeno.status, 403);
+    assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const sinIdentidad = await api.pedir("GET", "/api/esperas");
+    assert.equal(sinIdentidad.status, 401);
+    assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  });
+});
+
+test("retirarse: solo el dueño o un gestor, y los de detrás suben un puesto", async () => {
+  await conApi(async (api) => {
+    const nora = (await api.pedir("POST", "/api/esperas", { socio: NORA, cuerpo: { pistaId: "pista-1", inicio: OCUPADA } })).cuerpo.espera.id;
+    const pablo = (await api.pedir("POST", "/api/esperas", { socio: PABLO, cuerpo: { pistaId: "pista-1", inicio: OCUPADA } })).cuerpo.espera.id;
+    const marta = (await api.pedir("POST", "/api/esperas", { socio: MARTA, cuerpo: { pistaId: "pista-1", inicio: OCUPADA } })).cuerpo.espera.id;
+
+    const ajeno = await api.pedir("DELETE", `/api/esperas/${marta}`, { socio: PABLO });
+    assert.equal(ajeno.status, 403);
+    assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const retirada = await api.pedir("DELETE", `/api/esperas/${pablo}`, { socio: PABLO });
+    assert.equal(retirada.status, 200);
+    assert.equal(retirada.cuerpo.espera.estado, "retirada");
+    assert.equal(retirada.cuerpo.espera.posicion, undefined);
+
+    const martaTrasRetirar = await api.pedir("GET", "/api/esperas", { socio: MARTA });
+    assert.equal(martaTrasRetirar.cuerpo.esperas[0].posicion, 2);
+
+    const porGestor = await api.pedir("DELETE", `/api/esperas/${nora}`, { socio: GESTOR });
+    assert.equal(porGestor.status, 200);
+    assert.equal((await api.pedir("GET", "/api/esperas", { socio: MARTA })).cuerpo.esperas[0].posicion, 1);
+
+    const inexistente = await api.pedir("DELETE", "/api/esperas/E-9999", { socio: MARTA });
+    assert.equal(inexistente.status, 404);
+    assert.equal(inexistente.cuerpo.error.codigo, "ESPERA_NO_ENCONTRADA");
+
+    const sinIdentidad = await api.pedir("DELETE", `/api/esperas/${marta}`);
+    assert.equal(sinIdentidad.status, 401);
+    assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  });
+});
