+test("cancelar una reserva asigna la franja al primero de la lista", async () => {
+  await conApi(async (api) => {
+    await api.pedir("POST", "/api/esperas", { socio: NORA, cuerpo: { pistaId: "pista-1", inicio: OCUPADA } });
+    await api.pedir("POST", "/api/esperas", { socio: PABLO, cuerpo: { pistaId: "pista-1", inicio: OCUPADA } });
+
+    const cancelada = await api.pedir("POST", "/api/reservas/R-0515/cancelar");
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    const asignadaA = cancelada.cuerpo.asignadaA;
+    assert.equal(typeof asignadaA, "string");
+
+    const asignada = (await api.pedir("GET", `/api/reservas/${asignadaA}`)).cuerpo.reserva;
+    assert.equal(asignada.socioId, NORA);
+    assert.equal(asignada.pistaId, "pista-1");
+    assert.equal(asignada.inicio, OCUPADA);
+    assert.equal(asignada.estado, "confirmada");
+    assert.equal(asignada.importe, 2800);
+    assert.equal(asignada.notas, "Asignada desde la lista de espera");
+
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    assert.equal(estado.esperas.find((e: any) => e.socioId === NORA).estado, "asignada");
+
+    const deNora = await api.pedir("GET", "/api/esperas", { socio: NORA });
+    assert.equal(deNora.cuerpo.esperas.length, 0);
+    const dePablo = await api.pedir("GET", "/api/esperas", { socio: PABLO });
+    assert.equal(dePablo.cuerpo.esperas[0].posicion, 1);
+
+    // Sin lista de espera, cancelar responde como antes más `asignadaA: null`.
+    const sinLista = await api.pedir("POST", "/api/reservas/R-0519/cancelar");
+    assert.equal(sinLista.status, 200);
+    assert.equal(sinLista.cuerpo.asignadaA, null);
+  });
+});
+
+test("se salta a quien ya no puede reservar y se prueba con el siguiente", async () => {
+  await conApi(async (api) => {
+    await api.pedir("POST", "/api/esperas", { socio: LUIS, cuerpo: { pistaId: "pista-1", inicio: OCUPADA_2 } });
+    await api.pedir("POST", "/api/esperas", { socio: NORA, cuerpo: { pistaId: "pista-1", inicio: OCUPADA_2 } });
+
+    // Luis llega a las tres reservas futuras que permite el club.
+    const tercera = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: LUIS, pistaId: "pista-3", inicio: "2026-11-24T12:00" } });
+    assert.equal(tercera.status, 201);
+
+    const cancelada = await api.pedir("POST", "/api/reservas/R-0516/cancelar");
+    assert.equal(cancelada.status, 200);
+    const asignada = (await api.pedir("GET", `/api/reservas/${cancelada.cuerpo.asignadaA}`)).cuerpo.reserva;
+    assert.equal(asignada.socioId, NORA, "la franja es para el siguiente de la lista");
+
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    assert.equal(estado.esperas.find((e: any) => e.socioId === LUIS).estado, "descartada");
+    assert.equal((await api.pedir("GET", "/api/esperas", { socio: LUIS })).cuerpo.esperas.length, 0);
+  });
+});
