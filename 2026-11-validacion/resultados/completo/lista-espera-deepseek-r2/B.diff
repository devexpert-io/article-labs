+// La lista de espera de franjas, probada a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Arranca una API limpia para cada prueba y la cierra al terminar. */
+async function conApi(prueba: (api: Api) => Promise<void>, entorno?: Record<string, string>): Promise<void> {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const NORA = "socio-041";
+const PABLO = "socio-003";
+const MARTA = "socio-002";
+const LUIS = "socio-005";
+const GESTOR = "socio-040";
+const OCUPADA = "2026-11-19T19:30"; // pista-1, reservada por socio-007
+const OCUPADA_2 = "2026-11-21T15:00"; // pista-1, reservada por socio-009
+
+test("apuntarse a una franja ocupada responde 201 con la espera activa y su posición", async () => {
+  await conApi(async (api) => {
+    const creada = await api.pedir("POST", "/api/esperas", {
+      socio: NORA,
+      cuerpo: { pistaId: "pista-1", inicio: OCUPADA },
+    });
+    assert.equal(creada.status, 201);
+    assert.equal(creada.cuerpo.espera.id, "E-0001");
+    assert.equal(creada.cuerpo.espera.socioId, NORA);
+    assert.equal(creada.cuerpo.espera.pistaId, "pista-1");
+    assert.equal(creada.cuerpo.espera.inicio, OCUPADA);
+    assert.equal(creada.cuerpo.espera.estado, "activa");
+    assert.equal(creada.cuerpo.espera.posicion, 1);
+
+    const sinIdentidad = await api.pedir("POST", "/api/esperas", { cuerpo: { pistaId: "pista-1", inicio: OCUPADA } });
+    assert.equal(sinIdentidad.status, 401);
+    assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  });
+});
+
+test("solo se puede esperar una franja que se puede reservar", async () => {
+  await conApi(async (api) => {
+    const libre = await api.pedir("POST", "/api/esperas", { socio: NORA, cuerpo: { pistaId: "pista-2", inicio: OCUPADA } });
+    assert.equal(libre.status, 409);
+    assert.equal(libre.cuerpo.error.codigo, "FRANJA_LIBRE");
+
+    const inexistente = await api.pedir("POST", "/api/esperas", { socio: NORA, cuerpo: { pistaId: "pista-9", inicio: OCUPADA } });
+    assert.equal(inexistente.status, 404);
+    assert.equal(inexistente.cuerpo.error.codigo, "PISTA_NO_ENCONTRADA");
+
+    const cerrada = await api.pedir("POST", "/api/esperas", { socio: NORA, cuerpo: { pistaId: "pista-4", inicio: OCUPADA } });
+    assert.equal(cerrada.status, 409);
+    assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+
+    const invalida = await api.pedir("POST", "/api/esperas", { socio: NORA, cuerpo: { pistaId: "pista-1", inicio: "2026-11-19T19:00" } });
+    assert.equal(invalida.status, 400);
+    assert.equal(invalida.cuerpo.error.codigo, "FRANJA_INVALIDA");
+
+    const pasada = await api.pedir("POST", "/api/esperas", { socio: NORA, cuerpo: { pistaId: "pista-1", inicio: "2026-11-18T09:00" } });
+    assert.equal(pasada.status, 409);
+    assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+
+    const sinCuota = await api.pedir("POST", "/api/esperas", { socio: "socio-011", cuerpo: { pistaId: "pista-1", inicio: OCUPADA } });
+    assert.equal(sinCuota.status, 409);
+    assert.equal(sinCuota.cuerpo.error.codigo, "CUOTA_INACTIVA");
+  });
+});
+
+test("sin duplicados y como mucho dos esperas activas por socio", async () => {
+  await conApi(async (api) => {
