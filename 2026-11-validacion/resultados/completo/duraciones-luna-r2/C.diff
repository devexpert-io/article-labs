+export function precio(pista: Pista, inicio: string, duracion = MINUTOS_FRANJA): number {
+  const [hh, mm] = inicio.slice(11).split(":").map(Number);
+  const inicioMin = hh! * 60 + mm!;
+  let ponderado = 0;
+  for (let minuto = inicioMin; minuto < inicioMin + duracion; minuto++) {
+    const punta = diaDeLaSemana(inicio.slice(0, 10)) === 0 || diaDeLaSemana(inicio.slice(0, 10)) === 6 || minuto >= 18 * 60;
+    ponderado += punta ? pista.precioPunta : pista.precioValle;
+  }
+  return Math.floor((ponderado + MINUTOS_FRANJA / 2) / MINUTOS_FRANJA);
 }
 
