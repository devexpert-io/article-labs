+/** La misma hora local, `semanas` semanas después. Suma días sobre el calendario, no horas. */
+function sumarSemanas(inicio: string, semanas: number): string {
+  // Quien llama valida la fecha; aun así no se deja escapar un RangeError de Date.
+  const dia = new Date(`${inicio.slice(0, 10)}T12:00:00Z`);
