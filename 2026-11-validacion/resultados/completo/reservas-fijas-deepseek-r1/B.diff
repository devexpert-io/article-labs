+test("si no se puede reservar ninguna semana, SERIE_VACIA y no se crea nada", async () => {
+  await conApi({}, async (api) => {
+    const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+    // La primera semana ya está ocupada en la semilla y la segunda la ocupamos aquí.
+    const bloqueo = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T19:30" },
+    });
+    assert.equal(bloqueo.status, 201);
+
+    const resp = await api.pedir("POST", "/api/series", {
+      socio: GESTOR,
+      cuerpo: { socioId: SOCIO, pistaId: "pista-1", inicio: "2026-11-19T19:30", semanas: 2 },
+    });
+    assert.equal(resp.status, 409);
+    assert.equal(resp.cuerpo.error.codigo, "SERIE_VACIA");
+
+    const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+    assert.equal(despues.series.length, antes.series.length, "no se crea la serie");
+    assert.equal(despues.reservas.length, antes.reservas.length + 1, "solo queda la reserva de bloqueo");
+  });
+});
