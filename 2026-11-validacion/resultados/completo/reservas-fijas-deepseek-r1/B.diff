+// Las reservas fijas semanales, probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-004";
+
+/** Arranca una API limpia para cada prueba y la cierra al terminar. */
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("solo un gestor crea, consulta y cancela series", async () => {
+  await conApi({}, async (api) => {
+    const datos = { socioId: SOCIO, pistaId: "pista-1", inicio: "2027-01-05T10:30", semanas: 2 };
+
+    const sinIdentificar = await api.pedir("POST", "/api/series", { cuerpo: datos });
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const socioNormal = await api.pedir("POST", "/api/series", { socio: SOCIO, cuerpo: datos });
+    assert.equal(socioNormal.status, 403);
+    assert.equal(socioNormal.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const consultaSin = await api.pedir("GET", "/api/series/S-0001");
+    assert.equal(consultaSin.status, 401);
+    assert.equal((await api.pedir("GET", "/api/series/S-0001", { socio: SOCIO })).status, 403);
+
+    const cancelarSin = await api.pedir("POST", "/api/series/S-0001/cancelar");
+    assert.equal(cancelarSin.status, 401);
+    assert.equal((await api.pedir("POST", "/api/series/S-0001/cancelar", { socio: SOCIO })).status, 403);
+  });
+});
+
+test("los datos de la serie: semanas, socio, pista y franja", async () => {
+  await conApi({}, async (api) => {
+    const base = { socioId: SOCIO, pistaId: "pista-1", inicio: "2027-01-05T10:30", semanas: 2 };
+    const comprobar = async (cambios: Record<string, unknown>, status: number, codigo: string) => {
+      const r = await api.pedir("POST", "/api/series", { socio: GESTOR, cuerpo: { ...base, ...cambios } });
+      assert.equal(r.status, status, `esperaba ${codigo}`);
+      assert.equal(r.cuerpo.error.codigo, codigo);
+    };
+
+    for (const semanas of [1, 13, 2.5, "3", undefined]) {
+      await comprobar({ semanas }, 400, "DATOS_INVALIDOS");
+    }
+    await comprobar({ socioId: "socio-999" }, 404, "SOCIO_NO_ENCONTRADO");
+    await comprobar({ pistaId: "pista-99" }, 404, "PISTA_NO_ENCONTRADA");
+    await comprobar({ inicio: "2027-01-05T10:15" }, 400, "FRANJA_INVALIDA");
+    await comprobar({ inicio: "2026-11-18T09:00" }, 409, "FRANJA_PASADA");
+    await comprobar({ socioId: "socio-011" }, 409, "CUOTA_INACTIVA");
+    await comprobar({ pistaId: "pista-4" }, 409, "PISTA_CERRADA");
+  });
+});
+
+test("las fechas imposibles se rechazan con FRANJA_INVALIDA y sin tocar el estado", async () => {
+  await conApi({}, async (api) => {
+    const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+
+    for (const inicio of ["2027-13-01T10:30", "2027-02-30T10:30"]) {
+      const r = await api.pedir("POST", "/api/series", {
+        socio: GESTOR,
+        cuerpo: { socioId: SOCIO, pistaId: "pista-1", inicio, semanas: 2 },
+      });
+      assert.equal(r.status, 400, `esperaba 400 para ${inicio}`);
+      assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA");
+    }
+
+    const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+    assert.equal(despues.series.length, antes.series.length, "no se crea ninguna serie");
+    assert.equal(despues.reservas.length, antes.reservas.length, "no se crea ninguna reserva");
+  });
+});
+
+test("una reserva por semana, a la misma hora local aunque cambie la hora", async () => {
+  await conApi({}, async (api) => {
+    // El 28 de marzo de 2027 cambia la hora: la serie mantiene el martes a las 19:30.
+    const creada = await api.pedir("POST", "/api/series", {
