+    throw new ErrorDelClub("FRANJA_INVALIDA", "inicio no es una fecha válida", 400);
+  }
+  dia.setUTCDate(dia.getUTCDate() + 7 * semanas);
+  return `${dia.toISOString().slice(0, 10)}T${inicio.slice(11)}`;
