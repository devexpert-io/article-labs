+test("cancelar la serie: gratis desde 24 h, pendientes dentro de plazo y forzar con penalización", async () => {
+  await conApi({ AHORA: "2026-11-18T20:00" }, async (api) => {
+    // Faltan 23,5 horas para la primera reserva: queda pendiente salvo con forzar.
+    const creada = await api.pedir("POST", "/api/series", {
+      socio: GESTOR,
+      cuerpo: { socioId: SOCIO, pistaId: "pista-2", inicio: "2026-11-19T19:30", semanas: 3 },
+    });
+    assert.equal(creada.status, 201);
+    const id = creada.cuerpo.serie.id;
+
+    const primera = await api.pedir("POST", `/api/series/${id}/cancelar`, { socio: GESTOR });
+    assert.equal(primera.status, 200);
+    assert.equal(primera.cuerpo.canceladas.length, 2);
+    assert.equal(primera.cuerpo.pendientes.length, 1);
+    assert.equal(primera.cuerpo.pendientes[0].inicio, "2026-11-19T19:30");
+    assert.equal(primera.cuerpo.pendientes[0].estado, "confirmada");
+    for (const r of primera.cuerpo.canceladas) {
+      assert.equal(r.estado, "cancelada");
+      assert.equal(r.penalizacion, undefined, "cancelar gratis no genera penalización");
+    }
+
+    const segunda = await api.pedir("POST", `/api/series/${id}/cancelar`, { socio: GESTOR, cuerpo: { forzar: true } });
+    assert.equal(segunda.status, 200);
+    assert.equal(segunda.cuerpo.pendientes.length, 0);
+    assert.equal(segunda.cuerpo.canceladas.length, 1);
+    assert.equal(segunda.cuerpo.canceladas[0].penalizacion, segunda.cuerpo.canceladas[0].importe, "penalización del 100 %");
+  });
+});
