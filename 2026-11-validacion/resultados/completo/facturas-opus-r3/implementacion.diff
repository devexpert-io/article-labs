diff --git a/test/facturas.test.ts b/test/facturas.test.ts
new file mode 100644
index 0000000..20fa311
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,203 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+/** Las facturas que deberían salir de un mes, calculadas a partir de las reservas del estado. */
+function esperadas(reservas: any[], mes: string) {
+  const porSocio = new Map<string, any[]>();
+  const delMes = reservas
+    .filter((r) => r.inicio.startsWith(mes))
+    .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+  for (const r of delMes) {
+    let linea;
+    if (r.estado === "confirmada" || r.estado === "no_presentada") linea = { reservaId: r.id, concepto: "Reserva", importe: r.importe };
+    else if (r.estado === "cancelada" && r.penalizacion) linea = { reservaId: r.id, concepto: "Penalización", importe: r.penalizacion };
+    if (!linea) continue;
+    porSocio.set(r.socioId, [...(porSocio.get(r.socioId) ?? []), linea]);
+  }
+  return [...porSocio.keys()].sort().map((socioId) => ({ socioId, lineas: porSocio.get(socioId)! }));
+}
+
+function comprobarImportes(factura: any) {
+  const total = factura.lineas.reduce((s: number, l: any) => s + l.importe, 0);
+  assert.equal(factura.total, total);
+  assert.equal(factura.base, Math.round(total / 1.21));
+  assert.equal(factura.iva, factura.total - factura.base);
+}
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+test("solo un gestor genera y consulta facturas", async () => {
+  for (const [metodo, ruta, cuerpo] of [
+    ["POST", "/api/facturas", { mes: "2026-10" }],
+    ["GET", "/api/facturas?mes=2026-10", undefined],
+    ["GET", "/api/facturas/F2026-0001", undefined],
+  ] as const) {
+    const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+    assert.equal(anonimo.status, 401, `${metodo} ${ruta}`);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-004" });
+    assert.equal(socio.status, 403, `${metodo} ${ruta}`);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.facturas.length, 0, "sin permiso no se genera nada");
+});
+
+test("mes con formato AAAA-MM y ya cerrado", async () => {
+  for (const mes of [undefined, "2026-13", "2026-1", "octubre", 202610]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-00", { socio: GESTOR })).status, 400);
+  assert.equal((await api.pedir("GET", "/api/facturas", { socio: GESTOR })).status, 400);
+  for (const mes of ["2026-11", "2026-12", "2027-03"]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 409, mes);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+});
+
+test("octubre de 2026: una factura por socio con sus líneas, IVA y números", async () => {
+  const reservas = (await api.pedir("GET", "/_estado")).cuerpo.reservas;
+  const generada = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(generada.status, 201);
+  const { facturas } = generada.cuerpo;
+  const previstas = esperadas(reservas, "2026-10");
+  assert.equal(facturas.length, previstas.length);
+  facturas.forEach((f: any, i: number) => {
+    assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.mes, "2026-10");
+    assert.equal(f.socioId, previstas[i]!.socioId);
+    assert.deepEqual(f.lineas, previstas[i]!.lineas);
+    comprobarImportes(f);
+  });
+  // Ordenadas por socio y sin socios que no tienen nada que facturar.
+  const socios = facturas.map((f: any) => f.socioId);
+  assert.deepEqual(socios, [...socios].sort());
+  assert.ok(!socios.includes("socio-041"));
+  // Las canceladas sin penalización no se facturan.
+  const canceladas = new Set(reservas.filter((r: any) => r.inicio.startsWith("2026-10") && r.estado === "cancelada").map((r: any) => r.id));
+  assert.ok(canceladas.size > 0);
+  assert.ok(facturas.every((f: any) => f.lineas.every((l: any) => !canceladas.has(l.reservaId))));
+  // Las no presentadas sí, como Reserva.
+  const noPresentada = reservas.find((r: any) => r.inicio.startsWith("2026-10") && r.estado === "no_presentada");
+  const linea = facturas.flatMap((f: any) => f.lineas).find((l: any) => l.reservaId === noPresentada.id);
+  assert.deepEqual(linea, { reservaId: noPresentada.id, concepto: "Reserva", importe: noPresentada.importe });
+  // Líneas ordenadas por el inicio de la reserva.
+  const inicio = new Map(reservas.map((r: any) => [r.id, r.inicio]));
+  for (const f of facturas) {
+    const inicios = f.lineas.map((l: any) => inicio.get(l.reservaId));
+    assert.deepEqual(inicios, [...inicios].sort());
+  }
+});
+
+test("la base se calcula sobre el total de la factura, no línea a línea", async () => {
+  const { facturas } = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo;
+  // Marta López (socio-002): 20 400 céntimos. Línea a línea la base saldría 16 861.
+  const marta = facturas.find((f: any) => f.socioId === "socio-002");
+  assert.equal(marta.total, 20400);
+  assert.equal(marta.base, 16860);
+  assert.equal(marta.iva, 3540);
+  // socio-001: 6800 / 1,21 = 5619,83 → 5620.
+  const primera = facturas.find((f: any) => f.socioId === "socio-001");
+  assert.deepEqual([primera.total, primera.base, primera.iva], [6800, 5620, 1180]);
+});
+
+test("generar dos veces devuelve las mismas facturas sin crear ninguna", async () => {
+  const antes = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas;
+  const otra = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(otra.status, 200);
+  assert.deepEqual(otra.cuerpo.facturas, antes);
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.facturas.length, antes.length);
+});
+
+test("consultar facturas por mes y por número", async () => {
+  const { facturas } = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo;
+  const vacio = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+  assert.equal(vacio.status, 200);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  const una = await api.pedir("GET", "/api/facturas/F2026-0002", { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo, { factura: facturas[1] });
+  const falta = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+  assert.equal(falta.status, 404);
+  assert.equal(falta.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("facturar no cambia las reservas", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const octubre = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=1");
+  assert.equal(octubre.cuerpo.total, 315);
+  const nueva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-24T13:30" } });
+  assert.equal(nueva.status, 201);
+  assert.equal(nueva.cuerpo.reserva.id, `R-${String(estado.contador + 1).padStart(4, "0")}`);
+  const cancelada = await api.pedir("POST", `/api/reservas/${nueva.cuerpo.reserva.id}/cancelar`);
+  assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+});
+
+test("penalizaciones y numeración entre meses y entre años", async () => {
+  const otra = await arrancarApi();
