+    assert.equal(creada.status, 201);
+    const id = creada.cuerpo.reserva.id;
+    for (const [campo, valor] of [
+      ["importeBase", h.precio],
+      ["descuento", Math.round(h.precio / 10)],
+      ["importe", h.precio - Math.round(h.precio / 10)],
+      ["codigo", "CLUB10"],
+    ] as const) {
+      assert.equal(creada.cuerpo.reserva[campo], valor);
+      assert.equal((await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva[campo], valor);
+    }
+    const listado = await api.pedir("GET", "/api/reservas?socio=socio-041");
+    assert.equal(listado.cuerpo.total, 1);
+    const enLista = listado.cuerpo.reservas[0];
+    assert.equal(enLista.importeBase, h.precio);
+    assert.equal(enLista.descuento, Math.round(h.precio / 10));
