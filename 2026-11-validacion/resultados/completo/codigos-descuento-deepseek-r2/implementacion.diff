+// Catálogo fijo de códigos de descuento del club. No se crean ni se editan por la API.
+import type { CodigoDescuento } from "./tipos.ts";
+
+export const CODIGOS = ["BIENVENIDA", "MANANAS", "CLUB10"] as const;
+
+/** Céntimos que descuenta `MANANAS`. */
+export const DESCUENTO_MANANAS = 400;
+/** Último día del club en que se puede usar `BIENVENIDA` (incluido). */
+export const ULTIMO_DIA_BIENVENIDA = "2026-12-31";
+/** Reservas con `CLUB10` (confirmadas o no presentadas) que puede tener cada socio. */
+export const MAXIMO_CLUB10 = 3;
+
+/** Devuelve el código del catálogo, sin espacios y en mayúsculas, o undefined si no existe. */
+export function normalizarCodigo(valor: string): CodigoDescuento | undefined {
+  const normalizado = valor.trim().toUpperCase();
+  return CODIGOS.find((codigo) => codigo === normalizado);
+}
+
+/** Céntimos que el código descuenta sobre un importe base. */
+export function descuentoDe(codigo: CodigoDescuento, importeBase: number): number {
+  switch (codigo) {
+    case "BIENVENIDA":
+      return Math.round(importeBase * 0.5);
+    case "MANANAS":
+      return DESCUENTO_MANANAS;
+    case "CLUB10":
+      return Math.round(importeBase * 0.1);
+  }
+}
