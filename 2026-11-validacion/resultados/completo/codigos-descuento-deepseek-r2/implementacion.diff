+// Códigos de descuento al reservar: catálogo, condiciones, importes y errores.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+interface Hueco {
+  pistaId: string;
+  inicio: string;
+  precio: number;
+}
+
+/** Primer hueco libre del día que encaja con el filtro de horas (y no se haya usado ya en la prueba). */
+async function hueco(
+  api: Api,
+  fecha: string,
+  opciones: { desde?: string; hasta?: string; usados?: Set<string> } = {},
+): Promise<Hueco> {
+  const { desde = "00:00", hasta = "23:59", usados = new Set<string>() } = opciones;
+  const respuesta = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`);
+  assert.equal(respuesta.status, 200);
+  for (const p of respuesta.cuerpo.pistas) {
+    for (const f of p.franjas) {
+      const hora = f.inicio.slice(11);
+      if (f.estado === "libre" && hora >= desde && hora <= hasta && !usados.has(f.inicio)) {
+        usados.add(f.inicio);
+        return { pistaId: p.pistaId, inicio: f.inicio, precio: f.precio };
+      }
+    }
+  }
+  throw new Error(`No hay hueco libre el ${fecha} entre ${desde} y ${hasta}`);
+}
+
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reservar(api: Api, cuerpo: Record<string, unknown>) {
+  return api.pedir("POST", "/api/reservas", { cuerpo });
+}
+
+function assertError(respuesta: { status: number; cuerpo: any }, http: number, codigo: string) {
+  assert.equal(respuesta.status, http, `se esperaba ${http} ${codigo}`);
+  assert.equal(respuesta.cuerpo.error.codigo, codigo);
+}
+
+test("sin código, la reserva se crea como antes", () =>
+  conApi({}, async (api) => {
+    const h = await hueco(api, "2026-11-24", { desde: "12:00" });
+    const respuesta = await reservar(api, { socioId: "socio-041", pistaId: h.pistaId, inicio: h.inicio });
+    assert.equal(respuesta.status, 201);
+    const reserva = respuesta.cuerpo.reserva;
+    assert.equal(reserva.importeBase, h.precio);
+    assert.equal(reserva.descuento, 0);
+    assert.equal(reserva.importe, h.precio);
+    assert.equal(reserva.codigo, undefined);
+    assert.equal("codigo" in reserva, false);
+  }));
+
+test("BIENVENIDA descuenta el 50 % en la primera reserva del socio", () =>
+  conApi({}, async (api) => {
+    const h = await hueco(api, "2026-11-24", { desde: "09:00", hasta: "11:59" });
+    const respuesta = await reservar(api, { socioId: "socio-041", pistaId: h.pistaId, inicio: h.inicio, codigo: "BIENVENIDA" });
+    assert.equal(respuesta.status, 201);
+    const reserva = respuesta.cuerpo.reserva;
+    assert.equal(reserva.importeBase, h.precio);
+    assert.equal(reserva.descuento, Math.round(h.precio / 2));
+    assert.equal(reserva.importe, h.precio - Math.round(h.precio / 2));
+    assert.equal(reserva.codigo, "BIENVENIDA");
+  }));
+
+test("BIENVENIDA no vale si el socio ya tiene alguna reserva, aunque esté cancelada", () =>
+  conApi({}, async (api) => {
+    // Primera reserva de Nora, sin código, y la cancela muy por delante del plazo.
+    const usados = new Set<string>();
+    const primera = await hueco(api, "2026-11-24", { usados });
+    const creada = await reservar(api, { socioId: "socio-041", pistaId: primera.pistaId, inicio: primera.inicio });
+    assert.equal(creada.status, 201);
+    const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+
+    const segunda = await hueco(api, "2026-11-24", { usados });
+    const respuesta = await reservar(api, {
+      socioId: "socio-041", pistaId: segunda.pistaId, inicio: segunda.inicio, codigo: "BIENVENIDA",
+    });
+    assertError(respuesta, 409, "CODIGO_NO_APLICABLE");
+  }));
+
+test("BIENVENIDA solo vale hasta el 31 de diciembre de 2026 incluido", () =>
+  conApi({ AHORA: "2026-12-31T10:00" }, async (api) => {
+    const h = await hueco(api, "2026-12-31", { desde: "12:00" });
+    const respuesta = await reservar(api, { socioId: "socio-041", pistaId: h.pistaId, inicio: h.inicio, codigo: "BIENVENIDA" });
+    assert.equal(respuesta.status, 201);
+  }));
+
+test("BIENVENIDA no vale a partir del 1 de enero de 2027", () =>
+  conApi({ AHORA: "2027-01-05T10:00" }, async (api) => {
+    const h = await hueco(api, "2027-01-06", { desde: "12:00" });
+    const respuesta = await reservar(api, { socioId: "socio-041", pistaId: h.pistaId, inicio: h.inicio, codigo: "BIENVENIDA" });
+    assertError(respuesta, 409, "CODIGO_NO_APLICABLE");
+  }));
+
+test("MANANAS descuenta 4 € en mañanas de lunes a viernes", () =>
+  conApi({}, async (api) => {
+    // Miércoles 18 por la mañana.
+    const h = await hueco(api, "2026-11-18", { desde: "10:30", hasta: "11:59" });
+    const respuesta = await reservar(api, { socioId: "socio-041", pistaId: h.pistaId, inicio: h.inicio, codigo: "mananas" });
+    assert.equal(respuesta.status, 201);
+    const reserva = respuesta.cuerpo.reserva;
+    assert.equal(reserva.importeBase, h.precio);
+    assert.equal(reserva.descuento, 400);
+    assert.equal(reserva.importe, h.precio - 400);
+    assert.equal(reserva.codigo, "MANANAS");
+  }));
+
+test("MANANAS no vale desde las 12:00 ni en fin de semana", () =>
+  conApi({}, async (api) => {
+    const mediodia = await hueco(api, "2026-11-18", { desde: "12:00" });
+    assertError(
+      await reservar(api, { socioId: "socio-041", pistaId: mediodia.pistaId, inicio: mediodia.inicio, codigo: "MANANAS" }),
+      409,
+      "CODIGO_NO_APLICABLE",
+    );
+    const sabado = await hueco(api, "2026-11-21", { hasta: "11:59" });
+    assertError(
+      await reservar(api, { socioId: "socio-041", pistaId: sabado.pistaId, inicio: sabado.inicio, codigo: "MANANAS" }),
+      409,
+      "CODIGO_NO_APLICABLE",
+    );
+  }));
+
+test("CLUB10 descuenta el 10 % en cualquier franja", () =>
+  conApi({}, async (api) => {
+    const h = await hueco(api, "2026-11-21", { desde: "18:00" }); // fin de semana de punta
+    const respuesta = await reservar(api, { socioId: "socio-041", pistaId: h.pistaId, inicio: h.inicio, codigo: "CLUB10" });
+    assert.equal(respuesta.status, 201);
+    const reserva = respuesta.cuerpo.reserva;
+    assert.equal(reserva.importeBase, h.precio);
+    assert.equal(reserva.descuento, Math.round(h.precio / 10));
+    assert.equal(reserva.importe, h.precio - Math.round(h.precio / 10));
+    assert.equal(reserva.codigo, "CLUB10");
+  }));
+
+test("CLUB10 se puede usar 3 veces como mucho; la cuarta no vale", () =>
+  conApi({}, async (api) => {
+    const usados = new Set<string>();
+    for (let i = 0; i < 3; i++) {
+      const h = await hueco(api, "2026-11-19", { usados });
+      const creada = await reservar(api, { socioId: "socio-041", pistaId: h.pistaId, inicio: h.inicio, codigo: "CLUB10" });
+      assert.equal(creada.status, 201, `la reserva ${i + 1} con CLUB10 debe entrar`);
+    }
+    // Las tres quedan en el pasado: así el límite de reservas futuras no interfiere.
+    const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-20T10:00" } });
+    assert.equal(reloj.status, 200);
+    const libre = await hueco(api, "2026-11-20", { desde: "12:00" });
+    assertError(
+      await reservar(api, { socioId: "socio-041", pistaId: libre.pistaId, inicio: libre.inicio, codigo: "CLUB10" }),
+      409,
+      "CODIGO_NO_APLICABLE",
+    );
+  }));
+
+test("las reservas canceladas con CLUB10 no cuentan para el límite", () =>
+  conApi({}, async (api) => {
+    const usados = new Set<string>();
+    const ids: string[] = [];
