+// Reservas de 60, 90 o 120 minutos: duraciones, inicios, solapes, precios, disponibilidad y huecos.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+
+let api: Api;
+// Socios con cuota al día y sin reservas futuras que cuenten para el límite de tres. Cada reserva nueva
+// usa un socio que todavía tenga hueco en ese límite.
+const cupo = new Map<string, number>();
+
+before(async () => {
+  api = await arrancarApi();
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const activos = estado.socios.filter((s: any) => s.cuotaActiva && s.rol === "socio").map((s: any) => s.id as string);
+  for (const id of activos) cupo.set(id, 0);
+  for (const r of estado.reservas) {
+    if (r.estado === "confirmada" && r.inicio > estado.ahora && cupo.has(r.socioId)) {
+      cupo.set(r.socioId, cupo.get(r.socioId)! + 1);
+    }
+  }
+});
+after(() => api.cerrar());
+
+function socioLibre(): string {
+  for (const [id, usadas] of cupo) {
+    if (usadas < 3) {
+      cupo.set(id, usadas + 1);
+      return id;
+    }
+  }
+  throw new Error("no quedan socios con hueco en el límite de reservas");
+}
+
+function reservar(pistaId: string, inicio: string, duracion?: unknown): Promise<Respuesta> {
+  const cuerpo: Record<string, unknown> = { socioId: socioLibre(), pistaId, inicio };
+  if (duracion !== undefined) cuerpo.duracion = duracion;
+  return api.pedir("POST", "/api/reservas", { cuerpo });
+}
+
+async function disponibilidad(fecha: string, pista: string) {
+  const r = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pista}`);
+  assert.equal(r.status, 200);
+  return r.cuerpo.pistas[0];
+}
+
+test("la duración es de 90 minutos por defecto y admite 60, 90 o 120", async () => {
+  const porDefecto = await reservar("pista-3", "2026-12-02T10:00");
+  assert.equal(porDefecto.status, 201);
+  assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+  assert.equal(porDefecto.cuerpo.reserva.fin, "2026-12-02T11:30");
+
+  const una = await reservar("pista-3", "2026-12-02T12:00", 60);
+  assert.equal(una.status, 201);
+  assert.equal(una.cuerpo.reserva.duracion, 60);
+  assert.equal(una.cuerpo.reserva.fin, "2026-12-02T13:00");
+
+  const dos = await reservar("pista-3", "2026-12-02T13:30", 120);
+  assert.equal(dos.status, 201);
+  assert.equal(dos.cuerpo.reserva.duracion, 120);
+  assert.equal(dos.cuerpo.reserva.fin, "2026-12-02T15:30");
+});
+
+test("cualquier otra duración responde 400 DURACION_INVALIDA", async () => {
+  for (const malo of [45, 0, 150, 90.5, "90", null, true]) {
+    const r = await reservar("pista-3", "2026-12-02T17:00", malo);
+    assert.equal(r.status, 400, `duracion ${JSON.stringify(malo)}`);
+    assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA");
+  }
+});
+
+test("el inicio debe ser en punto o y media, no antes de las 09:00, y acabar como muy tarde a las 22:30", async () => {
+  const casos: [string, unknown][] = [
+    ["2026-12-01T10:15", 90],
+    ["2026-12-01T08:30", 60],
+    ["2026-12-01T22:00", 90],
