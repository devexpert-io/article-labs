+/** Los intervalos libres del día `fecha` entre la apertura y el cierre, sin reservas confirmadas. */
+function huecosDelDia(fecha: string, ocupadas: Pick<Reserva, "inicio" | "fin">[]): { inicio: string; fin: string }[] {
+  const apertura = `${fecha}T${horaDeMinutos(APERTURA)}`;
+  const cierre = `${fecha}T${horaDeMinutos(ULTIMO_FIN)}`;
+  const enElDia = ocupadas
