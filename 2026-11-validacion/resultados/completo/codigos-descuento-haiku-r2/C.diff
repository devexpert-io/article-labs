+// Códigos de descuento al reservar, probados a través de la API.
+// El reloj empieza el miércoles 25 de noviembre a las 08:00: las reservas de la semilla (hasta el 24) ya han pasado
+// y no cuentan para el límite de reservas futuras. Nora Benítez (socio-041) es la única sin historial.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi({ AHORA: "2026-11-25T08:00" });
+});
+after(() => api.cerrar());
+
+const reservar = (a: Api, socioId: string, pistaId: string, inicio: string, codigo?: unknown): Promise<Respuesta> =>
+  a.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio, ...(codigo === undefined ? {} : { codigo }) } });
+
+test("sin código, la reserva se crea como antes con los importes iguales", async () => {
+  const r = await reservar(api, "socio-003", "pista-3", "2026-11-25T10:30");
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.importeBase, 1200);
+  assert.equal(r.cuerpo.reserva.descuento, 0);
+  assert.equal(r.cuerpo.reserva.importe, 1200);
+  assert.equal("codigo" in r.cuerpo.reserva, false);
+});
+
+test("BIENVENIDA descuenta el 50 % solo en la primera reserva del socio", async () => {
+  const primera = await reservar(api, "socio-041", "pista-1", "2026-11-25T10:30", " bienvenida ");
+  assert.equal(primera.status, 201);
+  assert.equal(primera.cuerpo.reserva.importeBase, 1800);
+  assert.equal(primera.cuerpo.reserva.descuento, 900);
+  assert.equal(primera.cuerpo.reserva.importe, 900);
+  assert.equal(primera.cuerpo.reserva.codigo, "BIENVENIDA");
+
+  const segunda = await reservar(api, "socio-041", "pista-2", "2026-11-26T12:00", "BIENVENIDA");
+  assert.equal(segunda.status, 409);
+  assert.equal(segunda.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+
+  // Marta López tiene reservas de la semana pasada: en cualquier estado, ya no es su primera reserva.
+  const conHistorial = await reservar(api, "socio-002", "pista-2", "2026-11-25T12:00", "BIENVENIDA");
+  assert.equal(conHistorial.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("BIENVENIDA solo vale para reservas hechas hasta el 31 de diciembre de 2026", async () => {
+  const tarde = await arrancarApi({ AHORA: "2027-01-01T08:00" });
+  try {
+    const r = await reservar(tarde, "socio-041", "pista-1", "2027-01-04T10:30", "BIENVENIDA");
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+  } finally {
+    tarde.cerrar();
+  }
+
+  const ultimoDia = await arrancarApi({ AHORA: "2026-12-31T08:00" });
+  try {
+    const r = await reservar(ultimoDia, "socio-041", "pista-1", "2027-01-04T10:30", "BIENVENIDA");
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.importe, 900);
+  } finally {
+    ultimoDia.cerrar();
+  }
+});
+
+test("MANANAS descuenta 4,00 € en franjas de lunes a viernes que empiezan antes de las 12:00", async () => {
+  const miercoles = await reservar(api, "socio-006", "pista-2", "2026-11-25T10:30", "MANANAS");
+  assert.equal(miercoles.status, 201);
+  assert.equal(miercoles.cuerpo.reserva.importeBase, 1800);
+  assert.equal(miercoles.cuerpo.reserva.descuento, 400);
+  assert.equal(miercoles.cuerpo.reserva.importe, 1400);
+
+  const lunes = await reservar(api, "socio-006", "pista-1", "2026-11-30T09:00", "mananas");
+  assert.equal(lunes.status, 201);
+  assert.equal(lunes.cuerpo.reserva.codigo, "MANANAS");
+
+  const alMediodia = await reservar(api, "socio-007", "pista-1", "2026-11-25T12:00", "MANANAS");
+  assert.equal(alMediodia.status, 409);
+  assert.equal(alMediodia.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+
+  const sabado = await reservar(api, "socio-007", "pista-1", "2026-11-28T09:00", "MANANAS");
+  assert.equal(sabado.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+});
+
+test("CLUB10 descuenta el 10 % en cualquier franja y no admite más de 3 reservas con el código", async () => {
+  const otra = await arrancarApi({ AHORA: "2026-11-25T08:00" });
+  try {
+    const punta = await reservar(otra, "socio-008", "pista-1", "2026-11-25T18:00", "CLUB10");
+    assert.equal(punta.status, 201);
+    assert.equal(punta.cuerpo.reserva.importeBase, 2800);
+    assert.equal(punta.cuerpo.reserva.descuento, 280);
+    assert.equal(punta.cuerpo.reserva.importe, 2520);
+
+    // Tres reservas futuras con el código. Luego el reloj pasa de ellas para que el límite de futuras no interfiera.
+    assert.equal((await reservar(otra, "socio-009", "pista-1", "2026-11-25T12:00", "CLUB10")).status, 201);
+    assert.equal((await reservar(otra, "socio-009", "pista-2", "2026-11-25T13:30", "CLUB10")).status, 201);
+    assert.equal((await reservar(otra, "socio-009", "pista-3", "2026-11-25T15:00", "CLUB10")).status, 201);
+    assert.equal((await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T16:00" } })).status, 200);
+
+    const cuarta = await reservar(otra, "socio-009", "pista-1", "2026-11-26T12:00", "CLUB10");
+    assert.equal(cuarta.status, 409);
+    assert.equal(cuarta.cuerpo.error.codigo, "CODIGO_NO_APLICABLE");
+
+    // Sin código, el socio sigue pudiendo reservar.
+    assert.equal((await reservar(otra, "socio-009", "pista-2", "2026-11-26T12:00")).status, 201);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("las reservas CLUB10 canceladas no cuentan para el límite", async () => {
+  const otra = await arrancarApi({ AHORA: "2026-11-25T16:00" });
+  try {
+    const a = await reservar(otra, "socio-010", "pista-1", "2026-11-27T09:00", "CLUB10");
+    assert.equal((await reservar(otra, "socio-010", "pista-2", "2026-11-27T10:30", "CLUB10")).status, 201);
+    assert.equal((await reservar(otra, "socio-010", "pista-3", "2026-11-27T12:00", "CLUB10")).status, 201);
+    const cancelada = await otra.pedir("POST", `/api/reservas/${a.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+
+    const cuarta = await reservar(otra, "socio-010", "pista-1", "2026-11-27T13:30", "CLUB10");
+    assert.equal(cuarta.status, 201);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("los códigos desconocidos y los datos mal formados responden 400", async () => {
+  const desconocido = await reservar(api, "socio-012", "pista-2", "2026-11-25T16:30", "NOEXISTE");
+  assert.equal(desconocido.status, 400);
+  assert.equal(desconocido.cuerpo.error.codigo, "CODIGO_INVALIDO");
+
+  const noTexto = await reservar(api, "socio-012", "pista-2", "2026-11-25T16:30", 123);
+  assert.equal(noTexto.status, 400);
+  assert.equal(noTexto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+});
+
+test("las reglas del club van primero: un código no se aplica si la reserva no se puede hacer", async () => {
+  const cerrada = await reservar(api, "socio-013", "pista-4", "2026-11-25T10:30", "MANANAS");
+  assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+
+  const desconocidoCerrada = await reservar(api, "socio-013", "pista-4", "2026-11-25T10:30", "NOEXISTE");
+  assert.equal(desconocidoCerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+
+  const pasada = await reservar(api, "socio-013", "pista-2", "2026-11-24T09:00", "CLUB10");
+  assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+
+  const ocupada = await reservar(api, "socio-013", "pista-1", "2026-11-25T10:30", "CLUB10");
+  assert.equal(ocupada.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+
+  // Los intentos fallidos no han guardado nada: el socio puede reservar con el código después.
+  const despues = await reservar(api, "socio-013", "pista-2", "2026-11-25T13:30", "CLUB10");
+  assert.equal(despues.status, 201);
+});
+
+test("la penalización por cancelar fuera de plazo es el 100 % de lo que paga el socio", async () => {
+  const r = await reservar(api, "socio-015", "pista-1", "2026-11-25T18:00", "CLUB10");
+  assert.equal(r.status, 201);
+  const id = r.cuerpo.reserva.id;
+
+  const fuera = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(fuera.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+
+  const forzada = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 2520);
+});
+
+test("las reservas guardan los importes y el código, y la API los devuelve", async () => {
+  const creada = await reservar(api, "socio-016", "pista-3", "2026-11-25T09:00", "MANANAS");
+  const id = creada.cuerpo.reserva.id;
+
+  const una = (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva;
+  assert.deepEqual(
+    { importeBase: una.importeBase, descuento: una.descuento, importe: una.importe, codigo: una.codigo },
+    { importeBase: 1200, descuento: 400, importe: 800, codigo: "MANANAS" },
