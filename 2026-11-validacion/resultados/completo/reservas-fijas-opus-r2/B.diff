+test("10 y 11. cancelar la serie y cancelar reservas sueltas de la serie", () => conApi(async (api) => {
+  const creada = (await crear(api, { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-12-01T12:00", semanas: 4 })).cuerpo.serie;
+  const [s1, s2, s3, s4] = creada.reservas;
+
+  // 11: una reserva suelta se cancela con las reglas de siempre y la serie sigue.
+  const suelta = await api.pedir("POST", `/api/reservas/${s4}/cancelar`, { cuerpo: { motivo: "vacaciones" } });
