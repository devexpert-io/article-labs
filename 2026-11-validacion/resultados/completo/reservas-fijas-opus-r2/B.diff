@@ -0,0 +1,208 @@
+// Reservas fijas semanales (docs/specs/reservas-fijas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const crear = (api: Api, cuerpo: unknown, socio: string | null = GESTOR) =>
+  api.pedir("POST", "/api/series", { cuerpo, socio: socio ?? undefined });
+
+test("1. solo un gestor crea, consulta y cancela series", () => conApi(async (api) => {
+  const cuerpo = { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-12-01T12:00", semanas: 2 };
+  const llamadas = [
+    (socio?: string) => crear(api, cuerpo, socio ?? null),
+    (socio?: string) => api.pedir("GET", "/api/series/S-0001", { socio }),
+    (socio?: string) => api.pedir("POST", "/api/series/S-0001/cancelar", { socio }),
+  ];
+  for (const llamar of llamadas) {
+    const anonimo = await llamar(undefined);
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await llamar("socio-001");
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.series.length, 0);
+  assert.equal((await crear(api, cuerpo)).status, 201);
+  assert.equal((await api.pedir("GET", "/api/series/S-0001", { socio: GESTOR })).status, 200);
+  assert.equal((await api.pedir("POST", "/api/series/S-0001/cancelar", { socio: GESTOR })).status, 200);
+}));
+
+test("2 y 5. datos inválidos y comprobaciones de toda la serie: no se crea nada", () => conApi(async (api) => {
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+  const base = { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-12-01T12:00", semanas: 4 };
+  const casos: [Record<string, unknown>, number, string][] = [
+    [{ semanas: 1 }, 400, "DATOS_INVALIDOS"],
+    [{ semanas: 13 }, 400, "DATOS_INVALIDOS"],
+    [{ semanas: 2.5 }, 400, "DATOS_INVALIDOS"],
+    [{ semanas: "4" }, 400, "DATOS_INVALIDOS"],
+    [{ semanas: undefined }, 400, "DATOS_INVALIDOS"],
+    [{ socioId: "socio-999" }, 404, "SOCIO_NO_ENCONTRADO"],
+    [{ pistaId: "pista-9" }, 404, "PISTA_NO_ENCONTRADA"],
+    [{ inicio: "2026-12-01T10:00" }, 400, "FRANJA_INVALIDA"],
+    [{ inicio: "1 de diciembre" }, 400, "FRANJA_INVALIDA"],
+    [{ inicio: "2026-12-32T12:00" }, 400, "FRANJA_INVALIDA"],
+    [{ inicio: "2027-02-30T12:00" }, 400, "FRANJA_INVALIDA"],
+    [{ inicio: "2026-11-18T09:00" }, 409, "FRANJA_PASADA"],
+    [{ inicio: "2026-11-17T21:00" }, 409, "FRANJA_PASADA"],
+    [{ socioId: "socio-011" }, 409, "CUOTA_INACTIVA"],
+    [{ pistaId: "pista-4" }, 409, "PISTA_CERRADA"],
+  ];
+  for (const [cambio, http, codigo] of casos) {
+    const r = await crear(api, { ...base, ...cambio });
+    assert.equal(r.status, http, JSON.stringify(cambio));
+    assert.equal(r.cuerpo.error.codigo, codigo, JSON.stringify(cambio));
+  }
+  const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(despues.reservas.length, antes.reservas.length);
+  assert.equal(despues.series.length, 0);
+}));
+
+test("3, 7 y 8. una reserva confirmada por semana, a la misma hora, con su serieId y su precio", () => conApi(async (api) => {
+  const corta = await crear(api, { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-12-01T12:00", semanas: 3 });
+  assert.equal(corta.status, 201);
+  const serie = corta.cuerpo.serie;
+  assert.equal(serie.id, "S-0001");
+  assert.equal(serie.socioId, "socio-041");
+  assert.equal(serie.pistaId, "pista-2");
+  assert.equal(serie.inicio, "2026-12-01T12:00");
