+  const retirarAjena = await api.pedir("DELETE", `/api/esperas/${e1}`, { socio: "socio-002" });
+  assert.equal(retirarAjena.status, 403);
+  assert.equal(retirarAjena.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const retirada = await api.pedir("DELETE", `/api/esperas/${e1}`, { socio: "socio-003" });
+  assert.equal(retirada.status, 200);
+  assert.equal(retirada.cuerpo.espera.estado, "retirada");
+  assert.equal(retirada.cuerpo.espera.posicion, undefined);
+
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-002" })).cuerpo.esperas[0].posicion, 1);
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-004" })).cuerpo.esperas[0].posicion, 2);
+
+  const porGestor = await api.pedir("DELETE", `/api/esperas/${e2}`, { socio: "socio-040" });
+  assert.equal(porGestor.status, 200);
+  const irene = await api.pedir("GET", "/api/esperas", { socio: "socio-004" });
+  assert.deepEqual(irene.cuerpo.esperas.map((e: any) => [e.id, e.posicion]), [[e3, 1]]);
+
+  const otra = await api.pedir("DELETE", `/api/esperas/${e1}`, { socio: "socio-003" });
