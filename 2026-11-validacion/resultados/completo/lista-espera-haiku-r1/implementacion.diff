@@ -0,0 +1,234 @@
+// Lista de espera de franjas (docs/specs/lista-espera.md), probada a través de la API.
+// Cada test arranca su propia API para no compartir estado entre ellos.
+//
+// Datos de la semilla que usan los tests (2026-11-18T10:00 es la hora del club):
+//   - Franja A: pista-1, jueves 19 a las 19:30, reservada por socio-007. Cancelar es gratis (faltan 33,5 h).
+//   - Franja B: pista-1, jueves 19 a las 18:00, reservada por socio-011 (sin cuota al día).
+//   - Franja C: pista-2, jueves 19 a las 10:30, reservada por socio-018.
+//   - socio-002 (Marta) y socio-004 (Irene) tienen cuota y, como mucho, una reserva futura.
+//   - socio-041 (Nora) no tiene reservas: se le añaden tres para que no pueda reservar más.
+//   - socio-040 es gestor.
+import assert from "node:assert/strict";
+import { after, afterEach, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const A = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+const B = { pistaId: "pista-1", inicio: "2026-11-19T18:00" };
+const C = { pistaId: "pista-2", inicio: "2026-11-19T10:30" };
+
+const abiertas: Api[] = [];
+async function nueva(entorno: Record<string, string> = {}): Promise<Api> {
+  const api = await arrancarApi(entorno);
+  abiertas.push(api);
+  return api;
+}
+afterEach(() => {
+  for (const api of abiertas.splice(0)) api.cerrar();
+});
+after(() => {
+  for (const api of abiertas.splice(0)) api.cerrar();
+});
+
+function apuntar(api: Api, socio: string | undefined, franja: unknown) {
+  return api.pedir("POST", "/api/esperas", { socio, cuerpo: franja });
+}
+
+/** Id de la reserva confirmada que ocupa una franja, leído del estado de pruebas. */
+async function reservaDe(api: Api, pistaId: string, inicio: string): Promise<string> {
+  const { reservas } = (await api.pedir("GET", "/_estado")).cuerpo;
+  const r = reservas.find((x: any) => x.pistaId === pistaId && x.inicio === inicio && x.estado === "confirmada");
+  assert.ok(r, `debería haber una reserva en ${pistaId} ${inicio}`);
+  return r.id;
+}
+
+test("apuntarse: 201 con la espera y su posición; sin X-Socio, 401", async () => {
+  const api = await nueva();
+  const anonimo = await apuntar(api, undefined, A);
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const primero = await apuntar(api, "socio-003", A);
+  assert.equal(primero.status, 201);
+  assert.equal(primero.cuerpo.espera.estado, "activa");
+  assert.equal(primero.cuerpo.espera.socioId, "socio-003");
+  assert.equal(primero.cuerpo.espera.pistaId, "pista-1");
+  assert.equal(primero.cuerpo.espera.inicio, "2026-11-19T19:30");
+  assert.equal(primero.cuerpo.espera.posicion, 1);
+
+  const segundo = await apuntar(api, "socio-002", A);
+  assert.equal(segundo.cuerpo.espera.posicion, 2);
+
+  const mias = await api.pedir("GET", "/api/esperas", { socio: "socio-002" });
+  assert.equal(mias.status, 200);
+  assert.deepEqual(mias.cuerpo.esperas.map((e: any) => [e.inicio, e.posicion]), [["2026-11-19T19:30", 2]]);
+});
+
+test("apuntarse: solo franjas ocupadas, con las mismas comprobaciones que reservar", async () => {
+  const api = await nueva();
+  const pistaInexistente = await apuntar(api, "socio-003", { pistaId: "pista-99", inicio: A.inicio });
+  assert.equal(pistaInexistente.cuerpo.error.codigo, "PISTA_NO_ENCONTRADA");
+  assert.equal(pistaInexistente.status, 404);
+
+  const cerrada = await apuntar(api, "socio-003", { pistaId: "pista-4", inicio: A.inicio });
+  assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+
+  const franjaInvalida = await apuntar(api, "socio-003", { pistaId: "pista-1", inicio: "2026-11-19T19:45" });
+  assert.equal(franjaInvalida.status, 400);
+  assert.equal(franjaInvalida.cuerpo.error.codigo, "FRANJA_INVALIDA");
+
+  const sinCuota = await apuntar(api, "socio-011", A);
+  assert.equal(sinCuota.cuerpo.error.codigo, "CUOTA_INACTIVA");
+
+  const pasada = await apuntar(api, "socio-003", { pistaId: "pista-1", inicio: "2026-11-18T09:00" });
+  assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+
+  const libre = await apuntar(api, "socio-003", { pistaId: "pista-2", inicio: A.inicio });
+  assert.equal(libre.status, 409);
+  assert.equal(libre.cuerpo.error.codigo, "FRANJA_LIBRE");
+
+  const sinDatos = await apuntar(api, "socio-003", {});
+  assert.equal(sinDatos.status, 400);
