+test("cancelar asigna la franja al primero que puede jugar y salta a quien no puede", async () => {
+  const api = await nueva();
+  // Nora tiene tres reservas futuras: aunque sea la primera de la lista, no puede reservar más.
+  for (const inicio of ["2026-11-25T09:00", "2026-11-25T10:30", "2026-11-25T12:00"]) {
+    const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio } });
+    assert.equal(creada.status, 201);
+  }
+  const nora = (await apuntar(api, "socio-041", A)).cuerpo.espera.id;
+  const marta = (await apuntar(api, "socio-002", A)).cuerpo.espera.id;
+  const irene = (await apuntar(api, "socio-004", A)).cuerpo.espera.id;
+
+  const reservaA = await reservaDe(api, A.pistaId, A.inicio);
+  const cancelada = await api.pedir("POST", `/api/reservas/${reservaA}/cancelar`, { cuerpo: {} });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+  const asignadaA = cancelada.cuerpo.asignadaA;
+  assert.match(asignadaA, /^R-\d{4}$/);
+
+  const reservaNueva = (await api.pedir("GET", `/api/reservas/${asignadaA}`)).cuerpo.reserva;
+  assert.equal(reservaNueva.socioId, "socio-002");
+  assert.equal(reservaNueva.pistaId, "pista-1");
+  assert.equal(reservaNueva.inicio, A.inicio);
+  assert.equal(reservaNueva.estado, "confirmada");
+  assert.equal(reservaNueva.importe, 2800, "jueves a las 19:30 es punta");
+  assert.equal(reservaNueva.notas, "Asignada desde la lista de espera");
+
+  const estados = Object.fromEntries((await api.pedir("GET", "/_estado")).cuerpo.esperas.map((e: any) => [e.id, e.estado]));
+  assert.equal(estados[nora], "descartada");
+  assert.equal(estados[marta], "asignada");
+  assert.equal(estados[irene], "activa");
+
+  const posicionIrene = await api.pedir("GET", "/api/esperas", { socio: "socio-004" });
+  assert.deepEqual(posicionIrene.cuerpo.esperas.map((e: any) => e.posicion), [1]);
+});
