@@ -0,0 +1,268 @@
+// Las reservas fijas (series semanales), probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-030";
+/** Nora Benítez: sin reservas en la semilla, para probar el límite de reservas normales. */
+const SIN_RESERVAS = "socio-041";
+
+/** Arranca una API nueva para cada caso, así que cada test parte de la semilla. */
+async function conApi(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function crearSerie(api: Api, cuerpo: unknown, socio = GESTOR) {
+  return api.pedir("POST", "/api/series", { cuerpo, socio });
+}
+
+async function mover(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function estadoDelClub(api: Api) {
+  return (await api.pedir("GET", "/_estado")).cuerpo;
+}
+
+test("solo un gestor crea, consulta y cancela series", () =>
+  conApi(async (api) => {
+    const cuerpo = { socioId: SOCIO, pistaId: "pista-1", inicio: "2026-12-01T12:00", semanas: 2 };
+    const sinCabecera = await api.pedir("POST", "/api/series", { cuerpo });
+    assert.equal(sinCabecera.status, 401);
+    assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const desconocido = await api.pedir("POST", "/api/series", { cuerpo, socio: "socio-999" });
+    assert.equal(desconocido.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await crearSerie(api, cuerpo, SOCIO);
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const creada = await crearSerie(api, cuerpo);
+    assert.equal(creada.status, 201);
+    const url = `/api/series/${creada.cuerpo.serie.id}`;
+    assert.equal((await api.pedir("GET", url)).status, 401);
+    const consultaSocio = await api.pedir("GET", url, { socio: SOCIO });
+    assert.equal(consultaSocio.status, 403);
+    assert.equal(consultaSocio.cuerpo.error.codigo, "SIN_PERMISO");
+    assert.equal((await api.pedir("POST", `${url}/cancelar`)).status, 401);
+    const cancelacionSocio = await api.pedir("POST", `${url}/cancelar`, { socio: SOCIO });
+    assert.equal(cancelacionSocio.status, 403);
+  }));
+
+test("los datos de la serie se validan: semanas, socio, pista y franja", () =>
+  conApi(async (api) => {
+    const base = { socioId: SOCIO, pistaId: "pista-1", inicio: "2026-12-01T12:00", semanas: 2 };
