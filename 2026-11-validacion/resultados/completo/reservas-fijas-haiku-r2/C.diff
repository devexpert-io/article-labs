+test("cancelar la serie: gratis con 24 h o más; con menos, pendientes salvo forzar", () =>
+  conApi(async (api) => {
+    const creada = await crearSerie(api, { socioId: SOCIO, pistaId: "pista-1", inicio: "2026-12-10T12:00", semanas: 3 });
+    const url = `/api/series/${creada.cuerpo.serie.id}/cancelar`;
+    await mover(api, "2026-12-09T13:00"); // la primera reserva empieza en 23 horas
+
+    const invalido = await api.pedir("POST", url, { cuerpo: { forzar: "si" }, socio: GESTOR });
+    assert.equal(invalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const sinForzar = await api.pedir("POST", url, { cuerpo: {}, socio: GESTOR });
+    assert.equal(sinForzar.status, 200);
+    assert.deepEqual(sinForzar.cuerpo.canceladas.map((r: any) => r.inicio), ["2026-12-17T12:00", "2026-12-24T12:00"]);
+    assert.deepEqual(sinForzar.cuerpo.pendientes.map((r: any) => r.inicio), ["2026-12-10T12:00"]);
+    for (const r of sinForzar.cuerpo.canceladas) {
+      assert.equal(r.estado, "cancelada");
+      assert.equal(r.penalizacion, undefined, "cancelar con 24 h de margen es gratis");
+    }
+    assert.equal(sinForzar.cuerpo.pendientes[0].estado, "confirmada");
+    assert.equal(sinForzar.cuerpo.serie.reservas.length, 3);
+
+    const conForzar = await api.pedir("POST", url, { cuerpo: { forzar: true }, socio: GESTOR });
+    assert.deepEqual(conForzar.cuerpo.canceladas.map((r: any) => r.inicio), ["2026-12-10T12:00"]);
+    assert.equal(conForzar.cuerpo.canceladas[0].penalizacion, 1800, "penalización del 100 % del importe");
+    assert.deepEqual(conForzar.cuerpo.pendientes, []);
+
+    const otraVez = await api.pedir("POST", url, { cuerpo: { forzar: true }, socio: GESTOR });
+    assert.deepEqual(otraVez.cuerpo.canceladas, [], "las canceladas no se vuelven a tocar");
+    assert.deepEqual(otraVez.cuerpo.pendientes, []);
+  }));
