@@ -0,0 +1,221 @@
+// La lista de espera de franjas, probada a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Franjas ocupadas en la semilla (ahora = 2026-11-18T10:00).
+const JUEVES = { pistaId: "pista-1", inicio: "2026-11-19T19:30" }; // socio-007, más de 24 h: se cancela gratis
+const SABADO = { pistaId: "pista-1", inicio: "2026-11-21T15:00" }; // socio-009
+const SABADO_2 = { pistaId: "pista-2", inicio: "2026-11-21T15:00" }; // socio-012
+const MARTA = { pistaId: "pista-3", inicio: "2026-11-19T09:00" }; // socio-002, faltan 23 h
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function idDeReserva(api: Api, franja: { pistaId: string; inicio: string }): Promise<string> {
+  const r = await api.pedir("GET", `/api/reservas?fecha=${franja.inicio.slice(0, 10)}&pista=${franja.pistaId}&estado=confirmada&limite=100`);
+  return r.cuerpo.reservas.find((x: { inicio: string }) => x.inicio === franja.inicio).id;
+}
+
+test("apuntarse a una franja ocupada: 201 con la espera activa y su posición", () => conApi(async (api) => {
+  const r = await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: JUEVES });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.espera.socioId, "socio-041");
+  assert.equal(r.cuerpo.espera.pistaId, JUEVES.pistaId);
+  assert.equal(r.cuerpo.espera.inicio, JUEVES.inicio);
+  assert.equal(r.cuerpo.espera.estado, "activa");
+  assert.equal(r.cuerpo.espera.posicion, 1);
+  assert.match(r.cuerpo.espera.id, /^E-\d{4}$/);
+  const sin = await api.pedir("POST", "/api/esperas", { cuerpo: JUEVES });
+  assert.equal(sin.status, 401);
+  assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+}));
+
+test("solo se esperan franjas ocupadas que se podrían reservar", () => conApi(async (api) => {
+  const casos: [unknown, string, number, string?][] = [
+    [{ pistaId: "pista-2", inicio: "2026-11-19T19:30" }, "FRANJA_LIBRE", 409],
+    [{ pistaId: "pista-9", inicio: "2026-11-19T19:30" }, "PISTA_NO_ENCONTRADA", 404],
+    [{ pistaId: "pista-4", inicio: "2026-11-19T19:30" }, "PISTA_CERRADA", 409],
+    [{ pistaId: "pista-1", inicio: "2026-11-19T19:00" }, "FRANJA_INVALIDA", 400],
+    [{ pistaId: "pista-1", inicio: "mañana" }, "FRANJA_INVALIDA", 400],
+    [{ pistaId: "pista-1", inicio: "2026-11-17T19:30" }, "FRANJA_PASADA", 409],
+    [JUEVES, "CUOTA_INACTIVA", 409, "socio-011"],
+    [{ pistaId: "pista-1" }, "DATOS_INVALIDOS", 400],
+  ];
+  for (const [cuerpo, codigo, http, socio] of casos) {
+    const r = await api.pedir("POST", "/api/esperas", { socio: socio ?? "socio-041", cuerpo });
+    assert.equal(r.status, http, codigo);
+    assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+}));
+
+test("sin duplicados, sin esperar lo propio y como mucho 2 esperas activas", () => conApi(async (api) => {
+  assert.equal((await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: JUEVES })).status, 201);
+  const repetida = await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: JUEVES });
+  assert.equal(repetida.cuerpo.error.codigo, "YA_EN_ESPERA");
+  const propia = await api.pedir("POST", "/api/esperas", { socio: "socio-007", cuerpo: JUEVES });
+  assert.equal(propia.status, 409);
+  assert.equal(propia.cuerpo.error.codigo, "YA_RESERVADA");
+  assert.equal((await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: SABADO })).status, 201);
+  const tercera = await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: SABADO_2 });
+  assert.equal(tercera.status, 409);
+  assert.equal(tercera.cuerpo.error.codigo, "LIMITE_DE_ESPERAS");
+  // Una espera retirada ya no cuenta para el límite.
+  const mias = (await api.pedir("GET", "/api/esperas", { socio: "socio-041" })).cuerpo.esperas;
+  await api.pedir("DELETE", `/api/esperas/${mias[0].id}`, { socio: "socio-041" });
+  assert.equal((await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: SABADO_2 })).status, 201);
+}));
+
+test("la posición es el orden de llegada y un gestor consulta las esperas de otro socio", () => conApi(async (api) => {
+  const a = await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: JUEVES });
+  const b = await api.pedir("POST", "/api/esperas", { socio: "socio-004", cuerpo: JUEVES });
+  const c = await api.pedir("POST", "/api/esperas", { socio: "socio-005", cuerpo: JUEVES });
+  await api.pedir("POST", "/api/esperas", { socio: "socio-004", cuerpo: SABADO });
+  assert.deepEqual([a, b, c].map((r) => r.cuerpo.espera.posicion), [1, 2, 3]);
+
+  const irene = await api.pedir("GET", "/api/esperas", { socio: "socio-004" });
+  assert.equal(irene.status, 200);
+  assert.deepEqual(irene.cuerpo.esperas.map((e: any) => [e.inicio, e.posicion]), [[JUEVES.inicio, 2], [SABADO.inicio, 1]]);
+  assert.ok(irene.cuerpo.esperas.every((e: any) => e.socioId === "socio-004" && e.estado === "activa"));
+
