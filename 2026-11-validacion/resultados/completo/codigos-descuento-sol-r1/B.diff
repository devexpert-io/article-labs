@@ -0,0 +1,166 @@
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { crearClub, ErrorDelClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+
+let api: Api;
+beforeEach(async () => { api = await arrancarApi(); });
+afterEach(() => api.cerrar());
+
+function reservar(codigo?: unknown, inicio = "2026-11-26T09:00", socioId = "socio-041", pistaId = "pista-3") {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio, ...(codigo !== undefined ? { codigo } : {}) } });
+}
+function error(respuesta: Respuesta, status: number, codigo: string) {
+  assert.equal(respuesta.status, status);
+  assert.equal(respuesta.cuerpo.error.codigo, codigo);
+}
+async function reloj(ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+test("sin código: guarda los importes y los devuelve en detalle y listado sin modificar el historial", async () => {
+  const historial = (await api.pedir("GET", "/api/reservas/R-0001")).cuerpo.reserva;
+  const respuesta = await reservar();
+  assert.equal(respuesta.status, 201);
+  const r = respuesta.cuerpo.reserva;
+  assert.equal(r.importeBase, 1200);
+  assert.equal(r.descuento, 0);
+  assert.equal(r.importe, 1200);
+  assert.equal(Object.hasOwn(r, "codigo"), false);
+  assert.deepEqual((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva, r);
+  assert.deepEqual((await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.reservas, [r]);
+  assert.deepEqual((await api.pedir("GET", "/api/reservas/R-0001")).cuerpo.reserva, historial);
+});
+
+test("BIENVENIDA descuenta el 50 %, persiste y no permite repetir ni tras cancelar", async () => {
+  const respuesta = await reservar(" bienvenida ");
+  assert.equal(respuesta.status, 201);
+  const r = respuesta.cuerpo.reserva;
+  assert.equal(r.importeBase, 1200);
+  assert.equal(r.descuento, 600);
+  assert.equal(r.importe, 600);
+  assert.equal(r.codigo, "BIENVENIDA");
+  assert.deepEqual((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva, r);
+  assert.deepEqual((await api.pedir("GET", "/api/reservas?socio=socio-041")).cuerpo.reservas, [r]);
+  error(await reservar("BIENVENIDA", "2026-11-26T10:30"), 409, "CODIGO_NO_APLICABLE");
+  assert.equal((await api.pedir("POST", `/api/reservas/${r.id}/cancelar`)).status, 200);
+  error(await reservar("BIENVENIDA"), 409, "CODIGO_NO_APLICABLE");
+});
+
+test("BIENVENIDA rechaza historial en cualquier estado", async () => {
+  await reloj("2026-12-01T10:00");
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  for (const tipo of ["confirmada", "cancelada", "no_presentada"]) {
+    const anterior = estado.reservas.find((r: any) => r.estado === tipo && estado.socios.some((s: any) => s.id === r.socioId && s.cuotaActiva));
+    error(await reservar("BIENVENIDA", "2026-12-02T09:00", anterior.socioId), 409, "CODIGO_NO_APLICABLE");
+  }
+});
+
+test("BIENVENIDA incluye todo el 31 de diciembre y usa la fecha de creación", async () => {
+  await reloj("2026-12-31T23:59");
+  const r = await reservar("BIENVENIDA", "2027-01-04T09:00");
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.descuento, 600);
+});
+
+test("BIENVENIDA caduca al empezar 2027 sin consumir la primera reserva", async () => {
+  await reloj("2027-01-01T00:00");
+  error(await reservar("BIENVENIDA", "2027-01-04T09:00"), 409, "CODIGO_NO_APLICABLE");
+  await reloj("2026-12-31T23:59");
+  assert.equal((await reservar("BIENVENIDA", "2027-01-04T09:00")).status, 201);
+});
+
+test("MANANAS acepta lunes a viernes, antes de las 12, sin caducidad ni límite de usos", async () => {
+  for (const fecha of ["2027-01-04", "2027-01-05", "2027-01-06", "2027-01-07", "2027-01-08"]) {
+    await reloj(`${fecha}T08:00`);
+    const r = await reservar("MANANAS", `${fecha}T10:30`);
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.descuento, 400);
+    assert.equal(r.cuerpo.reserva.importe, 800);
+  }
+});
+
+test("MANANAS rechaza las 12:00, la tarde y ambos días del fin de semana", async () => {
+  for (const inicio of ["2026-11-26T12:00", "2026-11-26T18:00", "2026-11-28T09:00", "2026-11-29T10:30"]) {
+    error(await reservar("MANANAS", inicio), 409, "CODIGO_NO_APLICABLE");
+  }
+});
+
+test("CLUB10 admite tres usos históricos, normaliza y libera usos cancelados por socio", async () => {
+  const reservas = [];
+  for (const fecha of ["2026-11-26", "2026-11-27", "2026-11-28"]) {
+    await reloj(`${fecha}T08:00`);
+    const r = await reservar("  club10 ", `${fecha}T18:00`);
+    assert.equal(r.status, 201);
+    assert.equal(r.cuerpo.reserva.importeBase, 2000);
+    assert.equal(r.cuerpo.reserva.descuento, 200);
+    assert.equal(r.cuerpo.reserva.importe, 1800);
+    assert.equal(r.cuerpo.reserva.codigo, "CLUB10");
+    reservas.push(r.cuerpo.reserva);
+  }
+  // Las dos primeras ya pasaron: no es el límite de reservas futuras.
+  error(await reservar("CLUB10", "2026-11-30T09:00"), 409, "CODIGO_NO_APLICABLE");
+  assert.equal((await reservar("CLUB10", "2026-11-30T09:00", "socio-004")).status, 201);
+  assert.equal((await api.pedir("POST", `/api/reservas/${reservas[2].id}/cancelar`, { cuerpo: { forzar: true } })).status, 200);
+  assert.equal((await reservar("CLUB10", "2026-11-30T10:30")).status, 201);
+});
+
+test("formato: rechaza códigos desconocidos, vacíos, combinados y valores que no sean texto", async () => {
+  for (const codigo of ["OTRO", "", "  ", "CLUB10 MANANAS", "CLUB10,BIENVENIDA"]) {
+    error(await reservar(codigo), 400, "CODIGO_INVALIDO");
+  }
+  for (const codigo of [null, 10, true, ["CLUB10"], { codigo: "CLUB10" }]) {
+    error(await reservar(codigo), 400, "DATOS_INVALIDOS");
+  }
+  assert.equal((await reservar("BIENVENIDA")).status, 201);
+});
+
+test("las reglas del club preceden al código y los fallos no consumen usos", async () => {
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+  error(await reservar("OTRO", "2026-11-26T09:00", "socio-011"), 409, "CUOTA_INACTIVA");
+  error(await reservar(null, "2026-11-26T09:00", "socio-041", "pista-4"), 409, "PISTA_CERRADA");
+  error(await reservar("OTRO", "2026-11-26T11:00"), 400, "FRANJA_INVALIDA");
+  error(await reservar("OTRO", "2026-11-18T09:00"), 409, "FRANJA_PASADA");
+  error(await reservar("BIENVENIDA", "2026-11-19T19:30", "socio-041", "pista-1"), 409, "FRANJA_NO_DISPONIBLE");
+  const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(despues.contador, antes.contador);
+  assert.deepEqual(despues.reservas, antes.reservas);
+  for (const hora of ["09:00", "10:30", "12:00"]) {
+    assert.equal((await reservar("CLUB10", `2026-11-26T${hora}`)).status, 201);
+  }
+  error(await reservar("OTRO", "2026-11-27T09:00"), 409, "LIMITE_DE_RESERVAS");
+});
+
+test("la penalización usa el importe descontado y la disponibilidad conserva el precio", async () => {
+  const ruta = "/api/disponibilidad?fecha=2026-11-26&pista=pista-3";
+  const antes = (await api.pedir("GET", ruta)).cuerpo.pistas[0].franjas[0];
+  const r = (await reservar("BIENVENIDA")).cuerpo.reserva;
+  assert.equal(antes.precio, r.importeBase);
+  const despues = (await api.pedir("GET", ruta)).cuerpo.pistas[0].franjas[0];
+  assert.equal(despues.precio, antes.precio);
+  await reloj("2026-11-25T10:00");
+  error(await api.pedir("POST", `/api/reservas/${r.id}/cancelar`), 409, "FUERA_DE_PLAZO");
+  const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 600);
+  assert.equal(cancelada.cuerpo.reserva.descuento, 600);
+});
+
+// La API actual no permite marcar ausencias ni editar precios: se prueban esas
+// condiciones del dominio con un estado local, sin ampliar la API de la feature.
+test("CLUB10 cuenta las no presentadas; el descuento nunca supera el precio", () => {
+  const estado = crearSemilla();
+  estado.reservas = [];
+  estado.pistas[2]!.precioValle = 301;
+  const club = crearClub(estado);
+  for (const hora of ["09:00", "10:30", "12:00"]) {
+    const { reserva } = club.crearReserva({ socioId: "socio-041", pistaId: "pista-3", inicio: `2026-11-26T${hora}`, codigo: "CLUB10" });
+    assert.equal(reserva.descuento, 30);
+    reserva.estado = "no_presentada";
+  }
+  assert.throws(() => club.crearReserva({ socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-27T09:00", codigo: "CLUB10" }),
+    (e: unknown) => e instanceof ErrorDelClub && e.codigo === "CODIGO_NO_APLICABLE" && e.http === 409);
+  estado.reservas[0]!.estado = "cancelada";
+  assert.equal(club.crearReserva({ socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-27T09:00", codigo: "MANANAS" }).reserva.importe, 0);
+});
