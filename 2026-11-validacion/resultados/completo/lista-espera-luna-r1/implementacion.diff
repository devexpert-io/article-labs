+test("lista de espera: posiciones, permisos, asignación y caducidad", async () => {
+  const franja = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+  const sinIdentidad = await api.pedir("POST", "/api/esperas", { cuerpo: franja });
+  assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const una = await api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: franja });
+  const dos = await api.pedir("POST", "/api/esperas", { socio: "socio-003", cuerpo: franja });
+  assert.equal(una.status, 201);
+  assert.equal(una.cuerpo.espera.posicion, 1);
+  assert.equal(dos.cuerpo.espera.posicion, 2);
+  const ajena = await api.pedir("DELETE", `/api/esperas/${una.cuerpo.espera.id}`, { socio: "socio-003" });
+  assert.equal(ajena.cuerpo.error.codigo, "SIN_PERMISO");
+  const retirada = await api.pedir("DELETE", `/api/esperas/${una.cuerpo.espera.id}`, { socio: "socio-041" });
+  assert.equal(retirada.cuerpo.espera.estado, "retirada");
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-003" })).cuerpo.esperas[0].posicion, 1);
+  const reserva = (await api.pedir("GET", "/_estado")).cuerpo.reservas.find((r: any) => r.pistaId === franja.pistaId && r.inicio === franja.inicio && r.estado === "confirmada");
+  const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+  assert.equal(typeof cancelada.cuerpo.asignadaA, "string");
+  const creada = (await api.pedir("GET", "/_estado")).cuerpo.reservas.find((r: any) => r.id === cancelada.cuerpo.asignadaA);
+  assert.equal(creada.socioId, "socio-003");
+  assert.equal(creada.notas, "Asignada desde la lista de espera");
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-003" })).cuerpo.esperas.length, 0);
+});
+
+test("esperas caducan al empezar la franja y la franja libre no admite espera", async () => {
+  const otra = await arrancarApi();
+  try {
+    const libre = await otra.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: { pistaId: "pista-1", inicio: "2026-11-24T09:00" } });
+    assert.equal(libre.cuerpo.error.codigo, "FRANJA_LIBRE");
+    const franja = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+    const anotada = await otra.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: franja });
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: franja.inicio } });
+    assert.equal((await otra.pedir("GET", "/api/esperas", { socio: "socio-041" })).cuerpo.esperas.length, 0);
+    const estado = (await otra.pedir("GET", "/_estado")).cuerpo;
+    const reserva = estado.reservas.find((r: any) => r.pistaId === franja.pistaId && r.inicio === franja.inicio && r.estado === "confirmada");
+    assert.ok(reserva);
+    assert.equal(anotada.cuerpo.espera.estado, "activa");
+  } finally { otra.cerrar(); }
+});
