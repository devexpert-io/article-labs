@@ -0,0 +1,176 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+/** Las facturas que deberían salir de un mes según el estado del club, calculadas aquí por separado. */
+function facturasEsperadas(reservas: any[], mes: string) {
+  const porSocio = new Map<string, any[]>();
+  for (const r of reservas) {
+    if (!r.inicio.startsWith(mes)) continue;
+    let linea;
+    if (r.estado === "confirmada" || r.estado === "no_presentada") linea = { reservaId: r.id, concepto: "Reserva", importe: r.importe };
+    else if (r.penalizacion > 0) linea = { reservaId: r.id, concepto: "Penalización", importe: r.penalizacion };
+    if (!linea) continue;
+    porSocio.set(r.socioId, [...(porSocio.get(r.socioId) ?? []), { inicio: r.inicio, linea }]);
+  }
+  return [...porSocio.keys()].sort().map((socioId) => {
+    const lineas = porSocio.get(socioId)!.sort((a, b) => a.inicio.localeCompare(b.inicio)).map((l) => l.linea);
+    const total = lineas.reduce((s, l) => s + l.importe, 0);
+    const base = Math.round(total / 1.21);
+    return { mes, socioId, lineas, total, base, iva: total - base };
+  });
+}
+
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("solo un gestor genera y consulta facturas", () => conApi({}, async (api) => {
+  const peticiones: [string, string, unknown?][] = [
+    ["POST", "/api/facturas", { mes: "2026-10" }],
+    ["GET", "/api/facturas?mes=2026-10"],
+    ["GET", "/api/facturas/F2026-0001"],
+  ];
+  for (const [metodo, ruta, cuerpo] of peticiones) {
+    const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+    assert.equal(anonimo.status, 401, `${metodo} ${ruta}`);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-004" });
+    assert.equal(socio.status, 403, `${metodo} ${ruta}`);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.facturas.length, 0, "sin permiso no se genera nada");
+}));
+
+test("solo se factura un mes cerrado con el formato AAAA-MM", () => conApi({}, async (api) => {
+  for (const mes of [undefined, "2026-13", "2026-00", "2026/10", "2026-10-01", 202610]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 400, `mes ${mes}`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  const consulta = await api.pedir("GET", "/api/facturas?mes=octubre", { socio: GESTOR });
+  assert.equal(consulta.status, 400);
+  assert.equal(consulta.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12"]) {
+    const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(abierto.status, 409, `mes ${mes}`);
+    assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  // El mes termina a medianoche: un minuto antes sigue abierto.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T23:59" } });
+  assert.equal((await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).cuerpo.error.codigo, "MES_ABIERTO");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T00:00" } });
+  assert.equal((await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).status, 201);
+}));
+
+test("octubre: una factura por socio, con sus líneas, IVA y numeración; generar otra vez no cambia nada", () => conApi({}, async (api) => {
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+  const generadas = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(generadas.status, 201);
+  const facturas = generadas.cuerpo.facturas;
+
+  const esperadas = facturasEsperadas(antes.reservas, "2026-10");
+  assert.ok(esperadas.length > 20, "octubre tiene historial de muchos socios");
+  assert.deepEqual(facturas.map(({ numero, ...resto }: any) => resto), esperadas);
+  assert.deepEqual(facturas.map((f: any) => f.numero), esperadas.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+
+  const facturados = new Set(facturas.map((f: any) => f.socioId));
+  assert.ok(!facturados.has("socio-041"), "Nora Benítez no tiene reservas y no tiene factura");
+  const soloCanceladas = antes.socios.map((s: any) => s.id).filter((id: string) => {
+    const deOctubre = antes.reservas.filter((r: any) => r.socioId === id && r.inicio.startsWith("2026-10"));
+    return deOctubre.length > 0 && deOctubre.every((r: any) => r.estado === "cancelada");
+  });
+  for (const id of soloCanceladas) assert.ok(!facturados.has(id), `${id} solo tiene canceladas sin penalización`);
+  const lineas = facturas.flatMap((f: any) => f.lineas);
+  const noPresentada = antes.reservas.find((r: any) => r.inicio.startsWith("2026-10") && r.estado === "no_presentada");
+  assert.deepEqual(lineas.find((l: any) => l.reservaId === noPresentada.id), { reservaId: noPresentada.id, concepto: "Reserva", importe: noPresentada.importe });
+  const cancelada = antes.reservas.find((r: any) => r.inicio.startsWith("2026-10") && r.estado === "cancelada");
+  assert.ok(!lineas.some((l: any) => l.reservaId === cancelada.id), "una cancelada sin penalización no se factura");
+  for (const f of facturas) {
+    assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+    assert.equal(f.base + f.iva, f.total);
+  }
+
+  const otraVez = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(otraVez.status, 200);
+  assert.deepEqual(otraVez.cuerpo.facturas, facturas);
+  const listadas = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(listadas.status, 200);
+  assert.deepEqual(listadas.cuerpo.facturas, facturas);
+  const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(despues.facturas.length, facturas.length, "generar dos veces no crea facturas nuevas");
+  assert.deepEqual(despues.reservas, antes.reservas, "facturar no toca las reservas");
+
+  const una = await api.pedir("GET", `/api/facturas/${facturas[3].numero}`, { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo.factura, facturas[3]);
+  const ninguna = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+  assert.equal(ninguna.status, 404);
+  assert.equal(ninguna.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  const sinGenerar = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+  assert.equal(sinGenerar.status, 200);
+  assert.deepEqual(sinGenerar.cuerpo.facturas, []);
+}));
+
+test("penalizaciones, IVA sobre el total y numeración entre meses y entre años", () => conApi({}, async (api) => {
+  // Marta López cancela fuera de plazo su reserva del jueves 19 (1200 de penalización).
+  const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1200);
+  // Nora Benítez reserva para enero de 2027: 1800 + 1200 = 3000.
+  for (const [pistaId, inicio] of [["pista-1", "2027-01-05T09:00"], ["pista-3", "2027-01-05T10:30"]]) {
+    assert.equal((await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId, inicio } })).status, 201);
+  }
+
+  const octubre = (await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR })).cuerpo.facturas;
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-01T08:00" } });
+
+  // Enero de 2027 se genera antes que noviembre: cada año empieza en 0001.
+  const enero = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2027-01" }, socio: GESTOR });
+  assert.equal(enero.status, 201);
+  assert.deepEqual(enero.cuerpo.facturas, [{
+    numero: "F2027-0001",
+    mes: "2027-01",
+    socioId: "socio-041",
+    lineas: [
+      { reservaId: enero.cuerpo.facturas[0].lineas[0].reservaId, concepto: "Reserva", importe: 1800 },
