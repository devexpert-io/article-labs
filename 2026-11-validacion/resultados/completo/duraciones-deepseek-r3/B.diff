+  const minuto = Number(mm);
+  if (minuto !== 0 && minuto !== 30) return false;
+  const minutos = Number(hh) * 60 + minuto;
+  return minutos >= 9 * 60 && minutos + duracion <= 22 * 60 + 30;
+}
