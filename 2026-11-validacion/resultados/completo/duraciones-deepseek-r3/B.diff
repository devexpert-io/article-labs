+// Reservas de 60, 90 y 120 minutos: duraciones, inicios, solapes, precios, disponibilidad y huecos.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Cada prueba arranca su propia API para no heredar las reservas de las demás. */
+async function enApi(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function crear(api: Api, datos: Record<string, unknown>) {
+  return api.pedir("POST", "/api/reservas", { cuerpo: datos });
+}
+
+test("duracion es opcional y vale 60, 90 o 120 minutos", () =>
+  enApi(async (api) => {
+    const corta = await crear(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-24T09:00", duracion: 60 });
+    assert.equal(corta.status, 201);
+    assert.equal(corta.cuerpo.reserva.duracion, 60);
+    assert.equal(corta.cuerpo.reserva.fin, "2026-11-24T10:00");
+
+    const larga = await crear(api, { socioId: "socio-006", pistaId: "pista-1", inicio: "2026-11-24T10:00", duracion: 120 });
+    assert.equal(larga.status, 201);
+    assert.equal(larga.cuerpo.reserva.duracion, 120);
+    assert.equal(larga.cuerpo.reserva.fin, "2026-11-24T12:00");
+
+    const porDefecto = await crear(api, { socioId: "socio-016", pistaId: "pista-1", inicio: "2026-11-24T12:00" });
+    assert.equal(porDefecto.status, 201);
+    assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+    assert.equal(porDefecto.cuerpo.reserva.fin, "2026-11-24T13:30");
+  }));
+
+test("cualquier duracion que no sea 60, 90 o 120 responde 400 DURACION_INVALIDA", () =>
+  enApi(async (api) => {
+    for (const duracion of [45, 30, 0, 180, -60, "60", null, 90.5, true]) {
+      const r = await crear(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-24T09:00", duracion });
+      assert.equal(r.status, 400, `duracion ${JSON.stringify(duracion)}`);
+      assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA");
+    }
+  }));
+
+test("una reserva empieza en punto o y media, no antes de las 09:00 y termina como muy tarde a las 22:30", () =>
+  enApi(async (api) => {
+    const invalidos = [
+      { inicio: "2026-11-24T09:15", duracion: 60 },
+      { inicio: "2026-11-24T08:30", duracion: 60 },
+      { inicio: "2026-11-24T08:00", duracion: 90 },
+      { inicio: "2026-11-24T21:00", duracion: 120 },
+      { inicio: "2026-11-24T22:00", duracion: 60 },
+      { inicio: "2026-11-24T22:30", duracion: 60 },
+      { inicio: "2026-12-01T99:00", duracion: 60 },
+      { inicio: "2026-12-01T99:00", duracion: 90 },
+      { inicio: "2026-12-01T99:00", duracion: 120 },
+      { inicio: "2026-12-01T98:00", duracion: 120 },
+      { inicio: "2026-12-01T24:00", duracion: 60 },
+    ];
+    for (const datos of invalidos) {
+      const r = await crear(api, { socioId: "socio-041", pistaId: "pista-1", ...datos });
+      assert.equal(r.status, 400, `${datos.inicio} durante ${datos.duracion} minutos`);
+      assert.equal(r.cuerpo.error.codigo, "FRANJA_INVALIDA");
+    }
+
+    const abre = await crear(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-24T09:00", duracion: 60 });
+    assert.equal(abre.status, 201, "a las 09:00 se puede empezar");
+
+    const cierra = await crear(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-24T20:30", duracion: 120 });
+    assert.equal(cierra.status, 201, "de 20:30 a 22:30 cabe entera");
+    assert.equal(cierra.cuerpo.reserva.fin, "2026-11-24T22:30");
+
+    const ultima = await crear(api, { socioId: "socio-006", pistaId: "pista-1", inicio: "2026-11-23T21:30", duracion: 60 });
+    assert.equal(ultima.status, 201);
+    assert.equal(ultima.cuerpo.reserva.fin, "2026-11-23T22:30");
+  }));
+
+test("no se solapa con ninguna reserva confirmada de la pista, tampoco con las de 90 minutos de siempre", () =>
+  enApi(async (api) => {
+    // El jueves 19 la pista 1 tiene confirmadas 18:00-19:30 y 19:30-21:00.
+    const dentro = await crear(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-19T19:30", duracion: 60 });
+    assert.equal(dentro.status, 409);
+    assert.equal(dentro.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+
+    const cruza = await crear(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-19T18:30", duracion: 120 });
+    assert.equal(cruza.status, 409);
+
+    // Que una termine justo cuando empieza otra no es solaparse.
+    const antes = await crear(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-19T17:00", duracion: 60 });
+    assert.equal(antes.status, 201);
+    assert.equal(antes.cuerpo.reserva.fin, "2026-11-19T18:00");
+
+    // Una reserva nueva de 120 minutos ocupa dos franjas de 90.
