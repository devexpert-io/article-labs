+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado } from "../src/tipos.ts";
+
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas\r\n";
+const gestor = { socio: "socio-040" };
+let api: Api;
+before(async () => { api = await arrancarApi(); });
+after(() => api.cerrar());
+
+test("exportar requiere identificarse como gestor, incluso sin parámetros", async () => {
+  for (const [socio, status, codigo] of [
+    [undefined, 401, "NO_IDENTIFICADO"],
+    ["socio-999", 401, "NO_IDENTIFICADO"],
+    ["socio-001", 403, "SIN_PERMISO"],
+  ] as const) {
+    const r = await api.pedir("GET", "/api/reservas/exportar", { socio });
+    assert.equal(r.status, status);
+    assert.equal(r.cuerpo.error.codigo, codigo);
+    assert.equal(r.cabeceras.get("content-type"), "application/json; charset=utf-8");
+  }
+});
+
+test("exporta todas las reservas del periodo, ordenadas, con nombres e importes en euros", async () => {
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-31", gestor);
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-10-31.csv"');
+  const reservas = estado.reservas.filter((r) => r.inicio >= "2026-10-01" && r.inicio < "2026-11-01")
+    .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.pistaId.localeCompare(b.pistaId));
+  assert.equal(reservas.length, 315, "no se aplica el límite de 100 del listado JSON");
+  assert.equal(reservas[0]!.inicio.slice(0, 10), "2026-10-01");
+  assert.equal(reservas.at(-1)!.inicio.slice(0, 10), "2026-10-31");
+  assert.deepEqual(new Set(reservas.map((r) => r.estado)), new Set(["confirmada", "cancelada", "no_presentada"]));
+  const filas = reservas.map((r) => {
+    const socio = estado.socios.find((s) => s.id === r.socioId)!;
+    const pista = estado.pistas.find((p) => p.id === r.pistaId)!;
+    return [r.id, r.inicio.slice(0, 10), r.inicio.slice(11), pista.nombre, socio.nombre, socio.email,
+      r.estado, (r.importe / 100).toFixed(2), "", r.notas].join(",") + "\r\n";
+  });
+  assert.equal(r.texto, CABECERA + filas.join(""));
+  assert.equal(r.texto.replaceAll("\r\n", "").includes("\n"), false);
+});
+
+test("filtra cada estado y admite un periodo de un solo día", async () => {
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  for (const filtro of ["confirmada", "cancelada", "no_presentada"]) {
+    const r = await api.pedir("GET", `/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-01&estado=${filtro}`, gestor);
+    assert.equal(r.status, 200);
+    const filas = r.texto.slice(CABECERA.length).split("\r\n").filter(Boolean).map((f) => f.split(","));
+    const esperadas = estado.reservas.filter((r) => r.inicio.startsWith("2026-10-01T") && r.estado === filtro);
+    assert.deepEqual(filas.map((f) => f[0]), esperadas.map((r) => r.id));
+    assert.ok(filas.every((f) => f[1] === "2026-10-01" && f[6] === filtro));
+  }
+});
+
+test("sin reservas devuelve solo la cabecera terminada en CRLF", async () => {
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2027-01-01&hasta=2027-01-01", gestor);
+  assert.equal(r.status, 200);
+  assert.equal(r.texto, CABECERA);
+});
+
+test("rechaza periodos ausentes, mal formados, inexistentes o invertidos y estados desconocidos", async () => {
+  const consultas = [
+    "", "desde=2026-10-01", "hasta=2026-10-31",
+    "desde=&hasta=2026-10-31", "desde=2026-10-01&hasta=",
+    "desde=2026-1-01&hasta=2026-10-31", "desde=2026-10-01&hasta=31-10-2026",
+    "desde=2026-02-30&hasta=2026-03-01", "desde=2026-02-01&hasta=2026-02-29",
+    "desde=2026-13-01&hasta=2026-13-02", "desde=2026-10-31&hasta=2026-10-01",
+    "desde=2026-10-01&hasta=2026-10-31&estado=pendiente",
+    "desde=2026-10-01&hasta=2026-10-31&estado=",
+  ];
+  for (const consulta of consultas) {
+    const r = await api.pedir("GET", `/api/reservas/exportar?${consulta}`, gestor);
+    assert.equal(r.status, 400, consulta);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", consulta);
+  }
+});
+
+test("el máximo son 92 días inclusivos, también entre años, en año bisiesto y al cambiar la hora", async () => {
+  for (const [desde, hasta, status] of [
+    ["2026-10-01", "2026-12-31", 200],
+    ["2026-10-01", "2027-01-01", 400],
+    ["2026-12-01", "2027-03-02", 200],
+    ["2026-12-01", "2027-03-03", 400],
+    ["2028-02-01", "2028-05-02", 200],
+    ["2028-02-01", "2028-05-03", 400],
+  ] as const) {
+    const r = await api.pedir("GET", `/api/reservas/exportar?desde=${desde}&hasta=${hasta}`, gestor);
+    assert.equal(r.status, status, `${desde} / ${hasta}`);
+    if (status === 400) assert.equal(r.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+  }
+});
+
+test("escapa notas según RFC 4180 y ordena nuevas reservas sin alterar el listado JSON", async () => {
+  const casos = [
+    ["21:00", "Sin caracteres especiales", "Sin caracteres especiales"],
+    ["19:30", "Bolas, palas", '"Bolas, palas"'],
+    ["18:00", 'Dice "hola"', '"Dice ""hola"""'],
+    ["16:30", "Una\notra", '"Una\notra"'],
+    ["15:00", "Una\rotra", '"Una\rotra"'],
+    ["13:30", 'Una, "dos"\r\ntres', '"Una, ""dos""\r\ntres"'],
+    ["12:00", "", ""],
+  ];
+  const esperadas: { inicio: string; fila: string }[] = [];
+  for (const [hora, notas, escapadas] of casos) {
+    const inicio = `2026-12-01T${hora}`;
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio, notas },
+    });
+    assert.equal(creada.status, 201);
+    const id = creada.cuerpo.reserva.id;
+    assert.equal((await api.pedir("POST", `/api/reservas/${id}/cancelar`)).status, 200);
+    esperadas.push({ inicio, fila: `${id},2026-12-01,${hora},Pista 1,Nora Benítez,nora.benitez@example.com,cancelada,${hora! >= "18:00" ? "28.00" : "18.00"},,${escapadas}\r\n` });
+  }
+  // Otro inicio simultáneo en otra pista, insertado después para comprobar el desempate.
+  const otra = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-12-01T12:00" },
+  });
+  assert.equal(otra.status, 201);
+  const antes = await api.pedir("GET", "/api/reservas?desde=2026-12-01&hasta=2026-12-01&limite=2&pagina=2");
+  esperadas.sort((a, b) => a.inicio.localeCompare(b.inicio));
+  esperadas.splice(1, 0, { inicio: "2026-12-01T12:00", fila: `${otra.cuerpo.reserva.id},2026-12-01,12:00,Pista 2,Nora Benítez,nora.benitez@example.com,confirmada,18.00,,\r\n` });
+  const csv = await api.pedir("GET", "/api/reservas/exportar?desde=2026-12-01&hasta=2026-12-01", gestor);
+  assert.equal(csv.status, 200);
+  assert.equal(csv.texto, CABECERA + esperadas.map((r) => r.fila).join(""));
+  const despues = await api.pedir("GET", "/api/reservas?desde=2026-12-01&hasta=2026-12-01&limite=2&pagina=2");
+  assert.equal(despues.status, 200);
+  assert.equal(despues.cabeceras.get("content-type"), "application/json; charset=utf-8");
+  assert.deepEqual(despues.cuerpo, antes.cuerpo);
+  assert.equal(despues.cuerpo.total, 8);
+  assert.equal(despues.cuerpo.pagina, 2);
+  assert.equal(despues.cuerpo.paginas, 4);
+  assert.equal(despues.cuerpo.reservas.length, 2);
+  assert.equal(despues.cuerpo.reservas[0].inicio, "2026-12-01T18:00");
+});
+
+test("exporta la penalización de una cancelación fuera de plazo en euros", async () => {
+  const cancelada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-11-19&hasta=2026-11-19&estado=cancelada", gestor);
+  assert.equal(r.status, 200);
+  assert.ok(r.texto.includes("R-0520,2026-11-19,09:00,Pista 3,Marta López,marta.lopez@example.com,cancelada,12.00,12.00,\r\n"));
+});
