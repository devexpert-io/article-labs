+/** Base de un total con IVA (21 %) incluido: total / 1,21 al céntimo, con medio céntimo hacia arriba. */
+export function baseImponible(total: number): number {
+  return Math.floor((200 * total + 121) / 242);
+}
+
+/** Línea de factura de una reserva: su importe si se jugó o no se presentó, su penalización si se canceló con ella. */
+function lineaDeReserva(r: Reserva): LineaFactura | undefined {
+  if (r.estado !== "cancelada") return { reservaId: r.id, concepto: "Reserva", importe: r.importe };
+  if (r.penalizacion !== undefined && r.penalizacion > 0) {
+    return { reservaId: r.id, concepto: "Penalización", importe: r.penalizacion };
+  }
+  return undefined;
