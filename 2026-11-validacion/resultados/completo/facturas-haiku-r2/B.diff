+    if (linea) porSocio.set(r.socioId, [...(porSocio.get(r.socioId) ?? []), linea]);
+  }
+  const nuevas: Factura[] = [];
+  for (const socioId of [...porSocio.keys()].sort()) {
+    const lineas = porSocio.get(socioId)!;
+    const total = lineas.reduce((suma, l) => suma + l.importe, 0);
+    const base = baseImponible(total);
+    emitidas += 1;
+    nuevas.push({
+      numero: `${prefijo}${String(emitidas).padStart(4, "0")}`,
+      mes,
+      socioId,
+      lineas,
+      total,
+      base,
+      iva: total - base,
+    });
+  }
+  estado.facturas.push(...nuevas);
+  estado.mesesFacturados.push(mes);
+  return nuevas;
+}
