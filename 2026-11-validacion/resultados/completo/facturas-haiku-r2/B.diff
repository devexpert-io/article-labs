+test("el IVA se calcula sobre el total de la factura, redondeado al céntimo", async () => {
+  for (const f of await facturasDe("2026-10")) {
+    assert.equal(f.total, f.lineas.reduce((suma: number, l: any) => suma + l.importe, 0));
+    assert.equal(f.base, Math.round(f.total / 1.21));
+    assert.equal(f.iva, f.total - f.base);
+    assert.equal(f.base + f.iva, f.total);
+  }
+  assert.equal(baseImponible(121), 100);
+  assert.equal(baseImponible(1800), 1488);
+  assert.equal(baseImponible(2800), 2314);
+  assert.equal(baseImponible(3600), 2975);
+});
