+++ b/test/facturas.test.ts
@@ -0,0 +1,211 @@
+// Las facturas mensuales: permisos, mes cerrado, líneas, IVA, numeración y repetición.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { baseImponible } from "../src/nucleo.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const AHORA = "2026-11-18T10:00";
+
+interface ReservaDeEstado {
+  id: string;
+  socioId: string;
+  pistaId: string;
+  inicio: string;
+  estado: string;
+  importe: number;
+  penalizacion?: number;
+}
+
+/**
+ * Las facturas que deben salir de un mes, calculadas aquí a partir de las reservas del estado.
+ * `primero` es el número de la primera factura del mes dentro de su año.
+ */
+function facturasEsperadas(reservas: ReservaDeEstado[], mes: string, primero: number) {
+  const delMes = reservas
+    .filter((r) => r.inicio.startsWith(`${mes}-`))
+    .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+  const porSocio = new Map<string, { reservaId: string; concepto: string; importe: number }[]>();
+  for (const r of delMes) {
+    let linea: { reservaId: string; concepto: string; importe: number } | undefined;
+    if (r.estado !== "cancelada") linea = { reservaId: r.id, concepto: "Reserva", importe: r.importe };
+    else if (r.penalizacion) linea = { reservaId: r.id, concepto: "Penalización", importe: r.penalizacion };
+    if (linea) porSocio.set(r.socioId, [...(porSocio.get(r.socioId) ?? []), linea]);
+  }
+  return [...porSocio.keys()].sort().map((socioId, i) => {
+    const lineas = porSocio.get(socioId)!;
+    const total = lineas.reduce((suma, l) => suma + l.importe, 0);
+    // Con céntimos enteros nunca cae justo en medio céntimo, así que el redondeo en coma flotante es seguro.
+    const base = Math.round(total / 1.21);
+    return {
+      numero: `F${mes.slice(0, 4)}-${String(primero + i).padStart(4, "0")}`,
+      mes,
+      socioId,
+      lineas,
+      total,
+      base,
+      iva: total - base,
+    };
+  });
+}
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi({ AHORA });
+});
+after(() => api.cerrar());
+
+const reloj = async (ahora: string) => {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+};
+const estado = async () => (await api.pedir("GET", "/_estado")).cuerpo;
+const facturasDe = async (mes: string) =>
+  (await api.pedir("GET", `/api/facturas?mes=${mes}`, { socio: GESTOR })).cuerpo.facturas;
+
+test("solo un gestor genera y consulta facturas", async () => {
+  const sinCabecera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+  assert.equal(sinCabecera.status, 401);
+  assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10")).status, 401);
+  assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001")).status, 401);
+
+  const socio = await api.pedir("POST", "/api/facturas", { socio: "socio-001", cuerpo: { mes: "2026-10" } });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" })).status, 403);
+
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).status, 200);
+});
+
+test("el mes tiene formato AAAA-MM y tiene que estar cerrado", async () => {
+  for (const mes of ["2026-1", "2026-13", "2026-00", "octubre", 202610, undefined]) {
+    const r = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes } });
+    assert.equal(r.status, 400, `mes ${mes}`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12"]) {
+    const r = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes } });
+    assert.equal(r.status, 409, `mes ${mes}`);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=octubre", { socio: GESTOR })).status, 400);
+  assert.equal((await api.pedir("GET", "/api/facturas", { socio: GESTOR })).status, 400);
+});
+
+test("antes de generar, el mes no tiene facturas y el número no existe", async () => {
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo, { facturas: [] });
+  const noExiste = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: GESTOR });
+  assert.equal(noExiste.status, 404);
+  assert.equal(noExiste.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("una cancelación fuera de plazo con penalización queda en octubre", async () => {
+  await reloj("2026-10-10T10:00");
+  const pistas = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-10-12")).cuerpo.pistas;
+  // Franjas del 12 de octubre antes de las 10:30: a 21 o 22,5 horas de la cancelación, dentro del plazo de penalización.
+  const libre = pistas
+    .flatMap((p: any) => p.franjas.filter((f: any) => f.estado === "libre" && f.inicio <= "2026-10-12T10:30").map((f: any) => ({ pistaId: p.pistaId, inicio: f.inicio })))[0];
+  assert.ok(libre, "debe haber una franja libre para la prueba");
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", ...libre } });
+  assert.equal(creada.status, 201);
+  await reloj("2026-10-11T12:00");
+  const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, creada.cuerpo.reserva.importe);
+  await reloj(AHORA);
+});
+
+test("genera las facturas de un mes cerrado: una por socio, con sus líneas y en orden", async () => {
+  const reservas: ReservaDeEstado[] = (await estado()).reservas;
+  const esperadas = facturasEsperadas(reservas, "2026-10", 1);
+  const r = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10" } });
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.cuerpo.facturas, esperadas);
+
+  // Octubre tiene de todo: canceladas sin penalización (que no se facturan) y penalizaciones.
+  const sinPenalizacion = reservas.filter((x) => x.inicio.startsWith("2026-10-") && x.estado === "cancelada" && !x.penalizacion);
+  assert.ok(sinPenalizacion.length > 0);
+  const facturadas = new Set(r.cuerpo.facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId)));
+  for (const x of sinPenalizacion) assert.ok(!facturadas.has(x.id), `${x.id} cancelada sin penalización no se factura`);
+  const penalizadas = reservas.filter((x) => x.inicio.startsWith("2026-10-") && x.penalizacion);
+  assert.equal(penalizadas.length, 1);
