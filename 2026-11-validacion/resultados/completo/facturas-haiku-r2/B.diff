+/** Genera las facturas de un mes: una por socio con algo que facturar, numeradas en orden de socio. */
+function generarMes(estado: Estado, mes: string): Factura[] {
+  const prefijo = `F${mes.slice(0, 4)}-`;
+  let emitidas = estado.facturas.filter((f) => f.numero.startsWith(prefijo)).length;
+  const reservas = estado.reservas
+    .filter((r) => r.inicio.slice(0, 7) === mes)
+    .sort((a, b) => (a.inicio !== b.inicio ? (a.inicio < b.inicio ? -1 : 1) : a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
+  const porSocio = new Map<string, LineaFactura[]>();
