+/** Convierte la hora local del club a un instante, sin depender de la zona del proceso. */
+function instanteMadrid(local: string): number {
+  const comoUtc = Date.parse(`${local}:00Z`);
+  let instante = comoUtc;
+  for (let i = 0; i < 3; i++) {
+    const zona = zonaMadrid.formatToParts(instante).find((p) => p.type === "timeZoneName")!.value;
+    const [, signo, horas, minutos] = /^GMT([+-])(\d{2}):(\d{2})$/.exec(zona)!;
+    const desplazamiento = (Number(horas) * 60 + Number(minutos)) * (signo === "+" ? 1 : -1);
+    const corregido = comoUtc - desplazamiento * 60_000;
+    if (corregido === instante) break;
+    instante = corregido;
+  }
+  return instante;
+}
