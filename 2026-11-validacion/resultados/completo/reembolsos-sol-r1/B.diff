+test("caja incluye confirmadas y no presentadas del mes, conserva las canceladas y todas las pistas", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const antes: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.ok(antes.reservas.some((r) => r.estado === "no_presentada"));
+  for (const mes of ["2026-10", "2026-11", "2028-01"]) {
+    const respuesta = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: "socio-040" });
+    assert.equal(respuesta.status, 200);
+    assert.equal(respuesta.cuerpo.mes, mes);
+    const pistas = antes.pistas.map((p) => {
+      let reservas = 0, ingresos = 0, penalizaciones = 0;
+      for (const r of antes.reservas) {
+        if (r.pistaId !== p.id || !r.inicio.startsWith(`${mes}-`)) continue;
+        if (r.estado === "cancelada") penalizaciones += r.penalizacion ?? 0;
+        else { reservas++; ingresos += r.importe; }
+      }
+      return { pistaId: p.id, reservas, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    }).sort((a, b) => a.pistaId.localeCompare(b.pistaId));
+    assert.deepEqual(respuesta.cuerpo.pistas, pistas);
+    for (const campo of ["reservas", "ingresos", "penalizaciones", "total"] as const) {
+      assert.equal(respuesta.cuerpo.total[campo], pistas.reduce((suma, p) => suma + p[campo], 0));
+    }
+  }
+  const despues: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.deepEqual(despues.reservas, antes.reservas);
+});
