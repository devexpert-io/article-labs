     estado.reservas.some((r) => r.pistaId === pistaId && r.inicio === inicio && r.estado === "confirmada");
 
   return {
+    generarFacturas(valor: unknown) {
+      if (typeof valor !== "string" || !MES.test(valor)) invalido("mes debe tener el formato AAAA-MM");
+      const mes = valor as string;
+      const anio = mes.slice(0, 4);
+      if (mes >= estado.ahora.slice(0, 7)) throw new ErrorDelClub("MES_ABIERTO", "El mes todavía no ha terminado");
+      if (estado.mesesFacturados.includes(mes)) return { facturas: estado.facturas.filter((f) => f.mes === mes), creada: false };
+      const porSocio = new Map<string, { reserva: Reserva; concepto: "Reserva" | "Penalización"; importe: number }[]>();
+      for (const r of estado.reservas) {
+        if (!r.inicio.startsWith(`${mes}-`)) continue;
+        let concepto: "Reserva" | "Penalización" | undefined;
+        let importe = 0;
+        if (r.estado === "confirmada" || r.estado === "no_presentada") { concepto = "Reserva"; importe = r.importe; }
+        else if (r.estado === "cancelada" && (r.penalizacion ?? 0) > 0) { concepto = "Penalización"; importe = r.penalizacion!; }
+        if (!concepto) continue;
+        const lineas = porSocio.get(r.socioId) ?? [];
+        lineas.push({ reserva: r, concepto, importe });
+        porSocio.set(r.socioId, lineas);
+      }
+      const previas = estado.facturas.filter((f) => f.numero.startsWith(`F${anio}-`)).length;
+      const facturas: Factura[] = [...porSocio.entries()].sort(([a], [b]) => a.localeCompare(b)).map(([socioId, candidatas], i) => {
+        const ordenadas = candidatas.sort((a, b) => a.reserva.inicio.localeCompare(b.reserva.inicio) || a.reserva.id.localeCompare(b.reserva.id));
+        const lineas = ordenadas.map(({ reserva, concepto, importe }) => ({ reservaId: reserva.id, concepto, importe }));
+        const total = lineas.reduce((suma, l) => suma + l.importe, 0);
+        const base = Math.floor(total * 100 / 121 + 0.5);
+        return { numero: `F${anio}-${String(previas + i + 1).padStart(4, "0")}`, mes, socioId, lineas, total, base, iva: total - base };
+      });
+      estado.facturas.push(...facturas);
+      estado.mesesFacturados.push(mes);
+      return { facturas, creada: true };
+    },
+
+    listarFacturas(mes: unknown) {
+      if (typeof mes !== "string" || !MES.test(mes)) invalido("mes debe tener el formato AAAA-MM");
+      return { facturas: estado.facturas.filter((f) => f.mes === mes) };
+    },
+
+    obtenerFactura(numero: string) {
+      const factura = estado.facturas.find((f) => f.numero === numero);
+      if (!factura) throw new ErrorDelClub("FACTURA_NO_ENCONTRADA", `No existe la factura ${numero}`, 404);
+      return { factura };
+    },
+
     listarPistas() {
       return { pistas: estado.pistas };
     },
