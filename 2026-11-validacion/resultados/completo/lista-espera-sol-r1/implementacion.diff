+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+const franja = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+const segunda = { pistaId: "pista-2", inicio: "2026-11-21T15:00" };
+const tercera = { pistaId: "pista-1", inicio: "2026-11-21T16:30" };
+const apuntar = (api: Api, socio = "socio-041", cuerpo = franja) =>
+  api.pedir("POST", "/api/esperas", { socio, cuerpo });
+
+async function conApi(ejecutar: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try { await ejecutar(api); } finally { api.cerrar(); }
+}
+
+async function comprobarError(respuesta: ReturnType<Api["pedir"]>, status: number, codigo: string) {
+  const r = await respuesta;
+  assert.equal(r.status, status, r.texto);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+async function reservaDe(api: Api, datos = franja) {
+  const r = await api.pedir("GET",
+    `/api/reservas?fecha=${datos.inicio.slice(0, 10)}&pista=${datos.pistaId}&estado=confirmada`);
+  return r.cuerpo.reservas.find((r: any) => r.inicio === datos.inicio);
+}
+
+test("esperas: identidad obligatoria, alta propia y validaciones de franja", async () => {
+  await conApi(async (api) => {
+    for (const [metodo, ruta] of [["POST", "/api/esperas"], ["GET", "/api/esperas"], ["DELETE", "/api/esperas/E-0001"]]) {
+      await comprobarError(api.pedir(metodo!, ruta!, { cuerpo: metodo === "POST" ? franja : undefined }), 401, "NO_IDENTIFICADO");
+    }
+    await comprobarError(apuntar(api, "socio-999"), 401, "NO_IDENTIFICADO");
+    const casos = [
+      [{ ...franja, pistaId: "pista-999" }, "socio-041", 404, "PISTA_NO_ENCONTRADA"],
+      [{ ...franja, pistaId: "pista-4" }, "socio-041", 409, "PISTA_CERRADA"],
+      [{ ...franja, inicio: "2026-11-19T19:00" }, "socio-041", 400, "FRANJA_INVALIDA"],
+      [{ ...franja, inicio: "mal" }, "socio-041", 400, "FRANJA_INVALIDA"],
+      [{ ...franja, inicio: "2026-11-18T09:00" }, "socio-041", 409, "FRANJA_PASADA"],
+      [franja, "socio-011", 409, "CUOTA_INACTIVA"],
+      [{ ...franja, pistaId: "pista-2" }, "socio-041", 409, "FRANJA_LIBRE"],
+      [franja, "socio-007", 409, "YA_RESERVADA"],
+    ] as const;
+    for (const [cuerpo, socio, status, codigo] of casos) {
+      await comprobarError(apuntar(api, socio, cuerpo), status, codigo);
+    }
+    await comprobarError(api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: {} }), 400, "DATOS_INVALIDOS");
+    const alta = await api.pedir("POST", "/api/esperas", {
+      socio: "socio-041", cuerpo: { ...franja, socioId: "socio-004" },
+    });
+    assert.equal(alta.status, 201);
+    assert.deepEqual(alta.cuerpo.espera, {
+      id: "E-0001", socioId: "socio-041", ...franja, estado: "activa", posicion: 1,
+    });
+  });
+});
+
+test("esperas: duplicados, límite, permisos, retirada y posiciones por franja", async () => {
+  await conApi(async (api) => {
+    const primera = (await apuntar(api)).cuerpo.espera;
+    const detras = (await apuntar(api, "socio-004")).cuerpo.espera;
+    assert.equal(detras.posicion, 2);
+    assert.equal((await apuntar(api, "socio-041", segunda)).cuerpo.espera.posicion, 1);
+    await comprobarError(apuntar(api), 409, "YA_EN_ESPERA");
+    await comprobarError(apuntar(api, "socio-041", tercera), 409, "LIMITE_DE_ESPERAS");
+    const propias = await api.pedir("GET", "/api/esperas", { socio: "socio-041" });
+    assert.equal(propias.cuerpo.esperas.length, 2);
+    assert.ok(propias.cuerpo.esperas.every((e: any) => e.socioId === "socio-041"));
+    await comprobarError(api.pedir("GET", "/api/esperas?socio=socio-041", { socio: "socio-004" }), 403, "SIN_PERMISO");
+    const consulta = await api.pedir("GET", "/api/esperas?socio=socio-041", { socio: "socio-040" });
+    assert.deepEqual(consulta.cuerpo, propias.cuerpo);
+    await comprobarError(api.pedir("DELETE", `/api/esperas/${primera.id}`, { socio: "socio-004" }), 403, "SIN_PERMISO");
+    await comprobarError(api.pedir("DELETE", "/api/esperas/no-existe", { socio: "socio-040" }), 404, "ESPERA_NO_ENCONTRADA");
+    const retirada = await api.pedir("DELETE", `/api/esperas/${primera.id}`, { socio: "socio-040" });
+    assert.equal(retirada.status, 200);
