index 0000000..0bcf4d3
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,170 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Factura, Reserva } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+const generar = (api: Api, mes: string) => api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+const reloj = (api: Api, ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+
+test("solo el gestor puede generar, listar y consultar facturas", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const [metodo, ruta] of [
+    ["POST", "/api/facturas"],
+    ["GET", "/api/facturas?mes=2026-10"],
+    ["GET", "/api/facturas/F2026-0001"],
+  ]) {
+    for (const [socio, status, codigo] of [
+      [undefined, 401, "NO_IDENTIFICADO"],
+      ["socio-999", 401, "NO_IDENTIFICADO"],
+      ["socio-001", 403, "SIN_PERMISO"],
+    ] as const) {
+      const respuesta = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      assert.equal(respuesta.status, status);
+      assert.equal(respuesta.cuerpo.error.codigo, codigo);
+    }
+  }
+  const creada = await generar(api, "2026-10");
+  assert.equal(creada.status, 201);
+  const lista = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor });
+  assert.equal(lista.status, 200);
+  assert.deepEqual(lista.cuerpo, creada.cuerpo);
+  const factura = creada.cuerpo.facturas[0];
+  const consulta = await api.pedir("GET", `/api/facturas/${factura.numero}`, { socio: gestor });
+  assert.equal(consulta.status, 200);
+  assert.deepEqual(consulta.cuerpo, { factura });
+});
+
+test("valida el mes y solo genera meses terminados según el reloj del club", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const mes of [undefined, null, 202610, "", "26-10", "2026-1", "2026-00", "2026-13", "2026-10-01", "2026-10\n"]) {
+    for (const metodo of ["POST", "GET"]) {
+      const ruta = metodo === "GET" ? `/api/facturas${mes === undefined ? "" : `?mes=${encodeURIComponent(String(mes))}`}` : "/api/facturas";
+      const respuesta = await api.pedir(metodo, ruta, { socio: gestor, cuerpo: metodo === "POST" ? { mes } : undefined });
+      assert.equal(respuesta.status, 400, `${metodo}: ${mes}`);
+      assert.equal(respuesta.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const respuesta = await generar(api, mes);
+    assert.equal(respuesta.status, 409);
+    assert.equal(respuesta.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj(api, "2026-11-30T23:59");
+  assert.equal((await generar(api, "2026-11")).status, 409);
+  await reloj(api, "2026-12-01T00:00");
+  const noviembre = await generar(api, "2026-11");
+  assert.equal(noviembre.status, 201);
+  assert.equal(noviembre.cuerpo.facturas[0].numero, "F2026-0001", "los errores no consumen números");
+});
+
+test("octubre: una factura por socio, líneas ordenadas, no presentadas e IVA sobre el total", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const reservas: Reserva[] = estado.reservas.filter((r: Reserva) => r.inicio.startsWith("2026-10"));
+  assert.ok(reservas.some((r) => r.estado === "no_presentada"));
+  assert.ok(reservas.some((r) => r.estado === "cancelada"));
+  const facturables = reservas.filter((r) => r.estado !== "cancelada");
+  const socios = [...new Set(facturables.map((r) => r.socioId))].sort();
+  const respuesta = await generar(api, "2026-10");
+  assert.equal(respuesta.status, 201);
+  const facturas: Factura[] = respuesta.cuerpo.facturas;
+  assert.deepEqual(facturas.map((f) => f.socioId), socios);
+  assert.ok(!facturas.some((f) => f.socioId === "socio-041"));
+  let difiereDelRedondeoPorLinea = false;
+  for (const [i, factura] of facturas.entries()) {
+    const delSocio = facturables.filter((r) => r.socioId === factura.socioId).sort((a, b) => a.inicio.localeCompare(b.inicio));
+    const total = delSocio.reduce((suma, r) => suma + r.importe, 0);
+    // Redondeo con cociente y resto enteros, independiente del cálculo de producción.
+    const base = Math.floor(total * 100 / 121) + ((total * 100 % 121) * 2 >= 121 ? 1 : 0);
+    assert.deepEqual(factura, {
+      numero: `F2026-${String(i + 1).padStart(4, "0")}`,
+      mes: "2026-10", socioId: socios[i],
+      lineas: delSocio.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })),
+      total, base, iva: total - base,
+    });
+    if (base !== delSocio.reduce((suma, r) => suma + Math.round(r.importe / 1.21), 0)) difiereDelRedondeoPorLinea = true;
+  }
+  assert.ok(difiereDelRedondeoPorLinea, "el historial detecta el cálculo incorrecto de IVA por línea");
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, estado.reservas, "facturar no modifica reservas");
+  const repetida = await generar(api, "2026-10");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo, respuesta.cuerpo);
+});
+
+test("las cancelaciones con penalización se facturan por su mes de inicio y las gratuitas se excluyen", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const crear = async (inicio: string) => {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio } });
+    assert.equal(r.status, 201);
+    return r.cuerpo.reserva;
+  };
+  const gratis = await crear("2026-12-02T09:00");
+  const penalizada = await crear("2026-12-01T09:00");
+  const confirmada = await crear("2026-12-01T10:30");
+  const canceladaGratis = await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`);
+  assert.equal(canceladaGratis.status, 200);
+  assert.equal(canceladaGratis.cuerpo.reserva.penalizacion, undefined);
+  await reloj(api, "2026-11-30T12:00");
+  const fuera = await api.pedir("POST", `/api/reservas/${penalizada.id}/cancelar`);
+  assert.equal(fuera.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const cancelada = await api.pedir("POST", `/api/reservas/${penalizada.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1200);
+  await reloj(api, "2027-01-01T00:00");
+  const diciembre = await generar(api, "2026-12");
+  assert.equal(diciembre.status, 201);
+  assert.deepEqual(diciembre.cuerpo.facturas, [{
+    numero: "F2026-0001", mes: "2026-12", socioId: "socio-041",
+    lineas: [
+      { reservaId: penalizada.id, concepto: "Penalización", importe: 1200 },
+      { reservaId: confirmada.id, concepto: "Reserva", importe: 1200 },
+    ],
+    total: 2400, base: 1983, iva: 417,
+  }]);
+  const noviembre = await generar(api, "2026-11");
+  assert.ok(!noviembre.cuerpo.facturas.some((f: Factura) => f.socioId === "socio-041"));
+  const pasada = await api.pedir("POST", `/api/reservas/${confirmada.id}/cancelar`);
+  assert.equal(pasada.cuerpo.error.codigo, "RESERVA_PASADA");
+  const repetida = await generar(api, "2026-12");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo, diciembre.cuerpo);
+});
+
+test("numeración correlativa por orden de generación y año; meses vacíos y consultas ausentes", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const mes of ["2026-09", "2026-10", "2026-11"]) {
+    const consulta = await api.pedir("GET", `/api/facturas?mes=${mes}`, { socio: gestor });
+    assert.equal(consulta.status, 200);
+    assert.deepEqual(consulta.cuerpo, { facturas: [] });
+  }
+  const ausente = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: gestor });
+  assert.equal(ausente.status, 404);
+  assert.equal(ausente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  assert.equal((await generar(api, "2026-09")).status, 201);
+  const vacio = await generar(api, "2026-09");
+  assert.equal(vacio.status, 200);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  await reloj(api, "2026-12-01T00:00");
+  const noviembre = await generar(api, "2026-11");
+  assert.equal(noviembre.status, 201);
+  assert.equal(noviembre.cuerpo.facturas[0].numero, "F2026-0001");
+  const octubre = await generar(api, "2026-10");
+  assert.equal(octubre.status, 201);
+  const todas: Factura[] = [...noviembre.cuerpo.facturas, ...octubre.cuerpo.facturas];
+  assert.deepEqual(todas.map((f) => f.numero), todas.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+  assert.deepEqual((await generar(api, "2026-11")).cuerpo, noviembre.cuerpo);
+  const nueva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2027-01-04T09:00" } });
+  assert.equal(nueva.status, 201);
+  await reloj(api, "2027-02-01T00:00");
+  const enero = await generar(api, "2027-01");
+  assert.equal(enero.status, 201);
+  assert.equal(enero.cuerpo.facturas.length, 1);
+  assert.equal(enero.cuerpo.facturas[0].numero, "F2027-0001");
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).cuerpo, octubre.cuerpo);
+});
