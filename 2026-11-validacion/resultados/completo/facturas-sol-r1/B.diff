+      let contador = estado.facturas.filter((f) => f.mes.startsWith(`${ano}-`)).length;
+      const facturas: Factura[] = [...porSocio.keys()].sort().map((socioId) => {
+        const lineas = porSocio.get(socioId)!;
+        const total = lineas.reduce((suma, linea) => suma + linea.importe, 0);
+        const base = Math.round(total * 100 / 121);
+        contador += 1;
+        return { numero: `F${ano}-${String(contador).padStart(4, "0")}`, mes, socioId, lineas, total, base, iva: total - base };
+      });
+      estado.facturas.push(...facturas);
+      estado.mesesFacturados.push(mes);
+      return { facturas, creada: true };
+    },
+
+    listarFacturas(mes: unknown) {
+      validarMes(mes);
+      return { facturas: estado.facturas.filter((f) => f.mes === mes) };
+    },
+
+    obtenerFactura(numero: string) {
+      const factura = estado.facturas.find((f) => f.numero === numero);
+      if (!factura) throw new ErrorDelClub("FACTURA_NO_ENCONTRADA", `No existe la factura ${numero}`, 404);
+      return { factura };
+    },
+
     listarPistas() {
       return { pistas: estado.pistas };
     },
