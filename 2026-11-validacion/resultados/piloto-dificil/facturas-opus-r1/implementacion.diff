+test("numeración correlativa entre meses y entre años, y generar dos veces no crea nada", async () => {
+  await conApi({ AHORA: "2026-11-25T10:00" }, async (api) => {
+    // Una reserva en diciembre de 2026 y otra en enero de 2027.
+    await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-10T09:00" } });
+    await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-004", pistaId: "pista-2", inicio: "2027-01-12T10:30" } });
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-01T10:00" } });
+    const generar = (mes: string) => api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+
+    // Se genera noviembre antes que octubre: la numeración sigue el orden de generación.
+    const noviembre = await generar("2026-11");
+    assert.equal(noviembre.status, 201);
+    const nNov = noviembre.cuerpo.facturas.length;
+    assert.ok(nNov > 0);
+    const octubre = await generar("2026-10");
+    const nOct = octubre.cuerpo.facturas.length;
+    const enero = await generar("2027-01");
+    const diciembre = await generar("2026-12");
+    const numeros2026 = [...noviembre.cuerpo.facturas, ...octubre.cuerpo.facturas, ...diciembre.cuerpo.facturas].map((f: any) => f.numero);
+    assert.deepEqual(numeros2026, Array.from({ length: nNov + nOct + 1 }, (_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+    assert.deepEqual(enero.cuerpo.facturas.map((f: any) => [f.numero, f.socioId]), [["F2027-0001", "socio-004"]]);
+
+    // Un mes sin nada que facturar se genera sin facturas y no consume números.
+    const vacio = await generar("2026-09");
+    assert.equal(vacio.status, 201);
+    assert.deepEqual(vacio.cuerpo.facturas, []);
+    assert.equal((await generar("2026-09")).status, 200);
+
+    // Generar otra vez devuelve las mismas facturas y no crea ninguna.
+    const antes = (await api.pedir("GET", "/_estado")).cuerpo.facturas.length;
+    const otraVez = await generar("2026-11");
+    assert.equal(otraVez.status, 200);
+    assert.deepEqual(otraVez.cuerpo.facturas, noviembre.cuerpo.facturas);
+    assert.equal((await generar("2026-12")).status, 200);
+    assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, antes);
+
+    // Ninguna repetida en todo el club.
+    const todas = (await api.pedir("GET", "/_estado")).cuerpo.facturas.map((f: any) => f.numero);
+    assert.equal(new Set(todas).size, todas.length);
+  });
+});
