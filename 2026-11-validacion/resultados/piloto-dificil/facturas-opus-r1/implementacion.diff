new file mode 100644
index 0000000..74eda54
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,244 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+/** Base esperada calculada de otra forma: total·100/121 nunca cae justo en medio céntimo, así que basta Math.round. */
+const baseEsperada = (total: number) => Math.round((total * 100) / 121);
+
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+/** Las facturas que deberían salir de un mes, calculadas a partir del estado completo del club. */
+function esperadas(estado: any, mes: string) {
+  const porSocio = new Map<string, any[]>();
+  for (const r of estado.reservas) {
+    if (r.inicio.slice(0, 7) !== mes) continue;
+    let linea;
+    if (r.estado === "confirmada" || r.estado === "no_presentada") linea = { reservaId: r.id, concepto: "Reserva", importe: r.importe, inicio: r.inicio };
+    else if (r.penalizacion) linea = { reservaId: r.id, concepto: "Penalización", importe: r.penalizacion, inicio: r.inicio };
+    if (!linea) continue;
+    porSocio.set(r.socioId, [...(porSocio.get(r.socioId) ?? []), linea]);
+  }
+  return [...porSocio.keys()].sort().map((socioId) => ({
+    socioId,
+    lineas: porSocio.get(socioId)!.sort((a, b) => a.inicio.localeCompare(b.inicio)).map(({ inicio: _, ...l }) => l),
+  }));
+}
+
+test("permisos: solo un gestor genera y consulta facturas", async () => {
+  await conApi({ AHORA: "2026-11-18T10:00" }, async (api) => {
+    for (const [metodo, ruta, cuerpo] of [
+      ["POST", "/api/facturas", { mes: "2026-10" }],
+      ["GET", "/api/facturas?mes=2026-10", undefined],
+      ["GET", "/api/facturas/F2026-0001", undefined],
+    ] as const) {
+      const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+      assert.equal(anonimo.status, 401, `${metodo} ${ruta}`);
+      assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+      const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-004" });
+      assert.equal(socio.status, 403, `${metodo} ${ruta}`);
+      assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+      const desconocido = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-999" });
+      assert.equal(desconocido.status, 401);
+    }
+    // Ninguna de esas llamadas ha generado nada.
+    assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.facturas, []);
+  });
+});
+
+test("mes cerrado: formato AAAA-MM y solo meses que ya han terminado", async () => {
+  await conApi({ AHORA: "2026-11-18T10:00" }, async (api) => {
+    for (const mes of [undefined, "2026-1", "2026-13", "2026-00", "2026-10-01", 202610, "octubre"]) {
+      const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+      assert.equal(r.status, 400, String(mes));
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    assert.equal((await api.pedir("GET", "/api/facturas", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+    assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-13", { socio: GESTOR })).status, 400);
+    for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+      const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+      assert.equal(r.status, 409, mes);
+      assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+    }
+    // El último minuto del mes todavía es el mes; a las 00:00 del día 1 ya ha terminado.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T23:59" } });
+    assert.equal((await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).cuerpo.error.codigo, "MES_ABIERTO");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T00:00" } });
+    assert.equal((await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).status, 201);
+  });
+});
+
+test("octubre de 2026: una factura por socio con algo que facturar, líneas, total e IVA", async () => {
+  await conApi({ AHORA: "2026-11-18T10:00" }, async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(r.status, 201);
+    const { facturas } = r.cuerpo;
+    const previstas = esperadas(estado, "2026-10");
+    assert.ok(previstas.length > 10, "octubre tiene historial de muchos socios");
+
+    // Una por socio que tiene algo que facturar, ordenadas por id de socio, y ninguna para los demás.
+    assert.deepEqual(facturas.map((f: any) => f.socioId), previstas.map((p) => p.socioId));
+    assert.ok(!facturas.some((f: any) => f.socioId === "socio-041"), "Nora Benítez no tiene reservas");
+    const sinNada = estado.socios.map((s: any) => s.id).filter((id: string) => !previstas.some((p) => p.socioId === id));
+    assert.ok(sinNada.length > 0 && sinNada.every((id: string) => !facturas.some((f: any) => f.socioId === id)));
+
+    // Las canceladas sin penalización no se facturan.
+    const canceladas = new Set(estado.reservas.filter((x: any) => x.inicio.startsWith("2026-10") && x.estado === "cancelada").map((x: any) => x.id));
+    assert.ok(canceladas.size > 0);
+    const facturadas = facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId));
+    assert.ok(facturadas.every((id: string) => !canceladas.has(id)));
+    // Las no presentadas sí, como Reserva.
+    const noPresentada = estado.reservas.find((x: any) => x.inicio.startsWith("2026-10") && x.estado === "no_presentada");
+    const lineaNoPresentada = facturas.flatMap((f: any) => f.lineas).find((l: any) => l.reservaId === noPresentada.id);
+    assert.deepEqual(lineaNoPresentada, { reservaId: noPresentada.id, concepto: "Reserva", importe: noPresentada.importe });
+
+    facturas.forEach((f: any, i: number) => {
+      assert.equal(f.mes, "2026-10");
+      assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+      assert.deepEqual(f.lineas, previstas[i]!.lineas);
+      assert.deepEqual(Object.keys(f.lineas[0]).sort(), ["concepto", "importe", "reservaId"]);
+      assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+      assert.equal(f.base, baseEsperada(f.total));
+      assert.equal(f.iva, f.total - f.base);
+    });
+    const total = facturas.reduce((s: number, f: any) => s + f.total, 0);
+    const reservasFacturables = estado.reservas.filter((x: any) => x.inicio.startsWith("2026-10") && x.estado !== "cancelada");
+    assert.equal(total, reservasFacturables.reduce((s: number, x: any) => s + x.importe, 0));
+  });
+});
+
+test("IVA: la base sale del total de la factura, no línea a línea, redondeada al céntimo", async () => {
+  await conApi({ AHORA: "2026-11-25T10:00" }, async (api) => {
+    // Nora Benítez no tiene reservas: le hacemos dos de 18,00 € en diciembre.
+    for (const inicio of ["2026-12-01T09:00", "2026-12-02T09:00"]) {
+      assert.equal((await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio } })).status, 201);
+    }
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-01T00:00" } });
+    const { facturas } = (await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR })).cuerpo;
+    assert.equal(facturas.length, 1);
+    const [f] = facturas;
+    assert.equal(f.socioId, "socio-041");
+    assert.equal(f.total, 3600);
+    // 3600 / 1,21 = 2975,206… → 2975 (línea a línea habrían sido 2 × 1488 = 2976).
+    assert.equal(f.base, 2975);
+    assert.equal(f.iva, 625);
+  });
+});
+
+test("penalizaciones: se facturan las canceladas con penalización y no las gratuitas", async () => {
+  await conApi({ AHORA: "2026-11-18T10:00" }, async (api) => {
+    // Marta López cancela fuera de plazo con penalización; luego reserva y cancela gratis.
+    const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 1200);
+    const gratis = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-002", pistaId: "pista-3", inicio: "2026-11-27T12:00" } });
+    await api.pedir("POST", `/api/reservas/${gratis.cuerpo.reserva.id}/cancelar`);
+    const confirmada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-002", pistaId: "pista-1", inicio: "2026-11-28T18:00" } });
+
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-03T09:00" } });
+    const { facturas } = (await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).cuerpo;
+    const marta = facturas.find((f: any) => f.socioId === "socio-002");
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    assert.deepEqual(marta.lineas, esperadas(estado, "2026-11").find((p) => p.socioId === "socio-002")!.lineas);
+    // La penalización y la reserva confirmada están, en orden de inicio y al final del mes; la cancelada gratis, no.
+    assert.deepEqual(marta.lineas.slice(-2), [
+      { reservaId: "R-0520", concepto: "Penalización", importe: 1200 },
+      { reservaId: confirmada.cuerpo.reserva.id, concepto: "Reserva", importe: 2800 },
+    ]);
+    assert.ok(!marta.lineas.some((l: any) => l.reservaId === gratis.cuerpo.reserva.id));
+    assert.equal(marta.total, marta.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+    assert.equal(marta.base, baseEsperada(marta.total));
+    assert.equal(marta.iva, marta.total - marta.base);
+  });
+});
