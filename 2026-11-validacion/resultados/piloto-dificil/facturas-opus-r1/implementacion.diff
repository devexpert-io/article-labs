+test("consultar facturas por mes y por número", async () => {
+  await conApi({ AHORA: "2026-11-18T10:00" }, async (api) => {
+    assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo, { facturas: [] });
+    const generadas = (await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR })).cuerpo.facturas;
+    const listadas = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.equal(listadas.status, 200);
+    assert.deepEqual(listadas.cuerpo.facturas, generadas);
+    // Un mes sin generar (aunque esté abierto) da una lista vacía.
+    assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-11", { socio: GESTOR })).cuerpo, { facturas: [] });
+
+    const una = await api.pedir("GET", `/api/facturas/${generadas[2].numero}`, { socio: GESTOR });
+    assert.equal(una.status, 200);
+    assert.deepEqual(una.cuerpo, { factura: generadas[2] });
+    for (const numero of ["F2026-9999", "F2025-0001", "nada"]) {
+      const no = await api.pedir("GET", `/api/facturas/${numero}`, { socio: GESTOR });
+      assert.equal(no.status, 404);
+      assert.equal(no.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+    }
+  });
+});
