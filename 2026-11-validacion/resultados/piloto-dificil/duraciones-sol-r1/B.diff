--- /dev/null
+++ b/test/duraciones.test.ts
@@ -0,0 +1,195 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+async function iniciar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+function reservar(api: Api, inicio: string, duracion?: unknown, pistaId = "pista-1", socioId = "socio-041") {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio, duracion } });
+}
+
+async function error(respuesta: ReturnType<typeof reservar>, status: number, codigo: string) {
+  const r = await respuesta;
+  assert.equal(r.status, status, r.texto);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+async function crear(api: Api, inicio: string, duracion?: number, pistaId?: string, socioId?: string) {
+  const r = await reservar(api, inicio, duracion, pistaId, socioId);
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.reserva;
+}
+
+async function cancelar(api: Api, id: string) {
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(r.status, 200, r.texto);
+  return r.cuerpo.reserva;
+}
+
+async function disponibilidad(api: Api, fecha = "2026-11-30", pista = "pista-1") {
+  const r = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pista}`);
+  assert.equal(r.status, 200);
+  return r.cuerpo.pistas[0];
+}
+
+test("duraciones admitidas, fin calculado y 90 por defecto", async (t) => {
+  const api = await iniciar(t);
+  for (const [duracion, fin] of [[60, "11:00"], [90, "11:30"], [120, "12:00"], [undefined, "11:30"]] as const) {
+    const r = await crear(api, "2026-11-30T10:00", duracion);
+    assert.equal(r.duracion, duracion ?? 90);
+    assert.equal(r.fin, `2026-11-30T${fin}`);
+    const leida = await api.pedir("GET", `/api/reservas/${r.id}`);
+    assert.deepEqual(leida.cuerpo.reserva, r);
+    assert.equal((await cancelar(api, r.id)).duracion, duracion ?? 90);
+  }
+  for (const duracion of [null, 0, -60, 30, 61, 150, 90.5, "60", "90", true, [], {}]) {
+    await error(reservar(api, "2026-11-30T10:00", duracion), 400, "DURACION_INVALIDA");
+  }
+});
+
+test("inicios en punto o y media dentro del horario para cada duración", async (t) => {
+  const api = await iniciar(t);
+  for (const duracion of [60, 90, 120]) {
+    for (const hora of ["08:30", "09:15", "10:01", "12:60", "23:00", "24:00", "99:00"]) {
+      await error(reservar(api, `2026-11-30T${hora}`, duracion), 400, "FRANJA_INVALIDA");
+    }
+    await error(reservar(api, "2026-11-30 10:00", duracion), 400, "FRANJA_INVALIDA");
+    const apertura = await crear(api, "2026-11-30T09:00", duracion);
+    await cancelar(api, apertura.id);
+    const ultima = duracion === 60 ? "21:30" : duracion === 90 ? "21:00" : "20:30";
+    const r = await crear(api, `2026-11-30T${ultima}`, duracion);
+    assert.equal(r.fin, "2026-11-30T22:30");
+    await cancelar(api, r.id);
+    const tarde = duracion === 60 ? "22:00" : duracion === 90 ? "21:30" : "21:00";
+    await error(reservar(api, `2026-11-30T${tarde}`, duracion), 400, "FRANJA_INVALIDA");
+  }
+});
+
+test("solapes de intervalos, contigüidad, otras pistas y canceladas", async (t) => {
+  const api = await iniciar(t);
+  const central = await crear(api, "2026-11-30T12:00", 90);
+  for (const [hora, duracion] of [["11:00", 120], ["12:00", 60], ["12:30", 60], ["13:00", 120], ["11:30", 120]] as const) {
+    await error(reservar(api, `2026-11-30T${hora}`, duracion), 409, "FRANJA_NO_DISPONIBLE");
+  }
+  const otra = await crear(api, "2026-11-30T12:00", 60, "pista-2");
+  await cancelar(api, otra.id);
+  const antes = await crear(api, "2026-11-30T11:00", 60);
+  const despues = await crear(api, "2026-11-30T13:30", 120);
+  await cancelar(api, central.id);
+  const reemplazo = await crear(api, "2026-11-30T12:00", 90);
+  assert.equal(reemplazo.fin, despues.inicio);
+  assert.equal(antes.fin, reemplazo.inicio);
+});
+
+test("las reservas antiguas impiden solapes aunque no coincida el inicio", async (t) => {
+  const api = await iniciar(t);
+  await error(reservar(api, "2026-11-19T17:30", 60), 409, "FRANJA_NO_DISPONIBLE");
+  await error(reservar(api, "2026-11-19T20:30", 60), 409, "FRANJA_NO_DISPONIBLE");
+});
+
+test("precio por minutos, cruce de las 18:00 y fin de semana en todas las pistas", async (t) => {
+  const api = await iniciar(t);
+  for (const [pista, valle, punta] of [["pista-1", 1800, 2800], ["pista-2", 1800, 2800], ["pista-3", 1200, 2000]] as const) {
+    for (const [fecha, finde] of [["2026-11-30", false], ["2026-11-28", true], ["2026-11-29", true]] as const) {
+      for (const [hora, duracion, minutosValle] of [["12:30", 60, 60], ["17:30", 60, 30], ["17:30", 90, 30], ["17:00", 120, 60], ["18:00", 120, 0]] as const) {
+        const r = await crear(api, `${fecha}T${hora}`, duracion, pista);
+        const v = finde ? 0 : minutosValle;
+        assert.equal(r.importe, Math.round((v * valle + (duracion - v) * punta) / 90));
+        if (pista === "pista-1" && !finde && hora === "17:30" && duracion === 90) assert.equal(r.importe, 2467);
+        await cancelar(api, r.id);
+      }
+      // Todas las horas tradicionales siguen teniendo el precio original.
+      for (const hora of ["09:00", "10:30", "12:00", "13:30", "15:00", "16:30", "18:00", "19:30", "21:00"]) {
+        const r = await crear(api, `${fecha}T${hora}`, undefined, pista);
+        assert.equal(r.importe, finde || hora >= "18:00" ? punta : valle);
