+  assert.deepEqual(estado.reservas, semilla.reservas.map((r) => ({ ...r, duracion: 90 })));
+  for (let pagina = 1; pagina <= Math.ceil(semilla.reservas.length / 100); pagina++) {
+    const lista = await api.pedir("GET", `/api/reservas?limite=100&pagina=${pagina}`);
+    assert.ok(lista.cuerpo.reservas.every((r: any) => r.duracion === 90));
+  }
+  const antigua = semilla.reservas.find((r) => r.socioId === "socio-002" && r.inicio === "2026-11-19T09:00")!;
+  const leida = await api.pedir("GET", `/api/reservas/${antigua.id}`);
+  assert.equal(leida.cuerpo.reserva.duracion, 90);
+  const cancelada = await api.pedir("POST", `/api/reservas/${antigua.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.cuerpo.reserva.duracion, 90);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, antigua.importe);
+});
