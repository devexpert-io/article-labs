+test("una reserva de 90 minutos a una hora de siempre cuesta lo mismo que antes", () => conApi(async (api) => {
+  const pistas = (await api.pedir("GET", "/api/pistas")).cuerpo.pistas;
+  const precioDeSiempre = (pistaId: string, inicio: string) => {
+    const p = pistas.find((x: any) => x.id === pistaId);
+    const dia = new Date(`${inicio.slice(0, 10)}T12:00:00Z`).getUTCDay();
+    return dia === 0 || dia === 6 || inicio.slice(11) >= "18:00" ? p.precioPunta : p.precioValle;
+  };
+  // Las reservas de la semilla conservan su importe.
+  for (const r of (await api.pedir("GET", "/_estado")).cuerpo.reservas) {
+    assert.equal(r.importe, precioDeSiempre(r.pistaId, r.inicio), r.id);
+  }
+  // Las nuevas, un jueves y un sábado, en pistas con precios distintos.
+  let n = 0;
+  for (const [pistaId, fecha] of [["pista-1", "2026-11-26"], ["pista-3", "2026-11-28"]]) {
+    for (const hora of HORAS) {
+      const inicio = `${fecha}T${hora}`;
+      const r = await reservar(api, { socioId: LIBRES[Math.floor(n++ / 3)], pistaId, inicio });
+      assert.equal(r.status, 201, inicio);
+      assert.equal(r.cuerpo.reserva.importe, precioDeSiempre(pistaId!, inicio), `${pistaId} ${inicio}`);
+      const explicita = await reservar(api, { socioId: "socio-041", pistaId: "pista-2", inicio, duracion: 90 });
+      if (explicita.status === 201) {
+        assert.equal(explicita.cuerpo.reserva.importe, precioDeSiempre("pista-1", inicio));
+        await api.pedir("POST", `/api/reservas/${explicita.cuerpo.reserva.id}/cancelar`);
+      }
+    }
+  }
+}));
