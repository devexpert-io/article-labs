+test("disponibilidad: cada pista trae sus huecos libres del día", () => conApi(async (api) => {
+  const jueves = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-19");
+  const huecos = Object.fromEntries(jueves.cuerpo.pistas.map((p: any) => [p.pistaId, p.huecos]));
+  assert.deepEqual(huecos["pista-1"], [
+    { inicio: "2026-11-19T09:00", fin: "2026-11-19T12:00" },
+    { inicio: "2026-11-19T13:30", fin: "2026-11-19T18:00" },
+    { inicio: "2026-11-19T21:00", fin: "2026-11-19T22:30" },
+  ]);
+  assert.deepEqual(huecos["pista-4"], [], "una pista cerrada no tiene huecos");
+
+  // Un día sin reservas: un único hueco de 09:00 a 22:30.
+  const vacio = await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-02&pista=pista-2");
+  assert.deepEqual(vacio.cuerpo.pistas[0].huecos, [{ inicio: "2026-12-02T09:00", fin: "2026-12-02T22:30" }]);
+
+  // Con reservas nuevas de varias duraciones, pegadas y sueltas; las canceladas no cuentan.
+  await reservar(api, { socioId: "socio-006", pistaId: "pista-2", inicio: "2026-12-02T09:00", duracion: 60 });
+  await reservar(api, { socioId: "socio-016", pistaId: "pista-2", inicio: "2026-12-02T12:30", duracion: 120 });
+  await reservar(api, { socioId: "socio-020", pistaId: "pista-2", inicio: "2026-12-02T14:30", duracion: 60 });
+  await reservar(api, { socioId: "socio-023", pistaId: "pista-2", inicio: "2026-12-02T21:30", duracion: 60 });
+  const cancelada = await reservar(api, { socioId: "socio-024", pistaId: "pista-2", inicio: "2026-12-02T18:00", duracion: 90 });
+  await api.pedir("POST", `/api/reservas/${cancelada.cuerpo.reserva.id}/cancelar`);
+  const dia = await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-02&pista=pista-2");
+  assert.deepEqual(dia.cuerpo.pistas[0].huecos, [
+    { inicio: "2026-12-02T10:00", fin: "2026-12-02T12:30" },
+    { inicio: "2026-12-02T15:30", fin: "2026-12-02T21:30" },
+  ]);
+
+  // Sin tener en cuenta la hora actual.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-19T16:00" } });
+  const tarde = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-19&pista=pista-1");
+  assert.deepEqual(tarde.cuerpo.pistas[0].huecos, huecos["pista-1"]);
+
+  // Al cerrar una pista se queda sin huecos.
+  await api.pedir("PATCH", "/api/pistas/pista-2", { cuerpo: { estado: "cerrada" } });
+  const cerrada = await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-02&pista=pista-2");
+  assert.deepEqual(cerrada.cuerpo.pistas[0].huecos, []);
+}));
