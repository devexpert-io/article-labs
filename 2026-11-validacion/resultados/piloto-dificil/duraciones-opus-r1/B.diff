+// Reservas de 60, 90 o 120 minutos (docs/specs/duraciones.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Socios con la cuota al día y sin reservas futuras en la semilla. */
+const LIBRES = ["socio-006", "socio-016", "socio-020", "socio-023", "socio-024", "socio-026", "socio-027",
+  "socio-028", "socio-034", "socio-035", "socio-036", "socio-038", "socio-041"];
+const HORAS = ["09:00", "10:30", "12:00", "13:30", "15:00", "16:30", "18:00", "19:30", "21:00"];
+
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function reservar(api: Api, cuerpo: Record<string, unknown>) {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", ...cuerpo } });
+}
+
+test("duracion es opcional, vale 60, 90 o 120 y por defecto son 90", () => conApi(async (api) => {
+  const porDefecto = await reservar(api, { socioId: "socio-006", inicio: "2026-11-25T09:00" });
+  assert.equal(porDefecto.status, 201);
+  assert.equal(porDefecto.cuerpo.reserva.duracion, 90);
+  assert.equal(porDefecto.cuerpo.reserva.fin, "2026-11-25T10:30");
+  const corta = await reservar(api, { socioId: "socio-006", inicio: "2026-11-25T11:00", duracion: 60 });
+  assert.equal(corta.status, 201);
+  assert.equal(corta.cuerpo.reserva.duracion, 60);
+  assert.equal(corta.cuerpo.reserva.fin, "2026-11-25T12:00");
+  const larga = await reservar(api, { socioId: "socio-006", inicio: "2026-11-25T12:30", duracion: 120 });
+  assert.equal(larga.status, 201);
+  assert.equal(larga.cuerpo.reserva.duracion, 120);
+  assert.equal(larga.cuerpo.reserva.fin, "2026-11-25T14:30");
+  for (const duracion of [0, 30, 45, 61, 89.5, 150, -90, "90", null, true, [90]]) {
+    const r = await reservar(api, { socioId: "socio-016", inicio: "2026-11-26T09:00", duracion });
+    assert.equal(r.status, 400, `duracion ${JSON.stringify(duracion)}`);
+    assert.equal(r.cuerpo.error.codigo, "DURACION_INVALIDA");
+  }
+  const guardada = await api.pedir("GET", `/api/reservas/${larga.cuerpo.reserva.id}`);
+  assert.equal(guardada.cuerpo.reserva.duracion, 120);
+}));
+
+test("una reserva empieza en punto o y media, desde las 09:00, y termina como muy tarde a las 22:30", () => conApi(async (api) => {
+  const validas: [string, number, string][] = [
+    ["2026-11-25T09:00", 60, "2026-11-25T10:00"],
+    ["2026-11-25T13:30", 120, "2026-11-25T15:30"],
+    ["2026-11-25T21:30", 60, "2026-11-25T22:30"],
+    ["2026-11-26T20:30", 120, "2026-11-26T22:30"],
+    ["2026-11-26T09:30", 90, "2026-11-26T11:00"],
+  ];
+  for (const [i, [inicio, duracion, fin]] of validas.entries()) {
+    const r = await reservar(api, { socioId: LIBRES[i], inicio, duracion });
+    assert.equal(r.status, 201, `${inicio} + ${duracion}`);
+    assert.equal(r.cuerpo.reserva.fin, fin);
+  }
+  const invalidas: [string, number | undefined][] = [
+    ["2026-11-27T09:15", 60], ["2026-11-27T10:45", 90], ["2026-11-27T08:30", 60], ["2026-11-27T08:00", 120],
+    ["2026-11-27T21:30", 90], ["2026-11-27T22:00", 60], ["2026-11-27T21:00", 120], ["2026-11-27T21:30", undefined],
+    ["2026-11-27T22:30", 60], ["2026-11-27T25:00", 60], ["2026-02-30T10:00", 60], ["2026-11-27 10:00", 60], ["mañana", 60],
+  ];
+  for (const [inicio, duracion] of invalidas) {
+    const r = await reservar(api, { socioId: "socio-041", inicio, duracion });
