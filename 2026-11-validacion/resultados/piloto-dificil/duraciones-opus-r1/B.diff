+test("todas las reservas devuelven duracion, también las que ya existían", () => conApi(async (api) => {
+  let pagina = 1;
+  let paginas = 1;
+  let vistas = 0;
+  do {
+    const r = await api.pedir("GET", `/api/reservas?limite=100&pagina=${pagina}`);
+    paginas = r.cuerpo.paginas;
+    for (const reserva of r.cuerpo.reservas) {
+      assert.equal(reserva.duracion, 90, reserva.id);
+      vistas++;
+    }
+    pagina++;
+  } while (pagina <= paginas);
+  assert.ok(vistas > 500);
+  assert.equal((await api.pedir("GET", "/api/reservas/R-0001")).cuerpo.reserva.duracion, 90);
+  const cancelada = await api.pedir("POST", "/api/reservas/R-0525/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(cancelada.cuerpo.reserva.duracion, 90);
+}));
