   }
 });
+
+test("facturas mensuales: permisos, cálculo, numeración y consultas", async () => {
+  const sinIdentidad = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+  assert.equal(sinIdentidad.status, 401);
+  assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const noGestor = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+  const invalido = await api.pedir("POST", "/api/facturas", { socio: "socio-040", cuerpo: { mes: "2026-13" } });
+  assert.equal(invalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const abierto = await api.pedir("POST", "/api/facturas", { socio: "socio-040", cuerpo: { mes: "2026-11" } });
+  assert.equal(abierto.status, 409);
+  assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+
+  const primera = await api.pedir("POST", "/api/facturas", { socio: "socio-040", cuerpo: { mes: "2026-10" } });
+  assert.equal(primera.status, 201);
+  const facturas = primera.cuerpo.facturas;
+  assert.ok(facturas.length > 0);
+  assert.deepEqual(facturas.map((f: any) => f.socioId), [...facturas.map((f: any) => f.socioId)].sort());
+  assert.equal(facturas[0].numero, "F2026-0001");
+  for (const f of facturas) {
+    assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+    assert.equal(f.base, Math.floor(f.total * 100 / 121 + 0.5));
+    assert.equal(f.iva, f.total - f.base);
+    assert.ok(f.lineas.every((l: any) => l.concepto === "Reserva" || l.concepto === "Penalización"));
+  }
+  const repetida = await api.pedir("POST", "/api/facturas", { socio: "socio-040", cuerpo: { mes: "2026-10" } });
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo.facturas, facturas);
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-040" })).cuerpo.facturas, facturas);
+  const consultada = await api.pedir("GET", `/api/facturas/${facturas[0].numero}`, { socio: "socio-040" });
+  assert.deepEqual(consultada.cuerpo.factura, facturas[0]);
+  const ausente = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: "socio-040" });
+  assert.equal(ausente.status, 404);
+  assert.equal(ausente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("facturas continúan la numeración por año y reinician el año siguiente", async () => {
+  const otra = await arrancarApi({ AHORA: "2027-02-01T10:00" });
+  try {
+    const enero = await otra.pedir("POST", "/api/facturas", { socio: "socio-040", cuerpo: { mes: "2027-01" } });
+    assert.equal(enero.status, 201);
+    assert.deepEqual(enero.cuerpo.facturas, []);
+    const octubre = await otra.pedir("POST", "/api/facturas", { socio: "socio-040", cuerpo: { mes: "2026-10" } });
+    assert.equal(octubre.cuerpo.facturas[0].numero, "F2026-0001");
+    const noviembre = await otra.pedir("POST", "/api/facturas", { socio: "socio-040", cuerpo: { mes: "2026-11" } });
+    assert.equal(noviembre.cuerpo.facturas[0].numero, `F2026-${String(octubre.cuerpo.facturas.length + 1).padStart(4, "0")}`);
+  } finally {
+    otra.cerrar();
+  }
+});
