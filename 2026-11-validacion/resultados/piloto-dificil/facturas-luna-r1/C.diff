     estado.reservas.some((r) => r.pistaId === pistaId && r.inicio === inicio && r.estado === "confirmada");
 
   return {
+    generarFacturas(mes: unknown) {
+      if (typeof mes !== "string" || !MES.test(mes)) invalido("mes debe tener el formato AAAA-MM");
+      if (mes >= estado.ahora.slice(0, 7)) throw new ErrorDelClub("MES_ABIERTO", "Solo se pueden facturar meses que ya han terminado");
+      const existentes = estado.facturas.filter((f) => f.mes === mes);
+      if (estado.mesesFacturados.includes(mes)) return { facturas: existentes };
+      const porSocio = new Map<string, typeof estado.reservas>();
+      for (const r of estado.reservas) {
+        if (!r.inicio.startsWith(`${mes}-`)) continue;
+        const importe = r.estado === "cancelada" ? r.penalizacion : r.estado === "confirmada" || r.estado === "no_presentada" ? r.importe : undefined;
+        if (importe === undefined || importe <= 0) continue;
+        const filas = porSocio.get(r.socioId) ?? [];
+        filas.push(r);
+        porSocio.set(r.socioId, filas);
+      }
+      const socios = [...porSocio.keys()].sort((a, b) => a.localeCompare(b));
+      const anio = mes.slice(0, 4);
+      let correlativo = estado.facturas.filter((f) => f.numero.startsWith(`F${anio}-`)).length;
+      const nuevas: Factura[] = socios.map((socioId) => {
+        correlativo++;
+        const lineas = porSocio.get(socioId)!.sort((a, b) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id)).map((r) => ({
+          reservaId: r.id,
+          concepto: r.estado === "cancelada" ? "Penalización" as const : "Reserva" as const,
+          importe: r.estado === "cancelada" ? r.penalizacion! : r.importe,
+        }));
+        const total = lineas.reduce((suma, l) => suma + l.importe, 0);
+        const base = Math.floor(total * 100 / 121 + 0.5);
+        return { numero: `F${anio}-${String(correlativo).padStart(4, "0")}`, mes, socioId, lineas, total, base, iva: total - base };
+      });
+      estado.facturas.push(...nuevas);
+      estado.mesesFacturados.push(mes);
+      return { facturas: nuevas };
+    },
+
+    listarFacturas(mes: unknown) {
+      if (typeof mes !== "string" || !MES.test(mes)) invalido("mes debe tener el formato AAAA-MM");
+      return { facturas: estado.facturas.filter((f) => f.mes === mes) };
+    },
+
+    obtenerFactura(numero: string) {
+      const factura = estado.facturas.find((f) => f.numero === numero);
+      if (!factura) throw new ErrorDelClub("FACTURA_NO_ENCONTRADA", `No existe la factura ${numero}`, 404);
+      return { factura };
+    },
+
     listarPistas() {
       return { pistas: estado.pistas };
     },
