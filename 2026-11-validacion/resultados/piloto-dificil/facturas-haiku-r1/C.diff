diff --git a/test/facturas.test.ts b/test/facturas.test.ts
new file mode 100644
index 0000000..a6aebd1
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,182 @@
+// Las facturas mensuales, probadas a través de la API (docs/specs/facturas.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-001";
+
+/** Calcula las facturas esperadas a partir del estado del club, sin usar la lógica del servidor. */
+function esperadas(estado: any, mes: string, primerNumero: number) {
+  const anio = mes.slice(0, 4);
+  let numero = primerNumero;
+  const facturas = [];
+  for (const socio of [...estado.socios].sort((a: any, b: any) => (a.id < b.id ? -1 : a.id > b.id ? 1 : 0))) {
+    const reservas = estado.reservas
+      .filter((r: any) => r.socioId === socio.id && r.inicio.startsWith(mes))
+      .filter((r: any) => r.estado !== "cancelada" || r.penalizacion !== undefined)
+      .sort((a: any, b: any) => (a.inicio < b.inicio ? -1 : a.inicio > b.inicio ? 1 : a.id < b.id ? -1 : 1));
+    if (reservas.length === 0) continue;
+    const lineas = reservas.map((r: any) =>
+      r.estado === "cancelada"
+        ? { reservaId: r.id, concepto: "Penalización", importe: r.penalizacion }
+        : { reservaId: r.id, concepto: "Reserva", importe: r.importe });
+    const total = lineas.reduce((suma: number, l: any) => suma + l.importe, 0);
+    const base = Math.round(total / 1.21);
+    facturas.push({ numero: `F${anio}-${String(numero).padStart(4, "0")}`, mes, socioId: socio.id, lineas, total, base, iva: total - base });
+    numero += 1;
+  }
+  return facturas;
+}
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+test("solo un gestor genera y consulta facturas", async () => {
+  const sinSocio = [
+    await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } }),
+    await api.pedir("GET", "/api/facturas?mes=2026-10"),
+    await api.pedir("GET", "/api/facturas/F2026-0001"),
+  ];
+  for (const r of sinSocio) {
+    assert.equal(r.status, 401);
+    assert.equal(r.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  }
+  const socio = [
+    await api.pedir("POST", "/api/facturas", { socio: SOCIO, cuerpo: { mes: "2026-10" } }),
+    await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: SOCIO }),
+    await api.pedir("GET", "/api/facturas/F2026-0001", { socio: SOCIO }),
+  ];
+  for (const r of socio) {
+    assert.equal(r.status, 403);
+    assert.equal(r.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  const consulta = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(consulta.status, 200);
+  assert.deepEqual(consulta.cuerpo, { facturas: [] });
+});
+
+test("el mes tiene formato AAAA-MM y tiene que haber terminado", async () => {
+  for (const mes of ["octubre", "2026-13", "2026-00", "2026-1", undefined]) {
+    const r = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes } });
+    assert.equal(r.status, 400, `mes ${mes}`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-1", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await api.pedir("GET", "/api/facturas", { socio: GESTOR })).status, 400);
+  // Hoy es 18 de noviembre: noviembre y diciembre están abiertos.
+  for (const mes of ["2026-11", "2026-12"]) {
+    const r = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes } });
+    assert.equal(r.status, 409, mes);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+});
+
+test("octubre: una factura por socio, con sus líneas, el IVA y la numeración", async () => {
+  const r = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10" } });
+  assert.equal(r.status, 201);
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const esperado = esperadas(estado, "2026-10", 1);
+  assert.ok(esperado.length > 30, "octubre tiene facturas para muchos socios");
+  assert.deepEqual(r.cuerpo.facturas, esperado);
+
+  // Los socios salen ordenados y sin repetir; ninguna línea es de una cancelación sin penalización.
+  const ids = r.cuerpo.facturas.map((f: any) => f.socioId);
+  assert.deepEqual(ids, [...ids].sort());
+  assert.equal(new Set(ids).size, ids.length);
+  const canceladasSinPenalizacion = estado.reservas.filter((x: any) => x.estado === "cancelada" && x.penalizacion === undefined);
+  const reservasFacturadas = r.cuerpo.facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId));
+  for (const c of canceladasSinPenalizacion) assert.ok(!reservasFacturadas.includes(c.id), `${c.id} no se factura`);
+  for (const f of r.cuerpo.facturas) {
+    assert.equal(f.total, f.lineas.reduce((suma: number, l: any) => suma + l.importe, 0));
+    assert.equal(f.iva, f.total - f.base);
+  }
+});
+
+test("el IVA se calcula sobre el total de la factura y se redondea al céntimo", async () => {
+  // Con IVA incluido: base = total / 1,21, redondeado al céntimo.
+  // Socio-001 en octubre: 1800 + 2800 + 2200 = 6800. 6800 / 1,21 = 5619,83 -> 5620; IVA = 6800 - 5620 = 1180.
+  const octubre = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas;
+  const socio1 = octubre.find((f: any) => f.socioId === SOCIO);
+  assert.deepEqual({ total: socio1.total, base: socio1.base, iva: socio1.iva }, { total: 6800, base: 5620, iva: 1180 });
+  // Y en cada factura, la base es el total dividido por 1,21 redondeado.
+  for (const f of octubre) assert.equal(f.base, Math.round(f.total / 1.21), f.numero);
+});
+
+test("generar dos veces devuelve las mismas facturas y no crea ninguna nueva", async () => {
+  const primera = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo;
+  const segunda = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10" } });
+  assert.equal(segunda.status, 200);
+  assert.deepEqual(segunda.cuerpo, primera);
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo, primera);
+  const todas = (await api.pedir("GET", "/_estado")).cuerpo.facturas;
+  assert.equal(todas.length, primera.facturas.length);
+});
+
+test("consultar: un mes sin generar da una lista vacía; una factura por número", async () => {
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-11", { socio: GESTOR })).cuerpo, { facturas: [] });
+  const octubre = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas;
+  const una = await api.pedir("GET", `/api/facturas/${octubre[0].numero}`, { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo, { factura: octubre[0] });
+  const inexistente = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("la numeración sigue entre meses y años, y las penalizaciones se facturan", async () => {
+  // El club está el 19 de noviembre a las 08:00: cancelar con forzar la reserva de Marta López de las 09:00 la deja con penalización.
+  const club = await arrancarApi({ AHORA: "2026-11-19T08:00" });
+  try {
