+test("cancelar la serie: sin penalización si faltan 24 horas o más; si no, pendientes o forzada", () =>
+  conApi(async (api) => {
+    const creada = await crearSerie(api, { socioId: SOCIO, pistaId: "pista-1", inicio: "2026-11-25T10:30", semanas: 4 });
+    const id = creada.cuerpo.serie.id;
+    const [r1, r2, r3, r4] = creada.cuerpo.serie.reservas as string[];
+    // Ahora es miércoles 2 de diciembre a las 09:00: la primera ya ha empezado y la segunda faltan 1,5 horas.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-02T09:00" } });
+
+    const sinForzar = await api.pedir("POST", `/api/series/${id}/cancelar`, { cuerpo: {}, socio: GESTOR });
+    assert.equal(sinForzar.status, 200);
+    assert.deepEqual(sinForzar.cuerpo.canceladas.map((r: { id: string }) => r.id), [r3, r4]);
+    assert.deepEqual(sinForzar.cuerpo.pendientes.map((r: { id: string }) => r.id), [r2]);
+    assert.equal(sinForzar.cuerpo.canceladas[0].penalizacion, undefined);
+    assert.equal(sinForzar.cuerpo.serie.id, id);
+
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo.reservas;
+    const estadoDe = (rid: string) => estado.find((r: { id: string }) => r.id === rid).estado;
+    assert.equal(estadoDe(r1!), "confirmada", "la que ya ha empezado no se toca");
+    assert.equal(estadoDe(r2!), "confirmada", "la pendiente sigue confirmada");
+    assert.equal(estadoDe(r3!), "cancelada");
+
+    const forzada = await api.pedir("POST", `/api/series/${id}/cancelar`, { cuerpo: { forzar: true }, socio: GESTOR });
+    assert.deepEqual(forzada.cuerpo.canceladas.map((r: { id: string }) => r.id), [r2]);
+    assert.deepEqual(forzada.cuerpo.pendientes, []);
+    assert.equal(forzada.cuerpo.canceladas[0].penalizacion, 1800, "100 % del importe");
+
+    const otra = await api.pedir("POST", `/api/series/${id}/cancelar`, { cuerpo: { forzar: true }, socio: GESTOR });
+    assert.deepEqual(otra.cuerpo.canceladas, [], "las ya canceladas no se vuelven a tocar");
+    assert.equal((await api.pedir("POST", `/api/series/${id}/cancelar`, { cuerpo: { forzar: "sí" }, socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
