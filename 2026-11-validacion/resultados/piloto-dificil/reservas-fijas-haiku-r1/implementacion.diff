+// Reservas fijas semanales (docs/specs/reservas-fijas.md), probadas a través de la API.
+// Cada test arranca su propia API para no depender de los demás.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-003";
+
+async function conApi(fn: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function crearSerie(api: Api, cuerpo: Record<string, unknown>) {
+  return api.pedir("POST", "/api/series", { cuerpo, socio: GESTOR });
+}
+
+async function numeroReservas(api: Api): Promise<number> {
+  return (await api.pedir("GET", "/_estado")).cuerpo.reservas.length;
+}
+
+test("solo un gestor crea, consulta y cancela series", () =>
+  conApi(async (api) => {
+    const datos = { socioId: SOCIO, pistaId: "pista-1", inicio: "2026-11-25T10:30", semanas: 2 };
+    const sinCabecera = await api.pedir("POST", "/api/series", { cuerpo: datos });
+    assert.equal(sinCabecera.status, 401);
+    assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const desconocido = await api.pedir("POST", "/api/series", { cuerpo: datos, socio: "socio-999" });
+    assert.equal(desconocido.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const socio = await api.pedir("POST", "/api/series", { cuerpo: datos, socio: SOCIO });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const creada = await crearSerie(api, datos);
+    assert.equal(creada.status, 201);
+    const id = creada.cuerpo.serie.id;
+    assert.equal((await api.pedir("GET", `/api/series/${id}`, { socio: SOCIO })).status, 403);
+    assert.equal((await api.pedir("POST", `/api/series/${id}/cancelar`, { cuerpo: {}, socio: SOCIO })).status, 403);
+    assert.equal((await api.pedir("GET", `/api/series/${id}`, { socio: GESTOR })).status, 200);
+    assert.equal((await api.pedir("GET", `/api/series/${id}`)).status, 401);
+  }));
+
+test("los datos de la serie se validan", () =>
+  conApi(async (api) => {
+    const base = { socioId: SOCIO, pistaId: "pista-1", inicio: "2026-11-25T10:30", semanas: 3 };
+    for (const semanas of [1, 13, "3", 2.5, undefined]) {
+      const r = await crearSerie(api, { ...base, semanas });
+      assert.equal(r.status, 400, `semanas=${semanas}`);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    assert.equal((await crearSerie(api, { ...base, semanas: 2 })).status, 201);
+    assert.equal((await crearSerie(api, { ...base, semanas: 12 })).status, 201);
+
+    const socio = await crearSerie(api, { ...base, socioId: "socio-999" });
+    assert.equal(socio.cuerpo.error.codigo, "SOCIO_NO_ENCONTRADO");
+    const pista = await crearSerie(api, { ...base, pistaId: "pista-9" });
+    assert.equal(pista.cuerpo.error.codigo, "PISTA_NO_ENCONTRADA");
+    const franja = await crearSerie(api, { ...base, inicio: "2026-11-25T11:00" });
+    assert.equal(franja.status, 400);
+    assert.equal(franja.cuerpo.error.codigo, "FRANJA_INVALIDA");
+    const pasada = await crearSerie(api, { ...base, inicio: "2026-11-18T09:00" });
+    assert.equal(pasada.status, 409);
+    assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+  }));
+
+test("una reserva por semana, a la misma hora local, también cuando cambia la hora de verano", () =>
+  conApi(async (api) => {
+    // Martes 23 de marzo de 2027, 19:30. El cambio de hora es el domingo 28.
+    const creada = await crearSerie(api, { socioId: SOCIO, pistaId: "pista-1", inicio: "2027-03-23T19:30", semanas: 3 });
+    assert.equal(creada.status, 201);
+    const esperadas = ["2027-03-23T19:30", "2027-03-30T19:30", "2027-04-06T19:30"];
+    assert.deepEqual(creada.cuerpo.serie.reservas.length, 3);
+    const serie = (await api.pedir("GET", `/api/series/${creada.cuerpo.serie.id}`, { socio: GESTOR })).cuerpo.serie;
+    assert.deepEqual(serie.reservas.map((r: { inicio: string }) => r.inicio), esperadas);
+    assert.ok(serie.reservas.every((r: { pistaId: string }) => r.pistaId === "pista-1"));
+
