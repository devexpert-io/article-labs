+test("las reservas de una serie no cuentan para el límite de 3 futuras", () =>
+  conApi(async (api) => {
+    // Nora Benítez (socio-041) no tiene ninguna reserva en la semilla, así que el límite empieza libre.
+    const NORA = "socio-041";
+    const reservar = (inicio: string) =>
+      api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NORA, pistaId: "pista-2", inicio } });
+    // Primero tres reservas normales: el límite está completo.
+    for (const inicio of ["2026-12-20T09:00", "2026-12-21T09:00", "2026-12-22T09:00"]) {
+      assert.equal((await reservar(inicio)).status, 201);
+    }
+    assert.equal((await reservar("2026-12-23T09:00")).cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+    // Una serie se crea igualmente.
+    const serie = await crearSerie(api, { socioId: NORA, pistaId: "pista-1", inicio: "2026-11-25T10:30", semanas: 3 });
+    assert.equal(serie.status, 201);
+    assert.equal(serie.cuerpo.serie.reservas.length, 3);
+    assert.equal((await reservar("2026-12-23T09:00")).cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+
+    // Y al revés: con la serie hecha antes, el socio puede tener tres reservas normales.
+    const otro = await arrancarApi();
+    try {
+      assert.equal((await crearSerie(otro, { socioId: NORA, pistaId: "pista-1", inicio: "2026-11-25T10:30", semanas: 4 })).status, 201);
+      for (const inicio of ["2026-12-20T09:00", "2026-12-21T09:00", "2026-12-22T09:00"]) {
+        const r = await otro.pedir("POST", "/api/reservas", { cuerpo: { socioId: NORA, pistaId: "pista-2", inicio } });
+        assert.equal(r.status, 201, inicio);
+      }
+    } finally {
+      otro.cerrar();
+    }
+  }));
