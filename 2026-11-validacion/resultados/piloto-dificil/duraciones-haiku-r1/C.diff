+test("huecos: los intervalos libres entre las 09:00 y las 22:30, sin reservas confirmadas", async () => {
+  // Jueves 26, pista 1: 10:00 a 11:00 y 16:00 a 18:00.
+  const manana = await reservar({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T10:00", duracion: 60 });
+  assert.equal(manana.status, 201);
