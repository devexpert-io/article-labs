+
+  const dispo = await disponibilidad("2026-11-26", "pista-1");
+  assert.deepEqual(dispo.cuerpo.pistas[0].huecos, [
+    { inicio: "2026-11-26T09:00", fin: "2026-11-26T10:00" },
+    { inicio: "2026-11-26T11:00", fin: "2026-11-26T16:00" },
+    { inicio: "2026-11-26T18:00", fin: "2026-11-26T22:30" },
+  ]);
