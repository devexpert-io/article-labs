+// Reservas de 60, 90 o 120 minutos: duración, inicios, solapes, precio por minutos y huecos.
+// Los días 25 de noviembre en adelante no tienen datos de la semilla, así que las pruebas de esta
+// tabla crean sus propias reservas. Cada bloque usa socios distintos para no pelear por el límite de tres.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const reservar = (cuerpo: Record<string, unknown>) => api.pedir("POST", "/api/reservas", { cuerpo });
+const disponibilidad = (fecha: string, pista?: string) =>
+  api.pedir("GET", `/api/disponibilidad?fecha=${fecha}${pista ? `&pista=${pista}` : ""}`);
+const franja = (dispo: any, pista: string, hora: string) =>
+  dispo.cuerpo.pistas.find((p: any) => p.pistaId === pista).franjas.find((f: any) => f.inicio.endsWith(hora));
+
+test("las reservas de la semilla duran 90 minutos", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.ok(estado.reservas.length > 0);
+  assert.ok(estado.reservas.every((r: { duracion: number }) => r.duracion === 90), "todas las reservas existentes tienen duracion 90");
+});
+
+test("sin duracion, la reserva dura 90 minutos y cuesta como siempre", async () => {
+  const r = await reservar({ socioId: "socio-030", pistaId: "pista-1", inicio: "2026-11-25T10:30" });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.duracion, 90);
+  assert.equal(r.cuerpo.reserva.fin, "2026-11-25T12:00");
+  assert.equal(r.cuerpo.reserva.importe, 1800);
+});
+
+test("duraciones de 60 y 120 minutos, y cualquier otro valor se rechaza", async () => {
+  const una = await reservar({ socioId: "socio-031", pistaId: "pista-1", inicio: "2026-11-25T12:00", duracion: 60 });
+  assert.equal(una.status, 201);
+  assert.equal(una.cuerpo.reserva.duracion, 60);
+  assert.equal(una.cuerpo.reserva.fin, "2026-11-25T13:00");
+  assert.equal(una.cuerpo.reserva.importe, 1200);
+
+  const dos = await reservar({ socioId: "socio-032", pistaId: "pista-1", inicio: "2026-11-25T14:00", duracion: 120 });
