+test("una penalización se factura con su concepto y las canceladas gratis no se facturan", async () => {
+  await conApi(async (api) => {
+    // A las 2026-11-18T10:00, el 19 a las 09:00 está a menos de 24 horas: penalización del 100 %.
+    const penalizada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-19T09:00" },
+    });
+    assert.equal(penalizada.status, 201);
+    const cancelada = await api.pedir("POST", `/api/reservas/${penalizada.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, penalizada.cuerpo.reserva.importe);
+
+    const confirmada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-20T10:30" },
+    });
+    const gratuita = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-24T15:00" },
+    });
+    const canceladaGratis = await api.pedir("POST", `/api/reservas/${gratuita.cuerpo.reserva.id}/cancelar`);
+    assert.equal(canceladaGratis.cuerpo.reserva.penalizacion, undefined);
+
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T10:00" } });
+    const generada = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-11" } });
+    assert.equal(generada.status, 201);
+
+    const factura = generada.cuerpo.facturas.find((f: any) => f.socioId === "socio-041");
+    assert.ok(factura, "Nora tiene una penalización que facturar");
+    assert.deepEqual(factura.lineas, [
+      { reservaId: penalizada.cuerpo.reserva.id, concepto: "Penalización", importe: cancelada.cuerpo.reserva.penalizacion },
+      { reservaId: confirmada.cuerpo.reserva.id, concepto: "Reserva", importe: confirmada.cuerpo.reserva.importe },
+    ]);
+    assert.ok(!factura.lineas.some((l: Linea) => l.reservaId === gratuita.cuerpo.reserva.id));
+    assert.equal(factura.total, cancelada.cuerpo.reserva.penalizacion + confirmada.cuerpo.reserva.importe);
+  });
+});
