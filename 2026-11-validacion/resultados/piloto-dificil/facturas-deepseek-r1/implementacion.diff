+test("numeración correlativa por año, por orden de generación y sin huecos", async () => {
+  await conApi(async (api) => {
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T10:00" } });
+
+    // Noviembre se genera antes que octubre: la numeración sigue el orden de generación.
+    const noviembre = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-11" } });
+    assert.equal(noviembre.status, 201);
+    noviembre.cuerpo.facturas.forEach((f: any, i: number) => {
+      assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+    });
+    const ultimoNoviembre = numeroDe(noviembre.cuerpo.facturas.at(-1).numero);
+
+    // Un mes sin nada que facturar no consume números.
+    const vacio = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2025-12" } });
+    assert.equal(vacio.status, 201);
+    assert.deepEqual(vacio.cuerpo, { facturas: [] });
+    const vacioRepetido = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2025-12" } });
+    assert.equal(vacioRepetido.status, 200);
+    assert.deepEqual(vacioRepetido.cuerpo, { facturas: [] });
+
+    const octubre = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10" } });
+    assert.equal(octubre.status, 201);
+    assert.equal(numeroDe(octubre.cuerpo.facturas[0].numero), ultimoNoviembre + 1);
+    octubre.cuerpo.facturas.forEach((f: any, i: number) => {
+      assert.equal(f.numero, `F2026-${String(ultimoNoviembre + i + 1).padStart(4, "0")}`);
+    });
+
+    // Cada año empieza en 0001.
+    const futura = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-15T10:30" },
+    });
+    assert.equal(futura.status, 201);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-01T10:00" } });
+
+    const enero = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2027-01" } });
+    assert.equal(enero.status, 201);
+    assert.equal(enero.cuerpo.facturas[0].numero, "F2027-0001");
+    assert.deepEqual(enero.cuerpo.facturas[0].lineas, [
+      { reservaId: futura.cuerpo.reserva.id, concepto: "Reserva", importe: futura.cuerpo.reserva.importe },
+    ]);
+
+    // Y volver a generar noviembre no cambia nada.
+    const noviembreOtraVez = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-11" } });
+    assert.equal(noviembreOtraVez.status, 200);
+    assert.deepEqual(noviembreOtraVez.cuerpo.facturas, noviembre.cuerpo.facturas);
+  });
+});
