+++ b/test/facturas.test.ts
@@ -0,0 +1,275 @@
+// Facturas mensuales: permisos, mes cerrado, líneas, IVA y numeración.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-001";
+
+interface Linea {
+  reservaId: string;
+  concepto: string;
+  importe: number;
+}
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}): Promise<void> {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+/** Las líneas que debería tener cada socio en la factura del mes, según la semilla. */
+function lineasEsperadas(estado: any, mes: string): Map<string, Linea[]> {
+  const porSocio = new Map<string, Linea[]>();
+  const reservas = [...estado.reservas]
+    .filter((r: any) => r.inicio.slice(0, 7) === mes)
+    .sort((a: any, b: any) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+  for (const r of reservas) {
+    let linea: Linea | undefined;
+    if (r.estado === "confirmada" || r.estado === "no_presentada") {
+      linea = { reservaId: r.id, concepto: "Reserva", importe: r.importe };
+    } else if (r.estado === "cancelada" && r.penalizacion !== undefined) {
+      linea = { reservaId: r.id, concepto: "Penalización", importe: r.penalizacion };
+    }
+    if (!linea) continue;
+    if (!porSocio.has(r.socioId)) porSocio.set(r.socioId, []);
+    porSocio.get(r.socioId)!.push(linea);
+  }
+  return new Map([...porSocio.entries()].sort((a, b) => a[0].localeCompare(b[0])));
+}
+
+function numeroDe(numero: string): number {
+  return Number(numero.slice(numero.indexOf("-") + 1));
+}
+
+function baseDe(total: number): number {
+  return Math.round((total * 100) / 121);
+}
+
+test("solo un gestor genera y consulta facturas", async () => {
+  await conApi(async (api) => {
+    const listadoSin = await api.pedir("GET", "/api/facturas?mes=2026-10");
+    assert.equal(listadoSin.status, 401);
+    assert.equal(listadoSin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const generarSin = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+    assert.equal(generarSin.status, 401);
+    assert.equal(generarSin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const listadoSocio = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: SOCIO });
+    assert.equal(listadoSocio.status, 403);
+    assert.equal(listadoSocio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const generarSocio = await api.pedir("POST", "/api/facturas", { socio: SOCIO, cuerpo: { mes: "2026-10" } });
+    assert.equal(generarSocio.status, 403);
+    assert.equal(generarSocio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const unaSin = await api.pedir("GET", "/api/facturas/F2026-0001");
+    assert.equal(unaSin.status, 401);
+    assert.equal(unaSin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const unaSocio = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: SOCIO });
+    assert.equal(unaSocio.status, 403);
+    assert.equal(unaSocio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const generada = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10" } });
+    assert.equal(generada.status, 201);
+    const listadoGestor = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.equal(listadoGestor.status, 200);
+  });
+});
+
+test("solo se facturan meses cerrados y con el formato AAAA-MM", async () => {
+  await conApi(async (api) => {
+    for (const mes of ["2026-13", "2026-00", "2026-1", "octubre", 202610, undefined]) {
+      const r = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes } });
+      assert.equal(r.status, 400, `mes ${String(mes)} debe ser inválido`);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    const listadoInvalido = await api.pedir("GET", "/api/facturas?mes=2026-13", { socio: GESTOR });
+    assert.equal(listadoInvalido.status, 400);
+    assert.equal(listadoInvalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+      const r = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes } });
+      assert.equal(r.status, 409, `el mes ${mes} todavía no ha terminado`);
+      assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+    }
+
+    const cerradoSinDatos = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2025-12" } });
+    assert.equal(cerradoSinDatos.status, 201);
+    assert.deepEqual(cerradoSinDatos.cuerpo, { facturas: [] });
+
+    const sinGenerar = await api.pedir("GET", "/api/facturas?mes=2024-01", { socio: GESTOR });
+    assert.deepEqual(sinGenerar.cuerpo, { facturas: [] });
+  });
+});
+
+test("octubre de 2026: una factura por socio, líneas, total e IVA", async () => {
+  await conApi(async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const esperado = lineasEsperadas(estado, "2026-10");
+
+    const generada = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10" } });
+    assert.equal(generada.status, 201);
+    const facturas = generada.cuerpo.facturas;
+    assert.equal(facturas.length, 40);
+    assert.deepEqual(facturas.map((f: any) => f.socioId), [...esperado.keys()]);
+    assert.ok(!facturas.some((f: any) => f.socioId === "socio-041"), "Nora no tiene nada que facturar");
+
+    for (const factura of facturas) {
+      assert.equal(factura.mes, "2026-10");
+      assert.deepEqual(factura.lineas, esperado.get(factura.socioId));
+      const total = factura.lineas.reduce((suma: number, linea: Linea) => suma + linea.importe, 0);
+      assert.equal(factura.total, total);
+      assert.equal(factura.base, baseDe(total));
+      assert.equal(factura.iva, total - factura.base);
+      assert.equal(factura.base + factura.iva, factura.total);
+    }
+
+    // El total de la factura se calcula sobre la factura entera, no línea a línea.
+    const primera = facturas[0];
+    assert.equal(primera.socioId, "socio-001");
+    assert.equal(primera.total, 6800);
+    assert.equal(primera.base, 5620);
+    assert.equal(primera.iva, 1180);
+
+    // Las no presentadas se facturan como Reserva y las canceladas sin penalización no aparecen.
+    const noPresentada = estado.reservas.find(
+      (r: any) => r.inicio.slice(0, 7) === "2026-10" && r.estado === "no_presentada",
+    );
+    const canceladaSinPenalizacion = estado.reservas.find(
+      (r: any) => r.inicio.slice(0, 7) === "2026-10" && r.estado === "cancelada" && r.penalizacion === undefined,
+    );
+    const lineas = facturas.flatMap((f: any) => f.lineas);
+    const deNoPresentada = lineas.find((l: Linea) => l.reservaId === noPresentada.id);
+    assert.deepEqual(deNoPresentada, { reservaId: noPresentada.id, concepto: "Reserva", importe: noPresentada.importe });
+    assert.ok(!lineas.some((l: Linea) => l.reservaId === canceladaSinPenalizacion.id));
+
+    // Las líneas van ordenadas por el inicio de la reserva.
+    const inicioPorReserva = new Map(estado.reservas.map((r: any) => [r.id, r.inicio]));
+    for (const factura of facturas) {
+      const inicios = factura.lineas.map((l: Linea) => inicioPorReserva.get(l.reservaId));
+      assert.deepEqual(inicios, [...inicios].sort());
+    }
+  });
+});
