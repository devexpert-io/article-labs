@@ -0,0 +1,268 @@
+// Reservas fijas semanales (docs/specs/reservas-fijas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const crearSerie = (cuerpo: unknown, socio: string | null = GESTOR) => api.pedir("POST", "/api/series", { cuerpo, socio: socio ?? undefined });
+const numeroDeReservas = async (a: Api = api) => (await a.pedir("GET", "/_estado")).cuerpo.reservas.length;
+
+test("1. solo un gestor crea, consulta y cancela series", async () => {
+  const cuerpo = { socioId: "socio-003", pistaId: "pista-1", inicio: "2027-01-05T09:00", semanas: 2 };
+  const sinIdentificar = await crearSerie(cuerpo, null);
+  assert.equal(sinIdentificar.status, 401);
+  assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await crearSerie(cuerpo, "socio-003");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const creada = await crearSerie(cuerpo);
+  assert.equal(creada.status, 201);
+  const id = creada.cuerpo.serie.id;
+  for (const [metodo, ruta] of [["GET", `/api/series/${id}`], ["POST", `/api/series/${id}/cancelar`]] as const) {
+    const anonimo = await api.pedir(metodo, ruta);
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const noGestor = await api.pedir(metodo, ruta, { socio: "socio-003" });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  // La serie no se ha tocado.
+  const consultada = await api.pedir("GET", `/api/series/${id}`, { socio: GESTOR });
+  assert.ok(consultada.cuerpo.serie.reservas.every((r: any) => r.estado === "confirmada"));
+});
+
+test("2. valida semanas, socio, pista y franja", async () => {
+  const base = { socioId: "socio-003", pistaId: "pista-1", inicio: "2027-01-06T09:00", semanas: 4 };
+  const antes = await numeroDeReservas();
+  for (const semanas of [1, 13, 2.5, "4", undefined, 0]) {
+    const r = await crearSerie({ ...base, semanas });
+    assert.equal(r.status, 400, `semanas=${semanas}`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const semanas of [2, 12]) {
+    const r = await crearSerie({ ...base, inicio: semanas === 2 ? "2027-01-07T09:00" : "2027-01-08T09:00", semanas });
+    assert.equal(r.status, 201, `semanas=${semanas}`);
+  }
+  const casos: Array<[Record<string, unknown>, number, string]> = [
+    [{ socioId: "socio-999" }, 404, "SOCIO_NO_ENCONTRADO"],
+    [{ pistaId: "pista-9" }, 404, "PISTA_NO_ENCONTRADA"],
+    [{ inicio: "2027-01-06T09:15" }, 400, "FRANJA_INVALIDA"],
+    [{ inicio: "2027-02-30T09:00" }, 400, "FRANJA_INVALIDA"],
+    [{ inicio: "6/1/2027 09:00" }, 400, "FRANJA_INVALIDA"],
+    [{ inicio: "2026-11-18T09:00" }, 409, "FRANJA_PASADA"],
+    [{ inicio: "2026-11-17T21:00" }, 409, "FRANJA_PASADA"],
+  ];
+  for (const [cambio, http, codigo] of casos) {
+    const r = await crearSerie({ ...base, ...cambio });
+    assert.equal(r.status, http, JSON.stringify(cambio));
+    assert.equal(r.cuerpo.error.codigo, codigo, JSON.stringify(cambio));
+  }
+  assert.equal(await numeroDeReservas(), antes + 2 + 12);
+});
+
+test("3. una reserva confirmada cada 7 días, a la misma hora local aunque cambie la hora", async () => {
+  // El 28 de marzo de 2027 se adelanta la hora.
+  const primavera = await crearSerie({ socioId: "socio-003", pistaId: "pista-2", inicio: "2027-03-23T19:30", semanas: 3 });
