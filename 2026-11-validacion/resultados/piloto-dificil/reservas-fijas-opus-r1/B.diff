+test("10 y 11. cancelar la serie y reservas sueltas de la serie", async () => {
+  const otra = await arrancarApi();
+  try {
+    const pedir = (metodo: string, ruta: string, cuerpo?: unknown) => otra.pedir(metodo, ruta, { cuerpo, socio: GESTOR });
+    const creada = await pedir("POST", "/api/series", { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T19:30", semanas: 5 });
+    const [primera, segunda, tercera, cuarta, quinta] = creada.cuerpo.serie.reservas;
+
+    // 11. Una reserva de la serie se cancela sola con las reglas de siempre y la serie sigue con las demás.
+    const suelta = await otra.pedir("POST", `/api/reservas/${quinta}/cancelar`, { cuerpo: { motivo: "vacaciones" } });
+    assert.equal(suelta.status, 200);
+    assert.equal(suelta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(suelta.cuerpo.reserva.penalizacion, undefined);
+    let serie = (await pedir("GET", `/api/series/${creada.cuerpo.serie.id}`)).cuerpo.serie;
+    assert.deepEqual(serie.reservas.map((r: any) => r.estado), ["confirmada", "confirmada", "confirmada", "confirmada", "cancelada"]);
+
+    // Martes 8 de diciembre a las 18:30: la primera ya ha pasado y a la segunda le falta una hora.
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-08T18:30" } });
+    const fueraDePlazo = await otra.pedir("POST", `/api/reservas/${segunda}/cancelar`);
+    assert.equal(fueraDePlazo.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+
+    const sinForzar = await pedir("POST", `/api/series/${creada.cuerpo.serie.id}/cancelar`);
+    assert.equal(sinForzar.status, 200);
+    assert.equal(sinForzar.cuerpo.serie.id, creada.cuerpo.serie.id);
+    assert.deepEqual(sinForzar.cuerpo.canceladas.map((r: any) => r.id), [tercera, cuarta]);
+    assert.ok(sinForzar.cuerpo.canceladas.every((r: any) => r.estado === "cancelada" && r.penalizacion === undefined));
+    assert.deepEqual(sinForzar.cuerpo.pendientes.map((r: any) => r.id), [segunda]);
+    assert.equal(sinForzar.cuerpo.pendientes[0].estado, "confirmada");
+
+    const malForzar = await pedir("POST", `/api/series/${creada.cuerpo.serie.id}/cancelar`, { forzar: "sí" });
+    assert.equal(malForzar.status, 400);
+    assert.equal(malForzar.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const forzada = await pedir("POST", `/api/series/${creada.cuerpo.serie.id}/cancelar`, { forzar: true });
+    assert.deepEqual(forzada.cuerpo.canceladas.map((r: any) => r.id), [segunda]);
+    assert.equal(forzada.cuerpo.canceladas[0].penalizacion, 2800);
+    assert.deepEqual(forzada.cuerpo.pendientes, []);
+
+    serie = (await pedir("GET", `/api/series/${creada.cuerpo.serie.id}`)).cuerpo.serie;
+    // La que ya había empezado sigue confirmada; la cancelada suelta mantiene su motivo y no lleva penalización.
+    assert.deepEqual(serie.reservas.map((r: any) => r.estado), ["confirmada", "cancelada", "cancelada", "cancelada", "cancelada"]);
+    assert.equal(serie.reservas[0].id, primera);
+    assert.equal(serie.reservas[4].motivoCancelacion, "vacaciones");
+    assert.equal(serie.reservas[4].penalizacion, undefined);
+    assert.equal(serie.reservas[2].penalizacion, undefined);
+
+    const otraVez = await pedir("POST", `/api/series/${creada.cuerpo.serie.id}/cancelar`, { forzar: true });
+    assert.deepEqual([otraVez.cuerpo.canceladas, otraVez.cuerpo.pendientes], [[], []]);
+  } finally {
+    otra.cerrar();
+  }
+});
