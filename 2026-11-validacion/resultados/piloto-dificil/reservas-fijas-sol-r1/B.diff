+const horarioMadrid = new Intl.DateTimeFormat("en-GB", {
+  timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit",
+  hour: "2-digit", minute: "2-digit", hourCycle: "h23",
+});
+
+function instanteMadrid(local: string): number {
+  const referencia = Date.parse(`${local}:00Z`);
+  let instante = referencia;
+  // Corregir el desfase y volver a consultarlo en el instante resultante:
+  // puede haber cambiado el horario entre la referencia UTC y la hora de Madrid.
+  for (let paso = 0; paso < 2; paso++) {
+    const partes = Object.fromEntries(horarioMadrid.formatToParts(instante).map(p => [p.type, p.value]));
+    const representado = Date.UTC(Number(partes.year), Number(partes.month) - 1, Number(partes.day),
+      Number(partes.hour), Number(partes.minute));
+    instante = referencia - (representado - instante);
+  }
+  return instante;
+}
+
+function horasEntreMadrid(desde: string, hasta: string): number {
+  return (instanteMadrid(hasta) - instanteMadrid(desde)) / 3_600_000;
+}
