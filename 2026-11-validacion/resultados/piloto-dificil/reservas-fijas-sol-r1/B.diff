+  assert.deepEqual(await inventario(), antes);
+  assert.equal((await consultar(s.id)).status, 200);
+  assert.equal((await cancelar(s.id)).status, 200);
+});
+
+test("valida los datos y las reglas globales sin crear reservas ni series", async () => {
+  const antes = await inventario();
+  for (const semanas of [undefined, null, "8", 1, 13, 2.5, true]) {
+    error(await crear({ semanas }), 400, "DATOS_INVALIDOS");
+  }
+  for (const campo of ["socioId", "pistaId", "inicio"]) {
+    error(await crear({ [campo]: undefined }), 400, "DATOS_INVALIDOS");
+  }
+  error(await crear({ socioId: "inexistente" }), 404, "SOCIO_NO_ENCONTRADO");
+  error(await crear({ pistaId: "inexistente" }), 404, "PISTA_NO_ENCONTRADA");
+  for (const inicio of ["incorrecto", "2026-12-01T19:00", "2027-02-30T19:30"]) {
+    error(await crear({ inicio }), 400, "FRANJA_INVALIDA");
+  }
