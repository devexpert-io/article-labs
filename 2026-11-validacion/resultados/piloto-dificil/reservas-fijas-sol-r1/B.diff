+for (const forzar of [false, true]) {
+  for (const { inicio, ahora, gratis } of [
+    { inicio: "2027-03-28T19:30", ahora: "2027-03-27T19:30", gratis: false },
+    { inicio: "2027-10-31T19:30", ahora: "2027-10-30T20:00", gratis: true },
+  ]) {
+    test(`cancelación colectiva al cambiar la hora: ${inicio}, forzar=${forzar}`, async () => {
+      const creada = await crear({ inicio, semanas: 8 });
+      assert.equal(creada.status, 201, creada.texto);
+      const s = creada.cuerpo.serie;
+      const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+      assert.equal(reloj.status, 200);
+      const respuesta = await cancelar(s.id, { forzar });
+      assert.equal(respuesta.status, 200, respuesta.texto);
+      const { canceladas, pendientes } = respuesta.cuerpo;
+      const primeraCancelada = gratis || forzar;
+      assert.deepEqual(canceladas.map((r: Reserva) => r.id), primeraCancelada ? s.reservas : s.reservas.slice(1));
+      assert.deepEqual(pendientes.map((r: Reserva) => r.id), primeraCancelada ? [] : [s.reservas[0]]);
+      const reservas: Reserva[] = (await consultar(s.id)).cuerpo.serie.reservas;
+      assert.equal(reservas[0]!.estado, primeraCancelada ? "cancelada" : "confirmada");
+      assert.equal(reservas[0]!.penalizacion, !gratis && forzar ? reservas[0]!.importe : undefined);
+      assert.ok(reservas.slice(1).every(r => r.estado === "cancelada" && r.penalizacion === undefined));
+      assert.deepEqual(canceladas, reservas.filter(r => r.estado === "cancelada"));
+      assert.deepEqual(pendientes, reservas.filter(r => r.estado === "confirmada"));
+    });
+  }
+}
