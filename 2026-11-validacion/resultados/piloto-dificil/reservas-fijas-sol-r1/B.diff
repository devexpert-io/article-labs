+const datos = { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-12-01T19:30", semanas: 2 };
+const gestor = "socio-040";
+const crear = (cambios = {}) => api.pedir("POST", "/api/series", { socio: gestor, cuerpo: { ...datos, ...cambios } });
+const consultar = (id: string) => api.pedir("GET", `/api/series/${id}`, { socio: gestor });
+const cancelar = (id: string, cuerpo: unknown = {}) => api.pedir("POST", `/api/series/${id}/cancelar`, { socio: gestor, cuerpo });
+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status, r.texto);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+async function inventario() {
+  const e = (await api.pedir("GET", "/_estado")).cuerpo;
+  return { series: e.series, reservas: e.reservas, contador: e.contador };
+}
+
+test("solo el gestor puede crear, consultar y cancelar series", async () => {
+  const s = (await crear()).cuerpo.serie;
+  const antes = await inventario();
+  for (const [metodo, ruta] of [["POST", "/api/series"], ["GET", `/api/series/${s.id}`], ["POST", `/api/series/${s.id}/cancelar`]]) {
+    for (const socio of [undefined, "socio-041", "socio-999"]) {
+      const r = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? datos : undefined });
+      error(r, socio === "socio-041" ? 403 : 401, socio === "socio-041" ? "SIN_PERMISO" : "NO_IDENTIFICADO");
+    }
