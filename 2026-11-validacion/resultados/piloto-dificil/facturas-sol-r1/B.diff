+      let contador = estado.contadoresFacturas[anio] ?? 0;
+      const facturas: Factura[] = [...porSocio.keys()].sort().map((socioId) => {
+        const lineas = porSocio.get(socioId)!;
+        const total = lineas.reduce((suma, linea) => suma + linea.importe, 0);
+        // Dividir por 1,21 con enteros evita errores de coma flotante en el IVA.
+        const base = Math.floor((total * 100 + 60) / 121);
+        contador += 1;
+        return { numero: `F${anio}-${String(contador).padStart(4, "0")}`, mes, socioId, lineas,
+          total, base, iva: total - base };
+      });
+      estado.contadoresFacturas[anio] = contador;
+      estado.facturasPorMes[mes] = facturas;
+      return { facturas, creadas: true };
+    },
+
+    listarFacturas(mes: unknown) {
+      validarMes(mes);
+      return { facturas: estado.facturasPorMes[mes] ?? [] };
+    },
+
+    obtenerFactura(numero: string) {
+      const factura = Object.values(estado.facturasPorMes).flat().find((f) => f.numero === numero);
+      if (!factura) throw new ErrorDelClub("FACTURA_NO_ENCONTRADA", `No existe la factura ${numero}`, 404);
+      return { factura };
+    },
+
     listarPistas() {
       return { pistas: estado.pistas };
     },
