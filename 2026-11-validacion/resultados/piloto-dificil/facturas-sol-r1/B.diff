+      }
+      const existentes = estado.facturasPorMes[mes];
+      if (existentes) return { facturas: existentes, creadas: false };
+
+      const porSocio = new Map<string, LineaFactura[]>();
+      const reservas = estado.reservas.filter((r) => r.inicio.slice(0, 7) === mes)
+        .sort((a, b) => a.inicio.localeCompare(b.inicio));
+      for (const r of reservas) {
