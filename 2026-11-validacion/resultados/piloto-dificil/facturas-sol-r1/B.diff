index 0000000..fb53c8e
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,148 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado, Factura } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+async function iniciar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+const generar = (api: Api, mes: unknown) => api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+const reloj = (api: Api, ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+async function reservar(api: Api, socioId: string, inicio: string, pistaId = "pista-1") {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, inicio, pistaId } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.reserva.id as string;
+}
+
+test("facturas: solo el gestor puede generar, listar y consultar", async (t) => {
+  const api = await iniciar(t);
+  for (const [metodo, ruta] of [["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F2026-0001"]]) {
+    for (const socio of [undefined, "socio-001", "socio-999"]) {
+      const r = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      assert.equal(r.status, socio === "socio-001" ? 403 : 401);
+      assert.equal(r.cuerpo.error.codigo, socio === "socio-001" ? "SIN_PERMISO" : "NO_IDENTIFICADO");
+    }
+  }
+  assert.equal((await generar(api, "2026-10")).status, 201);
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).status, 200);
+  assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001", { socio: gestor })).status, 200);
+});
+
+test("facturas: valida el mes y usa el reloj del club para su cierre", async (t) => {
+  const api = await iniciar(t);
+  for (const mes of [undefined, null, 202610, "", "2026-1", "26-10", "2026-00", "2026-13", "2026-10-01", "2026-10\n"]) {
+    const post = await generar(api, mes);
+    assert.equal(post.status, 400, String(mes));
+    assert.equal(post.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const get = await api.pedir("GET", `/api/facturas${mes === undefined ? "" : `?mes=${encodeURIComponent(String(mes))}`}`, { socio: gestor });
+    assert.equal(get.status, 400);
+    assert.equal(get.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj(api, "2026-11-30T23:59");
+  assert.equal((await generar(api, "2026-11")).status, 409);
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+});
+
+test("facturas: octubre incluye todo el historial facturable, ordenado y con IVA sobre el total", async (t) => {
+  const api = await iniciar(t);
+  const antes: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const facturables = antes.reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(facturables.some((r) => r.estado === "no_presentada"));
+  assert.ok(antes.reservas.some((r) => r.inicio.startsWith("2026-10") && r.estado === "cancelada"));
+  const r = await generar(api, "2026-10");
+  assert.equal(r.status, 201);
+  const facturas: Factura[] = r.cuerpo.facturas;
+  const socios = [...new Set(facturables.map((r) => r.socioId))].sort();
+  assert.deepEqual(facturas.map((f) => f.socioId), socios);
+  assert.ok(!socios.includes("socio-041"));
+  for (const [i, factura] of facturas.entries()) {
+    const reservas = facturables.filter((r) => r.socioId === factura.socioId).sort((a, b) => a.inicio.localeCompare(b.inicio));
+    const total = reservas.reduce((s, r) => s + r.importe, 0);
+    assert.deepEqual(factura, {
+      numero: `F2026-${String(i + 1).padStart(4, "0")}`, mes: "2026-10", socioId: socios[i],
+      lineas: reservas.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })),
+      total, base: Math.round(total / 1.21), iva: total - Math.round(total / 1.21),
+    });
+  }
+  const despues: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.deepEqual(despues.reservas, antes.reservas);
+});
+
+test("facturas: penalizaciones, cancelaciones gratuitas y redondeo conjunto", async (t) => {
+  const api = await iniciar(t);
+  // Crear en orden inverso comprueba que las líneas se ordenan por inicio.
+  const segunda = await reservar(api, "socio-041", "2026-12-02T09:00");
+  const primera = await reservar(api, "socio-041", "2026-12-01T09:00");
+  const penalizada = await reservar(api, "socio-002", "2026-12-01T09:00", "pista-3");
+  const gratuita = await reservar(api, "socio-004", "2026-12-03T09:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratuita}/cancelar`)).status, 200);
+  await reloj(api, "2026-11-30T10:00");
+  const cancelada = await api.pedir("POST", `/api/reservas/${penalizada}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1200);
+  await reloj(api, "2027-01-01T00:00");
+  const r = await generar(api, "2026-12");
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.cuerpo.facturas, [
+    { numero: "F2026-0001", mes: "2026-12", socioId: "socio-002", lineas: [
+      { reservaId: penalizada, concepto: "Penalización", importe: 1200 },
+    ], total: 1200, base: 992, iva: 208 },
+    { numero: "F2026-0002", mes: "2026-12", socioId: "socio-041", lineas: [
+      { reservaId: primera, concepto: "Reserva", importe: 1800 },
+      { reservaId: segunda, concepto: "Reserva", importe: 1800 },
+    ], total: 3600, base: 2975, iva: 625 },
+  ]);
+  const pasada = await api.pedir("POST", `/api/reservas/${primera}/cancelar`);
+  assert.equal(pasada.status, 409);
+  assert.equal(pasada.cuerpo.error.codigo, "RESERVA_PASADA");
+  assert.equal((await api.pedir("GET", `/api/reservas/${primera}`)).cuerpo.reserva.estado, "confirmada");
+});
+
+test("facturas: consultas, repetición y numeración continua por año y orden de generación", async (t) => {
+  const api = await iniciar(t);
+  const consultar = (mes: string) => api.pedir("GET", `/api/facturas?mes=${mes}`, { socio: gestor });
+  assert.deepEqual((await consultar("2026-10")).cuerpo, { facturas: [] });
+  assert.deepEqual((await consultar("2026-12")).cuerpo, { facturas: [] });
+  const inexistente = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: gestor });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  // Un mes vacío también queda generado y no consume números.
+  const vacio = await generar(api, "2026-09");
+  assert.equal(vacio.status, 201);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  assert.equal((await generar(api, "2026-09")).status, 200);
+  await reservar(api, "socio-041", "2026-12-01T09:00");
+  await reloj(api, "2027-01-01T00:00");
+  const diciembre = await generar(api, "2026-12");
+  assert.equal(diciembre.cuerpo.facturas[0].numero, "F2026-0001");
+  const simultaneas = await Promise.all([generar(api, "2026-10"), generar(api, "2026-10")]);
+  assert.deepEqual(simultaneas.map((r) => r.status).sort(), [200, 201]);
+  assert.deepEqual(simultaneas[0]!.cuerpo, simultaneas[1]!.cuerpo);
+  const octubre: Factura[] = simultaneas[0]!.cuerpo.facturas;
+  assert.equal(octubre[0]!.numero, "F2026-0002");
+  assert.deepEqual((await consultar("2026-10")).cuerpo, { facturas: octubre });
+  for (const factura of octubre) {
+    const individual = await api.pedir("GET", `/api/facturas/${factura.numero}`, { socio: gestor });
+    assert.equal(individual.status, 200);
+    assert.deepEqual(individual.cuerpo, { factura });
+  }
+  const noviembre = await generar(api, "2026-11");
+  assert.equal(noviembre.cuerpo.facturas[0].numero, `F2026-${String(octubre.length + 2).padStart(4, "0")}`);
+  await reservar(api, "socio-041", "2027-01-04T09:00");
+  await reloj(api, "2027-02-01T00:00");
+  const enero = await generar(api, "2027-01");
+  assert.equal(enero.status, 201);
+  assert.equal(enero.cuerpo.facturas[0].numero, "F2027-0001");
+  assert.deepEqual((await generar(api, "2026-12")).cuerpo, diciembre.cuerpo);
+  const todas: Factura[] = [...diciembre.cuerpo.facturas, ...octubre, ...noviembre.cuerpo.facturas];
+  assert.deepEqual(todas.map((f) => f.numero), todas.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+});
