+test("cancelar la serie: gratis a 24 horas o más, pendientes las de menos y forzar con penalización", () =>
+  conApi({}, async (api) => {
+    const creada = await api.pedir("POST", "/api/series", {
+      cuerpo: { socioId: "socio-003", pistaId: "pista-2", inicio: "2026-11-19T19:30", semanas: 4 },
+      socio: GESTOR,
+    });
+    assert.equal(creada.status, 201);
+    const id = creada.cuerpo.serie.id;
+
+    // A las 08:00 del día de la primera reserva, faltan 11,5 horas para ella y más de 24 para las demás.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-19T08:00" } });
+    const cancelada = await api.pedir("POST", `/api/series/${id}/cancelar`, { socio: GESTOR });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.canceladas.length, 3);
+    assert.equal(cancelada.cuerpo.pendientes.length, 1);
+    assert.equal(cancelada.cuerpo.pendientes[0].inicio, "2026-11-19T19:30");
+    assert.equal(cancelada.cuerpo.pendientes[0].estado, "confirmada");
+    for (const r of cancelada.cuerpo.canceladas) {
+      assert.equal(r.estado, "cancelada");
+      assert.equal(r.penalizacion, undefined, "la cancelación gratuita no penaliza");
+    }
+
+    const forzada = await api.pedir("POST", `/api/series/${id}/cancelar`, { cuerpo: { forzar: true }, socio: GESTOR });
+    assert.equal(forzada.cuerpo.canceladas.length, 1);
+    assert.equal(forzada.cuerpo.pendientes.length, 0);
+    assert.equal(forzada.cuerpo.canceladas[0].penalizacion, forzada.cuerpo.canceladas[0].importe);
+
+    // Las que ya han empezado no se tocan.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T20:00" } });
+    const tarde = await api.pedir("POST", `/api/series/${id}/cancelar`, { socio: GESTOR });
+    assert.equal(tarde.cuerpo.canceladas.length, 0);
+    assert.equal(tarde.cuerpo.pendientes.length, 0);
+  }));
