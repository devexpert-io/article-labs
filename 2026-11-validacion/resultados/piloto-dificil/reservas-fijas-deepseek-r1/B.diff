+/** Suma días a una fecha AAAA-MM-DD sin salir de la fecha local del club. */
+function sumarDias(fecha: string, dias: number): string {
+  const dia = new Date(`${fecha}T12:00:00Z`);
+  dia.setUTCDate(dia.getUTCDate() + dias);
+  const anio = dia.getUTCFullYear();
+  if (!Number.isInteger(anio) || anio < 0 || anio > 9999) {
+    throw new ErrorDelClub("FRANJA_INVALIDA", "inicio debe ser una fecha y una hora válidas", 400);
+  }
+  const mes = String(dia.getUTCMonth() + 1).padStart(2, "0");
+  const numeroDia = String(dia.getUTCDate()).padStart(2, "0");
+  return `${String(anio).padStart(4, "0")}-${mes}-${numeroDia}`;
