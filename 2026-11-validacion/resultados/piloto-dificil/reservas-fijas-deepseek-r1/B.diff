@@ -0,0 +1,378 @@
+// Las reservas fijas semanales, probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+/** Arranca una API limpia para cada prueba y la cierra al terminar. */
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("solo un gestor puede crear, consultar y cancelar series", () =>
+  conApi({}, async (api) => {
+    const datos = { socioId: "socio-003", pistaId: "pista-2", inicio: "2026-11-25T12:00", semanas: 2 };
+
+    const anonima = await api.pedir("POST", "/api/series", { cuerpo: datos });
+    assert.equal(anonima.status, 401);
+    assert.equal(anonima.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinPermiso = await api.pedir("POST", "/api/series", { cuerpo: datos, socio: "socio-003" });
+    assert.equal(sinPermiso.status, 403);
+    assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const rutas = [
+      ["GET", "/api/series/S-0001"],
+      ["POST", "/api/series/S-0001/cancelar"],
+    ] as const;
+    for (const [metodo, ruta] of rutas) {
+      const sinCabeza = await api.pedir(metodo, ruta);
+      assert.equal(sinCabeza.status, 401, `${metodo} ${ruta}`);
+      assert.equal(sinCabeza.cuerpo.error.codigo, "NO_IDENTIFICADO");
+      const socio = await api.pedir(metodo, ruta, { socio: "socio-003" });
+      assert.equal(socio.status, 403, `${metodo} ${ruta}`);
+      assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+    }
+
+    const delGestor = await api.pedir("POST", "/api/series", { cuerpo: datos, socio: GESTOR });
+    assert.equal(delGestor.status, 201);
+  }));
+
+test("las rutas de series comprueban el gestor antes de leer el cuerpo", () =>
+  conApi({}, async (api) => {
+    const rutas = [
