+// Reservas de 60, 90 o 120 minutos: duraciones, inicios, solapes, precios, disponibilidad y huecos.
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+beforeEach(async () => {
+  api = await arrancarApi();
+});
+afterEach(() => api.cerrar());
+
+function reservar(cuerpo: Record<string, unknown>) {
+  return api.pedir("POST", "/api/reservas", { cuerpo });
+}
+
+async function disponibilidad(fecha: string, pista?: string) {
+  const ruta = `/api/disponibilidad?fecha=${fecha}${pista ? `&pista=${pista}` : ""}`;
+  const respuesta = await api.pedir("GET", ruta);
+  assert.equal(respuesta.status, 200);
+  return respuesta.cuerpo;
+}
+
+function finDe(inicio: string, minutos: number): string {
+  const [h, m] = inicio.slice(11).split(":").map(Number);
+  const total = h! * 60 + m! + minutos;
+  return `${inicio.slice(0, 10)}T${String(Math.floor(total / 60)).padStart(2, "0")}:${String(total % 60).padStart(2, "0")}`;
+}
+
+test("duracion es opcional y solo vale 60, 90 o 120", async () => {
+  const casos: [Record<string, unknown>, number][] = [
+    [{ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00", duracion: 60 }, 60],
+    [{ socioId: "socio-006", pistaId: "pista-1", inicio: "2026-11-25T10:00", duracion: 90 }, 90],
+    [{ socioId: "socio-016", pistaId: "pista-1", inicio: "2026-11-25T12:00", duracion: 120 }, 120],
+    [{ socioId: "socio-020", pistaId: "pista-1", inicio: "2026-11-25T15:00" }, 90],
+  ];
+  for (const [cuerpo, esperada] of casos) {
+    const creada = await reservar(cuerpo);
+    assert.equal(creada.status, 201, JSON.stringify(creada.cuerpo));
+    assert.equal(creada.cuerpo.reserva.duracion, esperada);
+  }
+  for (const duracion of [45, 0, 30, 150, "60", null]) {
+    const invalida = await reservar({ socioId: "socio-006", pistaId: "pista-2", inicio: "2026-11-25T09:00", duracion });
+    assert.equal(invalida.status, 400);
+    assert.equal(invalida.cuerpo.error.codigo, "DURACION_INVALIDA");
+  }
+});
+
+test("los inicios son en punto o y media y caben en el horario del club", async () => {
+  const validos: Record<string, unknown>[] = [
+    { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00", duracion: 60 },
+    { socioId: "socio-006", pistaId: "pista-2", inicio: "2026-11-25T09:30", duracion: 60 },
+    { socioId: "socio-016", pistaId: "pista-1", inicio: "2026-11-25T21:30", duracion: 60 },
+    { socioId: "socio-020", pistaId: "pista-2", inicio: "2026-11-25T20:30", duracion: 120 },
+  ];
+  for (const cuerpo of validos) {
+    assert.equal((await reservar(cuerpo)).status, 201, JSON.stringify(cuerpo));
+  }
+  const invalidos: Record<string, unknown>[] = [
+    { inicio: "2026-11-25T09:15", duracion: 60 },
+    { inicio: "2026-11-25T08:30", duracion: 60 },
+    { inicio: "2026-11-25T22:00", duracion: 60 },
+    { inicio: "2026-11-25T21:30", duracion: 120 },
+  ];
+  for (const datos of invalidos) {
+    const invalida = await reservar({ socioId: "socio-006", pistaId: "pista-1", ...datos });
+    assert.equal(invalida.status, 400);
+    assert.equal(invalida.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  }
+});
+
+test("fin es inicio más la duración", async () => {
+  const corta = await reservar({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00", duracion: 60 });
+  assert.equal(corta.cuerpo.reserva.fin, "2026-11-25T10:00");
+  const larga = await reservar({ socioId: "socio-006", pistaId: "pista-1", inicio: "2026-11-25T20:30", duracion: 120 });
+  assert.equal(larga.cuerpo.reserva.fin, "2026-11-25T22:30");
+});
+
+test("no se solapa con ninguna reserva confirmada, ni con las de 90 minutos de siempre", async () => {
+  assert.equal((await reservar({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T09:00", duracion: 60 })).status, 201);
+  // Que una termine justo cuando empieza otra no es solaparse.
+  assert.equal((await reservar({ socioId: "socio-006", pistaId: "pista-1", inicio: "2026-11-25T10:00", duracion: 60 })).status, 201);
+  const solapada = await reservar({ socioId: "socio-016", pistaId: "pista-1", inicio: "2026-11-25T09:30", duracion: 120 });
+  assert.equal(solapada.status, 409);
+  assert.equal(solapada.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+
+  // El jueves 19 la pista 1 tiene una reserva de siempre de 12:00 a 13:30.
