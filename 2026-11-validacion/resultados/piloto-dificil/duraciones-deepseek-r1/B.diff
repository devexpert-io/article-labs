+test("el precio va por minutos, cruza las 18:00 y aplica punta en fin de semana", async () => {
+  // El ejemplo de la spec: martes 17:30 a 19:00 en la pista 1.
+  const ejemplo = await reservar({ socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-24T17:30", duracion: 90 });
