+  assert.equal(sabadoMuro.cuerpo.reserva.importe, 1333);
+
+  // Entre semana por la mañana, valle: 60 × 1200 / 90 = 800.
+  const valle = await reservar({ socioId: "socio-020", pistaId: "pista-3", inicio: "2026-11-25T09:00", duracion: 60 });
+  assert.equal(valle.cuerpo.reserva.importe, 800);
