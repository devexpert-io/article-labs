+/** Los huecos libres más largos del día entre la apertura y el cierre, sin solaparse con las reservas. */
+function huecosDelDia(reservas: Reserva[], fecha: string): Intervalo[] {
+  const apertura = `${fecha}T${APERTURA}`;
+  const cierre = `${fecha}T${CIERRE}`;
+  const ocupados = reservas
+    .filter((r) => r.estado === "confirmada")
+    .map((r) => ({ inicio: r.inicio < apertura ? apertura : r.inicio, fin: r.fin > cierre ? cierre : r.fin }))
+    .filter((r) => r.inicio < r.fin)
+    .sort((a, b) => a.inicio.localeCompare(b.inicio));
+  const huecos: Intervalo[] = [];
+  let cursor = apertura;
+  for (const ocupado of ocupados) {
+    if (ocupado.inicio > cursor) huecos.push({ inicio: cursor, fin: ocupado.inicio });
+    if (ocupado.fin > cursor) cursor = ocupado.fin;
+  }
+  if (cierre > cursor) huecos.push({ inicio: cursor, fin: cierre });
+  return huecos;
+}
