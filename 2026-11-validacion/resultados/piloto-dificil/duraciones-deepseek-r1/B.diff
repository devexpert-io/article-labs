+test("los huecos son los intervalos libres más largos del día, ordenados y sin tener en cuenta la hora actual", async () => {
+  // Pista sin reservas: un solo hueco de apertura a cierre.
+  const vacia = await disponibilidad("2026-11-25", "pista-1");
+  assert.deepEqual(vacia.pistas[0].huecos, [{ inicio: "2026-11-25T09:00", fin: "2026-11-25T22:30" }]);
