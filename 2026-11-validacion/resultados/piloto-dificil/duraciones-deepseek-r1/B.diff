+test("una reserva de 90 minutos a las horas de siempre cuesta exactamente lo mismo que antes", async () => {
+  const horas = ["09:00", "10:30", "12:00", "13:30", "15:00", "16:30", "18:00", "19:30", "21:00"];
+  const esperados = [1800, 1800, 1800, 1800, 1800, 1800, 2800, 2800, 2800];
+  const socios = ["socio-041", "socio-001", "socio-002", "socio-003", "socio-004", "socio-005", "socio-006", "socio-007", "socio-008"];
+  const creadas = [];
+  for (const [i, hora] of horas.entries()) {
+    const r = await reservar({ socioId: socios[i], pistaId: "pista-1", inicio: `2026-11-25T${hora}`, duracion: 90 });
+    assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+    assert.equal(r.cuerpo.reserva.importe, esperados[i], `precio de las ${hora}`);
+    creadas.push(r.cuerpo.reserva);
+  }
+  const dia = await disponibilidad("2026-11-25", "pista-1");
+  for (const [i, hora] of horas.entries()) {
+    const franja = dia.pistas[0].franjas.find((f: { inicio: string }) => f.inicio.endsWith(hora));
+    assert.equal(franja.estado, "reservada");
+    assert.equal(creadas[i].importe, franja.precio, `importe de las ${hora} igual al precio de la franja`);
+  }
+});
