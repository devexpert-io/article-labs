+test("torneo: permisos, inscripciones, bloqueo, cuadro y campeona", async () => {
+  const otra = await arrancarApi();
+  try {
+    const datos = { nombre: "Copa de otoño", pistas: ["pista-2"], franjas: ["2026-11-27T09:00", "2026-11-27T10:30"], plazas: 4, cuota: 1500 };
+    assert.equal((await otra.pedir("POST", "/api/torneos", { cuerpo: datos })).cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const creado = await otra.pedir("POST", "/api/torneos", { cuerpo: datos, socio: "socio-040" });
+    assert.equal(creado.status, 201);
+    const id = creado.cuerpo.torneo.id;
+    const disp = await otra.pedir("GET", "/api/disponibilidad?fecha=2026-11-27&pista=pista-2");
+    assert.equal(disp.cuerpo.pistas[0].franjas[0].estado, "torneo");
+    const a = await otra.pedir("POST", `/api/torneos/${id}/inscripciones`, { cuerpo: { socios: ["socio-001", "socio-002"] }, socio: "socio-001" });
+    const b = await otra.pedir("POST", `/api/torneos/${id}/inscripciones`, { cuerpo: { socios: ["socio-003", "socio-004"] }, socio: "socio-003" });
+    assert.equal(a.status, 201); assert.equal(b.status, 201);
+    const cerrado = await otra.pedir("POST", `/api/torneos/${id}/cerrar`, { socio: "socio-040" });
+    assert.equal(cerrado.cuerpo.torneo.estado, "en_juego");
+    const partido = cerrado.cuerpo.torneo.partidos[0];
+    assert.deepEqual(partido.parejas, [a.cuerpo.inscripcion.id, b.cuerpo.inscripcion.id]);
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-27T09:00" } });
+    const resultado = await otra.pedir("POST", `/api/torneos/${id}/partidos/${partido.id}/resultado`, { cuerpo: { ganadora: a.cuerpo.inscripcion.id, marcador: "6-4 6-3" }, socio: "socio-040" });
+    assert.equal(resultado.status, 200, JSON.stringify(resultado.cuerpo));
+    assert.equal((await otra.pedir("GET", `/api/torneos/${id}`)).cuerpo.torneo.campeona, a.cuerpo.inscripcion.id);
+  } finally { otra.cerrar(); }
+});
+
+test("torneos: rechaza fechas imposibles y estados de filtro desconocidos", async () => {
+  const otra = await arrancarApi();
+  try {
+    const datos = { nombre: "Fecha imposible", pistas: ["pista-2"], franjas: ["2027-02-31T09:00"], plazas: 4, cuota: 0 };
+    const fecha = await otra.pedir("POST", "/api/torneos", { cuerpo: datos, socio: "socio-040" });
+    assert.equal(fecha.status, 400);
+    assert.equal(fecha.cuerpo.error.codigo, "FRANJA_INVALIDA");
+    for (const estado of ["", "desconocido"]) {
+      const listado = await otra.pedir("GET", `/api/torneos?estado=${estado}`);
+      assert.equal(listado.status, 400);
+      assert.equal(listado.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    assert.equal((await otra.pedir("GET", "/api/torneos")).status, 200);
+  } finally { otra.cerrar(); }
+});
+
+test("torneos: cerrar libera las combinaciones sobrantes y conserva las asignadas", async () => {
+  const otra = await arrancarApi();
+  try {
+    const franjas = ["2026-11-27T09:00", "2026-11-27T10:30", "2026-11-27T12:00"];
+    const datos = { nombre: "Copa con franjas sobrantes", pistas: ["pista-2"], franjas, plazas: 4, cuota: 0 };
+    const creado = await otra.pedir("POST", "/api/torneos", { cuerpo: datos, socio: "socio-040" });
+    assert.equal(creado.status, 201);
+    const id = creado.cuerpo.torneo.id;
+    for (const socios of [["socio-001", "socio-002"], ["socio-003", "socio-004"]]) {
+      const alta = await otra.pedir("POST", `/api/torneos/${id}/inscripciones`, { cuerpo: { socios }, socio: socios[0] });
+      assert.equal(alta.status, 201);
+    }
+    const cerrado = await otra.pedir("POST", `/api/torneos/${id}/cerrar`, { socio: "socio-040" });
+    assert.equal(cerrado.status, 200);
+    assert.equal(cerrado.cuerpo.torneo.partidos[0].inicio, franjas[0]);
+
+    const reutilizada = await otra.pedir("POST", "/api/torneos", {
+      cuerpo: { ...datos, nombre: "Reutiliza la franja libre", franjas: [franjas[1]] }, socio: "socio-040",
+    });
+    assert.equal(reutilizada.status, 201, JSON.stringify(reutilizada.cuerpo));
+
+    const ocupada = await otra.pedir("POST", "/api/torneos", {
+      cuerpo: { ...datos, nombre: "Respeta la franja asignada", franjas: [franjas[0]] }, socio: "socio-040",
+    });
+    assert.equal(ocupada.status, 409);
+    assert.equal(ocupada.cuerpo.error.codigo, "FRANJAS_OCUPADAS");
+    assert.deepEqual(ocupada.cuerpo.error.conflictos, [{ pistaId: "pista-2", inicio: franjas[0], torneoId: id }]);
+  } finally { otra.cerrar(); }
+});
