+test("torneos: permisos, inscripción, cuadro, resultados y bloqueo de franjas", async () => {
+  const datos={nombre:"Copa de otoño",pistas:["pista-1"],franjas:["2026-11-25T09:00","2026-11-25T10:30","2026-11-25T12:00","2026-11-25T13:30","2026-11-25T15:00"],plazas:4,cuota:2500};
+  assert.equal((await api.pedir("POST","/api/torneos",{cuerpo:datos})).cuerpo.error.codigo,"NO_IDENTIFICADO");
+  const creado=await api.pedir("POST","/api/torneos",{cuerpo:datos,socio:"socio-040"});
+  assert.equal(creado.status,201); const id=creado.cuerpo.torneo.id;
+  const disp=await api.pedir("GET","/api/disponibilidad?fecha=2026-11-25&pista=pista-1");
+  assert.equal(disp.cuerpo.pistas[0].franjas.find((x:any)=>x.inicio==="2026-11-25T09:00").estado,"torneo");
+  assert.equal((await api.pedir("POST","/api/reservas",{cuerpo:{socioId:"socio-003",pistaId:"pista-1",inicio:"2026-11-25T09:00"}})).cuerpo.error.codigo,"FRANJA_NO_DISPONIBLE");
+  const pares=[["socio-001","socio-002"],["socio-003","socio-004"],["socio-005","socio-006"],["socio-007","socio-008"]];
+  const ins=[];
+  for(const socios of pares) { const r=await api.pedir("POST",`/api/torneos/${id}/inscripciones`,{cuerpo:{socios},socio:socios[0]}); assert.equal(r.status,201); ins.push(r.cuerpo.inscripcion.id); }
+  const cerrado=await api.pedir("POST",`/api/torneos/${id}/cerrar`,{socio:"socio-040"});
+  assert.equal(cerrado.cuerpo.torneo.partidos.length,3);
+  assert.equal(cerrado.cuerpo.torneo.partidos[0].parejas[0],ins[0]);
+  await api.pedir("POST","/_reloj",{cuerpo:{ahora:"2026-11-25T09:00"}});
+  const primera=cerrado.cuerpo.torneo.partidos[0];
+  const resultado=await api.pedir("POST",`/api/torneos/${id}/partidos/${primera.id}/resultado`,{cuerpo:{ganadora:primera.parejas[0]},socio:"socio-040"});
+  assert.equal(resultado.cuerpo.partido.estado,"jugado");
+  assert.equal((await api.pedir("GET",`/api/torneos/${id}`)).cuerpo.torneo.estado,"en_juego");
+});
