+test("torneos valida fechas reales, avanza descansos y libera franjas sin partido", async () => {
+  const otra = await arrancarApi();
+  try {
+    const base = { nombre:"Copa", pistas:["pista-1"], franjas:["2026-12-01T09:00","2026-12-01T10:30","2026-12-01T12:00","2026-12-01T13:30","2026-12-01T15:00","2026-12-01T16:30"], plazas:8, cuota:0 };
+    const fechaMala = await otra.pedir("POST","/api/torneos",{socio:"socio-040",cuerpo:{...base,franjas:["2026-02-30T09:00"]}});
+    assert.equal(fechaMala.cuerpo.error.codigo,"FRANJA_INVALIDA");
+    const creado = await otra.pedir("POST","/api/torneos",{socio:"socio-040",cuerpo:base});
+    const id=creado.cuerpo.torneo.id;
+    for(let i=1;i<=5;i++) { const alta=await otra.pedir("POST",`/api/torneos/${id}/inscripciones`,{socio:"socio-040",cuerpo:{socios:[`socio-${String(i*2-1).padStart(3,"0")}`,`socio-${String(i*2).padStart(3,"0")}`]}}); assert.equal(alta.status,201); }
+    const cerrado=await otra.pedir("POST",`/api/torneos/${id}/cerrar`,{socio:"socio-040"});
+    const partidos=cerrado.cuerpo.torneo.partidos;
+    assert.equal(partidos[2].estado,"descanso");
+    assert.equal(partidos[5].parejas[1],partidos[2].ganadora);
+    const finRonda1=Math.max(...partidos.filter((p:any)=>p.ronda===1&&p.estado!=="descanso").map((p:any)=>Date.parse(`${p.inicio}:00Z`)+90*60000));
+    assert.ok(partidos.filter((p:any)=>p.ronda===2).every((p:any)=>Date.parse(`${p.inicio}:00Z`) >= finRonda1));
+    assert.equal((await otra.pedir("GET","/api/disponibilidad?fecha=2026-12-01&pista=pista-1")).cuerpo.pistas[0].franjas.find((f:any)=>f.inicio==="2026-12-01T15:00").estado,"libre");
+  } finally { otra.cerrar(); }
+});
