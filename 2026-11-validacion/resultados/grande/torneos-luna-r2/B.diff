+test("calendario de varias pistas espera solo a los dos predecesores del partido", async () => {
+  const otra = await arrancarApi();
+  try {
+    const base = { nombre:"Cuadro", pistas:["pista-1","pista-2","pista-3"], franjas:["2026-12-02T09:00","2026-12-02T10:30","2026-12-02T12:00","2026-12-02T13:30"], plazas:8, cuota:0 };
+    const creado = await otra.pedir("POST","/api/torneos",{socio:"socio-040",cuerpo:base});
+    const id = creado.cuerpo.torneo.id;
+    for(let i=1;i<=8;i++) await otra.pedir("POST",`/api/torneos/${id}/inscripciones`,{socio:"socio-040",cuerpo:{socios:[`socio-${String(i*2-1).padStart(3,"0")}`,`socio-${String(i*2).padStart(3,"0")}`]}});
+    const partidos = (await otra.pedir("POST",`/api/torneos/${id}/cerrar`,{socio:"socio-040"})).cuerpo.torneo.partidos;
+    const r2a = partidos.find((p:any)=>p.ronda===2&&p.numero===1);
+    const r2b = partidos.find((p:any)=>p.ronda===2&&p.numero===2);
+    const precedentesA = [partidos.find((p:any)=>p.ronda===1&&p.numero===1),partidos.find((p:any)=>p.ronda===1&&p.numero===4)];
+    const precedentesB = [partidos.find((p:any)=>p.ronda===1&&p.numero===2),partidos.find((p:any)=>p.ronda===1&&p.numero===3)];
+    const fin = (ps:any[]) => Math.max(...ps.map(p=>Date.parse(`${p.inicio}:00Z`)+90*60000));
+    assert.ok(Date.parse(`${r2a.inicio}:00Z`) >= fin(precedentesA));
+    assert.ok(Date.parse(`${r2b.inicio}:00Z`) >= fin(precedentesB));
+    assert.ok(Date.parse(`${r2a.inicio}:00Z`) >= fin(precedentesA));
+  } finally { otra.cerrar(); }
+});
