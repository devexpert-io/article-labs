+      return { partido: nuevo };
+    },
+
+    /** Los partidos abiertos que no han empezado. Sin identificarse. */
+    listarPartidos(f: FiltrosPartidos) {
+      if (f.fecha !== undefined && !(FECHA.test(f.fecha) && fechaExiste(f.fecha))) {
+        invalido("fecha debe ser una fecha real, AAAA-MM-DD");
+      }
+      // La spec escribe los niveles con coma decimal (4,5); en la query se aceptan coma y punto.
+      // Antes de convertir: Number() aceptaría cosas como "0x4" o " 4", que no son niveles.
+      if (f.nivel !== undefined && !NIVEL_TEXTO.test(f.nivel)) {
+        invalido("nivel debe ser un número entre 1 y 7 en pasos de 0,5");
+      }
+      const nivel = f.nivel === undefined ? undefined : Number(f.nivel.replace(",", "."));
+      if (nivel !== undefined && !nivelValido(nivel)) invalido("nivel debe ser un número entre 1 y 7 en pasos de 0,5");
+      const partidos = estado.partidos
+        .filter((p) =>
+          p.estado === "abierto" &&
+          p.inicio > estado.ahora &&
+          (f.fecha === undefined || p.inicio.slice(0, 10) === f.fecha) &&
+          (nivel === undefined || p.nivelMin === null || p.nivelMax === null || (p.nivelMin <= nivel && nivel <= p.nivelMax)))
+        .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.pistaId.localeCompare(b.pistaId));
+      return { partidos };
+    },
+
+    obtenerPartido(id: string) {
+      return { partido: partido(id) };
+    },
+
+    unirseAPartido(quienId: string | undefined, id: string) {
+      const quien = quienLlama(quienId);
+      const p = partido(id);
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.estado === "completo") throw new ErrorDelClub("PARTIDO_COMPLETO", "El partido ya no tiene plazas libres");
+      if (p.jugadores.includes(quien.id)) throw new ErrorDelClub("YA_APUNTADO", `${quien.nombre} ya juega en este partido`);
+      if (!quien.cuotaActiva) throw new ErrorDelClub("CUOTA_INACTIVA", `${quien.nombre} no tiene la cuota al día`);
+      comprobarRangoDeNivel(quien, p.nivelMin, p.nivelMax);
+      if (reservasFuturas(quien.id) >= MAXIMO_RESERVAS_FUTURAS) {
+        throw new ErrorDelClub("LIMITE_DE_RESERVAS", `${quien.nombre} ya tiene ${MAXIMO_RESERVAS_FUTURAS} reservas futuras`);
+      }
+      p.jugadores.push(quien.id);
+      p.plazasLibres -= 1;
+      if (p.plazasLibres === 0) p.estado = "completo";
+      return { partido: p };
+    },
+
+    /** Quien sale tarde (a menos de 24 horas) paga su parte con `forzar`. */
+    salirDePartido(quienId: string | undefined, id: string, datos: { forzar?: unknown }) {
+      const quien = quienLlama(quienId);
+      const p = partido(id);
+      const forzar = comprobarForzar(datos.forzar);
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      if (!p.jugadores.includes(quien.id)) throw new ErrorDelClub("NO_APUNTADO", `${quien.nombre} no juega en este partido`);
+      if (p.organizador === quien.id) {
+        throw new ErrorDelClub("ORGANIZADOR_NO_PUEDE_SALIR", "El organizador no puede salir de su partido: lo cancela");
+      }
+      if (horasEntre(estado.ahora, p.inicio) < HORAS_CANCELACION_GRATUITA) {
+        if (!forzar) {
+          throw new ErrorDelClub("FUERA_DE_PLAZO", `Faltan menos de ${HORAS_CANCELACION_GRATUITA} horas para el partido. Con forzar se sale y se paga la parte`);
+        }
+        p.penalizaciones.push({ socioId: quien.id, importe: p.importePorJugador });
+      }
+      p.jugadores = p.jugadores.filter((j) => j !== quien.id);
+      p.plazasLibres += 1;
+      if (p.estado === "completo") p.estado = "abierto";
+      expirarPartidos();
+      return { partido: p };
+    },
+
+    /** Lo cancela quien lo organiza o un gestor. Fuera de plazo, con `forzar`, la reserva lleva la penalización. */
+    cancelarPartido(quienId: string | undefined, id: string, datos: { forzar?: unknown }) {
+      const quien = quienLlama(quienId);
+      const p = partido(id);
+      const forzar = comprobarForzar(datos.forzar);
+      if (p.organizador !== quien.id && quien.rol !== "gestor") {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo quien organiza el partido o un gestor puede cancelarlo", 403);
+      }
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido ya estaba cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      const r = reserva(p.reservaId);
+      if (horasEntre(estado.ahora, p.inicio) < HORAS_CANCELACION_GRATUITA) {
+        if (!forzar) {
+          throw new ErrorDelClub("FUERA_DE_PLAZO", `Faltan menos de ${HORAS_CANCELACION_GRATUITA} horas para el partido. Con forzar se cancela con penalización del 100 %`);
+        }
+        r.penalizacion = r.importe;
+      }
+      anularPartido(p, "organizador");
+      return { partido: p };
+    },
   };
 }
 
