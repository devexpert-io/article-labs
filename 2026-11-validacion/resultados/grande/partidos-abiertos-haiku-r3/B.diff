+++ b/test/partidos.test.ts
@@ -0,0 +1,501 @@
+// Partidos abiertos: permisos, nivel de los socios, reglas al crear, unirse, salir, cancelar y la cancelación automática.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+// Jueves 25 de noviembre a las 08:00: la semilla no tiene nada de después, así que el límite de reservas solo cuenta lo de la prueba.
+const AHORA = "2026-11-25T08:00";
+
+/** Una API propia para cada prueba, con el reloj del club en `ahora`. */
+async function conReloj(ahora: string, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi({ AHORA: ahora });
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function fijarNivel(api: Api, socio: string, nivel: number | null) {
+  const r = await api.pedir("PATCH", `/api/socios/${socio}`, { socio, cuerpo: { nivel } });
+  assert.equal(r.status, 200, JSON.stringify(r.cuerpo));
+}
+
+async function crearOk(api: Api, socio: string, pistaId: string, inicio: string, extra: Record<string, unknown> = {}) {
+  const r = await api.pedir("POST", "/api/partidos", { socio, cuerpo: { pistaId, inicio, ...extra } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.partido;
+}
+
+async function unirOk(api: Api, id: string, socio: string) {
+  const r = await api.pedir("POST", `/api/partidos/${id}/unirse`, { socio });
+  assert.equal(r.status, 200, JSON.stringify(r.cuerpo));
+  return r.cuerpo.partido;
+}
+
+async function llenarOk(api: Api, id: string, socios: string[]) {
+  let partido: any;
+  for (const socio of socios) partido = await unirOk(api, id, socio);
+  return partido;
+}
+
+async function socioSinCuota(api: Api): Promise<string> {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  return estado.socios.find((s: { cuotaActiva: boolean }) => !s.cuotaActiva).id;
+}
+
+async function mover(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+test("permisos: crear, unirse, salir y cancelar piden X-Socio; consultar no", () =>
+  conReloj(AHORA, async (api) => {
+    const sin = await api.pedir("POST", "/api/partidos", { cuerpo: { pistaId: "pista-1", inicio: "2026-11-26T15:00" } });
+    assert.equal(sin.status, 401);
+    assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const partido = await crearOk(api, "socio-001", "pista-1", "2026-11-26T15:00");
+    for (const accion of ["unirse", "salir", "cancelar"]) {
+      const r = await api.pedir("POST", `/api/partidos/${partido.id}/${accion}`, { cuerpo: {} });
+      assert.equal(r.status, 401, accion);
+      assert.equal(r.cuerpo.error.codigo, "NO_IDENTIFICADO", accion);
+    }
+    assert.equal((await api.pedir("GET", "/api/partidos")).status, 200);
+    assert.equal((await api.pedir("GET", `/api/partidos/${partido.id}`)).status, 200);
+
+    const ajeno = await api.pedir("POST", `/api/partidos/${partido.id}/cancelar`, { socio: "socio-002", cuerpo: {} });
+    assert.equal(ajeno.status, 403);
+    assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const gestor = await api.pedir("POST", `/api/partidos/${partido.id}/cancelar`, { socio: "socio-040", cuerpo: {} });
+    assert.equal(gestor.status, 200);
+    assert.equal(gestor.cuerpo.partido.estado, "cancelado");
+  }));
+
+test("fijar el nivel: el propio socio o un gestor; con X-Socio", () =>
+  conReloj(AHORA, async (api) => {
+    const sin = await api.pedir("PATCH", "/api/socios/socio-001", { cuerpo: { nivel: 3 } });
+    assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    assert.equal(sin.status, 401);
+
+    const ajeno = await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-002", cuerpo: { nivel: 3 } });
+    assert.equal(ajeno.status, 403);
+    assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const ajenoInvalido = await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-002", cuerpo: { nivel: 0.5 } });
+    assert.equal(ajenoInvalido.status, 403, "el permiso se comprueba antes que el dato");
+    assert.equal(ajenoInvalido.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const propio = await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-001", cuerpo: { nivel: 3 } });
+    assert.equal(propio.status, 200);
+    assert.equal(propio.cuerpo.socio.nivel, 3);
+
+    const deGestor = await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-040", cuerpo: { nivel: 4.5 } });
+    assert.equal(deGestor.status, 200);
+    assert.equal(deGestor.cuerpo.socio.nivel, 4.5);
+  }));
+
+test("el nivel va de 1 a 7 en pasos de 0,5, o null; los socios lo traen", () =>
+  conReloj(AHORA, async (api) => {
+    const buscado = await api.pedir("GET", "/api/socios?texto=socio-001");
+    assert.equal(buscado.cuerpo.socios[0].nivel, null, "en la semilla todos empiezan con null");
+
+    for (const nivel of [1, 2.5, 7]) {
+      const r = await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-001", cuerpo: { nivel } });
+      assert.equal(r.status, 200, `nivel ${nivel}`);
+    }
+    for (const nivel of [0.5, 0.8, 7.5, 3.2, "3", true, 8]) {
+      const r = await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-001", cuerpo: { nivel } });
+      assert.equal(r.status, 400, `nivel ${JSON.stringify(nivel)}`);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    const sinNivel = await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-001", cuerpo: {} });
+    assert.equal(sinNivel.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const quitado = await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-001", cuerpo: { nivel: null } });
+    assert.equal(quitado.cuerpo.socio.nivel, null);
+
+    const inexistente = await api.pedir("PATCH", "/api/socios/socio-999", { socio: "socio-040", cuerpo: { nivel: 3 } });
+    assert.equal(inexistente.status, 404);
+    assert.equal(inexistente.cuerpo.error.codigo, "SOCIO_NO_ENCONTRADO");
+  }));
+
+test("crear un partido sigue las reglas de reservar", () =>
+  conReloj(AHORA, async (api) => {
+    const inactivo = await socioSinCuota(api);
+    const cuota = await api.pedir("POST", "/api/partidos", { socio: inactivo, cuerpo: { pistaId: "pista-1", inicio: "2026-11-26T15:00" } });
+    assert.equal(cuota.cuerpo.error.codigo, "CUOTA_INACTIVA");
+
+    const cerrada = await api.pedir("POST", "/api/partidos", { socio: "socio-001", cuerpo: { pistaId: "pista-4", inicio: "2026-11-26T15:00" } });
+    assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+
+    const pasada = await api.pedir("POST", "/api/partidos", { socio: "socio-001", cuerpo: { pistaId: "pista-1", inicio: "2026-11-24T09:00" } });
+    assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+
+    const franja = await api.pedir("POST", "/api/partidos", { socio: "socio-001", cuerpo: { pistaId: "pista-1", inicio: "2026-11-26T11:00" } });
+    assert.equal(franja.status, 400);
+    assert.equal(franja.cuerpo.error.codigo, "FRANJA_INVALIDA");
+
