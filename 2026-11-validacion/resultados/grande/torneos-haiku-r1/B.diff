@@ -0,0 +1,450 @@
+// Los torneos de parejas, probados a través de la API. Cada prueba arranca su propia API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+// Sábado sin reservas en la semilla: los torneos de estas pruebas se juegan aquí.
+const DIA = "2026-12-05";
+const franja = (hora: string, dia = DIA) => `${dia}T${hora}`;
+const CUATRO = ["09:00", "10:30", "12:00", "13:30"].map((h) => franja(h));
+// Parejas con la cuota al día (socio-011, socio-022 y socio-033 no la tienen).
+const PAREJAS = [
+  ["socio-001", "socio-002"],
+  ["socio-003", "socio-004"],
+  ["socio-005", "socio-006"],
+  ["socio-007", "socio-008"],
+  ["socio-009", "socio-010"],
+  ["socio-012", "socio-013"],
+  ["socio-014", "socio-015"],
+  ["socio-016", "socio-017"],
+];
+
+async function conApi(fn: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function crearTorneo(api: Api, cambios: Record<string, unknown> = {}) {
+  const r = await api.pedir("POST", "/api/torneos", {
+    socio: GESTOR,
+    cuerpo: { nombre: "Torneo de Navidad", pistas: ["pista-1", "pista-2"], franjas: CUATRO, plazas: 8, cuota: 1500, ...cambios },
+  });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.torneo;
+}
+
+function inscribirPareja(api: Api, torneoId: string, pareja: string[]) {
+  return api.pedir("POST", `/api/torneos/${torneoId}/inscripciones`, { socio: pareja[0], cuerpo: { socios: pareja } });
+}
+
+async function inscribirParejas(api: Api, torneoId: string, n: number) {
+  for (const pareja of PAREJAS.slice(0, n)) {
+    assert.equal((await inscribirPareja(api, torneoId, pareja)).status, 201);
+  }
+}
+
+function cerrar(api: Api, torneoId: string) {
+  return api.pedir("POST", `/api/torneos/${torneoId}/cerrar`, { socio: GESTOR });
+}
+
+function resultado(api: Api, torneoId: string, partidoId: string, ganadora: string, marcador?: string) {
+  return api.pedir("POST", `/api/torneos/${torneoId}/partidos/${partidoId}/resultado`, {
+    socio: GESTOR,
+    cuerpo: marcador === undefined ? { ganadora } : { ganadora, marcador },
+  });
+}
+
+async function ponerReloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function torneo(api: Api, id: string) {
+  return (await api.pedir("GET", `/api/torneos/${id}`)).cuerpo.torneo;
+}
+
+async function estadoDeFranja(api: Api, pistaId: string, inicio: string) {
+  const d = await api.pedir("GET", `/api/disponibilidad?fecha=${inicio.slice(0, 10)}&pista=${pistaId}`);
+  return d.cuerpo.pistas[0].franjas.find((f: { inicio: string }) => f.inicio === inicio);
+}
+
+test("permisos: crear y apuntar resultados solo para la recepción; consultar, sin identificarse", () =>
+  conApi(async (api) => {
+    const datos = { nombre: "Torneo", pistas: ["pista-1"], franjas: [CUATRO[0]], plazas: 4, cuota: 0 };
+    let r = await api.pedir("POST", "/api/torneos", { cuerpo: datos });
+    assert.equal(r.status, 401);
+    assert.equal(r.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    r = await api.pedir("POST", "/api/torneos", { socio: "socio-001", cuerpo: datos });
+    assert.equal(r.status, 403);
+    assert.equal(r.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const t = await crearTorneo(api);
+    assert.equal((await api.pedir("GET", "/api/torneos")).status, 200);
+    assert.equal((await api.pedir("GET", `/api/torneos/${t.id}`)).status, 200);
+    // Consultar no pide identificarse, pero una cabecera X-Socio que no existe da 401 como en el resto de la API.
+    assert.equal((await api.pedir("GET", "/api/torneos", { socio: "socio-999" })).cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    r = await api.pedir("POST", `/api/torneos/${t.id}/inscripciones`, { cuerpo: { socios: PAREJAS[0] } });
+    assert.equal(r.status, 401);
+    r = await api.pedir("POST", `/api/torneos/${t.id}/inscripciones`, { socio: "socio-030", cuerpo: { socios: PAREJAS[0] } });
+    assert.equal(r.status, 403);
+    assert.equal((await inscribirPareja(api, t.id, PAREJAS[0]!)).status, 201);
+    r = await api.pedir("POST", `/api/torneos/${t.id}/inscripciones/I-001/baja`, { socio: "socio-030" });
+    assert.equal(r.cuerpo.error.codigo, "SIN_PERMISO");
+    assert.equal((await api.pedir("POST", `/api/torneos/${t.id}/cerrar`, { socio: "socio-001" })).status, 403);
+    assert.equal((await api.pedir("POST", `/api/torneos/${t.id}/cancelar`, { socio: "socio-001" })).status, 403);
+  }));
+
+test("datos del torneo: formato, existencia, franjas válidas y no pasadas, pistas libres", () =>
+  conApi(async (api) => {
+    const probar = async (cambios: Record<string, unknown>, http: number, codigo: string) => {
+      const r = await api.pedir("POST", "/api/torneos", {
+        socio: GESTOR,
+        cuerpo: { nombre: "Torneo", pistas: ["pista-1"], franjas: [CUATRO[0]], plazas: 4, cuota: 0, ...cambios },
+      });
+      assert.equal(r.status, http, JSON.stringify(r.cuerpo));
+      assert.equal(r.cuerpo.error.codigo, codigo);
+      return r;
+    };
+    await probar({ nombre: "   " }, 400, "DATOS_INVALIDOS");
+    await probar({ pistas: [] }, 400, "DATOS_INVALIDOS");
+    await probar({ pistas: ["pista-1", "pista-1"] }, 400, "DATOS_INVALIDOS");
+    await probar({ franjas: [] }, 400, "DATOS_INVALIDOS");
+    await probar({ plazas: 3 }, 400, "DATOS_INVALIDOS");
+    await probar({ plazas: 17 }, 400, "DATOS_INVALIDOS");
+    await probar({ cuota: -1 }, 400, "DATOS_INVALIDOS");
+    await probar({ pistas: ["pista-99"] }, 404, "PISTA_NO_ENCONTRADA");
+    await probar({ franjas: [franja("11:00")] }, 400, "FRANJA_INVALIDA");
+    await probar({ franjas: ["2026-11-31T09:00"] }, 400, "FRANJA_INVALIDA");
+    await probar({ franjas: ["2026-13-01T09:00"] }, 400, "FRANJA_INVALIDA");
