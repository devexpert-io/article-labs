+function enRonda(partidos: Partido[], ronda: number): Partido[] {
+  return partidos.filter((p) => p.ronda === ronda);
+}
+
+/** Partido de la ronda siguiente al que va la ganadora de `partido`, y el sitio que ocupa (0 o 1). Undefined en la final. */
+function siguienteDe(partidos: Partido[], partido: Partido): { partido: Partido; sitio: 0 | 1 } | undefined {
+  const partidosRonda = enRonda(partidos, partido.ronda).length;
+  if (partidosRonda === 1) return undefined;
+  const sitio: 0 | 1 = partido.numero <= partidosRonda / 2 ? 0 : 1;
+  const numero = sitio === 0 ? partido.numero : partidosRonda + 1 - partido.numero;
+  const siguiente = partidos.find((p) => p.ronda === partido.ronda + 1 && p.numero === numero)!;
+  return { partido: siguiente, sitio };
+}
+
+/** Los partidos de la ronda anterior que alimentan a `partido` (vacío en la primera ronda). */
+function alimentanA(partidos: Partido[], partido: Partido): Partido[] {
+  if (partido.ronda === 1) return [];
+  const anteriores = enRonda(partidos, partido.ronda - 1).length;
+  return [partido.numero, anteriores + 1 - partido.numero].map(
+    (numero) => partidos.find((p) => p.ronda === partido.ronda - 1 && p.numero === numero)!,
+  );
+}
+
+/** El cuadro completo, sin horas: las parejas ya sabidas y los descansos. `inscritas` va en orden de inscripción. */
+function construirCuadro(inscritas: string[]): Partido[] {
+  const n = inscritas.length;
+  let total = 2;
+  while (total < n) total *= 2;
+  const partidos: Partido[] = [];
+  let partidosRonda = total / 2;
+  let ronda = 1;
+  for (let i = 1; i <= partidosRonda; i++) {
+    const rival = total + 1 - i;
+    const hayRival = rival <= n;
+    partidos.push({
+      id: "",
+      ronda,
+      numero: i,
+      parejas: [inscritas[i - 1]!, hayRival ? inscritas[rival - 1]! : null],
+      estado: hayRival ? "pendiente" : "descanso",
+      ganadora: hayRival ? null : inscritas[i - 1]!,
+      marcador: null,
+      pistaId: null,
+      inicio: null,
+    });
+  }
+  while (partidosRonda > 1) {
+    partidosRonda /= 2;
+    ronda += 1;
+    for (let j = 1; j <= partidosRonda; j++) {
+      partidos.push({ id: "", ronda, numero: j, parejas: [null, null], estado: "pendiente", ganadora: null, marcador: null, pistaId: null, inicio: null });
+    }
+  }
+  // Las ganadoras de los descansos pasan ya a la ronda siguiente.
+  for (const descanso of partidos.filter((p) => p.estado === "descanso")) {
+    const siguiente = siguienteDe(partidos, descanso);
+    if (siguiente) siguiente.partido.parejas[siguiente.sitio] = descanso.ganadora;
+  }
+  partidos.forEach((p, i) => {
+    p.id = `P-${String(i + 1).padStart(3, "0")}`;
+  });
+  return partidos;
+}
+
+/** Reparte pista y franja a cada partido que no es descanso, en orden de ronda y número. Lanza si no caben. */
+function asignarCalendario(torneo: Torneo, partidos: Partido[], ahora: string): void {
+  const ocupadas = new Set<string>();
+  for (const partido of partidos) {
+    if (partido.estado === "descanso") continue;
+    const minimo = alimentanA(partidos, partido)
+      .filter((p) => p.estado !== "descanso")
+      .map((p) => finDeFranja(p.inicio!))
+      .reduce((a, b) => (a > b ? a : b), "");
+    let libre: { franja: string; pista: string } | undefined;
+    for (const franja of torneo.franjas) {
+      if (franja <= ahora || franja < minimo) continue;
+      const pista = torneo.pistas.find((p) => !ocupadas.has(`${franja}|${p}`));
+      if (pista) {
+        libre = { franja, pista };
+        break;
+      }
+    }
+    if (!libre) throw new ErrorDelClub("FRANJAS_INSUFICIENTES", "No hay franjas y pistas para todos los partidos del cuadro");
+    ocupadas.add(`${libre.franja}|${libre.pista}`);
+    partido.pistaId = libre.pista;
+    partido.inicio = libre.franja;
+  }
+}
