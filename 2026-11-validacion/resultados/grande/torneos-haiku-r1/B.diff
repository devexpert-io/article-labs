+      return { torneo: torneo(id) };
+    },
+
+    inscribir(quien: Socio | undefined, torneoId: string, datos: Record<string, unknown>) {
+      const yo = exigirIdentidad(quien);
+      const t = torneo(torneoId);
+      const { socios } = datos;
+      if (!Array.isArray(socios) || socios.length !== 2 || socios[0] === socios[1] || !socios.every((s) => typeof s === "string")) {
+        invalido("socios debe ser una lista con los ids de dos socios distintos");
+      }
+      const [a, b] = socios as [string, string];
+      if (yo.rol !== "gestor" && yo.id !== a && yo.id !== b) {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo uno de los dos socios de la pareja o la recepción pueden inscribirla", 403);
+      }
+      if (!plazoAbierto(t)) throw new ErrorDelClub("INSCRIPCION_CERRADA", "La inscripción de este torneo ya no está abierta");
+      for (const id of [a, b]) {
+        const socio = estado.socios.find((s) => s.id === id);
+        if (!socio) throw new ErrorDelClub("SOCIO_NO_ENCONTRADO", `No existe el socio ${id}`, 404);
+        if (!socio.cuotaActiva) throw new ErrorDelClub("CUOTA_INACTIVA", `${socio.nombre} no tiene la cuota al día`);
+      }
+      const ocupan = (id: string) => t.inscripciones.some((i) => i.estado === "inscrita" && i.socios.includes(id));
+      for (const id of [a, b]) {
+        if (ocupan(id)) throw new ErrorDelClub("YA_INSCRITO", `El socio ${id} ya está inscrito en este torneo`);
+      }
+      const inscritas = t.inscripciones.filter((i) => i.estado === "inscrita").length;
+      if (inscritas >= t.plazas) throw new ErrorDelClub("TORNEO_COMPLETO", "No quedan plazas en este torneo");
+      const nueva = {
+        id: `I-${String(t.inscripciones.length + 1).padStart(3, "0")}`,
+        socios: [a, b] as [string, string],
+        estado: "inscrita" as const,
+        importe: t.cuota,
+      };
+      t.inscripciones.push(nueva);
+      return { inscripcion: nueva };
+    },
+
+    darDeBaja(quien: Socio | undefined, torneoId: string, inscripcionId: string) {
+      const yo = exigirIdentidad(quien);
+      const t = torneo(torneoId);
+      const inscripcion = t.inscripciones.find((i) => i.id === inscripcionId);
+      if (!inscripcion) throw new ErrorDelClub("INSCRIPCION_NO_ENCONTRADA", `No existe la inscripción ${inscripcionId} en este torneo`, 404);
+      if (yo.rol !== "gestor" && !inscripcion.socios.includes(yo.id)) {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo uno de los dos socios de la pareja o la recepción pueden darla de baja", 403);
+      }
+      if (inscripcion.estado === "baja") throw new ErrorDelClub("YA_DE_BAJA", "Esa inscripción ya está de baja");
+      if (!plazoAbierto(t)) throw new ErrorDelClub("INSCRIPCION_CERRADA", "La inscripción de este torneo ya no está abierta");
+      inscripcion.estado = "baja";
+      return { inscripcion };
+    },
+
+    cerrarTorneo(quien: Socio | undefined, torneoId: string) {
+      exigirGestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado !== "inscripcion") throw new ErrorDelClub("TORNEO_NO_EN_INSCRIPCION", "Solo se puede cerrar un torneo en inscripción");
+      const inscritas = t.inscripciones.filter((i) => i.estado === "inscrita").map((i) => i.id);
+      if (inscritas.length < 2) throw new ErrorDelClub("PAREJAS_INSUFICIENTES", "Hacen falta al menos 2 parejas inscritas");
+      const partidos = construirCuadro(inscritas);
+      asignarCalendario(t, partidos, estado.ahora);
+      t.partidos = partidos;
+      t.estado = "en_juego";
+      return { torneo: t };
+    },
+
+    apuntarResultado(quien: Socio | undefined, torneoId: string, partidoId: string, datos: Record<string, unknown>) {
+      exigirGestor(quien);
+      const t = torneo(torneoId);
+      const partido = t.partidos.find((p) => p.id === partidoId);
+      if (!partido) throw new ErrorDelClub("PARTIDO_NO_ENCONTRADO", `No existe el partido ${partidoId} en este torneo`, 404);
+      const { ganadora, marcador } = datos;
+      if (typeof ganadora !== "string") invalido("ganadora es obligatoria: el id de la inscripción que gana");
+      if (marcador !== undefined && marcador !== null && typeof marcador !== "string") invalido("marcador debe ser un texto");
+      if (t.estado !== "en_juego") throw new ErrorDelClub("TORNEO_NO_EN_JUEGO", "El torneo no está en juego");
+      if (partido.estado === "descanso" || partido.parejas.includes(null)) {
+        throw new ErrorDelClub("PARTIDO_NO_LISTO", "Aún no se sabe quién juega este partido");
+      }
+      if (!partido.parejas.includes(ganadora)) invalido("ganadora debe ser una de las dos parejas del partido");
+      if (partido.inicio! > estado.ahora) throw new ErrorDelClub("PARTIDO_NO_EMPEZADO", "El partido todavía no ha empezado");
+      const siguiente = siguienteDe(t.partidos, partido);
+      if (siguiente && siguiente.partido.estado === "jugado") {
+        throw new ErrorDelClub("RESULTADO_CERRADO", "La siguiente ronda ya se ha jugado: el resultado no se puede cambiar");
+      }
+      partido.ganadora = ganadora;
+      partido.marcador = (marcador as string | null | undefined) ?? null;
+      partido.estado = "jugado";
+      if (siguiente) {
+        siguiente.partido.parejas[siguiente.sitio] = ganadora;
+      } else {
+        t.estado = "terminado";
+        t.campeona = ganadora;
+      }
+      return { partido };
+    },
+
+    cancelarTorneo(quien: Socio | undefined, torneoId: string) {
+      exigirGestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado === "terminado") throw new ErrorDelClub("TORNEO_TERMINADO", "Un torneo terminado no se puede cancelar");
+      if (t.estado === "cancelado") throw new ErrorDelClub("YA_CANCELADO", "El torneo ya estaba cancelado");
+      t.estado = "cancelado";
+      return { torneo: t };
+    },
   };
 }
 
