+      const horas = horasEntre(estado.ahora, pt.inicio);
+      if (horas < HORAS_CANCELACION_GRATUITA) {
+        if (datos.forzar !== true) {
+          throw new ErrorDelClub(
+            "FUERA_DE_PLAZO",
+            `Faltan ${Math.floor(horas)} horas para el partido y se puede salir gratis hasta ${HORAS_CANCELACION_GRATUITA} horas antes. ` +
+            "Con forzar se sale pagando la parte del jugador: solo si el socio la ha aceptado expresamente.",
+          );
+        }
+        pt.penalizaciones.push({ socioId: yo.id, importe: pt.importePorJugador });
+      }
+      pt.jugadores = pt.jugadores.filter((j) => j !== yo.id);
+      pt.plazasLibres = JUGADORES_POR_PARTIDO - pt.jugadores.length;
+      pt.estado = "abierto";
+      revisarPartidos();
+      return { partido: pt };
+    },
+
+    cancelarPartido(id: string, datos: { forzar?: unknown }, quien: Socio | undefined) {
+      const yo = identificado(quien);
+      const pt = partido(id);
+      if (yo.rol !== "gestor" && yo.id !== pt.organizador) {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo quien organiza el partido o un gestor pueden cancelarlo", 403);
+      }
+      comprobarForzar(datos.forzar);
+      if (pt.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido ya está cancelado");
+      if (pt.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      const horas = horasEntre(estado.ahora, pt.inicio);
+      const tarde = horas < HORAS_CANCELACION_GRATUITA;
+      if (tarde && datos.forzar !== true) {
+        throw new ErrorDelClub(
+          "FUERA_DE_PLAZO",
+          `Faltan ${Math.floor(horas)} horas para el partido y la cancelación gratuita termina ${HORAS_CANCELACION_GRATUITA} horas antes. ` +
+          "Con forzar se cancela con una penalización del 100 % del importe: solo si el organizador ha aceptado expresamente la penalización.",
+        );
+      }
+      cancelarPartido(pt, "organizador", tarde);
+      return { partido: pt };
+    },
   };
 }
 
