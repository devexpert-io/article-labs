index 0000000..bafe0a9
--- /dev/null
+++ b/test/partidos.test.ts
@@ -0,0 +1,442 @@
+// Partidos abiertos: un socio reserva una pista y deja tres plazas para que se apunten otros socios.
+import assert from "node:assert/strict";
+import { after, before, describe, test } from "node:test";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SIN_CUOTA = "socio-011";
+
+/** Las franjas libres de un día, como `{ pistaId, inicio, precio }`, en orden de hora. */
+async function franjasLibres(api: Api, fecha: string) {
+  const r = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`);
+  const libres: { pistaId: string; inicio: string; precio: number }[] = [];
+  for (const p of r.cuerpo.pistas) {
+    for (const f of p.franjas) if (f.estado === "libre") libres.push({ pistaId: p.pistaId, inicio: f.inicio, precio: f.precio });
+  }
+  return libres.sort((a, b) => a.inicio.localeCompare(b.inicio));
+}
+
+/** Una franja libre de ese día, a partir de una hora y distinta de las ya usadas. */
+async function franjaLibre(api: Api, fecha: string, desde = "00:00", usadas = new Set<string>()) {
+  const libre = (await franjasLibres(api, fecha)).find((f) => f.inicio.slice(11) >= desde && !usadas.has(`${f.pistaId}|${f.inicio}`));
+  assert.ok(libre, `Hace falta una franja libre el ${fecha} desde las ${desde}`);
+  usadas.add(`${libre.pistaId}|${libre.inicio}`);
+  return libre;
+}
+
+/** Unos minutos antes de una fecha y hora del club. */
+function minutosAntes(inicio: string, minutos: number): string {
+  return new Date(Date.parse(`${inicio}:00Z`) - minutos * 60_000).toISOString().slice(0, 16);
+}
+
+/** Socios con la cuota al día, sin rol de gestor, sin reservas futuras y sin jugar en ningún partido. */
+async function sociosLibres(api: Api, cuantos: number): Promise<string[]> {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const ocupados = new Set(estado.reservas.filter((r: any) => r.estado === "confirmada" && r.inicio > estado.ahora).map((r: any) => r.socioId));
+  for (const p of estado.partidos) if (p.estado !== "cancelado") for (const j of p.jugadores) ocupados.add(j);
+  const libres = estado.socios.filter((s: any) => s.cuotaActiva && s.rol === "socio" && !ocupados.has(s.id)).map((s: any) => s.id);
+  assert.ok(libres.length >= cuantos, `Hacen falta ${cuantos} socios sin reservas futuras`);
+  return libres.slice(0, cuantos);
+}
+
+async function crearPartido(api: Api, socio: string, franja: { pistaId: string; inicio: string }, rango: object = {}) {
+  const r = await api.pedir("POST", "/api/partidos", { socio, cuerpo: { pistaId: franja.pistaId, inicio: franja.inicio, ...rango } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.partido;
+}
+
+async function fijarNivel(api: Api, socio: string, nivel: number | null) {
+  const r = await api.pedir("PATCH", `/api/socios/${socio}`, { socio, cuerpo: { nivel } });
+  assert.equal(r.status, 200, JSON.stringify(r.cuerpo));
+}
+
+function error(r: { status: number; cuerpo: any }, status: number, codigo: string) {
+  assert.equal(r.status, status, JSON.stringify(r.cuerpo));
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+describe("partidos abiertos", () => {
+  let api: Api;
+  let usadas: Set<string>;
+  before(async () => {
+    api = await arrancarApi();
+    usadas = new Set();
+  });
+  after(() => api.cerrar());
+
+  test("1. permisos: crear, unirse y salir piden X-Socio; cancelar y fijar nivel, permiso; consultar, nada", async () => {
+    const [org, otro] = await sociosLibres(api, 2);
+    const franja = await franjaLibre(api, "2026-11-24", "09:00", usadas);
+    error(await api.pedir("POST", "/api/partidos", { cuerpo: { pistaId: franja.pistaId, inicio: franja.inicio } }), 401, "NO_IDENTIFICADO");
+    const p = await crearPartido(api, org!, franja);
+    error(await api.pedir("POST", `/api/partidos/${p.id}/unirse`), 401, "NO_IDENTIFICADO");
+    error(await api.pedir("POST", `/api/partidos/${p.id}/salir`), 401, "NO_IDENTIFICADO");
+    error(await api.pedir("POST", `/api/partidos/${p.id}/cancelar`), 401, "NO_IDENTIFICADO");
+    error(await api.pedir("POST", `/api/partidos/${p.id}/cancelar`, { socio: otro }), 403, "SIN_PERMISO");
+    error(await api.pedir("PATCH", `/api/socios/${org}`, { cuerpo: { nivel: 3 } }), 401, "NO_IDENTIFICADO");
+    error(await api.pedir("PATCH", `/api/socios/${org}`, { socio: otro, cuerpo: { nivel: 3 } }), 403, "SIN_PERMISO");
+    assert.equal((await api.pedir("PATCH", `/api/socios/${org}`, { socio: GESTOR, cuerpo: { nivel: 3 } })).status, 200);
+    assert.equal((await api.pedir("GET", "/api/partidos")).status, 200);
+    assert.equal((await api.pedir("GET", `/api/partidos/${p.id}`)).status, 200);
+    const porGestor = await api.pedir("POST", `/api/partidos/${p.id}/cancelar`, { socio: GESTOR });
+    assert.equal(porGestor.status, 200);
+    assert.equal(porGestor.cuerpo.partido.estado, "cancelado");
+  });
+
+  test("2. nivel de los socios", async () => {
+    const yo = "socio-041";
+    const semilla = await api.pedir("GET", "/api/socios?texto=Nora");
+    assert.equal(semilla.cuerpo.socios[0].nivel, null);
+    for (const nivel of [1, 4.5, 7]) {
+      const r = await api.pedir("PATCH", `/api/socios/${yo}`, { socio: yo, cuerpo: { nivel } });
+      assert.equal(r.status, 200);
+      assert.equal(r.cuerpo.socio.id, yo);
+      assert.equal(r.cuerpo.socio.nivel, nivel);
+    }
+    for (const nivel of [0.5, 7.5, 3.2, "3", undefined, true]) {
+      error(await api.pedir("PATCH", `/api/socios/${yo}`, { socio: yo, cuerpo: nivel === undefined ? {} : { nivel } }), 400, "DATOS_INVALIDOS");
+    }
+    const buscado = await api.pedir("GET", "/api/socios?texto=socio-041");
+    assert.equal(buscado.cuerpo.socios[0].nivel, 7);
+    const quitado = await api.pedir("PATCH", `/api/socios/${yo}`, { socio: yo, cuerpo: { nivel: null } });
+    assert.equal(quitado.cuerpo.socio.nivel, null);
+    error(await api.pedir("PATCH", "/api/socios/socio-999", { socio: GESTOR, cuerpo: { nivel: 3 } }), 404, "SOCIO_NO_ENCONTRADO");
+  });
+
+  test("3. crear un partido tiene las mismas comprobaciones que reservar", async () => {
+    const [org] = await sociosLibres(api, 1);
+    const franja = await franjaLibre(api, "2026-11-24", "09:00", usadas);
+    const pedir = (socio: string, cuerpo: object) => api.pedir("POST", "/api/partidos", { socio, cuerpo });
+    error(await pedir(org!, { inicio: franja.inicio }), 400, "DATOS_INVALIDOS");
+    error(await pedir(org!, { pistaId: "pista-9", inicio: franja.inicio }), 404, "PISTA_NO_ENCONTRADA");
+    error(await pedir(org!, { pistaId: franja.pistaId, inicio: "2026-11-24T09:15" }), 400, "FRANJA_INVALIDA");
+    error(await pedir(SIN_CUOTA, { pistaId: franja.pistaId, inicio: franja.inicio }), 409, "CUOTA_INACTIVA");
+    error(await pedir(org!, { pistaId: "pista-4", inicio: franja.inicio }), 409, "PISTA_CERRADA");
+    error(await pedir(org!, { pistaId: franja.pistaId, inicio: "2026-11-18T09:00" }), 409, "FRANJA_PASADA");
+    error(await pedir(org!, { pistaId: "pista-1", inicio: "2026-11-19T19:30" }), 409, "FRANJA_NO_DISPONIBLE");
+    // Luis Martín tiene dos reservas futuras: con un partido llega a tres y ya no puede crear otro.
+    const luis1 = await franjaLibre(api, "2026-11-24", "09:00", usadas);
+    await crearPartido(api, "socio-005", luis1);
+    const luis2 = await franjaLibre(api, "2026-11-24", "09:00", usadas);
+    error(await pedir("socio-005", { pistaId: luis2.pistaId, inicio: luis2.inicio }), 409, "LIMITE_DE_RESERVAS");
+  });
+
+  test("4. rango de nivel al crear", async () => {
+    const [org] = await sociosLibres(api, 1);
+    const franja = await franjaLibre(api, "2026-11-24", "09:00", usadas);
+    const pedir = (rango: object) => api.pedir("POST", "/api/partidos", { socio: org, cuerpo: { pistaId: franja.pistaId, inicio: franja.inicio, ...rango } });
+    error(await pedir({ nivelMin: 3 }), 400, "DATOS_INVALIDOS");
+    error(await pedir({ nivelMax: 3 }), 400, "DATOS_INVALIDOS");
+    error(await pedir({ nivelMin: 3, nivelMax: 8 }), 400, "DATOS_INVALIDOS");
+    error(await pedir({ nivelMin: 2.3, nivelMax: 4 }), 400, "DATOS_INVALIDOS");
+    error(await pedir({ nivelMin: 5, nivelMax: 4 }), 400, "DATOS_INVALIDOS");
+    await fijarNivel(api, org!, null);
+    error(await pedir({ nivelMin: 3, nivelMax: 4 }), 409, "NIVEL_SIN_DEFINIR");
+    await fijarNivel(api, org!, 5);
+    error(await pedir({ nivelMin: 3, nivelMax: 4.5 }), 409, "NIVEL_FUERA_DE_RANGO");
+    const p = await crearPartido(api, org!, franja, { nivelMin: 4, nivelMax: 5 });
+    assert.equal(p.nivelMin, 4);
+    assert.equal(p.nivelMax, 5);
+  });
+
+  test("5, 6 y 7. la reserva del partido, la respuesta y el precio por jugador", async () => {
+    const [org] = await sociosLibres(api, 1);
+    const franja = await franjaLibre(api, "2026-11-24", "18:00", usadas);
+    const p = await crearPartido(api, org!, franja);
+    assert.match(p.id, /^P-\d{4}$/);
+    assert.equal(p.estado, "abierto");
+    assert.equal(p.organizador, org);
+    assert.deepEqual(p.jugadores, [org]);
+    assert.equal(p.plazasLibres, 3);
+    assert.deepEqual(p.penalizaciones, []);
+    assert.equal(p.nivelMin, null);
+    assert.equal(p.nivelMax, null);
+    assert.equal(p.pistaId, franja.pistaId);
+    assert.equal(p.inicio, franja.inicio);
+    assert.equal(p.fin, "2026-11-24T" + { "18:00": "19:30", "19:30": "21:00", "21:00": "22:30" }[franja.inicio.slice(11) as "18:00"]);
+    assert.equal(p.importe, franja.precio);
+    assert.equal(p.importePorJugador, Math.ceil(franja.precio / 4));
+
+    const reservas = await api.pedir("GET", `/api/reservas?socio=${org}&fecha=2026-11-24`);
+    const r = reservas.cuerpo.reservas.find((x: any) => x.id === p.reservaId);
+    assert.ok(r, "la reserva del partido sale en GET /api/reservas");
+    assert.equal(r.estado, "confirmada");
+    assert.equal(r.socioId, org);
+    assert.equal(r.partidoId, p.id);
+    assert.equal(r.importe, franja.precio);
+    const dia = await api.pedir("GET", `/api/disponibilidad?fecha=2026-11-24&pista=${franja.pistaId}`);
+    assert.equal(dia.cuerpo.pistas[0].franjas.find((f: any) => f.inicio === franja.inicio).estado, "reservada");
