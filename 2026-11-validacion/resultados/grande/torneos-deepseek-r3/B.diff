+    assert.equal(combos.size, jugables.length, "ningún partido comparte pista y franja");
+    for (const partido of jugables) {
+      assert.ok(torneo.franjas.includes(partido.inicio));
+      assert.ok(partido.inicio > "2026-11-18T10:00");
+      const anterior = partidos.filter((p) => p.ronda === partido.ronda - 1);
+      if (anterior.length === 0) continue;
+      const padres = [anterior[partido.numero - 1], anterior[anterior.length - partido.numero]];
+      for (const padre of padres) {
+        if (padre.estado === "descanso") continue;
+        assert.ok(partido.inicio >= finDe(padre.inicio), `el partido ${partido.id} empieza después de ${padre.id}`);
+      }
+    }
+    assert.deepEqual(
+      jugables.map((p) => p.inicio),
+      torneo.franjas.slice(0, jugables.length),
+      "se usan las primeras franjas, por ronda y número",
+    );
+  });
