+      if (yaInscrito) throw new ErrorDelClub("YA_INSCRITO", "Alguno de los socios ya está inscrito en este torneo");
+      const inscritas = t.inscripciones.filter((i) => i.estado === "inscrita").length;
+      if (inscritas >= t.plazas) throw new ErrorDelClub("TORNEO_COMPLETO", `El torneo ya tiene ${t.plazas} parejas inscritas`);
+
+      estado.contadorInscripciones += 1;
+      const inscripcion: Inscripcion = {
+        id: `I-${String(estado.contadorInscripciones).padStart(4, "0")}`,
+        socios: [uno, otro],
+        estado: "inscrita",
+        importe: t.cuota,
+      };
+      t.inscripciones.push(inscripcion);
+      return { inscripcion };
+    },
+
+    darDeBaja(torneoId: string, inscripcionId: string, quien?: Socio) {
+      const t = torneo(torneoId);
+      const inscripcion = t.inscripciones.find((i) => i.id === inscripcionId);
+      if (!inscripcion) throw new ErrorDelClub("INSCRIPCION_NO_ENCONTRADA", `No existe la inscripción ${inscripcionId} en el torneo ${torneoId}`, 404);
+      if (!quien) throw new ErrorDelClub("NO_IDENTIFICADO", "Hace falta identificarse con la cabecera X-Socio", 401);
+      if (quien.rol !== "gestor" && !inscripcion.socios.includes(quien.id)) {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo uno de los socios de la pareja o un gestor puede darla de baja", 403);
+      }
+      if (inscripcion.estado === "baja") throw new ErrorDelClub("YA_DE_BAJA", "Esa pareja ya está de baja");
+      exigirPlazoDeInscripcion(t);
+      inscripcion.estado = "baja";
+      return { inscripcion };
+    },
+
+    cerrarTorneo(torneoId: string, quien?: Socio) {
+      exigirGestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado !== "inscripcion") throw new ErrorDelClub("TORNEO_NO_EN_INSCRIPCION", "El torneo no está en inscripción");
+      const inscritas = t.inscripciones.filter((i) => i.estado === "inscrita");
+      if (inscritas.length < 2) throw new ErrorDelClub("PAREJAS_INSUFICIENTES", "Hacen falta al menos dos parejas inscritas");
+
+      const partidos = generarCuadro(inscritas);
+      asignarCalendario(t, partidos, estado.ahora);
+      const base = estado.contadorPartidos;
+      partidos.forEach((p, i) => {
+        p.id = `P-${String(base + i + 1).padStart(4, "0")}`;
+      });
+      estado.contadorPartidos = base + partidos.length;
+      t.partidos = partidos;
+      t.estado = "en_juego";
+      return { torneo: t };
+    },
+
+    apuntarResultado(torneoId: string, partidoId: string, datos: { ganadora?: unknown; marcador?: unknown }, quien?: Socio) {
+      exigirGestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado !== "en_juego") throw new ErrorDelClub("TORNEO_NO_EN_JUEGO", "El torneo no está en juego");
+      const partido = t.partidos.find((p) => p.id === partidoId);
+      if (!partido) throw new ErrorDelClub("PARTIDO_NO_ENCONTRADO", `No existe el partido ${partidoId} en el torneo ${torneoId}`, 404);
+      if (partido.estado === "descanso" || partido.parejas[0] === null || partido.parejas[1] === null) {
+        throw new ErrorDelClub("PARTIDO_NO_LISTO", "Ese partido todavía no tiene sus dos parejas");
+      }
+      if (partido.inicio === null || partido.inicio > estado.ahora) {
+        throw new ErrorDelClub("PARTIDO_NO_EMPEZADO", "Ese partido todavía no ha empezado");
+      }
+      if (datos.marcador !== undefined && datos.marcador !== null && typeof datos.marcador !== "string") {
+        invalido("marcador debe ser un texto");
+      }
+      const ganadora = datos.ganadora;
+      if (typeof ganadora !== "string" || !partido.parejas.includes(ganadora)) {
+        invalido("ganadora tiene que ser una de las dos parejas del partido");
+      }
+
+      const destino = siguienteDe(t, partido);
+      if (partido.estado === "jugado" && destino && destino.siguiente.estado === "jugado") {
+        throw new ErrorDelClub("RESULTADO_CERRADO", "El partido de la ronda siguiente ya se ha jugado");
+      }
+
+      partido.ganadora = ganadora;
+      partido.marcador = typeof datos.marcador === "string" ? datos.marcador : null;
+      partido.estado = "jugado";
+      if (destino) {
+        destino.siguiente.parejas[destino.hueco] = ganadora;
+      } else {
+        t.estado = "terminado";
+        t.campeona = ganadora;
+      }
+      return { partido };
+    },
+
+    cancelarTorneo(torneoId: string, quien?: Socio) {
+      exigirGestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado === "terminado") throw new ErrorDelClub("TORNEO_TERMINADO", "El torneo ya ha terminado y no se puede cancelar");
+      if (t.estado === "cancelado") throw new ErrorDelClub("YA_CANCELADO", "El torneo ya estaba cancelado");
+      t.estado = "cancelado";
+      return { torneo: t };
+    },
   };
 }
 
