+/** Genera el cuadro completo (todas las rondas) sin ids ni calendario. */
+function generarCuadro(inscritas: Inscripcion[]): Partido[] {
+  let plazas = 1;
+  while (plazas < inscritas.length) plazas *= 2;
+  const rondas: Partido[][] = [];
+
+  const primera: Partido[] = [];
+  for (let i = 1; i <= plazas / 2; i++) {
+    const pareja = inscritas[i - 1]!.id;
+    const rival = inscritas[plazas - i]?.id ?? null;
+    const descanso = rival === null;
+    primera.push({
+      id: "",
+      ronda: 1,
+      numero: i,
+      parejas: [pareja, rival],
+      estado: descanso ? "descanso" : "pendiente",
+      ganadora: descanso ? pareja : null,
+      marcador: null,
+      pistaId: null,
+      inicio: null,
+    });
+  }
+  rondas.push(primera);
+
+  let anterior = primera;
+  while (anterior.length > 1) {
+    const mitad = anterior.length / 2;
+    const siguiente: Partido[] = [];
+    for (let j = 1; j <= mitad; j++) {
+      siguiente.push({
+        id: "",
+        ronda: anterior[0]!.ronda + 1,
+        numero: j,
+        parejas: [anterior[j - 1]!.ganadora, anterior[anterior.length - j]!.ganadora],
+        estado: "pendiente",
+        ganadora: null,
+        marcador: null,
+        pistaId: null,
+        inicio: null,
+      });
+    }
+    rondas.push(siguiente);
+    anterior = siguiente;
+  }
+
+  return rondas.flat();
+}
+
+/** Reparte pista y franja a cada partido que no es un descanso, por ronda y número. */
+function asignarCalendario(torneo: Torneo, partidos: Partido[], ahora: string): void {
+  const combinaciones: Array<{ pistaId: string; inicio: string }> = [];
+  for (const inicio of torneo.franjas) {
+    for (const pistaId of torneo.pistas) combinaciones.push({ pistaId, inicio });
+  }
+  const ocupadas = new Set<string>();
+  const rondas = [...new Set(partidos.map((p) => p.ronda))].sort((a, b) => a - b);
+
+  for (const ronda of rondas) {
+    const deLaRonda = partidos.filter((p) => p.ronda === ronda);
+    const anterior = partidos.filter((p) => p.ronda === ronda - 1);
+    for (const partido of deLaRonda) {
+      if (partido.estado === "descanso") continue;
+      // El partido no puede empezar antes de que acaben sus dos partidos de la ronda anterior.
+      const padres = anterior.length === 0
+        ? []
+        : [anterior[partido.numero - 1], anterior[anterior.length - partido.numero]];
+      const minimo = padres
+        .filter((p): p is Partido => p !== undefined && p.estado !== "descanso" && p.inicio !== null)
+        .map((p) => finDeFranja(p.inicio!))
+        .sort()
+        .at(-1);
+      const hueco = combinaciones.find(
+        (c) => !ocupadas.has(`${c.pistaId}|${c.inicio}`) && c.inicio > ahora && (!minimo || c.inicio >= minimo),
+      );
+      if (!hueco) {
+        throw new ErrorDelClub("FRANJAS_INSUFICIENTES", `No hay franjas y pistas suficientes para el calendario del torneo ${torneo.id}`);
+      }
+      partido.pistaId = hueco.pistaId;
+      partido.inicio = hueco.inicio;
+      ocupadas.add(`${hueco.pistaId}|${hueco.inicio}`);
+    }
+  }
+}
+
+/** El partido de la ronda siguiente al que pasa la ganadora, con el hueco que ocupa (0 o 1). */
+function siguienteDe(torneo: Torneo, partido: Partido): { siguiente: Partido; hueco: 0 | 1 } | undefined {
+  const deLaRonda = torneo.partidos.filter((p) => p.ronda === partido.ronda);
+  if (deLaRonda.length <= 1) return undefined;
+  const primeraMitad = partido.numero <= deLaRonda.length / 2;
+  const numero = primeraMitad ? partido.numero : deLaRonda.length + 1 - partido.numero;
+  const siguiente = torneo.partidos.find((p) => p.ronda === partido.ronda + 1 && p.numero === numero);
+  if (!siguiente) return undefined;
+  return { siguiente, hueco: primeraMitad ? 0 : 1 };
+}
