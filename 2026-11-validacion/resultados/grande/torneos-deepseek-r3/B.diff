index 0000000..3ed9aff
--- /dev/null
+++ b/test/torneos.test.ts
@@ -0,0 +1,597 @@
+// Los torneos de parejas por eliminación directa, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+/** Socios con la cuota al día, de sobra para llenar los cuadros de los tests. */
+const ACTIVOS = [
+  "socio-001", "socio-002", "socio-003", "socio-004", "socio-005", "socio-006", "socio-007", "socio-008",
+  "socio-009", "socio-010", "socio-012", "socio-013", "socio-014", "socio-015", "socio-016", "socio-017",
+];
+
+/** Arranca una API limpia para cada test y la cierra al terminar. */
+async function conApi(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+/** Las primeras franjas libres de una pista en los días siguientes a la primera franja del plazo. */
+async function franjasLibres(api: Api, cuantas: number, pistaId = "pista-1"): Promise<string[]> {
+  const libres: string[] = [];
+  for (const fecha of ["2026-11-21", "2026-11-22"]) {
+    const respuesta = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pistaId}`);
+    for (const franja of respuesta.cuerpo.pistas[0].franjas) {
+      if (franja.estado === "libre") libres.push(franja.inicio);
+    }
+  }
+  assert.ok(libres.length >= cuantas, `hacen falta ${cuantas} franjas libres y hay ${libres.length}`);
+  return libres.slice(0, cuantas);
+}
+
+interface DatosTorneo {
+  nombre?: string;
+  pistas?: string[];
+  franjas?: string[];
+  plazas?: number;
+  cuota?: number;
+}
+
+async function crearTorneo(api: Api, datos: DatosTorneo = {}, socio: string | null = GESTOR) {
+  const franjas = datos.franjas ?? (await franjasLibres(api, 1));
+  return api.pedir("POST", "/api/torneos", {
+    socio: socio ?? undefined,
+    cuerpo: {
+      nombre: datos.nombre ?? "Torneo de prueba",
+      pistas: datos.pistas ?? ["pista-1"],
+      franjas,
+      plazas: datos.plazas ?? 8,
+      cuota: datos.cuota ?? 1500,
+    },
+  });
+}
+
+/** Las parejas de socios, en orden, para llenar un torneo. */
+function parejas(cuantas: number): Array<[string, string]> {
+  return Array.from({ length: cuantas }, (_, i) => [ACTIVOS[2 * i]!, ACTIVOS[2 * i + 1]!]);
+}
+
+async function inscribir(api: Api, torneoId: string, socios: [string, string], socio: string | null = GESTOR) {
+  return api.pedir("POST", `/api/torneos/${torneoId}/inscripciones`, { socio: socio ?? undefined, cuerpo: { socios } });
+}
+
+async function baja(api: Api, torneoId: string, inscripcionId: string, socio = GESTOR) {
+  return api.pedir("POST", `/api/torneos/${torneoId}/inscripciones/${inscripcionId}/baja`, { socio });
+}
+
+async function cerrar(api: Api, torneoId: string, socio = GESTOR) {
+  return api.pedir("POST", `/api/torneos/${torneoId}/cerrar`, { socio });
+}
+
+async function resultado(api: Api, torneoId: string, partidoId: string, cuerpo: Record<string, unknown>, socio = GESTOR) {
+  return api.pedir("POST", `/api/torneos/${torneoId}/partidos/${partidoId}/resultado`, { socio, cuerpo });
+}
+
+async function moverReloj(api: Api, ahora: string) {
+  const respuesta = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(respuesta.status, 200);
+}
+
+function finDe(inicio: string): string {
+  const [horas, minutos] = inicio.slice(11).split(":").map(Number);
+  const total = horas! * 60 + minutos! + 90;
+  const hh = String(Math.floor(total / 60)).padStart(2, "0");
+  const mm = String(total % 60).padStart(2, "0");
+  return `${inicio.slice(0, 10)}T${hh}:${mm}`;
+}
+
+/** Crea un torneo de `cuantas` parejas ya cerrado, con una franja por partido previsto. */
+async function torneoCerrado(api: Api, cuantas: number, plazas = 8) {
+  const franjas = await franjasLibres(api, 7);
+  const creado = await crearTorneo(api, { franjas, plazas });
+  assert.equal(creado.status, 201);
+  const torneoId = creado.cuerpo.torneo.id as string;
+  for (const pareja of parejas(cuantas)) {
+    assert.equal((await inscribir(api, torneoId, pareja)).status, 201);
+  }
+  const cerrado = await cerrar(api, torneoId);
+  assert.equal(cerrado.status, 200);
+  return cerrado.cuerpo.torneo;
+}
+
+test("permisos: los torneos los gestiona un gestor y las parejas se inscriben por sí mismas", async () => {
+  await conApi(async (api) => {
+    assert.equal((await crearTorneo(api, {}, null)).cuerpo.error.codigo, "NO_IDENTIFICADO");
+    assert.equal((await crearTorneo(api, {}, "socio-001")).cuerpo.error.codigo, "SIN_PERMISO");
+    const creado = await crearTorneo(api);
+    assert.equal(creado.status, 201);
+    const torneoId = creado.cuerpo.torneo.id;
+
+    assert.equal((await api.pedir("GET", "/api/torneos")).status, 200, "consultar no necesita identificarse");
+    assert.equal((await api.pedir("GET", `/api/torneos/${torneoId}`)).status, 200);
+
+    for (const [ruta, cuerpo] of [
+      [`/api/torneos/${torneoId}/cerrar`, undefined],
+      [`/api/torneos/${torneoId}/cancelar`, undefined],
+      [`/api/torneos/${torneoId}/partidos/P-0001/resultado`, { ganadora: "I-0001" }],
+    ] as const) {
+      assert.equal((await api.pedir("POST", ruta)).cuerpo.error.codigo, "NO_IDENTIFICADO");
+      assert.equal((await api.pedir("POST", ruta, { socio: "socio-001", cuerpo })).cuerpo.error.codigo, "SIN_PERMISO");
+    }
+
+    assert.equal((await inscribir(api, torneoId, ["socio-001", "socio-002"], null)).cuerpo.error.codigo, "NO_IDENTIFICADO");
+    assert.equal((await inscribir(api, torneoId, ["socio-001", "socio-002"], "socio-003")).cuerpo.error.codigo, "SIN_PERMISO");
+    assert.equal((await inscribir(api, torneoId, ["socio-001", "socio-002"], "socio-001")).status, 201);
+
+    const inscripcionId = (await api.pedir("GET", `/api/torneos/${torneoId}`)).cuerpo.torneo.inscripciones[0].id;
+    assert.equal((await baja(api, torneoId, inscripcionId, "socio-003")).cuerpo.error.codigo, "SIN_PERMISO");
+    assert.equal((await baja(api, torneoId, inscripcionId, "socio-002")).status, 200);
+  });
+});
+
+test("datos del torneo: se validan nombre, pistas, franjas, plazas y cuota", async () => {
+  await conApi(async (api) => {
+    const franja = (await franjasLibres(api, 1))[0]!;
+    const base = { nombre: "Torneo", pistas: ["pista-1"], franjas: [franja], plazas: 8, cuota: 1500 };
+    const invalido = async (cambios: Record<string, unknown>) => {
+      const respuesta = await api.pedir("POST", "/api/torneos", { socio: GESTOR, cuerpo: { ...base, ...cambios } });
+      assert.equal(respuesta.status, 400, JSON.stringify(cambios));
+      assert.equal(respuesta.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    };
+    await invalido({ nombre: "" });
+    await invalido({ nombre: 12 });
+    await invalido({ pistas: [] });
+    await invalido({ pistas: ["pista-1", "pista-1"] });
+    await invalido({ franjas: [] });
+    await invalido({ franjas: [franja, franja] });
+    await invalido({ plazas: 3 });
+    await invalido({ plazas: 17 });
+    await invalido({ plazas: 5.5 });
+    await invalido({ cuota: -1 });
+    await invalido({ cuota: 1.5 });
+
+    const sinPista = await api.pedir("POST", "/api/torneos", { socio: GESTOR, cuerpo: { ...base, pistas: ["pista-99"] } });
+    assert.equal(sinPista.status, 404);
+    assert.equal(sinPista.cuerpo.error.codigo, "PISTA_NO_ENCONTRADA");
+
+    const malFranja = await api.pedir("POST", "/api/torneos", { socio: GESTOR, cuerpo: { ...base, franjas: ["2026-11-21T11:00"] } });
+    assert.equal(malFranja.status, 400);
+    assert.equal(malFranja.cuerpo.error.codigo, "FRANJA_INVALIDA");
+
+    const pasada = await api.pedir("POST", "/api/torneos", { socio: GESTOR, cuerpo: { ...base, franjas: ["2026-11-18T09:00"] } });
+    assert.equal(pasada.status, 409);
+    assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+    assert.equal((await api.pedir("GET", "/api/torneos")).cuerpo.torneos.length, 0, "no se crea nada");
+  });
+});
+
+test("pistas cerradas y franjas ocupadas: el torneo no se crea", async () => {
+  await conApi(async (api) => {
+    const cerrada = await crearTorneo(api, { pistas: ["pista-4"], franjas: ["2026-11-21T09:00"] });
+    assert.equal(cerrada.status, 409);
