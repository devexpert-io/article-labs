+      const socioB = estado.socios.find((s) => s.id === idB);
+      if (!socioB) throw new ErrorDelClub("SOCIO_NO_ENCONTRADO", `No existe el socio ${idB}`, 404);
+      for (const socio of [socioA, socioB]) {
+        if (!socio.cuotaActiva) throw new ErrorDelClub("CUOTA_INACTIVA", `${socio.nombre} no tiene la cuota al día`);
+      }
+      const inscritas = t.inscripciones.filter((i) => i.estado === "inscrita");
+      if (inscritas.some((i) => i.socios.includes(idA) || i.socios.includes(idB))) {
+        throw new ErrorDelClub("YA_INSCRITO", "Alguno de los socios ya está inscrito en este torneo");
+      }
+      if (inscritas.length >= t.plazas) throw new ErrorDelClub("TORNEO_COMPLETO", "El torneo ya tiene todas sus plazas ocupadas");
+      if (!plazoDeInscripcionAbierto(t)) {
+        throw new ErrorDelClub("INSCRIPCION_CERRADA", "La inscripción del torneo está cerrada");
+      }
+      const inscripcion: Inscripcion = {
+        id: `${t.id}-I${t.inscripciones.length + 1}`,
+        socios: [idA, idB],
+        estado: "inscrita",
+        importe: t.cuota,
+      };
+      t.inscripciones.push(inscripcion);
+      return { inscripcion };
+    },
+
+    darDeBaja(torneoId: string, inscripcionId: string, quien: Socio | undefined) {
+      exigirIdentificado(quien);
+      const t = torneo(torneoId);
+      const inscripcion = t.inscripciones.find((i) => i.id === inscripcionId);
+      if (!inscripcion) {
+        throw new ErrorDelClub("INSCRIPCION_NO_ENCONTRADA", `No existe la inscripción ${inscripcionId} en este torneo`, 404);
+      }
+      if (quien!.rol !== "gestor" && !inscripcion.socios.includes(quien!.id)) {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo los dos socios de la pareja o un gestor pueden darle de baja", 403);
+      }
+      if (!plazoDeInscripcionAbierto(t)) {
+        throw new ErrorDelClub("INSCRIPCION_CERRADA", "La inscripción del torneo está cerrada");
+      }
+      if (inscripcion.estado === "baja") throw new ErrorDelClub("YA_DE_BAJA", "La pareja ya estaba de baja");
+      inscripcion.estado = "baja";
+      return { inscripcion };
+    },
+
+    cerrarTorneo(torneoId: string, quien: Socio | undefined) {
+      exigirGestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado !== "inscripcion") {
+        throw new ErrorDelClub("TORNEO_NO_EN_INSCRIPCION", "El torneo no está en periodo de inscripción");
+      }
+      const parejas = t.inscripciones.filter((i) => i.estado === "inscrita").map((i) => i.id);
+      if (parejas.length < 2) {
+        throw new ErrorDelClub("PAREJAS_INSUFICIENTES", "Hacen falta al menos dos parejas inscritas para cerrar el torneo");
+      }
+      // Si el calendario no cabe, esto lanza FRANJAS_INSUFICIENTES sin haber tocado el torneo.
+      const partidos = generarCuadro(t, parejas, estado.ahora);
+      t.partidos = partidos;
+      t.estado = "en_juego";
+      return { torneo: t };
+    },
+
+    apuntarResultado(
+      torneoId: string,
+      partidoId: string,
+      datos: { ganadora?: unknown; marcador?: unknown },
+      quien: Socio | undefined,
+    ) {
+      exigirGestor(quien);
+      const t = torneo(torneoId);
+      const partido = t.partidos.find((p) => p.id === partidoId);
+      if (!partido) throw new ErrorDelClub("PARTIDO_NO_ENCONTRADO", `No existe el partido ${partidoId} en este torneo`, 404);
+      if (t.estado !== "en_juego") throw new ErrorDelClub("TORNEO_NO_EN_JUEGO", "El torneo no está en juego");
+      const [local, visitante] = partido.parejas;
+      if (partido.estado === "descanso" || local === null || visitante === null) {
+        throw new ErrorDelClub("PARTIDO_NO_LISTO", "Todavía no se sabe qué dos parejas juegan este partido");
+      }
+      if (partido.inicio === null || partido.inicio > estado.ahora) {
+        throw new ErrorDelClub("PARTIDO_NO_EMPEZADO", "El partido todavía no ha empezado");
+      }
+      const ganadora = datos.ganadora;
+      if (typeof ganadora !== "string" || (ganadora !== local && ganadora !== visitante)) {
+        invalido("ganadora debe ser el id de una de las dos parejas del partido");
+      }
+      if (datos.marcador !== undefined && datos.marcador !== null && typeof datos.marcador !== "string") {
+        invalido("marcador debe ser un texto libre");
+      }
+      const siguientes = t.partidos.filter((p) => p.ronda === partido.ronda).sort((a, b) => a.numero - b.numero);
+      let siguiente: Partido | undefined;
+      let hueco: 0 | 1 = 0;
+      if (siguientes.length > 1) {
+        const { j, indice } = huecoEnSiguiente(partido, siguientes.length);
+        siguiente = t.partidos.find((p) => p.ronda === partido.ronda + 1 && p.numero === j);
+        hueco = indice;
+      }
+      if (partido.estado === "jugado" && siguiente?.estado === "jugado") {
+        throw new ErrorDelClub("RESULTADO_CERRADO", "El partido de la ronda siguiente ya está jugado: el resultado no se puede cambiar");
+      }
+      partido.ganadora = ganadora;
+      partido.marcador = typeof datos.marcador === "string" ? datos.marcador : null;
+      partido.estado = "jugado";
+      if (siguiente) {
+        siguiente.parejas[hueco] = ganadora;
+      } else {
+        t.estado = "terminado";
+        t.campeona = ganadora;
+      }
+      return { partido };
+    },
+
+    cancelarTorneo(torneoId: string, quien: Socio | undefined) {
+      exigirGestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado === "terminado") throw new ErrorDelClub("TORNEO_TERMINADO", "El torneo ya ha terminado y no se puede cancelar");
+      if (t.estado === "cancelado") throw new ErrorDelClub("YA_CANCELADO", "El torneo ya estaba cancelado");
+      t.estado = "cancelado";
+      return { torneo: t };
+    },
   };
 }
 
