+test("cerrar: cuadro de 5 parejas con descansos, calendario y franjas sobrantes", async () => {
+  const creado = await crearTorneo({
+    pistas: ["pista-1", "pista-2", "pista-3"],
+    franjas: ["2026-12-10T09:00", "2026-12-10T10:30", "2026-12-10T12:00", "2026-12-10T13:30"],
+  });
+  const id = creado.cuerpo.torneo.id;
+  const parejas: [string, string][] = [
+    ["socio-001", "socio-002"],
+    ["socio-003", "socio-004"],
+    ["socio-005", "socio-006"],
+    ["socio-007", "socio-008"],
+    ["socio-009", "socio-010"],
+  ];
+  const inscripcionIds: string[] = [];
+  for (const pareja of parejas) inscripcionIds.push((await inscribir(id, pareja)).cuerpo.inscripcion.id);
+
+  const cerrado = await cerrar(id);
+  assert.equal(cerrado.status, 200);
+  const torneo = cerrado.cuerpo.torneo;
+  assert.equal(torneo.estado, "en_juego");
+
+  const ronda = (n: number) => torneo.partidos.filter((p: any) => p.ronda === n).sort((a: any, b: any) => a.numero - b.numero);
+  assert.equal(torneo.partidos.length, 7);
+  assert.equal(ronda(1).length, 4);
+  assert.equal(ronda(2).length, 2);
+  assert.equal(ronda(3).length, 1);
+
+  // Primera ronda: 1, 2 y 3 descansan; 4 contra 5.
+  for (let i = 0; i < 3; i++) {
+    const partido = ronda(1)[i];
+    assert.deepEqual(partido.parejas, [inscripcionIds[i], null]);
+    assert.equal(partido.estado, "descanso");
+    assert.equal(partido.ganadora, inscripcionIds[i]);
+    assert.equal(partido.pistaId, null);
+    assert.equal(partido.inicio, null);
+  }
+  assert.deepEqual(ronda(1)[3].parejas, [inscripcionIds[3], inscripcionIds[4]]);
+  assert.equal(ronda(1)[3].estado, "pendiente");
+
+  // Segunda ronda: 1 contra la ganadora de 4 y 5; 2 contra 3.
+  assert.deepEqual(ronda(2)[0].parejas, [inscripcionIds[0], null]);
+  assert.deepEqual(ronda(2)[1].parejas, [inscripcionIds[1], inscripcionIds[2]]);
+  // La final aún no sabe sus parejas.
+  assert.deepEqual(ronda(3)[0].parejas, [null, null]);
+
+  // Calendario: se asignan por ronda y número, con la franja más temprana y la pista en orden.
+  assert.deepEqual([ronda(1)[3].pistaId, ronda(1)[3].inicio], ["pista-1", "2026-12-10T09:00"]);
+  assert.deepEqual([ronda(2)[0].pistaId, ronda(2)[0].inicio], ["pista-1", "2026-12-10T10:30"]);
+  assert.deepEqual([ronda(2)[1].pistaId, ronda(2)[1].inicio], ["pista-2", "2026-12-10T09:00"]);
+  assert.deepEqual([ronda(3)[0].pistaId, ronda(3)[0].inicio], ["pista-1", "2026-12-10T12:00"]);
+
+  // Los partidos no son reservas.
+  const reservas = await api.pedir("GET", "/api/reservas?fecha=2026-12-10&limite=100");
+  assert.equal(reservas.cuerpo.reservas.length, 0);
+
+  // Franjas sobrantes liberadas; las usadas siguen bloqueadas.
+  const disponibilidad = await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-10");
+  const porPista = Object.fromEntries(disponibilidad.cuerpo.pistas.map((p: any) => [p.pistaId, p]));
+  const estadoFranja = (pista: string, hora: string) =>
+    porPista[pista].franjas.find((f: any) => f.inicio.endsWith(hora)).estado;
+  assert.equal(estadoFranja("pista-3", "09:00"), "libre");
+  assert.equal(estadoFranja("pista-2", "10:30"), "libre");
+  assert.equal(estadoFranja("pista-1", "09:00"), "torneo");
+  assert.equal(estadoFranja("pista-2", "09:00"), "torneo");
+  assert.equal(estadoFranja("pista-1", "12:00"), "torneo");
+
+  // Reservar una franja usada sigue bloqueado; inscribirse ya no.
+  const reserva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-10T09:00" } });
+  assert.equal(reserva.cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  const tarde = await inscribir(id, ["socio-018", "socio-019"]);
+  assert.equal(tarde.cuerpo.error.codigo, "INSCRIPCION_CERRADA");
+  const otraVez = await cerrar(id);
+  assert.equal(otraVez.status, 409);
+  assert.equal(otraVez.cuerpo.error.codigo, "TORNEO_NO_EN_INSCRIPCION");
