+test("resultados: validaciones, propagación de la ganadora y corrección", async () => {
+  const creado = await crearTorneo({
+    pistas: ["pista-1", "pista-2"],
+    franjas: ["2026-12-12T09:00", "2026-12-12T10:30", "2026-12-12T12:00", "2026-12-12T13:30", "2026-12-12T15:00"],
+  });
+  const id = creado.cuerpo.torneo.id;
+  const parejas: [string, string][] = [
+    ["socio-001", "socio-002"],
+    ["socio-003", "socio-004"],
+    ["socio-005", "socio-006"],
+    ["socio-007", "socio-008"],
+    ["socio-009", "socio-010"],
+    ["socio-012", "socio-013"],
+    ["socio-014", "socio-015"],
+    ["socio-016", "socio-017"],
+  ];
+  const ids: string[] = [];
+  for (const pareja of parejas) ids.push((await inscribir(id, pareja)).cuerpo.inscripcion.id);
+  const torneo = (await cerrar(id)).cuerpo.torneo;
+  const ronda = (n: number, t: any = torneo) => t.partidos.filter((p: any) => p.ronda === n).sort((a: any, b: any) => a.numero - b.numero);
+
+  // Emparejamientos de la primera ronda: 1 contra 8, 2 contra 7, 3 contra 6 y 4 contra 5.
+  assert.deepEqual(ronda(1).map((p: any) => p.parejas), [
+    [ids[0], ids[7]],
+    [ids[1], ids[6]],
+    [ids[2], ids[5]],
+    [ids[3], ids[4]],
+  ]);
+  assert.deepEqual(ronda(2).map((p: any) => p.parejas), [[null, null], [null, null]]);
+
+  try {
+    await moverReloj("2026-12-12T14:00");
+
+    // La final aún no sabe sus parejas.
+    const final = ronda(3)[0];
+    const noListo = await api.pedir("POST", `/api/torneos/${id}/partidos/${final.id}/resultado`, { socio: GESTOR, cuerpo: { ganadora: ids[0] } });
+    assert.equal(noListo.status, 409);
+    assert.equal(noListo.cuerpo.error.codigo, "PARTIDO_NO_LISTO");
+
+    // Ganadora que no juega el partido.
+    const invalida = await api.pedir("POST", `/api/torneos/${id}/partidos/${ronda(1)[0].id}/resultado`, { socio: GESTOR, cuerpo: { ganadora: "socio-001" } });
+    assert.equal(invalida.status, 400);
+    assert.equal(invalida.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const inexistente = await api.pedir("POST", `/api/torneos/${id}/partidos/NADA/resultado`, { socio: GESTOR, cuerpo: { ganadora: ids[0] } });
+    assert.equal(inexistente.status, 404);
+    assert.equal(inexistente.cuerpo.error.codigo, "PARTIDO_NO_ENCONTRADO");
+
+    const apuntar = async (partido: any, ganadora: string) =>
+      api.pedir("POST", `/api/torneos/${id}/partidos/${partido.id}/resultado`, { socio: GESTOR, cuerpo: { ganadora } });
+
+    assert.equal((await apuntar(ronda(1)[0], ids[0])).status, 200);
+    assert.equal((await apuntar(ronda(1)[1], ids[1])).status, 200);
+    assert.equal((await apuntar(ronda(1)[2], ids[2])).status, 200);
+    assert.equal((await apuntar(ronda(1)[3], ids[3])).status, 200);
+
+    let actual = (await api.pedir("GET", `/api/torneos/${id}`)).cuerpo.torneo;
+    assert.deepEqual(ronda(2, actual).map((p: any) => p.parejas), [[ids[0], ids[3]], [ids[1], ids[2]]]);
+
+    // Se juega la primera semifinal.
+    const semi1 = ronda(2, actual)[0];
+    assert.equal((await apuntar(semi1, ids[3])).status, 200);
+    actual = (await api.pedir("GET", `/api/torneos/${id}`)).cuerpo.torneo;
+    assert.deepEqual(ronda(3, actual)[0].parejas, [ids[3], null]);
+
+    // Corregir un partido cuya ronda siguiente ya se jugó no se permite.
+    const cerrado = await apuntar(ronda(1, actual)[3], ids[4]);
+    assert.equal(cerrado.status, 409);
+    assert.equal(cerrado.cuerpo.error.codigo, "RESULTADO_CERRADO");
+
+    // Corregir un partido cuya ronda siguiente no se ha jugado sí, y cambia la pareja que pasó.
+    assert.equal((await apuntar(ronda(1, actual)[1], ids[6])).status, 200);
+    actual = (await api.pedir("GET", `/api/torneos/${id}`)).cuerpo.torneo;
+    assert.deepEqual(ronda(2, actual)[1].parejas, [ids[6], ids[2]]);
+
+    // Se juega la segunda semifinal y la final.
+    assert.equal((await apuntar(ronda(2, actual)[1], ids[2])).status, 200);
+    actual = (await api.pedir("GET", `/api/torneos/${id}`)).cuerpo.torneo;
+    assert.deepEqual(ronda(3, actual)[0].parejas, [ids[3], ids[2]]);
+    const finalJugada = await apuntar(ronda(3, actual)[0], ids[2]);
+    assert.equal(finalJugada.status, 200);
+    actual = (await api.pedir("GET", `/api/torneos/${id}`)).cuerpo.torneo;
+    assert.equal(actual.estado, "terminado");
+    assert.equal(actual.campeona, ids[2]);
+  } finally {
+    await moverReloj(AHORA);
+  }
+});
