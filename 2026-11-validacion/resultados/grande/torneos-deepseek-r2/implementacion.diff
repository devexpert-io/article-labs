+/** Índice del partido de la ronda siguiente al que pasa la ganadora, y su hueco (0 o 1). */
+function huecoEnSiguiente(partido: Partido, partidosRonda: number) {
+  const j = partido.numero <= partidosRonda / 2 ? partido.numero : partidosRonda + 1 - partido.numero;
+  return { j, indice: (partido.numero === j ? 0 : 1) as 0 | 1 };
+}
