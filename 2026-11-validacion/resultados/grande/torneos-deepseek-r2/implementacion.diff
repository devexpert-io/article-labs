+// Los torneos de parejas, probados a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const GESTOR = "socio-040";
+const AHORA = "2026-11-18T10:00";
+
+function crearTorneo(datos: Record<string, unknown> = {}): Promise<Respuesta> {
+  return api.pedir("POST", "/api/torneos", {
+    socio: GESTOR,
+    cuerpo: {
+      nombre: "Torneo de prueba",
+      pistas: ["pista-1"],
+      franjas: ["2026-11-25T09:00"],
+      plazas: 8,
+      cuota: 1000,
+      ...datos,
+    },
+  });
+}
+
+async function inscribir(id: string, socios: [string, string], quien = GESTOR): Promise<Respuesta> {
+  return api.pedir("POST", `/api/torneos/${id}/inscripciones`, { socio: quien, cuerpo: { socios } });
+}
+
+async function cerrar(id: string): Promise<Respuesta> {
+  return api.pedir("POST", `/api/torneos/${id}/cerrar`, { socio: GESTOR });
+}
+
+async function moverReloj(ahora: string): Promise<void> {
+  const respuesta = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(respuesta.status, 200);
+}
+
+test("permisos: gestor para crear, cerrar, cancelar y resultados; pareja o gestor para inscribir", async () => {
+  const sinIdentificar = await api.pedir("POST", "/api/torneos", { cuerpo: { nombre: "X", pistas: ["pista-1"], franjas: ["2026-11-25T09:00"], plazas: 4, cuota: 0 } });
+  assert.equal(sinIdentificar.status, 401);
+  assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const sinPermiso = await api.pedir("POST", "/api/torneos", {
+    socio: "socio-001",
+    cuerpo: { nombre: "X", pistas: ["pista-1"], franjas: ["2026-11-25T09:00"], plazas: 4, cuota: 0 },
+  });
+  assert.equal(sinPermiso.status, 403);
+  assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const creado = await crearTorneo();
+  assert.equal(creado.status, 201);
+  const id = creado.cuerpo.torneo.id;
+
+  // Consultar es libre.
+  assert.equal((await api.pedir("GET", "/api/torneos")).status, 200);
+  assert.equal((await api.pedir("GET", `/api/torneos/${id}`)).status, 200);
+
+  // Inscribir: sin identificar, un socio ajeno y un miembro de la pareja.
+  const sinSocio = await api.pedir("POST", `/api/torneos/${id}/inscripciones`, { cuerpo: { socios: ["socio-001", "socio-002"] } });
+  assert.equal(sinSocio.status, 401);
+  assert.equal(sinSocio.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const ajeno = await inscribir(id, ["socio-001", "socio-002"], "socio-003");
+  assert.equal(ajeno.status, 403);
+  assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+  const propio = await inscribir(id, ["socio-001", "socio-002"], "socio-001");
+  assert.equal(propio.status, 201);
+
+  for (const [metodo, ruta] of [
+    ["POST", `/api/torneos/${id}/cerrar`],
+    ["POST", `/api/torneos/${id}/cancelar`],
+    ["POST", `/api/torneos/${id}/partidos/lo-que-sea/resultado`],
+  ] as const) {
+    const anonimo = await api.pedir(metodo, ruta, { cuerpo: {} });
+    assert.equal(anonimo.status, 401, `${ruta} sin identificar`);
+    const noGestor = await api.pedir(metodo, ruta, { socio: "socio-001", cuerpo: {} });
+    assert.equal(noGestor.status, 403, `${ruta} con un socio normal`);
+  }
+});
+
+test("datos del torneo: nombre, listas, plazas, cuota, pistas y franjas", async () => {
+  const casos: [Record<string, unknown>, number, string][] = [
+    [{ nombre: "" }, 400, "DATOS_INVALIDOS"],
+    [{ nombre: "   " }, 400, "DATOS_INVALIDOS"],
+    [{ pistas: [] }, 400, "DATOS_INVALIDOS"],
+    [{ pistas: ["pista-1", "pista-1"] }, 400, "DATOS_INVALIDOS"],
+    [{ franjas: [] }, 400, "DATOS_INVALIDOS"],
+    [{ franjas: ["2026-11-25T09:00", "2026-11-25T09:00"] }, 400, "DATOS_INVALIDOS"],
+    [{ plazas: 3 }, 400, "DATOS_INVALIDOS"],
+    [{ plazas: 17 }, 400, "DATOS_INVALIDOS"],
+    [{ plazas: 4.5 }, 400, "DATOS_INVALIDOS"],
+    [{ cuota: -1 }, 400, "DATOS_INVALIDOS"],
+    [{ cuota: 1.5 }, 400, "DATOS_INVALIDOS"],
+    [{ pistas: ["pista-9"] }, 404, "PISTA_NO_ENCONTRADA"],
+    [{ franjas: ["2026-11-25T09:15"] }, 400, "FRANJA_INVALIDA"],
+    [{ franjas: ["2026-11-25"] }, 400, "FRANJA_INVALIDA"],
+    [{ franjas: ["2026-11-18T09:00"] }, 409, "FRANJA_PASADA"],
+    [{ pistas: ["pista-4"] }, 409, "PISTA_CERRADA"],
+  ];
+  for (const [datos, status, codigo] of casos) {
+    const respuesta = await crearTorneo(datos);
+    assert.equal(respuesta.status, status, JSON.stringify(datos));
+    assert.equal(respuesta.cuerpo.error.codigo, codigo, JSON.stringify(datos));
+  }
+});
+
+test("pistas libres: reservas confirmadas y otros torneos no cancelados dan conflictos", async () => {
+  const conReserva = await crearTorneo({ pistas: ["pista-1"], franjas: ["2026-11-19T19:30"] });
+  assert.equal(conReserva.status, 409);
+  assert.equal(conReserva.cuerpo.error.codigo, "FRANJAS_OCUPADAS");
+  assert.ok(Array.isArray(conReserva.cuerpo.error.conflictos));
+  const choqueReserva = conReserva.cuerpo.error.conflictos.find((c: any) => c.pistaId === "pista-1" && c.inicio === "2026-11-19T19:30");
+  assert.ok(choqueReserva.reservaId);
+
+  const primero = await crearTorneo({ pistas: ["pista-1", "pista-2"], franjas: ["2026-11-26T09:00"] });
+  assert.equal(primero.status, 201);
+  const segundo = await crearTorneo({ pistas: ["pista-2"], franjas: ["2026-11-26T09:00"] });
+  assert.equal(segundo.status, 409);
+  assert.equal(segundo.cuerpo.error.codigo, "FRANJAS_OCUPADAS");
+  const choqueTorneo = segundo.cuerpo.error.conflictos.find((c: any) => c.pistaId === "pista-2" && c.inicio === "2026-11-26T09:00");
+  assert.equal(choqueTorneo.torneoId, primero.cuerpo.torneo.id);
+
+  const disponibilidad = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-26&pista=pista-1");
+  const franja = disponibilidad.cuerpo.pistas[0].franjas.find((f: any) => f.inicio.endsWith("09:00"));
+  assert.equal(franja.torneoId, primero.cuerpo.torneo.id);
+
+  // Al cancelar el primero, sus franjas quedan libres para otro torneo.
+  const cancelado = await api.pedir("POST", `/api/torneos/${primero.cuerpo.torneo.id}/cancelar`, { socio: GESTOR });
+  assert.equal(cancelado.status, 200);
+  const tercero = await crearTorneo({ pistas: ["pista-2"], franjas: ["2026-11-26T09:00"] });
+  assert.equal(tercero.status, 201);
+});
