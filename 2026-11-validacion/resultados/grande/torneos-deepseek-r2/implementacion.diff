+test("cancelar: libera las franjas también en juego, y no se cancela dos veces", async () => {
+  const creado = await crearTorneo({ franjas: ["2026-12-14T09:00", "2026-12-14T10:30"] });
+  const id = creado.cuerpo.torneo.id;
+  const a = (await inscribir(id, ["socio-001", "socio-002"])).cuerpo.inscripcion.id;
+  const b = (await inscribir(id, ["socio-003", "socio-004"])).cuerpo.inscripcion.id;
+  const torneo = (await cerrar(id)).cuerpo.torneo;
+  assert.equal(torneo.partidos[0].inicio, "2026-12-14T09:00");
+
+  const cancelado = await api.pedir("POST", `/api/torneos/${id}/cancelar`, { socio: GESTOR });
+  assert.equal(cancelado.status, 200);
+  assert.equal(cancelado.cuerpo.torneo.estado, "cancelado");
+  const disponibilidad = await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-14&pista=pista-1");
+  assert.equal(disponibilidad.cuerpo.pistas[0].franjas.find((f: any) => f.inicio.endsWith("09:00")).estado, "libre");
+  assert.equal(disponibilidad.cuerpo.pistas[0].franjas.find((f: any) => f.inicio.endsWith("10:30")).estado, "libre");
+
+  const otraVez = await api.pedir("POST", `/api/torneos/${id}/cancelar`, { socio: GESTOR });
+  assert.equal(otraVez.status, 409);
+  assert.equal(otraVez.cuerpo.error.codigo, "YA_CANCELADO");
+  assert.ok(a && b);
+});
