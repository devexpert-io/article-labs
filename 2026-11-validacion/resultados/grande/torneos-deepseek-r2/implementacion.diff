+/** Construye todas las rondas, asigna pista y hora y devuelve los partidos en orden. */
+function generarCuadro(torneo: Torneo, parejas: string[], ahora: string): Partido[] {
+  let plazas = 1;
+  while (plazas < parejas.length) plazas *= 2;
+
+  const nuevoPartido = (ronda: number, numero: number, dosParejas: [string | null, string | null]): Partido => ({
+    id: "",
+    ronda,
+    numero,
+    parejas: dosParejas,
+    estado: "pendiente",
+    ganadora: null,
+    marcador: null,
+    pistaId: null,
+    inicio: null,
+  });
+
+  const primera: Partido[] = [];
+  for (let i = 1; i <= plazas / 2; i++) {
+    const local = parejas[i - 1]!;
+    const visitante = parejas[plazas - i] ?? null;
+    const partido = nuevoPartido(1, i, [local, visitante]);
+    if (visitante === null) {
+      partido.estado = "descanso";
+      partido.ganadora = local;
+    }
+    primera.push(partido);
+  }
+
+  const rondas: Partido[][] = [primera];
+  while (rondas[rondas.length - 1]!.length > 1) {
+    const anterior = rondas[rondas.length - 1]!;
+    const cuantos = anterior.length;
+    const ronda: Partido[] = [];
+    for (let j = 1; j <= cuantos / 2; j++) {
+      const a = anterior[j - 1]!;
+      const b = anterior[cuantos - j]!;
+      ronda.push(nuevoPartido(rondas.length + 1, j, [a.ganadora, b.ganadora]));
+    }
+    rondas.push(ronda);
+  }
+
+  let secuencia = 0;
+  for (const ronda of rondas) {
+    for (const partido of ronda) {
+      secuencia += 1;
+      partido.id = `${torneo.id}-P${String(secuencia).padStart(2, "0")}`;
+    }
+  }
+
+  // Calendario: franjas que aún no han empezado, por orden de ronda y número.
+  const franjas = torneo.franjas.filter((f) => f > ahora);
+  const usados = new Set<string>();
+  for (let r = 0; r < rondas.length; r++) {
+    for (const partido of rondas[r]!) {
+      if (partido.estado === "descanso") continue;
+      let minimo = "";
+      if (r > 0) {
+        const anterior = rondas[r - 1]!;
+        const cuantos = anterior.length;
+        const j = partido.numero <= cuantos / 2 ? partido.numero : cuantos + 1 - partido.numero;
+        for (const fuente of [anterior[j - 1]!, anterior[cuantos - j]!]) {
+          if (fuente.inicio !== null) {
+            const fin = finDeFranja(fuente.inicio);
+            if (fin > minimo) minimo = fin;
+          }
+        }
+      }
+      let elegida: { pistaId: string; inicio: string } | undefined;
+      for (const inicio of franjas) {
+        if (minimo !== "" && inicio < minimo) continue;
+        for (const pistaId of torneo.pistas) {
+          if (!usados.has(`${pistaId}|${inicio}`)) {
+            elegida = { pistaId, inicio };
+            break;
+          }
+        }
+        if (elegida) break;
+      }
+      if (!elegida) {
+        throw new ErrorDelClub("FRANJAS_INSUFICIENTES", "No hay franjas suficientes para todos los partidos del torneo");
+      }
+      partido.pistaId = elegida.pistaId;
+      partido.inicio = elegida.inicio;
+      usados.add(`${elegida.pistaId}|${elegida.inicio}`);
+    }
+  }
+
+  return rondas.flat();
+}
