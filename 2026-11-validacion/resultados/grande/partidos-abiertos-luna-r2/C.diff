@@ -0,0 +1,125 @@
+import assert from "node:assert/strict";
+import { after, before, beforeEach, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => { api = await arrancarApi(); });
+beforeEach(async () => { await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:00" } }); });
+after(() => api.cerrar());
+
+test("niveles de socio y permisos", async () => {
+  assert.equal((await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-002", cuerpo: { nivel: 4.5 } })).status, 403);
+  const fijado = await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-001", cuerpo: { nivel: 4.5 } });
+  assert.equal(fijado.cuerpo.socio.nivel, 4.5);
+  assert.equal((await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-001", cuerpo: { nivel: 4.3 } })).status, 400);
+});
+
+test("permisos HTTP y validación del rango de nivel", async () => {
+  const sinIdentidad = await api.pedir("POST", "/api/partidos", { cuerpo: { pistaId: "pista-2", inicio: "2026-12-03T13:30" } });
+  assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  assert.equal((await api.pedir("PATCH", "/api/socios/socio-001", { cuerpo: { nivel: 3 } })).cuerpo.error.codigo, "NO_IDENTIFICADO");
+  await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-001", cuerpo: { nivel: 3 } });
+  const creado = await api.pedir("POST", "/api/partidos", { socio: "socio-001", cuerpo: { pistaId: "pista-2", inicio: "2026-12-03T13:30", nivelMin: 2, nivelMax: 4 } });
+  const id = creado.cuerpo.partido.id;
+  assert.equal((await api.pedir("POST", `/api/partidos/${id}/unirse`)).cuerpo.error.codigo, "NO_IDENTIFICADO");
+  assert.equal((await api.pedir("POST", `/api/partidos/${id}/salir`)).cuerpo.error.codigo, "NO_IDENTIFICADO");
+  assert.equal((await api.pedir("POST", `/api/partidos/${id}/cancelar`, { socio: "socio-002" })).cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("POST", `/api/partidos/${id}/unirse`, { socio: "socio-002" })).cuerpo.error.codigo, "NIVEL_SIN_DEFINIR");
+  await api.pedir("PATCH", "/api/socios/socio-002", { socio: "socio-002", cuerpo: { nivel: 5 } });
+  assert.equal((await api.pedir("POST", `/api/partidos/${id}/unirse`, { socio: "socio-002" })).cuerpo.error.codigo, "NIVEL_FUERA_DE_RANGO");
+  assert.equal((await api.pedir("GET", "/api/partidos")).status, 200);
+});
+
+test("crear, unirse, completar y salir de un partido", async () => {
+  for (const s of ["socio-001", "socio-002", "socio-003", "socio-004"]) await api.pedir("PATCH", `/api/socios/${s}`, { socio: s, cuerpo: { nivel: 3 } });
+  const creado = await api.pedir("POST", "/api/partidos", { socio: "socio-001", cuerpo: { pistaId: "pista-2", inicio: "2026-11-25T13:30", nivelMin: 2, nivelMax: 4 } });
+  assert.equal(creado.status, 201);
+  const p = creado.cuerpo.partido;
+  assert.equal(p.plazasLibres, 3);
+  const r = (await api.pedir("GET", "/_estado")).cuerpo.reservas.find((x: any) => x.id === p.reservaId);
+  assert.equal(r.partidoId, p.id);
+  for (const s of ["socio-002", "socio-003", "socio-004"]) await api.pedir("POST", `/api/partidos/${p.id}/unirse`, { socio: s });
+  assert.equal((await api.pedir("GET", `/api/partidos/${p.id}`)).cuerpo.partido.estado, "completo");
+  const salida = await api.pedir("POST", `/api/partidos/${p.id}/salir`, { socio: "socio-004" });
+  assert.equal(salida.cuerpo.partido.estado, "abierto");
+  assert.equal(salida.cuerpo.partido.plazasLibres, 1);
+});
+
+test("cancelación automática al entrar en las seis horas", async () => {
+  const apiAuto = await arrancarApi();
+  const creado = await apiAuto.pedir("POST", "/api/partidos", { socio: "socio-001", cuerpo: { pistaId: "pista-2", inicio: "2026-11-26T16:30" } });
+  const p = creado.cuerpo.partido;
+  await apiAuto.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T10:30" } });
+  const actualizado = await apiAuto.pedir("GET", `/api/partidos/${p.id}`);
+  assert.equal(actualizado.cuerpo.partido.estado, "cancelado");
+  assert.equal(actualizado.cuerpo.partido.motivo, "incompleto");
+  assert.equal((await apiAuto.pedir("POST", `/api/reservas/${p.reservaId}/cancelar`)).cuerpo.error.codigo, "ES_UN_PARTIDO");
+  apiAuto.cerrar();
+});
+
+test("el reloj sincroniza sin consultar partidos: reserva, disponibilidad y nueva reserva", async () => {
+  const apiSync = await arrancarApi();
+  const creado = await apiSync.pedir("POST", "/api/partidos", { socio: "socio-001", cuerpo: { pistaId: "pista-2", inicio: "2026-11-27T16:30" } });
+  const p = creado.cuerpo.partido;
+  await apiSync.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-27T10:30" } });
+  assert.equal((await apiSync.pedir("GET", "/api/reservas?fecha=2026-11-27&socio=socio-001")).cuerpo.reservas.find((r: any) => r.id === p.reservaId).estado, "cancelada");
+  assert.equal((await apiSync.pedir("GET", "/api/disponibilidad?fecha=2026-11-27&pista=pista-2")).cuerpo.pistas[0].franjas.find((f: any) => f.inicio === p.inicio).estado, "libre");
+  const normal = await apiSync.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-001", pistaId: "pista-2", inicio: p.inicio } });
+  assert.equal(normal.status, 201);
+  apiSync.cerrar();
+});
+
+test("salto al inicio cancela y bloquea incorporaciones", async () => {
+  const apiSalto = await arrancarApi();
+  const creado = await apiSalto.pedir("POST", "/api/partidos", { socio: "socio-001", cuerpo: { pistaId: "pista-2", inicio: "2026-11-28T16:30" } });
+  const p = creado.cuerpo.partido;
+  await apiSalto.pedir("POST", "/_reloj", { cuerpo: { ahora: p.inicio } });
+  const unido = await apiSalto.pedir("POST", `/api/partidos/${p.id}/unirse`, { socio: "socio-002" });
+  assert.equal(unido.cuerpo.error.codigo, "PARTIDO_CANCELADO");
+  const estado = await apiSalto.pedir("GET", "/_estado");
+  assert.equal(estado.cuerpo.reservas.find((r: any) => r.id === p.reservaId).estado, "cancelada");
+  apiSalto.cerrar();
+});
+
+test("salir dentro de seis horas cancela sin penalizaciones", async () => {
+  const apiSalida = await arrancarApi();
+  const creado = await apiSalida.pedir("POST", "/api/partidos", { socio: "socio-001", cuerpo: { pistaId: "pista-2", inicio: "2026-11-29T16:30" } });
+  const p = creado.cuerpo.partido;
+  for (const socio of ["socio-002", "socio-003", "socio-004"]) await apiSalida.pedir("POST", `/api/partidos/${p.id}/unirse`, { socio });
+  await apiSalida.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-29T11:30" } });
+  const salida = await apiSalida.pedir("POST", `/api/partidos/${p.id}/salir`, { socio: "socio-004", cuerpo: { forzar: true } });
+  assert.equal(salida.cuerpo.partido.estado, "cancelado");
+  assert.deepEqual(salida.cuerpo.partido.penalizaciones, []);
+  assert.equal((await apiSalida.pedir("GET", "/api/reservas?fecha=2026-11-29&socio=socio-001")).cuerpo.reservas.find((r: any) => r.id === p.reservaId).estado, "cancelada");
+  apiSalida.cerrar();
+});
+
+test("crear partido conserva validaciones de reserva antes de DEMASIADO_TARDE", async () => {
+  const faltante = await api.pedir("POST", "/api/partidos", { socio: "socio-001", cuerpo: { pistaId: "pista-2" } });
+  assert.equal(faltante.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const pasadaReserva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-001", pistaId: "pista-2", inicio: "2026-11-18T09:30" } });
+  const pasadaPartido = await api.pedir("POST", "/api/partidos", { socio: "socio-001", cuerpo: { pistaId: "pista-2", inicio: "2026-11-18T09:30" } });
+  assert.equal(pasadaPartido.cuerpo.error.codigo, pasadaReserva.cuerpo.error.codigo);
+  assert.equal((await api.pedir("GET", "/api/partidos")).status, 200);
+});
+
+test("el límite compartido de tres incluye partidos abiertos como participante", async () => {
+  const apiLimite = await arrancarApi();
+  try {
+    const fechas = ["2026-12-04T13:30", "2026-12-05T13:30", "2026-12-06T13:30"];
+    const organizadores = ["socio-001", "socio-002", "socio-003"];
+    for (let i = 0; i < fechas.length; i++) {
+      const creado = await apiLimite.pedir("POST", "/api/partidos", { socio: organizadores[i], cuerpo: { pistaId: `pista-${i + 1}`, inicio: fechas[i] } });
+      assert.equal((await apiLimite.pedir("POST", `/api/partidos/${creado.cuerpo.partido.id}/unirse`, { socio: "socio-006" })).status, 200);
+    }
+    const cuarto = await apiLimite.pedir("POST", "/api/partidos", { socio: "socio-003", cuerpo: { pistaId: "pista-1", inicio: "2026-12-07T13:30" } });
+    assert.equal((await apiLimite.pedir("POST", `/api/partidos/${cuarto.cuerpo.partido.id}/unirse`, { socio: "socio-006" })).cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+  } finally { apiLimite.cerrar(); }
+});
+
+test("filtro fecha rechaza fechas imposibles y admite día bisiesto real", async () => {
+  for (const fecha of ["2026-02-30", "2026-13-01", "2025-02-29"]) {
+    assert.equal((await api.pedir("GET", `/api/partidos?fecha=${fecha}`)).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/partidos?fecha=2024-02-29")).status, 200);
+});
