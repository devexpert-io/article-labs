+test("cancelación automática al entrar en las seis horas", async () => {
+  const creado = await api.pedir("POST", "/api/partidos", { socio: "socio-001", cuerpo: { pistaId: "pista-2", inicio: "2026-11-25T16:30" } });
+  const p = creado.cuerpo.partido;
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T10:30" } });
+  const actualizado = await api.pedir("GET", `/api/partidos/${p.id}`);
+  assert.equal(actualizado.cuerpo.partido.estado, "cancelado");
+  assert.equal(actualizado.cuerpo.partido.motivo, "incompleto");
+  assert.equal((await api.pedir("POST", `/api/reservas/${p.reservaId}/cancelar`)).cuerpo.error.codigo, "ES_UN_PARTIDO");
+});
+
+test("el reloj cancela aunque salte más allá del inicio y libera disponibilidad", async () => {
+  const creado = await api.pedir("POST", "/api/partidos", { socio: "socio-001", cuerpo: { pistaId: "pista-2", inicio: "2026-11-26T13:30" } });
+  const p = creado.cuerpo.partido;
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T14:00" } });
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.partidos.find((x: any) => x.id === p.id).estado, "cancelado");
+  assert.equal(estado.reservas.find((x: any) => x.id === p.reservaId).estado, "cancelada");
+  const disponibilidad = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-26&pista=pista-2");
+  assert.equal(disponibilidad.cuerpo.pistas[0].franjas.find((x: any) => x.inicio === p.inicio).estado, "libre");
+});
