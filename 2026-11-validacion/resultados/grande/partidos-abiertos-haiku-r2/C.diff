+    salirDePartido(quienId: string, id: string, datos: { forzar?: unknown }) {
+      const socio = socioPorId(quienId);
+      const p = partido(id);
+      if (datos.forzar !== undefined && typeof datos.forzar !== "boolean") invalido("forzar debe ser true o false");
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      if (!p.jugadores.includes(socio.id)) throw new ErrorDelClub("NO_APUNTADO", `${socio.nombre} no juega en este partido`);
+      if (p.organizador === socio.id) {
+        throw new ErrorDelClub("ORGANIZADOR_NO_PUEDE_SALIR", "El organizador no puede salir de su partido: para dejarlo, cancélalo");
+      }
+      const horas = horasEntre(estado.ahora, p.inicio);
+      if (horas < HORAS_CANCELACION_GRATUITA) {
+        if (datos.forzar !== true) {
+          throw new ErrorDelClub(
+            "FUERA_DE_PLAZO",
+            `Faltan ${Math.floor(horas)} horas para el partido y salir gratis termina ${HORAS_CANCELACION_GRATUITA} horas antes. ` +
+            "Con forzar se sale y se anota una penalización de su parte del importe.",
+          );
+        }
+        p.penalizaciones.push({ socioId: socio.id, importe: p.importePorJugador });
+      }
+      p.jugadores = p.jugadores.filter((j) => j !== socio.id);
+      reflejarPlazas(p);
+      ponerAlDia();
+      return { partido: p };
+    },
+
+    cancelarPartido(quienId: string, id: string, datos: { forzar?: unknown }) {
+      const quien = socioPorId(quienId);
+      const p = partido(id);
+      if (quien.id !== p.organizador && quien.rol !== "gestor") {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo el organizador o un gestor pueden cancelar el partido", 403);
+      }
+      if (datos.forzar !== undefined && typeof datos.forzar !== "boolean") invalido("forzar debe ser true o false");
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido ya está cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      const r = reserva(p.reservaId);
+      const horas = horasEntre(estado.ahora, p.inicio);
+      if (horas < HORAS_CANCELACION_GRATUITA) {
+        if (datos.forzar !== true) {
+          throw new ErrorDelClub(
+            "FUERA_DE_PLAZO",
+            `Faltan ${Math.floor(horas)} horas para el partido y la cancelación gratuita termina ${HORAS_CANCELACION_GRATUITA} horas antes. ` +
+            "Con forzar se cancela con una penalización del 100 % del importe de la reserva.",
+          );
+        }
+        r.penalizacion = r.importe;
+      }
+      r.estado = "cancelada";
+      p.estado = "cancelado";
+      p.motivo = "organizador";
+      return { partido: p };
+    },
   };
 }
 
