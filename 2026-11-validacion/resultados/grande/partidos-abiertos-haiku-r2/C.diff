diff --git a/test/partidos.test.ts b/test/partidos.test.ts
new file mode 100644
index 0000000..da3159f
--- /dev/null
+++ b/test/partidos.test.ts
@@ -0,0 +1,490 @@
+// Los partidos abiertos y el nivel de los socios, probados a través de la API.
+// Cada prueba arranca su propia API: la hora del club se mueve con POST /_reloj sin afectar a las demás.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Despues de la última reserva de la semilla (el 24 a las 21:00): todos los socios empiezan sin reservas futuras.
+const AHORA = "2026-11-24T23:00";
+const DIA = "2026-11-26";
+const ORG = "socio-001";
+const JUG1 = "socio-002";
+const JUG2 = "socio-003";
+const JUG3 = "socio-006";
+const GESTOR = "socio-040";
+
+async function con(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const conClub = (prueba: (api: Api) => Promise<void>) => con({ AHORA }, prueba);
+
+async function abrir(api: Api, socio: string, pistaId: string, inicio: string, extra: Record<string, unknown> = {}) {
+  const r = await api.pedir("POST", "/api/partidos", { socio, cuerpo: { pistaId, inicio, ...extra } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.partido;
+}
+
+async function unirse(api: Api, socio: string, id: string) {
+  return api.pedir("POST", `/api/partidos/${id}/unirse`, { socio });
+}
+
+async function llenar(api: Api, id: string, socios = [JUG1, JUG2, JUG3]) {
+  for (const s of socios) assert.equal((await unirse(api, s, id)).status, 200);
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+// ---------------------------------------------------------------- nivel de los socios
+
+test("fijar el nivel: número en pasos de 0,5, null para quitarlo, y solo el propio socio o un gestor", async () => {
+  await conClub(async (api) => {
+    const fijado = await api.pedir("PATCH", `/api/socios/${JUG1}`, { socio: JUG1, cuerpo: { nivel: 3.5 } });
+    assert.equal(fijado.status, 200);
+    assert.equal(fijado.cuerpo.socio.nivel, 3.5);
+    const busqueda = await api.pedir("GET", "/api/socios?texto=socio-002");
+    assert.equal(busqueda.cuerpo.socios[0].nivel, 3.5);
+    assert.equal((await api.pedir("PATCH", `/api/socios/${JUG1}`, { socio: GESTOR, cuerpo: { nivel: 4 } })).status, 200);
+    const quitado = await api.pedir("PATCH", `/api/socios/${JUG1}`, { socio: JUG1, cuerpo: { nivel: null } });
+    assert.equal(quitado.cuerpo.socio.nivel, null);
+  });
+});
+
+test("fijar el nivel: datos no válidos, socio que no existe y permisos", async () => {
+  await conClub(async (api) => {
+    for (const nivel of [0, 7.5, 8, 3.25, "3", undefined]) {
+      const r = await api.pedir("PATCH", `/api/socios/${JUG1}`, { socio: JUG1, cuerpo: { nivel } });
+      assert.equal(r.status, 400, `nivel ${String(nivel)}`);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    const otro = await api.pedir("PATCH", `/api/socios/${JUG2}`, { socio: JUG1, cuerpo: { nivel: 3 } });
+    assert.equal(otro.status, 403);
+    assert.equal(otro.cuerpo.error.codigo, "SIN_PERMISO");
+    const sinIdentificar = await api.pedir("PATCH", `/api/socios/${JUG1}`, { cuerpo: { nivel: 3 } });
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const inexistente = await api.pedir("PATCH", "/api/socios/socio-999", { socio: GESTOR, cuerpo: { nivel: 3 } });
+    assert.equal(inexistente.status, 404);
+    assert.equal(inexistente.cuerpo.error.codigo, "SOCIO_NO_ENCONTRADO");
+  });
+});
+
+// ---------------------------------------------------------------- crear
+
+test("crear un partido reserva la pista y deja el partido abierto con el organizador", async () => {
+  await conClub(async (api) => {
+    const partido = await abrir(api, ORG, "pista-1", `${DIA}T10:30`);
+    assert.equal(partido.estado, "abierto");
+    assert.deepEqual(partido.jugadores, [ORG]);
+    assert.equal(partido.organizador, ORG);
+    assert.equal(partido.plazasLibres, 3);
+    assert.deepEqual(partido.penalizaciones, []);
+    assert.equal(partido.nivelMin, null);
+    assert.equal(partido.nivelMax, null);
+    assert.equal(partido.fin, `${DIA}T12:00`);
+    assert.equal(partido.importe, 1800);
+    assert.equal(partido.importePorJugador, 450);
+
+    const reserva = (await api.pedir("GET", `/api/reservas/${partido.reservaId}`)).cuerpo.reserva;
+    assert.equal(reserva.socioId, ORG);
+    assert.equal(reserva.estado, "confirmada");
+    assert.equal(reserva.importe, 1800);
+    assert.equal(reserva.partidoId, partido.id);
+
+    const delDia = (await api.pedir("GET", `/api/reservas?fecha=${DIA}`)).cuerpo.reservas;
+    assert.ok(delDia.some((r: { id: string }) => r.id === partido.reservaId));
+    const pista = (await api.pedir("GET", `/api/disponibilidad?fecha=${DIA}&pista=pista-1`)).cuerpo.pistas[0];
+    assert.equal(pista.franjas.find((f: { inicio: string }) => f.inicio.endsWith("10:30")).estado, "reservada");
+
+    const consulta = await api.pedir("GET", `/api/partidos/${partido.id}`);
+    assert.equal(consulta.status, 200);
+    assert.equal(consulta.cuerpo.partido.id, partido.id);
+    assert.equal((await api.pedir("GET", "/api/partidos/P-9999")).cuerpo.error.codigo, "PARTIDO_NO_ENCONTRADO");
+  });
+});
+
+test("crear un partido: el precio por jugador redondea al céntimo hacia arriba", async () => {
+  await conClub(async (api) => {
+    const punta = await abrir(api, ORG, "pista-1", `${DIA}T18:00`);
+    assert.equal(punta.importe, 2800);
+    assert.equal(punta.importePorJugador, 700);
+  });
+});
+
+test("crear un partido: mismas comprobaciones que una reserva normal", async () => {
+  await conClub(async (api) => {
+    const caso = async (socio: string, pistaId: string, inicio: string) =>
+      api.pedir("POST", "/api/partidos", { socio, cuerpo: { pistaId, inicio } });
+    assert.equal((await api.pedir("POST", "/api/partidos", { socio: ORG, cuerpo: { inicio: `${DIA}T10:30` } })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+    assert.equal((await caso("socio-999", "pista-1", `${DIA}T10:30`)).cuerpo.error.codigo, "NO_IDENTIFICADO");
+    assert.equal((await caso("socio-011", "pista-1", `${DIA}T10:30`)).cuerpo.error.codigo, "CUOTA_INACTIVA");
+    assert.equal((await caso(ORG, "pista-4", `${DIA}T10:30`)).cuerpo.error.codigo, "PISTA_CERRADA");
+    assert.equal((await caso(ORG, "pista-9", `${DIA}T10:30`)).status, 404);
+    assert.equal((await caso(ORG, "pista-1", `${DIA}T10:00`)).cuerpo.error.codigo, "FRANJA_INVALIDA");
+    assert.equal((await caso(ORG, "pista-1", "2026-11-24T21:00")).cuerpo.error.codigo, "FRANJA_PASADA");
+    await abrir(api, ORG, "pista-1", `${DIA}T10:30`);
+    assert.equal((await caso(JUG1, "pista-1", `${DIA}T10:30`)).cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+  });
+});
+
+test("crear un partido: no con menos de 6 horas de antelación", async () => {
+  await con({ AHORA: "2026-11-26T05:00" }, async (api) => {
+    const r = await api.pedir("POST", "/api/partidos", { socio: ORG, cuerpo: { pistaId: "pista-1", inicio: `${DIA}T10:30` } });
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "DEMASIADO_TARDE");
+  });
+  await con({ AHORA: "2026-11-26T04:00" }, async (api) => {
+    await abrir(api, ORG, "pista-1", `${DIA}T10:30`);
+  });
+});
+
+test("crear un partido: el límite de 3 reservas futuras también cuenta", async () => {
+  await conClub(async (api) => {
+    for (const [pistaId, inicio] of [["pista-2", `${DIA}T09:00`], ["pista-2", `${DIA}T12:00`], ["pista-3", `${DIA}T12:00`]]) {
+      assert.equal((await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: ORG, pistaId, inicio } })).status, 201);
+    }
+    const r = await api.pedir("POST", "/api/partidos", { socio: ORG, cuerpo: { pistaId: "pista-1", inicio: `${DIA}T16:30` } });
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+  });
+});
+
+test("crear un partido con rango de nivel: datos no válidos", async () => {
+  await conClub(async (api) => {
+    const caso = (extra: Record<string, unknown>) =>
+      api.pedir("POST", "/api/partidos", { socio: ORG, cuerpo: { pistaId: "pista-1", inicio: `${DIA}T10:30`, ...extra } });
+    for (const extra of [{ nivelMin: 3 }, { nivelMax: 5 }, { nivelMin: 5, nivelMax: 3 }, { nivelMin: "3", nivelMax: 5 }, { nivelMin: 0, nivelMax: 5 }, { nivelMin: 3, nivelMax: 8 }, { nivelMin: 3.2, nivelMax: 5 }]) {
+      const r = await caso(extra);
+      assert.equal(r.status, 400, JSON.stringify(extra));
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+  });
+});
+
+test("crear un partido con rango de nivel: el organizador tiene que tener nivel y estar dentro", async () => {
