@@ -0,0 +1,536 @@
+// Torneos de parejas por eliminación directa (docs/specs/torneos.md), probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+// Socios con la cuota al día (socio-011 y socio-022 no la tienen).
+const PAREJAS: [string, string][] = [
+  ["socio-001", "socio-002"], ["socio-003", "socio-004"], ["socio-005", "socio-006"], ["socio-007", "socio-008"],
+  ["socio-009", "socio-010"], ["socio-012", "socio-013"], ["socio-014", "socio-015"], ["socio-016", "socio-017"],
+];
+const SABADO = "2026-11-28";
+const DOMINGO = "2026-11-29";
+
+const datosTorneo = (cambios: Record<string, unknown> = {}) => ({
+  nombre: "Torneo de otoño",
+  pistas: ["pista-1", "pista-2"],
+  franjas: [`${SABADO}T12:00`, `${SABADO}T09:00`, `${SABADO}T10:30`, `${SABADO}T13:30`],
+  plazas: 8,
+  cuota: 3000,
+  ...cambios,
+});
+
+async function conApi(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function crear(api: Api, cambios: Record<string, unknown> = {}) {
+  const r = await api.pedir("POST", "/api/torneos", { cuerpo: datosTorneo(cambios), socio: GESTOR });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.torneo;
+}
+
+async function inscribir(api: Api, torneoId: string, n: number): Promise<string[]> {
+  const ids: string[] = [];
+  for (const socios of PAREJAS.slice(0, n)) {
+    const r = await api.pedir("POST", `/api/torneos/${torneoId}/inscripciones`, { cuerpo: { socios }, socio: socios[0] });
+    assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+    ids.push(r.cuerpo.inscripcion.id);
+  }
+  return ids;
+}
+
+const reloj = (api: Api, ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+const obtener = async (api: Api, id: string) => (await api.pedir("GET", `/api/torneos/${id}`)).cuerpo.torneo;
+const partido = (t: any, ronda: number, numero: number) => t.partidos.find((p: any) => p.ronda === ronda && p.numero === numero);
+const franja = async (api: Api, fecha: string, pistaId: string, hora: string) => {
+  const d = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pistaId}`);
+  return d.cuerpo.pistas[0].franjas.find((f: any) => f.inicio.endsWith(hora));
+};
+const resultado = (api: Api, t: any, p: any, ganadora: string, extra: Record<string, unknown> = {}) =>
+  api.pedir("POST", `/api/torneos/${t.id}/partidos/${p.id}/resultado`, { cuerpo: { ganadora, ...extra }, socio: GESTOR });
+
+test("1. permisos: gestor para gestionar, la pareja o un gestor para inscribir, cualquiera para consultar", () => conApi(async (api) => {
+  const sin = await api.pedir("POST", "/api/torneos", { cuerpo: datosTorneo() });
+  assert.equal(sin.status, 401);
+  assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("POST", "/api/torneos", { cuerpo: datosTorneo(), socio: "socio-001" });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const t = await crear(api);
+
+  assert.equal((await api.pedir("GET", "/api/torneos")).status, 200);
+  assert.equal((await api.pedir("GET", `/api/torneos/${t.id}`)).status, 200);
+
+  const ins = `/api/torneos/${t.id}/inscripciones`;
+  assert.equal((await api.pedir("POST", ins, { cuerpo: { socios: PAREJAS[0] } })).cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const ajeno = await api.pedir("POST", ins, { cuerpo: { socios: PAREJAS[0] }, socio: "socio-003" });
+  assert.equal(ajeno.status, 403);
+  assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+  const propia = await api.pedir("POST", ins, { cuerpo: { socios: PAREJAS[0] }, socio: "socio-002" });
+  assert.equal(propia.status, 201);
+  const porGestor = await api.pedir("POST", ins, { cuerpo: { socios: PAREJAS[1] }, socio: GESTOR });
+  assert.equal(porGestor.status, 201);
+
+  const baja = (id: string, socio?: string) => api.pedir("POST", `${ins}/${id}/baja`, socio ? { socio } : {});
+  assert.equal((await baja(propia.cuerpo.inscripcion.id)).status, 401);
+  assert.equal((await baja(propia.cuerpo.inscripcion.id, "socio-003")).status, 403);
+  assert.equal((await baja(propia.cuerpo.inscripcion.id, "socio-001")).status, 200);
+  assert.equal((await baja(porGestor.cuerpo.inscripcion.id, GESTOR)).status, 200);
+
+  for (const accion of ["cerrar", "cancelar"]) {
+    assert.equal((await api.pedir("POST", `/api/torneos/${t.id}/${accion}`)).status, 401);
+    assert.equal((await api.pedir("POST", `/api/torneos/${t.id}/${accion}`, { socio: "socio-001" })).status, 403);
+  }
+  const r = await api.pedir("POST", `/api/torneos/${t.id}/partidos/P-0001/resultado`, { cuerpo: { ganadora: "x" }, socio: "socio-001" });
+  assert.equal(r.status, 403);
+  assert.equal((await api.pedir("POST", `/api/torneos/${t.id}/partidos/P-0001/resultado`, { cuerpo: { ganadora: "x" } })).status, 401);
+}));
+
+test("2. datos del torneo", () => conApi(async (api) => {
+  const probar = async (cambios: Record<string, unknown>, http: number, codigo: string) => {
+    const r = await api.pedir("POST", "/api/torneos", { cuerpo: datosTorneo(cambios), socio: GESTOR });
+    assert.equal(r.status, http, JSON.stringify(cambios));
+    assert.equal(r.cuerpo.error.codigo, codigo, JSON.stringify(cambios));
+  };
+  for (const cambios of [
+    { nombre: "" }, { nombre: "   " }, { nombre: 3 },
+    { pistas: [] }, { pistas: "pista-1" }, { pistas: ["pista-1", "pista-1"] },
+    { franjas: [] }, { franjas: [`${SABADO}T09:00`, `${SABADO}T09:00`] },
+    { plazas: 3 }, { plazas: 17 }, { plazas: 4.5 }, { plazas: "8" },
+    { cuota: -1 }, { cuota: 10.5 }, { cuota: undefined },
+  ]) {
+    await probar(cambios, 400, "DATOS_INVALIDOS");
+  }
+  await probar({ pistas: ["pista-1", "pista-9"] }, 404, "PISTA_NO_ENCONTRADA");
+  await probar({ franjas: [`${SABADO}T09:15`] }, 400, "FRANJA_INVALIDA");
+  await probar({ franjas: ["mañana"] }, 400, "FRANJA_INVALIDA");
+  await probar({ franjas: ["2026-11-18T09:00"] }, 409, "FRANJA_PASADA");
+  await probar({ franjas: [`${SABADO}T09:00`, "2026-11-18T10:00"] }, 400, "FRANJA_INVALIDA");
+  await probar({ franjas: ["2026-11-18T10:30", "2026-11-18T09:00"] }, 409, "FRANJA_PASADA");
+  // Los extremos valen.
+  const valido = await api.pedir("POST", "/api/torneos", { cuerpo: datosTorneo({ plazas: 4, cuota: 0, franjas: [`${DOMINGO}T09:00`] }), socio: GESTOR });
+  assert.equal(valido.status, 201);
+  const dieciseis = await api.pedir("POST", "/api/torneos", { cuerpo: datosTorneo({ plazas: 16, franjas: [`${DOMINGO}T10:30`] }), socio: GESTOR });
+  assert.equal(dieciseis.status, 201);
+}));
+
+test("3. pistas libres: cerradas, reservas y otros torneos", () => conApi(async (api) => {
+  const cerrada = await api.pedir("POST", "/api/torneos", { cuerpo: datosTorneo({ pistas: ["pista-1", "pista-4"] }), socio: GESTOR });
+  assert.equal(cerrada.status, 409);
+  assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+
+  // El jueves 19 a las 19:30 la pista 1 está reservada (la última reserva de socio-007).
+  const reservas = (await api.pedir("GET", "/api/reservas?fecha=2026-11-19&pista=pista-1&estado=confirmada&limite=100")).cuerpo.reservas;
+  const r1930 = reservas.find((r: any) => r.inicio === "2026-11-19T19:30");
+  const conReserva = await api.pedir("POST", "/api/torneos", {
+    cuerpo: datosTorneo({ franjas: ["2026-11-19T19:30"], pistas: ["pista-2", "pista-1"] }), socio: GESTOR,
+  });
+  assert.equal(conReserva.status, 409);
+  assert.equal(conReserva.cuerpo.error.codigo, "FRANJAS_OCUPADAS");
+  assert.deepEqual(conReserva.cuerpo.error.conflictos, [{ pistaId: "pista-1", inicio: "2026-11-19T19:30", reservaId: r1930.id }]);
+
+  const primero = await crear(api);
+  const choque = await api.pedir("POST", "/api/torneos", {
+    cuerpo: datosTorneo({ pistas: ["pista-2", "pista-3"], franjas: [`${SABADO}T13:30`, `${SABADO}T15:00`] }), socio: GESTOR,
+  });
+  assert.equal(choque.status, 409);
+  assert.equal(choque.cuerpo.error.codigo, "FRANJAS_OCUPADAS");
+  assert.deepEqual(choque.cuerpo.error.conflictos, [{ pistaId: "pista-2", inicio: `${SABADO}T13:30`, torneoId: primero.id }]);
