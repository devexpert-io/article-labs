+      const t = torneo(torneoId);
+      if (t.estado !== "inscripcion") throw new ErrorDelClub("TORNEO_NO_EN_INSCRIPCION", "El torneo ya no está en inscripción");
+      const parejas = inscritas(t).map((i) => i.id);
+      if (parejas.length < 2) throw new ErrorDelClub("PAREJAS_INSUFICIENTES", "Hacen falta 2 parejas inscritas o más");
+
+      // Cuadro: T plazas, la menor potencia de 2 que llega al número de parejas.
+      let plazasCuadro = 2;
+      while (plazasCuadro < parejas.length) plazasCuadro *= 2;
+      const primerId = contarTodos((x) => x.partidos) + 1;
+      const partidos: Partido[] = [];
+      const nuevoPartido = (ronda: number, numero: number, parejasPartido: [string | null, string | null]): Partido => ({
+        id: `P-${String(primerId + partidos.length).padStart(4, "0")}`,
+        ronda, numero, parejas: parejasPartido, estado: "pendiente", ganadora: null, marcador: null, pistaId: null, inicio: null,
+      });
+      for (let i = 1; i <= plazasCuadro / 2; i++) {
+        const rival = parejas[plazasCuadro - i] ?? null;
+        const p = nuevoPartido(1, i, [parejas[i - 1]!, rival]);
+        if (rival === null) {
+          p.estado = "descanso";
+          p.ganadora = p.parejas[0];
+        }
+        partidos.push(p);
+      }
+      for (let ronda = 2, m = plazasCuadro / 4; m >= 1; ronda++, m /= 2) {
+        for (let j = 1; j <= m; j++) partidos.push(nuevoPartido(ronda, j, [null, null]));
+      }
+      const borrador: Torneo = { ...t, partidos };
+      for (const p of partidos.filter((x) => x.estado === "descanso")) {
+        const s = siguiente(borrador, p)!;
+        s.partido.parejas[s.hueco] = p.ganadora;
+      }
+
+      // Calendario: por ronda y número, la primera combinación libre que empieza cuando acaban los partidos de los que salen sus parejas.
+      const combinaciones = t.franjas.filter((f) => f > estado.ahora).flatMap((inicio) => t.pistas.map((pistaId) => ({ pistaId, inicio })));
+      const usadas = new Set<string>();
+      for (const p of partidos) {
+        if (p.estado === "descanso") continue;
+        const previos = p.ronda === 1 ? [] : partidos.filter((x) => x.ronda === p.ronda - 1 && x.estado !== "descanso" && siguiente(borrador, x)!.partido === p);
+        const desde = previos.map((x) => finDeFranja(x.inicio!)).sort().at(-1) ?? "";
+        const libre = combinaciones.find((c) => !usadas.has(`${c.pistaId}|${c.inicio}`) && c.inicio >= desde);
+        if (!libre) throw new ErrorDelClub("FRANJAS_INSUFICIENTES", "Las franjas del torneo no llegan para todos los partidos");
+        usadas.add(`${libre.pistaId}|${libre.inicio}`);
+        p.pistaId = libre.pistaId;
+        p.inicio = libre.inicio;
+      }
+      t.partidos = partidos;
+      t.estado = "en_juego";
+      return { torneo: t };
+    },
+
+    apuntarResultado(quien: Socio | undefined, torneoId: string, partidoId: string, datos: { ganadora?: unknown; marcador?: unknown }) {
+      exigirGestor(quien);
+      const t = torneo(torneoId);
+      const p = t.partidos.find((x) => x.id === partidoId);
+      if (!p) throw new ErrorDelClub("PARTIDO_NO_ENCONTRADO", `No existe el partido ${partidoId} en el torneo ${t.id}`, 404);
+      if (t.estado !== "en_juego") throw new ErrorDelClub("TORNEO_NO_EN_JUEGO", "El torneo no está en juego");
+      if (p.estado === "descanso" || p.parejas.includes(null)) {
+        throw new ErrorDelClub("PARTIDO_NO_LISTO", "El partido todavía no tiene sus dos parejas");
+      }
+      const { ganadora, marcador } = datos;
+      if (typeof ganadora !== "string" || !p.parejas.includes(ganadora)) invalido("ganadora debe ser el id de una de las dos parejas del partido");
+      if (marcador !== undefined && marcador !== null && typeof marcador !== "string") invalido("marcador debe ser un texto");
+      if (p.inicio! > estado.ahora) throw new ErrorDelClub("PARTIDO_NO_EMPEZADO", "El partido todavía no ha empezado");
+      const s = siguiente(t, p);
+      if (p.estado === "jugado" && s && s.partido.estado === "jugado") {
+        throw new ErrorDelClub("RESULTADO_CERRADO", "El partido de la ronda siguiente ya se ha jugado");
+      }
+      p.ganadora = ganadora as string;
+      p.marcador = (marcador as string | null | undefined) ?? null;
+      p.estado = "jugado";
+      if (s) {
+        s.partido.parejas[s.hueco] = p.ganadora;
+      } else {
+        t.estado = "terminado";
+        t.campeona = p.ganadora;
+      }
+      return { partido: p };
+    },
+
+    cancelarTorneo(quien: Socio | undefined, torneoId: string) {
+      exigirGestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado === "cancelado") throw new ErrorDelClub("YA_CANCELADO", "El torneo ya estaba cancelado");
+      if (t.estado === "terminado") throw new ErrorDelClub("TORNEO_TERMINADO", "Un torneo terminado no se cancela");
+      t.estado = "cancelado";
+      return { torneo: t };
+    },
   };
 }
 
