+/** La menor potencia de 2 que llega a n (2 como mínimo). */
+function siguientePotenciaDeDos(n: number): number {
+  let tamano = 2;
+  while (tamano < n) tamano *= 2;
+  return tamano;
+}
+
+/** El partido de la ronda siguiente al que pasa la ganadora de `partido`, y su hueco (0 o 1). */
+function siguientePartido(torneo: Torneo, partido: Partido): { partido: Partido; hueco: 0 | 1 } | undefined {
+  const deLaRonda = torneo.partidos.filter((p) => p.ronda === partido.ronda);
+  const siguienteRonda = torneo.partidos.filter((p) => p.ronda === partido.ronda + 1);
+  if (siguienteRonda.length === 0) return undefined;
+  const mitad = deLaRonda.length / 2;
+  const primero = partido.numero <= mitad;
+  const numero = primero ? partido.numero : deLaRonda.length + 1 - partido.numero;
+  const encontrado = siguienteRonda.find((p) => p.numero === numero)!;
+  return { partido: encontrado, hueco: primero ? 0 : 1 };
