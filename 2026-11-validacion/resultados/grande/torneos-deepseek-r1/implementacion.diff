+test("resultados: se apuntan cuando el partido ha empezado y la ganadora pasa de ronda", async () => {
+  const creado = await crearOk({
+    nombre: "Resultados",
+    pistas: ["pista-1"],
+    franjas: ["2026-12-13T10:30", "2026-12-13T12:00", "2026-12-13T13:30", "2026-12-13T15:00"],
+    plazas: 4,
+    cuota: 1000,
+  });
+  const inscripciones = [];
+  for (const pareja of [["socio-001", "socio-002"], ["socio-003", "socio-004"], ["socio-005", "socio-006"], ["socio-007", "socio-008"]] as [string, string][]) {
+    inscripciones.push(await inscribirOk(creado.id, pareja));
+  }
+  const ids = inscripciones.map((i) => i.id);
+  const t = await cerrarOk(creado.id);
+
+  assert.deepEqual([partido(t, 1, 1).inicio, partido(t, 1, 2).inicio, partido(t, 2, 1).inicio], ["2026-12-13T10:30", "2026-12-13T12:00", "2026-12-13T13:30"]);
+
+  const ruta = (partidoId: string) => `/api/torneos/${creado.id}/partidos/${partidoId}/resultado`;
+  const primera = partido(t, 1, 1);
+  const segunda = partido(t, 1, 2);
+  const final = partido(t, 2, 1);
+
+  const noEncontrado = await api.pedir("POST", ruta("P-9999"), { socio: GESTOR, cuerpo: { ganadora: ids[0] } });
+  assert.equal(noEncontrado.status, 404);
+  assert.equal(noEncontrado.cuerpo.error.codigo, "PARTIDO_NO_ENCONTRADO");
+
+  const temprano = await api.pedir("POST", ruta(primera.id), { socio: GESTOR, cuerpo: { ganadora: ids[0] } });
+  assert.equal(temprano.status, 409);
+  assert.equal(temprano.cuerpo.error.codigo, "PARTIDO_NO_EMPEZADO");
+
+  await moverReloj("2026-12-13T10:30");
+  try {
+    // La final todavía no tiene parejas: la ganadora no puede ser una de ellas.
+    const sinParejas = await api.pedir("POST", ruta(final.id), { socio: GESTOR, cuerpo: { ganadora: ids[0] } });
+    assert.equal(sinParejas.status, 400);
+    assert.equal(sinParejas.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const ajena = await api.pedir("POST", ruta(primera.id), { socio: GESTOR, cuerpo: { ganadora: ids[2] } });
+    assert.equal(ajena.status, 400);
+    assert.equal(ajena.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const jugado = await api.pedir("POST", ruta(primera.id), { socio: GESTOR, cuerpo: { ganadora: ids[0], marcador: "6-4 6-3" } });
+    assert.equal(jugado.status, 200);
+    assert.equal(jugado.cuerpo.partido.estado, "jugado");
+    assert.equal(jugado.cuerpo.partido.ganadora, ids[0]);
+    assert.equal(jugado.cuerpo.partido.marcador, "6-4 6-3");
+
+    let leido = await torneo(creado.id);
+    assert.deepEqual(partido(leido, 2, 1).parejas, [ids[0], null], "la ganadora ocupa su sitio en la final");
+
+    await moverReloj("2026-12-13T12:00");
+    const otra = await api.pedir("POST", ruta(segunda.id), { socio: GESTOR, cuerpo: { ganadora: ids[2] } });
+    assert.equal(otra.status, 200);
+    assert.equal(otra.cuerpo.partido.marcador, null);
+
+    leido = await torneo(creado.id);
+    assert.deepEqual(partido(leido, 2, 1).parejas, [ids[0], ids[2]]);
