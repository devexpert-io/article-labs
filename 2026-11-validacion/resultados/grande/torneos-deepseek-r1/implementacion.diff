+/** Un inicio de franja del club: un día válido a una de las horas de las franjas. */
+function esFranjaDelClub(inicio: string): boolean {
+  return FECHA_HORA.test(inicio) && fechaDelClub(inicio.slice(0, 10)) && HORAS_DEL_CLUB.includes(inicio.slice(11));
