+/** Un día que existe de verdad en el calendario. */
+function fechaDelClub(fecha: string): boolean {
+  if (!FECHA.test(fecha)) return false;
+  return new Date(`${fecha}T12:00:00Z`).toISOString().slice(0, 10) === fecha;
