+        partidos: [],
+        campeona: null,
+      };
+      estado.torneos.push(nuevo);
+      return { torneo: nuevo };
+    },
+
+    inscribirTorneo(torneoId: string, datos: { socios?: unknown }, quien?: Socio) {
+      const solicitante = exigeSocio(quien);
+      const { socios } = datos;
+      if (
+        !Array.isArray(socios) || socios.length !== 2 ||
+        !socios.every((s) => typeof s === "string") || socios[0] === socios[1]
+      ) {
+        invalido("socios debe ser una lista con dos ids distintos");
+      }
+      const idsSocios = socios as [string, string];
+      if (solicitante.rol !== "gestor" && !idsSocios.includes(solicitante.id)) {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo un socio de la pareja o un gestor puede inscribirla", 403);
+      }
+      const t = torneo(torneoId);
+      exigePlazo(t);
+      if (inscritas(t).length >= t.plazas) {
+        throw new ErrorDelClub("TORNEO_COMPLETO", "El torneo ya tiene ocupadas todas sus plazas");
+      }
+      for (const id of idsSocios) {
+        const socio = estado.socios.find((s) => s.id === id);
+        if (!socio) throw new ErrorDelClub("SOCIO_NO_ENCONTRADO", `No existe el socio ${id}`, 404);
+        if (!socio.cuotaActiva) throw new ErrorDelClub("CUOTA_INACTIVA", `${socio.nombre} no tiene la cuota al día`);
+      }
+      if (t.inscripciones.some((i) => i.estado === "inscrita" && i.socios.some((s) => idsSocios.includes(s)))) {
+        throw new ErrorDelClub("YA_INSCRITO", "Alguno de los socios ya está inscrito en este torneo");
+      }
+      estado.contadores.inscripciones += 1;
+      const nueva: Inscripcion = {
+        id: `I-${String(estado.contadores.inscripciones).padStart(4, "0")}`,
+        socios: idsSocios,
+        estado: "inscrita",
+        importe: t.cuota,
+      };
+      t.inscripciones.push(nueva);
+      return { inscripcion: nueva };
+    },
+
+    darDeBajaTorneo(torneoId: string, inscripcionId: string, quien?: Socio) {
+      const solicitante = exigeSocio(quien);
+      const t = torneo(torneoId);
+      const inscripcion = inscripcionDe(t, inscripcionId);
+      if (solicitante.rol !== "gestor" && !inscripcion.socios.includes(solicitante.id)) {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo un socio de la pareja o un gestor puede dar de baja la inscripción", 403);
+      }
+      exigePlazo(t);
+      if (inscripcion.estado === "baja") throw new ErrorDelClub("YA_DE_BAJA", "La inscripción ya estaba de baja");
+      inscripcion.estado = "baja";
+      return { inscripcion };
+    },
+
+    cerrarTorneo(torneoId: string, quien?: Socio) {
+      exigeGestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado !== "inscripcion") {
+        throw new ErrorDelClub("TORNEO_NO_EN_INSCRIPCION", "Solo se puede cerrar un torneo en inscripción");
+      }
+      if (inscritas(t).length < 2) {
+        throw new ErrorDelClub("PAREJAS_INSUFICIENTES", "Hacen falta al menos dos parejas para cerrar el torneo");
+      }
+      const partidos = generarPartidos(t);
+      t.partidos = partidos;
+      t.estado = "en_juego";
+      return { torneo: t };
+    },
+
+    apuntarResultado(
+      torneoId: string,
+      partidoId: string,
+      datos: { ganadora?: unknown; marcador?: unknown },
+      quien?: Socio,
+    ) {
+      exigeGestor(quien);
+      const t = torneo(torneoId);
+      const partido = t.partidos.find((p) => p.id === partidoId);
+      if (!partido) {
+        throw new ErrorDelClub("PARTIDO_NO_ENCONTRADO", `No existe el partido ${partidoId} en el torneo ${t.id}`, 404);
+      }
+      if (t.estado !== "en_juego") {
+        throw new ErrorDelClub("TORNEO_NO_EN_JUEGO", "Solo se apuntan resultados con el torneo en juego");
+      }
+      const { ganadora, marcador } = datos;
+      if (typeof ganadora !== "string" || !partido.parejas.includes(ganadora)) {
+        invalido("ganadora debe ser el id de una de las dos parejas del partido");
+      }
+      if (marcador !== undefined && typeof marcador !== "string") invalido("marcador debe ser un texto");
+      if (partido.estado === "descanso" || partido.parejas.some((p) => p === null)) {
+        throw new ErrorDelClub("PARTIDO_NO_LISTO", "Todavía no se saben las dos parejas de este partido");
+      }
+      if (partido.inicio === null || partido.inicio > estado.ahora) {
+        throw new ErrorDelClub("PARTIDO_NO_EMPEZADO", "El partido todavía no ha empezado");
+      }
+      const destino = siguientePartido(t, partido);
+      if (destino && destino.partido.estado === "jugado") {
+        throw new ErrorDelClub("RESULTADO_CERRADO", "El partido de la ronda siguiente ya se jugó");
+      }
+      partido.ganadora = ganadora;
+      partido.marcador = (marcador as string | undefined) ?? null;
+      partido.estado = "jugado";
+      if (destino) {
+        destino.partido.parejas[destino.hueco] = ganadora;
+      } else {
+        t.campeona = ganadora;
+        t.estado = "terminado";
+      }
+      return { partido };
+    },
+
+    cancelarTorneo(torneoId: string, quien?: Socio) {
+      exigeGestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado === "terminado") throw new ErrorDelClub("TORNEO_TERMINADO", "El torneo ya ha terminado");
+      if (t.estado === "cancelado") throw new ErrorDelClub("YA_CANCELADO", "El torneo ya estaba cancelado");
+      t.estado = "cancelado";
+      return { torneo: t };
+    },
   };
 }
 
