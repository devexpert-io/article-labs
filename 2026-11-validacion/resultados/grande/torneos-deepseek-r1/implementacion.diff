+// ---------------------------------------------------------------------------
+// 20. Corregir un resultado
+// ---------------------------------------------------------------------------
+
+test("corregir: cambia la ganadora y la ronda siguiente, salvo que esa ronda ya se jugó", async () => {
+  const creado = await crearOk({
+    nombre: "Correcciones",
+    pistas: ["pista-1"],
+    franjas: ["2026-12-14T10:30", "2026-12-14T12:00", "2026-12-14T13:30", "2026-12-14T15:00", "2026-12-14T16:30", "2026-12-14T18:00", "2026-12-14T19:30"],
+    plazas: 8,
+    cuota: 1000,
+  });
+  const inscripciones = [];
+  for (const pareja of [
+    ["socio-001", "socio-002"],
+    ["socio-003", "socio-004"],
+    ["socio-005", "socio-006"],
+    ["socio-007", "socio-008"],
+    ["socio-009", "socio-010"],
+    ["socio-012", "socio-013"],
+    ["socio-014", "socio-015"],
+    ["socio-016", "socio-017"],
+  ] as [string, string][]) {
+    inscripciones.push(await inscribirOk(creado.id, pareja));
+  }
+  const ids = inscripciones.map((i) => i.id);
+  const t = await cerrarOk(creado.id);
+  const ruta = (partidoId: string) => `/api/torneos/${creado.id}/partidos/${partidoId}/resultado`;
+  const jugar = (partidoId: string, ganadora: string) =>
+    api.pedir("POST", ruta(partidoId), { socio: GESTOR, cuerpo: { ganadora } });
+
+  await moverReloj("2026-12-14T19:30");
+  try {
+    // Primera ronda: la pareja i juega contra la T+1−i.
+    assert.deepEqual(partido(t, 1, 1).parejas, [ids[0], ids[7]]);
+    assert.deepEqual(partido(t, 1, 2).parejas, [ids[1], ids[6]]);
+    assert.deepEqual(partido(t, 1, 3).parejas, [ids[2], ids[5]]);
+    assert.deepEqual(partido(t, 1, 4).parejas, [ids[3], ids[4]]);
+
+    // La segunda ronda cruza la ganadora j con la M+1−j.
+    assert.equal((await jugar(partido(t, 1, 1).id, ids[0])).status, 200);
+    assert.equal((await jugar(partido(t, 1, 4).id, ids[3])).status, 200);
+    let leido = await torneo(creado.id);
+    assert.deepEqual(partido(leido, 2, 1).parejas, [ids[0], ids[3]]);
+
+    // La ronda 2 ya se jugó: la ronda 1 queda cerrada.
+    assert.equal((await jugar(partido(leido, 2, 1).id, ids[0])).status, 200);
+    const cerrada = await jugar(partido(leido, 1, 1).id, ids[7]);
+    assert.equal(cerrada.status, 409);
+    assert.equal(cerrada.cuerpo.error.codigo, "RESULTADO_CERRADO");
+    leido = await torneo(creado.id);
+    assert.equal(partido(leido, 1, 1).ganadora, ids[0]);
+
+    // La otra mitad de la ronda 2 no se ha jugado: se puede corregir.
+    assert.equal((await jugar(partido(t, 1, 2).id, ids[1])).status, 200);
+    assert.equal((await jugar(partido(t, 1, 3).id, ids[2])).status, 200);
+    leido = await torneo(creado.id);
+    assert.deepEqual(partido(leido, 2, 2).parejas, [ids[1], ids[2]]);
+
+    const correccion = await jugar(partido(leido, 1, 3).id, ids[5]);
+    assert.equal(correccion.status, 200);
+    assert.equal(correccion.cuerpo.partido.ganadora, ids[5]);
+    leido = await torneo(creado.id);
+    assert.deepEqual(partido(leido, 2, 2).parejas, [ids[1], ids[5]], "la ronda siguiente cambia de pareja");
+  } finally {
+    await moverReloj(AHORA);
+  }
+});
