@@ -0,0 +1,841 @@
+// Los torneos, probados a través de la API: permisos, cuadro, calendario y resultados.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const AHORA = "2026-11-18T10:00";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const crear = (datos: Record<string, unknown>, socio?: string) =>
+  api.pedir("POST", "/api/torneos", socio === undefined ? { cuerpo: datos } : { cuerpo: datos, socio });
+
+const crearOk = async (datos: Record<string, unknown>) => {
+  const r = await crear(datos, GESTOR);
+  assert.equal(r.status, 201, `crear torneo: ${r.texto}`);
+  return r.cuerpo.torneo;
+};
+
+const inscribir = (torneoId: string, socios: unknown, socio?: string) =>
+  api.pedir("POST", `/api/torneos/${torneoId}/inscripciones`, {
+    cuerpo: { socios },
+    ...(socio === undefined ? {} : { socio }),
+  });
+
+const inscribirOk = async (torneoId: string, socios: [string, string], socio = GESTOR) => {
+  const r = await inscribir(torneoId, socios, socio);
+  assert.equal(r.status, 201, `inscribir: ${r.texto}`);
+  return r.cuerpo.inscripcion;
+};
+
+const cerrar = (torneoId: string, socio = GESTOR) => api.pedir("POST", `/api/torneos/${torneoId}/cerrar`, { socio });
+
+const cerrarOk = async (torneoId: string) => {
+  const r = await cerrar(torneoId);
+  assert.equal(r.status, 200, `cerrar: ${r.texto}`);
+  return r.cuerpo.torneo;
+};
+
+const torneo = async (torneoId: string) => {
+  const r = await api.pedir("GET", `/api/torneos/${torneoId}`);
+  assert.equal(r.status, 200, `leer torneo: ${r.texto}`);
+  return r.cuerpo.torneo;
+};
+
+const moverReloj = async (ahora: string) => {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200, `mover reloj: ${r.texto}`);
+};
+
+const partido = (t: any, ronda: number, numero: number) => {
+  const encontrado = t.partidos.find((p: any) => p.ronda === ronda && p.numero === numero);
+  assert.ok(encontrado, `debe existir el partido ${ronda}-${numero}`);
+  return encontrado;
+};
+
+// ---------------------------------------------------------------------------
+// 1. Permisos
+// ---------------------------------------------------------------------------
+
+test("permisos: crear, cerrar, cancelar y resultados solo con un gestor", async () => {
+  const datos = { nombre: "Torneo de permisos", pistas: ["pista-1"], franjas: ["2026-12-07T10:30"], plazas: 4, cuota: 1000 };
+
+  const sinIdentificar = await crear(datos);
+  assert.equal(sinIdentificar.status, 401);
+  assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const socio = await crear(datos, "socio-001");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const creado = await crearOk(datos);
+  assert.equal(creado.estado, "inscripcion");
+
+  // Consultar no necesita identificarse.
+  assert.equal((await api.pedir("GET", "/api/torneos")).status, 200);
+  assert.equal((await api.pedir("GET", `/api/torneos/${creado.id}`)).status, 200);
+
+  // Inscribir: 401 sin identificarse, 403 si no es de la pareja ni gestor.
+  assert.equal((await inscribir(creado.id, ["socio-001", "socio-002"])).status, 401);
+  const tercero = await inscribir(creado.id, ["socio-001", "socio-002"], "socio-003");
+  assert.equal(tercero.status, 403);
+  assert.equal(tercero.cuerpo.error.codigo, "SIN_PERMISO");
+
+  // Uno de la pareja puede inscribir; un gestor, también.
+  assert.equal((await inscribir(creado.id, ["socio-001", "socio-002"], "socio-001")).status, 201);
+  assert.equal((await inscribir(creado.id, ["socio-003", "socio-004"], GESTOR)).status, 201);
+
+  // Cerrar y cancelar: solo gestor.
+  assert.equal((await cerrar(creado.id, "socio-001")).cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("POST", `/api/torneos/${creado.id}/cancelar`)).status, 401);
+
+  assert.equal((await cerrar(creado.id)).status, 200);
+  const conPartidos = await torneo(creado.id);
+  const partidoId = conPartidos.partidos[0].id;
+  const ruta = `/api/torneos/${creado.id}/partidos/${partidoId}/resultado`;
+
+  // Resultados: solo gestor.
+  assert.equal((await api.pedir("POST", ruta, { cuerpo: { ganadora: "I-1" } })).status, 401);
+  const sinPermiso = await api.pedir("POST", ruta, { cuerpo: { ganadora: "I-1" }, socio: "socio-001" });
+  assert.equal(sinPermiso.status, 403);
+  assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+  // Dar de baja: 401 sin identificarse.
+  const bajaAnonima = await api.pedir("POST", `/api/torneos/${creado.id}/inscripciones/${conPartidos.inscripciones[0].id}/baja`);
+  assert.equal(bajaAnonima.status, 401);
+});
+
+// ---------------------------------------------------------------------------
+// 2. Datos del torneo
+// ---------------------------------------------------------------------------
+
+test("datos del torneo: se validan nombre, pistas, franjas, plazas y cuota", async () => {
+  const base = { nombre: "Torneo", pistas: ["pista-1"], franjas: ["2026-12-08T10:30"], plazas: 4, cuota: 1000 };
+  const invalidos: [string, Record<string, unknown>][] = [
+    ["nombre vacío", { ...base, nombre: "   " }],
+    ["sin nombre", { ...base, nombre: undefined }],
+    ["pistas vacías", { ...base, pistas: [] }],
+    ["pistas repetidas", { ...base, pistas: ["pista-1", "pista-1"] }],
+    ["franjas vacías", { ...base, franjas: [] }],
+    ["franjas repetidas", { ...base, franjas: ["2026-12-08T10:30", "2026-12-08T10:30"] }],
+    ["plazas de menos", { ...base, plazas: 3 }],
+    ["plazas de más", { ...base, plazas: 17 }],
+    ["plazas no entera", { ...base, plazas: 4.5 }],
+    ["plazas de texto", { ...base, plazas: "4" }],
+    ["cuota negativa", { ...base, cuota: -1 }],
+    ["cuota no entera", { ...base, cuota: 10.5 }],
+  ];
+  for (const [caso, datos] of invalidos) {
+    const r = await crear(datos, GESTOR);
+    assert.equal(r.status, 400, caso);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", caso);
+  }
+
+  const pistaInexistente = await crear({ ...base, pistas: ["pista-99"] }, GESTOR);
+  assert.equal(pistaInexistente.status, 404);
+  assert.equal(pistaInexistente.cuerpo.error.codigo, "PISTA_NO_ENCONTRADA");
+
+  for (const franja of ["2026-12-08T10:15", "2026-12-08", "mañana", "2026-02-30T10:30"]) {
