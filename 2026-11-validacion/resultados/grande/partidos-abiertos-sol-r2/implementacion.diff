@@ -0,0 +1,220 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+
+const organizador = "socio-041";
+const jugadores = ["socio-002", "socio-004", "socio-005"];
+const inicio = "2026-11-26T18:00";
+function caso(nombre: string, ejecutar: (api: Api) => Promise<void>) {
+  test(nombre, async () => {
+    const api = await arrancarApi();
+    try { await ejecutar(api); } finally { api.cerrar(); }
+  });
+}
+function error(r: Respuesta, codigo: string, status = 409) {
+  assert.equal(r.status, status, r.texto);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+async function crear(api: Api, datos = {}, socio = organizador) {
+  const r = await api.pedir("POST", "/api/partidos", { socio, cuerpo: { pistaId: "pista-2", inicio, ...datos } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.partido;
+}
+async function accion(api: Api, id: string, nombre: string, socio?: string, cuerpo?: unknown) {
+  return api.pedir("POST", `/api/partidos/${id}/${nombre}`, { socio, cuerpo });
+}
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+async function llenar(api: Api, id: string) {
+  for (const socio of jugadores) assert.equal((await accion(api, id, "unirse", socio)).status, 200);
+}
+
+caso("identidad, permisos y partidos inexistentes", async (api) => {
+  error(await api.pedir("POST", "/api/partidos"), "NO_IDENTIFICADO", 401);
+  const p = await crear(api);
+  for (const a of ["unirse", "salir", "cancelar"]) error(await accion(api, p.id, a), "NO_IDENTIFICADO", 401);
+  error(await accion(api, p.id, "cancelar", jugadores[0]), "SIN_PERMISO", 403);
+  error(await api.pedir("PATCH", `/api/socios/${organizador}`, { cuerpo: { nivel: 3 } }), "NO_IDENTIFICADO", 401);
+  error(await api.pedir("PATCH", `/api/socios/${organizador}`, { socio: jugadores[0], cuerpo: { nivel: 3 } }), "SIN_PERMISO", 403);
+  assert.equal((await api.pedir("GET", `/api/partidos/${p.id}`)).status, 200);
+  error(await api.pedir("GET", "/api/partidos/no-existe"), "PARTIDO_NO_ENCONTRADO", 404);
+  for (const a of ["unirse", "salir", "cancelar"]) error(await accion(api, "no-existe", a, organizador), "PARTIDO_NO_ENCONTRADO", 404);
+  assert.equal((await accion(api, p.id, "cancelar", "socio-040")).status, 200);
+});
+
+caso("niveles válidos, nulos y consulta de socios", async (api) => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.ok(estado.socios.every((s: any) => s.nivel === null));
+  for (const nivel of [1, 3.5, 7, null]) {
+    const r = await api.pedir("PATCH", `/api/socios/${organizador}`, { socio: organizador, cuerpo: { nivel } });
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.socio.nivel, nivel);
+  }
+  for (const nivel of [0, 7.5, 3.2, "3", true, undefined]) error(await api.pedir("PATCH", `/api/socios/${organizador}`, { socio: organizador, cuerpo: { nivel } }), "DATOS_INVALIDOS", 400);
+  error(await api.pedir("PATCH", "/api/socios/no-existe", { socio: "socio-040", cuerpo: { nivel: 3 } }), "SOCIO_NO_ENCONTRADO", 404);
+  await api.pedir("PATCH", `/api/socios/${organizador}`, { socio: "socio-040", cuerpo: { nivel: 4.5 } });
+  assert.equal((await api.pedir("GET", "/api/socios?texto=Nora")).cuerpo.socios[0].nivel, 4.5);
+});
+
+caso("crear reutiliza las reglas de reservas y no deja estado tras errores", async (api) => {
+  for (const [datos, codigo, status] of [
+    [{ pistaId: "no-existe" }, "PISTA_NO_ENCONTRADA", 404],
+    [{ inicio: "2026-11-26T11:00" }, "FRANJA_INVALIDA", 400],
+    [{ pistaId: "pista-4" }, "PISTA_CERRADA", 409],
+    [{ inicio: "2026-11-18T09:00" }, "FRANJA_PASADA", 409],
+    [{ inicio: "2026-11-19T19:30", pistaId: "pista-1" }, "FRANJA_NO_DISPONIBLE", 409],
+    [{ inicio: "2026-11-18T15:00" }, "DEMASIADO_TARDE", 409],
+    [{}, "CUOTA_INACTIVA", 409],
+  ] as const) {
+    error(await api.pedir("POST", "/api/partidos", { socio: codigo === "CUOTA_INACTIVA" ? "socio-011" : organizador, cuerpo: { pistaId: "pista-2", inicio, ...datos } }), codigo, status);
+  }
+  assert.deepEqual((await api.pedir("GET", "/api/partidos")).cuerpo.partidos, []);
+});
+
+caso("rango al crear y al unirse: validación y extremos incluidos", async (api) => {
+  for (const rango of [{ nivelMin: 3 }, { nivelMax: 4 }, { nivelMin: null, nivelMax: null }, { nivelMin: 4, nivelMax: 3 }, { nivelMin: 3.1, nivelMax: 4 }, { nivelMin: "3", nivelMax: 4 }]) {
+    error(await api.pedir("POST", "/api/partidos", { socio: organizador, cuerpo: { pistaId: "pista-2", inicio, ...rango } }), "DATOS_INVALIDOS", 400);
+  }
+  const datos = { pistaId: "pista-2", inicio, nivelMin: 3, nivelMax: 4.5 };
+  error(await api.pedir("POST", "/api/partidos", { socio: organizador, cuerpo: datos }), "NIVEL_SIN_DEFINIR");
+  await api.pedir("PATCH", `/api/socios/${organizador}`, { socio: organizador, cuerpo: { nivel: 2.5 } });
+  error(await api.pedir("POST", "/api/partidos", { socio: organizador, cuerpo: datos }), "NIVEL_FUERA_DE_RANGO");
+  await api.pedir("PATCH", `/api/socios/${organizador}`, { socio: organizador, cuerpo: { nivel: 3 } });
+  const p = await crear(api, datos);
+  error(await accion(api, p.id, "unirse", jugadores[0]), "NIVEL_SIN_DEFINIR");
+  for (const nivel of [2.5, 5, 3, 4.5]) {
+    const id = nivel === 4.5 ? jugadores[1] : jugadores[0];
+    await api.pedir("PATCH", `/api/socios/${id}`, { socio: id, cuerpo: { nivel } });
+    const r = await accion(api, p.id, "unirse", id);
+    if (nivel < 3 || nivel > 4.5) error(r, "NIVEL_FUERA_DE_RANGO");
+    else assert.equal(r.status, 200);
+  }
+});
+
+caso("respuesta, reserva vinculada, precio, plazas y restricciones al unirse", async (api) => {
+  const p = await crear(api);
+  assert.deepEqual(p, { id: p.id, reservaId: p.reservaId, pistaId: "pista-2", inicio, fin: "2026-11-26T19:30", organizador, jugadores: [organizador], plazasLibres: 3, nivelMin: null, nivelMax: null, estado: "abierto", importe: 2800, importePorJugador: 700, penalizaciones: [] });
+  const r = (await api.pedir("GET", `/api/reservas/${p.reservaId}`)).cuerpo.reserva;
+  assert.equal(r.partidoId, p.id);
+  assert.equal(r.socioId, organizador);
+  assert.equal(r.estado, "confirmada");
+  assert.equal((await api.pedir("GET", `/api/reservas?fecha=2026-11-26`)).cuerpo.reservas[0].partidoId, p.id);
+  const d = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-26&pista=pista-2")).cuerpo;
+  assert.equal(d.pistas[0].franjas.find((f: any) => f.inicio === inicio).estado, "reservada");
+  error(await accion(api, p.id, "unirse", organizador), "YA_APUNTADO");
+  error(await accion(api, p.id, "unirse", "socio-011"), "CUOTA_INACTIVA");
+  error(await api.pedir("POST", `/api/reservas/${p.reservaId}/cancelar`), "ES_UN_PARTIDO");
+  await llenar(api, p.id);
+  const completo = (await api.pedir("GET", `/api/partidos/${p.id}`)).cuerpo.partido;
+  assert.deepEqual(completo.jugadores, [organizador, ...jugadores]);
+  assert.equal(completo.estado, "completo");
+  assert.equal(completo.plazasLibres, 0);
+  error(await accion(api, p.id, "unirse", "socio-040"), "PARTIDO_COMPLETO");
+  const salida = await accion(api, p.id, "salir", jugadores[0]);
+  assert.equal(salida.cuerpo.partido.estado, "abierto");
