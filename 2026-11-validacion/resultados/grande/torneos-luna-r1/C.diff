+function instanteLocalMadrid(valor: string): number {
+  const [fecha, hora] = valor.split("T");
+  const [y, m, d] = fecha!.split("-").map(Number);
+  const [hh, mm] = hora!.split(":").map(Number);
+  const UTC = Date.UTC(y!, m! - 1, d!, hh!, mm!);
+  const partes = new Intl.DateTimeFormat("en-GB", {
+    timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit",
+    hour: "2-digit", minute: "2-digit", hourCycle: "h23",
+  }).formatToParts(new Date(UTC));
+  const obtenido = Object.fromEntries(partes.map((p) => [p.type, Number(p.value)]));
+  const horaLocalComoUtc = Date.UTC(obtenido.year, obtenido.month - 1, obtenido.day, obtenido.hour, obtenido.minute);
+  return UTC + (UTC - horaLocalComoUtc);
+}
+
+function horasEntreLocalesMadrid(desde: string, hasta: string): number {
+  return (instanteLocalMadrid(hasta) - instanteLocalMadrid(desde)) / 3_600_000;
+}
+
+function fechaHoraValida(valor: string): boolean {
+  if (!FECHA_HORA.test(valor) || !HORAS.includes(valor.slice(11))) return false;
+  const [fecha, hora] = valor.split("T");
+  const [y, m, d] = fecha!.split("-").map(Number);
+  const [hh, mm] = hora!.split(":").map(Number);
+  const dia = new Date(Date.UTC(y!, m! - 1, d!));
+  return dia.getUTCFullYear() === y && dia.getUTCMonth() === m! - 1 && dia.getUTCDate() === d && hh! >= 0 && hh! <= 23 && mm! >= 0 && mm! <= 59;
+}
