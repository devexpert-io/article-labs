diff --git a/test/partidos.test.ts b/test/partidos.test.ts
new file mode 100644
index 0000000..d5769c8
--- /dev/null
+++ b/test/partidos.test.ts
@@ -0,0 +1,390 @@
+// Partidos abiertos (docs/specs/partidos-abiertos.md), probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+// Jueves 26 de noviembre: no hay reservas en la semilla.
+const JUEVES = "2026-11-26";
+
+/** Arranca una API nueva para cada test, así no se pisan los estados. */
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+/** Socios con la cuota al día, sin rol de gestor y sin reservas futuras en la semilla. */
+async function sociosLibres(api: Api): Promise<string[]> {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  return estado.socios
+    .filter((s: any) => s.cuotaActiva && s.rol === "socio")
+    .filter((s: any) => !estado.reservas.some((r: any) => r.socioId === s.id && r.estado === "confirmada" && r.inicio > estado.ahora))
+    .map((s: any) => s.id);
+}
+
+async function crearPartido(api: Api, socio: string, cuerpo: Record<string, unknown> = {}) {
+  return api.pedir("POST", "/api/partidos", { socio, cuerpo: { pistaId: "pista-1", inicio: `${JUEVES}T19:30`, ...cuerpo } });
+}
+
+async function fijarNivel(api: Api, socio: string, nivel: number | null) {
+  const r = await api.pedir("PATCH", `/api/socios/${socio}`, { socio, cuerpo: { nivel } });
+  assert.equal(r.status, 200);
+}
+
+function error(r: { status: number; cuerpo: any }, status: number, codigo: string) {
+  assert.equal(r.status, status, JSON.stringify(r.cuerpo));
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+test("1. permisos: identificarse para crear, unirse y salir; cancelar y fijar nivel con permiso", () => conApi(async (api) => {
+  const [a, b, c] = await sociosLibres(api);
+  error(await api.pedir("POST", "/api/partidos", { cuerpo: { pistaId: "pista-1", inicio: `${JUEVES}T19:30` } }), 401, "NO_IDENTIFICADO");
+  const creado = await crearPartido(api, a!);
+  const id = creado.cuerpo.partido.id;
+  error(await api.pedir("POST", `/api/partidos/${id}/unirse`), 401, "NO_IDENTIFICADO");
+  error(await api.pedir("POST", `/api/partidos/${id}/salir`), 401, "NO_IDENTIFICADO");
+  error(await api.pedir("POST", `/api/partidos/${id}/cancelar`), 401, "NO_IDENTIFICADO");
+  error(await api.pedir("POST", `/api/partidos/${id}/cancelar`, { socio: b! }), 403, "SIN_PERMISO");
+  error(await api.pedir("PATCH", `/api/socios/${a}`, { cuerpo: { nivel: 3 } }), 401, "NO_IDENTIFICADO");
+  error(await api.pedir("PATCH", `/api/socios/${a}`, { socio: b!, cuerpo: { nivel: 3 } }), 403, "SIN_PERMISO");
+  assert.equal((await api.pedir("PATCH", `/api/socios/${a}`, { socio: GESTOR, cuerpo: { nivel: 3 } })).status, 200);
+  assert.equal((await api.pedir("GET", "/api/partidos")).status, 200);
+  assert.equal((await api.pedir("GET", `/api/partidos/${id}`)).status, 200);
+  // El gestor puede cancelar un partido que no organiza.
+  const otro = await crearPartido(api, c!, { pistaId: "pista-2" });
+  const cancelado = await api.pedir("POST", `/api/partidos/${otro.cuerpo.partido.id}/cancelar`, { socio: GESTOR });
+  assert.equal(cancelado.status, 200);
+  assert.equal(cancelado.cuerpo.partido.estado, "cancelado");
+}));
+
+test("2. nivel de los socios: se fija, se quita y sale al buscar", () => conApi(async (api) => {
+  const semilla = (await api.pedir("GET", "/_estado")).cuerpo.socios;
+  assert.ok(semilla.every((s: any) => s.nivel === null));
+  const fijado = await api.pedir("PATCH", "/api/socios/socio-004", { socio: "socio-004", cuerpo: { nivel: 4.5 } });
+  assert.equal(fijado.status, 200);
+  assert.equal(fijado.cuerpo.socio.id, "socio-004");
+  assert.equal(fijado.cuerpo.socio.nivel, 4.5);
+  const buscado = await api.pedir("GET", "/api/socios?texto=Irene Sanz");
+  assert.equal(buscado.cuerpo.socios.find((s: any) => s.id === "socio-004").nivel, 4.5);
+  for (const nivel of [0.5, 7.5, 3.3, "4", undefined]) {
+    error(await api.pedir("PATCH", "/api/socios/socio-004", { socio: "socio-004", cuerpo: { nivel } }), 400, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("PATCH", "/api/socios/socio-004", { socio: "socio-004", cuerpo: { nivel: 1 } })).cuerpo.socio.nivel, 1);
+  assert.equal((await api.pedir("PATCH", "/api/socios/socio-004", { socio: "socio-004", cuerpo: { nivel: 7 } })).cuerpo.socio.nivel, 7);
+  const quitado = await api.pedir("PATCH", "/api/socios/socio-004", { socio: GESTOR, cuerpo: { nivel: null } });
+  assert.equal(quitado.cuerpo.socio.nivel, null);
+  error(await api.pedir("PATCH", "/api/socios/socio-999", { socio: GESTOR, cuerpo: { nivel: 3 } }), 404, "SOCIO_NO_ENCONTRADO");
+}));
+
+test("3. crear un partido tiene las comprobaciones de una reserva", () => conApi(async (api) => {
+  const [a] = await sociosLibres(api);
+  error(await crearPartido(api, a!, { pistaId: "pista-9" }), 404, "PISTA_NO_ENCONTRADA");
+  error(await crearPartido(api, a!, { inicio: `${JUEVES}T19:00` }), 400, "FRANJA_INVALIDA");
+  error(await crearPartido(api, "socio-022"), 409, "CUOTA_INACTIVA");
+  error(await crearPartido(api, a!, { pistaId: "pista-4" }), 409, "PISTA_CERRADA");
+  error(await crearPartido(api, a!, { inicio: "2026-11-18T09:00" }), 409, "FRANJA_PASADA");
+  // Jueves 19 a las 19:30 la pista 1 está reservada.
+  error(await crearPartido(api, a!, { inicio: "2026-11-19T19:30" }), 409, "FRANJA_NO_DISPONIBLE");
+  error(await crearPartido(api, a!, { pistaId: 7 }), 400, "DATOS_INVALIDOS");
+  // Luis Martín tiene dos reservas futuras: con un partido llega a tres.
+  assert.equal((await crearPartido(api, "socio-005")).status, 201);
+  error(await crearPartido(api, "socio-005", { pistaId: "pista-2" }), 409, "LIMITE_DE_RESERVAS");
+}));
+
+test("4. rango de nivel al crear", () => conApi(async (api) => {
+  const [a] = await sociosLibres(api);
+  error(await crearPartido(api, a!, { nivelMin: 3 }), 400, "DATOS_INVALIDOS");
+  error(await crearPartido(api, a!, { nivelMax: 3 }), 400, "DATOS_INVALIDOS");
+  error(await crearPartido(api, a!, { nivelMin: 3, nivelMax: 8 }), 400, "DATOS_INVALIDOS");
+  error(await crearPartido(api, a!, { nivelMin: 3.2, nivelMax: 4 }), 400, "DATOS_INVALIDOS");
+  error(await crearPartido(api, a!, { nivelMin: 4, nivelMax: 3 }), 400, "DATOS_INVALIDOS");
+  error(await crearPartido(api, a!, { nivelMin: 3, nivelMax: 4 }), 409, "NIVEL_SIN_DEFINIR");
+  await fijarNivel(api, a!, 5);
+  error(await crearPartido(api, a!, { nivelMin: 3, nivelMax: 4.5 }), 409, "NIVEL_FUERA_DE_RANGO");
+  const creado = await crearPartido(api, a!, { nivelMin: 3, nivelMax: 5 });
+  assert.equal(creado.status, 201);
+  assert.equal(creado.cuerpo.partido.nivelMin, 3);
+  assert.equal(creado.cuerpo.partido.nivelMax, 5);
+  const sinRango = await crearPartido(api, a!, { pistaId: "pista-2" });
+  assert.equal(sinRango.cuerpo.partido.nivelMin, null);
+  assert.equal(sinRango.cuerpo.partido.nivelMax, null);
+}));
+
+test("5, 6 y 7. la reserva del partido, la respuesta y el precio por jugador", () => conApi(async (api) => {
+  const [a] = await sociosLibres(api);
+  const creado = await crearPartido(api, a!);
+  assert.equal(creado.status, 201);
+  const p = creado.cuerpo.partido;
+  assert.equal(p.estado, "abierto");
+  assert.equal(p.organizador, a);
+  assert.deepEqual(p.jugadores, [a]);
+  assert.equal(p.plazasLibres, 3);
+  assert.deepEqual(p.penalizaciones, []);
+  assert.equal(p.pistaId, "pista-1");
+  assert.equal(p.inicio, `${JUEVES}T19:30`);
+  assert.equal(p.fin, `${JUEVES}T21:00`);
+  assert.equal(p.importe, 2800);
+  assert.equal(p.importePorJugador, 700);
+  assert.equal(p.importePorJugador, Math.ceil(p.importe / 4));
+  assert.equal(p.motivo, undefined);
+
+  const reservas = await api.pedir("GET", `/api/reservas?fecha=${JUEVES}&socio=${a}`);
+  assert.equal(reservas.cuerpo.total, 1);
+  const r = reservas.cuerpo.reservas[0];
+  assert.equal(r.id, p.reservaId);
+  assert.equal(r.estado, "confirmada");
+  assert.equal(r.importe, 2800);
+  assert.equal(r.partidoId, p.id);
+  const dispo = await api.pedir("GET", `/api/disponibilidad?fecha=${JUEVES}&pista=pista-1`);
+  assert.equal(dispo.cuerpo.pistas[0].franjas.find((f: any) => f.inicio === p.inicio).estado, "reservada");
+
+  const consultado = await api.pedir("GET", `/api/partidos/${p.id}`);
+  assert.deepEqual(consultado.cuerpo.partido, p);
+  error(await api.pedir("GET", "/api/partidos/P-9999"), 404, "PARTIDO_NO_ENCONTRADO");
+  error(await api.pedir("POST", "/api/partidos/P-9999/unirse", { socio: a! }), 404, "PARTIDO_NO_ENCONTRADO");
+  error(await api.pedir("POST", "/api/partidos/P-9999/salir", { socio: a! }), 404, "PARTIDO_NO_ENCONTRADO");
+  error(await api.pedir("POST", "/api/partidos/P-9999/cancelar", { socio: a! }), 404, "PARTIDO_NO_ENCONTRADO");
+}));
+
+test("8 y 9. unirse hasta completar y quién no se puede unir", () => conApi(async (api) => {
+  const [a, b, c, d, e] = await sociosLibres(api);
+  const id = (await crearPartido(api, a!)).cuerpo.partido.id;
+  const unirse = (socio: string) => api.pedir("POST", `/api/partidos/${id}/unirse`, { socio });
+  const uno = await unirse(b!);
+  assert.equal(uno.status, 200);
+  assert.deepEqual(uno.cuerpo.partido.jugadores, [a, b]);
+  assert.equal(uno.cuerpo.partido.plazasLibres, 2);
+  assert.equal(uno.cuerpo.partido.estado, "abierto");
+  error(await unirse(b!), 409, "YA_APUNTADO");
+  error(await unirse(a!), 409, "YA_APUNTADO");
+  error(await unirse("socio-022"), 409, "CUOTA_INACTIVA");
+  await unirse(c!);
+  const lleno = await unirse(d!);
+  assert.deepEqual(lleno.cuerpo.partido.jugadores, [a, b, c, d]);
+  assert.equal(lleno.cuerpo.partido.plazasLibres, 0);
+  assert.equal(lleno.cuerpo.partido.estado, "completo");
+  error(await unirse(e!), 409, "PARTIDO_COMPLETO");
+
+  const otro = (await crearPartido(api, e!, { pistaId: "pista-2" })).cuerpo.partido.id;
+  await api.pedir("POST", `/api/partidos/${otro}/cancelar`, { socio: e! });
+  error(await api.pedir("POST", `/api/partidos/${otro}/unirse`, { socio: b! }), 409, "PARTIDO_CANCELADO");
+}));
+
+test("10. nivel al unirse, con los extremos incluidos", () => conApi(async (api) => {
+  const [a, b, c, d, e] = await sociosLibres(api);
+  await fijarNivel(api, a!, 4);
+  const id = (await crearPartido(api, a!, { nivelMin: 3.5, nivelMax: 4.5 })).cuerpo.partido.id;
+  const unirse = (socio: string) => api.pedir("POST", `/api/partidos/${id}/unirse`, { socio });
+  error(await unirse(b!), 409, "NIVEL_SIN_DEFINIR");
+  await fijarNivel(api, b!, 3);
+  error(await unirse(b!), 409, "NIVEL_FUERA_DE_RANGO");
+  await fijarNivel(api, b!, 5);
+  error(await unirse(b!), 409, "NIVEL_FUERA_DE_RANGO");
+  await fijarNivel(api, c!, 3.5);
+  await fijarNivel(api, d!, 4.5);
+  assert.equal((await unirse(c!)).status, 200);
