+    },
+
+    cancelarPartido(id: string, datos: { forzar?: unknown }, quien: Socio | undefined) {
+      const q = identificado(quien);
+      const pt = partido(id);
+      if (q.id !== pt.organizador && q.rol !== "gestor") sinPermiso();
+      if (datos.forzar !== undefined && typeof datos.forzar !== "boolean") invalido("forzar debe ser true o false");
+      if (pt.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido ya está cancelado");
+      if (pt.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      const r = reserva(pt.reservaId);
+      const horas = horasEntre(estado.ahora, pt.inicio);
+      if (horas < HORAS_CANCELACION_GRATUITA) {
+        if (datos.forzar !== true) {
+          throw new ErrorDelClub(
+            "FUERA_DE_PLAZO",
+            `Faltan ${Math.floor(horas)} horas para el partido y la cancelación gratuita termina ${HORAS_CANCELACION_GRATUITA} horas antes. ` +
+            "Con forzar se cancela con una penalización del 100 % del importe: solo si el organizador la ha aceptado expresamente.",
+          );
+        }
+        r.penalizacion = r.importe;
+      }
+      r.estado = "cancelada";
+      r.motivoCancelacion = "Partido abierto cancelado";
+      pt.estado = "cancelado";
+      pt.motivo = "organizador";
+      return { partido: pt };
+    },
   };
 }
 
