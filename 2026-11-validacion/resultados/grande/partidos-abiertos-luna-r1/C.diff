+test("límite combinado: reservar, crear y unirse cuentan reservas y partidos", async () => {
+  const otra = await arrancarApi();
+  const pedir = otra.pedir;
+  const reserva = (socio: string, inicio: string, pistaId: string) => pedir("POST", "/api/reservas", { cuerpo: { socioId: socio, pistaId, inicio } });
+  const crear = (socio: string, inicio: string, pistaId: string) => pedir("POST", "/api/partidos", { socio, cuerpo: { pistaId, inicio } });
+  try {
+    // Nora empieza sin reservas: dos reservas y unirse a un partido alcanzan el límite.
+    await reserva("socio-041", "2026-11-25T12:00", "pista-1");
+    await reserva("socio-041", "2026-11-26T12:00", "pista-1");
+    const partido = (await crear("socio-003", "2026-11-25T16:30", "pista-1")).cuerpo.partido;
+    const unido = await pedir("POST", `/api/partidos/${partido.id}/unirse`, { socio: "socio-041" });
+    assert.equal(unido.status, 200);
+    assert.ok(unido.cuerpo.partido.jugadores.includes("socio-041"));
+    const bloqueada = await reserva("socio-041", "2026-11-27T12:00", "pista-1");
+    assert.equal(bloqueada.status, 409);
+    assert.equal(bloqueada.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+    const crearBloqueado = await crear("socio-041", "2026-11-27T16:30", "pista-1");
+    assert.equal(crearBloqueado.status, 409);
+    assert.equal(crearBloqueado.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+
+    // Luis ya tiene dos reservas semilla; las plazas en partidos también completan el límite.
+    const p1 = (await crear("socio-002", "2026-11-28T12:00", "pista-1")).cuerpo.partido;
+    const p2 = (await crear("socio-004", "2026-11-28T12:00", "pista-2")).cuerpo.partido;
+    const join1 = await pedir("POST", `/api/partidos/${p1.id}/unirse`, { socio: "socio-005" });
+    assert.equal(join1.status, 200);
+    const join2 = await pedir("POST", `/api/partidos/${p2.id}/unirse`, { socio: "socio-005" });
+    assert.equal(join2.status, 409);
+    assert.equal(join2.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+  } finally { otra.cerrar(); }
+});
