+test("partidos abiertos: reserva, plazas, niveles y cancelación automática", async () => {
+  const organizador = await api.pedir("POST", "/api/partidos", { socio: "socio-041", cuerpo: { pistaId: "pista-2", inicio: "2026-11-24T12:00" } });
+  assert.equal(organizador.status, 201);
+  const partido = organizador.cuerpo.partido;
+  assert.equal(partido.plazasLibres, 3);
+  assert.equal(partido.importePorJugador, 450);
+  assert.equal((await api.pedir("GET", `/api/reservas/${partido.reservaId}`)).cuerpo.reserva.partidoId, partido.id);
+  const unido = await api.pedir("POST", `/api/partidos/${partido.id}/unirse`, { socio: "socio-003" });
+  assert.equal(unido.cuerpo.partido.jugadores[1], "socio-003");
+  assert.equal(unido.cuerpo.partido.plazasLibres, 2);
+  const salio = await api.pedir("POST", `/api/partidos/${partido.id}/salir`, { socio: "socio-003" });
+  assert.equal(salio.cuerpo.partido.plazasLibres, 3);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-24T06:00" } });
+  const cancelado = await api.pedir("GET", `/api/partidos/${partido.id}`);
+  assert.equal(cancelado.cuerpo.partido.estado, "cancelado");
+  assert.equal(cancelado.cuerpo.partido.motivo, "incompleto");
+  assert.equal((await api.pedir("GET", `/api/reservas/${partido.reservaId}`)).cuerpo.reserva.estado, "cancelada");
+});
