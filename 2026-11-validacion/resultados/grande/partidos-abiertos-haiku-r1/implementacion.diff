diff --git a/test/partidos.test.ts b/test/partidos.test.ts
new file mode 100644
index 0000000..015b46a
--- /dev/null
+++ b/test/partidos.test.ts
@@ -0,0 +1,457 @@
+// Los partidos abiertos, probados a través de la API. Cada test arranca su propia API para partir de la semilla.
+// Semilla: el club está el 18 de noviembre a las 10:00. Del 25 de noviembre en adelante no hay reservas.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const ORGANIZADOR = "socio-030";
+const ORGANIZADOR_2 = "socio-031";
+const JUGADOR = "socio-001";
+const GESTOR = "socio-040";
+const NORA = "socio-041";
+const SIN_CUOTA = "socio-022";
+const JORNADA_19 = "2026-11-19T19:30"; // pistas 2 y 3 libres por diseño de la semilla
+
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const crear = (api: Api, socio: string | undefined, pistaId: string, inicio: string, extra: Record<string, unknown> = {}) =>
+  api.pedir("POST", "/api/partidos", { socio, cuerpo: { pistaId, inicio, ...extra } });
+const unirse = (api: Api, id: string, socio?: string) => api.pedir("POST", `/api/partidos/${id}/unirse`, { socio });
+const salir = (api: Api, id: string, socio?: string, cuerpo?: unknown) =>
+  api.pedir("POST", `/api/partidos/${id}/salir`, { socio, cuerpo: cuerpo ?? {} });
+const cancelar = (api: Api, id: string, socio?: string, cuerpo?: unknown) =>
+  api.pedir("POST", `/api/partidos/${id}/cancelar`, { socio, cuerpo: cuerpo ?? {} });
+const obtener = (api: Api, id: string) => api.pedir("GET", `/api/partidos/${id}`);
+const reloj = (api: Api, ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+const nivelar = (api: Api, socioId: string, quien: string, nivel: unknown) =>
+  api.pedir("PATCH", `/api/socios/${socioId}`, { socio: quien, cuerpo: { nivel } });
+const disponibilidad = async (api: Api, fecha: string, pista: string) => {
+  const r = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pista}`);
+  return r.cuerpo.pistas[0].franjas;
+};
+
+async function llenar(api: Api, id: string, socios: string[]) {
+  for (const socio of socios) assert.equal((await unirse(api, id, socio)).status, 200);
+}
+
+test("permisos: crear, unirse, salir y cancelar piden X-Socio; consultar no", async () => {
+  await conApi(async (api) => {
+    const sinSocio = await api.pedir("POST", "/api/partidos", { cuerpo: { pistaId: "pista-2", inicio: JORNADA_19 } });
+    assert.equal(sinSocio.status, 401);
+    assert.equal(sinSocio.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const id = (await crear(api, ORGANIZADOR, "pista-2", JORNADA_19)).cuerpo.partido.id;
+    for (const r of [await unirse(api, id), await salir(api, id), await cancelar(api, id)]) {
+      assert.equal(r.status, 401);
+      assert.equal(r.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    }
+    assert.equal((await api.pedir("GET", "/api/partidos")).status, 200);
+    assert.equal((await obtener(api, id)).status, 200);
+  });
+});
+
+test("cancelar lo puede hacer el organizador o un gestor; el nivel, el propio socio o un gestor", async () => {
+  await conApi(async (api) => {
+    const id = (await crear(api, ORGANIZADOR, "pista-2", JORNADA_19)).cuerpo.partido.id;
+    const ajeno = await cancelar(api, id, ORGANIZADOR_2);
+    assert.equal(ajeno.status, 403);
+    assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+    assert.equal((await nivelar(api, ORGANIZADOR, ORGANIZADOR_2, 3)).cuerpo.error.codigo, "SIN_PERMISO");
+    assert.equal((await nivelar(api, ORGANIZADOR, ORGANIZADOR, 3)).status, 200, "el propio socio");
+    assert.equal((await nivelar(api, ORGANIZADOR, GESTOR, 4)).status, 200, "un gestor");
+    assert.equal((await api.pedir("PATCH", `/api/socios/${ORGANIZADOR}`, { cuerpo: { nivel: 3 } })).status, 401);
+    assert.equal((await cancelar(api, id, GESTOR)).status, 200, "el gestor cancela cualquier partido");
+  });
+});
+
+test("el nivel de un socio va de 1 a 7 en pasos de 0,5, o null, y sale en los socios", async () => {
+  await conApi(async (api) => {
+    const buscado = await api.pedir("GET", "/api/socios?texto=Nora");
+    assert.ok("nivel" in buscado.cuerpo.socios[0]);
+    assert.equal(buscado.cuerpo.socios[0].nivel, null, "en la semilla, todos empiezan sin nivel");
+    const bien = await nivelar(api, NORA, NORA, 4.5);
+    assert.equal(bien.status, 200);
+    assert.equal(bien.cuerpo.socio.nivel, 4.5);
+    assert.equal((await nivelar(api, NORA, NORA, 1)).status, 200);
+    assert.equal((await nivelar(api, NORA, NORA, 7)).status, 200);
+    assert.equal((await nivelar(api, NORA, NORA, null)).cuerpo.socio.nivel, null);
+    for (const malo of [3.25, 0.5, 7.5, 0, 8, "3", undefined]) {
+      const r = await nivelar(api, NORA, NORA, malo);
+      assert.equal(r.status, 400, `nivel ${JSON.stringify(malo)}`);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    const noExiste = await api.pedir("PATCH", "/api/socios/socio-999", { socio: GESTOR, cuerpo: { nivel: 3 } });
+    assert.equal(noExiste.status, 404);
+    assert.equal(noExiste.cuerpo.error.codigo, "SOCIO_NO_ENCONTRADO");
+  });
+});
+
+test("crear un partido reserva la pista y deja tres plazas libres", async () => {
+  await conApi(async (api) => {
+    const r = await crear(api, ORGANIZADOR, "pista-2", JORNADA_19);
+    assert.equal(r.status, 201);
+    const { partido } = r.cuerpo;
+    assert.equal(partido.estado, "abierto");
+    assert.deepEqual(partido.jugadores, [ORGANIZADOR]);
+    assert.equal(partido.organizador, ORGANIZADOR);
+    assert.equal(partido.plazasLibres, 3);
+    assert.deepEqual(partido.penalizaciones, []);
+    assert.equal(partido.nivelMin, null);
+    assert.equal(partido.nivelMax, null);
+    assert.equal(partido.pistaId, "pista-2");
+    assert.equal(partido.inicio, JORNADA_19);
+    assert.equal(partido.fin, "2026-11-19T21:00");
+    // Jueves a las 19:30 es punta: pista 2 a 2800 céntimos, y un cuarto redondeado hacia arriba.
+    assert.equal(partido.importe, 2800);
+    assert.equal(partido.importePorJugador, 700);
+
+    const reserva = (await api.pedir("GET", `/api/reservas/${partido.reservaId}`)).cuerpo.reserva;
+    assert.equal(reserva.socioId, ORGANIZADOR);
+    assert.equal(reserva.estado, "confirmada");
