+        if (socio.nivel < nivelMin || socio.nivel > nivelMax) {
+          throw new ErrorDelClub("NIVEL_FUERA_DE_RANGO", `El nivel de ${socio.nombre} está fuera del rango del partido`);
+        }
+      }
+
+      const id = `P-${String(estado.partidos.length + 1).padStart(4, "0")}`;
+      const reservaDelPartido = insertarReserva(socio, p, inicio, "", id);
+      const nuevo: Partido = {
+        id,
+        reservaId: reservaDelPartido.id,
+        pistaId: p.id,
+        inicio,
+        fin: reservaDelPartido.fin,
+        organizador: socio.id,
+        jugadores: [socio.id],
+        plazasLibres: PLAZAS_PARTIDO - 1,
+        nivelMin,
+        nivelMax,
+        estado: "abierto",
+        importe: reservaDelPartido.importe,
+        importePorJugador: Math.ceil(reservaDelPartido.importe / PLAZAS_PARTIDO),
+        penalizaciones: [],
+      };
+      estado.partidos.push(nuevo);
+      return { partido: nuevo };
+    },
+
+    listarPartidos(f: FiltrosPartidos) {
+      if (f.fecha !== undefined && !fechaValida(f.fecha)) invalido("fecha debe tener el formato AAAA-MM-DD y ser una fecha real");
+      if (f.nivel !== undefined && !nivelValido(f.nivel)) {
+        invalido(`nivel debe ser un número de ${NIVEL_MINIMO} a ${NIVEL_MAXIMO} en pasos de 0,5`);
+      }
+      const partidos = estado.partidos
+        .filter((p) =>
+          p.estado === "abierto" &&
+          p.inicio > estado.ahora &&
+          (!f.fecha || p.inicio.slice(0, 10) === f.fecha) &&
+          (f.nivel === undefined || admiteNivel(p, f.nivel)))
+        .sort((a, b) => (a.inicio === b.inicio ? a.id.localeCompare(b.id) : a.inicio.localeCompare(b.inicio)));
+      return { partidos };
+    },
+
+    obtenerPartido(id: string) {
+      return { partido: partido(id) };
+    },
+
+    unirse(quienId: string | undefined, id: string) {
+      const socio = socioConId(quienId);
+      const p = partido(id);
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.estado === "completo") throw new ErrorDelClub("PARTIDO_COMPLETO", "El partido ya no tiene plazas libres");
+      if (p.jugadores.includes(socio.id)) throw new ErrorDelClub("YA_APUNTADO", `${socio.nombre} ya juega en este partido`);
+      if (!socio.cuotaActiva) throw new ErrorDelClub("CUOTA_INACTIVA", `${socio.nombre} no tiene la cuota al día`);
+      if (p.nivelMin !== null && p.nivelMax !== null) {
+        if (socio.nivel === null) throw new ErrorDelClub("NIVEL_SIN_DEFINIR", `${socio.nombre} no tiene nivel fijado`);
+        if (socio.nivel < p.nivelMin || socio.nivel > p.nivelMax) {
+          throw new ErrorDelClub("NIVEL_FUERA_DE_RANGO", `El nivel de ${socio.nombre} está fuera del rango del partido`);
+        }
+      }
+      if (futurasDe(socio.id) >= MAXIMO_RESERVAS_FUTURAS) {
+        throw new ErrorDelClub("LIMITE_DE_RESERVAS", `${socio.nombre} ya tiene ${MAXIMO_RESERVAS_FUTURAS} reservas futuras`);
+      }
+      p.jugadores.push(socio.id);
+      p.plazasLibres -= 1;
+      if (p.plazasLibres === 0) p.estado = "completo";
+      return { partido: p };
+    },
+
+    salir(quienId: string | undefined, id: string, datos: { forzar?: unknown }) {
+      const socio = socioConId(quienId);
+      const p = partido(id);
+      const forzar = forzarValido(datos.forzar);
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      if (!p.jugadores.includes(socio.id)) throw new ErrorDelClub("NO_APUNTADO", `${socio.nombre} no juega en este partido`);
+      if (p.organizador === socio.id) {
+        throw new ErrorDelClub("ORGANIZADOR_NO_PUEDE_SALIR", "El organizador no puede salir de su partido: tiene que cancelarlo");
+      }
+      const tarde = horasHasta(p.inicio) < HORAS_CANCELACION_GRATUITA;
+      if (tarde && !forzar) {
+        throw new ErrorDelClub(
+          "FUERA_DE_PLAZO",
+          `Faltan menos de ${HORAS_CANCELACION_GRATUITA} horas para el partido. Con forzar se sale con una penalización de tu parte del importe.`,
+        );
+      }
+      p.jugadores = p.jugadores.filter((j) => j !== socio.id);
+      p.plazasLibres += 1;
+      if (p.estado === "completo") p.estado = "abierto";
+      if (tarde) p.penalizaciones.push({ socioId: socio.id, importe: p.importePorJugador });
+      sincronizar();
+      return { partido: p };
+    },
+
+    cancelarPartido(quienId: string | undefined, id: string, datos: { forzar?: unknown }) {
+      const socio = socioConId(quienId);
+      const p = partido(id);
+      const forzar = forzarValido(datos.forzar);
+      if (socio.id !== p.organizador && socio.rol !== "gestor") {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo el organizador o un gestor puede cancelar el partido", 403);
+      }
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido ya estaba cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      const tarde = horasHasta(p.inicio) < HORAS_CANCELACION_GRATUITA;
+      if (tarde && !forzar) {
+        throw new ErrorDelClub(
+          "FUERA_DE_PLAZO",
+          `Faltan menos de ${HORAS_CANCELACION_GRATUITA} horas para el partido. Con forzar se cancela con una penalización del 100 % del importe.`,
+        );
+      }
+      cerrarPartido(p, "organizador", tarde);
+      return { partido: p };
+    },
   };
 }
 
