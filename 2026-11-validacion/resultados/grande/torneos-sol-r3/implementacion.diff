+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+async function obtener(api: Api, id: string): Promise<Torneo> {
+  return (await api.pedir("GET", `/api/torneos/${id}`)).cuerpo.torneo;
+}
+async function resultado(api: Api, id: string, partidoId: string, ganadora: unknown, marcador?: unknown) {
+  return api.pedir("POST", `/api/torneos/${id}/partidos/${partidoId}/resultado`, { socio: gestor, cuerpo: { ganadora, marcador } });
