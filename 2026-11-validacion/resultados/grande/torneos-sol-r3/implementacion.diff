+  return api.pedir("POST", `/api/torneos/${id}/inscripciones`, { socio: gestor, cuerpo: { socios } });
+}
+async function parejas(api: Api, id: string, cantidad: number) {
+  const socios = (await api.pedir("GET", "/_estado")).cuerpo.socios
+    .filter((s: any) => s.cuotaActiva).map((s: any) => s.id);
+  const ids: string[] = [];
+  for (let i = 0; i < cantidad; i++) {
+    const r = await inscribir(api, id, socios.slice(i * 2, i * 2 + 2));
+    assert.equal(r.status, 201, r.texto);
+    ids.push(r.cuerpo.inscripcion.id);
+  }
+  return ids;
+}
