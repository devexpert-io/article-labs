+  const cerrado: Torneo = (await cerrar(api, torneo.id)).cuerpo.torneo;
+  const [descanso, , , cuarto, semi1, semi2, final] = cerrado.partidos;
+  error(await resultado(api, torneo.id, "no", ids[0]), 404, "PARTIDO_NO_ENCONTRADO");
+  error(await resultado(api, torneo.id, descanso.id, ids[0]), 409, "PARTIDO_NO_LISTO");
+  error(await resultado(api, torneo.id, semi1.id, ids[0]), 409, "PARTIDO_NO_LISTO");
+  error(await resultado(api, torneo.id, cuarto.id, ids[3]), 409, "PARTIDO_NO_EMPEZADO");
+  await reloj(api, cuarto.inicio!);
+  for (const [ganadora, marcador] of [[ids[0], undefined], [null, undefined], [ids[3], 42]]) {
+    error(await resultado(api, torneo.id, cuarto.id, ganadora, marcador), 400, "DATOS_INVALIDOS");
+  }
+  const jugado = await resultado(api, torneo.id, cuarto.id, ids[3], "6-4 6-3");
+  assert.equal(jugado.cuerpo.partido.estado, "jugado");
+  assert.equal(jugado.cuerpo.partido.marcador, "6-4 6-3");
+  assert.deepEqual((await obtener(api, torneo.id)).partidos[4].parejas, [ids[0], ids[3]]);
+  assert.equal((await resultado(api, torneo.id, cuarto.id, ids[4])).cuerpo.partido.marcador, null);
+  assert.deepEqual((await obtener(api, torneo.id)).partidos[4].parejas, [ids[0], ids[4]]);
+  await resultado(api, torneo.id, semi2.id, ids[2]);
+  assert.deepEqual((await obtener(api, torneo.id)).partidos[6].parejas, [null, ids[2]]);
+  error(await resultado(api, torneo.id, semi1.id, ids[0]), 409, "PARTIDO_NO_EMPEZADO");
+  await reloj(api, semi1.inicio!);
+  await resultado(api, torneo.id, semi1.id, ids[4]);
+  const antes = await obtener(api, torneo.id);
+  error(await resultado(api, torneo.id, cuarto.id, ids[3]), 409, "RESULTADO_CERRADO");
