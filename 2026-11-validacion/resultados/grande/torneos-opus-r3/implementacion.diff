+// Torneos de parejas por eliminación directa (docs/specs/torneos.md), probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const DIA = "2026-11-28"; // sábado, sin reservas en la semilla
+const f = (hora: string, dia = DIA) => `${dia}T${hora}`;
+
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function datosTorneo(extra: Record<string, unknown> = {}) {
+  return { nombre: "Open de invierno", pistas: ["pista-1", "pista-2"], franjas: [f("09:00"), f("10:30"), f("12:00"), f("13:30")], plazas: 8, cuota: 3000, ...extra };
+}
+
+async function crear(api: Api, extra: Record<string, unknown> = {}) {
+  const r = await api.pedir("POST", "/api/torneos", { socio: GESTOR, cuerpo: datosTorneo(extra) });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.torneo;
+}
+
+async function inscribir(api: Api, torneoId: string, socios: [string, string], socio = GESTOR) {
+  return api.pedir("POST", `/api/torneos/${torneoId}/inscripciones`, { socio, cuerpo: { socios } });
+}
+
+/** Socios con la cuota al día, por parejas. */
+const PAREJAS: [string, string][] = [
+  ["socio-001", "socio-002"], ["socio-003", "socio-004"], ["socio-005", "socio-006"], ["socio-007", "socio-008"],
+  ["socio-009", "socio-010"], ["socio-012", "socio-013"], ["socio-014", "socio-015"], ["socio-016", "socio-017"],
+];
+
+async function torneoCon(api: Api, parejas: number, extra: Record<string, unknown> = {}) {
+  const t = await crear(api, extra);
+  const ids: string[] = [];
+  for (let i = 0; i < parejas; i++) ids.push((await inscribir(api, t.id, PAREJAS[i]!)).cuerpo.inscripcion.id);
+  return { id: t.id as string, ids };
+}
+
+const reloj = (api: Api, ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+const resultado = (api: Api, torneoId: string, partidoId: string, cuerpo: unknown, socio = GESTOR) =>
+  api.pedir("POST", `/api/torneos/${torneoId}/partidos/${partidoId}/resultado`, { socio, cuerpo });
+const verTorneo = async (api: Api, id: string) => (await api.pedir("GET", `/api/torneos/${id}`)).cuerpo.torneo;
+const partido = (t: any, ronda: number, numero: number) => t.partidos.find((p: any) => p.ronda === ronda && p.numero === numero);
+const franjaDe = async (api: Api, pistaId: string, inicio: string) => {
+  const d = await api.pedir("GET", `/api/disponibilidad?fecha=${inicio.slice(0, 10)}&pista=${pistaId}`);
+  return d.cuerpo.pistas[0].franjas.find((x: any) => x.inicio === inicio);
+};
+
+test("permisos: gestionar es de gestores, inscribirse de la pareja o un gestor y consultar es libre", () => conApi(async (api) => {
+  const sin = await api.pedir("POST", "/api/torneos", { cuerpo: datosTorneo() });
+  assert.equal(sin.status, 401);
+  assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("POST", "/api/torneos", { socio: "socio-001", cuerpo: datosTorneo() });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const t = await crear(api);
+
+  assert.equal((await api.pedir("GET", "/api/torneos")).status, 200);
+  assert.equal((await api.pedir("GET", `/api/torneos/${t.id}`)).status, 200);
+
+  const inscSin = await api.pedir("POST", `/api/torneos/${t.id}/inscripciones`, { cuerpo: { socios: PAREJAS[0] } });
+  assert.equal(inscSin.status, 401);
+  const ajeno = await inscribir(api, t.id, PAREJAS[0]!, "socio-003");
+  assert.equal(ajeno.status, 403);
+  assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+  const propia = await inscribir(api, t.id, PAREJAS[0]!, "socio-002");
+  assert.equal(propia.status, 201);
+  const delGestor = await inscribir(api, t.id, PAREJAS[1]!);
+  assert.equal(delGestor.status, 201);
+
+  const bajaRuta = (id: string) => `/api/torneos/${t.id}/inscripciones/${id}/baja`;
+  assert.equal((await api.pedir("POST", bajaRuta(propia.cuerpo.inscripcion.id))).status, 401);
+  const bajaAjena = await api.pedir("POST", bajaRuta(propia.cuerpo.inscripcion.id), { socio: "socio-003" });
+  assert.equal(bajaAjena.status, 403);
+  assert.equal((await api.pedir("POST", bajaRuta(propia.cuerpo.inscripcion.id), { socio: "socio-001" })).status, 200);
+  assert.equal((await api.pedir("POST", bajaRuta(delGestor.cuerpo.inscripcion.id), { socio: GESTOR })).status, 200);
+
+  for (const ruta of [`/api/torneos/${t.id}/cerrar`, `/api/torneos/${t.id}/cancelar`, `/api/torneos/${t.id}/partidos/x/resultado`]) {
+    assert.equal((await api.pedir("POST", ruta)).status, 401, ruta);
+    const r = await api.pedir("POST", ruta, { socio: "socio-001", cuerpo: {} });
+    assert.equal(r.status, 403, ruta);
+    assert.equal(r.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+}));
+
+test("datos del torneo: se validan y no se crea nada si no valen", () => conApi(async (api) => {
+  const casos: [Record<string, unknown>, number, string][] = [
+    [{ nombre: "" }, 400, "DATOS_INVALIDOS"],
+    [{ nombre: "   " }, 400, "DATOS_INVALIDOS"],
+    [{ nombre: 7 }, 400, "DATOS_INVALIDOS"],
+    [{ pistas: [] }, 400, "DATOS_INVALIDOS"],
+    [{ pistas: ["pista-1", "pista-1"] }, 400, "DATOS_INVALIDOS"],
+    [{ pistas: "pista-1" }, 400, "DATOS_INVALIDOS"],
+    [{ franjas: [] }, 400, "DATOS_INVALIDOS"],
+    [{ franjas: [f("09:00"), f("09:00")] }, 400, "DATOS_INVALIDOS"],
+    [{ plazas: 3 }, 400, "DATOS_INVALIDOS"],
+    [{ plazas: 17 }, 400, "DATOS_INVALIDOS"],
+    [{ plazas: 4.5 }, 400, "DATOS_INVALIDOS"],
+    [{ cuota: -1 }, 400, "DATOS_INVALIDOS"],
+    [{ cuota: 10.5 }, 400, "DATOS_INVALIDOS"],
+    [{ cuota: "3000" }, 400, "DATOS_INVALIDOS"],
+    [{ pistas: ["pista-1", "pista-9"] }, 404, "PISTA_NO_ENCONTRADA"],
+    [{ franjas: [f("09:15")] }, 400, "FRANJA_INVALIDA"],
+    [{ franjas: ["28/11/2026 09:00"] }, 400, "FRANJA_INVALIDA"],
+    [{ franjas: [f("09:00", "2026-11-18")] }, 409, "FRANJA_PASADA"],
+    [{ franjas: [f("10:00", "2026-11-18").replace("10:00", "09:00")] }, 409, "FRANJA_PASADA"],
+  ];
+  for (const [extra, status, codigo] of casos) {
+    const r = await api.pedir("POST", "/api/torneos", { socio: GESTOR, cuerpo: datosTorneo(extra) });
+    assert.equal(r.status, status, JSON.stringify(extra));
+    assert.equal(r.cuerpo.error.codigo, codigo, JSON.stringify(extra));
+  }
+  assert.equal((await crear(api, { plazas: 4, cuota: 0 })).plazas, 4);
+  assert.equal((await crear(api, { plazas: 16, franjas: [f("15:00")] })).plazas, 16);
+  assert.equal((await api.pedir("GET", "/api/torneos")).cuerpo.torneos.length, 2);
+}));
+
+test("pistas libres: pista cerrada o franjas ocupadas por reservas u otros torneos", () => conApi(async (api) => {
+  const cerrada = await api.pedir("POST", "/api/torneos", { socio: GESTOR, cuerpo: datosTorneo({ pistas: ["pista-1", "pista-4"] }) });
+  assert.equal(cerrada.status, 409);
+  assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
