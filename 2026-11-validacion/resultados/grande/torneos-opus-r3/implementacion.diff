+  assert.deepEqual(t.partidos.map((x: any) => [x.ronda, x.numero, x.parejas, x.pistaId, x.inicio]), [[1, 1, [ids[0], ids[1]], "pista-1", f("09:00")]]);
+  await reloj(api, f("09:30"));
+  await resultado(api, id, t.partidos[0].id, { ganadora: ids[1] });
+  const fin = await verTorneo(api, id);
