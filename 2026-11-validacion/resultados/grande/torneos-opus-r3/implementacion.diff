+      if (!i) throw new ErrorDelClub("INSCRIPCION_NO_ENCONTRADA", `No existe la inscripción ${inscripcionId} en el torneo ${t.id}`, 404);
+      if (quien.rol !== "gestor" && !i.socios.includes(quien.id)) sinPermiso("Solo uno de los dos socios de la pareja o un gestor puede darla de baja");
+      comprobarPlazo(t);
+      if (i.estado === "baja") throw new ErrorDelClub("YA_DE_BAJA", "La inscripción ya estaba de baja");
+      i.estado = "baja";
+      return { inscripcion: i };
+    },
+
+    cerrarTorneo(quien: Socio | undefined, torneoId: string) {
+      requerirGestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado !== "inscripcion") throw new ErrorDelClub("TORNEO_NO_EN_INSCRIPCION", "El torneo no está en inscripción");
+      const parejas = inscritas(t).map((i) => i.id);
+      if (parejas.length < 2) throw new ErrorDelClub("PAREJAS_INSUFICIENTES", "Hacen falta 2 parejas inscritas o más");
+
+      // Cuadro: T plazas, la menor potencia de 2 que llega al número de parejas.
+      let plazasCuadro = 2;
+      while (plazasCuadro < parejas.length) plazasCuadro *= 2;
+      const rondas: Partido[][] = [];
+      let n = 0;
+      const partido = (ronda: number, numero: number, parejasPartido: [string | null, string | null]): Partido => {
+        n += 1;
+        return {
+          id: `${t.id}-P${String(n).padStart(2, "0")}`,
+          ronda,
+          numero,
+          parejas: parejasPartido,
+          estado: "pendiente",
+          ganadora: null,
+          marcador: null,
+          pistaId: null,
+          inicio: null,
+        };
+      };
+      const primera: Partido[] = [];
+      for (let i = 1; i <= plazasCuadro / 2; i++) {
+        const rival = parejas[plazasCuadro - i] ?? null;
+        const p = partido(1, i, [parejas[i - 1]!, rival]);
+        if (rival === null) {
+          p.estado = "descanso";
+          p.ganadora = p.parejas[0];
+        }
+        primera.push(p);
+      }
+      rondas.push(primera);
+      while (rondas.at(-1)!.length > 1) {
+        const anterior = rondas.at(-1)!;
+        const m = anterior.length;
+        const ronda: Partido[] = [];
+        for (let j = 1; j <= m / 2; j++) {
+          ronda.push(partido(rondas.length + 1, j, [anterior[j - 1]!.ganadora, anterior[m - j]!.ganadora]));
+        }
+        rondas.push(ronda);
+      }
+
+      // Calendario: combinaciones de franja y pista que no han empezado, por franja y, en cada franja, por pista.
+      const huecos = t.franjas.filter((f) => f > estado.ahora).flatMap((inicio) => t.pistas.map((pistaId) => ({ pistaId, inicio })));
+      const usados = new Set<number>();
+      for (let r = 0; r < rondas.length; r++) {
+        for (const p of rondas[r]!) {
+          if (p.estado === "descanso") continue;
+          let desde = "";
+          if (r > 0) {
+            const anterior = rondas[r - 1]!;
+            for (const origen of [anterior[p.numero - 1]!, anterior[anterior.length - p.numero]!]) {
+              if (origen.inicio && finDeFranja(origen.inicio) > desde) desde = finDeFranja(origen.inicio);
+            }
+          }
+          const indice = huecos.findIndex((h, k) => !usados.has(k) && h.inicio >= desde);
+          if (indice === -1) {
+            throw new ErrorDelClub("FRANJAS_INSUFICIENTES", "No hay franjas y pistas suficientes para todos los partidos del cuadro");
+          }
+          usados.add(indice);
+          p.pistaId = huecos[indice]!.pistaId;
+          p.inicio = huecos[indice]!.inicio;
+        }
+      }
+      t.partidos = rondas.flat();
+      t.estado = "en_juego";
+      return { torneo: t };
+    },
+
+    apuntarResultado(quien: Socio | undefined, torneoId: string, partidoId: string, datos: { ganadora?: unknown; marcador?: unknown }) {
+      requerirGestor(quien);
+      const t = torneo(torneoId);
+      const p = t.partidos.find((x) => x.id === partidoId);
+      if (!p) throw new ErrorDelClub("PARTIDO_NO_ENCONTRADO", `No existe el partido ${partidoId} en el torneo ${t.id}`, 404);
+      if (t.estado !== "en_juego") throw new ErrorDelClub("TORNEO_NO_EN_JUEGO", "El torneo no está en juego");
+      if (p.estado === "descanso" || p.parejas[0] === null || p.parejas[1] === null) {
+        throw new ErrorDelClub("PARTIDO_NO_LISTO", "El partido todavía no tiene sus dos parejas o es un descanso");
+      }
+      if (p.inicio! > estado.ahora) throw new ErrorDelClub("PARTIDO_NO_EMPEZADO", "El partido todavía no ha empezado");
+      if (typeof datos.ganadora !== "string" || !p.parejas.includes(datos.ganadora)) {
+        invalido("ganadora debe ser el id de una de las dos inscripciones del partido");
+      }
+      if (datos.marcador !== undefined && datos.marcador !== null && typeof datos.marcador !== "string") invalido("marcador debe ser un texto");
+      const despues = siguiente(t, p);
+      if (p.estado === "jugado" && despues?.partido.estado === "jugado") {
+        throw new ErrorDelClub("RESULTADO_CERRADO", "El partido de la ronda siguiente ya se ha jugado");
+      }
+      p.estado = "jugado";
+      p.ganadora = datos.ganadora;
+      p.marcador = (datos.marcador as string | null | undefined) ?? null;
+      if (despues) {
+        despues.partido.parejas[despues.posicion] = p.ganadora;
+      } else {
+        t.estado = "terminado";
+        t.campeona = p.ganadora;
+      }
+      return { partido: p };
+    },
+
+    cancelarTorneo(quien: Socio | undefined, torneoId: string) {
+      requerirGestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado === "terminado") throw new ErrorDelClub("TORNEO_TERMINADO", "El torneo ya ha terminado");
+      if (t.estado === "cancelado") throw new ErrorDelClub("YA_CANCELADO", "El torneo ya estaba cancelado");
+      t.estado = "cancelado";
+      return { torneo: t };
+    },
   };
 }
 
