+test("cancelar: libera todas las franjas, también en juego, y no se cancela dos veces", () => conApi(async (api) => {
+  const enInscripcion = await crear(api, { pistas: ["pista-3"] });
+  const c1 = await api.pedir("POST", `/api/torneos/${enInscripcion.id}/cancelar`, { socio: GESTOR });
+  assert.equal(c1.status, 200);
+  assert.equal(c1.cuerpo.torneo.estado, "cancelado");
+  assert.equal((await franjaDe(api, "pista-3", f("09:00"))).estado, "libre");
+  const dos = await api.pedir("POST", `/api/torneos/${enInscripcion.id}/cancelar`, { socio: GESTOR });
+  assert.equal(dos.status, 409);
+  assert.equal(dos.cuerpo.error.codigo, "YA_CANCELADO");
+
+  const { id } = await torneoCon(api, 5);
+  await api.pedir("POST", `/api/torneos/${id}/cerrar`, { socio: GESTOR });
+  await reloj(api, f("09:00"));
+  const p4 = partido(await verTorneo(api, id), 1, 4);
+  await resultado(api, id, p4.id, { ganadora: p4.parejas[0] });
+  const c2 = await api.pedir("POST", `/api/torneos/${id}/cancelar`, { socio: GESTOR });
