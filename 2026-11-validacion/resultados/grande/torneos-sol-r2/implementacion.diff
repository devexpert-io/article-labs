+test("torneos: resultados, propagación, correcciones y campeona (18–22)", async t => {
+  const api = await arrancarApi(); t.after(() => api.cerrar());
+  const torneo = await crear(api);
+  const ids = await apuntar(api, torneo, 8);
+  const cerrado = await cerrar(api, torneo);
+  const p = cerrado.partidos;
+  assert.deepEqual(p.slice(0, 4).map(p => p.parejas), [[ids[0], ids[7]], [ids[1], ids[6]], [ids[2], ids[5]], [ids[3], ids[4]]]);
+  error(await resultado(api, cerrado, p[0]!), "PARTIDO_NO_EMPEZADO");
+  error(await resultado(api, cerrado, p[4]!), "PARTIDO_NO_LISTO");
+  error(await api.pedir("POST", `/api/torneos/${torneo.id}/partidos/no/resultado`, { socio: gestor }), "PARTIDO_NO_ENCONTRADO", 404);
+  await reloj(api, "2026-12-01T21:00");
+  for (const cuerpo of [{ ganadora: null }, { ganadora: "no" }, { ganadora: ids[0], marcador: 6 }]) {
+    error(await api.pedir("POST", `/api/torneos/${torneo.id}/partidos/${p[0]!.id}/resultado`, { socio: gestor, cuerpo }), "DATOS_INVALIDOS", 400);
+  }
+  for (const partido of p.slice(0, 4)) {
+    const r = await resultado(api, cerrado, partido, partido.parejas[0], { marcador: "6-4 6-3" });
+    assert.equal(r.cuerpo.partido.estado, "jugado"); assert.equal(r.cuerpo.partido.marcador, "6-4 6-3");
+  }
+  const corregido = await resultado(api, cerrado, p[0]!, ids[7]);
+  assert.equal(corregido.cuerpo.partido.ganadora, ids[7]); assert.equal(corregido.cuerpo.partido.marcador, null);
+  const actual: Torneo = (await api.pedir("GET", `/api/torneos/${torneo.id}`)).cuerpo.torneo;
+  assert.deepEqual(actual.partidos[4]!.parejas, [ids[7], ids[3]]);
+  assert.deepEqual(actual.partidos[5]!.parejas, [ids[1], ids[2]]);
+  await resultado(api, actual, actual.partidos[4]!);
+  const trasSemi = (await api.pedir("GET", `/api/torneos/${torneo.id}`)).cuerpo.torneo;
+  error(await resultado(api, cerrado, p[0]!, ids[0]), "RESULTADO_CERRADO");
+  assert.deepEqual((await api.pedir("GET", `/api/torneos/${torneo.id}`)).cuerpo.torneo, trasSemi);
+  await resultado(api, actual, actual.partidos[5]!);
+  const final: Torneo = (await api.pedir("GET", `/api/torneos/${torneo.id}`)).cuerpo.torneo;
+  assert.deepEqual(final.partidos[6]!.parejas, [ids[7], ids[1]]);
+  assert.equal((await resultado(api, final, final.partidos[6]!, ids[1])).status, 200);
+  const terminado = (await api.pedir("GET", `/api/torneos/${torneo.id}`)).cuerpo.torneo;
+  assert.equal(terminado.estado, "terminado"); assert.equal(terminado.campeona, ids[1]);
+  error(await resultado(api, final, final.partidos[6]!), "TORNEO_NO_EN_JUEGO");
+  error(await api.pedir("POST", `/api/torneos/${torneo.id}/cancelar`, { socio: gestor }), "TORNEO_TERMINADO");
+  assert.equal((await api.pedir("GET", "/api/torneos?estado=terminado")).cuerpo.torneos.length, 1);
+});
