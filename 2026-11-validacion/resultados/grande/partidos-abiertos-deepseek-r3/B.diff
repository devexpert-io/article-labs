index 0000000..dd14ef0
--- /dev/null
+++ b/test/partidos.test.ts
@@ -0,0 +1,516 @@
+// Los partidos abiertos, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Arranca una API limpia para cada prueba, así ninguna depende del estado de otra. */
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}): Promise<void> {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const ORGANIZADOR = "socio-041"; // Nora Benítez: cuota al día y ninguna reserva.
+const ANA = "socio-016";
+const PABLO = "socio-020";
+const IRENE = "socio-023";
+const LUIS = "socio-024";
+const GESTOR = "socio-040";
+
+function crearPartido(api: Api, socio: string, datos: Record<string, unknown>) {
+  return api.pedir("POST", "/api/partidos", { socio, cuerpo: datos });
+}
+
+function unirse(api: Api, id: string, socio: string) {
+  return api.pedir("POST", `/api/partidos/${id}/unirse`, { socio });
+}
+
+function salir(api: Api, id: string, socio: string, cuerpo: Record<string, unknown> = {}) {
+  return api.pedir("POST", `/api/partidos/${id}/salir`, { socio, cuerpo });
+}
+
+function cancelar(api: Api, id: string, socio: string, cuerpo: Record<string, unknown> = {}) {
+  return api.pedir("POST", `/api/partidos/${id}/cancelar`, { socio, cuerpo });
+}
+
+function moverReloj(api: Api, ahora: string) {
+  return api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+}
+
+const DATOS_PARTIDO = { pistaId: "pista-1", inicio: "2026-11-20T12:00" };
+
+test("permisos: crear, unirse y salir necesitan X-Socio; cancelar es de quien organiza o de un gestor", async () => {
+  await conApi(async (api) => {
+    const sinIdentificar = await api.pedir("POST", "/api/partidos", { cuerpo: DATOS_PARTIDO });
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const creado = await crearPartido(api, ORGANIZADOR, DATOS_PARTIDO);
+    assert.equal(creado.status, 201);
+    const id = creado.cuerpo.partido.id;
+
+    for (const ruta of [`/api/partidos/${id}/unirse`, `/api/partidos/${id}/salir`]) {
+      const respuesta = await api.pedir("POST", ruta, { cuerpo: {} });
+      assert.equal(respuesta.status, 401, `${ruta} sin X-Socio`);
+      assert.equal(respuesta.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    }
+    assert.equal((await api.pedir("PATCH", `/api/socios/${ANA}`, { cuerpo: { nivel: 3 } })).status, 401);
+
+    // Consultar no necesita identificarse.
+    assert.equal((await api.pedir("GET", "/api/partidos")).status, 200);
+    assert.equal((await api.pedir("GET", `/api/partidos/${id}`)).status, 200);
+
+    // El nivel: el propio socio o un gestor.
+    const ajeno = await api.pedir("PATCH", `/api/socios/${ANA}`, { socio: PABLO, cuerpo: { nivel: 3 } });
+    assert.equal(ajeno.status, 403);
+    assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+    assert.equal((await api.pedir("PATCH", `/api/socios/${ANA}`, { socio: ANA, cuerpo: { nivel: 3 } })).status, 200);
+    assert.equal((await api.pedir("PATCH", `/api/socios/${ANA}`, { socio: GESTOR, cuerpo: { nivel: 2 } })).status, 200);
+
+    // Cancelar: quien organiza o un gestor.
+    const otro = await crearPartido(api, ANA, { pistaId: "pista-2", inicio: "2026-11-20T12:00" });
+    const ajenoIntento = await cancelar(api, otro.cuerpo.partido.id, PABLO);
+    assert.equal(ajenoIntento.status, 403);
+    assert.equal(ajenoIntento.cuerpo.error.codigo, "SIN_PERMISO");
+    assert.equal((await cancelar(api, otro.cuerpo.partido.id, GESTOR)).status, 200);
+    assert.equal((await cancelar(api, id, ORGANIZADOR)).status, 200);
+  });
+});
+
+test("el nivel de un socio: de 1 a 7 en pasos de 0,5, o null", async () => {
+  await conApi(async (api) => {
+    const valido = async (nivel: unknown) => {
+      const r = await api.pedir("PATCH", `/api/socios/${ANA}`, { socio: ANA, cuerpo: { nivel } });
+      assert.equal(r.status, 200, `nivel ${JSON.stringify(nivel)}`);
+      assert.equal(r.cuerpo.socio.nivel, nivel);
+      return r;
+    };
+    for (const nivel of [1, 3, 4.5, 7]) await valido(nivel);
+
+    for (const nivel of [0, 0.5, 7.5, 8, 3.25, "3", true]) {
+      const r = await api.pedir("PATCH", `/api/socios/${ANA}`, { socio: ANA, cuerpo: { nivel } });
+      assert.equal(r.status, 400, `nivel ${JSON.stringify(nivel)}`);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    assert.equal((await api.pedir("PATCH", `/api/socios/${ANA}`, { socio: ANA, cuerpo: {} })).status, 400);
+
+    await valido(null);
+    assert.equal((await api.pedir("GET", `/api/socios?texto=nora`)).cuerpo.socios[0].nivel, null);
+
+    const inexistente = await api.pedir("PATCH", "/api/socios/socio-999", { socio: GESTOR, cuerpo: { nivel: 3 } });
+    assert.equal(inexistente.status, 404);
+    assert.equal(inexistente.cuerpo.error.codigo, "SOCIO_NO_ENCONTRADO");
+  });
+});
+
+test("crear un partido reserva la pista con las reglas de siempre", async () => {
+  await conApi(async (api) => {
+    const error = async (datos: Record<string, unknown>, socio: string, codigo: string) => {
+      const r = await crearPartido(api, socio, datos);
+      assert.equal(r.cuerpo.error?.codigo, codigo, JSON.stringify(datos));
+      return r;
