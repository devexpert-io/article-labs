+        nivel = leido;
+      }
+      const partidos = estado.partidos
+        .filter((p) => p.estado === "abierto" && p.inicio > estado.ahora)
+        .filter((p) => !f.fecha || p.inicio.slice(0, 10) === f.fecha)
+        .filter((p) => nivel === undefined || p.nivelMin === null || (nivel >= p.nivelMin && nivel <= p.nivelMax!))
+        .sort((a, b) => a.inicio.localeCompare(b.inicio))
+        .map(verPartido);
+      return { partidos };
+    },
+
+    obtenerPartido(id: string) {
+      mantener();
+      return { partido: verPartido(partido(id)) };
+    },
+
+    crearPartido(datos: { pistaId?: unknown; inicio?: unknown; nivelMin?: unknown; nivelMax?: unknown }, quien: Socio) {
+      mantener();
+      const { pistaId, inicio } = datos;
+      if (typeof pistaId !== "string" || typeof inicio !== "string") invalido("pistaId e inicio son obligatorios");
+      const { minimo, maximo } = leerRango(datos);
+      const p = pista(pistaId);
+      validarInicio(inicio);
+      comprobarReglasDeReserva(quien, p, inicio, HORAS_MINIMAS_PARTIDO);
+      comprobarNivel(quien, minimo, maximo);
+      const suya = anotarReserva(quien, p, inicio, "");
+      estado.contadorPartidos += 1;
+      const id = `P-${String(estado.contadorPartidos).padStart(4, "0")}`;
+      suya.partidoId = id;
+      const creado: Partido = {
+        id,
+        reservaId: suya.id,
+        pistaId: p.id,
+        inicio,
+        fin: suya.fin,
+        organizador: quien.id,
+        jugadores: [quien.id],
+        nivelMin: minimo,
+        nivelMax: maximo,
+        estado: "abierto",
+        importe: suya.importe,
+        importePorJugador: Math.ceil(suya.importe / JUGADORES_POR_PARTIDO),
+        penalizaciones: [],
+      };
+      estado.partidos.push(creado);
+      return { partido: verPartido(creado) };
+    },
+
+    unirsePartido(id: string, quien: Socio) {
+      mantener();
+      const p = partido(id);
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.estado === "completo" || p.jugadores.length >= JUGADORES_POR_PARTIDO) {
+        throw new ErrorDelClub("PARTIDO_COMPLETO", "El partido ya tiene sus cuatro jugadores");
+      }
+      if (p.jugadores.includes(quien.id)) throw new ErrorDelClub("YA_APUNTADO", `${quien.nombre} ya juega en este partido`);
+      if (!quien.cuotaActiva) throw new ErrorDelClub("CUOTA_INACTIVA", `${quien.nombre} no tiene la cuota al día`);
+      comprobarNivel(quien, p.nivelMin, p.nivelMax);
+      if (reservasFuturas(quien.id) >= MAXIMO_RESERVAS_FUTURAS) {
+        throw new ErrorDelClub("LIMITE_DE_RESERVAS", `${quien.nombre} ya tiene ${MAXIMO_RESERVAS_FUTURAS} reservas futuras`);
+      }
+      p.jugadores.push(quien.id);
+      p.estado = p.jugadores.length >= JUGADORES_POR_PARTIDO ? "completo" : "abierto";
+      return { partido: verPartido(p) };
+    },
+
+    salirPartido(id: string, datos: { forzar?: unknown }, quien: Socio) {
+      mantener();
+      const p = partido(id);
+      if (datos.forzar !== undefined && typeof datos.forzar !== "boolean") invalido("forzar debe ser true o false");
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      if (p.organizador === quien.id) {
+        throw new ErrorDelClub("ORGANIZADOR_NO_PUEDE_SALIR", "Quien organiza el partido no puede salir: tiene que cancelarlo");
+      }
+      const indice = p.jugadores.indexOf(quien.id);
+      if (indice === -1) throw new ErrorDelClub("NO_APUNTADO", `${quien.nombre} no juega en este partido`);
+      const horas = horasEntre(estado.ahora, p.inicio);
+      if (horas < HORAS_CANCELACION_GRATUITA) {
+        if (datos.forzar !== true) {
+          throw new ErrorDelClub(
+            "FUERA_DE_PLAZO",
+            `Faltan ${Math.floor(horas)} horas para el partido y la salida gratuita termina ${HORAS_CANCELACION_GRATUITA} horas antes. ` +
+            "Con forzar se sale pagando la parte del jugador: solo si el socio ha aceptado expresamente la penalización.",
+          );
+        }
+        p.penalizaciones.push({ socioId: quien.id, importe: p.importePorJugador });
+      }
+      p.jugadores.splice(indice, 1);
+      if (p.estado === "completo") p.estado = "abierto";
+      // Si al salir deja de estar completo dentro de las últimas 6 horas, se cancela solo.
+      mantener();
+      return { partido: verPartido(p) };
+    },
+
+    cancelarPartido(id: string, datos: { forzar?: unknown }, quien: Socio) {
+      mantener();
+      const p = partido(id);
+      if (datos.forzar !== undefined && typeof datos.forzar !== "boolean") invalido("forzar debe ser true o false");
+      exigirOrganizadorOGestor(quien, p);
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido ya estaba cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      const horas = horasEntre(estado.ahora, p.inicio);
+      let penalizacion: number | undefined;
+      if (horas < HORAS_CANCELACION_GRATUITA) {
+        if (datos.forzar !== true) {
+          throw new ErrorDelClub(
+            "FUERA_DE_PLAZO",
+            `Faltan ${Math.floor(horas)} horas para el partido y la cancelación gratuita termina ${HORAS_CANCELACION_GRATUITA} horas antes. ` +
+            "Con forzar se cancela con una penalización del 100 % del importe: solo si el socio ha aceptado expresamente la penalización.",
+          );
+        }
+        penalizacion = p.importe;
+      }
+      p.estado = "cancelado";
+      p.motivo = "organizador";
+      cancelarReservaDelPartido(p, penalizacion);
+      return { partido: verPartido(p) };
+    },
   };
 }
 
