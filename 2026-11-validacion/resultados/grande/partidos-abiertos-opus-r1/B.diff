diff --git a/test/partidos.test.ts b/test/partidos.test.ts
new file mode 100644
index 0000000..6055ff6
--- /dev/null
+++ b/test/partidos.test.ts
@@ -0,0 +1,376 @@
+// Partidos abiertos (docs/specs/partidos-abiertos.md), probados a través de la API.
+// Cada test arranca su propia API para partir siempre de la semilla.
+// En la semilla, el miércoles 25 de noviembre no tiene ninguna reserva, y estos socios no tienen reservas futuras:
+// socio-006, socio-016, socio-020, socio-023, socio-024, socio-026, socio-041. socio-022 no tiene la cuota al día.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const crear = (api: Api, socio: string | undefined, cuerpo: Record<string, unknown>) =>
+  api.pedir("POST", "/api/partidos", { cuerpo, ...(socio ? { socio } : {}) });
+const unirse = (api: Api, socio: string | undefined, id: string) =>
+  api.pedir("POST", `/api/partidos/${id}/unirse`, socio ? { socio } : {});
+const salir = (api: Api, socio: string | undefined, id: string, cuerpo: Record<string, unknown> = {}) =>
+  api.pedir("POST", `/api/partidos/${id}/salir`, { cuerpo, ...(socio ? { socio } : {}) });
+const cancelar = (api: Api, socio: string | undefined, id: string, cuerpo: Record<string, unknown> = {}) =>
+  api.pedir("POST", `/api/partidos/${id}/cancelar`, { cuerpo, ...(socio ? { socio } : {}) });
+const nivel = (api: Api, quien: string, socioId: string, valor: unknown) =>
+  api.pedir("PATCH", `/api/socios/${socioId}`, { socio: quien, cuerpo: { nivel: valor } });
+const reloj = (api: Api, ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+
+function error(r: { status: number; cuerpo: any }, status: number, codigo: string) {
+  assert.equal(r.status, status, `esperaba ${status} ${codigo} y llegó ${r.status} ${JSON.stringify(r.cuerpo)}`);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+/** Un partido de pista-1 el miércoles 25 a las 12:00 organizado por socio-006, con los jugadores que se indiquen. */
+async function partidoCon(api: Api, jugadores: string[] = [], inicio = "2026-11-25T12:00") {
+  const creado = await crear(api, "socio-006", { pistaId: "pista-1", inicio });
+  assert.equal(creado.status, 201);
+  const id = creado.cuerpo.partido.id as string;
+  for (const j of jugadores) assert.equal((await unirse(api, j, id)).status, 200);
+  return id;
+}
+
+async function franja(api: Api, pistaId: string, inicio: string) {
+  const d = await api.pedir("GET", `/api/disponibilidad?fecha=${inicio.slice(0, 10)}&pista=${pistaId}`);
+  return d.cuerpo.pistas[0].franjas.find((f: any) => f.inicio === inicio).estado;
+}
+
+test("permisos: crear, unirse y salir piden X-Socio; cancelar y fijar nivel, permiso; consultar, nada", () => conApi(async (api) => {
+  error(await crear(api, undefined, { pistaId: "pista-1", inicio: "2026-11-25T12:00" }), 401, "NO_IDENTIFICADO");
+  const id = await partidoCon(api);
+  error(await unirse(api, undefined, id), 401, "NO_IDENTIFICADO");
+  error(await salir(api, undefined, id), 401, "NO_IDENTIFICADO");
+  error(await cancelar(api, undefined, id), 401, "NO_IDENTIFICADO");
+  error(await cancelar(api, "socio-016", id), 403, "SIN_PERMISO");
+  assert.equal((await api.pedir("GET", "/api/partidos")).status, 200);
+  assert.equal((await api.pedir("GET", `/api/partidos/${id}`)).status, 200);
+  assert.equal((await cancelar(api, "socio-040", id)).cuerpo.partido.estado, "cancelado");
+  const otro = await partidoCon(api, [], "2026-11-25T13:30");
+  assert.equal((await cancelar(api, "socio-006", otro)).cuerpo.partido.estado, "cancelado");
+
+  error(await api.pedir("PATCH", "/api/socios/socio-016", { cuerpo: { nivel: 3 } }), 401, "NO_IDENTIFICADO");
+  error(await nivel(api, "socio-006", "socio-016", 3), 403, "SIN_PERMISO");
+  assert.equal((await nivel(api, "socio-016", "socio-016", 3)).status, 200);
+  assert.equal((await nivel(api, "socio-040", "socio-016", 4)).cuerpo.socio.nivel, 4);
+}));
+
+test("nivel de los socios: de 1 a 7 en pasos de 0,5, o null", () => conApi(async (api) => {
+  const busqueda = await api.pedir("GET", "/api/socios?texto=socio-016");
+  assert.equal(busqueda.cuerpo.socios[0].nivel, null);
+  for (const valor of [1, 3, 4.5, 7]) {
+    const r = await nivel(api, "socio-016", "socio-016", valor);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.socio.id, "socio-016");
+    assert.equal(r.cuerpo.socio.nivel, valor);
+  }
+  assert.equal((await api.pedir("GET", "/api/socios?texto=socio-016")).cuerpo.socios[0].nivel, 7);
+  for (const valor of [0.5, 7.5, 3.3, 0, "3", true]) error(await nivel(api, "socio-016", "socio-016", valor), 400, "DATOS_INVALIDOS");
+  error(await api.pedir("PATCH", "/api/socios/socio-016", { socio: "socio-016", cuerpo: {} }), 400, "DATOS_INVALIDOS");
+  assert.equal((await nivel(api, "socio-016", "socio-016", null)).cuerpo.socio.nivel, null);
+  error(await nivel(api, "socio-040", "socio-999", 3), 404, "SOCIO_NO_ENCONTRADO");
+}));
+
+test("crear un partido sigue las reglas de reservar", () => conApi(async (api) => {
+  error(await crear(api, "socio-006", { inicio: "2026-11-25T12:00" }), 400, "DATOS_INVALIDOS");
+  error(await crear(api, "socio-006", { pistaId: "pista-9", inicio: "2026-11-25T12:00" }), 404, "PISTA_NO_ENCONTRADA");
+  error(await crear(api, "socio-006", { pistaId: "pista-1", inicio: "2026-11-25T12:15" }), 400, "FRANJA_INVALIDA");
+  error(await crear(api, "socio-022", { pistaId: "pista-1", inicio: "2026-11-25T12:00" }), 409, "CUOTA_INACTIVA");
+  error(await crear(api, "socio-006", { pistaId: "pista-4", inicio: "2026-11-25T12:00" }), 409, "PISTA_CERRADA");
+  error(await crear(api, "socio-006", { pistaId: "pista-1", inicio: "2026-11-18T09:00" }), 409, "FRANJA_PASADA");
+  error(await crear(api, "socio-006", { pistaId: "pista-1", inicio: "2026-11-19T19:30" }), 409, "FRANJA_NO_DISPONIBLE");
+  // Luis Martín (socio-005) tiene dos reservas futuras: puede organizar un partido, pero no dos.
+  assert.equal((await crear(api, "socio-005", { pistaId: "pista-1", inicio: "2026-11-25T12:00" })).status, 201);
+  error(await crear(api, "socio-005", { pistaId: "pista-2", inicio: "2026-11-25T12:00" }), 409, "LIMITE_DE_RESERVAS");
+}));
+
+test("crear con rango de nivel", () => conApi(async (api) => {
+  const base = { pistaId: "pista-1", inicio: "2026-11-25T12:00" };
+  for (const rango of [{ nivelMin: 3 }, { nivelMax: 4 }, { nivelMin: 0.5, nivelMax: 4 }, { nivelMin: 3, nivelMax: 3.2 }, { nivelMin: "3", nivelMax: 4 }, { nivelMin: 5, nivelMax: 4 }]) {
+    error(await crear(api, "socio-006", { ...base, ...rango }), 400, "DATOS_INVALIDOS");
+  }
+  error(await crear(api, "socio-006", { ...base, nivelMin: 3, nivelMax: 4 }), 409, "NIVEL_SIN_DEFINIR");
+  await nivel(api, "socio-006", "socio-006", 5);
+  error(await crear(api, "socio-006", { ...base, nivelMin: 3, nivelMax: 4.5 }), 409, "NIVEL_FUERA_DE_RANGO");
+  const ok = await crear(api, "socio-006", { ...base, nivelMin: 5, nivelMax: 5 });
+  assert.equal(ok.status, 201);
+  assert.equal(ok.cuerpo.partido.nivelMin, 5);
+  assert.equal(ok.cuerpo.partido.nivelMax, 5);
+  // Sin rango no hace falta nivel.
+  const sinRango = await crear(api, "socio-016", { pistaId: "pista-2", inicio: "2026-11-25T12:00" });
+  assert.equal(sinRango.status, 201);
+  assert.equal(sinRango.cuerpo.partido.nivelMin, null);
+  assert.equal(sinRango.cuerpo.partido.nivelMax, null);
+}));
+
+test("la reserva del partido, la respuesta y la consulta", () => conApi(async (api) => {
+  const creado = await crear(api, "socio-006", { pistaId: "pista-1", inicio: "2026-11-25T19:30" });
+  assert.equal(creado.status, 201);
+  const p = creado.cuerpo.partido;
+  assert.equal(p.estado, "abierto");
+  assert.deepEqual(p.jugadores, ["socio-006"]);
+  assert.equal(p.organizador, "socio-006");
+  assert.equal(p.plazasLibres, 3);
+  assert.deepEqual(p.penalizaciones, []);
+  assert.equal(p.pistaId, "pista-1");
+  assert.equal(p.inicio, "2026-11-25T19:30");
+  assert.equal(p.fin, "2026-11-25T21:00");
+  assert.equal(p.importe, 2800);
+  assert.equal(p.motivo, undefined);
+
+  const reservas = await api.pedir("GET", "/api/reservas?socio=socio-006&fecha=2026-11-25");
+  assert.equal(reservas.cuerpo.total, 1);
+  const r = reservas.cuerpo.reservas[0];
+  assert.equal(r.id, p.reservaId);
+  assert.equal(r.partidoId, p.id);
+  assert.equal(r.estado, "confirmada");
+  assert.equal(r.importe, 2800);
+  assert.equal(await franja(api, "pista-1", "2026-11-25T19:30"), "reservada");
+
+  assert.deepEqual((await api.pedir("GET", `/api/partidos/${p.id}`)).cuerpo.partido, p);
+  error(await api.pedir("GET", "/api/partidos/P-9999"), 404, "PARTIDO_NO_ENCONTRADO");
+  error(await unirse(api, "socio-016", "P-9999"), 404, "PARTIDO_NO_ENCONTRADO");
+  error(await salir(api, "socio-016", "P-9999"), 404, "PARTIDO_NO_ENCONTRADO");
+  error(await cancelar(api, "socio-040", "P-9999"), 404, "PARTIDO_NO_ENCONTRADO");
+}));
+
+test("el precio por jugador es la cuarta parte, redondeada al céntimo hacia arriba", () => conApi(async (api) => {
+  // Los precios de la semilla son múltiplos de 4: la pista 3 en valle cuesta 1200 y en punta 2000.
+  const valle = (await crear(api, "socio-006", { pistaId: "pista-3", inicio: "2026-11-25T12:00" })).cuerpo.partido;
+  assert.equal(valle.importePorJugador, 300);
+  const punta = (await crear(api, "socio-016", { pistaId: "pista-3", inicio: "2026-11-25T19:30" })).cuerpo.partido;
+  assert.equal(punta.importePorJugador, 500);
+  for (const p of [valle, punta]) assert.equal(p.importePorJugador, Math.ceil(p.importe / 4));
+}));
+
+test("unirse: al final de jugadores y, con el cuarto, completo", () => conApi(async (api) => {
+  const id = await partidoCon(api);
+  let p = (await unirse(api, "socio-016", id)).cuerpo.partido;
+  assert.deepEqual(p.jugadores, ["socio-006", "socio-016"]);
+  assert.equal(p.plazasLibres, 2);
+  assert.equal(p.estado, "abierto");
+  p = (await unirse(api, "socio-020", id)).cuerpo.partido;
+  assert.equal(p.plazasLibres, 1);
+  p = (await unirse(api, "socio-023", id)).cuerpo.partido;
