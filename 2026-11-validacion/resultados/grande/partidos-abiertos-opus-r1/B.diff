+      if (p.organizador === quien.id) {
+        throw new ErrorDelClub("ORGANIZADOR_NO_PUEDE_SALIR", "El organizador no puede salir de su partido: para dejarlo, lo cancela");
+      }
+      if (!p.jugadores.includes(quien.id)) throw new ErrorDelClub("NO_APUNTADO", `${quien.nombre} no juega en este partido`);
+      const horas = horasEntre(estado.ahora, p.inicio);
+      const tarde = horas < HORAS_CANCELACION_GRATUITA;
+      if (tarde && datos.forzar !== true) {
+        throw new ErrorDelClub(
+          "FUERA_DE_PLAZO",
+          `Faltan ${Math.floor(horas)} horas para el partido y la salida gratuita termina ${HORAS_CANCELACION_GRATUITA} horas antes. ` +
+          "Con forzar se sale pagando la parte del jugador: solo si el socio ha aceptado expresamente la penalización.",
+        );
+      }
+      p.jugadores = p.jugadores.filter((j) => j !== quien.id);
+      p.plazasLibres += 1;
+      if (p.estado === "completo") p.estado = "abierto";
+      if (tarde) p.penalizaciones.push({ socioId: quien.id, importe: p.importePorJugador });
+      revisarPartidos();
+      return { partido: p };
+    },
+
+    cancelarPartido(quien: Socio | undefined, id: string, datos: { forzar?: unknown }) {
+      if (!quien) noIdentificado();
+      const p = partido(id);
+      if (p.organizador !== quien.id && quien.rol !== "gestor") sinPermiso("Solo quien organiza el partido o un gestor pueden cancelarlo");
+      comprobarForzar(datos.forzar);
+      comprobarNoEmpezado(p);
+      const horas = horasEntre(estado.ahora, p.inicio);
+      const tarde = horas < HORAS_CANCELACION_GRATUITA;
+      if (tarde && datos.forzar !== true) {
+        throw new ErrorDelClub(
+          "FUERA_DE_PLAZO",
+          `Faltan ${Math.floor(horas)} horas para el partido y la cancelación gratuita termina ${HORAS_CANCELACION_GRATUITA} horas antes. ` +
+          "Con forzar se cancela con una penalización del 100 % del importe: solo si el socio ha aceptado expresamente la penalización.",
+        );
+      }
+      cerrarPartido(p, "organizador", tarde);
+      return { partido: p };
+    },
   };
 }
 
