--- /dev/null
+++ b/test/partidos.test.ts
@@ -0,0 +1,460 @@
+// La feature de partidos abiertos, probada a través de la API (docs/specs/partidos-abiertos.md).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+
+/** Arranca una API limpia para cada prueba y la cierra al terminar. */
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function codigo(r: Respuesta): string {
+  assert.ok(r.cuerpo?.error, `se esperaba un error y llegó ${r.status} ${r.texto}`);
+  return r.cuerpo.error.codigo;
+}
+
+function esperar(r: Respuesta, codigoError: string, http?: number) {
+  assert.equal(codigo(r), codigoError, r.texto);
+  if (http !== undefined) assert.equal(r.status, http, r.texto);
+}
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200, r.texto);
+}
+
+async function crearPartido(api: Api, socio: string, cuerpo: Record<string, unknown>) {
+  const r = await api.pedir("POST", "/api/partidos", { cuerpo, socio });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.partido;
+}
+
+const unirse = (api: Api, socio: string, partido: string) =>
+  api.pedir("POST", `/api/partidos/${partido}/unirse`, { socio });
+
+const salir = (api: Api, socio: string, partido: string, cuerpo: Record<string, unknown> = {}) =>
+  api.pedir("POST", `/api/partidos/${partido}/salir`, { socio, cuerpo });
+
+const cancelar = (api: Api, socio: string, partido: string, cuerpo: Record<string, unknown> = {}) =>
+  api.pedir("POST", `/api/partidos/${partido}/cancelar`, { socio, cuerpo });
+
+const fijarNivel = (api: Api, socio: string, nivel: unknown, quien = socio) =>
+  api.pedir("PATCH", `/api/socios/${socio}`, { socio: quien, cuerpo: { nivel } });
+
+async function llenar(api: Api, partido: string, socios: string[]) {
+  for (const socio of socios) {
+    const r = await unirse(api, socio, partido);
+    assert.equal(r.status, 200, r.texto);
+  }
+  return (await api.pedir("GET", `/api/partidos/${partido}`)).cuerpo.partido;
+}
+
+test("criterio 1: permisos de los partidos y del nivel", async () => {
+  await conApi(async (api) => {
+    // Consultar no necesita identificarse.
+    assert.equal((await api.pedir("GET", "/api/partidos")).status, 200);
+
+    // Crear, unirse y salir exigen X-Socio.
+    esperar(await api.pedir("POST", "/api/partidos", { cuerpo: { pistaId: "pista-1", inicio: "2026-11-20T10:30" } }), "NO_IDENTIFICADO", 401);
+    const partido = await crearPartido(api, "socio-041", { pistaId: "pista-1", inicio: "2026-11-20T10:30" });
+    esperar(await api.pedir("POST", `/api/partidos/${partido.id}/unirse`), "NO_IDENTIFICADO", 401);
+    esperar(await api.pedir("POST", `/api/partidos/${partido.id}/salir`, { cuerpo: {} }), "NO_IDENTIFICADO", 401);
+    esperar(await api.pedir("POST", `/api/partidos/${partido.id}/cancelar`, { cuerpo: {} }), "NO_IDENTIFICADO", 401);
+
+    // El nivel: el propio socio o un gestor.
+    esperar(await fijarNivel(api, "socio-003", 4, "socio-002"), "SIN_PERMISO", 403);
+    assert.equal((await fijarNivel(api, "socio-003", 4)).status, 200);
+    assert.equal((await fijarNivel(api, "socio-003", 5, "socio-040")).status, 200);
+    esperar(await api.pedir("PATCH", "/api/socios/socio-003", { cuerpo: { nivel: 4 } }), "NO_IDENTIFICADO", 401);
+
+    // Cancelar: el organizador o un gestor.
+    esperar(await cancelar(api, "socio-003", partido.id), "SIN_PERMISO", 403);
+    assert.equal((await cancelar(api, "socio-040", partido.id)).status, 200);
+  });
+});
+
+test("criterio 2: el nivel de los socios se fija de 1 a 7 en pasos de 0,5", async () => {
+  await conApi(async (api) => {
+    const fijado = await fijarNivel(api, "socio-004", 4.5);
+    assert.equal(fijado.status, 200);
+    assert.equal(fijado.cuerpo.socio.nivel, 4.5);
+
+    const buscado = await api.pedir("GET", "/api/socios?texto=Irene");
+    assert.equal(buscado.cuerpo.socios[0].id, "socio-004");
+    assert.equal(buscado.cuerpo.socios[0].nivel, 4.5);
+
+    for (const malo of [0, 7.5, 3.3, "4", true, {}]) {
+      esperar(await fijarNivel(api, "socio-004", malo), "DATOS_INVALIDOS", 400);
+    }
+    esperar(await api.pedir("PATCH", "/api/socios/socio-004", { socio: "socio-004", cuerpo: {} }), "DATOS_INVALIDOS", 400);
+
+    const quitado = await fijarNivel(api, "socio-004", null);
+    assert.equal(quitado.status, 200);
+    assert.equal(quitado.cuerpo.socio.nivel, null);
+
+    esperar(await fijarNivel(api, "socio-999", 4, "socio-040"), "SOCIO_NO_ENCONTRADO", 404);
+  });
+});
+
+test("criterio 3: crear hace las mismas comprobaciones que reservar", async () => {
+  await conApi(async (api) => {
+    const cuerpo = { pistaId: "pista-1", inicio: "2026-11-20T10:30" };
+    esperar(await api.pedir("POST", "/api/partidos", { socio: "socio-041", cuerpo: { ...cuerpo, pistaId: "pista-9" } }), "PISTA_NO_ENCONTRADA", 404);
+    esperar(await api.pedir("POST", "/api/partidos", { socio: "socio-041", cuerpo: { ...cuerpo, inicio: "2026-11-20T11:00" } }), "FRANJA_INVALIDA", 400);
+    esperar(await api.pedir("POST", "/api/partidos", { socio: "socio-041", cuerpo: { ...cuerpo, inicio: "2026-11-18T09:00" } }), "FRANJA_PASADA", 409);
+    esperar(await api.pedir("POST", "/api/partidos", { socio: "socio-011", cuerpo }), "CUOTA_INACTIVA", 409);
+    esperar(await api.pedir("POST", "/api/partidos", { socio: "socio-041", cuerpo: { ...cuerpo, pistaId: "pista-4" } }), "PISTA_CERRADA", 409);
+    esperar(await api.pedir("POST", "/api/partidos", { socio: "socio-041", cuerpo: { pistaId: "pista-1", inicio: "2026-11-19T19:30" } }), "FRANJA_NO_DISPONIBLE", 409);
+    // Hoy a las 15:00 faltan 5 horas: demasiado tarde.
+    esperar(await api.pedir("POST", "/api/partidos", { socio: "socio-041", cuerpo: { pistaId: "pista-1", inicio: "2026-11-18T15:00" } }), "DEMASIADO_TARDE", 409);
+
+    // El límite de reservas futuras.
+    const tercera = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-005", pistaId: "pista-1", inicio: "2026-11-20T09:00" } });
+    assert.equal(tercera.status, 201, tercera.texto);
+    esperar(await api.pedir("POST", "/api/partidos", { socio: "socio-005", cuerpo: { pistaId: "pista-1", inicio: "2026-11-21T10:30" } }), "LIMITE_DE_RESERVAS", 409);
+  });
+});
+
+test("criterio 4: el rango de nivel al crear", async () => {
+  await conApi(async (api) => {
