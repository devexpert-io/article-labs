+        importe: suya.importe,
+        importePorJugador: Math.ceil(suya.importe / JUGADORES_POR_PARTIDO),
+        penalizaciones: [],
+      };
+      suya.partidoId = nuevo.id;
+      estado.partidos.push(nuevo);
+      return { partido: nuevo };
+    },
+
+    unirsePartido(id: string, quien: Socio | undefined) {
+      sincronizar();
+      if (!quien) throw new ErrorDelClub("NO_IDENTIFICADO", "Para unirse a un partido hay que identificarse con X-Socio", 401);
+      const p = partido(id);
+      if (p.estado === "completo") throw new ErrorDelClub("PARTIDO_COMPLETO", "El partido ya tiene sus cuatro jugadores");
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.jugadores.includes(quien.id)) throw new ErrorDelClub("YA_APUNTADO", `${quien.nombre} ya juega en este partido`);
+      if (!quien.cuotaActiva) throw new ErrorDelClub("CUOTA_INACTIVA", `${quien.nombre} no tiene la cuota al día`);
+      if (p.nivelMin !== null) {
+        if (quien.nivel === null) {
+          throw new ErrorDelClub("NIVEL_SIN_DEFINIR", `${quien.nombre} no tiene nivel y el partido pide del ${p.nivelMin} al ${p.nivelMax}`);
+        }
+        if (quien.nivel < p.nivelMin || quien.nivel > p.nivelMax!) {
+          throw new ErrorDelClub(
+            "NIVEL_FUERA_DE_RANGO",
+            `${quien.nombre} tiene nivel ${quien.nivel} y el partido pide del ${p.nivelMin} al ${p.nivelMax}`,
+          );
+        }
+      }
+      if (ocupacionFutura(quien.id) >= MAXIMO_RESERVAS_FUTURAS) {
+        throw new ErrorDelClub("LIMITE_DE_RESERVAS", `${quien.nombre} ya tiene ${MAXIMO_RESERVAS_FUTURAS} reservas futuras`);
+      }
+      p.jugadores.push(quien.id);
+      p.plazasLibres = JUGADORES_POR_PARTIDO - p.jugadores.length;
+      if (p.jugadores.length >= JUGADORES_POR_PARTIDO) p.estado = "completo";
+      return { partido: p };
+    },
+
+    salirPartido(id: string, quien: Socio | undefined, datos: { forzar?: unknown }) {
+      sincronizar();
+      if (!quien) throw new ErrorDelClub("NO_IDENTIFICADO", "Para salir de un partido hay que identificarse con X-Socio", 401);
+      const p = partido(id);
+      comprobarForzar(datos.forzar);
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      if (p.organizador === quien.id) {
+        throw new ErrorDelClub("ORGANIZADOR_NO_PUEDE_SALIR", "El organizador no puede salir de su partido: tiene que cancelarlo");
+      }
+      const indice = p.jugadores.indexOf(quien.id);
+      if (indice < 0) throw new ErrorDelClub("NO_APUNTADO", `${quien.nombre} no juega en este partido`);
+      const horas = horasEntre(estado.ahora, p.inicio);
+      if (horas < HORAS_CANCELACION_GRATUITA) {
+        if (datos.forzar !== true) {
+          throw new ErrorDelClub(
+            "FUERA_DE_PLAZO",
+            `Faltan ${Math.floor(horas)} horas para el partido y la salida gratuita termina ${HORAS_CANCELACION_GRATUITA} horas antes. ` +
+            "Con forzar se sale con una penalización de tu parte: solo si el socio ha aceptado expresamente la penalización.",
+          );
+        }
+        p.penalizaciones.push({ socioId: quien.id, importe: p.importePorJugador });
+      }
+      p.jugadores.splice(indice, 1);
+      p.plazasLibres = JUGADORES_POR_PARTIDO - p.jugadores.length;
+      if (p.estado === "completo" && p.jugadores.length < JUGADORES_POR_PARTIDO) p.estado = "abierto";
+      sincronizar();
+      return { partido: p };
+    },
+
+    cancelarPartido(id: string, quien: Socio | undefined, datos: { forzar?: unknown }) {
+      sincronizar();
+      if (!quien) throw new ErrorDelClub("NO_IDENTIFICADO", "Para cancelar un partido hay que identificarse con X-Socio", 401);
+      const p = partido(id);
+      comprobarForzar(datos.forzar);
+      if (quien.id !== p.organizador && quien.rol !== "gestor") {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo el organizador o un gestor puede cancelar el partido", 403);
+      }
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido ya estaba cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      const horas = horasEntre(estado.ahora, p.inicio);
+      const fueraDePlazo = horas < HORAS_CANCELACION_GRATUITA;
+      if (fueraDePlazo && datos.forzar !== true) {
+        throw new ErrorDelClub(
+          "FUERA_DE_PLAZO",
+          `Faltan ${Math.floor(horas)} horas para el partido y la cancelación gratuita termina ${HORAS_CANCELACION_GRATUITA} horas antes. ` +
+          "Con forzar se cancela con una penalización del 100 % del importe: solo si el socio ha aceptado expresamente la penalización.",
+        );
+      }
+      p.estado = "cancelado";
+      p.motivo = "organizador";
+      const suya = estado.reservas.find((r) => r.id === p.reservaId);
+      if (suya) {
+        suya.estado = "cancelada";
+        if (fueraDePlazo) suya.penalizacion = suya.importe;
+      }
+      return { partido: p };
+    },
   };
 }
 
