+      const abiertas = t.pistas.filter((pistaId) => estado.pistas.find((p) => p.id === pistaId)?.estado !== "cerrada");
+      if (!calendario(partidos, abiertas, t.franjas, estado.ahora)) {
+        throw new ErrorDelClub("FRANJAS_INSUFICIENTES", "No hay franjas y pistas suficientes para todos los partidos del torneo");
+      }
+      for (const partido of partidos) partido.id = nuevoId("P");
+      t.partidos = partidos;
+      t.estado = "en_juego";
+      return { torneo: t };
+    },
+
+    resultado(quien: Socio | undefined, id: string, partidoId: string, datos: Record<string, unknown>) {
+      exigirGestor(quien);
+      const t = torneo(id);
+      const { ganadora, marcador } = datos;
+      if (typeof ganadora !== "string" || (marcador !== undefined && marcador !== null && typeof marcador !== "string")) {
+        invalido("ganadora es el id de la inscripción que gana, y marcador, un texto (opcional)");
+      }
+      if (t.estado !== "en_juego") throw new ErrorDelClub("TORNEO_NO_EN_JUEGO", "Solo se apuntan resultados de un torneo en juego");
+      const partido = t.partidos.find((p) => p.id === partidoId);
+      if (!partido) throw new ErrorDelClub("PARTIDO_NO_ENCONTRADO", `No existe el partido ${partidoId} en este torneo`, 404);
+      if (partido.estado === "descanso" || partido.parejas.includes(null)) {
+        throw new ErrorDelClub("PARTIDO_NO_LISTO", "El partido aún no tiene sus dos parejas");
+      }
+      if (!partido.parejas.includes(ganadora)) invalido("ganadora debe ser una de las dos parejas del partido");
+      if (partido.inicio! > estado.ahora) throw new ErrorDelClub("PARTIDO_NO_EMPEZADO", "El partido todavía no ha empezado");
+      const siguiente = siguienteDe(t.partidos, partido);
+      if (partido.estado === "jugado" && siguiente?.partido.estado === "jugado") {
+        throw new ErrorDelClub("RESULTADO_CERRADO", "La pareja ya ha jugado la ronda siguiente: el resultado no se puede cambiar");
+      }
+      partido.ganadora = ganadora;
+      partido.marcador = typeof marcador === "string" ? marcador : null;
+      partido.estado = "jugado";
+      if (siguiente) {
+        siguiente.partido.parejas[siguiente.slot] = ganadora;
+      } else {
+        t.estado = "terminado";
+        t.campeona = ganadora;
+      }
+      return { partido };
+    },
+
+    cancelar(quien: Socio | undefined, id: string) {
+      exigirGestor(quien);
+      const t = torneo(id);
+      if (t.estado === "terminado") throw new ErrorDelClub("TORNEO_TERMINADO", "Un torneo terminado no se cancela");
+      if (t.estado === "cancelado") throw new ErrorDelClub("YA_CANCELADO", "El torneo ya estaba cancelado");
+      t.estado = "cancelado";
+      return { torneo: t };
+    },
+  };
+}
+
+export type Torneos = ReturnType<typeof crearTorneos>;
