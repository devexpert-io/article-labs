+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+// Socios con la cuota al día (socio-011, socio-022 y socio-033 no la tienen).
+const PAREJAS = [
+  ["socio-001", "socio-003"],
+  ["socio-006", "socio-007"],
+  ["socio-008", "socio-009"],
+  ["socio-010", "socio-012"],
+  ["socio-013", "socio-014"],
+];
+const DIA = "2026-11-25";
+const F9 = `${DIA}T09:00`;
+const F1030 = `${DIA}T10:30`;
+const F12 = `${DIA}T12:00`;
+
+async function conApi(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function torneoBase(cambios: Record<string, unknown> = {}) {
+  return { nombre: "Torneo de otoño", pistas: ["pista-1", "pista-2"], franjas: [F9, F1030, F12], plazas: 8, cuota: 1500, ...cambios };
+}
+
+async function crear(api: Api, cuerpo = torneoBase()): Promise<any> {
+  const r = await api.pedir("POST", "/api/torneos", { cuerpo, socio: GESTOR });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.torneo;
+}
+
+function inscribir(api: Api, torneoId: string, socios: string[], socio = GESTOR) {
+  return api.pedir("POST", `/api/torneos/${torneoId}/inscripciones`, { cuerpo: { socios }, socio });
+}
+
+async function inscribirTodas(api: Api, torneoId: string): Promise<string[]> {
+  const ids: string[] = [];
+  for (const pareja of PAREJAS) {
+    const r = await inscribir(api, torneoId, pareja);
+    assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+    ids.push(r.cuerpo.inscripcion.id);
+  }
+  return ids;
+}
+
+function cerrar(api: Api, torneoId: string, socio = GESTOR) {
+  return api.pedir("POST", `/api/torneos/${torneoId}/cerrar`, { socio });
+}
+
+function apuntar(api: Api, torneoId: string, partidoId: string, ganadora: string, marcador?: string) {
+  return api.pedir("POST", `/api/torneos/${torneoId}/partidos/${partidoId}/resultado`, {
+    cuerpo: marcador === undefined ? { ganadora } : { ganadora, marcador },
+    socio: GESTOR,
+  });
+}
+
+async function leer(api: Api, torneoId: string): Promise<any> {
+  return (await api.pedir("GET", `/api/torneos/${torneoId}`)).cuerpo.torneo;
+}
+
+function partido(torneo: any, ronda: number, numero: number): any {
+  return torneo.partidos.find((p: any) => p.ronda === ronda && p.numero === numero);
+}
+
+async function franjaDe(api: Api, pistaId: string, inicio: string): Promise<any> {
+  const disp = (await api.pedir("GET", `/api/disponibilidad?fecha=${inicio.slice(0, 10)}&pista=${pistaId}`)).cuerpo;
+  return disp.pistas[0].franjas.find((f: any) => f.inicio === inicio);
+}
