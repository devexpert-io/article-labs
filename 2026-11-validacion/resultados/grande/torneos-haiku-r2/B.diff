+      }
+      if (conflictos.length > 0) {
+        throw new ErrorDelClub("FRANJAS_OCUPADAS", "Hay franjas ocupadas o bloqueadas por otro torneo", 409, { conflictos });
+      }
+
+      const nuevo: Torneo = {
+        id: `TOR-${String(estado.torneos.length + 1).padStart(3, "0")}`,
+        nombre: nombre.trim(),
+        pistas: [...pistas],
+        franjas: [...franjas].sort(),
+        plazas,
+        cuota,
+        estado: "inscripcion",
+        inscripciones: [],
+        partidos: [],
+        campeona: null,
+        bloqueos: ps.flatMap((p) => franjas.map((f) => ({ pistaId: p.id, inicio: f }))),
+      };
+      estado.torneos.push(nuevo);
+      return { torneo: vistaTorneo(nuevo) };
+    },
+
+    inscribir(id: string, datos: Record<string, unknown>, quien: Socio | undefined) {
+      const yo = exigirIdentificado(quien);
+      const t = torneo(id);
+      const ids = datos.socios;
+      if (
+        !Array.isArray(ids) || ids.length !== 2 || typeof ids[0] !== "string" || typeof ids[1] !== "string" || ids[0] === ids[1]
+      ) {
+        invalido("socios debe ser una lista con los ids de dos socios distintos");
+      }
+      const parejaIds = ids as string[];
+      if (yo.rol !== "gestor" && !parejaIds.includes(yo.id)) {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo puede inscribir a una pareja uno de sus socios o un gestor", 403);
+      }
+      if (!inscripcionAbierta(t)) {
+        throw new ErrorDelClub("INSCRIPCION_CERRADA", "La inscripción no está abierta: el torneo no está en inscripción o faltan menos de 48 horas");
+      }
+      for (const socioId of parejaIds) {
+        const socio = estado.socios.find((s) => s.id === socioId);
+        if (!socio) throw new ErrorDelClub("SOCIO_NO_ENCONTRADO", `No existe el socio ${socioId}`, 404);
+        if (!socio.cuotaActiva) throw new ErrorDelClub("CUOTA_INACTIVA", "Un socio de la pareja no tiene la cuota al día");
+      }
+      const yaInscrito = t.inscripciones.some((i) => i.estado === "inscrita" && i.socios.some((s) => parejaIds.includes(s)));
+      if (yaInscrito) throw new ErrorDelClub("YA_INSCRITO", "Uno de los socios ya está inscrito en este torneo");
+      if (t.inscripciones.filter((i) => i.estado === "inscrita").length >= t.plazas) {
+        throw new ErrorDelClub("TORNEO_COMPLETO", "No quedan plazas en el torneo");
+      }
+      const nueva: Inscripcion = {
+        id: `${t.id}-I${String(t.inscripciones.length + 1).padStart(2, "0")}`,
+        socios: parejaIds,
+        estado: "inscrita",
+        importe: t.cuota,
+      };
+      t.inscripciones.push(nueva);
+      return { inscripcion: nueva };
+    },
+
+    darDeBaja(id: string, inscripcionId: string, quien: Socio | undefined) {
+      const yo = exigirIdentificado(quien);
+      const t = torneo(id);
+      const inscripcion = t.inscripciones.find((i) => i.id === inscripcionId);
+      if (!inscripcion) throw new ErrorDelClub("INSCRIPCION_NO_ENCONTRADA", `No existe la inscripción ${inscripcionId} en ${id}`, 404);
+      if (yo.rol !== "gestor" && !inscripcion.socios.includes(yo.id)) {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo puede dar de baja a una pareja uno de sus socios o un gestor", 403);
+      }
+      if (inscripcion.estado === "baja") throw new ErrorDelClub("YA_DE_BAJA", "La inscripción ya estaba de baja");
+      if (!inscripcionAbierta(t)) {
+        throw new ErrorDelClub("INSCRIPCION_CERRADA", "La inscripción no está abierta: el torneo no está en inscripción o faltan menos de 48 horas");
+      }
+      inscripcion.estado = "baja";
+      return { inscripcion };
+    },
+
+    cerrarTorneo(id: string, quien: Socio | undefined) {
+      const yo = exigirIdentificado(quien);
+      const t = torneo(id);
+      exigirGestorDe(yo);
+      if (t.estado !== "inscripcion") throw new ErrorDelClub("TORNEO_NO_EN_INSCRIPCION", "El torneo no está en inscripción");
+      const inscritas = t.inscripciones.filter((i) => i.estado === "inscrita");
+      if (inscritas.length < 2) throw new ErrorDelClub("PAREJAS_INSUFICIENTES", "Hacen falta al menos 2 parejas inscritas");
+      const { partidos, bloqueos } = generarCuadro(t, inscritas, estado.ahora);
+      // Solo llegamos aquí si el cuadro cabe: ahora sí se guarda todo.
+      t.partidos = partidos;
+      t.bloqueos = bloqueos;
+      t.estado = "en_juego";
+      return { torneo: vistaTorneo(t) };
+    },
+
+    apuntarResultado(id: string, partidoId: string, datos: Record<string, unknown>, quien: Socio | undefined) {
+      const yo = exigirIdentificado(quien);
+      const t = torneo(id);
+      exigirGestorDe(yo);
+      const { ganadora, marcador } = datos;
+      if (typeof ganadora !== "string") invalido("ganadora es el id de la pareja que gana");
+      if (marcador !== undefined && marcador !== null && typeof marcador !== "string") invalido("marcador debe ser un texto");
+      const partido = t.partidos.find((p) => p.id === partidoId);
+      if (!partido) throw new ErrorDelClub("PARTIDO_NO_ENCONTRADO", `No existe el partido ${partidoId} en ${id}`, 404);
+      if (t.estado !== "en_juego") throw new ErrorDelClub("TORNEO_NO_EN_JUEGO", "El torneo no está en juego");
+      if (partido.estado === "descanso" || partido.parejas.includes(null)) {
+        throw new ErrorDelClub("PARTIDO_NO_LISTO", "El partido todavía no tiene sus dos parejas");
+      }
+      if (!partido.parejas.includes(ganadora)) invalido("ganadora debe ser una de las parejas del partido");
+      if (partido.inicio! > estado.ahora) throw new ErrorDelClub("PARTIDO_NO_EMPEZADO", "El partido todavía no ha empezado");
+      const siguiente = siguienteDe(t.partidos, partido);
+      if (siguiente && siguiente.partido.estado === "jugado") {
+        throw new ErrorDelClub("RESULTADO_CERRADO", "La pareja ya ha jugado la siguiente ronda");
+      }
+
+      partido.ganadora = ganadora;
+      partido.marcador = (marcador as string | undefined) ?? null;
+      partido.estado = "jugado";
+      if (siguiente) {
+        siguiente.partido.parejas[siguiente.hueco] = ganadora;
+      } else {
+        t.estado = "terminado";
+        t.campeona = ganadora;
+      }
+      return { partido };
+    },
+
+    cancelarTorneo(id: string, quien: Socio | undefined) {
+      const yo = exigirIdentificado(quien);
+      const t = torneo(id);
+      exigirGestorDe(yo);
+      if (t.estado === "terminado") throw new ErrorDelClub("TORNEO_TERMINADO", "Un torneo terminado no se puede cancelar");
+      if (t.estado === "cancelado") throw new ErrorDelClub("YA_CANCELADO", "El torneo ya estaba cancelado");
+      t.estado = "cancelado";
+      t.bloqueos = [];
+      return { torneo: vistaTorneo(t) };
+    },
   };
 }
 
