+
+/** El partido de la ronda siguiente al que va la ganadora de `p`, y en qué hueco (0 o 1). */
+function siguienteDe(partidos: Partido[], p: Partido): { partido: Partido; hueco: 0 | 1 } | undefined {
+  const M = partidos.filter((x) => x.ronda === p.ronda).length;
+  const primeraMitad = p.numero <= M / 2;
+  const numero = primeraMitad ? p.numero : M + 1 - p.numero;
+  const partido = partidos.find((x) => x.ronda === p.ronda + 1 && x.numero === numero);
+  return partido ? { partido, hueco: primeraMitad ? 0 : 1 } : undefined;
+}
+
+/** Los partidos de la ronda anterior de los que salen las parejas de `p` (sin los descansos). */
+function alimentadores(partidos: Partido[], p: Partido): Partido[] {
+  if (p.ronda === 1) return [];
+  const anterior = partidos.filter((x) => x.ronda === p.ronda - 1);
+  const M = anterior.length;
+  return [p.numero, M + 1 - p.numero]
+    .map((n) => anterior.find((x) => x.numero === n)!)
+    .filter((x) => x.estado !== "descanso");
+}
+
+/** Forma el cuadro completo y le da pista y franja a cada partido que no es descanso. Lanza si no caben. */
+function generarCuadro(t: Torneo, inscritas: Inscripcion[], ahora: string): { partidos: Partido[]; bloqueos: Bloqueo[] } {
+  const n = inscritas.length;
+  let T = 2;
+  while (T < n) T *= 2;
+  const rondas = Math.log2(T);
+
+  const partidos: Partido[] = [];
+  for (let r = 1; r <= rondas; r++) {
+    for (let numero = 1; numero <= T / 2 ** r; numero++) {
+      partidos.push({
+        id: `${t.id}-R${r}-P${numero}`,
+        ronda: r,
+        numero,
+        parejas: [null, null],
+        estado: "pendiente",
+        ganadora: null,
+        marcador: null,
+        pistaId: null,
+        inicio: null,
+      });
+    }
+  }
+
+  for (let i = 1; i <= T / 2; i++) {
+    const p = partidos.find((x) => x.ronda === 1 && x.numero === i)!;
+    const a = inscritas[i - 1]!.id;
+    const bi = T + 1 - i;
+    const b = bi <= n ? inscritas[bi - 1]!.id : null;
+    p.parejas = [a, b];
+    if (b === null) {
+      p.estado = "descanso";
+      p.ganadora = a;
+    }
+  }
+  // Las ganadoras de los descansos pasan a la ronda siguiente al cerrar.
+  for (const p of partidos.filter((x) => x.estado === "descanso")) {
+    const siguiente = siguienteDe(partidos, p);
+    if (siguiente) siguiente.partido.parejas[siguiente.hueco] = p.ganadora;
+  }
+
+  // Calendario: por ronda y, dentro de la ronda, por número. Cada partido toma la primera
+  // combinación de franja (en orden) y pista (en orden de `pistas`) libre y que empiece a tiempo.
+  const usados = new Set<string>();
+  const bloqueos: Bloqueo[] = [];
+  const combinaciones = t.franjas.flatMap((franja) => t.pistas.map((pistaId) => ({ pistaId, inicio: franja })));
+  for (const p of partidos) {
+    if (p.estado === "descanso") continue;
+    const fines = alimentadores(partidos, p).map((x) => finDeFranja(x.inicio!));
+    const minimo = fines.length ? fines.reduce((a, b) => (a > b ? a : b)) : undefined;
+    const elegida = combinaciones.find(
+      (c) => !usados.has(`${c.pistaId}|${c.inicio}`) && c.inicio > ahora && (minimo === undefined || c.inicio >= minimo),
+    );
+    if (!elegida) {
+      throw new ErrorDelClub("FRANJAS_INSUFICIENTES", "No hay franjas y pistas para todos los partidos del cuadro");
+    }
+    usados.add(`${elegida.pistaId}|${elegida.inicio}`);
+    p.pistaId = elegida.pistaId;
+    p.inicio = elegida.inicio;
+    bloqueos.push({ pistaId: elegida.pistaId, inicio: elegida.inicio });
+  }
+  return { partidos, bloqueos };
+}
