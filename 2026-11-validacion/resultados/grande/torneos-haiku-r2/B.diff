--- /dev/null
+++ b/test/torneos.test.ts
@@ -0,0 +1,403 @@
+// Los torneos de parejas, probados a través de la API.
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const DIA = "2026-11-28"; // sin reservas en la semilla
+
+async function arrancar(t: TestContext): Promise<Api> {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+function torneoCuerpo(extra: Record<string, unknown> = {}) {
+  return {
+    nombre: "Open de otoño",
+    pistas: ["pista-1", "pista-2"],
+    franjas: [`${DIA}T09:00`, `${DIA}T10:30`],
+    plazas: 8,
+    cuota: 2000,
+    ...extra,
+  };
+}
+
+async function crear(api: Api, extra: Record<string, unknown> = {}) {
+  const r = await api.pedir("POST", "/api/torneos", { socio: GESTOR, cuerpo: torneoCuerpo(extra) });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.torneo;
+}
+
+async function inscribir(api: Api, tid: string, socios: string[]) {
+  return api.pedir("POST", `/api/torneos/${tid}/inscripciones`, { socio: socios[0], cuerpo: { socios } });
+}
+
+async function reloj(api: Api, ahora: string) {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+}
+
+async function cerrar(api: Api, tid: string) {
+  return api.pedir("POST", `/api/torneos/${tid}/cerrar`, { socio: GESTOR });
+}
+
+async function resultado(api: Api, tid: string, partidoId: string, ganadora: string, marcador?: string) {
+  return api.pedir("POST", `/api/torneos/${tid}/partidos/${partidoId}/resultado`, {
+    socio: GESTOR,
+    cuerpo: marcador === undefined ? { ganadora } : { ganadora, marcador },
+  });
+}
+
+/** Ocho parejas con socios activos: [socio-001, socio-002], [socio-003, socio-004], ... */
+const OCHO_PAREJAS = [
+  ["socio-001", "socio-002"], ["socio-003", "socio-004"], ["socio-005", "socio-006"], ["socio-007", "socio-008"],
+  ["socio-009", "socio-010"], ["socio-012", "socio-013"], ["socio-014", "socio-015"], ["socio-016", "socio-017"],
+];
+
+test("permisos: crear, cerrar, cancelar y apuntar resultados solo para el gestor; consultar sin identificarse", async (t) => {
+  const api = await arrancar(t);
+  assert.equal((await api.pedir("POST", "/api/torneos", { cuerpo: torneoCuerpo() })).cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const sinPermiso = await api.pedir("POST", "/api/torneos", { socio: "socio-001", cuerpo: torneoCuerpo() });
+  assert.equal(sinPermiso.status, 403);
+  assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+  const tor = await crear(api);
+  assert.equal((await api.pedir("POST", `/api/torneos/${tor.id}/cerrar`, { socio: "socio-001" })).status, 403);
+  assert.equal((await api.pedir("POST", `/api/torneos/${tor.id}/cancelar`)).cuerpo.error.codigo, "NO_IDENTIFICADO");
+  assert.equal((await api.pedir("GET", "/api/torneos")).status, 200);
+  assert.equal((await api.pedir("GET", `/api/torneos/${tor.id}`)).status, 200);
+});
+
+test("permisos al inscribir y dar de baja: uno de los dos socios o un gestor", async (t) => {
+  const api = await arrancar(t);
+  const tor = await crear(api);
+  const ajena = await api.pedir("POST", `/api/torneos/${tor.id}/inscripciones`, { socio: "socio-003", cuerpo: { socios: ["socio-001", "socio-002"] } });
+  assert.equal(ajena.status, 403);
+  const propia = await inscribir(api, tor.id, ["socio-001", "socio-002"]);
+  assert.equal(propia.status, 201);
+  const bajaAjena = await api.pedir("POST", `/api/torneos/${tor.id}/inscripciones/${propia.cuerpo.inscripcion.id}/baja`, { socio: "socio-003" });
+  assert.equal(bajaAjena.cuerpo.error.codigo, "SIN_PERMISO");
+  const bajaGestor = await api.pedir("POST", `/api/torneos/${tor.id}/inscripciones/${propia.cuerpo.inscripcion.id}/baja`, { socio: GESTOR });
+  assert.equal(bajaGestor.status, 200);
+});
+
+test("datos del torneo: validación, pistas, franjas pasadas y pistas cerradas", async (t) => {
+  const api = await arrancar(t);
+  const pedir = (extra: Record<string, unknown>) => api.pedir("POST", "/api/torneos", { socio: GESTOR, cuerpo: torneoCuerpo(extra) });
+  assert.equal((await pedir({ nombre: "  " })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await pedir({ pistas: [] })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await pedir({ pistas: ["pista-1", "pista-1"] })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await pedir({ plazas: 3 })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await pedir({ plazas: 17 })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await pedir({ cuota: -1 })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await pedir({ pistas: ["pista-9"] })).cuerpo.error.codigo, "PISTA_NO_ENCONTRADA");
+  const invalida = await pedir({ franjas: [`${DIA}T09:15`] });
+  assert.equal(invalida.status, 400);
+  assert.equal(invalida.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  for (const imposible of ["2026-13-45T09:00", "2027-02-30T09:00"]) {
+    const fecha = await pedir({ franjas: [imposible] });
+    assert.equal(fecha.status, 400, imposible);
+    assert.equal(fecha.cuerpo.error.codigo, "FRANJA_INVALIDA", imposible);
+  }
+  const pasada = await pedir({ franjas: ["2026-11-18T09:00"] });
+  assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+  const cerrada = await pedir({ pistas: ["pista-4"] });
+  assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+  const lista = await api.pedir("GET", "/api/torneos");
+  assert.deepEqual(lista.cuerpo.torneos, [], "ninguno de los intentos anteriores crea torneo");
+});
+
+test("franjas ocupadas por una reserva o por otro torneo, con sus conflictos", async (t) => {
+  const api = await arrancar(t);
+  const reservas = await api.pedir("GET", "/api/reservas?fecha=2026-11-19&pista=pista-1");
+  const reservaId = reservas.cuerpo.reservas.find((r: { inicio: string }) => r.inicio.endsWith("19:30")).id;
+  const choque = await api.pedir("POST", "/api/torneos", {
+    socio: GESTOR,
+    cuerpo: torneoCuerpo({ pistas: ["pista-1"], franjas: ["2026-11-19T19:30"] }),
+  });
+  assert.equal(choque.status, 409);
