+/** Si la fecha del texto `AAAA-MM-DD…` existe en el calendario (ni 2026-02-30 ni 2026-13-01). */
+function fechaExiste(texto: string): boolean {
+  const [anio, mes, dia] = texto.slice(0, 10).split("-").map(Number) as [number, number, number];
+  const d = new Date(0);
+  d.setUTCFullYear(anio, mes - 1, dia);
+  return d.getUTCFullYear() === anio && d.getUTCMonth() === mes - 1 && d.getUTCDate() === dia;
