+          const t = torneoEn(pistaId, inicio);
+          if (t) conflictos.push({ pistaId, inicio, torneoId: t.id });
+        }
+      }
+      if (conflictos.length > 0) {
+        throw new ErrorDelClub("FRANJAS_OCUPADAS", "Algunas franjas ya están reservadas o las bloquea otro torneo", 409, { conflictos });
+      }
+      const nuevo: Torneo = {
+        id: `T-${String(estado.torneos.length + 1).padStart(3, "0")}`,
+        nombre: nombre.trim(),
+        pistas: idsPistas,
+        franjas: ordenadas,
+        plazas: plazas as number,
+        cuota: cuota as number,
+        estado: "inscripcion",
+        inscripciones: [],
+        partidos: [],
+        campeona: null,
+      };
+      estado.torneos.push(nuevo);
+      return { torneo: nuevo };
+    },
+
+    listarTorneos(filtro?: string) {
+      if (filtro !== undefined && !ESTADOS_TORNEO.includes(filtro as EstadoTorneo)) {
+        invalido(`estado debe ser uno de estos: ${ESTADOS_TORNEO.join(", ")}`);
+      }
+      const torneos = estado.torneos
+        .filter((t) => filtro === undefined || t.estado === filtro)
+        .sort((a, b) => a.franjas[0]!.localeCompare(b.franjas[0]!))
+        .map((t) => ({ id: t.id, nombre: t.nombre, estado: t.estado, plazas: t.plazas, cuota: t.cuota, inscritas: inscritas(t).length }));
+      return { torneos };
+    },
+
+    obtenerTorneo(id: string) {
+      return { torneo: torneo(id) };
+    },
+
+    inscribir(quien: Socio | undefined, torneoId: string, datos: { socios?: unknown }) {
+      identificado(quien);
+      const t = torneo(torneoId);
+      const { socios } = datos;
+      if (!Array.isArray(socios) || socios.length !== 2 || !socios.every((s) => typeof s === "string") || socios[0] === socios[1]) {
+        invalido("socios debe ser una lista con dos ids de socio distintos");
+      }
+      const ids = socios as [string, string];
+      deLaPareja(quien, ids);
+      const pareja = ids.map((id) => {
+        const s = estado.socios.find((x) => x.id === id);
+        if (!s) throw new ErrorDelClub("SOCIO_NO_ENCONTRADO", `No existe el socio ${id}`, 404);
+        return s;
+      });
+      exigirPlazo(t);
+      const sinCuota = pareja.find((s) => !s.cuotaActiva);
+      if (sinCuota) throw new ErrorDelClub("CUOTA_INACTIVA", `${sinCuota.nombre} no tiene la cuota al día`);
+      const yaInscrito = pareja.find((s) => inscritas(t).some((i) => i.socios.includes(s.id)));
+      if (yaInscrito) throw new ErrorDelClub("YA_INSCRITO", `${yaInscrito.nombre} ya está inscrito en este torneo`);
+      if (inscritas(t).length >= t.plazas) throw new ErrorDelClub("TORNEO_COMPLETO", `El torneo ya tiene sus ${t.plazas} parejas`);
+      const inscripcion: Inscripcion = {
+        id: `I-${String(totalInscripciones() + 1).padStart(4, "0")}`,
+        socios: [ids[0], ids[1]],
+        estado: "inscrita",
+        importe: t.cuota,
+      };
+      t.inscripciones.push(inscripcion);
+      return { inscripcion };
+    },
+
+    darDeBaja(quien: Socio | undefined, torneoId: string, inscripcionId: string) {
+      identificado(quien);
+      const t = torneo(torneoId);
+      const inscripcion = t.inscripciones.find((i) => i.id === inscripcionId);
+      if (!inscripcion) throw new ErrorDelClub("INSCRIPCION_NO_ENCONTRADA", `No existe la inscripción ${inscripcionId} en ${t.id}`, 404);
+      deLaPareja(quien, inscripcion.socios);
+      exigirPlazo(t);
+      if (inscripcion.estado === "baja") throw new ErrorDelClub("YA_DE_BAJA", "La pareja ya estaba de baja");
+      inscripcion.estado = "baja";
+      return { inscripcion };
+    },
+
+    cerrarTorneo(quien: Socio | undefined, torneoId: string) {
+      gestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado !== "inscripcion") throw new ErrorDelClub("TORNEO_NO_EN_INSCRIPCION", "El torneo no está en inscripción");
+      if (inscritas(t).length < 2) throw new ErrorDelClub("PAREJAS_INSUFICIENTES", "Hacen falta al menos 2 parejas inscritas");
+      t.partidos = generarCuadro(t);
+      t.estado = "en_juego";
+      return { torneo: t };
+    },
+
+    apuntarResultado(quien: Socio | undefined, torneoId: string, partidoId: string, datos: { ganadora?: unknown; marcador?: unknown }) {
+      gestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado !== "en_juego") throw new ErrorDelClub("TORNEO_NO_EN_JUEGO", "El torneo no está en juego");
+      const p = t.partidos.find((x) => x.id === partidoId);
+      if (!p) throw new ErrorDelClub("PARTIDO_NO_ENCONTRADO", `No existe el partido ${partidoId} en ${t.id}`, 404);
+      if (p.estado === "descanso" || p.parejas[0] === null || p.parejas[1] === null) {
+        throw new ErrorDelClub("PARTIDO_NO_LISTO", "El partido todavía no tiene sus dos parejas");
+      }
+      const { ganadora, marcador } = datos;
+      if (typeof ganadora !== "string" || !p.parejas.includes(ganadora)) invalido("ganadora debe ser una de las dos parejas del partido");
+      if (marcador !== undefined && marcador !== null && typeof marcador !== "string") invalido("marcador debe ser un texto");
+      if (p.inicio! > estado.ahora) throw new ErrorDelClub("PARTIDO_NO_EMPEZADO", "El partido todavía no ha empezado");
+      const sig = siguiente(t, p);
+      if (sig && sig.partido.estado === "jugado") {
+        throw new ErrorDelClub("RESULTADO_CERRADO", "El partido siguiente ya se ha jugado: este resultado no se puede cambiar");
+      }
+      p.ganadora = ganadora;
+      p.marcador = (marcador as string | null | undefined) ?? null;
+      p.estado = "jugado";
+      if (sig) {
+        sig.partido.parejas[sig.hueco] = ganadora;
+      } else {
+        t.estado = "terminado";
+        t.campeona = ganadora;
+      }
+      return { partido: p };
+    },
+
+    cancelarTorneo(quien: Socio | undefined, torneoId: string) {
+      gestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado === "terminado") throw new ErrorDelClub("TORNEO_TERMINADO", "El torneo ya ha terminado");
+      if (t.estado === "cancelado") throw new ErrorDelClub("YA_CANCELADO", "El torneo ya estaba cancelado");
+      t.estado = "cancelado";
+      return { torneo: t };
+    },
   };
 }
 
