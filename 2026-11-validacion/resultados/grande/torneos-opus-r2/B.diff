+++ b/test/torneos.test.ts
@@ -0,0 +1,490 @@
+// Torneos de parejas por eliminación directa (docs/specs/torneos.md), probados a través de la API.
+import assert from "node:assert/strict";
+import { after, afterEach, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const AHORA = "2026-11-18T10:00";
+// Socios con la cuota al día (socio-011, socio-022 y socio-033 no la tienen).
+const PAREJAS: [string, string][] = [
+  ["socio-001", "socio-002"], ["socio-003", "socio-004"], ["socio-005", "socio-006"], ["socio-007", "socio-008"],
+  ["socio-009", "socio-010"], ["socio-012", "socio-013"], ["socio-014", "socio-015"], ["socio-016", "socio-017"],
+];
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+afterEach(() => reloj(AHORA));
+
+async function reloj(ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+/** Crea un torneo como gestor. Por defecto, en las pistas 1 y 2 y con cuatro franjas del día dado (sin reservas en la semilla). */
+async function crearTorneo(dia: string, extra: Record<string, unknown> = {}) {
+  const r = await api.pedir("POST", "/api/torneos", {
+    socio: GESTOR,
+    cuerpo: {
+      nombre: `Torneo ${dia}`,
+      pistas: ["pista-1", "pista-2"],
+      franjas: [`${dia}T09:00`, `${dia}T10:30`, `${dia}T12:00`, `${dia}T13:30`],
+      plazas: 8,
+      cuota: 3000,
+      ...extra,
+    },
+  });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.torneo;
+}
+
+async function inscribir(torneoId: string, n: number): Promise<string[]> {
+  const ids: string[] = [];
+  for (const socios of PAREJAS.slice(0, n)) {
+    const r = await api.pedir("POST", `/api/torneos/${torneoId}/inscripciones`, { socio: socios[0], cuerpo: { socios } });
+    assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+    ids.push(r.cuerpo.inscripcion.id);
+  }
+  return ids;
+}
+
+async function cerrar(torneoId: string) {
+  const r = await api.pedir("POST", `/api/torneos/${torneoId}/cerrar`, { socio: GESTOR });
+  assert.equal(r.status, 200, JSON.stringify(r.cuerpo));
+  return r.cuerpo.torneo;
+}
+
+async function resultado(torneoId: string, partidoId: string, ganadora: string | null, marcador?: string) {
+  return api.pedir("POST", `/api/torneos/${torneoId}/partidos/${partidoId}/resultado`, {
+    socio: GESTOR,
+    cuerpo: marcador === undefined ? { ganadora } : { ganadora, marcador },
+  });
+}
+
+async function verTorneo(id: string) {
+  return (await api.pedir("GET", `/api/torneos/${id}`)).cuerpo.torneo;
+}
+
+function codigo(r: { status: number; cuerpo: any }, http: number, esperado: string) {
+  assert.equal(r.status, http, JSON.stringify(r.cuerpo));
+  assert.equal(r.cuerpo.error.codigo, esperado);
+}
+
+async function franja(fecha: string, pistaId: string, hora: string) {
+  const r = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pistaId}`);
+  return r.cuerpo.pistas[0].franjas.find((f: any) => f.inicio === `${fecha}T${hora}`);
+}
+
+test("1. permisos: gestor para gestionar, la pareja o un gestor para inscribirse, nadie para consultar", async () => {
+  const datos = { nombre: "X", pistas: ["pista-1"], franjas: ["2026-11-25T09:00"], plazas: 4, cuota: 0 };
+  codigo(await api.pedir("POST", "/api/torneos", { cuerpo: datos }), 401, "NO_IDENTIFICADO");
+  codigo(await api.pedir("POST", "/api/torneos", { socio: "socio-001", cuerpo: datos }), 403, "SIN_PERMISO");
+  const t = await crearTorneo("2026-11-25");
+  assert.equal((await api.pedir("GET", "/api/torneos")).status, 200);
+  assert.equal((await api.pedir("GET", `/api/torneos/${t.id}`)).status, 200);
+
+  const ruta = `/api/torneos/${t.id}/inscripciones`;
+  codigo(await api.pedir("POST", ruta, { cuerpo: { socios: PAREJAS[0] } }), 401, "NO_IDENTIFICADO");
+  codigo(await api.pedir("POST", ruta, { socio: "socio-003", cuerpo: { socios: PAREJAS[0] } }), 403, "SIN_PERMISO");
+  const propia = await api.pedir("POST", ruta, { socio: "socio-002", cuerpo: { socios: PAREJAS[0] } });
+  assert.equal(propia.status, 201);
+  const porGestor = await api.pedir("POST", ruta, { socio: GESTOR, cuerpo: { socios: PAREJAS[1] } });
+  assert.equal(porGestor.status, 201);
+
+  const baja = (id: string) => `/api/torneos/${t.id}/inscripciones/${id}/baja`;
+  codigo(await api.pedir("POST", baja(propia.cuerpo.inscripcion.id)), 401, "NO_IDENTIFICADO");
+  codigo(await api.pedir("POST", baja(propia.cuerpo.inscripcion.id), { socio: "socio-003" }), 403, "SIN_PERMISO");
+  assert.equal((await api.pedir("POST", baja(propia.cuerpo.inscripcion.id), { socio: "socio-001" })).status, 200);
+  assert.equal((await api.pedir("POST", baja(porGestor.cuerpo.inscripcion.id), { socio: GESTOR })).status, 200);
+
+  for (const accion of ["cerrar", "cancelar", "partidos/P-0001/resultado"]) {
+    codigo(await api.pedir("POST", `/api/torneos/${t.id}/${accion}`, { cuerpo: {} }), 401, "NO_IDENTIFICADO");
+    codigo(await api.pedir("POST", `/api/torneos/${t.id}/${accion}`, { socio: "socio-001", cuerpo: {} }), 403, "SIN_PERMISO");
+  }
+  assert.equal((await verTorneo(t.id)).estado, "inscripcion");
+});
+
+test("2. datos del torneo", async () => {
+  const base = { nombre: "Otoño", pistas: ["pista-1"], franjas: ["2026-11-26T09:00"], plazas: 4, cuota: 0 };
+  const crear = (cambios: Record<string, unknown>) => api.pedir("POST", "/api/torneos", { socio: GESTOR, cuerpo: { ...base, ...cambios } });
+  for (const cambios of [
+    { nombre: "" }, { nombre: "   " }, { nombre: 3 },
+    { pistas: [] }, { pistas: "pista-1" }, { pistas: ["pista-1", "pista-1"] },
+    { franjas: [] }, { franjas: ["2026-11-26T09:00", "2026-11-26T09:00"] },
+    { plazas: 3 }, { plazas: 17 }, { plazas: 4.5 }, { plazas: "8" },
+    { cuota: -1 }, { cuota: 10.5 }, { cuota: undefined },
+  ]) {
+    codigo(await crear(cambios), 400, "DATOS_INVALIDOS");
+  }
+  codigo(await crear({ pistas: ["pista-1", "pista-9"] }), 404, "PISTA_NO_ENCONTRADA");
+  codigo(await crear({ franjas: ["2026-11-26T09:15"] }), 400, "FRANJA_INVALIDA");
+  codigo(await crear({ franjas: ["mañana"] }), 400, "FRANJA_INVALIDA");
+  codigo(await crear({ franjas: ["2026-11-26T09:00", "2026-11-18T09:00"] }), 409, "FRANJA_PASADA");
+  assert.equal((await crear({ plazas: 16, cuota: 0, franjas: ["2026-11-26T10:30"] })).status, 201);
+  assert.equal((await crear({ plazas: 4, franjas: ["2026-11-26T12:00"] })).status, 201);
+});
+
+test("2. una franja que ya ha empezado es FRANJA_PASADA", async () => {
+  await reloj("2026-11-27T09:00");
+  const r = await api.pedir("POST", "/api/torneos", {
+    socio: GESTOR,
+    cuerpo: { nombre: "Tarde", pistas: ["pista-1"], franjas: ["2026-11-27T10:30", "2026-11-27T09:00"], plazas: 4, cuota: 0 },
+  });
