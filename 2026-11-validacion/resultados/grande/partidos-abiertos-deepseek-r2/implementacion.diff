+      if (!jugador.cuotaActiva) throw new ErrorDelClub("CUOTA_INACTIVA", `${jugador.nombre} no tiene la cuota al día`);
+      if (p.nivelMin !== null) {
+        if (jugador.nivel === null) throw new ErrorDelClub("NIVEL_SIN_DEFINIR", "No has fijado tu nivel de juego");
+        if (!dentroDelRango(jugador.nivel, p.nivelMin, p.nivelMax!)) {
+          throw new ErrorDelClub("NIVEL_FUERA_DE_RANGO", `Tu nivel ${jugador.nivel} no está entre ${p.nivelMin} y ${p.nivelMax}`);
+        }
+      }
+      comprobarLimite(jugador.id);
+      p.jugadores.push(jugador.id);
+      p.plazasLibres = JUGADORES_PARTIDO - p.jugadores.length;
+      if (p.jugadores.length >= JUGADORES_PARTIDO) p.estado = "completo";
+      return { partido: p };
+    },
+
+    salirPartido(id: string, datos: { forzar?: unknown }, quien: Socio | undefined) {
+      const jugador = exigirIdentidad(quien);
+      if (datos.forzar !== undefined && typeof datos.forzar !== "boolean") invalido("forzar debe ser true o false");
+      const p = partido(id);
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      if (p.organizador === jugador.id) {
+        throw new ErrorDelClub("ORGANIZADOR_NO_PUEDE_SALIR", "El organizador no puede salir de su partido: tiene que cancelarlo");
+      }
+      const indice = p.jugadores.indexOf(jugador.id);
+      if (indice === -1) throw new ErrorDelClub("NO_APUNTADO", "No juegas en este partido");
+      const horas = horasEntre(estado.ahora, p.inicio);
+      if (horas < HORAS_CANCELACION_GRATUITA) {
+        if (datos.forzar !== true) {
+          throw new ErrorDelClub(
+            "FUERA_DE_PLAZO",
+            `Faltan ${Math.floor(horas)} horas para el partido y se sale sin coste hasta ${HORAS_CANCELACION_GRATUITA} horas antes. ` +
+            "Con forzar se sale pagando tu parte.",
+          );
+        }
+        p.penalizaciones.push({ socioId: jugador.id, importe: p.importePorJugador });
+      }
+      p.jugadores.splice(indice, 1);
+      p.plazasLibres = JUGADORES_PARTIDO - p.jugadores.length;
+      if (p.estado === "completo") p.estado = "abierto";
+      return { partido: p };
+    },
+
+    cancelarPartido(id: string, datos: { forzar?: unknown }, quien: Socio | undefined) {
+      const quienLlama = exigirIdentidad(quien);
+      if (datos.forzar !== undefined && typeof datos.forzar !== "boolean") invalido("forzar debe ser true o false");
+      const p = partido(id);
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.organizador !== quienLlama.id && !esGestor(quienLlama)) {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo el organizador o un gestor puede cancelar el partido", 403);
+      }
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      const horas = horasEntre(estado.ahora, p.inicio);
+      const r = reserva(p.reservaId);
+      if (horas < HORAS_CANCELACION_GRATUITA) {
+        if (datos.forzar !== true) {
+          throw new ErrorDelClub(
+            "FUERA_DE_PLAZO",
+            `Faltan ${Math.floor(horas)} horas para el partido y la cancelación gratuita termina ${HORAS_CANCELACION_GRATUITA} horas antes. ` +
+            "Con forzar se cancela con una penalización del 100 % del importe.",
+          );
+        }
+        r.penalizacion = r.importe;
+      }
+      p.estado = "cancelado";
+      p.motivo = "organizador";
+      cancelarReservaDePartido(r, "Partido cancelado por el organizador");
+      return { partido: p };
+    },
+
+    revisarPartidos,
   };
 }
 
