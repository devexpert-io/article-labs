diff --git a/test/partidos.test.ts b/test/partidos.test.ts
new file mode 100644
index 0000000..89b2ffe
--- /dev/null
+++ b/test/partidos.test.ts
@@ -0,0 +1,449 @@
+// Los partidos abiertos y sus reglas, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Arranca una API limpia para cada prueba, así los partidos y las reservas no se mezclan. */
+async function conApi(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const GESTOR = "socio-040";
+
+const crear = (api: Api, socio: string | undefined, pistaId: string, inicio: string, extra: Record<string, unknown> = {}) =>
+  api.pedir("POST", "/api/partidos", {
+    ...(socio ? { socio } : {}),
+    cuerpo: { pistaId, inicio, ...extra },
+  });
+
+const unirse = (api: Api, socio: string | undefined, id: string) =>
+  api.pedir("POST", `/api/partidos/${id}/unirse`, socio ? { socio } : undefined);
+
+const salir = (api: Api, socio: string | undefined, id: string, cuerpo: Record<string, unknown> = {}) =>
+  api.pedir("POST", `/api/partidos/${id}/salir`, { ...(socio ? { socio } : {}), cuerpo });
+
+const cancelar = (api: Api, socio: string | undefined, id: string, cuerpo: Record<string, unknown> = {}) =>
+  api.pedir("POST", `/api/partidos/${id}/cancelar`, { ...(socio ? { socio } : {}), cuerpo });
+
+const reloj = (api: Api, ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+
+const partido = async (api: Api, id: string) => (await api.pedir("GET", `/api/partidos/${id}`)).cuerpo.partido;
+const reserva = async (api: Api, id: string) => (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva;
+
+const nivelDe = async (api: Api, socio: string, nivel: number | null) => {
+  const r = await api.pedir("PATCH", `/api/socios/${socio}`, { socio, cuerpo: { nivel } });
+  assert.equal(r.status, 200, `fijar nivel de ${socio}`);
+  return r.cuerpo.socio;
+};
+
+test("nivel de los socios: lo fija el propio socio o un gestor, y sale en la consulta", () =>
+  conApi(async (api) => {
+    const fijado = await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-001", cuerpo: { nivel: 4.5 } });
+    assert.equal(fijado.status, 200);
+    assert.equal(fijado.cuerpo.socio.nivel, 4.5);
+
+    const buscado = await api.pedir("GET", "/api/socios?texto=socio-001");
+    assert.equal(buscado.cuerpo.socios[0].nivel, 4.5);
+    assert.equal((await api.pedir("GET", "/api/socios?texto=socio-002")).cuerpo.socios[0].nivel, null);
+
+    const quitado = await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-001", cuerpo: { nivel: null } });
+    assert.equal(quitado.cuerpo.socio.nivel, null);
+
+    for (const nivel of [0.5, 7.5, 3.2, "4", true]) {
+      const malo = await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-001", cuerpo: { nivel } });
+      assert.equal(malo.status, 400, `nivel ${JSON.stringify(nivel)}`);
+      assert.equal(malo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    const sinNivel = await api.pedir("PATCH", "/api/socios/socio-001", { socio: "socio-001", cuerpo: {} });
+    assert.equal(sinNivel.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    assert.equal((await api.pedir("PATCH", "/api/socios/socio-001", { cuerpo: { nivel: 3 } })).cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const ajeno = await api.pedir("PATCH", "/api/socios/socio-002", { socio: "socio-001", cuerpo: { nivel: 3 } });
+    assert.equal(ajeno.status, 403);
+    assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+    assert.equal((await api.pedir("PATCH", "/api/socios/socio-002", { socio: GESTOR, cuerpo: { nivel: 6 } })).cuerpo.socio.nivel, 6);
+
+    const noExiste = await api.pedir("PATCH", "/api/socios/socio-999", { socio: GESTOR, cuerpo: { nivel: 3 } });
+    assert.equal(noExiste.status, 404);
+    assert.equal(noExiste.cuerpo.error.codigo, "SOCIO_NO_ENCONTRADO");
+  }));
+
+test("crear un partido reserva la pista con las reglas y los errores de siempre", () =>
+  conApi(async (api) => {
+    const casos: Array<[string, string, string, string, number]> = [
+      ["socio-002", "pista-4", "2026-11-20T12:00", "PISTA_CERRADA", 409],
+      ["socio-011", "pista-1", "2026-11-20T12:00", "CUOTA_INACTIVA", 409],
+      ["socio-002", "pista-1", "2026-11-18T09:00", "FRANJA_PASADA", 409],
+      ["socio-002", "pista-1", "2026-11-19T19:30", "FRANJA_NO_DISPONIBLE", 409],
+      ["socio-002", "pista-1", "2026-11-20T12:15", "FRANJA_INVALIDA", 400],
+      ["socio-002", "pista-9", "2026-11-20T12:00", "PISTA_NO_ENCONTRADA", 404],
+    ];
+    for (const [socio, pistaId, inicio, codigo, http] of casos) {
+      const r = await crear(api, socio, pistaId, inicio);
+      assert.equal(r.status, http, `${codigo}: ${r.texto}`);
+      assert.equal(r.cuerpo.error.codigo, codigo);
+    }
+
+    // El límite de 3 reservas futuras también frena al crear un partido.
+    assert.equal((await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-005", pistaId: "pista-1", inicio: "2026-11-20T12:00" } })).status, 201);
+    const limite = await crear(api, "socio-005", "pista-2", "2026-11-20T13:30");
+    assert.equal(limite.status, 409);
+    assert.equal(limite.cuerpo.error.codigo, "LIMITE_DE_RESERVAS");
+  }));
+
+test("crear: rango de nivel de los dos extremos o ninguno", () =>
+  conApi(async (api) => {
+    const invalidos = [
+      { nivelMin: 3 },
+      { nivelMax: 5 },
+      { nivelMin: 0, nivelMax: 4 },
+      { nivelMin: 3.2, nivelMax: 4 },
+      { nivelMin: 5, nivelMax: 4 },
+      { nivelMin: "3", nivelMax: "4" },
+    ];
+    for (const extra of invalidos) {
+      const r = await crear(api, "socio-002", "pista-1", "2026-11-21T09:00", extra);
+      assert.equal(r.status, 400, JSON.stringify(extra));
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+
+    const sinNivel = await crear(api, "socio-002", "pista-1", "2026-11-21T09:00", { nivelMin: 3, nivelMax: 5 });
+    assert.equal(sinNivel.status, 409);
+    assert.equal(sinNivel.cuerpo.error.codigo, "NIVEL_SIN_DEFINIR");
+
+    await nivelDe(api, "socio-002", 2);
+    const fuera = await crear(api, "socio-002", "pista-1", "2026-11-21T09:00", { nivelMin: 3, nivelMax: 5 });
+    assert.equal(fuera.status, 409);
+    assert.equal(fuera.cuerpo.error.codigo, "NIVEL_FUERA_DE_RANGO");
+
+    await nivelDe(api, "socio-002", 3);
+    const dentro = await crear(api, "socio-002", "pista-1", "2026-11-21T09:00", { nivelMin: 3, nivelMax: 5 });
+    assert.equal(dentro.status, 201);
+    assert.equal(dentro.cuerpo.partido.nivelMin, 3);
+    assert.equal(dentro.cuerpo.partido.nivelMax, 5);
+  }));
+
+test("el partido crea una reserva confirmada con partidoId", () =>
+  conApi(async (api) => {
+    const creado = await crear(api, "socio-002", "pista-1", "2026-11-20T12:00");
+    assert.equal(creado.status, 201);
+    const p = creado.cuerpo.partido;
+    assert.equal(p.estado, "abierto");
+    assert.deepEqual(p.jugadores, ["socio-002"]);
+    assert.equal(p.plazasLibres, 3);
+    assert.deepEqual(p.penalizaciones, []);
+    assert.equal(p.nivelMin, null);
+    assert.equal(p.nivelMax, null);
+    assert.equal(p.organizador, "socio-002");
+    assert.equal(p.pistaId, "pista-1");
+    assert.equal(p.inicio, "2026-11-20T12:00");
+    assert.equal(p.fin, "2026-11-20T13:30");
+    assert.equal(p.importe, 1800);
+    assert.equal(p.importePorJugador, 450);
+
+    const r = await reserva(api, p.reservaId);
+    assert.equal(r.estado, "confirmada");
+    assert.equal(r.socioId, "socio-002");
+    assert.equal(r.importe, 1800);
+    assert.equal(r.partidoId, p.id);
+
+    const lista = await api.pedir("GET", "/api/reservas?pista=pista-1&fecha=2026-11-20");
+    assert.ok(lista.cuerpo.reservas.some((x: any) => x.id === p.reservaId && x.partidoId === p.id));
+
+    const dia = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-20&pista=pista-1");
+    const franja = dia.cuerpo.pistas[0].franjas.find((f: any) => f.inicio === "2026-11-20T12:00");
+    assert.equal(franja.estado, "reservada");
+
+    // En punta el importe también se reparte en cuatro.
+    const punta = await crear(api, "socio-003", "pista-1", "2026-11-20T18:00");
+    assert.equal(punta.cuerpo.partido.importe, 2800);
+    assert.equal(punta.cuerpo.partido.importePorJugador, 700);
