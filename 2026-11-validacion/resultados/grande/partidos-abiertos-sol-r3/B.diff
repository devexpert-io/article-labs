+++ b/test/partidos.test.ts
@@ -0,0 +1,237 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+
+const org = "socio-041";
+const jugadores = ["socio-002", "socio-004", "socio-005"];
+const inicio = "2026-11-27T18:00";
+const datos = { pistaId: "pista-1", inicio };
+function error(r: Respuesta, codigo: string, status = 409) {
+  assert.equal(r.status, status, r.texto);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+async function escenario(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi({ AHORA: "2026-11-25T10:00" });
+  try { await fn(api); } finally { api.cerrar(); }
+}
+async function crear(api: Api, cuerpo: object = datos, socio = org) {
+  const r = await api.pedir("POST", "/api/partidos", { socio, cuerpo });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.partido;
+}
+async function accion(api: Api, id: string, accion: string, socio = org, cuerpo: object = {}) {
+  return api.pedir("POST", `/api/partidos/${id}/${accion}`, { socio, cuerpo });
+}
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+async function completar(api: Api, id: string) {
+  for (const s of jugadores) assert.equal((await accion(api, id, "unirse", s)).status, 200);
+}
+
+test("identidad, permisos, niveles de socios y partidos inexistentes", () => escenario(async (api) => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.ok(estado.socios.every((s: any) => s.nivel === null));
+  for (const ruta of ["/api/partidos", ...["unirse", "salir", "cancelar"].map((a) => `/api/partidos/no/${a}`)]) {
+    error(await api.pedir("POST", ruta, { cuerpo: datos }), "NO_IDENTIFICADO", 401);
+  }
+  error(await api.pedir("PATCH", `/api/socios/${org}`, { cuerpo: { nivel: 3 } }), "NO_IDENTIFICADO", 401);
+  error(await api.pedir("PATCH", `/api/socios/${org}`, { socio: jugadores[0], cuerpo: { nivel: 3 } }), "SIN_PERMISO", 403);
+  for (const nivel of [0, 7.5, 3.2, "3", true, {}, undefined]) {
+    error(await api.pedir("PATCH", `/api/socios/${org}`, { socio: org, cuerpo: { nivel } }), "DATOS_INVALIDOS", 400);
+  }
+  for (const nivel of [1, 4.5, 7, null]) {
+    const r = await api.pedir("PATCH", `/api/socios/${org}`, { socio: org, cuerpo: { nivel } });
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.socio.nivel, nivel);
+  }
+  assert.equal((await api.pedir("PATCH", `/api/socios/${org}`, { socio: "socio-040", cuerpo: { nivel: 3 } })).status, 200);
+  assert.equal((await api.pedir("GET", "/api/socios?texto=Nora")).cuerpo.socios[0].nivel, 3);
+  error(await api.pedir("PATCH", "/api/socios/no", { socio: "socio-040", cuerpo: { nivel: 3 } }), "SOCIO_NO_ENCONTRADO", 404);
+  error(await api.pedir("GET", "/api/partidos/no"), "PARTIDO_NO_ENCONTRADO", 404);
+  for (const a of ["unirse", "salir", "cancelar"]) error(await accion(api, "no", a), "PARTIDO_NO_ENCONTRADO", 404);
+  const p = await crear(api);
+  error(await accion(api, p.id, "cancelar", jugadores[0]), "SIN_PERMISO", 403);
+  assert.equal((await accion(api, p.id, "cancelar", "socio-040")).status, 200);
+}));
+
+test("crear aplica las reglas de reservas sin dejar datos al fallar", () => escenario(async (api) => {
+  for (const [cuerpo, socio, codigo, status] of [
+    [{ inicio }, org, "DATOS_INVALIDOS", 400],
+    [{ ...datos, pistaId: "no" }, org, "PISTA_NO_ENCONTRADA", 404],
+    [{ ...datos, inicio: "2026-11-27T18:01" }, org, "FRANJA_INVALIDA", 400],
+    [datos, "socio-011", "CUOTA_INACTIVA", 409],
+    [{ ...datos, pistaId: "pista-4" }, org, "PISTA_CERRADA", 409],
+    [{ ...datos, inicio: "2026-11-25T09:00" }, org, "FRANJA_PASADA", 409],
+    [{ ...datos, inicio: "2026-11-25T15:00" }, org, "DEMASIADO_TARDE", 409],
+  ] as const) error(await api.pedir("POST", "/api/partidos", { cuerpo, socio }), codigo, status);
+  const p = await crear(api);
+  error(await api.pedir("POST", "/api/partidos", { cuerpo: datos, socio: jugadores[0] }), "FRANJA_NO_DISPONIBLE");
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.partidos.length, 1);
+  assert.equal(p.estado, "abierto");
+}));
+
+test("reserva vinculada, respuesta, precio y disponibilidad", () => escenario(async (api) => {
+  const p = await crear(api);
+  assert.deepEqual(p.jugadores, [org]);
+  assert.equal(p.organizador, org);
+  assert.equal(p.plazasLibres, 3);
+  assert.equal(p.nivelMin, null);
+  assert.equal(p.nivelMax, null);
+  assert.deepEqual(p.penalizaciones, []);
+  assert.equal(p.importe, 2800);
+  assert.equal(p.importePorJugador, 700);
+  assert.equal(p.fin, "2026-11-27T19:30");
+  assert.deepEqual((await api.pedir("GET", `/api/partidos/${p.id}`)).cuerpo.partido, p);
+  const r = (await api.pedir("GET", `/api/reservas/${p.reservaId}`)).cuerpo.reserva;
+  assert.equal(r.partidoId, p.id);
+  assert.equal(r.socioId, org);
+  assert.equal(r.estado, "confirmada");
+  assert.equal((await api.pedir("GET", `/api/reservas?fecha=2026-11-27`)).cuerpo.reservas[0].partidoId, p.id);
+  const d = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-27&pista=pista-1")).cuerpo;
+  assert.equal(d.pistas[0].franjas.find((f: any) => f.inicio === inicio).estado, "reservada");
+  error(await api.pedir("POST", `/api/reservas/${r.id}/cancelar`), "ES_UN_PARTIDO");
+}));
+
+test("rangos válidos y nivel del organizador y jugadores con extremos incluidos", () => escenario(async (api) => {
+  for (const rango of [{ nivelMin: 3 }, { nivelMax: 5 }, { nivelMin: null, nivelMax: null }, { nivelMin: 5, nivelMax: 3 }, { nivelMin: 1.2, nivelMax: 7 }]) {
+    error(await api.pedir("POST", "/api/partidos", { socio: org, cuerpo: { ...datos, ...rango } }), "DATOS_INVALIDOS", 400);
+  }
+  const cuerpo = { ...datos, nivelMin: 3, nivelMax: 4.5 };
+  error(await api.pedir("POST", "/api/partidos", { socio: org, cuerpo }), "NIVEL_SIN_DEFINIR");
+  await api.pedir("PATCH", `/api/socios/${org}`, { socio: org, cuerpo: { nivel: 5 } });
+  error(await api.pedir("POST", "/api/partidos", { socio: org, cuerpo }), "NIVEL_FUERA_DE_RANGO");
+  await api.pedir("PATCH", `/api/socios/${org}`, { socio: org, cuerpo: { nivel: 3 } });
+  const p = await crear(api, cuerpo);
+  error(await accion(api, p.id, "unirse", jugadores[0]), "NIVEL_SIN_DEFINIR");
+  for (const nivel of [2.5, 5]) {
+    await api.pedir("PATCH", `/api/socios/${jugadores[0]}`, { socio: jugadores[0], cuerpo: { nivel } });
+    error(await accion(api, p.id, "unirse", jugadores[0]), "NIVEL_FUERA_DE_RANGO");
+  }
+  for (const [i, nivel] of [3, 4.5].entries()) {
+    await api.pedir("PATCH", `/api/socios/${jugadores[i]}`, { socio: jugadores[i], cuerpo: { nivel } });
+    assert.equal((await accion(api, p.id, "unirse", jugadores[i])).status, 200);
+  }
+}));
+
+test("unirse, completar, salir y reabrir sin rango ni penalización a 24 horas", () => escenario(async (api) => {
+  const p = await crear(api);
+  error(await accion(api, p.id, "unirse"), "YA_APUNTADO");
+  error(await accion(api, p.id, "unirse", "socio-011"), "CUOTA_INACTIVA");
+  error(await accion(api, p.id, "salir", jugadores[0]), "NO_APUNTADO");
+  error(await accion(api, p.id, "salir"), "ORGANIZADOR_NO_PUEDE_SALIR");
+  await completar(api, p.id);
+  const lleno = (await api.pedir("GET", `/api/partidos/${p.id}`)).cuerpo.partido;
+  assert.equal(lleno.estado, "completo");
+  assert.equal(lleno.plazasLibres, 0);
+  assert.deepEqual(lleno.jugadores, [org, ...jugadores]);
+  error(await accion(api, p.id, "unirse", "socio-001"), "PARTIDO_COMPLETO");
+  assert.deepEqual((await api.pedir("GET", "/api/partidos")).cuerpo.partidos, []);
+  await reloj(api, "2026-11-26T18:00");
+  const salida = (await accion(api, p.id, "salir", jugadores[0])).cuerpo.partido;
+  assert.equal(salida.estado, "abierto");
+  assert.equal(salida.plazasLibres, 1);
+  assert.deepEqual(salida.penalizaciones, []);
+  assert.equal((await accion(api, p.id, "unirse", jugadores[0])).status, 200);
+}));
+
+test("salir tarde requiere forzar, anota la parte y no permite salir tras empezar", () => escenario(async (api) => {
+  const p = await crear(api);
+  await completar(api, p.id);
+  await reloj(api, "2026-11-26T18:01");
+  error(await accion(api, p.id, "salir", jugadores[0]), "FUERA_DE_PLAZO");
+  error(await accion(api, p.id, "salir", jugadores[0], { forzar: "sí" }), "DATOS_INVALIDOS", 400);
+  const r = await accion(api, p.id, "salir", jugadores[0], { forzar: true });
+  assert.deepEqual(r.cuerpo.partido.penalizaciones, [{ socioId: jugadores[0], importe: 700 }]);
+  await accion(api, p.id, "unirse", jugadores[0]);
+  await reloj(api, inicio);
+  error(await accion(api, p.id, "salir", jugadores[0], { forzar: true }), "FRANJA_PASADA");
+  error(await accion(api, p.id, "cancelar", org, { forzar: true }), "FRANJA_PASADA");
+}));
+
+test("cancelar gratis y tarde, libera pista y protege partidos cancelados", () => escenario(async (api) => {
+  const p = await crear(api);
+  await reloj(api, "2026-11-26T18:00");
+  const r = await accion(api, p.id, "cancelar");
