+test("corregir: no se puede si el partido siguiente ya se jugó", async () => {
+  const t = await crearTorneo({ pistas: ["pista-1", "pista-2"], franjas: franjasDel("2026-12-18") });
+  const ids = await inscribirParejas(t.id, 4);
+  const cerrado = (await api.pedir("POST", `/api/torneos/${t.id}/cerrar`, { socio: GESTOR })).cuerpo.torneo;
+  const semi1 = partido(cerrado, 1, 1);
+  const semi2 = partido(cerrado, 1, 2);
+  assert.deepEqual(semi1.parejas, [ids[0], ids[3]]);
+  assert.deepEqual(semi2.parejas, [ids[1], ids[2]]);
+  await reloj("2026-12-18T12:00");
+  try {
+    await resultado(t.id, semi1.id, { ganadora: ids[0] });
+    await resultado(t.id, semi2.id, { ganadora: ids[2] });
+    assert.deepEqual(partido(await verTorneo(t.id), 2, 1).parejas, [ids[0], ids[2]]);
+    // La final aún no se ha jugado: el resultado de una semifinal se puede corregir.
+    await resultado(t.id, semi2.id, { ganadora: ids[1] });
+    assert.deepEqual(partido(await verTorneo(t.id), 2, 1).parejas, [ids[0], ids[1]]);
+  } finally {
+    await reloj("2026-11-18T10:00");
+  }
+  // Para comprobar RESULTADO_CERRADO, un cuadro de 8 donde la ronda 2 se juega sin terminar el torneo.
+  const grande = await crearTorneo({ pistas: ["pista-1", "pista-2"], franjas: franjasDel("2026-12-19", ["09:00", "10:30", "12:00", "13:30"]) });
+  const g = await inscribirParejas(grande.id, 8);
+  const cuadro = (await api.pedir("POST", `/api/torneos/${grande.id}/cerrar`, { socio: GESTOR })).cuerpo.torneo;
+  await reloj("2026-12-19T13:30");
+  try {
+    for (const p of cuadro.partidos.filter((x: any) => x.ronda === 1)) await resultado(grande.id, p.id, { ganadora: p.parejas[0] });
+    const r2 = partido(await verTorneo(grande.id), 2, 1);
+    assert.deepEqual(r2.parejas, [g[0], g[3]]);
+    assert.equal((await resultado(grande.id, r2.id, { ganadora: g[3] })).status, 200);
+    const tarde = await resultado(grande.id, partido(cuadro, 1, 1).id, { ganadora: g[7] });
+    assert.equal(tarde.status, 409);
+    assert.equal(tarde.cuerpo.error.codigo, "RESULTADO_CERRADO");
+    assert.equal(partido(await verTorneo(grande.id), 1, 1).ganadora, g[0], "no cambia nada");
+    // El otro partido de la ronda 2 no se ha jugado: sus partidos de la ronda 1 sí se corrigen.
+    assert.equal((await resultado(grande.id, partido(cuadro, 1, 2).id, { ganadora: g[6] })).status, 200);
+    assert.deepEqual(partido(await verTorneo(grande.id), 2, 2).parejas, [g[6], g[2]]);
+  } finally {
+    await reloj("2026-11-18T10:00");
+  }
+});
