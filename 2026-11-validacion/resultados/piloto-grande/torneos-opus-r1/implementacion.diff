+
+  // Baja: uno de los dos socios o un gestor.
+  const bajaAjena = await api.pedir("POST", `/api/torneos/${t.id}/inscripciones/${propia.cuerpo.inscripcion.id}/baja`, { socio: "socio-003" });
+  assert.equal(bajaAjena.status, 403);
+  const bajaAnonima = await api.pedir("POST", `/api/torneos/${t.id}/inscripciones/${propia.cuerpo.inscripcion.id}/baja`);
+  assert.equal(bajaAnonima.status, 401);
+  const bajaPropia = await api.pedir("POST", `/api/torneos/${t.id}/inscripciones/${propia.cuerpo.inscripcion.id}/baja`, { socio: "socio-001" });
+  assert.equal(bajaPropia.status, 200);
+  const bajaGestor = await api.pedir("POST", `/api/torneos/${t.id}/inscripciones/${otra.cuerpo.inscripcion.id}/baja`, { socio: GESTOR });
+  assert.equal(bajaGestor.status, 200);
+  await inscribirParejas(t.id, 2, 4);
+
+  for (const ruta of [`/api/torneos/${t.id}/cerrar`, `/api/torneos/${t.id}/cancelar`]) {
+    assert.equal((await api.pedir("POST", ruta)).status, 401);
+    assert.equal((await api.pedir("POST", ruta, { socio: "socio-005" })).cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  assert.equal((await api.pedir("POST", `/api/torneos/${t.id}/cerrar`, { socio: GESTOR })).status, 200);
+  const final = partido(await verTorneo(t.id), 1, 1);
+  await reloj(final.inicio);
+  try {
+    const sinId = await api.pedir("POST", `/api/torneos/${t.id}/partidos/${final.id}/resultado`, { cuerpo: { ganadora: final.parejas[0] } });
+    assert.equal(sinId.status, 401);
+    const jugador = await resultado(t.id, final.id, { ganadora: final.parejas[0] }, "socio-005");
+    assert.equal(jugador.status, 403);
+    assert.equal(jugador.cuerpo.error.codigo, "SIN_PERMISO");
+  } finally {
+    await reloj("2026-11-18T10:00");
+  }
+});
