+      if (!p) throw new ErrorDelClub("PARTIDO_NO_ENCONTRADO", `No existe el partido ${partidoId} en el torneo ${t.id}`, 404);
+      if (typeof datos.ganadora !== "string") invalido("ganadora es obligatoria: el id de una de las dos inscripciones del partido");
+      if (datos.marcador !== undefined && datos.marcador !== null && typeof datos.marcador !== "string") invalido("marcador debe ser un texto");
+      if (t.estado !== "en_juego") throw new ErrorDelClub("TORNEO_NO_EN_JUEGO", "El torneo no está en juego");
+      if (p.estado === "descanso" || p.parejas[0] === null || p.parejas[1] === null) {
+        throw new ErrorDelClub("PARTIDO_NO_LISTO", "Todavía no se saben las dos parejas de este partido");
+      }
+      if (p.inicio! > estado.ahora) throw new ErrorDelClub("PARTIDO_NO_EMPEZADO", "El partido todavía no ha empezado");
+      if (!p.parejas.includes(datos.ganadora)) invalido("ganadora debe ser una de las dos inscripciones del partido");
+      const siguiente = siguientePartido(t.partidos, p);
+      if (p.estado === "jugado" && siguiente?.partido.estado === "jugado") {
+        throw new ErrorDelClub("RESULTADO_CERRADO", "El partido siguiente ya se ha jugado y este resultado ya no se puede cambiar");
+      }
+      p.ganadora = datos.ganadora;
+      p.marcador = typeof datos.marcador === "string" ? datos.marcador : null;
+      p.estado = "jugado";
+      if (siguiente) {
+        avanzar(t.partidos, p);
+      } else {
+        t.estado = "terminado";
+        t.campeona = p.ganadora;
+      }
+      return { partido: p };
+    },
+
+    cancelarTorneo(quien: Socio | undefined, torneoId: string) {
+      exigirGestor(quien);
+      const t = torneo(torneoId);
+      if (t.estado === "terminado") throw new ErrorDelClub("TORNEO_TERMINADO", "El torneo ya ha terminado y no se puede cancelar");
+      if (t.estado === "cancelado") throw new ErrorDelClub("YA_CANCELADO", "El torneo ya estaba cancelado");
+      t.estado = "cancelado";
+      return { torneo: t };
+    },
   };
 }
 
+/** Todos los partidos del cuadro de eliminación directa, con los descansos de la primera ronda ya resueltos. */
+function generarCuadro(torneoId: string, parejas: string[]): Partido[] {
+  let plazas = 1;
+  while (plazas < parejas.length) plazas *= 2;
+  const partidos: Partido[] = [];
+  const nuevo = (ronda: number, numero: number, a: string | null, b: string | null, descanso = false): Partido => ({
+    id: `${torneoId}-P${partidos.length + 1}`,
+    ronda,
+    numero,
+    parejas: [a, b],
+    estado: descanso ? "descanso" : "pendiente",
+    ganadora: descanso ? a : null,
+    marcador: null,
+    pistaId: null,
+    inicio: null,
+  });
+  for (let i = 1; i <= plazas / 2; i++) {
+    const rival = parejas[plazas - i] ?? null;
+    partidos.push(nuevo(1, i, parejas[i - 1]!, rival, rival === null));
+  }
+  for (let ronda = 2, cuantos = plazas / 4; cuantos >= 1; ronda++, cuantos /= 2) {
+    for (let j = 1; j <= cuantos; j++) partidos.push(nuevo(ronda, j, null, null));
+  }
+  return partidos;
+}
+
+/** El partido de la ronda siguiente al que pasa la ganadora y el hueco que ocupa en sus parejas. */
+function siguientePartido(partidos: Partido[], p: Partido): { partido: Partido; hueco: 0 | 1 } | undefined {
+  const enRonda = partidos.filter((x) => x.ronda === p.ronda).length;
+  const numero = p.numero <= enRonda / 2 ? p.numero : enRonda + 1 - p.numero;
+  const partido = partidos.find((x) => x.ronda === p.ronda + 1 && x.numero === numero);
+  return partido ? { partido, hueco: p.numero <= enRonda / 2 ? 0 : 1 } : undefined;
+}
+
+/** Los dos partidos de la ronda anterior de los que salen las parejas de p. */
+function alimentadores(partidos: Partido[], p: Partido): Partido[] {
+  const anteriores = partidos.filter((x) => x.ronda === p.ronda - 1);
+  const m = anteriores.length;
+  return anteriores.filter((x) => x.numero === p.numero || x.numero === m + 1 - p.numero);
+}
+
+function avanzar(partidos: Partido[], p: Partido) {
+  const siguiente = siguientePartido(partidos, p);
+  if (siguiente) siguiente.partido.parejas[siguiente.hueco] = p.ganadora;
+}
+
 export type Club = ReturnType<typeof crearClub>;
