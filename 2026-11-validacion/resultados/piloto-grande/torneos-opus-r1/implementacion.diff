+// Torneos de parejas por eliminación directa, probados a través de la API (spec docs/specs/torneos.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+// Socios con la cuota al día (en la semilla, socio-011, socio-022 y socio-033 no la tienen).
+const ACTIVOS = ["socio-001", "socio-002", "socio-003", "socio-004", "socio-005", "socio-006", "socio-007", "socio-008",
+  "socio-009", "socio-010", "socio-012", "socio-013", "socio-014", "socio-015", "socio-016", "socio-017",
+  "socio-018", "socio-019", "socio-020", "socio-021", "socio-023", "socio-024", "socio-025", "socio-026",
+  "socio-027", "socio-028", "socio-029", "socio-030", "socio-031", "socio-032", "socio-034", "socio-035"];
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+/** Cada test usa su propio día para que los torneos no choquen entre sí. */
+function franjasDel(dia: string, horas = ["09:00", "10:30", "12:00", "13:30"]) {
+  return horas.map((h) => `${dia}T${h}`);
+}
+
+async function crearTorneo(datos: Record<string, unknown>) {
+  const r = await api.pedir("POST", "/api/torneos", {
+    socio: GESTOR,
+    cuerpo: { nombre: "Torneo de prueba", pistas: ["pista-1", "pista-2"], plazas: 8, cuota: 2000, ...datos },
+  });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.torneo;
+}
+
+async function inscribirParejas(torneoId: string, cuantas: number, desde = 0) {
+  const ids: string[] = [];
+  for (let i = 0; i < cuantas; i++) {
+    const socios = [ACTIVOS[desde + 2 * i]!, ACTIVOS[desde + 2 * i + 1]!];
+    const r = await api.pedir("POST", `/api/torneos/${torneoId}/inscripciones`, { socio: GESTOR, cuerpo: { socios } });
+    assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+    ids.push(r.cuerpo.inscripcion.id);
+  }
+  return ids;
+}
+
+async function reloj(ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function verTorneo(id: string) {
+  return (await api.pedir("GET", `/api/torneos/${id}`)).cuerpo.torneo;
+}
+
+async function resultado(torneoId: string, partidoId: string, cuerpo: Record<string, unknown>, socio = GESTOR) {
+  return api.pedir("POST", `/api/torneos/${torneoId}/partidos/${partidoId}/resultado`, { socio, cuerpo });
+}
+
+function partido(t: any, ronda: number, numero: number) {
+  return t.partidos.find((p: any) => p.ronda === ronda && p.numero === numero);
+}
+
+test("permisos: solo un gestor crea, cierra, cancela y apunta resultados; consultar es libre", async () => {
+  const cuerpo = { nombre: "Permisos", pistas: ["pista-1"], franjas: franjasDel("2026-12-01"), plazas: 4, cuota: 0 };
+  const sin = await api.pedir("POST", "/api/torneos", { cuerpo });
+  assert.equal(sin.status, 401);
+  assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("POST", "/api/torneos", { socio: "socio-001", cuerpo });
+  assert.equal(socio.status, 403);
