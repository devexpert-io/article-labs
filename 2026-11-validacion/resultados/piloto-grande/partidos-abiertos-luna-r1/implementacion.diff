+++ b/test/partidos.test.ts
@@ -0,0 +1,37 @@
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => { api = await arrancarApi(); });
+after(() => api.cerrar());
+
+test("crear, apuntarse, completar y proteger la reserva de un partido", async () => {
+  const creado = await api.pedir("POST", "/api/partidos", { socio: "socio-041", cuerpo: { pistaId: "pista-3", inicio: "2026-11-24T12:00" } });
+  assert.equal(creado.status, 201);
+  const p = creado.cuerpo.partido;
+  assert.equal(p.plazasLibres, 3);
+  assert.equal(p.importePorJugador, 300);
+  const reserva = await api.pedir("GET", `/api/reservas/${p.reservaId}`);
+  assert.equal(reserva.cuerpo.reserva.partidoId, p.id);
+  assert.equal((await api.pedir("POST", `/api/reservas/${p.reservaId}/cancelar`)).cuerpo.error.codigo, "ES_UN_PARTIDO");
+  for (const socio of ["socio-001", "socio-002", "socio-003"]) {
+    assert.equal((await api.pedir("POST", `/api/partidos/${p.id}/unirse`, { socio })).status, 200);
+  }
+  const completo = await api.pedir("GET", `/api/partidos/${p.id}`);
+  assert.equal(completo.cuerpo.partido.estado, "completo");
+  assert.equal(completo.cuerpo.partido.jugadores.length, 4);
+  assert.equal((await api.pedir("GET", "/api/partidos")).cuerpo.partidos.some((x: any) => x.id === p.id), false);
+});
+
+test("nivel de socio, límites de nivel y cancelación automática", async () => {
+  assert.equal((await api.pedir("PATCH", "/api/socios/socio-041", { socio: "socio-041", cuerpo: { nivel: 4.5 } })).cuerpo.socio.nivel, 4.5);
+  const creado = await api.pedir("POST", "/api/partidos", { socio: "socio-041", cuerpo: { pistaId: "pista-3", inicio: "2026-11-24T13:30", nivelMin: 4, nivelMax: 5 } });
+  const p = creado.cuerpo.partido;
+  assert.equal((await api.pedir("POST", `/api/partidos/${p.id}/unirse`, { socio: "socio-001" })).cuerpo.error.codigo, "NIVEL_SIN_DEFINIR");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-24T07:30" } });
+  const actualizado = await api.pedir("GET", `/api/partidos/${p.id}`);
+  assert.equal(actualizado.cuerpo.partido.estado, "cancelado");
+  assert.equal(actualizado.cuerpo.partido.motivo, "incompleto");
+  assert.equal((await api.pedir("GET", `/api/reservas/${p.reservaId}`)).cuerpo.reserva.estado, "cancelada");
+});
