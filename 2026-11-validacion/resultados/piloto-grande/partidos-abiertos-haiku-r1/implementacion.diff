+test("la cancelación automática: un partido incompleto se cancela 6 horas antes, sin penalización", async () => {
+  // Reloj propio de esta prueba: el lunes 26 a las 08:00, partido el viernes 27 a las 10:30 (pista 1).
+  const reloj = await arrancarApi({ AHORA: "2026-11-26T08:00" });
+  try {
+    const crearEn = (socio: string, cuerpo: unknown) => reloj.pedir("POST", "/api/partidos", { socio, cuerpo });
+    const ahora = (hora: string) => reloj.pedir("POST", "/_reloj", { cuerpo: { ahora: hora } });
+
+    // A: se queda con una sola plaza ocupada y se cancela sola.
+    const a = (await crearEn("socio-006", { pistaId: "pista-1", inicio: "2026-11-27T10:30" })).cuerpo.partido;
+    // B: se completa a 12:00 del viernes y uno se sale a las 6 horas, con forzar.
+    const b = (await crearEn("socio-007", { pistaId: "pista-2", inicio: "2026-11-27T12:00" })).cuerpo.partido;
+    for (const socio of ["socio-008", "socio-009", "socio-010"]) {
+      await reloj.pedir("POST", `/api/partidos/${b.id}/unirse`, { socio });
+    }
+
+    await ahora("2026-11-27T04:00");
+    assert.equal((await reloj.pedir("GET", `/api/partidos/${a.id}`)).cuerpo.partido.estado, "abierto", "a 6,5 horas, todavía abierto");
+    await ahora("2026-11-27T04:30");
+    const cancelado = (await reloj.pedir("GET", `/api/partidos/${a.id}`)).cuerpo.partido;
+    assert.equal(cancelado.estado, "cancelado");
+    assert.equal(cancelado.motivo, "incompleto");
+    assert.equal(cancelado.penalizaciones.length, 0, "sin penalización para nadie");
+    const reservaA = (await reloj.pedir("GET", `/api/reservas/${a.reservaId}`)).cuerpo.reserva;
+    assert.equal(reservaA.estado, "cancelada");
+    assert.equal(reservaA.penalizacion, undefined);
+    const disponible = await reloj.pedir("GET", "/api/disponibilidad?fecha=2026-11-27&pista=pista-1");
+    assert.equal(disponible.cuerpo.pistas[0].franjas.find((f: any) => f.inicio.endsWith("10:30")).estado, "libre");
+    assert.equal((await reloj.pedir("POST", `/api/partidos/${a.id}/unirse`, { socio: "socio-011" })).cuerpo.error.codigo, "PARTIDO_CANCELADO");
+
+    // B está completo: a 6 horas no se cancela solo (solo lo hace si está abierto).
+    await ahora("2026-11-27T06:00");
+    assert.equal((await reloj.pedir("GET", `/api/partidos/${b.id}`)).cuerpo.partido.estado, "completo");
+    const salida = await reloj.pedir("POST", `/api/partidos/${b.id}/salir`, { socio: "socio-010", cuerpo: { forzar: true } });
+    assert.equal(salida.cuerpo.partido.estado, "cancelado", "al quedar abierto a 6 horas, se cancela");
+    assert.equal(salida.cuerpo.partido.motivo, "incompleto");
+    assert.deepEqual(salida.cuerpo.partido.penalizaciones, [{ socioId: "socio-010", importe: 450 }], "la penalización de salir se queda");
+
+    // Crear a menos de 6 horas no se puede; a 7 horas y media, sí, y se cancela en cuanto faltan 6.
+    assert.equal((await crearEn("socio-012", { pistaId: "pista-3", inicio: "2026-11-27T12:00" })).cuerpo.error.codigo, "DEMASIADO_TARDE");
+    const c = (await crearEn("socio-012", { pistaId: "pista-3", inicio: "2026-11-27T13:30" })).cuerpo.partido;
+    await ahora("2026-11-27T07:00");
+    assert.equal((await reloj.pedir("GET", `/api/partidos/${c.id}`)).cuerpo.partido.estado, "abierto");
+    await ahora("2026-11-27T07:30");
+    assert.equal((await reloj.pedir("GET", `/api/partidos/${c.id}`)).cuerpo.partido.estado, "cancelado");
+  } finally {
+    reloj.cerrar();
+  }
