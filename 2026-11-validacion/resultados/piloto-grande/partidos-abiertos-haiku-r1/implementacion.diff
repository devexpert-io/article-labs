+// Partidos abiertos: nivel de los socios, crear, unirse, salir, cancelar y la cancelación automática.
+// Las pruebas usan fechas sin reservas de la semilla (desde el 25 de noviembre), así que la semilla no interfiere.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Miércoles 25 de noviembre de 2026 a las 08:00: el reloj de estas pruebas.
+let api: Api;
+before(async () => {
+  api = await arrancarApi({ AHORA: "2026-11-25T08:00" });
+});
+after(() => api.cerrar());
+
+const crear = (socio: string | undefined, cuerpo: unknown) => api.pedir("POST", "/api/partidos", { socio, cuerpo });
+const nivelDe = (socio: string, nivel: unknown, quien = socio) =>
+  api.pedir("PATCH", `/api/socios/${socio}`, { socio: quien, cuerpo: { nivel } });
+
+test("el nivel de un socio: lo fija él mismo o un gestor, y solo valores válidos", async () => {
+  const propio = await nivelDe("socio-006", 3.5);
+  assert.equal(propio.status, 200);
+  assert.equal(propio.cuerpo.socio.nivel, 3.5);
+  assert.equal((await nivelDe("socio-007", 4, "socio-006")).cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await nivelDe("socio-007", 4, "socio-040")).status, 200, "un gestor puede fijar el nivel de cualquiera");
+  assert.equal((await api.pedir("PATCH", "/api/socios/socio-006", { cuerpo: { nivel: 3 } })).cuerpo.error.codigo, "NO_IDENTIFICADO");
+  assert.equal((await nivelDe("socio-999", 3, "socio-040")).cuerpo.error.codigo, "SOCIO_NO_ENCONTRADO");
+  for (const malo of [0.5, 7.5, 3.3, "3", undefined]) {
+    const r = await nivelDe("socio-006", malo);
+    assert.equal(r.status, 400, `nivel ${String(malo)} debe ser inválido`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await nivelDe("socio-006", null)).cuerpo.socio.nivel, null, "se puede quitar con null");
+  const lista = await api.pedir("GET", "/api/socios?texto=Nora");
+  assert.equal(lista.cuerpo.socios[0].nivel, null);
+  await nivelDe("socio-006", 3.5);
+});
+
+test("crear un partido reserva la pista para el organizador y deja tres plazas libres", async () => {
+  const creado = await crear("socio-006", { pistaId: "pista-1", inicio: "2026-11-26T19:30" });
+  assert.equal(creado.status, 201);
+  const p = creado.cuerpo.partido;
+  assert.equal(p.estado, "abierto");
+  assert.deepEqual(p.jugadores, ["socio-006"]);
+  assert.equal(p.organizador, "socio-006");
+  assert.equal(p.plazasLibres, 3);
+  assert.deepEqual(p.penalizaciones, []);
+  assert.equal(p.nivelMin, null);
+  assert.equal(p.nivelMax, null);
+  assert.equal(p.fin, "2026-11-26T21:00");
+  assert.equal(p.importe, 2800, "sábado o tarde de punta");
+  assert.equal(p.importePorJugador, 700, "la cuarta parte");
+
+  const reserva = (await api.pedir("GET", `/api/reservas/${p.reservaId}`)).cuerpo.reserva;
+  assert.equal(reserva.socioId, "socio-006");
+  assert.equal(reserva.estado, "confirmada");
+  assert.equal(reserva.importe, 2800);
+  assert.equal(reserva.partidoId, p.id);
+  const disponible = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-26&pista=pista-1");
+  assert.equal(disponible.cuerpo.pistas[0].franjas.find((f: any) => f.inicio.endsWith("19:30")).estado, "reservada");
+  assert.equal((await api.pedir("GET", `/api/partidos/${p.id}`)).cuerpo.partido.id, p.id);
+  assert.equal((await api.pedir("GET", "/api/partidos/P-9999")).cuerpo.error.codigo, "PARTIDO_NO_ENCONTRADO");
+});
+
+test("el importe por jugador se redondea al céntimo hacia arriba", async () => {
+  // Valle de pista 1 entre semana: 1800 céntimos, la cuarta parte es 450.
+  const p = (await crear("socio-010", { pistaId: "pista-1", inicio: "2026-11-27T10:30" })).cuerpo.partido;
+  assert.equal(p.importePorJugador, 450);
+  assert.equal(p.importe, 1800);
+});
+
+test("crear: sin identificarse, o con las reglas de siempre de la reserva", async () => {
+  assert.equal((await crear(undefined, { pistaId: "pista-1", inicio: "2026-11-26T10:30" })).cuerpo.error.codigo, "NO_IDENTIFICADO");
+  assert.equal((await crear("socio-011", { pistaId: "pista-1", inicio: "2026-11-26T10:30" })).cuerpo.error.codigo, "CUOTA_INACTIVA");
+  assert.equal((await crear("socio-012", { pistaId: "pista-4", inicio: "2026-11-26T10:30" })).cuerpo.error.codigo, "PISTA_CERRADA");
+  assert.equal((await crear("socio-012", { pistaId: "pista-1", inicio: "2026-11-24T19:30" })).cuerpo.error.codigo, "FRANJA_PASADA");
+  assert.equal((await crear("socio-012", { pistaId: "pista-1", inicio: "2026-11-27T11:00" })).cuerpo.error.codigo, "FRANJA_INVALIDA");
+  assert.equal((await crear("socio-012", { pistaId: "pista-9", inicio: "2026-11-27T10:30" })).cuerpo.error.codigo, "PISTA_NO_ENCONTRADA");
+  assert.equal((await crear("socio-012", { pistaId: "pista-1", inicio: "2026-11-26T19:30" })).cuerpo.error.codigo, "FRANJA_NO_DISPONIBLE");
+});
+
+test("crear: un partido solo se abre con más de 6 horas de antelación", async () => {
+  // Ahora son las 08:00: a las 09:00 faltan 1 hora y a las 13:30, 5,5 horas.
+  assert.equal((await crear("socio-012", { pistaId: "pista-3", inicio: "2026-11-25T09:00" })).cuerpo.error.codigo, "DEMASIADO_TARDE");
+  assert.equal((await crear("socio-012", { pistaId: "pista-3", inicio: "2026-11-25T13:30" })).cuerpo.error.codigo, "DEMASIADO_TARDE");
+  assert.equal((await crear("socio-012", { pistaId: "pista-3", inicio: "2026-11-25T15:00" })).status, 201, "a 7 horas sí");
+});
+
+test("crear con rango de nivel: los dos niveles o ninguno, válidos y en orden", async () => {
+  const base = { pistaId: "pista-2", inicio: "2026-11-27T10:30" };
+  for (const rango of [{ nivelMin: 3 }, { nivelMax: 3 }, { nivelMin: 4, nivelMax: 3 }, { nivelMin: 0.5, nivelMax: 3 }, { nivelMin: 1, nivelMax: 7.5 }]) {
+    const r = await crear("socio-013", { ...base, ...rango });
+    assert.equal(r.status, 400, JSON.stringify(rango));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  // Sin nivel definido: no puede crear un partido con rango.
+  assert.equal((await crear("socio-012", { ...base, nivelMin: 1, nivelMax: 7 })).cuerpo.error.codigo, "NIVEL_SIN_DEFINIR");
+  // Con nivel 5, fuera de un rango 1-3.
+  await nivelDe("socio-013", 5);
+  assert.equal((await crear("socio-013", { ...base, nivelMin: 1, nivelMax: 3 })).cuerpo.error.codigo, "NIVEL_FUERA_DE_RANGO");
+  // Ninguno de esos intentos ha reservado la franja.
+  const disponible = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-27&pista=pista-2");
+  assert.equal(disponible.cuerpo.pistas[0].franjas.find((f: any) => f.inicio.endsWith("10:30")).estado, "libre");
+  // Con el extremo superior incluido, sí.
+  const rangoOk = await crear("socio-013", { ...base, nivelMin: 5, nivelMax: 6 });
+  assert.equal(rangoOk.status, 201);
+  assert.equal(rangoOk.cuerpo.partido.nivelMin, 5);
+  assert.equal(rangoOk.cuerpo.partido.nivelMax, 6);
+});
+
+test("unirse: se añade al final, el cuarto jugador completa el partido, y las reglas de quién entra", async () => {
+  const p = (await crear("socio-020", { pistaId: "pista-3", inicio: "2026-11-28T10:30" })).cuerpo.partido;
+  const ruta = `/api/partidos/${p.id}/unirse`;
+  assert.equal((await api.pedir("POST", ruta)).cuerpo.error.codigo, "NO_IDENTIFICADO");
+  assert.equal((await api.pedir("POST", ruta, { socio: "socio-020" })).cuerpo.error.codigo, "YA_APUNTADO");
+  assert.equal((await api.pedir("POST", ruta, { socio: "socio-011" })).cuerpo.error.codigo, "CUOTA_INACTIVA");
+  assert.equal((await api.pedir("POST", "/api/partidos/P-9999/unirse", { socio: "socio-021" })).cuerpo.error.codigo, "PARTIDO_NO_ENCONTRADO");
+
+  const primero = await api.pedir("POST", ruta, { socio: "socio-021" });
+  assert.equal(primero.status, 200);
+  assert.deepEqual(primero.cuerpo.partido.jugadores, ["socio-020", "socio-021"]);
+  assert.equal(primero.cuerpo.partido.plazasLibres, 2);
+  assert.equal((await api.pedir("POST", ruta, { socio: "socio-021" })).cuerpo.error.codigo, "YA_APUNTADO");
+  await api.pedir("POST", ruta, { socio: "socio-022" }).then((r) => assert.equal(r.cuerpo.error?.codigo, "CUOTA_INACTIVA"));
+  await api.pedir("POST", ruta, { socio: "socio-023" });
+  const cuarto = await api.pedir("POST", ruta, { socio: "socio-024" });
+  assert.equal(cuarto.cuerpo.partido.estado, "completo");
+  assert.equal(cuarto.cuerpo.partido.plazasLibres, 0);
