+      if (f.fecha !== undefined && !FECHA.test(f.fecha)) invalido("fecha debe tener el formato AAAA-MM-DD");
+      let nivel: number | undefined;
+      if (f.nivel !== undefined) {
+        nivel = Number(f.nivel.replace(",", "."));
+        if (!nivelValido(nivel)) invalido("nivel debe ser un número de 1 a 7 en pasos de 0,5");
+      }
+      const admite = (p: Partido) => {
+        if (nivel === undefined) return true;
+        const rango = rangoDe(p);
+        return rango === null || (nivel >= rango.min && nivel <= rango.max);
+      };
+      const partidos = estado.partidos
+        .filter((p) => p.estado === "abierto" && p.inicio > estado.ahora)
+        .filter((p) => f.fecha === undefined || p.inicio.slice(0, 10) === f.fecha)
+        .filter(admite)
+        .sort((a, b) => (a.inicio === b.inicio ? a.pistaId.localeCompare(b.pistaId) : a.inicio.localeCompare(b.inicio)));
+      return { partidos };
+    },
+
+    obtenerPartido(id: string) {
+      return { partido: partidoPorId(id) };
+    },
+
+    unirsePartido(quien: Socio | undefined, id: string) {
+      const socio = exigirSocio(quien);
+      const p = partidoPorId(id);
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.jugadores.includes(socio.id)) throw new ErrorDelClub("YA_APUNTADO", `${socio.nombre} ya juega en este partido`);
+      if (p.estado === "completo") throw new ErrorDelClub("PARTIDO_COMPLETO", "El partido ya está completo");
+      if (!socio.cuotaActiva) throw new ErrorDelClub("CUOTA_INACTIVA", `${socio.nombre} no tiene la cuota al día`);
+      comprobarNivel(socio, rangoDe(p));
+      if (reservasFuturas(socio.id) >= MAXIMO_RESERVAS_FUTURAS) {
+        throw new ErrorDelClub("LIMITE_DE_RESERVAS", `${socio.nombre} ya tiene ${MAXIMO_RESERVAS_FUTURAS} reservas futuras`);
+      }
+      p.jugadores.push(socio.id);
+      actualizarPlazas(p);
+      return { partido: p };
+    },
+
+    salirPartido(quien: Socio | undefined, id: string, datos: { forzar?: unknown }) {
+      const socio = exigirSocio(quien);
+      const p = partidoPorId(id);
+      if (datos.forzar !== undefined && typeof datos.forzar !== "boolean") invalido("forzar debe ser true o false");
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      if (!p.jugadores.includes(socio.id)) throw new ErrorDelClub("NO_APUNTADO", `${socio.nombre} no juega en este partido`);
+      if (p.organizador === socio.id) {
+        throw new ErrorDelClub("ORGANIZADOR_NO_PUEDE_SALIR", "El organizador no puede salir de su partido: para dejarlo, lo cancela");
+      }
+      const tarde = horasEntre(estado.ahora, p.inicio) < HORAS_CANCELACION_GRATUITA;
+      if (tarde && datos.forzar !== true) {
+        throw new ErrorDelClub(
+          "FUERA_DE_PLAZO",
+          `Faltan menos de ${HORAS_CANCELACION_GRATUITA} horas para el partido. Salir ahora cuesta la parte del partido (penalización): solo con forzar.`,
+        );
+      }
+      p.jugadores = p.jugadores.filter((j) => j !== socio.id);
+      if (tarde) p.penalizaciones.push({ socioId: socio.id, importe: p.importePorJugador });
+      actualizarPlazas(p);
+      barrerPartidos();
+      return { partido: p };
+    },
+
+    cancelarPartido(quien: Socio | undefined, id: string, datos: { forzar?: unknown }) {
+      const socio = exigirSocio(quien);
+      const p = partidoPorId(id);
+      if (socio.id !== p.organizador && socio.rol !== "gestor") {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo el organizador o un gestor puede cancelar el partido", 403);
+      }
+      if (datos.forzar !== undefined && typeof datos.forzar !== "boolean") invalido("forzar debe ser true o false");
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido ya está cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      const r = reserva(p.reservaId);
+      penalizarSiTarde(r, datos.forzar);
+      r.estado = "cancelada";
+      r.motivoCancelacion = "Partido cancelado por el organizador";
+      p.estado = "cancelado";
+      p.motivo = "organizador";
+      return { partido: p };
+    },
   };
 }
 
