diff --git a/test/partidos.test.ts b/test/partidos.test.ts
new file mode 100644
index 0000000..f557c27
--- /dev/null
+++ b/test/partidos.test.ts
@@ -0,0 +1,357 @@
+// Partidos abiertos (docs/specs/partidos-abiertos.md), probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const ORGANIZADOR = "socio-041"; // Nora Benítez: sin reservas
+const SIN_CUOTA = "socio-011";
+// Del 25 de noviembre en adelante la semilla no tiene reservas: todas las franjas están libres.
+const MIERCOLES = "2026-11-25T18:00"; // punta en pista 1: 2800
+
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status, `${codigo}: ${r.texto}`);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+/** Socios con la cuota al día, sin rol de gestor y sin reservas futuras, aparte de Nora. */
+async function sociosLibres(api: Api): Promise<string[]> {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  return estado.socios
+    .filter((s: any) => s.cuotaActiva && s.rol === "socio" && s.id !== ORGANIZADOR)
+    .filter((s: any) => !estado.reservas.some((r: any) => r.socioId === s.id && r.estado === "confirmada" && r.inicio > estado.ahora))
+    .map((s: any) => s.id);
+}
+
+async function crear(api: Api, cuerpo: Record<string, unknown> = {}, socio = ORGANIZADOR) {
+  return api.pedir("POST", "/api/partidos", { socio, cuerpo: { pistaId: "pista-1", inicio: MIERCOLES, ...cuerpo } });
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+test("permisos: crear, unirse y salir necesitan X-Socio; cancelar y fijar nivel, permiso", () => conApi(async (api) => {
+  error(await api.pedir("POST", "/api/partidos", { cuerpo: { pistaId: "pista-1", inicio: MIERCOLES } }), 401, "NO_IDENTIFICADO");
+  const { partido } = (await crear(api)).cuerpo;
+  error(await api.pedir("POST", `/api/partidos/${partido.id}/unirse`), 401, "NO_IDENTIFICADO");
+  error(await api.pedir("POST", `/api/partidos/${partido.id}/salir`), 401, "NO_IDENTIFICADO");
+  error(await api.pedir("POST", `/api/partidos/${partido.id}/cancelar`), 401, "NO_IDENTIFICADO");
+  error(await api.pedir("POST", `/api/partidos/${partido.id}/cancelar`, { socio: "socio-003" }), 403, "SIN_PERMISO");
+  error(await api.pedir("PATCH", "/api/socios/socio-003", { socio: "socio-004", cuerpo: { nivel: 3 } }), 403, "SIN_PERMISO");
+  error(await api.pedir("PATCH", "/api/socios/socio-003", { cuerpo: { nivel: 3 } }), 401, "NO_IDENTIFICADO");
+  assert.equal((await api.pedir("GET", "/api/partidos")).status, 200);
+  assert.equal((await api.pedir("GET", `/api/partidos/${partido.id}`)).status, 200);
+  const porGestor = await api.pedir("POST", `/api/partidos/${partido.id}/cancelar`, { socio: GESTOR });
+  assert.equal(porGestor.status, 200);
+  assert.equal(porGestor.cuerpo.partido.estado, "cancelado");
+  const otro = (await crear(api, { inicio: "2026-11-26T18:00" })).cuerpo.partido;
+  const porOrganizador = await api.pedir("POST", `/api/partidos/${otro.id}/cancelar`, { socio: ORGANIZADOR });
+  assert.equal(porOrganizador.status, 200);
+}));
+
+test("nivel de los socios: se fija, se quita y sale en la búsqueda", () => conApi(async (api) => {
+  const busqueda = await api.pedir("GET", "/api/socios?texto=irene");
+  assert.equal(busqueda.cuerpo.socios[0].nivel, null);
+  const propio = await api.pedir("PATCH", "/api/socios/socio-004", { socio: "socio-004", cuerpo: { nivel: 4.5 } });
+  assert.equal(propio.status, 200);
+  assert.equal(propio.cuerpo.socio.nivel, 4.5);
+  assert.equal((await api.pedir("GET", "/api/socios?texto=irene")).cuerpo.socios[0].nivel, 4.5);
+  const gestor = await api.pedir("PATCH", "/api/socios/socio-004", { socio: GESTOR, cuerpo: { nivel: 1 } });
+  assert.equal(gestor.cuerpo.socio.nivel, 1);
+  assert.equal((await api.pedir("PATCH", "/api/socios/socio-004", { socio: GESTOR, cuerpo: { nivel: 7 } })).cuerpo.socio.nivel, 7);
+  const quitado = await api.pedir("PATCH", "/api/socios/socio-004", { socio: "socio-004", cuerpo: { nivel: null } });
+  assert.equal(quitado.cuerpo.socio.nivel, null);
+  for (const nivel of [0.5, 7.5, 3.2, "3", undefined, true]) {
+    error(await api.pedir("PATCH", "/api/socios/socio-004", { socio: GESTOR, cuerpo: { nivel } }), 400, "DATOS_INVALIDOS");
+  }
+  error(await api.pedir("PATCH", "/api/socios/socio-999", { socio: GESTOR, cuerpo: { nivel: 3 } }), 404, "SOCIO_NO_ENCONTRADO");
+}));
+
+test("crear un partido sigue las reglas de siempre de las reservas", () => conApi(async (api) => {
+  error(await crear(api, { pistaId: "pista-9" }), 404, "PISTA_NO_ENCONTRADA");
+  error(await crear(api, { inicio: "2026-11-25T18:15" }), 400, "FRANJA_INVALIDA");
+  error(await crear(api, { pistaId: undefined }), 400, "DATOS_INVALIDOS");
+  error(await crear(api, {}, SIN_CUOTA), 409, "CUOTA_INACTIVA");
+  error(await crear(api, { pistaId: "pista-4" }), 409, "PISTA_CERRADA");
+  error(await crear(api, { inicio: "2026-11-18T09:00" }), 409, "FRANJA_PASADA");
+  error(await crear(api, { pistaId: "pista-1", inicio: "2026-11-19T19:30" }), 409, "FRANJA_NO_DISPONIBLE");
+  // Luis Martín tiene dos reservas futuras: con el partido llega a tres y ya no puede crear otro.
+  assert.equal((await crear(api, {}, "socio-005")).status, 201);
+  error(await crear(api, { inicio: "2026-11-26T18:00" }, "socio-005"), 409, "LIMITE_DE_RESERVAS");
+  error(await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-005", pistaId: "pista-1", inicio: "2026-11-27T18:00" } }), 409, "LIMITE_DE_RESERVAS");
+}));
+
+test("crear con rango de nivel", () => conApi(async (api) => {
+  error(await crear(api, { nivelMin: 3 }), 400, "DATOS_INVALIDOS");
+  error(await crear(api, { nivelMax: 3 }), 400, "DATOS_INVALIDOS");
+  error(await crear(api, { nivelMin: 4, nivelMax: 3 }), 400, "DATOS_INVALIDOS");
+  error(await crear(api, { nivelMin: 0, nivelMax: 3 }), 400, "DATOS_INVALIDOS");
+  error(await crear(api, { nivelMin: 3, nivelMax: 3.3 }), 400, "DATOS_INVALIDOS");
+  error(await crear(api, { nivelMin: 3, nivelMax: 4 }), 409, "NIVEL_SIN_DEFINIR");
+  await api.pedir("PATCH", `/api/socios/${ORGANIZADOR}`, { socio: ORGANIZADOR, cuerpo: { nivel: 5 } });
+  error(await crear(api, { nivelMin: 3, nivelMax: 4.5 }), 409, "NIVEL_FUERA_DE_RANGO");
+  const creado = await crear(api, { nivelMin: 3, nivelMax: 5 });
+  assert.equal(creado.status, 201);
+  assert.equal(creado.cuerpo.partido.nivelMin, 3);
+  assert.equal(creado.cuerpo.partido.nivelMax, 5);
+  const sinRango = await crear(api, { inicio: "2026-11-26T18:00" });
+  assert.equal(sinRango.cuerpo.partido.nivelMin, null);
+  assert.equal(sinRango.cuerpo.partido.nivelMax, null);
+}));
+
+test("el partido crea su reserva, responde 201 y se consulta", () => conApi(async (api) => {
+  const creado = await crear(api);
+  assert.equal(creado.status, 201);
+  const p = creado.cuerpo.partido;
+  assert.equal(p.estado, "abierto");
+  assert.deepEqual(p.jugadores, [ORGANIZADOR]);
+  assert.equal(p.organizador, ORGANIZADOR);
+  assert.equal(p.plazasLibres, 3);
+  assert.deepEqual(p.penalizaciones, []);
+  assert.equal(p.pistaId, "pista-1");
+  assert.equal(p.inicio, MIERCOLES);
+  assert.equal(p.fin, "2026-11-25T19:30");
+  assert.equal(p.importe, 2800);
+  assert.equal(p.importePorJugador, 700);
+  assert.equal(p.motivo, undefined);
+  const reservas = (await api.pedir("GET", `/api/reservas?socio=${ORGANIZADOR}`)).cuerpo.reservas;
+  assert.equal(reservas.length, 1);
+  assert.equal(reservas[0].id, p.reservaId);
+  assert.equal(reservas[0].estado, "confirmada");
+  assert.equal(reservas[0].importe, 2800);
+  assert.equal(reservas[0].partidoId, p.id);
+  const dia = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-25&pista=pista-1")).cuerpo;
+  assert.equal(dia.pistas[0].franjas.find((f: any) => f.inicio === MIERCOLES).estado, "reservada");
+  const consultado = await api.pedir("GET", `/api/partidos/${p.id}`);
+  assert.deepEqual(consultado.cuerpo.partido, p);
+  error(await api.pedir("GET", "/api/partidos/P-9999"), 404, "PARTIDO_NO_ENCONTRADO");
