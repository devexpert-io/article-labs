+          (nivel === undefined || p.nivelMin === null || p.nivelMax === null || (nivel >= p.nivelMin && nivel <= p.nivelMax)))
+        .sort((a, b) => (a.inicio === b.inicio ? a.pistaId.localeCompare(b.pistaId) : a.inicio.localeCompare(b.inicio)));
+      return { partidos };
+    },
+
+    obtenerPartido(id: string) {
+      cerrarPartidosIncompletos();
+      return { partido: partido(id) };
+    },
+
+    unirseAPartido(quien: Socio | undefined, id: string) {
+      cerrarPartidosIncompletos();
+      const yo = identificado(quien);
+      const p = partido(id);
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.jugadores.includes(yo.id)) throw new ErrorDelClub("YA_APUNTADO", `${yo.nombre} ya juega en este partido`);
+      if (p.estado === "completo") throw new ErrorDelClub("PARTIDO_COMPLETO", "El partido ya está completo");
+      if (!yo.cuotaActiva) throw new ErrorDelClub("CUOTA_INACTIVA", `${yo.nombre} no tiene la cuota al día`);
+      comprobarNivel(yo, p);
+      comprobarLimite(yo);
+      p.jugadores.push(yo.id);
+      p.plazasLibres = JUGADORES_POR_PARTIDO - p.jugadores.length;
+      if (p.plazasLibres === 0) p.estado = "completo";
+      return { partido: p };
+    },
+
+    salirDePartido(quien: Socio | undefined, id: string, datos: { forzar?: unknown }) {
+      cerrarPartidosIncompletos();
+      const yo = identificado(quien);
+      const p = partido(id);
+      comprobarForzar(datos.forzar);
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      if (p.organizador === yo.id) {
+        throw new ErrorDelClub("ORGANIZADOR_NO_PUEDE_SALIR", "Quien organiza el partido no puede salir: para dejarlo, lo cancela");
+      }
+      if (!p.jugadores.includes(yo.id)) throw new ErrorDelClub("NO_APUNTADO", `${yo.nombre} no juega en este partido`);
+      const horas = horasEntre(estado.ahora, p.inicio);
+      if (horas < HORAS_CANCELACION_GRATUITA) {
+        if (datos.forzar !== true) {
+          throw new ErrorDelClub(
+            "FUERA_DE_PLAZO",
+            `Faltan ${Math.floor(horas)} horas para el partido y se puede salir gratis hasta ${HORAS_CANCELACION_GRATUITA} horas antes. ` +
+            "Con forzar se sale pagando la parte del jugador: solo si el socio la ha aceptado expresamente.",
+          );
+        }
+        p.penalizaciones.push({ socioId: yo.id, importe: p.importePorJugador });
+      }
+      p.jugadores = p.jugadores.filter((j) => j !== yo.id);
+      p.plazasLibres = JUGADORES_POR_PARTIDO - p.jugadores.length;
+      p.estado = "abierto";
+      cerrarPartidosIncompletos();
+      return { partido: p };
+    },
+
+    cancelarPartido(quien: Socio | undefined, id: string, datos: { forzar?: unknown }) {
+      cerrarPartidosIncompletos();
+      const yo = identificado(quien);
+      const p = partido(id);
+      if (yo.id !== p.organizador && yo.rol !== "gestor") sinPermiso();
+      comprobarForzar(datos.forzar);
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido ya está cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      const r = reserva(p.reservaId);
+      const horas = horasEntre(estado.ahora, p.inicio);
+      if (horas < HORAS_CANCELACION_GRATUITA) {
+        if (datos.forzar !== true) {
+          throw new ErrorDelClub(
+            "FUERA_DE_PLAZO",
+            `Faltan ${Math.floor(horas)} horas para el partido y la cancelación gratuita termina ${HORAS_CANCELACION_GRATUITA} horas antes. ` +
+            "Con forzar se cancela con una penalización del 100 % del importe: solo si el socio ha aceptado expresamente la penalización.",
+          );
+        }
+        r.penalizacion = r.importe;
+      }
+      r.estado = "cancelada";
+      p.estado = "cancelado";
+      p.motivo = "organizador";
+      return { partido: p };
+    },
   };
 }
 
