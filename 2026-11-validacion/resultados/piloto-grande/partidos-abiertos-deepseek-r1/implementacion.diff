+        if (!nivelValido(filtros.nivel)) invalido("nivel debe ser un número entre 1 y 7 en pasos de 0,5");
+        nivel = filtros.nivel;
+      }
+      const partidos = estado.partidos
+        .filter((p) => p.estado === "abierto" && p.inicio > estado.ahora)
+        .filter((p) => filtros.fecha === undefined || p.inicio.slice(0, 10) === filtros.fecha)
+        .filter((p) => nivel === undefined || p.nivelMin === null || (p.nivelMin <= nivel && nivel <= p.nivelMax!))
+        .sort((a, b) => (a.inicio === b.inicio ? a.id.localeCompare(b.id) : a.inicio.localeCompare(b.inicio)));
+      return { partidos };
+    },
+
+    obtenerPartido(id: string) {
+      aplicarCancelaciones();
+      return { partido: partido(id) };
+    },
+
+    unirsePartido(quien: Socio | undefined, id: string) {
+      aplicarCancelaciones();
+      const socio = exigirSocio(quien);
+      const p = partido(id);
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.jugadores.includes(socio.id)) throw new ErrorDelClub("YA_APUNTADO", `${socio.nombre} ya juega en este partido`);
+      if (p.estado === "completo" || p.jugadores.length >= JUGADORES_POR_PARTIDO) {
+        throw new ErrorDelClub("PARTIDO_COMPLETO", "El partido ya tiene sus cuatro jugadores");
+      }
+      if (!socio.cuotaActiva) throw new ErrorDelClub("CUOTA_INACTIVA", `${socio.nombre} no tiene la cuota al día`);
+      comprobarNivel(socio, p);
+      if (reservasFuturas(socio.id) >= MAXIMO_RESERVAS_FUTURAS) {
+        throw new ErrorDelClub("LIMITE_DE_RESERVAS", `${socio.nombre} ya tiene ${MAXIMO_RESERVAS_FUTURAS} reservas futuras`);
+      }
+      p.jugadores.push(socio.id);
+      p.plazasLibres = JUGADORES_POR_PARTIDO - p.jugadores.length;
+      p.estado = p.plazasLibres === 0 ? "completo" : "abierto";
+      return { partido: p };
+    },
+
+    salirPartido(quien: Socio | undefined, id: string, datos: { forzar?: unknown }) {
+      aplicarCancelaciones();
+      const socio = exigirSocio(quien);
+      const p = partido(id);
+      if (datos.forzar !== undefined && typeof datos.forzar !== "boolean") invalido("forzar debe ser true o false");
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido está cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      if (p.organizador === socio.id) {
+        throw new ErrorDelClub("ORGANIZADOR_NO_PUEDE_SALIR", "El organizador no puede salir de su partido: tiene que cancelarlo");
+      }
+      if (!p.jugadores.includes(socio.id)) throw new ErrorDelClub("NO_APUNTADO", `${socio.nombre} no juega en este partido`);
+      const horas = horasEntre(estado.ahora, p.inicio);
+      if (horas < HORAS_CANCELACION_GRATUITA) {
+        if (datos.forzar !== true) {
+          throw new ErrorDelClub(
+            "FUERA_DE_PLAZO",
+            `Faltan ${Math.floor(horas)} horas para el partido: para salir hay que forzar y se paga la parte de ${socio.nombre}`,
+          );
+        }
+        p.penalizaciones.push({ socioId: socio.id, importe: p.importePorJugador });
+      }
+      p.jugadores = p.jugadores.filter((j) => j !== socio.id);
+      p.plazasLibres = JUGADORES_POR_PARTIDO - p.jugadores.length;
+      p.estado = "abierto";
+      // Si deja de estar completo dentro del plazo, el partido se cancela solo.
+      aplicarCancelaciones();
+      return { partido: p };
+    },
+
+    cancelarPartido(quien: Socio | undefined, id: string, datos: { forzar?: unknown }) {
+      aplicarCancelaciones();
+      const socio = exigirSocio(quien);
+      const p = partido(id);
+      if (datos.forzar !== undefined && typeof datos.forzar !== "boolean") invalido("forzar debe ser true o false");
+      if (socio.id !== p.organizador && socio.rol !== "gestor") {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo quien organiza el partido o un gestor pueden cancelarlo", 403);
+      }
+      if (p.estado === "cancelado") throw new ErrorDelClub("PARTIDO_CANCELADO", "El partido ya estaba cancelado");
+      if (p.inicio <= estado.ahora) throw new ErrorDelClub("FRANJA_PASADA", "El partido ya ha empezado o ha pasado");
+      const horas = horasEntre(estado.ahora, p.inicio);
+      if (horas < HORAS_CANCELACION_GRATUITA && datos.forzar !== true) {
+        throw new ErrorDelClub(
+          "FUERA_DE_PLAZO",
+          `Faltan ${Math.floor(horas)} horas para el partido: para cancelarlo hay que forzar y la reserva paga el 100 % del importe`,
+        );
+      }
+      p.estado = "cancelado";
+      p.motivo = "organizador";
+      const suya = reserva(p.reservaId);
+      if (suya.estado === "confirmada") {
+        if (horasEntre(estado.ahora, suya.inicio) < HORAS_CANCELACION_GRATUITA) suya.penalizacion = suya.importe;
+        suya.estado = "cancelada";
+      }
+      return { partido: p };
+    },
   };
 }
 
