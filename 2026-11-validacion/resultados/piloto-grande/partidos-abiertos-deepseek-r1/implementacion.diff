diff --git a/test/partidos.test.ts b/test/partidos.test.ts
new file mode 100644
index 0000000..57ba48f
--- /dev/null
+++ b/test/partidos.test.ts
@@ -0,0 +1,450 @@
+// Los partidos abiertos: una pista reservada por un socio con tres plazas libres para que se apunten otros.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const P1 = "pista-1";
+const P2 = "pista-2";
+const P3 = "pista-3";
+
+async function crear(api: Api, socio: string, cuerpo: Record<string, unknown>) {
+  const r = await api.pedir("POST", "/api/partidos", { socio, cuerpo });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.partido;
+}
+
+async function unirse(api: Api, socio: string, id: string) {
+  return api.pedir("POST", `/api/partidos/${id}/unirse`, { socio });
+}
+
+async function salir(api: Api, socio: string, id: string, cuerpo?: Record<string, unknown>) {
+  return api.pedir("POST", `/api/partidos/${id}/salir`, { socio, cuerpo });
+}
+
+async function cancelar(api: Api, socio: string, id: string, cuerpo?: Record<string, unknown>) {
+  return api.pedir("POST", `/api/partidos/${id}/cancelar`, { socio, cuerpo });
+}
+
+async function nivel(api: Api, socio: string, destino: string, valor: unknown) {
+  return api.pedir("PATCH", `/api/socios/${destino}`, { socio, cuerpo: { nivel: valor } });
+}
+
+async function moverReloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200, r.texto);
+}
+
+test("crear un partido reserva la pista y devuelve un partido abierto", () =>
+  conApi(async (api) => {
+    const partido = await crear(api, "socio-006", { pistaId: P1, inicio: "2026-11-20T18:00" });
+    assert.equal(partido.estado, "abierto");
+    assert.equal(partido.organizador, "socio-006");
+    assert.deepEqual(partido.jugadores, ["socio-006"]);
+    assert.equal(partido.plazasLibres, 3);
+    assert.deepEqual(partido.penalizaciones, []);
+    assert.equal(partido.inicio, "2026-11-20T18:00");
+    assert.equal(partido.fin, "2026-11-20T19:30");
+    assert.equal(partido.nivelMin, null);
+    assert.equal(partido.nivelMax, null);
+    assert.equal(partido.importe, 2800);
+    assert.equal(partido.importePorJugador, 700);
+
+    const reserva = await api.pedir("GET", `/api/reservas/${partido.reservaId}`);
+    assert.equal(reserva.status, 200);
+    assert.equal(reserva.cuerpo.reserva.estado, "confirmada");
+    assert.equal(reserva.cuerpo.reserva.socioId, "socio-006");
+    assert.equal(reserva.cuerpo.reserva.importe, 2800);
+    assert.equal(reserva.cuerpo.reserva.partidoId, partido.id);
+    const listaReservas = await api.pedir("GET", "/api/reservas?fecha=2026-11-20&pista=pista-1");
+    assert.equal(
+      listaReservas.cuerpo.reservas.some((r: any) => r.id === partido.reservaId && r.partidoId === partido.id),
+      true,
+    );
+
+    const disponibilidad = await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-20&pista=pista-1");
+    const franja = disponibilidad.cuerpo.pistas[0].franjas.find((f: any) => f.inicio === "2026-11-20T18:00");
+    assert.equal(franja.estado, "reservada");
+
+    // Consultar no necesita identificarse.
+    const consulta = await api.pedir("GET", `/api/partidos/${partido.id}`);
+    assert.equal(consulta.status, 200);
+    assert.deepEqual(consulta.cuerpo.partido, partido);
+    assert.equal((await api.pedir("GET", "/api/partidos")).status, 200);
+  }));
+
+test("permisos: identificarse para crear, unirse y salir; cancelar es del organizador o de un gestor", () =>
+  conApi(async (api) => {
+    const sinCabecera = await api.pedir("POST", "/api/partidos", { cuerpo: { pistaId: P1, inicio: "2026-11-20T18:00" } });
+    assert.equal(sinCabecera.status, 401);
+    assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const desconocido = await api.pedir("POST", "/api/partidos", { socio: "socio-999", cuerpo: { pistaId: P1, inicio: "2026-11-20T18:00" } });
+    assert.equal(desconocido.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const partido = await crear(api, "socio-006", { pistaId: P1, inicio: "2026-11-20T18:00" });
+    assert.equal((await api.pedir("POST", `/api/partidos/${partido.id}/unirse`)).cuerpo.error.codigo, "NO_IDENTIFICADO");
+    assert.equal((await api.pedir("POST", `/api/partidos/${partido.id}/salir`)).cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const ajeno = await cancelar(api, "socio-016", partido.id);
+    assert.equal(ajeno.status, 403);
+    assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+    const nivelAjeno = await nivel(api, "socio-016", "socio-006", 3);
+    assert.equal(nivelAjeno.status, 403);
+    assert.equal(nivelAjeno.cuerpo.error.codigo, "SIN_PERMISO");
+    const nivelSinCabecera = await api.pedir("PATCH", "/api/socios/socio-006", { cuerpo: { nivel: 3 } });
+    assert.equal(nivelSinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const gestor = await cancelar(api, "socio-040", partido.id);
+    assert.equal(gestor.status, 200);
+    assert.equal(gestor.cuerpo.partido.estado, "cancelado");
+  }));
+
+test("el nivel de los socios va de 1 a 7 en pasos de 0,5 o se quita con null", () =>
+  conApi(async (api) => {
+    const propio = await nivel(api, "socio-006", "socio-006", 3.5);
+    assert.equal(propio.status, 200);
+    assert.equal(propio.cuerpo.socio.nivel, 3.5);
+    assert.equal((await nivel(api, "socio-040", "socio-006", null)).cuerpo.socio.nivel, null);
+
+    for (const valor of [0, 7.5, 2.3, "3"]) {
+      const r = await nivel(api, "socio-006", "socio-006", valor);
+      assert.equal(r.status, 400, `nivel ${valor}`);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    const sinNivel = await api.pedir("PATCH", "/api/socios/socio-006", { socio: "socio-006", cuerpo: {} });
+    assert.equal(sinNivel.status, 400);
+    assert.equal(sinNivel.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const noExiste = await nivel(api, "socio-040", "socio-999", 3);
+    assert.equal(noExiste.status, 404);
+    assert.equal(noExiste.cuerpo.error.codigo, "SOCIO_NO_ENCONTRADO");
+
+    const antes = await api.pedir("GET", "/api/socios?texto=Nora");
+    assert.equal(antes.cuerpo.socios.find((s: any) => s.id === "socio-041").nivel, null);
+    await nivel(api, "socio-041", "socio-041", 4);
+    const despues = await api.pedir("GET", "/api/socios?texto=Nora");
+    assert.equal(despues.cuerpo.socios.find((s: any) => s.id === "socio-041").nivel, 4);
+  }));
+
+test("crear un partido aplica las reglas de siempre al organizador", () =>
+  conApi(async (api) => {
+    const casos: Array<[Record<string, unknown>, string, number]> = [
+      [{ pistaId: "pista-999", inicio: "2026-11-20T18:00" }, "PISTA_NO_ENCONTRADA", 404],
+      [{ pistaId: P1, inicio: "2026-11-20T17:00" }, "FRANJA_INVALIDA", 400],
+      [{ pistaId: "pista-4", inicio: "2026-11-20T18:00" }, "PISTA_CERRADA", 409],
+      [{ pistaId: P1, inicio: "2026-11-18T09:00" }, "FRANJA_PASADA", 409],
+      [{ pistaId: P1, inicio: "2026-11-19T19:30" }, "FRANJA_NO_DISPONIBLE", 409],
+      [{ pistaId: P2, inicio: "2026-11-18T15:00" }, "DEMASIADO_TARDE", 409],
+    ];
+    for (const [cuerpo, codigo, status] of casos) {
+      const r = await api.pedir("POST", "/api/partidos", { socio: "socio-006", cuerpo });
+      assert.equal(r.status, status, `${codigo}: ${r.texto}`);
+      assert.equal(r.cuerpo.error.codigo, codigo);
+    }
+
+    const inactivo = await api.pedir("POST", "/api/partidos", { socio: "socio-022", cuerpo: { pistaId: P1, inicio: "2026-11-20T18:00" } });
