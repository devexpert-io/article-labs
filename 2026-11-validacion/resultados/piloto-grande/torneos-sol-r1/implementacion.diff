+const gestor = "socio-040";
+const franjas = ["09:00", "10:30", "12:00", "13:30", "15:00"].map((h) => `2026-12-01T${h}`);
+const datos = { nombre: "Copa del club", pistas: ["pista-2", "pista-1"], franjas, plazas: 16, cuota: 1500 };
+const parejas = Array.from({ length: 16 }, (_, i) => {
+  const activos = Array.from({ length: 40 }, (_, n) => n + 1).filter((n) => n % 11 !== 0);
+  return activos.slice(i * 2, i * 2 + 2).map((n) => `socio-${String(n).padStart(3, "0")}`);
+});
+async function iniciar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+function error(r: Respuesta, codigo: string, status = 409) {
+  assert.equal(r.status, status, r.texto);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+async function crear(api: Api, cambios = {}): Promise<Torneo> {
+  const r = await api.pedir("POST", "/api/torneos", { socio: gestor, cuerpo: { ...datos, ...cambios } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.torneo;
+}
+async function inscribir(api: Api, id: string, cantidad: number) {
+  const inscripciones = [];
+  for (const socios of parejas.slice(0, cantidad)) {
+    const r = await api.pedir("POST", `/api/torneos/${id}/inscripciones`, { socio: socios[0], cuerpo: { socios } });
+    assert.equal(r.status, 201, r.texto);
+    inscripciones.push(r.cuerpo.inscripcion);
+  }
+  return inscripciones;
+}
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+async function cerrar(api: Api, id: string): Promise<Torneo> {
+  const r = await api.pedir("POST", `/api/torneos/${id}/cerrar`, { socio: gestor });
+  assert.equal(r.status, 200, r.texto);
