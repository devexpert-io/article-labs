+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import type { Partido } from "../src/tipos.ts";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+
+const nora = "socio-041", marta = "socio-002", irene = "socio-004", luis = "socio-005", gestor = "socio-040";
+const inicio = "2026-12-10T18:00";
+function error(r: Respuesta, codigo: string, status = 409) {
+  assert.equal(r.status, status, r.texto);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+async function crear(api: Api, socio = nora, datos: object = {}) {
+  const r = await api.pedir("POST", "/api/partidos", { socio, cuerpo: { pistaId: "pista-2", inicio, ...datos } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.partido;
+}
+async function accion(api: Api, id: string, accion: string, socio?: string, cuerpo?: object) {
+  return api.pedir("POST", `/api/partidos/${id}/${accion}`, { socio, cuerpo });
+}
+async function escenario(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try { await fn(api); } finally { api.cerrar(); }
+}
+
+test("permisos, nivel de los socios y partidos inexistentes", () => escenario(async (api) => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.ok(estado.socios.every((s: any) => s.nivel === null));
+  for (const ruta of ["/api/partidos", "/api/partidos/no/unirse", "/api/partidos/no/salir", "/api/partidos/no/cancelar"]) {
+    error(await api.pedir("POST", ruta), "NO_IDENTIFICADO", 401);
+  }
+  error(await api.pedir("PATCH", `/api/socios/${nora}`, { cuerpo: { nivel: 3 } }), "NO_IDENTIFICADO", 401);
+  error(await api.pedir("PATCH", `/api/socios/${nora}`, { socio: marta, cuerpo: { nivel: 3 } }), "SIN_PERMISO", 403);
+  error(await api.pedir("PATCH", "/api/socios/no", { socio: gestor, cuerpo: { nivel: 3 } }), "SOCIO_NO_ENCONTRADO", 404);
+  for (const nivel of [0, 8, 3.2, "3", true, {}, undefined]) {
+    error(await api.pedir("PATCH", `/api/socios/${nora}`, { socio: nora, cuerpo: { nivel } }), "DATOS_INVALIDOS", 400);
+  }
+  for (const nivel of [1, 4.5, 7, null]) {
+    const r = await api.pedir("PATCH", `/api/socios/${nora}`, { socio: nivel === 7 ? gestor : nora, cuerpo: { nivel } });
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.socio.nivel, nivel);
+    assert.equal((await api.pedir("GET", "/api/socios?texto=Nora")).cuerpo.socios[0].nivel, nivel);
+  }
+  error(await api.pedir("GET", "/api/partidos/no"), "PARTIDO_NO_ENCONTRADO", 404);
+  for (const a of ["unirse", "salir", "cancelar"]) error(await accion(api, "no", a, nora), "PARTIDO_NO_ENCONTRADO", 404);
+  const p = await crear(api);
+  error(await accion(api, p.id, "cancelar", marta), "SIN_PERMISO", 403);
+  assert.equal((await accion(api, p.id, "cancelar", gestor)).status, 200);
+}));
+
+test("crear comparte las reglas de reservas y valida el rango sin dejar reservas huérfanas", () => escenario(async (api) => {
+  const casos: [object, string, string, number][] = [
+    [{ pistaId: "no" }, nora, "PISTA_NO_ENCONTRADA", 404],
+    [{ inicio: "mal" }, nora, "FRANJA_INVALIDA", 400],
+    [{ inicio: "2026-12-10T18:15" }, nora, "FRANJA_INVALIDA", 400],
+    [{}, "socio-011", "CUOTA_INACTIVA", 409],
+    [{ pistaId: "pista-4" }, nora, "PISTA_CERRADA", 409],
+    [{ inicio: "2026-11-18T09:00" }, nora, "FRANJA_PASADA", 409],
+    [{ pistaId: "pista-1", inicio: "2026-11-19T19:30" }, nora, "FRANJA_NO_DISPONIBLE", 409],
+    [{ inicio: "2026-11-18T15:00" }, nora, "DEMASIADO_TARDE", 409],
+  ];
+  for (const [datos, socio, codigo, status] of casos) {
+    error(await api.pedir("POST", "/api/partidos", { socio, cuerpo: { pistaId: "pista-2", inicio, ...datos } }), codigo, status);
+  }
+  for (const rango of [{ nivelMin: 3 }, { nivelMax: 4 }, { nivelMin: null, nivelMax: null }, { nivelMin: 4, nivelMax: 3 }, { nivelMin: 2.1, nivelMax: 4 }, { nivelMin: 1, nivelMax: 8 }]) {
+    error(await api.pedir("POST", "/api/partidos", { socio: nora, cuerpo: { pistaId: "pista-2", inicio, ...rango } }), "DATOS_INVALIDOS", 400);
+  }
+  const datos = { pistaId: "pista-2", inicio, nivelMin: 3, nivelMax: 4.5 };
+  error(await api.pedir("POST", "/api/partidos", { socio: nora, cuerpo: datos }), "NIVEL_SIN_DEFINIR");
+  await api.pedir("PATCH", `/api/socios/${nora}`, { socio: nora, cuerpo: { nivel: 5 } });
+  error(await api.pedir("POST", "/api/partidos", { socio: nora, cuerpo: datos }), "NIVEL_FUERA_DE_RANGO");
+  assert.equal((await api.pedir("GET", "/api/reservas?fecha=2026-12-10")).cuerpo.total, 0);
+  await api.pedir("PATCH", `/api/socios/${nora}`, { socio: nora, cuerpo: { nivel: 3 } });
+  const p = await crear(api, nora, datos);
+  assert.equal(p.nivelMin, 3);
+}));
+
+test("reserva vinculada, respuesta, importe, jugadores y estados", () => escenario(async (api) => {
+  const p = await crear(api);
+  assert.deepEqual(p, {
+    id: p.id, reservaId: p.reservaId, pistaId: "pista-2", inicio, fin: "2026-12-10T19:30",
+    organizador: nora, jugadores: [nora], plazasLibres: 3, nivelMin: null, nivelMax: null,
+    estado: "abierto", importe: 2800, importePorJugador: 700, penalizaciones: [],
+  });
+  assert.deepEqual((await api.pedir("GET", `/api/partidos/${p.id}`)).cuerpo.partido, p);
+  const r = (await api.pedir("GET", "/api/reservas?fecha=2026-12-10")).cuerpo.reservas[0];
+  assert.equal(r.id, p.reservaId);
+  assert.equal(r.partidoId, p.id);
+  assert.equal(r.socioId, nora);
+  assert.equal(r.estado, "confirmada");
+  const disponible = async () => (await api.pedir("GET", "/api/disponibilidad?fecha=2026-12-10&pista=pista-2")).cuerpo.pistas[0].franjas.find((f: any) => f.inicio === inicio).estado;
+  assert.equal(await disponible(), "reservada");
+  error(await api.pedir("POST", `/api/reservas/${r.id}/cancelar`), "ES_UN_PARTIDO");
+  error(await accion(api, p.id, "unirse", nora), "YA_APUNTADO");
+  error(await accion(api, p.id, "unirse", "socio-011"), "CUOTA_INACTIVA");
+  for (const [i, socio] of [marta, irene, luis].entries()) {
+    const unido: Partido = (await accion(api, p.id, "unirse", socio)).cuerpo.partido;
+    assert.deepEqual(unido.jugadores, [nora, marta, irene, luis].slice(0, i + 2));
+    assert.equal(unido.plazasLibres, 2 - i);
+    assert.equal(unido.estado, i === 2 ? "completo" : "abierto");
+  }
+  error(await accion(api, p.id, "unirse", gestor), "PARTIDO_COMPLETO");
+  assert.equal((await api.pedir("GET", "/api/partidos")).cuerpo.partidos.length, 0);
+  const sale = (await accion(api, p.id, "salir", luis)).cuerpo.partido;
+  assert.equal(sale.estado, "abierto");
+  assert.equal(sale.plazasLibres, 1);
+  error(await accion(api, p.id, "salir", luis), "NO_APUNTADO");
+  error(await accion(api, p.id, "salir", nora), "ORGANIZADOR_NO_PUEDE_SALIR");
+  const cancelado = (await accion(api, p.id, "cancelar", nora)).cuerpo.partido;
+  assert.equal(cancelado.estado, "cancelado");
+  assert.equal(cancelado.motivo, "organizador");
+  assert.equal(await disponible(), "libre");
+  for (const a of ["unirse", "salir", "cancelar"]) error(await accion(api, p.id, a, nora), "PARTIDO_CANCELADO");
+}));
+
+test("niveles al unirse y filtros de consulta ordenados", () => escenario(async (api) => {
+  for (const [socio, nivel] of [[nora, 3], [marta, 4.5], [irene, 5]] as const) await api.pedir("PATCH", `/api/socios/${socio}`, { socio, cuerpo: { nivel } });
+  const tarde = await crear(api, nora, { nivelMin: 3, nivelMax: 4.5 });
+  const pronto = await crear(api, marta, { inicio: "2026-12-09T12:00" });
