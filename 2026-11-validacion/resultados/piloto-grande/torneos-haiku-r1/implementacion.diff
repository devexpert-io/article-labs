+export type EstadoTorneo = "inscripcion" | "en_juego" | "terminado" | "cancelado";
+export type EstadoInscripcion = "inscrita" | "baja";
+export type EstadoPartido = "pendiente" | "jugado" | "descanso";
+
+export interface Inscripcion {
+  id: string;
