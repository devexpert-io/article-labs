+          .map((origen) => finDeFranja(origen.inicio!))
+          .reduce((max, fin) => (fin > max ? fin : max), "");
+        const libre = combinaciones.find((c) => !usadas.has(`${c.pistaId}|${c.inicio}`) && c.inicio >= minimo);
+        if (!libre) throw new ErrorDelClub("FRANJAS_INSUFICIENTES", "No hay franjas y pistas suficientes para todos los partidos del cuadro");
+        usadas.add(`${libre.pistaId}|${libre.inicio}`);
+        p.pistaId = libre.pistaId;
+        p.inicio = libre.inicio;
+      }
+
+      // Todo calculado: ahora sí se cambia el torneo.
+      t.partidos = partidos;
+      t.bloqueos = partidos.filter((p) => p.pistaId !== null).map((p) => ({ pistaId: p.pistaId!, inicio: p.inicio! }));
+      t.estado = "en_juego";
+      return { torneo: vistaTorneo(t) };
+    },
+
+    registrarResultado(quien: Socio | undefined, id: string, partidoId: string, datos: Record<string, unknown>) {
+      exigirGestor(quien);
+      const t = torneo(id);
+      const { ganadora, marcador } = datos;
+      if (typeof ganadora !== "string") invalido("ganadora es el id de la inscripción que gana");
+      if (marcador !== undefined && marcador !== null && typeof marcador !== "string") invalido("marcador debe ser un texto");
+      if (t.estado !== "en_juego") throw new ErrorDelClub("TORNEO_NO_EN_JUEGO", "El torneo no está en juego");
+      const p = t.partidos.find((x) => x.id === partidoId);
+      if (!p) throw new ErrorDelClub("PARTIDO_NO_ENCONTRADO", `No existe el partido ${partidoId} en este torneo`, 404);
+      if (p.estado === "descanso" || p.parejas.includes(null)) {
+        throw new ErrorDelClub("PARTIDO_NO_LISTO", "El partido aún no tiene sus dos parejas");
+      }
+      if (!p.parejas.includes(ganadora)) invalido("ganadora debe ser una de las dos parejas del partido");
+      if (p.inicio! > estado.ahora) throw new ErrorDelClub("PARTIDO_NO_EMPEZADO", "El partido aún no ha empezado");
+
+      const destino = siguienteDe(t.partidos, p);
+      if (destino && destino.estado === "jugado") {
+        throw new ErrorDelClub("RESULTADO_CERRADO", "La pareja ya jugó la ronda siguiente: el resultado no se puede cambiar");
+      }
+      p.ganadora = ganadora;
+      p.marcador = marcador ?? null;
+      p.estado = "jugado";
+      if (destino) {
+        destino.parejas[posicionEnDestino(t.partidos, p)] = ganadora;
+      } else {
+        t.estado = "terminado";
+        t.campeona = ganadora;
+      }
+      return { partido: p };
+    },
+
+    cancelarTorneo(quien: Socio | undefined, id: string) {
+      exigirGestor(quien);
+      const t = torneo(id);
+      if (t.estado === "terminado") throw new ErrorDelClub("TORNEO_TERMINADO", "Un torneo terminado no se cancela");
+      if (t.estado === "cancelado") throw new ErrorDelClub("YA_CANCELADO", "El torneo ya estaba cancelado");
+      t.estado = "cancelado";
+      t.bloqueos = [];
+      return { torneo: vistaTorneo(t) };
+    },
   };
 }
 
+// ----- Cuadro: ayudas -----
+
+/** Los dos partidos de la ronda anterior de los que sale la pareja del partido p (vacío en la primera ronda). */
+function alimentadores(rondas: Partido[][], p: Partido): Partido[] {
+  if (p.ronda === 1) return [];
+  const previa = rondas[p.ronda - 2]!;
+  const M = previa.length;
+  return [previa[p.numero - 1]!, previa[M - p.numero]!];
+}
+
+/** Lleva la ganadora de un descanso a su sitio en la ronda siguiente. */
+function llevarAlSiguiente(rondas: Partido[][], p: Partido) {
+  const siguiente = rondas[p.ronda];
+  if (!siguiente || p.ganadora === null) return;
+  const M = rondas[p.ronda - 1]!.length;
+  const j = Math.min(p.numero, M + 1 - p.numero);
+  siguiente[j - 1]!.parejas[p.numero === j ? 0 : 1] = p.ganadora;
+}
+
+/** El partido de la ronda siguiente al que va la ganadora de p (undefined en la final). */
+function siguienteDe(partidos: Partido[], p: Partido): Partido | undefined {
+  const M = partidos.filter((x) => x.ronda === p.ronda).length;
+  const j = Math.min(p.numero, M + 1 - p.numero);
+  return partidos.find((x) => x.ronda === p.ronda + 1 && x.numero === j);
+}
+
+/** Posición (0 o 1) que ocupa la ganadora de p en el partido siguiente. */
+function posicionEnDestino(partidos: Partido[], p: Partido): 0 | 1 {
+  const M = partidos.filter((x) => x.ronda === p.ronda).length;
+  const j = Math.min(p.numero, M + 1 - p.numero);
+  return p.numero === j ? 0 : 1;
+}
+
 export type Club = ReturnType<typeof crearClub>;
