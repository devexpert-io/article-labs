+test("cuadro y calendario con cinco parejas: descansos, rondas y franjas", async () => {
+  const t = await crearTorneo(api, { franjas: ["2026-11-25T10:30", "2026-11-25T12:00", "2026-11-25T13:30"] });
+  const ins: string[] = [];
+  for (const pareja of PAREJAS) ins.push((await inscribir(api, t.id, pareja)).cuerpo.inscripcion.id);
+  const cerrado = (await api.pedir("POST", `/api/torneos/${t.id}/cerrar`, { socio: GESTOR })).cuerpo.torneo;
+  assert.equal(cerrado.partidos.length, 7, "un cuadro de 8 tiene 7 partidos");
+
+  // Primera ronda: el 1, el 2 y el 3 descansan (sus rivales 8, 7 y 6 no existen); el 4 juega contra el 5.
+  const d1 = partido(cerrado, 1, 1);
+  assert.equal(d1.estado, "descanso");
+  assert.deepEqual(d1.parejas, [ins[0], null]);
+  assert.equal(d1.pistaId, null);
+  assert.equal(d1.inicio, null);
+  assert.deepEqual(partido(cerrado, 1, 2).parejas, [ins[1], null]);
+  assert.deepEqual(partido(cerrado, 1, 3).parejas, [ins[2], null]);
+  const p14 = partido(cerrado, 1, 4);
+  assert.deepEqual(p14.parejas, [ins[3], ins[4]]);
+  assert.equal(p14.estado, "pendiente");
+  // Segunda ronda: 1 contra la ganadora de 4 y 5; 2 contra 3 (ambas ya sabidas por los descansos).
+  assert.deepEqual(partido(cerrado, 2, 1).parejas, [ins[0], null]);
+  assert.deepEqual(partido(cerrado, 2, 2).parejas, [ins[1], ins[2]]);
+  assert.deepEqual(partido(cerrado, 3, 1).parejas, [null, null]);
+
+  // Calendario: 4 contra 5 a las 10:30 en pista 1; la segunda ronda, después de que acaben; la final, a las 13:30.
+  assert.deepEqual([p14.pistaId, p14.inicio], ["pista-1", "2026-11-25T10:30"]);
+  assert.deepEqual([partido(cerrado, 2, 1).pistaId, partido(cerrado, 2, 1).inicio], ["pista-1", "2026-11-25T12:00"]);
+  assert.deepEqual([partido(cerrado, 2, 2).pistaId, partido(cerrado, 2, 2).inicio], ["pista-2", "2026-11-25T10:30"]);
+  assert.deepEqual([partido(cerrado, 3, 1).pistaId, partido(cerrado, 3, 1).inicio], ["pista-1", "2026-11-25T13:30"]);
+
+  // Las franjas que no usa ningún partido dejan de estar bloqueadas (criterio 17).
+  assert.equal((await franja(api, "2026-11-25", "pista-2", "2026-11-25T13:30")).estado, "libre");
+  assert.equal((await franja(api, "2026-11-25", "pista-3", "2026-11-25T10:30")).estado, "libre");
+  assert.equal((await franja(api, "2026-11-25", "pista-1", "2026-11-25T12:00")).estado, "torneo");
+  // Y cerrar no toca las reservas normales.
+  const reservas = (await api.pedir("GET", "/api/reservas?fecha=2026-11-25")).cuerpo.total;
+  assert.equal(reservas, 0);
+});
