+  estado: EstadoTorneo;
+  inscripciones: Inscripcion[];
+  partidos: Partido[];
+  campeona: string | null;
+  /** Franjas bloqueadas (pista e inicio). Interno: no sale en la API. */
+  bloqueos: { pistaId: string; inicio: string }[];
+}
+
 export interface Estado {
   ahora: string;
   pistas: Pista[];
