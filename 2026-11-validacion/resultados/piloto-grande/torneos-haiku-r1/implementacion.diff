+// Los torneos de parejas, probados a través de la API (docs/specs/torneos.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+// Cada torneo por defecto tiene su propio día (desde 2027), para que no se bloqueen entre ellos.
+let diasUsados = 0;
+function diaNuevo(): string {
+  return new Date(Date.UTC(2027, 0, 4) + diasUsados++ * 86_400_000).toISOString().slice(0, 10);
+}
+// Socios con cuota al día y sin reservas en esos días. socio-011 tiene la cuota inactiva.
+const PAREJAS = [
+  ["socio-001", "socio-006"],
+  ["socio-003", "socio-007"],
+  ["socio-004", "socio-008"],
+  ["socio-005", "socio-009"],
+  ["socio-010", "socio-012"],
+];
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+function datosTorneo(extra: Record<string, unknown> = {}) {
+  const dia = diaNuevo();
+  const franjas = [`${dia}T10:30`, `${dia}T12:00`, `${dia}T13:30`];
+  return { nombre: "Torneo de otoño", pistas: ["pista-1", "pista-2", "pista-3"], franjas, plazas: 8, cuota: 1500, ...extra };
+}
+
+async function crear(a: Api, extra: Record<string, unknown> = {}): Promise<Respuesta> {
+  return a.pedir("POST", "/api/torneos", { socio: GESTOR, cuerpo: datosTorneo(extra) });
+}
+
+async function crearTorneo(a: Api, extra: Record<string, unknown> = {}): Promise<any> {
+  const r = await crear(a, extra);
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.torneo;
+}
+
+async function inscribir(a: Api, torneoId: string, socios: string[], quien: string = GESTOR): Promise<Respuesta> {
+  return a.pedir("POST", `/api/torneos/${torneoId}/inscripciones`, { socio: quien, cuerpo: { socios } });
+}
+
+async function detalle(a: Api, torneoId: string): Promise<any> {
+  return (await a.pedir("GET", `/api/torneos/${torneoId}`)).cuerpo.torneo;
+}
+
+function partido(torneo: any, ronda: number, numero: number): any {
+  return torneo.partidos.find((p: any) => p.ronda === ronda && p.numero === numero);
+}
+
+async function franja(a: Api, fecha: string, pistaId: string, inicio: string): Promise<any> {
+  const r = await a.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pistaId}`);
+  return r.cuerpo.pistas[0].franjas.find((f: any) => f.inicio === inicio);
+}
+
+test("permisos: crear necesita un gestor; consultar no necesita identificarse", async () => {
+  const sinCabecera = await api.pedir("POST", "/api/torneos", { cuerpo: datosTorneo() });
+  assert.equal(sinCabecera.status, 401);
+  assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("POST", "/api/torneos", { socio: "socio-001", cuerpo: datosTorneo() });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("GET", "/api/torneos")).status, 200);
+});
+
+test("datos del torneo: formato, pistas y franjas válidas, plazas y cuota", async () => {
+  const malos: Record<string, unknown>[] = [
+    { nombre: "  " },
+    { pistas: [] },
+    { pistas: ["pista-1", "pista-1"] },
+    { franjas: [] },
+    { franjas: ["2026-11-25T10:30", "2026-11-25T10:30"] },
+    { plazas: 3 },
+    { plazas: 17 },
+    { plazas: 4.5 },
+    { cuota: -1 },
+    { cuota: 1.5 },
+  ];
+  for (const extra of malos) {
+    const r = await crear(api, extra);
+    assert.equal(r.status, 400, JSON.stringify(extra));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", JSON.stringify(extra));
+  }
+  const noExiste = await crear(api, { pistas: ["pista-9"] });
+  assert.equal(noExiste.status, 404);
+  assert.equal(noExiste.cuerpo.error.codigo, "PISTA_NO_ENCONTRADA");
+  const invalida = await crear(api, { franjas: ["2026-11-25T11:00"] });
+  assert.equal(invalida.status, 400);
+  assert.equal(invalida.cuerpo.error.codigo, "FRANJA_INVALIDA");
+  const pasada = await crear(api, { franjas: ["2026-11-18T09:00"] });
+  assert.equal(pasada.status, 409);
+  assert.equal(pasada.cuerpo.error.codigo, "FRANJA_PASADA");
+  const cerrada = await crear(api, { pistas: ["pista-4"] });
+  assert.equal(cerrada.status, 409);
+  assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+});
+
+test("pistas libres: una reserva confirmada o otro torneo bloquean la franja y no se crea nada", async () => {
+  const antes = (await api.pedir("GET", "/api/torneos")).cuerpo.torneos.length;
+  const reservada = await crear(api, { pistas: ["pista-1", "pista-2"], franjas: ["2026-11-19T19:30", "2026-11-25T10:30"] });
+  assert.equal(reservada.status, 409);
+  assert.equal(reservada.cuerpo.error.codigo, "FRANJAS_OCUPADAS");
+  const conflictos = reservada.cuerpo.error.conflictos;
+  assert.equal(conflictos.length, 1);
+  assert.equal(conflictos[0].pistaId, "pista-1");
+  assert.equal(conflictos[0].inicio, "2026-11-19T19:30");
+  assert.ok(conflictos[0].reservaId);
+  assert.equal(conflictos[0].torneoId, undefined);
+
+  const otro = await crearTorneo(api, { pistas: ["pista-2"], franjas: ["2026-11-26T10:30"] });
+  const choque = await crear(api, { pistas: ["pista-2", "pista-3"], franjas: ["2026-11-26T10:30"] });
+  assert.equal(choque.status, 409);
+  assert.deepEqual(choque.cuerpo.error.conflictos, [{ pistaId: "pista-2", inicio: "2026-11-26T10:30", torneoId: otro.id }]);
+
+  assert.equal((await api.pedir("GET", "/api/torneos")).cuerpo.torneos.length, antes + 1, "solo se crea el torneo válido");
+});
+
+test("crear y consultar: el torneo nace en inscripción, con las franjas ordenadas", async () => {
+  const dia = diaNuevo();
+  const r = await crear(api, { franjas: [`${dia}T12:00`, `${dia}T10:30`] });
+  assert.equal(r.status, 201);
+  const t = r.cuerpo.torneo;
+  assert.equal(t.estado, "inscripcion");
+  assert.equal(t.campeona, null);
+  assert.deepEqual(t.inscripciones, []);
+  assert.deepEqual(t.partidos, []);
+  assert.deepEqual(t.franjas, [`${dia}T10:30`, `${dia}T12:00`]);
+  assert.equal(t.bloqueos, undefined, "los bloqueos son internos");
+  const consulta = await api.pedir("GET", `/api/torneos/${t.id}`);
+  assert.equal(consulta.status, 200);
+  assert.equal(consulta.cuerpo.torneo.id, t.id);
+  const noExiste = await api.pedir("GET", "/api/torneos/T-9999");
+  assert.equal(noExiste.status, 404);
+  assert.equal(noExiste.cuerpo.error.codigo, "TORNEO_NO_ENCONTRADO");
+  assert.equal((await api.pedir("POST", "/api/torneos/T-9999/cancelar", { socio: GESTOR })).cuerpo.error.codigo, "TORNEO_NO_ENCONTRADO");
+});
+
+test("listado: todos los torneos por fecha de su primera franja, con filtro de estado", async () => {
+  const tarde = await crearTorneo(api, { franjas: ["2026-12-02T19:30"] });
+  const temprano = await crearTorneo(api, { franjas: ["2026-12-01T09:00"] });
+  await api.pedir("POST", `/api/torneos/${tarde.id}/cancelar`, { socio: GESTOR });
+  const lista = (await api.pedir("GET", "/api/torneos")).cuerpo.torneos;
+  const ids = lista.map((t: any) => t.id);
+  assert.ok(ids.indexOf(temprano.id) < ids.indexOf(tarde.id));
+  const fila = lista.find((t: any) => t.id === tarde.id);
+  assert.deepEqual(Object.keys(fila).sort(), ["cuota", "estado", "id", "inscritas", "nombre", "plazas"]);
+  assert.equal(fila.estado, "cancelado");
+  assert.equal(fila.inscritas, 0);
+  const cancelados = (await api.pedir("GET", "/api/torneos?estado=cancelado")).cuerpo.torneos;
+  assert.ok(cancelados.every((t: any) => t.estado === "cancelado"));
+  assert.ok(cancelados.some((t: any) => t.id === tarde.id));
+  const malo = await api.pedir("GET", "/api/torneos?estado=raro");
+  assert.equal(malo.status, 400);
+  assert.equal(malo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+});
+
+test("franjas bloqueadas: se ven en la disponibilidad y no se pueden reservar", async () => {
+  const t = await crearTorneo(api, { pistas: ["pista-2"], franjas: ["2026-11-27T10:30"] });
+  const f = await franja(api, "2026-11-27", "pista-2", "2026-11-27T10:30");
