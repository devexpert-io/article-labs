+test("cuadro de 5 parejas: descansos en la primera ronda y cruces de las rondas siguientes", async () => {
+  await conApi(async (api) => {
+    const torneo = await crear(api, {
+      pistas: ["pista-1", "pista-2"],
+      franjas: [`${DIA}T09:00`, `${DIA}T10:30`, `${DIA}T12:00`, `${DIA}T13:30`],
+    });
+    const ids: string[] = [];
+    for (const pareja of PAREJAS_5) ids.push((await inscribirBien(api, torneo.id, pareja)).id);
+
+    const cerrado = (await api.pedir("POST", `/api/torneos/${torneo.id}/cerrar`, { socio: GESTOR })).cuerpo.torneo;
+    assert.equal(cerrado.estado, "en_juego");
+    assert.equal(cerrado.campeona, null);
+    assert.equal(cerrado.partidos.length, 7, "4 + 2 + 1 partidos");
+
+    const primera = cerrado.partidos.filter((p: any) => p.ronda === 1);
+    assert.equal(primera.length, 4);
+    // Con 5 parejas, T = 8: las parejas 1, 2 y 3 descansan y 4 juega contra 5.
+    for (let i = 0; i < 3; i++) {
+      assert.deepEqual(primera[i].parejas, [ids[i], null]);
+      assert.equal(primera[i].estado, "descanso");
+      assert.equal(primera[i].ganadora, ids[i]);
+      assert.equal(primera[i].pistaId, null, "los descansos no tienen pista");
+      assert.equal(primera[i].inicio, null, "los descansos no tienen hora");
+    }
+    assert.deepEqual(primera[3].parejas, [ids[3], ids[4]]);
+    assert.equal(primera[3].estado, "pendiente");
+    assert.equal(primera[3].ganadora, null);
+
+    const segunda = cerrado.partidos.filter((p: any) => p.ronda === 2);
+    assert.equal(segunda.length, 2);
+    assert.deepEqual(segunda[0].parejas, [ids[0], null], "la 1 espera a la ganadora de 4 contra 5");
+    assert.deepEqual(segunda[1].parejas, [ids[1], ids[2]]);
+
+    const final = cerrado.partidos.filter((p: any) => p.ronda === 3);
+    assert.equal(final.length, 1);
+    assert.deepEqual(final[0].parejas, [null, null]);
+  });
+});
