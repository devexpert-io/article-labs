+test("corregir un resultado: cambia la pareja que pasa mientras la siguiente ronda no se haya jugado", async () => {
+  await conApi(async (api) => {
+    const torneo = await crear(api, {
+      pistas: ["pista-1", "pista-2"],
+      franjas: [`${DIA}T09:00`, `${DIA}T10:30`, `${DIA}T12:00`, `${DIA}T13:30`],
+    });
+    const ids: string[] = [];
+    for (const pareja of PAREJAS_8) ids.push((await inscribirBien(api, torneo.id, pareja)).id);
+    const cerrado = (await api.pedir("POST", `/api/torneos/${torneo.id}/cerrar`, { socio: GESTOR })).cuerpo.torneo;
+    assert.equal(cerrado.partidos.length, 7);
+
+    // Se juegan los cuatro partidos de la primera ronda (gana la pareja local).
+    const horas = ["09:30", "09:30", "10:45", "10:45"];
+    for (let i = 0; i < 4; i++) {
+      assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: `${DIA}T${horas[i]}` } })).status, 200);
+      const p = partidoDe(cerrado, 1, i + 1);
+      const r = await api.pedir("POST", `/api/torneos/${torneo.id}/partidos/${p.id}/resultado`, {
+        cuerpo: { ganadora: ids[i], marcador: "6-0 6-0" },
+        socio: GESTOR,
+      });
+      assert.equal(r.status, 200, JSON.stringify(r.cuerpo));
+    }
+
+    // La semifinal 2 (ganadores de los partidos 2 y 3) ya tiene sus parejas.
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: `${DIA}T12:15` } })).status, 200);
+    const trasRonda1 = (await api.pedir("GET", `/api/torneos/${torneo.id}`)).cuerpo.torneo;
+    const semifinal2 = partidoDe(trasRonda1, 2, 2);
+    assert.deepEqual(semifinal2.parejas, [ids[1], ids[2]]);
+    assert.equal(semifinal2.inicio, `${DIA}T12:00`);
+    const semi = await api.pedir("POST", `/api/torneos/${torneo.id}/partidos/${semifinal2.id}/resultado`, {
+      cuerpo: { ganadora: ids[2] },
+      socio: GESTOR,
+    });
+    assert.equal(semi.status, 200);
+
+    // Corregir el partido 3 ya no se puede: su ganadora jugó la semifinal.
+    const tarde = await api.pedir("POST", `/api/torneos/${torneo.id}/partidos/${partidoDe(cerrado, 1, 3).id}/resultado`, {
+      cuerpo: { ganadora: ids[5] },
+      socio: GESTOR,
+    });
+    assert.equal(tarde.status, 409);
+    assert.equal(tarde.cuerpo.error.codigo, "RESULTADO_CERRADO");
+
+    // El partido 1 sí se puede corregir: su semifinal sigue pendiente.
+    const correccion = await api.pedir("POST", `/api/torneos/${torneo.id}/partidos/${partidoDe(cerrado, 1, 1).id}/resultado`, {
+      cuerpo: { ganadora: ids[7], marcador: "3-6 6-4 7-6" },
+      socio: GESTOR,
+    });
+    assert.equal(correccion.status, 200);
+    const detalle = (await api.pedir("GET", `/api/torneos/${torneo.id}`)).cuerpo.torneo;
+    assert.deepEqual(partidoDe(detalle, 2, 1).parejas[0], ids[7], "la plaza de la semifinal cambia de pareja");
+    assert.equal(partidoDe(detalle, 1, 1).ganadora, ids[7]);
+    assert.equal(partidoDe(detalle, 1, 1).marcador, "3-6 6-4 7-6");
+  });
+});
