+test("cancelar: libera las franjas también en juego, pero no cancela un torneo terminado", async () => {
+  await conApi(async (api) => {
+    const torneo = await crear(api, { pistas: ["pista-1"], franjas: [`${DIA}T09:00`, `${DIA}T10:30`] });
+    for (const pareja of PAREJAS_5.slice(0, 2)) await inscribirBien(api, torneo.id, pareja);
+    await api.pedir("POST", `/api/torneos/${torneo.id}/cerrar`, { socio: GESTOR });
+
+    const cancelado = await api.pedir("POST", `/api/torneos/${torneo.id}/cancelar`, { socio: GESTOR });
+    assert.equal(cancelado.status, 200);
+    assert.equal(cancelado.cuerpo.torneo.estado, "cancelado");
+    const dia = (await api.pedir("GET", `/api/disponibilidad?fecha=${DIA}&pista=pista-1`)).cuerpo;
+    assert.equal(dia.pistas[0].franjas.find((f: any) => f.inicio === `${DIA}T09:00`).estado, "libre");
+    assert.equal(
+      (await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: `${DIA}T09:00` } })).status,
+      201,
+    );
+    const otraVez = await api.pedir("POST", `/api/torneos/${torneo.id}/cancelar`, { socio: GESTOR });
+    assert.equal(otraVez.status, 409);
+    assert.equal(otraVez.cuerpo.error.codigo, "YA_CANCELADO");
+
+    // Un torneo terminado no se cancela.
+    const otro = await crear(api, { pistas: ["pista-1"], franjas: [`${DIA}T12:00`] });
+    const a = await inscribirBien(api, otro.id, ["socio-001", "socio-002"]);
+    await inscribirBien(api, otro.id, ["socio-003", "socio-004"]);
+    const cerrado = (await api.pedir("POST", `/api/torneos/${otro.id}/cerrar`, { socio: GESTOR })).cuerpo.torneo;
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: `${DIA}T12:30` } })).status, 200);
+    await api.pedir("POST", `/api/torneos/${otro.id}/partidos/${cerrado.partidos[0].id}/resultado`, {
+      cuerpo: { ganadora: a.id },
+      socio: GESTOR,
+    });
+    const terminado = await api.pedir("POST", `/api/torneos/${otro.id}/cancelar`, { socio: GESTOR });
+    assert.equal(terminado.status, 409);
+    assert.equal(terminado.cuerpo.error.codigo, "TORNEO_TERMINADO");
+  });
+});
