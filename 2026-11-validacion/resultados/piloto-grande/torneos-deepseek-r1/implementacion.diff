+test("campeona: al apuntar la final el torneo termina; con 2 parejas el único partido es la final", async () => {
+  await conApi(async (api) => {
+    const torneo = await crear(api, { pistas: ["pista-1"], franjas: [`${DIA}T09:00`] });
+    const primera = await inscribirBien(api, torneo.id, ["socio-001", "socio-002"]);
+    const segunda = await inscribirBien(api, torneo.id, ["socio-003", "socio-004"]);
+    const cerrado = (await api.pedir("POST", `/api/torneos/${torneo.id}/cerrar`, { socio: GESTOR })).cuerpo.torneo;
+    assert.equal(cerrado.partidos.length, 1);
+    assert.equal(cerrado.partidos[0].ronda, 1);
+    assert.equal(cerrado.partidos[0].estado, "pendiente");
+
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: `${DIA}T09:30` } })).status, 200);
+    const final = await api.pedir("POST", `/api/torneos/${torneo.id}/partidos/${cerrado.partidos[0].id}/resultado`, {
+      cuerpo: { ganadora: segunda.id, marcador: "7-5 7-5" },
+      socio: GESTOR,
+    });
+    assert.equal(final.status, 200);
+    const detalle = (await api.pedir("GET", `/api/torneos/${torneo.id}`)).cuerpo.torneo;
+    assert.equal(detalle.estado, "terminado");
+    assert.equal(detalle.campeona, segunda.id);
+    assert.notEqual(detalle.campeona, primera.id);
+
+    const fueraDeJuego = await api.pedir("POST", `/api/torneos/${torneo.id}/partidos/${cerrado.partidos[0].id}/resultado`, {
+      cuerpo: { ganadora: primera.id },
+      socio: GESTOR,
+    });
+    assert.equal(fueraDeJuego.status, 409);
+    assert.equal(fueraDeJuego.cuerpo.error.codigo, "TORNEO_NO_EN_JUEGO");
+  });
+});
