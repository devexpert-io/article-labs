+      socio: GESTOR,
+    });
+    assert.equal(jugado.status, 200);
+    assert.equal(jugado.cuerpo.partido.estado, "jugado");
+    assert.equal(jugado.cuerpo.partido.ganadora, ids[0]);
+    assert.equal(jugado.cuerpo.partido.marcador, "6-4 6-3");
+
+    // La ganadora ya ocupa su sitio en la final.
+    const trasPrimero = (await api.pedir("GET", `/api/torneos/${torneo.id}`)).cuerpo.torneo;
+    assert.equal(partidoDe(trasPrimero, 2, 1).parejas[0], ids[0]);
+    const noListo = await api.pedir("POST", `/api/torneos/${torneo.id}/partidos/${partidoDe(trasPrimero, 2, 1).id}/resultado`, {
