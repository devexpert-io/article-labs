@@ -0,0 +1,734 @@
+// La feature de torneos, probada a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const DIA = "2026-11-26";
+
+/** Cada test arranca su propia API para no arrastrar el estado de los demás. */
+async function conApi(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function datosTorneo(extra: Record<string, unknown> = {}) {
+  return {
+    nombre: "Torneo de prueba",
+    pistas: ["pista-1", "pista-2"],
+    franjas: [`${DIA}T09:00`, `${DIA}T10:30`, `${DIA}T12:00`, `${DIA}T13:30`],
+    plazas: 8,
+    cuota: 2500,
+    ...extra,
+  };
+}
+
+async function crear(api: Api, extra: Record<string, unknown> = {}): Promise<any> {
+  const r = await api.pedir("POST", "/api/torneos", { cuerpo: datosTorneo(extra), socio: GESTOR });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.torneo;
+}
+
+function inscribir(api: Api, torneoId: string, socios: [string, string], socio = GESTOR) {
+  return api.pedir("POST", `/api/torneos/${torneoId}/inscripciones`, { cuerpo: { socios }, socio });
+}
+
+async function inscribirBien(api: Api, torneoId: string, socios: [string, string]): Promise<any> {
+  const r = await inscribir(api, torneoId, socios);
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.inscripcion;
+}
+
+function partidoDe(torneo: any, ronda: number, numero: number): any {
+  const p = torneo.partidos.find((x: any) => x.ronda === ronda && x.numero === numero);
+  assert.ok(p, `falta el partido ${ronda}-${numero}`);
+  return p;
+}
+
+const PAREJAS_5: Array<[string, string]> = [
+  ["socio-001", "socio-002"],
+  ["socio-003", "socio-004"],
+  ["socio-005", "socio-006"],
+  ["socio-007", "socio-008"],
+  ["socio-009", "socio-010"],
+];
+
+const PAREJAS_8: Array<[string, string]> = [
+  ...PAREJAS_5,
+  ["socio-012", "socio-013"],
+  ["socio-014", "socio-015"],
+  ["socio-016", "socio-017"],
+];
+
+test("permisos: crear, cerrar, cancelar y resultados son de un gestor; inscribir, de la pareja o un gestor", async () => {
+  await conApi(async (api) => {
+    for (const [metodo, ruta] of [
+      ["POST", "/api/torneos"],
+      ["POST", "/api/torneos/T-0001/cerrar"],
+      ["POST", "/api/torneos/T-0001/cancelar"],
+      ["POST", "/api/torneos/T-0001/partidos/P-0001/resultado"],
+    ] as const) {
+      const sin = await api.pedir(metodo, ruta, { cuerpo: {} });
+      assert.equal(sin.status, 401, ruta);
+      assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO", ruta);
+      const socio = await api.pedir(metodo, ruta, { cuerpo: {}, socio: "socio-001" });
+      assert.equal(socio.status, 403, ruta);
+      assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO", ruta);
+    }
+
+    // Consultar no necesita identificarse.
+    assert.equal((await api.pedir("GET", "/api/torneos")).status, 200);
+    const torneo = await crear(api);
+    assert.equal((await api.pedir("GET", `/api/torneos/${torneo.id}`)).status, 200);
+
+    // Inscribir: los dos socios de la pareja o un gestor.
+    const ajeno = await inscribir(api, torneo.id, ["socio-001", "socio-002"], "socio-003");
+    assert.equal(ajeno.status, 403);
+    assert.equal(ajeno.cuerpo.error.codigo, "SIN_PERMISO");
+    const propio = await inscribir(api, torneo.id, ["socio-001", "socio-002"], "socio-001");
+    assert.equal(propio.status, 201);
+    const sinNada = await inscribir(api, torneo.id, ["socio-003", "socio-004"], "");
+    assert.equal(sinNada.status, 401);
+    // La baja también es de la pareja.
+    const bajaAjena = await api.pedir("POST", `/api/torneos/${torneo.id}/inscripciones/${propio.cuerpo.inscripcion.id}/baja`, {
+      socio: "socio-003",
+    });
+    assert.equal(bajaAjena.status, 403);
+  });
+});
+
+test("datos del torneo: se validan nombre, listas, plazas, cuota, pistas y franjas", async () => {
+  await conApi(async (api) => {
+    const casos: Array<[Record<string, unknown>, number, string]> = [
+      [{ nombre: "" }, 400, "DATOS_INVALIDOS"],
+      [{ nombre: "   " }, 400, "DATOS_INVALIDOS"],
+      [{ nombre: 3 }, 400, "DATOS_INVALIDOS"],
+      [{ pistas: [] }, 400, "DATOS_INVALIDOS"],
+      [{ pistas: ["pista-1", "pista-1"] }, 400, "DATOS_INVALIDOS"],
+      [{ pistas: [1] }, 400, "DATOS_INVALIDOS"],
+      [{ franjas: [] }, 400, "DATOS_INVALIDOS"],
+      [{ franjas: [`${DIA}T09:00`, `${DIA}T09:00`] }, 400, "DATOS_INVALIDOS"],
+      [{ plazas: 3 }, 400, "DATOS_INVALIDOS"],
+      [{ plazas: 17 }, 400, "DATOS_INVALIDOS"],
+      [{ plazas: 4.5 }, 400, "DATOS_INVALIDOS"],
+      [{ cuota: -1 }, 400, "DATOS_INVALIDOS"],
+      [{ cuota: 1.5 }, 400, "DATOS_INVALIDOS"],
+      [{ pistas: ["pista-999"] }, 404, "PISTA_NO_ENCONTRADA"],
+      [{ franjas: ["mañana"] }, 400, "FRANJA_INVALIDA"],
+      [{ franjas: [`${DIA}T09:15`] }, 400, "FRANJA_INVALIDA"],
+      [{ franjas: ["2026-11-18T09:00"] }, 409, "FRANJA_PASADA"],
+    ];
+    for (const [extra, http, codigo] of casos) {
+      const r = await api.pedir("POST", "/api/torneos", { cuerpo: datosTorneo(extra), socio: GESTOR });
+      assert.equal(r.status, http, JSON.stringify(extra));
+      assert.equal(r.cuerpo.error.codigo, codigo, JSON.stringify(extra));
+    }
+    assert.deepEqual((await api.pedir("GET", "/api/torneos")).cuerpo.torneos, [], "no se crea nada");
+    // Los límites válidos sí entran.
+    assert.equal((await api.pedir("POST", "/api/torneos", { cuerpo: datosTorneo({ plazas: 4, cuota: 0 }), socio: GESTOR })).status, 201);
+    assert.equal(
+      (await api.pedir("POST", "/api/torneos", {
+        cuerpo: datosTorneo({ plazas: 16, cuota: 1, franjas: ["2026-11-27T09:00"] }),
+        socio: GESTOR,
+      })).status,
+      201,
+    );
+  });
+});
+
+test("pistas libres: pista cerrada y franjas ocupadas por reservas o por otro torneo", async () => {
+  await conApi(async (api) => {
+    const cerrada = await api.pedir("POST", "/api/torneos", {
+      cuerpo: datosTorneo({ pistas: ["pista-4"] }),
+      socio: GESTOR,
+    });
+    assert.equal(cerrada.status, 409);
+    assert.equal(cerrada.cuerpo.error.codigo, "PISTA_CERRADA");
+
+    // Reserva confirmada de la semilla: jueves 19 a las 19:30 en la pista 1 (la 2 está libre).
+    const porReserva = await api.pedir("POST", "/api/torneos", {
+      cuerpo: datosTorneo({ pistas: ["pista-1", "pista-2"], franjas: ["2026-11-19T19:30", `${DIA}T09:00`] }),
+      socio: GESTOR,
+    });
+    assert.equal(porReserva.status, 409);
+    assert.equal(porReserva.cuerpo.error.codigo, "FRANJAS_OCUPADAS");
+    assert.deepEqual(
+      porReserva.cuerpo.error.conflictos.map((c: any) => [c.pistaId, c.inicio]),
+      [["pista-1", "2026-11-19T19:30"]],
