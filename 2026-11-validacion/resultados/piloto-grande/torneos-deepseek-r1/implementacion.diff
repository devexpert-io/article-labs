+/** Lista no vacía de textos sin repetir, o undefined si no lo es. */
+function listaDeTextos(valor: unknown): string[] | undefined {
+  if (!Array.isArray(valor) || valor.length === 0) return undefined;
+  if (!valor.every((v) => typeof v === "string")) return undefined;
+  const lista = valor as string[];
+  return new Set(lista).size === lista.length ? lista : undefined;
