+      const socios = datos.socios;
+      if (!Array.isArray(socios) || socios.length !== 2 || socios.some((s) => typeof s !== "string") || socios[0] === socios[1]) {
+        invalido("socios debe ser una lista con dos ids distintos");
+      }
+      const uno = socios[0] as string;
+      const dos = socios[1] as string;
+      if (yo.rol !== "gestor" && yo.id !== uno && yo.id !== dos) {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo los dos socios de la pareja o un gestor pueden inscribirla", 403);
+      }
+      if (!plazoDeInscripcionAbierto(t)) {
+        throw new ErrorDelClub("INSCRIPCION_CERRADA", "El plazo de inscripción está cerrado");
+      }
+      const pareja: Socio[] = [];
+      for (const id of [uno, dos]) {
+        const socio = estado.socios.find((s) => s.id === id);
+        if (!socio) throw new ErrorDelClub("SOCIO_NO_ENCONTRADO", `No existe el socio ${id}`, 404);
+        pareja.push(socio);
+      }
+      for (const socio of pareja) {
+        if (!socio.cuotaActiva) throw new ErrorDelClub("CUOTA_INACTIVA", `${socio.nombre} no tiene la cuota al día`);
+      }
+      if (t.inscripciones.some((i) => i.estado === "inscrita" && i.socios.some((s) => s === uno || s === dos))) {
+        throw new ErrorDelClub("YA_INSCRITO", "Alguno de los socios ya está inscrito en este torneo");
+      }
+      if (cuentaInscritas(t) >= t.plazas) {
+        throw new ErrorDelClub("TORNEO_COMPLETO", "El torneo ya tiene todas sus plazas ocupadas");
+      }
+      estado.contadores.inscripcion += 1;
+      const inscripcion: Inscripcion = {
+        id: `I-${String(estado.contadores.inscripcion).padStart(4, "0")}`,
+        socios: [uno, dos],
+        estado: "inscrita",
+        importe: t.cuota,
+      };
+      t.inscripciones.push(inscripcion);
+      return { inscripcion };
+    },
+
+    darDeBajaInscripcion(torneoId: string, inscripcionId: string, quien?: Socio) {
+      const yo = exigirIdentificado(quien);
+      const t = torneo(torneoId);
+      const inscripcion = t.inscripciones.find((i) => i.id === inscripcionId);
+      if (!inscripcion) {
+        throw new ErrorDelClub("INSCRIPCION_NO_ENCONTRADA", `No existe la inscripción ${inscripcionId} en este torneo`, 404);
+      }
+      if (yo.rol !== "gestor" && !inscripcion.socios.includes(yo.id)) {
+        throw new ErrorDelClub("SIN_PERMISO", "Solo los dos socios de la pareja o un gestor pueden darla de baja", 403);
+      }
+      if (!plazoDeInscripcionAbierto(t)) {
+        throw new ErrorDelClub("INSCRIPCION_CERRADA", "El plazo de inscripción está cerrado");
+      }
+      if (inscripcion.estado === "baja") throw new ErrorDelClub("YA_DE_BAJA", "La pareja ya estaba de baja");
+      inscripcion.estado = "baja";
+      return { inscripcion };
+    },
+
+    cerrarTorneo(id: string, quien?: Socio) {
+      exigirGestor(quien);
+      const t = torneo(id);
+      if (t.estado !== "inscripcion") {
+        throw new ErrorDelClub("TORNEO_NO_EN_INSCRIPCION", "Solo se puede cerrar un torneo en inscripción");
+      }
+      const parejas = t.inscripciones.filter((i) => i.estado === "inscrita");
+      if (parejas.length < 2) throw new ErrorDelClub("PAREJAS_INSUFICIENTES", "Hacen falta al menos dos parejas inscritas");
+      const partidos = generarCuadro(t, parejas);
+      t.partidos = partidos;
+      t.estado = "en_juego";
+      t.campeona = null;
+      return { torneo: t };
+    },
+
+    apuntarResultado(
+      torneoId: string,
+      partidoId: string,
+      datos: { ganadora?: unknown; marcador?: unknown },
+      quien?: Socio,
+    ) {
+      exigirGestor(quien);
+      const t = torneo(torneoId);
+      const partido = t.partidos.find((p) => p.id === partidoId);
+      if (!partido) {
+        throw new ErrorDelClub("PARTIDO_NO_ENCONTRADO", `No existe el partido ${partidoId} en este torneo`, 404);
+      }
+      if (t.estado !== "en_juego") throw new ErrorDelClub("TORNEO_NO_EN_JUEGO", "El torneo no está en juego");
+      if (partido.estado === "descanso" || partido.parejas[0] === null || partido.parejas[1] === null) {
+        throw new ErrorDelClub("PARTIDO_NO_LISTO", "Todavía no se sabe qué parejas juegan este partido");
+      }
+      if (partido.inicio === null || partido.inicio > estado.ahora) {
+        throw new ErrorDelClub("PARTIDO_NO_EMPEZADO", "El partido todavía no ha empezado");
+      }
+      const ganadora = datos.ganadora;
+      if (typeof ganadora !== "string" || (ganadora !== partido.parejas[0] && ganadora !== partido.parejas[1])) {
+        invalido("ganadora debe ser una de las dos parejas del partido");
+      }
+      if (datos.marcador !== undefined && datos.marcador !== null && typeof datos.marcador !== "string") {
+        invalido("marcador debe ser un texto");
+      }
+      const siguiente = partidoSiguiente(t, partido);
+      if (partido.estado === "jugado" && siguiente && siguiente.partido.estado === "jugado") {
+        throw new ErrorDelClub("RESULTADO_CERRADO", "El partido de la ronda siguiente ya se ha jugado: no se puede corregir");
+      }
+      partido.ganadora = ganadora;
+      partido.marcador = typeof datos.marcador === "string" ? datos.marcador : null;
+      partido.estado = "jugado";
+      if (siguiente) {
+        siguiente.partido.parejas[siguiente.lado] = ganadora;
+      } else {
+        t.estado = "terminado";
+        t.campeona = ganadora;
+      }
+      return { partido };
+    },
+
+    cancelarTorneo(id: string, quien?: Socio) {
+      exigirGestor(quien);
+      const t = torneo(id);
+      if (t.estado === "terminado") throw new ErrorDelClub("TORNEO_TERMINADO", "El torneo ya ha terminado");
+      if (t.estado === "cancelado") throw new ErrorDelClub("YA_CANCELADO", "El torneo ya estaba cancelado");
+      t.estado = "cancelado";
+      return { torneo: t };
+    },
   };
 }
 
