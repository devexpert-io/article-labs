+test("retirarse: queda retirada, los de detrás suben y solo puede su dueño o un gestor", () => conApi(async (api) => {
+  const a = (await apuntar(api, "socio-041", JUEVES)).cuerpo.espera;
+  const b = (await apuntar(api, "socio-002", JUEVES)).cuerpo.espera;
+  await apuntar(api, "socio-003", JUEVES);
+
+  const ajena = await api.pedir("DELETE", `/api/esperas/${a.id}`, { socio: "socio-002" });
+  assert.equal(ajena.status, 403);
+  assert.equal(ajena.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("DELETE", `/api/esperas/${a.id}`)).status, 401);
+  const noExiste = await api.pedir("DELETE", "/api/esperas/E-9999", { socio: "socio-041" });
