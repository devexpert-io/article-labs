+++ b/test/esperas.test.ts
@@ -0,0 +1,204 @@
+// La lista de espera de franjas, probada a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Franjas de la semilla: la pista 1 el jueves 19 a las 19:30 la tiene socio-007;
+// la del sábado 21 a las 16:30, socio-015. La pista 2 el jueves 19 a las 19:30 está libre.
+const JUEVES = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+const SABADO = { pistaId: "pista-1", inicio: "2026-11-21T16:30" };
+const SABADO_15 = { pistaId: "pista-1", inicio: "2026-11-21T15:00" };
+
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const apuntar = (api: Api, socio: string | undefined, cuerpo: unknown) => api.pedir("POST", "/api/esperas", { socio, cuerpo });
+
+test("apuntarse: 201 con la espera activa y su posición; sin X-Socio, 401", () => conApi(async (api) => {
+  const sin = await apuntar(api, undefined, JUEVES);
+  assert.equal(sin.status, 401);
+  assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const r = await apuntar(api, "socio-041", JUEVES);
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.espera.socioId, "socio-041");
+  assert.equal(r.cuerpo.espera.pistaId, "pista-1");
+  assert.equal(r.cuerpo.espera.inicio, "2026-11-19T19:30");
+  assert.equal(r.cuerpo.espera.estado, "activa");
+  assert.equal(r.cuerpo.espera.posicion, 1);
+  assert.match(r.cuerpo.espera.id, /^E-\d{4}$/);
+}));
+
+test("solo se esperan franjas ocupadas y válidas, con las comprobaciones de reservar", () => conApi(async (api) => {
+  const casos: [unknown, string, number, string?][] = [
+    [{ pistaId: "pista-2", inicio: "2026-11-19T19:30" }, "FRANJA_LIBRE", 409],
+    [{ pistaId: "pista-9", inicio: "2026-11-19T19:30" }, "PISTA_NO_ENCONTRADA", 404],
+    [{ pistaId: "pista-4", inicio: "2026-11-19T19:30" }, "PISTA_CERRADA", 409],
+    [{ pistaId: "pista-1", inicio: "2026-11-19T11:00" }, "FRANJA_INVALIDA", 400],
+    [{ pistaId: "pista-1", inicio: "2026-11-18T09:00" }, "FRANJA_PASADA", 409],
+    [JUEVES, "CUOTA_INACTIVA", 409, "socio-022"],
+    [{ pistaId: "pista-1" }, "DATOS_INVALIDOS", 400],
+  ];
+  for (const [cuerpo, codigo, http, socio] of casos) {
+    const r = await apuntar(api, socio ?? "socio-041", cuerpo);
+    assert.equal(r.status, http, codigo);
+    assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+}));
+
+test("sin duplicados, sin esperar lo que ya es tuyo y como mucho 2 esperas activas", () => conApi(async (api) => {
+  assert.equal((await apuntar(api, "socio-041", JUEVES)).status, 201);
+  const repetida = await apuntar(api, "socio-041", JUEVES);
+  assert.equal(repetida.status, 409);
+  assert.equal(repetida.cuerpo.error.codigo, "YA_EN_ESPERA");
+  const propia = await apuntar(api, "socio-007", JUEVES);
+  assert.equal(propia.status, 409);
+  assert.equal(propia.cuerpo.error.codigo, "YA_RESERVADA");
+  assert.equal((await apuntar(api, "socio-041", SABADO)).status, 201);
