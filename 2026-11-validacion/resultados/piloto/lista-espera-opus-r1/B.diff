+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.esperas.find((e: any) => e.id === primera.id).estado, "asignada");
+  assert.equal(estado.esperas.find((e: any) => e.id === segunda.id).estado, "activa");
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-002" })).cuerpo.esperas[0].posicion, 1);
+  assert.equal((await api.pedir("GET", "/api/esperas", { socio: "socio-041" })).cuerpo.esperas.length, 0);
+}));
