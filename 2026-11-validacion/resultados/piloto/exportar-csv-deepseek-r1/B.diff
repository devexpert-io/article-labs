@@ -0,0 +1,257 @@
+// La exportación de reservas a CSV, probada a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-002";
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+function exportar(consulta: string, socio?: string) {
+  return api.pedir("GET", `/api/reservas/exportar${consulta}`, socio === undefined ? {} : { socio });
+}
+
+async function leerEstado(): Promise<any> {
+  return (await api.pedir("GET", "/_estado")).cuerpo;
+}
+
+/** Parser mínimo del RFC 4180, para no trocear por CRLF campos que llevan saltos de línea. */
+function parsearCsv(texto: string): string[][] {
+  const filas: string[][] = [];
+  let fila: string[] = [];
+  let campo = "";
+  let entreComillas = false;
+  for (let i = 0; i < texto.length; i++) {
+    const c = texto[i]!;
+    if (entreComillas) {
+      if (c === '"') {
+        if (texto[i + 1] === '"') {
+          campo += '"';
+          i++;
+        } else {
+          entreComillas = false;
+        }
+      } else {
+        campo += c;
+      }
+    } else if (c === '"') {
+      entreComillas = true;
+    } else if (c === ",") {
+      fila.push(campo);
+      campo = "";
+    } else if (c === "\r" && texto[i + 1] === "\n") {
+      fila.push(campo);
+      campo = "";
+      filas.push(fila);
+      fila = [];
+      i++;
+    } else {
+      campo += c;
+    }
+  }
+  if (campo !== "" || fila.length > 0) {
+    fila.push(campo);
+    filas.push(fila);
+  }
+  return filas;
+}
+
+function compararInicio(a: any, b: any): number {
+  if (a.inicio !== b.inicio) return a.inicio < b.inicio ? -1 : 1;
+  if (a.pistaId !== b.pistaId) return a.pistaId < b.pistaId ? -1 : 1;
+  return 0;
+}
+
+/** Las filas que la exportación debe devolver según el estado del club, sin pasar por el CSV. */
+function filasEsperadas(e: any, desde: string, hasta: string, estado?: string): string[][] {
+  const pistas = new Map(e.pistas.map((p: any) => [p.id, p]));
+  const socios = new Map(e.socios.map((s: any) => [s.id, s]));
+  return e.reservas
+    .filter((r: any) =>
+      r.inicio.slice(0, 10) >= desde &&
+      r.inicio.slice(0, 10) <= hasta &&
+      (!estado || r.estado === estado))
+    .sort(compararInicio)
+    .map((r: any) => [
+      r.id,
+      r.inicio.slice(0, 10),
+      r.inicio.slice(11, 16),
+      (pistas.get(r.pistaId) as any).nombre,
+      (socios.get(r.socioId) as any).nombre,
+      (socios.get(r.socioId) as any).email,
+      r.estado,
+      (r.importe / 100).toFixed(2),
+      r.penalizacion === undefined ? "" : (r.penalizacion / 100).toFixed(2),
+      r.notas,
+    ]);
+}
+
+/** Un hueco libre futuro de una pista operativa, para crear reservas en las pruebas. */
+async function huecoLibre(): Promise<{ pistaId: string; inicio: string }> {
+  const e = await leerEstado();
+  for (const fecha of ["2026-11-22", "2026-11-23", "2026-11-24"]) {
+    for (const p of e.pistas.filter((pista: any) => pista.estado === "operativa")) {
+      for (const hora of ["09:00", "10:30", "12:00", "13:30", "15:00", "16:30", "18:00", "19:30", "21:00"]) {
+        const inicio = `${fecha}T${hora}`;
+        const ocupada = e.reservas.some((r: any) => r.pistaId === p.id && r.inicio === inicio && r.estado === "confirmada");
+        if (!ocupada) return { pistaId: p.id, inicio };
+      }
+    }
+  }
+  throw new Error("No hay huecos libres para la prueba");
+}
+
+test("permisos: sin X-Socio es 401 y con un socio normal es 403", async () => {
+  const sinIdentificar = await exportar("?desde=2026-11-19&hasta=2026-11-19");
+  assert.equal(sinIdentificar.status, 401);
+  assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const sinPermiso = await exportar("?desde=2026-11-19&hasta=2026-11-19", SOCIO);
+  assert.equal(sinPermiso.status, 403);
+  assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+  // El permiso se comprueba antes que los datos del periodo.
+  const sinPermisoNiPeriodo = await exportar("?estado=lo-que-sea", SOCIO);
+  assert.equal(sinPermisoNiPeriodo.status, 403);
+  assert.equal(sinPermisoNiPeriodo.cuerpo.error.codigo, "SIN_PERMISO");
+
+  assert.equal((await exportar("?desde=2026-11-19&hasta=2026-11-19", GESTOR)).status, 200);
+});
+
+test("respuesta: 200, texto CSV y nombre de fichero con el periodo", async () => {
+  const r = await exportar("?desde=2026-11-19&hasta=2026-11-21", GESTOR);
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-11-19-2026-11-21.csv"');
+  assert.equal(typeof r.cuerpo, "string", "el cuerpo no es JSON");
+});
+
+test("cabecera: la primera línea es la exacta, con las columnas en orden", async () => {
+  const { texto } = await exportar("?desde=2026-11-19&hasta=2026-11-19", GESTOR);
+  assert.equal(texto.split("\r\n")[0], CABECERA);
+  assert.deepEqual(parsearCsv(texto)[0], [
+    "id", "fecha", "hora", "pista", "socio", "email", "estado", "importe", "penalizacion", "notas",
+  ]);
+});
+
+test("filas: una por reserva del periodo, ordenadas por inicio y luego por pista", async () => {
+  const r = await exportar("?desde=2026-11-18&hasta=2026-11-24", GESTOR);
+  const filas = parsearCsv(r.texto).slice(1);
+  const estado = await leerEstado();
+  assert.deepEqual(filas, filasEsperadas(estado, "2026-11-18", "2026-11-24"));
+  assert.ok(filas.length > 0);
+
+  // El orden es por inicio y, a igual inicio, por id de pista (no por nombre).
+  const inicios = filas.map((f) => `${f[1]}T${f[2]}`);
+  assert.deepEqual(inicios, [...inicios].sort());
+  const mismoInicio = filas.filter((f) => `${f[1]}T${f[2]}` === "2026-11-21T15:00");
+  assert.ok(mismoInicio.length > 1);
+  assert.deepEqual(mismoInicio.map((f) => f[3]), [...mismoInicio.map((f) => f[3])].sort((a, b) => a.localeCompare(b)));
+});
+
+test("importes: euros con dos decimales y punto; penalización vacía si no la hay", async () => {
+  const cancelada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1200);
+
+  const { texto } = await exportar("?desde=2026-11-19&hasta=2026-11-19", GESTOR);
+  const filas = parsearCsv(texto);
+  const conPenalizacion = filas.find((f) => f[0] === "R-0520");
+  assert.ok(conPenalizacion);
+  assert.equal(conPenalizacion[6], "cancelada");
+  assert.equal(conPenalizacion[7], "12.00");
+  assert.equal(conPenalizacion[8], "12.00");
+
+  const sinPenalizacion = filas.find((f) => f[0] !== "R-0520" && f[6] === "confirmada");
+  assert.ok(sinPenalizacion);
+  assert.equal(sinPenalizacion[8], "");
+  assert.match(sinPenalizacion[7]!, /^\d+\.\d{2}$/);
+});
+
+test("escapado: comas, comillas y saltos de línea siguen el RFC 4180", async () => {
+  const { pistaId, inicio } = await huecoLibre();
+  const notas = 'Pista, "central"\nsegunda línea';
+  const creada = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio, notas },
+  });
+  assert.equal(creada.status, 201);
+  const id = creada.cuerpo.reserva.id;
+
+  const dia = inicio.slice(0, 10);
+  const { texto } = await exportar(`?desde=${dia}&hasta=${dia}`, GESTOR);
+  assert.ok(texto.includes('"Pista, ""central""\nsegunda línea"'));
+
+  const filas = parsearCsv(texto);
+  const fila = filas.find((f) => f[0] === id);
+  assert.ok(fila);
+  assert.equal(fila[9], notas, "el parser recupera las notas originales");
+  const estado = await leerEstado();
+  assert.deepEqual(filas.slice(1), filasEsperadas(estado, dia, dia));
+
+  // Un campo sin caracteres especiales no se entrecomilla.
+  assert.ok(texto.includes(",Pista 1,"));
+  const otroDia = await exportar("?desde=2026-11-19&hasta=2026-11-19", GESTOR);
+  assert.ok(otroDia.texto.includes(",Traen sus propias palas. Piden bolas nuevas.\r\n"));
+
+  // Una coma suelta en un campo sí obliga a entrecomillar.
+  assert.ok(texto.includes(`"Pista, ""central""`));
+});
+
+test("fin de línea: todas las líneas, también la última, terminan en CRLF", async () => {
+  const { texto } = await exportar("?desde=2026-11-19&hasta=2026-11-19", GESTOR);
+  assert.ok(texto.endsWith("\r\n"));
+  const filas = parsearCsv(texto);
+  assert.equal((texto.match(/\r\n/g) ?? []).length, filas.length);
+  assert.equal(texto.replaceAll("\r\n", "").includes("\n"), false, "no hay saltos de línea sueltos");
+});
+
+test("periodo: obligatorio, con formato, ordenado y de 92 días como mucho", async () => {
+  const casos = [
+    "?hasta=2026-11-19",
+    "?desde=2026-11-19",
+    "?desde=19%2F11%2F2026&hasta=2026-11-19",
+    "?desde=2026-11-20&hasta=2026-11-19",
+    "?desde=2026-02-31&hasta=2026-03-01",
+  ];
+  for (const consulta of casos) {
+    const r = await exportar(consulta, GESTOR);
+    assert.equal(r.status, 400, consulta);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", consulta);
+  }
+
+  // 92 días contando los dos extremos: 2026-09-01 a 2026-12-01.
+  const justo = await exportar("?desde=2026-09-01&hasta=2026-12-01", GESTOR);
