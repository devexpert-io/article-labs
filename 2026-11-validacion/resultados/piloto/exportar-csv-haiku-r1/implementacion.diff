+++ b/test/exportar-csv.test.ts
@@ -0,0 +1,192 @@
+// Exportación de reservas a CSV, probada a través de la API (docs/specs/exportar-csv.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO_NORMAL = "socio-001";
+// Socio sin reservas en la semilla: sirve para crear reservas con notas especiales.
+const SOCIO_SIN_RESERVAS = "socio-041";
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+type Reserva = { id: string; socioId: string; pistaId: string; inicio: string; estado: string; importe: number; penalizacion?: number; notas: string };
+type Estado = { pistas: { id: string; nombre: string }[]; socios: { id: string; nombre: string; email: string }[]; reservas: Reserva[] };
+
+const estadoDelClub = async (): Promise<Estado> => (await api.pedir("GET", "/_estado")).cuerpo;
+/** Sin `socio` llama como gestor; con `null`, sin cabecera X-Socio. */
+const exportar = (query: string, socio: string | null = GESTOR) => api.pedir("GET", `/api/reservas/exportar?${query}`, { socio: socio ?? undefined });
+const euros = (centimos: number) => (centimos / 100).toFixed(2);
+/** Las líneas del CSV, sin la última cadena vacía que deja el CRLF final. Sirve mientras ninguna nota tenga saltos de línea. */
+const lineasDe = (texto: string) => texto.split("\r\n").slice(0, -1);
+const diaDe = (inicio: string) => inicio.slice(0, 10);
+
+/** La fila que debe salir para una reserva, calculada a partir del estado del club. */
+function filaEsperada(r: Reserva, estado: Estado): string {
+  const pista = estado.pistas.find((p) => p.id === r.pistaId)!;
+  const socio = estado.socios.find((s) => s.id === r.socioId)!;
+  return [
+    r.id, diaDe(r.inicio), r.inicio.slice(11), pista.nombre, socio.nombre, socio.email, r.estado,
+    euros(r.importe), r.penalizacion === undefined ? "" : euros(r.penalizacion), r.notas,
+  ].join(",");
+}
+
+/** Las filas esperadas de un periodo: por inicio y, si empiezan a la vez, por id de pista. */
+function filasEsperadas(estado: Estado, desde: string, hasta: string, estadoFiltro?: string): string[] {
+  return estado.reservas
+    .filter((r) => diaDe(r.inicio) >= desde && diaDe(r.inicio) <= hasta && (!estadoFiltro || r.estado === estadoFiltro))
+    .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.pistaId.localeCompare(b.pistaId))
+    .map((r) => filaEsperada(r, estado));
+}
+
+test("solo exporta un gestor: sin X-Socio, 401; con un socio que no lo es, 403", async () => {
+  const anonimo = await exportar("desde=2026-11-18&hasta=2026-11-24", null);
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const desconocido = await exportar("desde=2026-11-18&hasta=2026-11-24", "socio-999");
+  assert.equal(desconocido.status, 401);
+  assert.equal(desconocido.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const socio = await exportar("desde=2026-11-18&hasta=2026-11-24", SOCIO_NORMAL);
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+  assert.equal((await exportar("desde=2026-11-18&hasta=2026-11-24", GESTOR)).status, 200);
+});
+
+test("responde 200 con text/csv y el nombre del fichero con el periodo", async () => {
+  const r = await exportar("desde=2026-11-18&hasta=2026-11-24");
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-11-18-2026-11-24.csv"');
+  assert.ok(r.texto.startsWith(CABECERA + "\r\n"), "el cuerpo es CSV, no JSON");
+});
+
+test("la primera línea es la cabecera exacta", async () => {
+  const r = await exportar("desde=2026-11-18&hasta=2026-11-24");
+  assert.equal(lineasDe(r.texto)[0], CABECERA);
+});
+
+test("una fila por reserva que empieza en el periodo, ambos días incluidos", async () => {
+  const estado = await estadoDelClub();
+  const r = await exportar("desde=2026-11-18&hasta=2026-11-19");
+  const filas = lineasDe(r.texto).slice(1);
+  assert.deepEqual(filas, filasEsperadas(estado, "2026-11-18", "2026-11-19"));
+  assert.ok(filas.some((f) => f.includes(",2026-11-19,09:00,Pista 3,")), "el jueves 19 a las 09:00 está");
+  assert.ok(filas.some((f) => f.includes(",2026-11-18,")), "el día 18 entra");
+  assert.ok(filas.every((f) => ["2026-11-18", "2026-11-19"].includes(f.split(",")[1]!)), "no sale nada fuera del periodo");
+});
+
+test("las filas van por inicio y, si empiezan a la vez, por id de pista", async () => {
+  const estado = await estadoDelClub();
+  const r = await exportar("desde=2026-11-21&hasta=2026-11-21");
+  const filas = lineasDe(r.texto).slice(1);
+  assert.deepEqual(filas, filasEsperadas(estado, "2026-11-21", "2026-11-21"));
+  const quince = filas.filter((f) => f.includes(",15:00,")).map((f) => f.split(",")[3]);
+  // La semilla tiene dos reservas a las 15:00 del sábado 21 (pistas 1 y 2): empatan en la hora y se ordenan por pista.
+  assert.deepEqual(quince, ["Pista 1", "Pista 2"], "a la misma hora, por pista");
+});
+
+test("importes en euros con dos decimales, y la penalización vacía si no la hay", async () => {
+  const estado = await estadoDelClub();
+  const r = await exportar("desde=2026-11-19&hasta=2026-11-19");
+  const lineas = lineasDe(r.texto);
+  const marta = estado.reservas.find((x) => x.socioId === "socio-002" && x.inicio === "2026-11-19T09:00")!;
+  // Pista 3 en valle (1200 céntimos) y sin penalización: el campo va vacío.
+  assert.equal(lineas.find((l) => l.includes(",Marta López,")), `${marta.id},2026-11-19,09:00,Pista 3,Marta López,marta.lopez@example.com,confirmada,12.00,,`);
+  // Pista 1 en punta a partir de las 18:00 (2800 céntimos).
+  assert.ok(lineas.some((l) => l.includes(",2026-11-19,19:30,Pista 1,") && l.includes(",confirmada,28.00,,")));
+});
+
+test("una reserva cancelada con penalización la muestra en euros", async () => {
+  const cancelada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200, "R-0520 se cancela con penalización");
+  const reserva = cancelada.cuerpo.reserva as Reserva;
+  const dia = diaDe(reserva.inicio);
+  const r = await exportar(`desde=${dia}&hasta=${dia}`);
+  const linea = lineasDe(r.texto).find((l) => l.startsWith("R-0520,"))!;
+  const campos = linea.split(",");
+  assert.equal(campos[6], "cancelada");
+  assert.equal(campos[7], euros(reserva.importe));
+  assert.equal(campos[8], euros(reserva.penalizacion!));
+});
+
+test("escapa las notas con comas, comillas y saltos de línea según RFC 4180", async () => {
+  const notas = 'Dos, "tres" y\nuna línea';
+  const creada = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: SOCIO_SIN_RESERVAS, pistaId: "pista-3", inicio: "2026-11-25T10:30", notas },
+  });
+  assert.equal(creada.status, 201);
+  const otra = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: SOCIO_SIN_RESERVAS, pistaId: "pista-1", inicio: "2026-11-25T12:00", notas: 'Dice "hola"' },
+  });
+  assert.equal(otra.status, 201);
+
+  const r = await exportar("desde=2026-11-25&hasta=2026-11-25");
+  const id = creada.cuerpo.reserva.id;
+  // El salto de línea va dentro del campo entre comillas, sin tocar: la línea sigue a continuación.
+  assert.ok(r.texto.includes(`${id},2026-11-25,10:30,Pista 3,Nora Benítez,nora.benitez@example.com,confirmada,12.00,,"Dos, ""tres"" y\nuna línea"\r\n`));
+  assert.ok(r.texto.includes(`,18.00,,"Dice ""hola"""\r\n`));
+  // Los campos sin caracteres especiales no llevan comillas.
+  assert.ok(r.texto.includes(`,2026-11-25,10:30,Pista 3,Nora Benítez,`));
+});
+
+test("cada línea, también la cabecera y la última, termina en CRLF", async () => {
+  const r = await exportar("desde=2026-11-19&hasta=2026-11-20");
+  assert.ok(r.texto.endsWith("\r\n"));
+  const sinCrlf = r.texto.replace(/\r\n/g, "");
+  assert.doesNotMatch(sinCrlf, /\n/, "no hay saltos de línea sueltos");
+  assert.doesNotMatch(sinCrlf, /\r/, "no hay retornos de carro sueltos");
+});
+
+test("periodo: desde y hasta son obligatorios, con formato AAAA-MM-DD y en orden", async () => {
+  const casos = [
+    "hasta=2026-11-24",
+    "desde=2026-11-18",
+    "desde=2026-11-1&hasta=2026-11-24",
+    "desde=18-11-2026&hasta=2026-11-24",
+    "desde=2026-02-30&hasta=2026-03-02",
+    "desde=2026-11-24&hasta=2026-11-18",
+  ];
+  for (const query of casos) {
+    const r = await exportar(query);
+    assert.equal(r.status, 400, query);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", query);
+  }
+});
+
+test("periodo: como mucho 92 días contando los dos extremos", async () => {
+  // Del 1 de agosto al 31 de octubre son 92 días.
+  assert.equal((await exportar("desde=2026-08-01&hasta=2026-10-31")).status, 200);
+  const demasiado = await exportar("desde=2026-08-01&hasta=2026-11-01");
+  assert.equal(demasiado.status, 400);
+  assert.equal(demasiado.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+});
+
+test("filtro por estado: solo las de ese estado; otro valor, 400", async () => {
+  const estado = await estadoDelClub();
+  for (const valor of ["confirmada", "cancelada", "no_presentada"]) {
+    const r = await exportar(`desde=2026-10-01&hasta=2026-11-24&estado=${valor}`);
+    assert.equal(r.status, 200);
