diff --git a/test/exportar-csv.test.ts b/test/exportar-csv.test.ts
new file mode 100644
index 0000000..751a3e8
--- /dev/null
+++ b/test/exportar-csv.test.ts
@@ -0,0 +1,157 @@
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado } from "../src/tipos.ts";
+
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas\r\n";
+const GESTOR = { socio: "socio-040" };
+const RUTA = "/api/reservas/exportar";
+let api: Api;
+before(async () => { api = await arrancarApi(); });
+after(() => api.cerrar());
+
+test("exportar exige identificarse como gestor, incluso sin parámetros", async () => {
+  for (const [socio, status, codigo] of [
+    [undefined, 401, "NO_IDENTIFICADO"],
+    ["socio-999", 401, "NO_IDENTIFICADO"],
+    ["socio-041", 403, "SIN_PERMISO"],
+  ] as const) {
+    const r = await api.pedir("GET", RUTA, { socio });
+    assert.equal(r.status, status);
+    assert.equal(r.cuerpo.error.codigo, codigo);
+    assert.equal(r.cabeceras.get("content-type"), "application/json; charset=utf-8");
+  }
+});
+
+test("exporta todo el periodo inclusivo, con nombres, importes y orden, sin límite de 100", async () => {
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const r = await api.pedir("GET", `${RUTA}?desde=2026-10-01&hasta=2026-10-31`, GESTOR);
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-10-31.csv"');
+  assert.ok(r.texto.startsWith(CABECERA));
+  assert.ok(r.texto.endsWith("\r\n"));
+  assert.doesNotMatch(r.texto.replaceAll("\r\n", ""), /[\r\n]/);
+  const filas = r.texto.slice(CABECERA.length, -2).split("\r\n").map((linea) => linea.split(","));
+  assert.equal(filas.length, 315);
+  assert.deepEqual(new Set(filas.map((f) => f[6])), new Set(["confirmada", "cancelada", "no_presentada"]));
+  assert.equal(filas[0]![1], "2026-10-01");
+  assert.equal(filas.at(-1)![1], "2026-10-31");
+  const idsEsperados = estado.reservas.filter((r) => r.inicio >= "2026-10-01" && r.inicio < "2026-11-01").map((r) => r.id);
+  assert.deepEqual(new Set(filas.map((f) => f[0])), new Set(idsEsperados));
+  let anterior = "";
+  for (const fila of filas) {
+    const reserva = estado.reservas.find((r) => r.id === fila[0])!;
+    const socio = estado.socios.find((s) => s.id === reserva.socioId)!;
+    const pista = estado.pistas.find((p) => p.id === reserva.pistaId)!;
+    assert.deepEqual(fila, [reserva.id, reserva.inicio.slice(0, 10), reserva.inicio.slice(11), pista.nombre,
+      socio.nombre, socio.email, reserva.estado, reserva.importe === 1800 ? "18.00" : `${reserva.importe / 100}.00`, "", reserva.notas]);
+    const orden = `${fila[1]}T${fila[2]}|${pista.id}`;
+    assert.ok(orden >= anterior);
+    anterior = orden;
+  }
+});
+
+test("el filtro admite cada estado y solo devuelve las reservas correspondientes", async () => {
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  for (const filtro of ["confirmada", "cancelada", "no_presentada"]) {
+    const r = await api.pedir("GET", `${RUTA}?desde=2026-10-01&hasta=2026-10-31&estado=${filtro}`, GESTOR);
+    assert.equal(r.status, 200);
+    const filas = r.texto.slice(CABECERA.length, -2).split("\r\n").map((f) => f.split(","));
+    const esperadas = estado.reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado === filtro);
+    assert.ok(esperadas.length > 0);
+    assert.deepEqual(filas.map((f) => f[0]), esperadas.map((r) => r.id));
+    assert.ok(filas.every((f) => f[6] === filtro));
+  }
+});
+
+test("valida fechas obligatorias, orden y estado", async () => {
+  for (const parametros of [
+    "", "desde=2026-10-01", "hasta=2026-10-31", "desde=&hasta=2026-10-31",
+    "desde=2026-1-01&hasta=2026-10-31", "desde=2026-10-01T00:00&hasta=2026-10-31",
+    "desde=2026-02-30&hasta=2026-03-01", "desde=2026-13-01&hasta=2026-13-02",
+    "desde=2026-10-02&hasta=2026-10-01", "desde=2026-10-01&hasta=no-fecha",
+    "desde=2026-10-01&hasta=2026-10-31&estado=pendiente",
+    "desde=2026-10-01&hasta=2026-10-31&estado=",
+  ]) {
+    const r = await api.pedir("GET", `${RUTA}?${parametros}`, GESTOR);
+    assert.equal(r.status, 400, parametros);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", parametros);
+  }
+});
+
+test("el límite es de 92 días inclusivos, también al cruzar años, febrero y cambios de hora", async () => {
+  for (const [desde, hasta, status] of [
+    ["2026-10-01", "2026-12-31", 200], ["2026-10-01", "2027-01-01", 400],
+    ["2026-12-01", "2027-03-02", 200], ["2026-12-01", "2027-03-03", 400],
+    ["2028-02-01", "2028-05-02", 200], ["2028-02-01", "2028-05-03", 400],
+  ] as const) {
+    const r = await api.pedir("GET", `${RUTA}?desde=${desde}&hasta=${hasta}`, GESTOR);
+    assert.equal(r.status, status, `${desde} a ${hasta}`);
+    if (status === 400) assert.equal(r.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+  }
+});
+
+test("un periodo sin reservas devuelve solo la cabecera, terminada en CRLF", async () => {
+  const r = await api.pedir("GET", `${RUTA}?desde=2027-01-01&hasta=2027-01-01`, GESTOR);
+  assert.equal(r.status, 200);
+  assert.equal(r.texto, CABECERA);
+});
+
+test("escapa notas según RFC 4180 y ordena las reservas nuevas junto al historial", async () => {
+  const otra = await arrancarApi();
+  try {
+    const notas = ["Sin caracteres especiales", "Coma, aquí", 'Dice "hola"', "Primera\nsegunda", "Primera\r\nsegunda", "Solo\rretorno"];
+    const escapadas = ["Sin caracteres especiales", '"Coma, aquí"', '"Dice ""hola"""', '"Primera\nsegunda"', '"Primera\r\nsegunda"', '"Solo\rretorno"'];
+    const ids: string[] = [];
+    for (let i = 0; i < notas.length; i++) {
+      const creada = await otra.pedir("POST", "/api/reservas", { cuerpo: {
+        socioId: "socio-041", pistaId: i % 2 === 0 ? "pista-2" : "pista-1",
+        inicio: `2026-11-${25 + i}T12:00`, notas: notas[i],
+      } });
+      assert.equal(creada.status, 201);
+      ids.push(creada.cuerpo.reserva.id);
+      // Cancela gratis para no alcanzar el límite de reservas futuras.
+      assert.equal((await otra.pedir("POST", `/api/reservas/${ids[i]}/cancelar`)).status, 200);
+    }
+    const r = await otra.pedir("GET", `${RUTA}?desde=2026-11-25&hasta=2026-11-30`, GESTOR);
+    assert.equal(r.texto, CABECERA + ids.map((id, i) =>
+      `${id},2026-11-${25 + i},12:00,Pista ${i % 2 === 0 ? 2 : 1},Nora Benítez,nora.benitez@example.com,cancelada,${i === 3 || i === 4 ? "28.00" : "18.00"},,${escapadas[i]}\r\n`).join(""));
+
+    const creada = await otra.pedir("POST", "/api/reservas", { cuerpo: {
+      socioId: "socio-041", pistaId: "pista-2", inicio: "2026-11-19T19:30",
+    } });
+    assert.equal(creada.status, 201);
+    const listadoAntes = await otra.pedir("GET", "/api/reservas?fecha=2026-11-19&limite=100");
+    const csv = await otra.pedir("GET", `${RUTA}?desde=2026-11-19&hasta=2026-11-19`, GESTOR);
+    const filas = csv.texto.trimEnd().split("\r\n").slice(1).map((f) => f.split(","));
+    const simultaneas = filas.filter((f) => f[2] === "19:30");
+    assert.deepEqual(simultaneas.map((f) => f[3]), ["Pista 1", "Pista 2"]);
+    assert.equal(simultaneas[1]![0], creada.cuerpo.reserva.id);
+    const listadoDespues = await otra.pedir("GET", "/api/reservas?fecha=2026-11-19&limite=100");
+    assert.deepEqual(listadoDespues.cuerpo, listadoAntes.cuerpo);
+  } finally { otra.cerrar(); }
+});
+
+test("exporta la penalización de una cancelación fuera de plazo en euros", async () => {
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const reserva = estado.reservas.find((r) => r.socioId === "socio-002" && r.inicio === "2026-11-19T09:00")!;
+  const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  const r = await api.pedir("GET", `${RUTA}?desde=2026-11-19&hasta=2026-11-19&estado=cancelada`, GESTOR);
+  assert.equal(r.texto, CABECERA + `${reserva.id},2026-11-19,09:00,Pista 3,Marta López,marta.lopez@example.com,cancelada,12.00,12.00,\r\n`);
+});
+
+test("el listado JSON mantiene filtros, paginación y contenido", async () => {
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const todas = estado.reservas.filter((r) => r.inicio.startsWith("2026-10"));
+  const defecto = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31");
+  assert.equal(defecto.status, 200);
+  assert.equal(defecto.cabeceras.get("content-type"), "application/json; charset=utf-8");
+  assert.deepEqual(defecto.cuerpo, { total: 315, pagina: 1, paginas: 7, reservas: todas.slice(0, 50) });
+  const segunda = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=100&pagina=2");
+  assert.deepEqual(segunda.cuerpo, { total: 315, pagina: 2, paginas: 4, reservas: todas.slice(100, 200) });
+  const filtradas = todas.filter((r) => r.socioId === "socio-002" && r.pistaId === "pista-1" && r.estado === "confirmada");
+  const filtrado = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&socio=socio-002&pista=pista-1&estado=confirmada");
+  assert.deepEqual(filtrado.cuerpo, { total: filtradas.length, pagina: 1, paginas: 1, reservas: filtradas });
+});
