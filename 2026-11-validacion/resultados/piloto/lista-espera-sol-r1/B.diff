+test("la asignación descarta cuotas que han dejado de estar al día y devuelve null si nadie puede", () => {
+  // No hay un endpoint para cambiar la cuota; se cambia el estado en esta prueba del núcleo.
+  const estado = crearSemilla();
+  const club = crearClub(estado);
+  const nora = estado.socios.find((s) => s.id === "socio-041")!;
+  const irene = estado.socios.find((s) => s.id === "socio-004")!;
+  club.crearEspera(nora, franja);
+  club.crearEspera(irene, franja);
+  nora.cuotaActiva = false;
+  const original = estado.reservas.find((r) => r.pistaId === franja.pistaId && r.inicio === franja.inicio && r.estado === "confirmada")!;
+  const resultado = club.cancelarReserva(original.id, {});
+  assert.equal(estado.esperas[0].estado, "descartada");
+  assert.equal(estado.reservas.find((r) => r.id === resultado.asignadaA)!.socioId, irene.id);
+  nora.cuotaActiva = true;
+  club.crearEspera(nora, franja);
+  nora.cuotaActiva = false;
+  assert.equal(club.cancelarReserva(resultado.asignadaA!, {}).asignadaA, null);
+  assert.equal(estado.esperas[2].estado, "descartada");
+});
