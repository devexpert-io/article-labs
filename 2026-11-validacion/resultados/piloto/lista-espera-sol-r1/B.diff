+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+const franja = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+const otra = { pistaId: "pista-1", inicio: "2026-11-23T18:00" };
+const tercera = { pistaId: "pista-2", inicio: "2026-11-20T18:00" };
+const apuntar = (api: Api, socio = "socio-041", cuerpo = franja) => api.pedir("POST", "/api/esperas", { socio, cuerpo });
+async function error(respuesta: ReturnType<Api["pedir"]>, status: number, codigo: string) {
+  const r = await respuesta;
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+async function reservaDe(api: Api, cuerpo = franja) {
+  const r = await api.pedir("GET", `/api/reservas?fecha=${cuerpo.inicio.slice(0, 10)}&pista=${cuerpo.pistaId}&estado=confirmada`);
+  return r.cuerpo.reservas.find((r: any) => r.inicio === cuerpo.inicio);
+}
+
+test("esperas: identidad, validaciones, duplicados y límite", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const [metodo, ruta] of [["POST", "/api/esperas"], ["GET", "/api/esperas"], ["DELETE", "/api/esperas/E-0001"]]) {
+    await error(api.pedir(metodo!, ruta!), 401, "NO_IDENTIFICADO");
+  }
+  await error(apuntar(api, "socio-999"), 401, "NO_IDENTIFICADO");
+  await error(apuntar(api, "socio-041", { ...franja, pistaId: "inexistente" }), 404, "PISTA_NO_ENCONTRADA");
+  await error(apuntar(api, "socio-041", { ...franja, pistaId: "pista-4" }), 409, "PISTA_CERRADA");
+  await error(apuntar(api, "socio-041", { ...franja, inicio: "2026-11-19T19:00" }), 400, "FRANJA_INVALIDA");
+  await error(apuntar(api, "socio-041", { ...franja, inicio: "2026-11-18T09:00" }), 409, "FRANJA_PASADA");
+  await error(apuntar(api, "socio-041", { ...franja, pistaId: "pista-2" }), 409, "FRANJA_LIBRE");
+  await error(apuntar(api, "socio-011"), 409, "CUOTA_INACTIVA");
+  await error(apuntar(api, "socio-007"), 409, "YA_RESERVADA");
+  await error(api.pedir("POST", "/api/esperas", { socio: "socio-041", cuerpo: {} }), 400, "DATOS_INVALIDOS");
+  const primera = await apuntar(api);
+  assert.equal(primera.status, 201);
+  assert.deepEqual(primera.cuerpo.espera, { id: "E-0001", socioId: "socio-041", ...franja, estado: "activa", posicion: 1 });
+  await error(apuntar(api), 409, "YA_EN_ESPERA");
+  assert.equal((await apuntar(api, "socio-041", otra)).status, 201);
+  await error(apuntar(api, "socio-041", tercera), 409, "LIMITE_DE_ESPERAS");
+});
+
+test("esperas: posiciones, consulta privada, retirada por dueño y gestor", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const a = (await apuntar(api)).cuerpo.espera;
+  const b = (await apuntar(api, "socio-004")).cuerpo.espera;
+  assert.equal(b.posicion, 2);
+  await error(api.pedir("GET", "/api/esperas?socio=socio-041", { socio: "socio-004" }), 403, "SIN_PERMISO");
+  const consulta = await api.pedir("GET", "/api/esperas?socio=socio-004", { socio: "socio-040" });
+  assert.deepEqual(consulta.cuerpo.esperas, [b]);
+  await error(api.pedir("DELETE", `/api/esperas/${a.id}`, { socio: "socio-004" }), 403, "SIN_PERMISO");
+  await error(api.pedir("DELETE", "/api/esperas/desconocida", { socio: "socio-041" }), 404, "ESPERA_NO_ENCONTRADA");
+  const retirada = await api.pedir("DELETE", `/api/esperas/${a.id}`, { socio: "socio-041" });
+  assert.equal(retirada.status, 200);
+  assert.equal(retirada.cuerpo.espera.estado, "retirada");
+  assert.equal(retirada.cuerpo.espera.posicion, undefined);
+  const lista = await api.pedir("GET", "/api/esperas", { socio: "socio-004" });
+  assert.equal(lista.cuerpo.esperas[0].posicion, 1);
