+    await apuntar(api, "socio-041");
+    await apuntar(api, "socio-004");
+    for (const franja of [
+      { pistaId: "pista-3", inicio: "2026-11-21T15:00" },
+      { pistaId: "pista-2", inicio: "2026-11-21T16:30" },
+      { pistaId: "pista-3", inicio: "2026-11-21T16:30" },
