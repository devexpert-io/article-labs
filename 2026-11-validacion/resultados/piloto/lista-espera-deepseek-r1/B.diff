index 0000000..d72bd02
--- /dev/null
+++ b/test/lista-espera.test.ts
@@ -0,0 +1,242 @@
+// La lista de espera de franjas, probada a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const FRANJA = { pistaId: "pista-1", inicio: "2026-11-19T19:30" };
+
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function estado(api: Api) {
+  return (await api.pedir("GET", "/_estado")).cuerpo;
+}
+
+/** La reserva confirmada de una franja (la que ocupa la pista). */
+async function reservaDeLaFranja(api: Api, pistaId: string, inicio: string) {
+  const { reservas } = await estado(api);
+  return reservas.find((r: any) => r.pistaId === pistaId && r.inicio === inicio && r.estado === "confirmada");
+}
+
+async function apuntar(api: Api, socio: string, datos = FRANJA) {
+  return api.pedir("POST", "/api/esperas", { cuerpo: datos, socio });
+}
+
+test("apuntarse: 201 con la espera activa y su posición; sin X-Socio, 401", async () => {
+  await conApi(async (api) => {
+    const sinIdentidad = await api.pedir("POST", "/api/esperas", { cuerpo: FRANJA });
+    assert.equal(sinIdentidad.status, 401);
+    assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const primera = await apuntar(api, "socio-041");
+    assert.equal(primera.status, 201);
+    assert.equal(primera.cuerpo.espera.estado, "activa");
+    assert.equal(primera.cuerpo.espera.posicion, 1);
+    assert.equal(primera.cuerpo.espera.socioId, "socio-041");
+    assert.equal(primera.cuerpo.espera.pistaId, "pista-1");
+    assert.equal(primera.cuerpo.espera.inicio, "2026-11-19T19:30");
+
+    const segunda = await apuntar(api, "socio-004");
+    assert.equal(segunda.status, 201);
+    assert.equal(segunda.cuerpo.espera.posicion, 2);
+
+    const lista = await api.pedir("GET", "/api/esperas", { socio: "socio-004" });
+    assert.equal(lista.status, 200);
+    assert.deepEqual(lista.cuerpo.esperas.map((e: any) => [e.id, e.posicion]), [[segunda.cuerpo.espera.id, 2]]);
+
+    const sinIdentidadGet = await api.pedir("GET", "/api/esperas");
+    assert.equal(sinIdentidadGet.status, 401);
+    assert.equal(sinIdentidadGet.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  });
+});
+
+test("solo se esperan franjas ocupadas y con las mismas comprobaciones que al reservar", async () => {
+  await conApi(async (api) => {
+    const casos: Array<[string, Promise<{ status: number; cuerpo: any }>, number, string]> = [
+      ["franja libre", apuntar(api, "socio-041", { pistaId: "pista-2", inicio: "2026-11-19T19:30" }), 409, "FRANJA_LIBRE"],
+      ["pista inexistente", apuntar(api, "socio-041", { pistaId: "pista-9", inicio: "2026-11-19T19:30" }), 404, "PISTA_NO_ENCONTRADA"],
+      ["pista cerrada", apuntar(api, "socio-041", { pistaId: "pista-4", inicio: "2026-11-19T19:30" }), 409, "PISTA_CERRADA"],
+      ["franja inválida", apuntar(api, "socio-041", { pistaId: "pista-1", inicio: "2026-11-19T19:35" }), 400, "FRANJA_INVALIDA"],
+      ["franja pasada", apuntar(api, "socio-041", { pistaId: "pista-1", inicio: "2026-11-18T09:00" }), 409, "FRANJA_PASADA"],
+      ["cuota inactiva", apuntar(api, "socio-011"), 409, "CUOTA_INACTIVA"],
+    ];
+    for (const [nombre, peticion, http, codigo] of casos) {
+      const r = await peticion;
+      assert.equal(r.status, http, nombre);
+      assert.equal(r.cuerpo.error.codigo, codigo, nombre);
+    }
+  });
+});
+
+test("sin duplicados y con un máximo de dos esperas activas", async () => {
+  await conApi(async (api) => {
+    assert.equal((await apuntar(api, "socio-041")).status, 201);
+
+    const repetida = await apuntar(api, "socio-041");
+    assert.equal(repetida.status, 409);
+    assert.equal(repetida.cuerpo.error.codigo, "YA_EN_ESPERA");
+
+    const yaReservada = await apuntar(api, "socio-007");
+    assert.equal(yaReservada.status, 409);
+    assert.equal(yaReservada.cuerpo.error.codigo, "YA_RESERVADA");
+
+    assert.equal((await apuntar(api, "socio-041", { pistaId: "pista-2", inicio: "2026-11-20T18:00" })).status, 201);
+    const tercera = await apuntar(api, "socio-041", { pistaId: "pista-1", inicio: "2026-11-23T18:00" });
+    assert.equal(tercera.status, 409);
+    assert.equal(tercera.cuerpo.error.codigo, "LIMITE_DE_ESPERAS");
+  });
+});
+
+test("retirarse: su dueño o un gestor, y los de detrás suben un puesto", async () => {
+  await conApi(async (api) => {
+    const primera = (await apuntar(api, "socio-041")).cuerpo.espera;
+    const segunda = (await apuntar(api, "socio-004")).cuerpo.espera;
+    const tercera = (await apuntar(api, "socio-006")).cuerpo.espera;
+
+    const retirada = await api.pedir("DELETE", `/api/esperas/${primera.id}`, { socio: "socio-041" });
+    assert.equal(retirada.status, 200);
+    assert.equal(retirada.cuerpo.espera.estado, "retirada");
