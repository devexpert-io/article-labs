+test("exportar CSV exige gestor y valida periodo y estado", async () => {
+  const ruta = "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-02";
+  const anonimo = await api.pedir("GET", ruta);
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("GET", ruta, { socio: "socio-001" });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  for (const [query, codigo] of [
+    ["hasta=2026-10-02", "DATOS_INVALIDOS"],
+    ["desde=2026-02-30&hasta=2026-03-02", "DATOS_INVALIDOS"],
+    ["desde=2026-10-03&hasta=2026-10-02", "DATOS_INVALIDOS"],
+    ["desde=2026-01-01&hasta=2026-04-03", "RANGO_DEMASIADO_GRANDE"],
+    ["desde=2026-10-01&hasta=2026-10-02&estado=otro", "DATOS_INVALIDOS"],
+  ]) {
+    const r = await api.pedir("GET", `/api/reservas/exportar?${query}`, { socio: "socio-040" });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, codigo);
+  }
+});
+
+test("exportar CSV devuelve cabecera, filas ordenadas, importes, filtro y CRLF", async () => {
+  const r = await api.pedir("GET", "/api/reservas/exportar?desde=2026-10-01&hasta=2026-10-02", { socio: "socio-040" });
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-10-02.csv"');
+  const lineas = r.texto.split("\r\n");
+  assert.equal(lineas[0], "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas");
+  assert.equal(lineas.at(-1), "");
+  assert.ok(r.texto.endsWith("\r\n"));
+  assert.ok(!r.texto.replace(/\r\n/g, "").includes("\n"));
+  const datos = (await api.pedir("GET", "/_estado")).cuerpo;
