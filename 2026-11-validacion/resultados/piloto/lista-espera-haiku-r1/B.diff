+    const tarde =await otra.pedir("POST", "/api/esperas", { socio: "socio-024", cuerpo: { pistaId: "pista-1", inicio: dia("12:00") } });
+    assert.equal(tarde.cuerpo.error.codigo, "FRANJA_PASADA");
