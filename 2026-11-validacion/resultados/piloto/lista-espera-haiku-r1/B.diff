+    const dia = (hora: string) => `2026-11-25T${hora}`;
+    await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-028", pistaId: "pista-1", inicio: dia("12:00") } });
+    await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-027", pistaId: "pista-2", inicio: dia("18:00") } });
+    await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-034", pistaId: "pista-3", inicio: dia("15:00") } });
+
+    const enH = await otra.pedir("POST", "/api/esperas", { socio: "socio-026", cuerpo: { pistaId: "pista-1", inicio: dia("12:00") } });
+    const enJ = await otra.pedir("POST", "/api/esperas", { socio: "socio-026", cuerpo: { pistaId: "pista-2", inicio: dia("18:00") } });
+    assert.equal(enH.status, 201);
+    assert.equal(enJ.status, 201);
+    const llena = await otra.pedir("POST", "/api/esperas", { socio: "socio-026", cuerpo: { pistaId: "pista-3", inicio: dia("15:00") } });
+    assert.equal(llena.cuerpo.error.codigo, "LIMITE_DE_ESPERAS");
+
+    assert.equal((await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T12:30" } })).status, 200);
+
+    const visibles = await otra.pedir("GET", "/api/esperas", { socio: "socio-026" });
+    assert.deepEqual(visibles.cuerpo.esperas.map((e: any) => e.inicio), [dia("18:00")]);
+    assert.equal(visibles.cuerpo.esperas[0].posicion, 1);
+
+    // La espera caducada no queda asignada: no hay reserva de socio-026 en esa franja, ni la espera pasa a asignada.
