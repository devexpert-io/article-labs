@@ -0,0 +1,262 @@
+// La lista de espera de franjas, probada a través de la API.
+// Los días 25 a 27 de noviembre están libres en la semilla, así que cada test monta su propia ocupación.
+// Los socios usados no tienen reservas futuras en la semilla, salvo socio-001 (una) y socio-002 y socio-003 (una cada uno).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+/** Reserva a nombre de un socio como lo haría recepción (sin cabecera X-Socio) y devuelve su id. */
+async function reservar(socioId: string, pistaId: string, inicio: string): Promise<string> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, `reservar ${pistaId} ${inicio} para ${socioId}: ${r.texto}`);
+  return r.cuerpo.reserva.id;
+}
+
+/** Estado de una espera tal y como la guarda el club. */
+async function esperaEnElClub(id: string) {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  return estado.esperas.find((e: { id: string }) => e.id === id);
