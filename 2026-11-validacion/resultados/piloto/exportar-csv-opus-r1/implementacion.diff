@@ -0,0 +1,169 @@
+// Exportar reservas a CSV (docs/specs/exportar-csv.md), probado a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const CABECERA = "id,fecha,hora,pista,socio,email,estado,importe,penalizacion,notas";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+/** Con `socio: null`, sin cabecera X-Socio. */
+const exportar = (consulta: string, socio: string | null = GESTOR) =>
+  api.pedir("GET", `/api/reservas/exportar${consulta}`, socio === null ? {} : { socio });
+
+/** Separa el CSV en líneas comprobando que todas terminan en CRLF. Solo vale si no hay saltos dentro de campos. */
+function lineas(texto: string): string[] {
+  assert.ok(texto.endsWith("\r\n"), "la última línea termina en CRLF");
+  return texto.slice(0, -2).split("\r\n");
+}
+
+test("permisos: solo exporta un gestor", async () => {
+  const sin = await exportar("?desde=2026-11-01&hasta=2026-11-30", null);
+  assert.equal(sin.status, 401);
+  assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await exportar("?desde=2026-11-01&hasta=2026-11-30", "socio-004");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const desconocido = await exportar("?desde=2026-11-01&hasta=2026-11-30", "socio-999");
+  assert.equal(desconocido.status, 401);
+  assert.equal(desconocido.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  assert.equal((await exportar("?desde=2026-11-01&hasta=2026-11-30")).status, 200);
+});
+
+test("respuesta: 200 con content-type y content-disposition, y la cabecera exacta en la primera línea", async () => {
+  const r = await exportar("?desde=2026-10-01&hasta=2026-10-31");
+  assert.equal(r.status, 200);
+  assert.equal(r.cabeceras.get("content-type"), "text/csv; charset=utf-8");
+  assert.equal(r.cabeceras.get("content-disposition"), 'attachment; filename="reservas-2026-10-01-2026-10-31.csv"');
+  assert.ok(r.texto.startsWith(`${CABECERA}\r\n`));
+  assert.equal(lineas(r.texto)[0], CABECERA);
+});
+
+test("filas: una por reserva del periodo, ambos días incluidos, ordenadas por inicio y pista", async () => {
+  const r = await exportar("?desde=2026-10-01&hasta=2026-10-31");
+  const filas = lineas(r.texto).slice(1);
+  const json = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=1");
+  assert.equal(filas.length, json.cuerpo.total);
+  assert.equal(filas.length, 315);
+  const estados = new Set(filas.map((f) => f.split(",")[6]));
+  assert.deepEqual([...estados].sort(), ["cancelada", "confirmada", "no_presentada"]);
+  const fechas = filas.map((f) => f.split(",")[1]!);
+  assert.equal(fechas[0], "2026-10-01");
+  assert.equal(fechas.at(-1), "2026-10-31");
+  const claves = filas.map((f) => { const c = f.split(","); return `${c[1]}T${c[2]}|${c[3]}`; });
+  assert.deepEqual(claves, [...claves].sort());
+
+  // Una reserva creada ahora (al final del estado) sale en su sitio, y empatada en inicio, por id de pista.
+  await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-24T09:00" } });
+  await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-006", pistaId: "pista-1", inicio: "2026-11-24T09:00" } });
+  const dia = lineas((await exportar("?desde=2026-11-24&hasta=2026-11-24")).texto).slice(1);
+  const nueve = dia.filter((f) => f.split(",")[2] === "09:00").map((f) => f.split(",")[3]);
+  assert.deepEqual(nueve, [...nueve].sort());
+  assert.ok(nueve.includes("Pista 1") && nueve.includes("Pista 3"));
+  const inicios = dia.map((f) => f.split(",")[2]!);
+  assert.deepEqual(inicios, [...inicios].sort());
+});
+
+test("columnas: fecha, hora, nombre de pista, socio, email e importes en euros", async () => {
+  const r = await exportar("?desde=2026-11-23&hasta=2026-11-23");
+  const fila = lineas(r.texto).find((f) => f.includes(",Irene Sanz,"));
+  const reserva = (await api.pedir("GET", "/api/reservas?socio=socio-004&fecha=2026-11-23")).cuerpo.reservas[0];
+  assert.equal(fila, `${reserva.id},2026-11-23,18:00,Pista 1,Irene Sanz,irene.sanz@example.com,confirmada,28.00,,`);
+});
+
+test("importes: la penalización en euros con dos decimales y, si no hay, vacía", async () => {
+  const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1200);
+  const filas = lineas((await exportar("?desde=2026-11-19&hasta=2026-11-19")).texto).slice(1);
+  const cancelada = filas.find((f) => f.startsWith("R-0520,"))!.split(",");
+  assert.deepEqual(cancelada.slice(6, 9), ["cancelada", "12.00", "12.00"]);
+  for (const f of filas.filter((f) => !f.startsWith("R-0520,"))) {
+    const c = f.split(",");
+    assert.match(c[7]!, /^\d+\.\d{2}$/);
+    assert.equal(c[8], "");
+  }
+});
+
+test("escapado RFC 4180 y CRLF en todas las líneas", async () => {
+  const notas = [
+    "Sin nada raro",
+    "Palas, bolas y toallas",
+    'Dice "hola" al llegar',
+    "Primera línea\nSegunda línea",
+    'Todo: "a", b\r\nc',
+  ];
+  const horas = ["09:00", "10:30", "12:00", "13:30", "15:00"];
+  const socios = ["socio-003", "socio-006", "socio-007", "socio-008", "socio-009"];
+  for (const [i, nota] of notas.entries()) {
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: socios[i], pistaId: "pista-2", inicio: `2026-11-30T${horas[i]}`, notas: nota },
+    });
+    assert.equal(creada.status, 201);
+  }
+  const r = await exportar("?desde=2026-11-30&hasta=2026-11-30&estado=confirmada");
+  const filas = r.texto.split(/(?<=\r\n)/);
+  // 1 cabecera + 5 filas, y la última nota lleva un CRLF dentro que este split también parte.
+  assert.equal(filas.length, 7);
+  assert.equal(filas[0], `${CABECERA}\r\n`);
+  const fin = (f: string) => f.slice(f.indexOf(",18.00,,") + ",18.00,,".length);
+  assert.equal(fin(filas[1]!), "Sin nada raro\r\n");
+  assert.equal(fin(filas[2]!), '"Palas, bolas y toallas"\r\n');
+  assert.equal(fin(filas[3]!), '"Dice ""hola"" al llegar"\r\n');
+  assert.equal(fin(filas[4]!), '"Primera línea\nSegunda línea"\r\n');
+  // Ese campo con CRLF dentro se comprueba sobre el texto entero.
+  assert.ok(r.texto.endsWith('"Todo: ""a"", b\r\nc"\r\n'));
+  // Los demás campos van sin comillas.
+  assert.ok(!filas[1]!.includes('"'));
+});
+
+test("periodo: obligatorio, con formato, ordenado y de 92 días como mucho", async () => {
+  for (const consulta of ["", "?desde=2026-11-01", "?hasta=2026-11-30", "?desde=2026-11-1&hasta=2026-11-30",
+    "?desde=01-11-2026&hasta=2026-11-30", "?desde=2026-11-01&hasta=2026-02-30", "?desde=2026-11-30&hasta=2026-11-01",
+    "?desde=2026-11-01T10:00&hasta=2026-11-30"]) {
+    const r = await exportar(consulta);
+    assert.equal(r.status, 400, consulta);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS", consulta);
+  }
+  // Del 1 de octubre al 31 de diciembre son 92 días contando los dos extremos.
+  assert.equal((await exportar("?desde=2026-10-01&hasta=2026-12-31")).status, 200);
+  assert.equal((await exportar("?desde=2026-11-18&hasta=2026-11-18")).status, 200);
+  const grande = await exportar("?desde=2026-10-01&hasta=2027-01-01");
+  assert.equal(grande.status, 400);
+  assert.equal(grande.cuerpo.error.codigo, "RANGO_DEMASIADO_GRANDE");
+});
+
+test("filtro por estado", async () => {
+  const todas = lineas((await exportar("?desde=2026-10-01&hasta=2026-10-31")).texto).slice(1);
+  let suma = 0;
+  for (const estado of ["confirmada", "cancelada", "no_presentada"]) {
+    const filas = lineas((await exportar(`?desde=2026-10-01&hasta=2026-10-31&estado=${estado}`)).texto).slice(1);
+    assert.ok(filas.length > 0);
+    assert.ok(filas.every((f) => f.split(",")[6] === estado), estado);
+    suma += filas.length;
+  }
+  assert.equal(suma, todas.length);
+  const malo = await exportar("?desde=2026-10-01&hasta=2026-10-31&estado=pendiente");
+  assert.equal(malo.status, 400);
+  assert.equal(malo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+});
+
+test("GET /api/reservas y GET /api/reservas/:id responden igual que antes", async () => {
+  const otra = await arrancarApi();
+  try {
+    const lista = await otra.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=2");
+    assert.equal(lista.status, 200);
+    assert.equal(lista.cabeceras.get("content-type"), "application/json; charset=utf-8");
+    assert.deepEqual(Object.keys(lista.cuerpo), ["total", "pagina", "paginas", "reservas"]);
+    assert.deepEqual(lista.cuerpo, { total: 315, pagina: 1, paginas: 158, reservas: lista.cuerpo.reservas });
+    assert.equal(lista.cuerpo.reservas[0].id, "R-0001");
+    assert.equal((await otra.pedir("GET", "/api/reservas?limite=101")).cuerpo.error.codigo, "DATOS_INVALIDOS");
+    assert.equal((await otra.pedir("GET", "/api/reservas/R-0001")).cuerpo.reserva.id, "R-0001");
+  } finally {
+    otra.cerrar();
+  }
+});
