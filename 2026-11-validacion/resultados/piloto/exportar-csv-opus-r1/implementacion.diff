+/** Una fecha AAAA-MM-DD que existe en el calendario. */
+function esFechaValida(texto: unknown): texto is string {
+  if (typeof texto !== "string" || !FECHA.test(texto)) return false;
+  const d = new Date(`${texto}T12:00:00Z`);
+  return !Number.isNaN(d.getTime()) && d.toISOString().slice(0, 10) === texto;
+}
+
+/** Céntimos a euros con dos decimales y punto: 1800 es "18.00". */
+function euros(centimos: number): string {
+  const signo = centimos < 0 ? "-" : "";
+  const abs = Math.abs(centimos);
+  return `${signo}${Math.floor(abs / 100)}.${String(abs % 100).padStart(2, "0")}`;
+}
+
+/** Un campo CSV según el RFC 4180: entre comillas solo si lleva coma, comillas o salto de línea. */
+function campoCsv(valor: string): string {
+  return /[",\r\n]/.test(valor) ? `"${valor.replace(/"/g, '""')}"` : valor;
+}
