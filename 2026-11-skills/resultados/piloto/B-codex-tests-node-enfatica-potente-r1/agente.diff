+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { ahora });
+}
+
+async function crear(inicio = "2026-12-10T18:00", pistaId = "pista-1"): Promise<Reserva> {
+  const r = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio, notas: "Prueba de reembolsos" },
+  });
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.cuerpo, { reserva: {
+    id: r.cuerpo.reserva.id, socioId: "socio-041", pistaId, inicio,
+    fin: `${inicio.slice(0, 10)}T${inicio.endsWith("21:00") ? "22:30" : "19:30"}`,
+    importe: pistaId === "pista-3" ? 2000 : 2800, estado: "confirmada" as const, notas: "Prueba de reembolsos",
+  } });
+  return r.cuerpo.reserva;
+}
+
+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+  assert.equal(typeof r.cuerpo.error.mensaje, "string");
+}
+
+async function cancelar(r: Reserva, penalizacion: number, cuerpo = {}, socio?: string) {
+  const respuesta = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo, socio });
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, {
+    reserva: { ...r, estado: "cancelada", penalizacion,
+      ...("motivo" in cuerpo ? { motivoCancelacion: cuerpo.motivo } : {}) },
+    reembolso: r.importe - penalizacion,
+  });
+  const guardada = await api.pedir("GET", `/api/reservas/${r.id}`);
+  assert.equal(guardada.status, 200);
+  assert.deepEqual(guardada.cuerpo, { reserva: respuesta.cuerpo.reserva });
+}
