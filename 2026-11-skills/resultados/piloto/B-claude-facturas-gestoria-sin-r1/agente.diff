index 0000000..8fe4bad
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,193 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { desglosarIva } from "../src/nucleo.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("permisos: solo un gestor genera y consulta facturas", () =>
+  conApi({}, async (api) => {
+    const rutas: [string, string, unknown?][] = [
+      ["POST", "/api/facturas", { mes: "2026-10" }],
+      ["GET", "/api/facturas?mes=2026-10"],
+      ["GET", "/api/facturas/2026-0001"],
+    ];
+    for (const [metodo, ruta, cuerpo] of rutas) {
+      const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+      assert.equal(anonimo.status, 401, `${metodo} ${ruta}`);
+      assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+      const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-004" });
+      assert.equal(socio.status, 403, `${metodo} ${ruta}`);
+      assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+    }
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    assert.deepEqual(estado.facturas, [], "sin permiso no se genera nada");
+  }));
+
+test("mes cerrado: formato AAAA-MM y solo meses que ya han terminado", () =>
+  conApi({}, async (api) => {
+    for (const mes of [undefined, "2026-1", "2026-13", "2026-00", "octubre", "2026-10-01", 202610]) {
+      const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+      assert.equal(r.status, 400, String(mes));
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    const malGet = await api.pedir("GET", "/api/facturas?mes=2026-1", { socio: GESTOR });
+    assert.equal(malGet.status, 400);
+    for (const mes of ["2026-11", "2026-12"]) {
+      const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+      assert.equal(abierto.status, 409);
+      assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+    }
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T23:59" } });
+    assert.equal((await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).cuerpo.error.codigo, "MES_ABIERTO");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T00:00" } });
+    assert.equal((await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).status, 201);
+  }));
+
+test("octubre de 2026: una factura por socio, con sus líneas, total, IVA y números", () =>
+  conApi({}, async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const octubre = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10-"));
+    const facturables = octubre.filter((r: any) => r.estado !== "cancelada" || r.penalizacion);
+
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(r.status, 201);
+    const facturas = r.cuerpo.facturas;
+
+    // Una por socio con algo que facturar, ordenadas por id de socio, y ninguna para los demás.
+    const socios = [...new Set(facturables.map((x: any) => x.socioId))].sort();
+    assert.deepEqual(facturas.map((f: any) => f.socioId), socios);
+    assert.equal(facturas.length, 40);
+    assert.ok(!facturas.some((f: any) => f.socioId === "socio-041"), "Nora Benítez no tiene nada que facturar");
+
+    // Numeración correlativa desde 2026-0001, por orden de socio.
+    assert.deepEqual(facturas.map((f: any) => f.numero), facturas.map((_: unknown, i: number) => `2026-${String(i + 1).padStart(4, "0")}`));
+
+    for (const f of facturas) {
+      assert.equal(f.mes, "2026-10");
+      const suyas = facturables.filter((x: any) => x.socioId === f.socioId).sort((a: any, b: any) => a.inicio.localeCompare(b.inicio));
+      assert.deepEqual(f.lineas.map((l: any) => l.reservaId), suyas.map((x: any) => x.id));
+      assert.deepEqual(f.lineas.map((l: any) => l.importe), suyas.map((x: any) => x.importe));
+      assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+      assert.equal(f.base + f.iva, f.total);
+      assert.equal(f.base, Math.round((f.total * 100) / 121));
+    }
+
+    // Las canceladas sin penalización no se facturan; las no presentadas sí, por su importe.
+    const lineas = facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId));
+    for (const x of octubre) assert.equal(lineas.includes(x.id), x.estado !== "cancelada", x.id);
+    assert.equal(lineas.length, 290);
+    assert.equal(facturas.reduce((s: number, f: any) => s + f.total, 0), 635000);
+
+    // Un ejemplo concreto: socio-001.
+    assert.deepEqual(facturas[0], {
+      numero: "2026-0001",
+      mes: "2026-10",
+      socioId: "socio-001",
+      lineas: [
+        { reservaId: "R-0120", concepto: "Reserva de Pista 1, 2026-10-12 09:00", importe: 1800 },
+        { reservaId: "R-0172", concepto: "Reserva de Pista 2, 2026-10-17 21:00", importe: 2800 },
+        { reservaId: "R-0193", concepto: "Reserva de Pista 4, 2026-10-18 12:00", importe: 2200 },
+      ],
+      total: 6800,
+      base: 5620,
+      iva: 1180,
+    });
+  }));
+
+test("IVA del 21 % incluido en el precio: la base se redondea al céntimo y el IVA es la diferencia", () => {
+  assert.deepEqual(desglosarIva(12100), { base: 10000, iva: 2100 });
+  assert.deepEqual(desglosarIva(6800), { base: 5620, iva: 1180 }); // 5619,83 → 5620
+  assert.deepEqual(desglosarIva(1200), { base: 992, iva: 208 }); // 991,74 → 992
+  assert.deepEqual(desglosarIva(1), { base: 1, iva: 0 }); // 0,83 → 1
+  assert.deepEqual(desglosarIva(0), { base: 0, iva: 0 });
+});
+
+test("penalizaciones: se facturan como línea propia por su importe", () =>
+  conApi({}, async (api) => {
+    // R-0520 es de Marta López (socio-002), el jueves 19 a las 09:00 en la pista 3.
+    const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 1200);
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T09:00" } });
+    const { facturas } = (await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).cuerpo;
+    const marta = facturas.find((f: any) => f.socioId === "socio-002");
+    const linea = marta.lineas.find((l: any) => l.reservaId === "R-0520");
+    assert.deepEqual(linea, { reservaId: "R-0520", concepto: "Penalización por cancelación de Pista 3, 2026-11-19 09:00", importe: 1200 });
+    const inicios = marta.lineas.map((l: any) => l.concepto.slice(-16));
+    assert.deepEqual(inicios, [...inicios].sort(), "líneas ordenadas por inicio");
+  }));
+
+test("numeración entre meses y entre años, y generar dos veces no crea nada", () =>
+  conApi({}, async (api) => {
+    const octubre = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
