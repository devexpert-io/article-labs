+
+test("C5 · exención: un gestor cancela sin penalización con exento y motivo de 10 caracteres o más", async () => {
+  await conApi(async (api) => {
+    await moverReloj(api, "2027-07-01T10:00");
+    const reserva = await crear(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2027-07-01T19:30" });
+
+    const motivoCorto = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
