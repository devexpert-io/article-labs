+// La política de cancelación escalonada, la exención de gestores y el informe de caja.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Cada test arranca su propia API con una semilla nueva y la cierra al terminar. */
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function moverReloj(api: Api, ahora: string) {
+  const respuesta = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(respuesta.status, 200);
+  assert.equal(respuesta.cuerpo.ahora, ahora);
+}
+
+async function crear(api: Api, datos: Record<string, unknown>) {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: datos });
+  assert.equal(respuesta.status, 201);
+  return respuesta.cuerpo.reserva;
+}
+
+test("C1 · tramos: gratis con 48 h o más, 25 % entre 24 y 48, y 50 % con forzar por debajo de 24", async () => {
+  await conApi(async (api) => {
+    await moverReloj(api, "2027-05-01T10:00");
+
+    const larga = await crear(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2027-05-04T10:30" });
+    const gratis = await api.pedir("POST", `/api/reservas/${larga.id}/cancelar`);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.estado, "cancelada");
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, larga.importe);
+
+    const media = await crear(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2027-05-02T12:00" });
+    const reducida = await api.pedir("POST", `/api/reservas/${media.id}/cancelar`);
+    assert.equal(reducida.status, 200);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, 700);
+    assert.equal(reducida.cuerpo.reembolso, media.importe - 700);
+
+    const corta = await crear(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2027-05-01T19:30" });
+    const bloqueada = await api.pedir("POST", `/api/reservas/${corta.id}/cancelar`);
+    assert.equal(bloqueada.status, 409);
+    assert.equal(bloqueada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${corta.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 1400);
+    assert.equal(forzada.cuerpo.reembolso, corta.importe - 1400);
+  });
+});
+
+test("C2 · límites exactos: a 48 h no hay penalización y a 24 h se aplica el 25 % sin forzar", async () => {
+  await conApi(async (api) => {
+    await moverReloj(api, "2027-05-01T10:30");
+
+    const a48 = await crear(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2027-05-03T10:30" });
+    const justo48 = await api.pedir("POST", `/api/reservas/${a48.id}/cancelar`);
+    assert.equal(justo48.status, 200);
+    assert.equal(justo48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(justo48.cuerpo.reembolso, a48.importe);
+
+    const a24 = await crear(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2027-05-02T10:30" });
+    const justo24 = await api.pedir("POST", `/api/reservas/${a24.id}/cancelar`);
+    assert.equal(justo24.status, 200);
+    assert.equal(justo24.cuerpo.reserva.penalizacion, 700);
+    assert.equal(justo24.cuerpo.reembolso, a24.importe - 700);
+  });
+});
+
+test("C3 · cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  await conApi(async (api) => {
+    // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 h reales
+    // (48,5 h de reloj menos la hora que se adelanta esa madrugada).
+    await moverReloj(api, "2027-03-26T20:30");
+    const reserva = await crear(api, { socioId: "socio-003", pistaId: "pista-1", inicio: "2027-03-28T21:00" });
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+    assert.equal(cancelada.cuerpo.reembolso, reserva.importe - 700);
+  });
+});
+
+test("C4 · reembolso: es el importe menos la penalización, o el importe entero sin penalización", async () => {
+  await conApi(async (api) => {
+    await moverReloj(api, "2027-06-01T10:00");
