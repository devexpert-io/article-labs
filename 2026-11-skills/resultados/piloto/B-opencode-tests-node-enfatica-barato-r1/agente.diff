+test("C7 · informe de caja: cuenta las no presentadas del historial y las pistas sin movimientos", async () => {
+  await conApi(async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+
+    const pista3 = informe.cuerpo.pistas.find((p: { pistaId: string }) => p.pistaId === "pista-3");
+    const delMes = estado.reservas.filter((r: { pistaId: string; inicio: string }) => r.pistaId === "pista-3" && r.inicio.slice(0, 7) === "2026-10");
+    const cobradas = delMes.filter((r: { estado: string }) => r.estado === "confirmada" || r.estado === "no_presentada");
+    assert.equal(cobradas.some((r: { estado: string }) => r.estado === "no_presentada"), true);
+    assert.equal(pista3.reservas, cobradas.length);
+    assert.equal(pista3.ingresos, cobradas.reduce((suma: number, r: { importe: number }) => suma + r.importe, 0));
+    assert.deepEqual(
+      informe.cuerpo.pistas.map((p: { pistaId: string }) => p.pistaId),
+      ["pista-1", "pista-2", "pista-3", "pista-4"],
+    );
+  });
+});
