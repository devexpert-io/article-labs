+          .map(lineaDe)
+          .filter((l): l is LineaFactura => l !== undefined);
+        if (lineas.length === 0) continue;
+        const total = lineas.reduce((suma, l) => suma + l.importe, 0);
+        const base = baseImponible(total);
+        nuevas.push({
+          numero: `F${anio}-${String(siguiente++).padStart(4, "0")}`,
+          mes,
+          socioId,
+          lineas,
+          total,
+          base,
+          iva: total - base,
+        });
+      }
+      estado.facturas.push(...nuevas);
+      estado.mesesFacturados.push(mes);
+      return { creadas: true, facturas: nuevas };
+    },
