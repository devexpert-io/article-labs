diff --git a/test/facturas.test.ts b/test/facturas.test.ts
new file mode 100644
index 0000000..4022c2f
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,150 @@
+// Facturas mensuales para la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const generar = (api: Api, mes: unknown, socio = GESTOR) => api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio });
+
+test("solo un gestor genera y consulta facturas", () => conApi(async (api) => {
+  for (const [metodo, ruta] of [["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F2026-0001"]] as const) {
+    const cuerpo = metodo === "POST" ? { mes: "2026-10" } : undefined;
+    const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+    assert.equal(anonimo.status, 401, ruta);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-004" });
+    assert.equal(socio.status, 403, ruta);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, 0);
+}));
+
+test("solo se factura un mes cerrado con el formato AAAA-MM", () => conApi(async (api) => {
+  for (const mes of [undefined, "2026-13", "2026-1", "octubre", "2026-10-01", 202610]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-1", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+}));
+
+test("octubre: una factura por socio con algo que facturar, con sus líneas, total, IVA y números", () => conApi(async (api) => {
+  const { reservas } = (await api.pedir("GET", "/_estado")).cuerpo;
+  const octubre = reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+  const r = await generar(api, "2026-10");
+  assert.equal(r.status, 201);
+  const { facturas } = r.cuerpo;
+
+  const facturables = octubre.filter((x: any) => x.estado !== "cancelada" || x.penalizacion > 0);
+  const socios = [...new Set(facturables.map((x: any) => x.socioId))].sort();
+  assert.deepEqual(facturas.map((f: any) => f.socioId), socios, "una por socio, por orden de id");
+  assert.deepEqual(facturas.map((f: any) => f.numero), socios.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+
+  for (const f of facturas) {
+    assert.equal(f.mes, "2026-10");
+    const esperadas = facturables.filter((x: any) => x.socioId === f.socioId).sort((a: any, b: any) => a.inicio.localeCompare(b.inicio));
+    assert.deepEqual(f.lineas, esperadas.map((x: any) => ({ reservaId: x.id, concepto: "Reserva", importe: x.importe })));
+    assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+    assert.equal(f.base, Math.round(f.total * 100 / 121));
+    assert.equal(f.base + f.iva, f.total);
+  }
+  const canceladas = octubre.filter((x: any) => x.estado === "cancelada").map((x: any) => x.id);
+  assert.ok(canceladas.length > 0);
+  const facturadas = facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId));
+  assert.ok(canceladas.every((id: string) => !facturadas.includes(id)), "las cancelaciones sin penalización no entran");
+  assert.ok(octubre.some((x: any) => x.estado === "no_presentada" && facturadas.includes(x.id)), "las no presentadas entran");
+
+  // Consultar.
+  const lista = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(lista.status, 200);
+  assert.deepEqual(lista.cuerpo.facturas, facturas);
+  const una = await api.pedir("GET", `/api/facturas/${facturas[2].numero}`, { socio: GESTOR });
+  assert.deepEqual(una.cuerpo.factura, facturas[2]);
+  const vacia = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+  assert.deepEqual(vacia.cuerpo, { facturas: [] });
+  const noExiste = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+  assert.equal(noExiste.status, 404);
+  assert.equal(noExiste.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+
+  // Generar dos veces devuelve las mismas y no gasta números.
+  const otra = await generar(api, "2026-10");
+  assert.equal(otra.status, 200);
+  assert.deepEqual(otra.cuerpo.facturas, facturas);
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, facturas.length);
+}));
+
+test("base sobre el total: 1.800 + 1.800 + 2.800 = 6.400 dan base 5.289 e IVA 1.111", () => conApi(async (api) => {
+  for (const inicio of ["2026-12-01T09:00", "2026-12-02T09:00", "2026-12-02T18:00"]) {
+    assert.equal((await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio } })).status, 201);
+  }
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-05T10:00" } });
+  const { facturas } = (await generar(api, "2026-12")).cuerpo;
+  assert.equal(facturas.length, 1);
+  assert.deepEqual(facturas[0].lineas.map((l: any) => l.importe), [1800, 1800, 2800]);
+  assert.equal(facturas[0].total, 6400);
+  assert.equal(facturas[0].base, 5289);
+  assert.equal(facturas[0].iva, 1111);
+}));
+
+test("una cancelación con penalización entra como Penalización y una sin penalización no entra", () => conApi(async (api) => {
+  // R-0520: Marta López, jueves 19 a las 09:00, faltan 23 horas: se cancela con penalización.
+  const penalizada = (await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } })).cuerpo.reserva;
+  assert.equal(penalizada.penalizacion, 1200);
+  const nueva = (await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-002", pistaId: "pista-3", inicio: "2026-11-24T12:00" } })).cuerpo.reserva;
+  assert.equal((await api.pedir("POST", `/api/reservas/${nueva.id}/cancelar`)).cuerpo.reserva.penalizacion, undefined);
+
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T00:00" } });
+  const { facturas } = (await generar(api, "2026-11")).cuerpo;
+  const marta = facturas.find((f: any) => f.socioId === "socio-002");
+  const linea = marta.lineas.find((l: any) => l.reservaId === "R-0520");
+  assert.deepEqual(linea, { reservaId: "R-0520", concepto: "Penalización", importe: 1200 });
+  assert.ok(!marta.lineas.some((l: any) => l.reservaId === nueva.id));
+}));
+
+test("numeración: sigue entre meses, diciembre generado en enero es de 2026 y cada año empieza en 0001", () => conApi(async (api) => {
+  await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-01T09:00" } });
+  await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-006", pistaId: "pista-1", inicio: "2026-12-01T10:30" } });
+
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-05T10:00" } });
+  // Fuera de orden: primero noviembre, luego diciembre, luego octubre.
+  const noviembre = (await generar(api, "2026-11")).cuerpo.facturas;
+  assert.equal(noviembre[0].numero, "F2026-0001");
+  const diciembre = await generar(api, "2026-12");
+  assert.equal(diciembre.status, 201);
+  assert.deepEqual(diciembre.cuerpo.facturas.map((f: any) => [f.numero, f.socioId]), [
+    [`F2026-${String(noviembre.length + 1).padStart(4, "0")}`, "socio-006"],
+    [`F2026-${String(noviembre.length + 2).padStart(4, "0")}`, "socio-041"],
+  ]);
+  const octubre = (await generar(api, "2026-10")).cuerpo.facturas;
