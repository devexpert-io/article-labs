+test("informe de caja: cuenta confirmadas y no presentadas por fecha de inicio, y las penalizaciones de las canceladas", async () => {
+  await reloj("2026-11-18T10:00");
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const informe = (await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR })).cuerpo;
+  assert.equal(informe.mes, "2026-10");
+  assert.deepEqual(informe.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+  const deOctubre = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+  for (const linea of informe.pistas) {
+    const suyas = deOctubre.filter((r: any) => r.pistaId === linea.pistaId);
+    const cobradas = suyas.filter((r: any) => r.estado === "confirmada" || r.estado === "no_presentada");
+    const ingresos = cobradas.reduce((s: number, r: any) => s + r.importe, 0);
+    const penalizaciones = suyas.filter((r: any) => r.estado === "cancelada").reduce((s: number, r: any) => s + (r.penalizacion ?? 0), 0);
+    assert.deepEqual(linea, { pistaId: linea.pistaId, reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones });
+  }
+  const suma = (campo: string) => informe.pistas.reduce((s: number, p: any) => s + p[campo], 0);
+  assert.deepEqual(informe.total, { reservas: suma("reservas"), ingresos: suma("ingresos"), penalizaciones: suma("penalizaciones"), total: suma("total") });
+  assert.ok(informe.total.reservas > 0);
+  assert.ok(deOctubre.some((r: any) => r.estado === "no_presentada"));
+});
