@@ -0,0 +1,203 @@
+// Penalizaciones escalonadas, exención por un gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-041";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+async function reloj(ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+/** Crea una reserva con el reloj en un momento anterior y después pone el reloj en `ahora`. */
+async function reservarYMoverReloj(pistaId: string, inicio: string, ahora: string, socioId = SOCIO) {
+  await reloj("2026-11-18T10:00");
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(creada.status, 201, JSON.stringify(creada.cuerpo));
+  await reloj(ahora);
+  return creada.cuerpo.reserva as { id: string; importe: number };
+}
+
+function cancelar(id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+test("tramos: sin penalización con 48 horas o más, 25 % con 24 o más y 50 % con forzar con menos", async () => {
+  // pista-3 en valle: 1200 céntimos.
+  const holgada = await reservarYMoverReloj("pista-3", "2026-11-25T09:00", "2026-11-20T10:00");
+  const r1 = await cancelar(holgada.id);
+  assert.equal(r1.status, 200);
+  assert.equal(r1.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r1.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r1.cuerpo.reembolso, 1200);
+
+  const media = await reservarYMoverReloj("pista-3", "2026-11-25T10:30", "2026-11-24T00:00");
+  const r2 = await cancelar(media.id);
+  assert.equal(r2.status, 200);
+  assert.equal(r2.cuerpo.reserva.penalizacion, 300);
+  assert.equal(r2.cuerpo.reembolso, 900);
+
+  const justa = await reservarYMoverReloj("pista-3", "2026-11-25T12:00", "2026-11-25T08:00");
+  const sinForzar = await cancelar(justa.id);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const conForzar = await cancelar(justa.id, { forzar: true });
+  assert.equal(conForzar.status, 200);
+  assert.equal(conForzar.cuerpo.reserva.penalizacion, 600);
+  assert.equal(conForzar.cuerpo.reembolso, 600);
+});
+
+test("límites exactos: a 48 horas justas no hay penalización y a 24 justas es el 25 % sin forzar", async () => {
+  const a48 = await reservarYMoverReloj("pista-3", "2026-11-26T12:00", "2026-11-24T12:00");
+  const r48 = await cancelar(a48.id);
+  assert.equal(r48.status, 200);
+  assert.equal(r48.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r48.cuerpo.reembolso, 1200);
+
+  const casi48 = await reservarYMoverReloj("pista-3", "2026-11-26T13:30", "2026-11-24T13:31");
+  const rCasi48 = await cancelar(casi48.id);
+  assert.equal(rCasi48.cuerpo.reserva.penalizacion, 300);
+
+  const a24 = await reservarYMoverReloj("pista-3", "2026-11-26T15:00", "2026-11-25T15:00");
+  const r24 = await cancelar(a24.id);
+  assert.equal(r24.status, 200);
+  assert.equal(r24.cuerpo.reserva.penalizacion, 300);
+  assert.equal(r24.cuerpo.reembolso, 900);
+
+  const casi24 = await reservarYMoverReloj("pista-3", "2026-11-26T16:30", "2026-11-25T16:31");
+  assert.equal((await cancelar(casi24.id)).cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  assert.equal((await cancelar(casi24.id, { forzar: true })).cuerpo.reserva.penalizacion, 600);
+});
+
+test("cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  // Marzo de 2027: del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales (no 48,5).
+  const marzo = await reservarYMoverReloj("pista-3", "2027-03-28T21:00", "2027-03-26T20:30");
+  const rMarzo = await cancelar(marzo.id);
+  assert.equal(rMarzo.status, 200);
+  assert.equal(rMarzo.cuerpo.reserva.penalizacion, 500); // 25 % de 2000 (domingo, punta)
+  assert.equal(rMarzo.cuerpo.reembolso, 1500);
+
+  // Octubre de 2027: del viernes 29 a las 10:00 al domingo 31 a las 09:00 hay 48 horas reales (no 47).
+  const octubre = await reservarYMoverReloj("pista-3", "2027-10-31T09:00", "2027-10-29T10:00");
+  const rOctubre = await cancelar(octubre.id);
+  assert.equal(rOctubre.status, 200);
+  assert.equal(rOctubre.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(rOctubre.cuerpo.reembolso, 2000);
+});
+
+test("exención: un gestor cancela sin penalización con un motivo de al menos 10 caracteres", async () => {
+  const cercana = await reservarYMoverReloj("pista-2", "2026-11-27T12:00", "2026-11-27T10:00");
+  const motivo = "Lesión justificada con parte médico";
+
+  const anonimo = await cancelar(cercana.id, { exento: true, motivo });
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await cancelar(cercana.id, { exento: true, motivo }, "socio-001");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const sinMotivo = await cancelar(cercana.id, { exento: true }, GESTOR);
+  assert.equal(sinMotivo.status, 400);
+  assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const corto = await cancelar(cercana.id, { exento: true, motivo: "Lesión" }, GESTOR);
+  assert.equal(corto.status, 400);
+  assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  assert.equal((await api.pedir("GET", `/api/reservas/${cercana.id}`)).cuerpo.reserva.estado, "confirmada");
+
+  const exenta = await cancelar(cercana.id, { exento: true, motivo }, GESTOR);
+  assert.equal(exenta.status, 200);
+  assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+  assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(exenta.cuerpo.reserva.motivoCancelacion, motivo);
+  assert.equal(exenta.cuerpo.reembolso, cercana.importe);
+});
