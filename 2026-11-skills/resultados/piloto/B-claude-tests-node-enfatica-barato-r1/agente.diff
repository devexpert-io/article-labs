@@ -0,0 +1,233 @@
+// Penalizaciones escalonadas, exención de gestor e informe de caja (docs/specs/reembolsos.md), probados a través de la API.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-041"; // Nora Benítez: sin reservas, cuota al día y rol socio.
+// Miércoles 2 de diciembre a las 12:00, pista 1 en valle: 1800 céntimos.
+const INICIO = "2026-12-02T12:00";
+
+/** Cada test arranca su propia API con la semilla limpia. */
+async function conClub(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function reservar(api: Api, inicio = INICIO, pistaId = "pista-1") {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIO, pistaId, inicio } });
+  assert.equal(r.status, 201);
+  return r.cuerpo.reserva.id as string;
+}
+
+const cancelar = (api: Api, id: string, cuerpo?: unknown, socio?: string) =>
+  api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+
+async function reservaDe(api: Api, id: string) {
+  return (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva;
+}
+
+const error = (r: { status: number; cuerpo: any }) => ({ status: r.status, codigo: r.cuerpo.error?.codigo });
+
+test("C1 · con 48 horas o más de antelación no hay penalización", () => conClub(async (api) => {
+  const id = await reservar(api);
+  await reloj(api, "2026-11-28T12:00"); // 96 horas
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.deepEqual({ estado: r.cuerpo.reserva.estado, penalizacion: r.cuerpo.reserva.penalizacion }, { estado: "cancelada", penalizacion: undefined });
+}));
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 % del importe", () => conClub(async (api) => {
+  const id = await reservar(api);
+  await reloj(api, "2026-12-01T00:00"); // 36 horas
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 450);
+}));
+
+test("C1 · con menos de 24 horas solo se cancela con forzar, y entonces la penalización es el 50 %", () => conClub(async (api) => {
+  const id = await reservar(api);
+  await reloj(api, "2026-12-01T13:00"); // 23 horas
+  assert.deepEqual(error(await cancelar(api, id)), { status: 409, codigo: "FUERA_DE_PLAZO" });
+  assert.equal((await reservaDe(api, id)).estado, "confirmada", "sin forzar la reserva sigue confirmada");
+  const r = await cancelar(api, id, { forzar: true });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 900);
+}));
+
+test("C2 · a 48 horas justas no hay penalización", () => conClub(async (api) => {
+  const id = await reservar(api);
+  await reloj(api, "2026-11-30T12:00");
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+}));
+
+test("C2 · a un minuto de las 48 horas ya hay un 25 % de penalización", () => conClub(async (api) => {
+  const id = await reservar(api);
+  await reloj(api, "2026-11-30T12:01"); // 47 horas y 59 minutos
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 450);
+}));
+
+test("C2 · a 24 horas justas se aplica el 25 % sin necesidad de forzar", () => conClub(async (api) => {
+  const id = await reservar(api);
+  await reloj(api, "2026-12-01T12:00");
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 450);
+}));
+
+test("C2 · a un minuto de las 24 horas hace falta forzar", () => conClub(async (api) => {
+  const id = await reservar(api);
+  await reloj(api, "2026-12-01T12:01"); // 23 horas y 59 minutos
+  assert.deepEqual(error(await cancelar(api, id)), { status: 409, codigo: "FUERA_DE_PLAZO" });
+  const r = await cancelar(api, id, { forzar: true });
+  assert.equal(r.cuerpo.reserva.penalizacion, 900);
+}));
+
+test("C3 · el cambio de hora cuenta horas reales: 47,5 horas siguen siendo menos de 48", () => conClub(async (api) => {
+  // Viernes 26 de marzo de 2027 a las 20:30 hasta domingo 28 a las 21:00: 47,5 horas reales, no 48,5.
+  const id = await reservar(api, "2027-03-28T21:00", "pista-1"); // domingo, punta: 2800 céntimos
+  await reloj(api, "2027-03-26T20:30");
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 700);
+}));
+
+test("C3 · el cambio de hora cuenta horas reales: 48,5 horas ya no tienen penalización", () => conClub(async (api) => {
+  const id = await reservar(api, "2027-03-28T21:00", "pista-1");
+  await reloj(api, "2027-03-26T19:30");
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+}));
+
+test("C4 · la respuesta trae el reembolso: importe menos penalización", () => conClub(async (api) => {
+  const id = await reservar(api);
+  await reloj(api, "2026-12-01T00:00");
+  const r = await cancelar(api, id);
+  assert.equal(r.cuerpo.reembolso, 1350);
+  assert.equal(r.cuerpo.reembolso, r.cuerpo.reserva.importe - r.cuerpo.reserva.penalizacion);
+}));
+
+test("C4 · sin penalización el reembolso es el importe entero", () => conClub(async (api) => {
+  const id = await reservar(api);
+  await reloj(api, "2026-11-28T12:00");
+  const r = await cancelar(api, id);
+  assert.equal(r.cuerpo.reembolso, 1800);
+}));
+
+test("C5 · el gestor cancela sin penalización antes del inicio, con exento y un motivo", () => conClub(async (api) => {
+  const id = await reservar(api);
+  await reloj(api, "2026-12-02T10:00"); // 2 horas, sin forzar
+  const r = await cancelar(api, id, { exento: true, motivo: "lluvia torrencial" }, GESTOR);
+  assert.equal(r.status, 200);
+  assert.deepEqual(
+    { estado: r.cuerpo.reserva.estado, penalizacion: r.cuerpo.reserva.penalizacion, reembolso: r.cuerpo.reembolso, motivo: r.cuerpo.reserva.motivoCancelacion },
+    { estado: "cancelada", penalizacion: undefined, reembolso: 1800, motivo: "lluvia torrencial" },
+  );
+}));
+
