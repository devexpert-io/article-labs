+const ZONA = "Europe/Madrid";
+
+function desplazamiento(ts: number): number {
+  const partes = new Intl.DateTimeFormat("en-US", {
+    timeZone: ZONA,
+    hour12: false,
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+    hour: "2-digit",
+    minute: "2-digit",
+    second: "2-digit",
+  }).formatToParts(new Date(ts));
+  const leer = (tipo: string) => Number(partes.find((p) => p.type === tipo)?.value ?? 0);
+  const comoUtc = Date.UTC(leer("year"), leer("month") - 1, leer("day"), leer("hour"), leer("minute"), leer("second"));
+  return comoUtc - ts;
+}
+
+function enUtc(local: string): number {
+  const base = Date.parse(`${local}:00Z`);
+  let ts = base - desplazamiento(base);
+  if (desplazamiento(ts) !== desplazamiento(base)) ts = base - desplazamiento(ts);
+  return ts;
+}
