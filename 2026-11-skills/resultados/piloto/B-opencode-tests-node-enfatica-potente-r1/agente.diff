+
+    const cuarentaYOcho = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-001", pistaId: "pista-1", inicio: "2026-12-03T09:00" } });
+    assert.equal(cuarentaYOcho.status, 201);
+    const sinPenalizacion = await api.pedir("POST", `/api/reservas/${cuarentaYOcho.cuerpo.reserva.id}/cancelar`);
+    assert.equal(sinPenalizacion.status, 200);
+    assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, undefined);
