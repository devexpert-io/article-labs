+    const veinticuatro = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-002", pistaId: "pista-1", inicio: "2026-12-02T09:00" } });
+    assert.equal(veinticuatro.status, 201);
+    const parcial = await api.pedir("POST", `/api/reservas/${veinticuatro.cuerpo.reserva.id}/cancelar`);
+    assert.equal(parcial.status, 200);
+    assert.equal(parcial.cuerpo.reserva.penalizacion, Math.round(veinticuatro.cuerpo.reserva.importe * 0.25));
+  } finally {
+    api.cerrar();
