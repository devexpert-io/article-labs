+    const pista1 = informe.cuerpo.pistas[0];
+    assert.equal(pista1.reservas, 2);
+    assert.equal(pista1.ingresos, a.cuerpo.reserva.importe + b.cuerpo.reserva.importe);
+    assert.equal(pista1.penalizaciones, 0);
+    assert.equal(pista1.total, a.cuerpo.reserva.importe + b.cuerpo.reserva.importe);
+
+    const pista2 = informe.cuerpo.pistas[1];
+    assert.equal(pista2.reservas, 0);
+    assert.equal(pista2.ingresos, 0);
