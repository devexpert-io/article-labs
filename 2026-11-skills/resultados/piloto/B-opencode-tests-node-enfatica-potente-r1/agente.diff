+// La política de cancelación por tramos y el informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+test("C1 · la cancelación penaliza por tramos de antelación", async () => {
+  const api = await arrancarApi();
+  try {
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T09:00" } });
+
+    // 48 horas o más: sin penalización.
+    const lejos = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-001", pistaId: "pista-1", inicio: "2026-12-05T12:00" } });
+    assert.equal(lejos.status, 201);
+    const gratis = await api.pedir("POST", `/api/reservas/${lejos.cuerpo.reserva.id}/cancelar`);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, lejos.cuerpo.reserva.importe);
+
+    // Entre 24 y 48 horas: 25 % del importe.
+    const parcial = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-002", pistaId: "pista-1", inicio: "2026-12-02T12:00" } });
+    assert.equal(parcial.status, 201);
+    const conPenalizacion = await api.pedir("POST", `/api/reservas/${parcial.cuerpo.reserva.id}/cancelar`);
+    assert.equal(conPenalizacion.status, 200);
+    assert.equal(conPenalizacion.cuerpo.reserva.penalizacion, Math.round(parcial.cuerpo.reserva.importe * 0.25));
+
+    // Menos de 24 horas: 50 %, y solo con forzar.
+    const urgente = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-01T21:00" } });
+    assert.equal(urgente.status, 201);
+    const sinForzar = await api.pedir("POST", `/api/reservas/${urgente.cuerpo.reserva.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${urgente.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, Math.round(urgente.cuerpo.reserva.importe * 0.5));
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C2 · a 48 horas justas no hay penalización y a 24 horas justas se aplica el 25 %", async () => {
+  const api = await arrancarApi();
