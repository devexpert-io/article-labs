+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado, Factura } from "../src/tipos.ts";
+
+let api: Api;
+const gestor = "socio-040";
+beforeEach(async () => { api = await arrancarApi(); });
+afterEach(() => api.cerrar());
+
+async function generar(mes: unknown) {
+  return api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+}
+async function reloj(ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+async function reservar(socioId: string, inicio: string) {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-1", inicio } });
+  assert.equal(respuesta.status, 201, respuesta.texto);
+  return respuesta.cuerpo.reserva;
+}
+
+test("solo los gestores pueden generar, listar y obtener facturas", async () => {
+  for (const [metodo, ruta] of [["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F2026-0001"]]) {
+    for (const [socio, status, codigo] of [[undefined, 401, "NO_IDENTIFICADO"], ["socio-999", 401, "NO_IDENTIFICADO"], ["socio-001", 403, "SIN_PERMISO"]] as const) {
+      const r = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      assert.equal(r.status, status);
+      assert.equal(r.cuerpo.error.codigo, codigo);
+    }
+  }
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.deepEqual(estado.facturasPorMes, {});
+});
+
+test("valida el mes y solo genera meses terminados según el reloj del club", async () => {
+  for (const mes of [undefined, null, 202610, "", "2026-1", "26-10", "2026-00", "2026-13", "2026-10-01", " 2026-10"]) {
+    const r = await generar(mes);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const ruta of ["/api/facturas", "/api/facturas?mes=2026-13"]) {
+    const r = await api.pedir("GET", ruta, { socio: gestor });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj("2026-11-30T23:59");
+  assert.equal((await generar("2026-11")).status, 409);
+  await reloj("2026-12-01T00:00");
+  assert.equal((await generar("2026-11")).status, 201);
+});
+
+test("octubre: factura por socio, líneas por inicio, no presentadas, totales, consultas y repetición", async () => {
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const antes = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor });
+  assert.equal(antes.status, 200);
+  assert.deepEqual(antes.cuerpo, { facturas: [] });
+  const generada = await generar("2026-10");
+  assert.equal(generada.status, 201);
+  const facturas: Factura[] = generada.cuerpo.facturas;
+  const facturables = estado.reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(facturables.some((r) => r.estado === "no_presentada"));
+  const socios = [...new Set(facturables.map((r) => r.socioId))].sort();
+  assert.deepEqual(facturas.map((f) => f.socioId), socios);
+  assert.ok(!socios.includes("socio-041"));
+  for (const [i, f] of facturas.entries()) {
+    const reservas = facturables.filter((r) => r.socioId === f.socioId).sort((a, b) => a.inicio.localeCompare(b.inicio));
+    assert.deepEqual(f.lineas, reservas.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })));
+    assert.equal(f.mes, "2026-10");
+    assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.total, reservas.reduce((total, r) => total + r.importe, 0));
+    assert.equal(f.base, Math.round(f.total * 100 / 121));
+    assert.equal(f.iva, f.total - f.base);
+    const consulta = await api.pedir("GET", `/api/facturas/${f.numero}`, { socio: gestor });
+    assert.equal(consulta.status, 200);
+    assert.deepEqual(consulta.cuerpo, { factura: f });
+  }
+  const repetida = await generar("2026-10");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo, generada.cuerpo);
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).cuerpo, generada.cuerpo);
+  const inexistente = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: gestor });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.deepEqual(despues.reservas, estado.reservas);
+});
+
+test("IVA sobre el total: 1800 + 1800 + 2800 da base 5289 e IVA 1111", async () => {
+  // Se crean fuera del orden cronológico y se incluye el último día del mes.
+  const ultima = await reservar("socio-041", "2026-12-31T18:00");
+  const primera = await reservar("socio-041", "2026-12-01T09:00");
+  const segunda = await reservar("socio-041", "2026-12-02T09:00");
+  await reloj("2027-01-01T00:00");
+  const r = await generar("2026-12");
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.cuerpo.facturas, [{
+    numero: "F2026-0001", mes: "2026-12", socioId: "socio-041",
+    lineas: [primera, segunda, ultima].map((reserva) => ({ reservaId: reserva.id, concepto: "Reserva", importe: reserva.importe })),
+    total: 6400, base: 5289, iva: 1111,
+  }]);
+});
+
+test("cancelaciones: cobra Penalización y excluye cancelaciones gratuitas y otros meses", async () => {
+  const penalizada = await reservar("socio-041", "2026-12-01T09:00");
+  const gratis = await reservar("socio-041", "2026-12-02T09:00");
+  const soloGratis = await reservar("socio-001", "2026-12-03T09:00");
+  for (const r of [gratis, soloGratis]) {
+    const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+  }
+  await reloj("2026-11-30T10:00");
+  const cancelada = await api.pedir("POST", `/api/reservas/${penalizada.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1800);
+  await reservar("socio-041", "2027-01-01T09:00");
+  await reloj("2027-01-01T00:00");
+  const r = await generar("2026-12");
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.facturas.length, 1);
+  assert.equal(r.cuerpo.facturas[0].socioId, "socio-041");
+  assert.deepEqual(r.cuerpo.facturas[0].lineas, [{ reservaId: penalizada.id, concepto: "Penalización", importe: 1800 }]);
+});
+
+test("serie anual correlativa: meses fuera de orden, vacíos, repetidos y cambio de año", async () => {
+  // El socio mayor reserva primero: la asignación debe seguir el id de socio.
+  await reservar("socio-041", "2026-12-01T09:00");
+  await reservar("socio-001", "2026-12-02T09:00");
+  await reloj("2027-01-01T00:00");
+  const diciembre = await generar("2026-12");
+  assert.equal(diciembre.status, 201);
+  assert.deepEqual(diciembre.cuerpo.facturas.map((f: Factura) => [f.socioId, f.numero]), [
+    ["socio-001", "F2026-0001"], ["socio-041", "F2026-0002"],
+  ]);
+  const vacio = await generar("2026-09");
+  assert.equal(vacio.status, 201);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  assert.equal((await generar("2026-09")).status, 200);
+  assert.deepEqual((await generar("2026-12")).cuerpo, diciembre.cuerpo);
+  const octubre = await generar("2026-10");
+  assert.equal(octubre.cuerpo.facturas[0].numero, "F2026-0003");
+  const noviembre = await generar("2026-11");
+  const todas: Factura[] = [...diciembre.cuerpo.facturas, ...octubre.cuerpo.facturas, ...noviembre.cuerpo.facturas];
+  assert.deepEqual(todas.map((f) => f.numero), todas.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+  await reservar("socio-041", "2027-01-04T09:00");
+  await reloj("2027-02-01T00:00");
+  const enero = await generar("2027-01");
+  assert.equal(enero.status, 201);
+  assert.equal(enero.cuerpo.facturas[0].numero, "F2027-0001");
+  assert.equal((await generar("2026-12")).status, 200);
+  assert.deepEqual((await generar("2026-12")).cuerpo, diciembre.cuerpo);
+});
