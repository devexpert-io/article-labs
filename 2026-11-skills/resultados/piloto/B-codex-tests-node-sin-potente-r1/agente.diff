+test("caja incluye no presentadas, conserva el historial y devuelve ceros en un mes vacío", async () => {
+  const antes: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const octubre = antes.reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(octubre.some((r) => r.estado === "no_presentada"));
+  const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-040" });
+  assert.equal(informe.status, 200);
+  for (const p of informe.cuerpo.pistas) {
+    const reservas = octubre.filter((r) => r.pistaId === p.pistaId);
+    assert.equal(p.reservas, reservas.length);
+    assert.equal(p.ingresos, reservas.reduce((suma, r) => suma + r.importe, 0));
+    assert.equal(p.penalizaciones, 0);
+    assert.equal(p.total, p.ingresos);
+  }
+  assert.equal(informe.cuerpo.total.reservas, octubre.length);
+  assert.equal(informe.cuerpo.total.ingresos, octubre.reduce((suma, r) => suma + r.importe, 0));
+  const vacio = await api.pedir("GET", "/api/informes/caja?mes=2028-02", { socio: "socio-040" });
+  assert.equal(vacio.status, 200);
+  const ceros = { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 };
+  assert.deepEqual(vacio.cuerpo.total, ceros);
+  assert.deepEqual(vacio.cuerpo.pistas, antes.pistas.map((p) => ({ pistaId: p.id, ...ceros })));
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, antes.reservas);
+});
