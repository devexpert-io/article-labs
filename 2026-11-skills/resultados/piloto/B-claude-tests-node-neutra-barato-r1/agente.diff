+    const malo = await api.pedir("GET", ruta, { socio: GESTOR });
+    assert.equal(malo.status, 400, `mes ${mes}`);
+    assert.equal(malo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  const bien = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR });
+  assert.equal(bien.status, 200);
+  assert.equal(bien.cuerpo.mes, "2026-11");
+});
