+// Penalizaciones escalonadas, exención de la recepción e informe de caja (docs/specs/reembolsos.md).
+// Cada test arranca su propia API con su propio estado.
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-003";
+const MOTIVO = "Lesión con parte médico";
+
+/** Arranca una API con el reloj del club en `ahora` y la cierra al terminar el test. */
+async function escenario(t: TestContext, ahora: string): Promise<Api> {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(reloj.status, 200);
+  return api;
+}
+
+async function reservar(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva as { id: string; importe: number };
+}
+
+async function cancelar(api: Api, id: string, cuerpo?: object, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+async function ponerReloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+// ---- C1 · Tramos ----
+
+test("C1 · con 48 horas o más de antelación no hay penalización y el reembolso es el importe entero", async (t) => {
+  const api = await escenario(t, "2026-11-18T10:00");
+  const r = await reservar(api, SOCIO, "pista-3", "2026-11-21T09:00"); // 71 horas antes, sábado: punta, 2000
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.estado, "cancelada");
+  assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(c.cuerpo.reembolso, 2000);
+});
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 % del importe", async (t) => {
+  const api = await escenario(t, "2026-11-19T10:00");
+  const r = await reservar(api, SOCIO, "pista-3", "2026-11-21T09:00"); // 47 horas antes
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.penalizacion, 500);
+  assert.equal(c.cuerpo.reembolso, 1500);
+});
+
+test("C1 · a menos de 24 horas, sin forzar, responde 409 FUERA_DE_PLAZO y la reserva sigue confirmada", async (t) => {
+  const api = await escenario(t, "2026-11-20T09:30");
+  const r = await reservar(api, SOCIO, "pista-3", "2026-11-21T09:00"); // 23 horas y media antes
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 409);
+  assert.equal(c.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  assert.equal((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva.estado, "confirmada");
+});
+
+test("C1 · a menos de 24 horas, con forzar, la penalización es el 50 % del importe", async (t) => {
+  const api = await escenario(t, "2026-11-20T09:30");
+  const r = await reservar(api, SOCIO, "pista-3", "2026-11-21T09:00");
+  const c = await cancelar(api, r.id, { forzar: true });
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.penalizacion, 1000);
+  assert.equal(c.cuerpo.reembolso, 1000);
+});
+
+// ---- C2 · Límites exactos ----
