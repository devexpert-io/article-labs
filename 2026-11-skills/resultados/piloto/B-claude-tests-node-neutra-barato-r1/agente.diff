+test("C7 · el total de noviembre de la semilla cuadra con sus reservas", async (t) => {
+  const api = await escenario(t, "2026-11-18T10:00");
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const delMes = estado.reservas.filter((r: { inicio: string }) => r.inicio.startsWith("2026-11-"));
+  const cobradas = delMes.filter((r: { estado: string }) => r.estado === "confirmada" || r.estado === "no_presentada");
+  const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR });
+  assert.equal(informe.cuerpo.total.reservas, cobradas.length);
+  assert.equal(informe.cuerpo.total.ingresos, cobradas.reduce((s: number, r: { importe: number }) => s + r.importe, 0));
+  for (const p of informe.cuerpo.pistas) {
+    const de = cobradas.filter((r: { pistaId: string }) => r.pistaId === p.pistaId);
+    assert.equal(p.reservas, de.length, p.pistaId);
+    assert.equal(p.ingresos, de.reduce((s: number, r: { importe: number }) => s + r.importe, 0), p.pistaId);
+  }
+  assert.equal(informe.cuerpo.total.total, informe.cuerpo.total.ingresos + informe.cuerpo.total.penalizaciones);
+});
