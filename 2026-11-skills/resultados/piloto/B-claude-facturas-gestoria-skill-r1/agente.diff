+test("consultar facturas por mes y por número", async () => {
+  const lista = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(lista.status, 200);
+  assert.deepEqual(lista.cuerpo.facturas, octubre);
