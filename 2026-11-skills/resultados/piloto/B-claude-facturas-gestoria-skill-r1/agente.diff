index 0000000..da693b4
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,157 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const generar = (mes: unknown, socio: string | undefined = GESTOR) => api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio });
+const reloj = (ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+
+// Los tests de este fichero comparten la API y van en orden: preparan noviembre y diciembre, generan los meses y comprueban la numeración.
+
+test("permisos: solo un gestor genera y consulta facturas", async () => {
+  for (const [metodo, ruta] of [["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F2026-0001"]] as const) {
+    const sin = await api.pedir(metodo, ruta, { cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+    assert.equal(sin.status, 401, `${metodo} ${ruta} sin X-Socio`);
+    assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined, socio: "socio-001" });
+    assert.equal(socio.status, 403, `${metodo} ${ruta} con un socio`);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo, { facturas: [] }, "nada generado todavía");
+});
+
+test("mes: formato AAAA-MM y solo meses cerrados", async () => {
+  for (const mes of [undefined, "2026-13", "2026-1", "2026-10-01", 202610]) {
+    const r = await generar(mes);
+    assert.equal(r.status, 400, `mes ${mes}`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=octubre", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12"]) {
+    const r = await generar(mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+});
+
+test("preparar noviembre y diciembre: una penalización, una cancelación gratis y tres reservas de Nora", async () => {
+  // Marta cancela fuera de plazo su reserva del 19 de noviembre: penalización de 1.200.
+  assert.equal((await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } })).cuerpo.reserva.penalizacion, 1200);
+  // Nora reserva en noviembre y cancela gratis: no se le factura nada.
+  const gratis = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-24T12:00" } });
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratis.cuerpo.reserva.id}/cancelar`)).cuerpo.reserva.penalizacion, undefined);
+  // Nora en diciembre: 1.800 + 1.800 + 2.800 = 6.400.
+  for (const inicio of ["2026-12-05T10:30", "2026-12-01T09:00", "2026-12-02T09:00"]) {
+    assert.equal((await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio } })).status, 201);
+  }
+});
+
+let octubre: any[];
+
+test("octubre: una factura por socio con algo que facturar, con sus líneas, total, base e IVA", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const r = await generar("2026-10");
+  assert.equal(r.status, 201);
+  octubre = r.cuerpo.facturas;
+
+  // Lo esperado, a partir de las reservas de la semilla.
+  const reservas = estado.reservas.filter((x: any) => x.inicio.startsWith("2026-10") && x.estado !== "cancelada");
+  const socios = [...new Set(reservas.map((x: any) => x.socioId))].sort();
+  assert.deepEqual(octubre.map((f) => f.socioId), socios, "ordenadas por id de socio, solo socios con algo que facturar");
+  assert.ok(!socios.includes("socio-041"));
+  octubre.forEach((f, i) => {
+    assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.mes, "2026-10");
+    const suyas = reservas.filter((x: any) => x.socioId === f.socioId).sort((a: any, b: any) => a.inicio.localeCompare(b.inicio));
+    assert.deepEqual(f.lineas, suyas.map((x: any) => ({ reservaId: x.id, concepto: "Reserva", importe: x.importe })));
+    assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+    assert.equal(f.base, Math.round((f.total * 100) / 121));
+    assert.equal(f.base + f.iva, f.total);
+  });
+  // Las canceladas de la semilla no tienen penalización y no entran; las no presentadas sí.
+  const facturadas = new Set(octubre.flatMap((f) => f.lineas.map((l: any) => l.reservaId)));
+  for (const x of estado.reservas.filter((x: any) => x.inicio.startsWith("2026-10"))) {
+    assert.equal(facturadas.has(x.id), x.estado !== "cancelada", `${x.id} (${x.estado})`);
+  }
+  assert.ok(estado.reservas.some((x: any) => x.inicio.startsWith("2026-10") && x.estado === "no_presentada"));
+
+  const ana = octubre.find((f) => f.socioId === "socio-001");
+  assert.deepEqual(ana, {
+    numero: "F2026-0001", mes: "2026-10", socioId: "socio-001",
+    lineas: [
+      { reservaId: "R-0120", concepto: "Reserva", importe: 1800 },
+      { reservaId: "R-0172", concepto: "Reserva", importe: 2800 },
+      { reservaId: "R-0193", concepto: "Reserva", importe: 2200 },
+    ],
+    total: 6800, base: 5620, iva: 1180,
+  });
+});
+
+test("generar otra vez un mes devuelve las mismas facturas y no crea ninguna", async () => {
+  const otra = await generar("2026-10");
+  assert.equal(otra.status, 200);
+  assert.deepEqual(otra.cuerpo.facturas, octubre);
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, octubre.length);
+});
+
+test("diciembre generado en enero, antes que noviembre: sigue la serie de 2026 y redondea el IVA sobre el total", async () => {
+  await reloj("2027-01-10T10:00");
+  // Nora reserva para enero de 2027, que se factura más tarde.
+  assert.equal((await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2027-01-12T09:00" } })).status, 201);
+  const r = await generar("2026-12");
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.facturas.length, 1);
+  const [nora] = r.cuerpo.facturas;
+  assert.equal(nora.numero, `F2026-${String(octubre.length + 1).padStart(4, "0")}`);
+  assert.equal(nora.socioId, "socio-041");
+  assert.deepEqual(nora.lineas.map((l: any) => [l.concepto, l.importe]), [["Reserva", 1800], ["Reserva", 1800], ["Reserva", 2800]]);
+  // Línea a línea saldría 5.290; sobre el total, 5.289.
+  assert.deepEqual([nora.total, nora.base, nora.iva], [6400, 5289, 1111]);
+});
+
+test("noviembre: la penalización entra con su concepto, la cancelación gratis no, y la numeración continúa", async () => {
+  const r = await generar("2026-11");
+  assert.equal(r.status, 201);
+  const facturas = r.cuerpo.facturas;
+  facturas.forEach((f: any, i: number) => assert.equal(f.numero, `F2026-${String(octubre.length + 2 + i).padStart(4, "0")}`));
+  assert.deepEqual(facturas.map((f: any) => f.socioId), facturas.map((f: any) => f.socioId).sort());
+  const marta = facturas.find((f: any) => f.socioId === "socio-002");
+  assert.deepEqual(marta.lineas.find((l: any) => l.reservaId === "R-0520"), { reservaId: "R-0520", concepto: "Penalización", importe: 1200 });
+  assert.ok(!facturas.some((f: any) => f.socioId === "socio-041"), "Nora solo canceló gratis en noviembre");
+  // Las reservas posteriores al 18 de noviembre que siguen confirmadas también se facturan.
+  assert.ok(facturas.some((f: any) => f.lineas.some((l: any) => l.reservaId === "R-0519")));
+});
+
+test("un mes sin facturas no gasta números, y cada año empieza en 0001", async () => {
+  const vacio = await generar("2026-09");
+  assert.equal(vacio.status, 201);
