+/** Líneas facturables de un socio en un mes, según las reglas de la gestoría. */
+function lineasFacturables(estado: Estado, socioId: string, mes: string): LineaFactura[] {
+  return estado.reservas
+    .filter((r) => r.socioId === socioId && r.inicio.slice(0, 7) === mes)
+    .filter((r) =>
+      r.estado === "confirmada" || r.estado === "no_presentada" ||
+      (r.estado === "cancelada" && (r.penalizacion ?? 0) > 0))
+    .sort((a, b) => (a.inicio === b.inicio ? a.id.localeCompare(b.id) : a.inicio.localeCompare(b.inicio)))
+    .map((r) => ({
+      reservaId: r.id,
+      concepto: r.estado === "cancelada" ? "Penalización" : "Reserva",
+      importe: r.estado === "cancelada" ? (r.penalizacion ?? 0) : r.importe,
+    }));
+}
+
+/** La base se calcula sobre el total de la factura (no línea a línea), y el IVA es total − base. */
+function construirFactura(estado: Estado, socioId: string, mes: string, numero: string): Factura {
+  const lineas = lineasFacturables(estado, socioId, mes);
+  const total = lineas.reduce((suma, linea) => suma + linea.importe, 0);
+  const base = Math.round((total * 100) / 121);
+  return { numero, mes, socioId, lineas, total, base, iva: total - base };
+}
