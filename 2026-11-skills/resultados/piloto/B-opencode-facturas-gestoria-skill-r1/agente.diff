@@ -0,0 +1,171 @@
+// Facturación mensual de la gestoría, probada a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+/** Arranca una API nueva para cada prueba y la cierra al terminar. */
+async function conApi(fn: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("permisos y validación de facturas", () => conApi(async (api) => {
+  const sin = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+  assert.equal(sin.status, 401);
+  assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const noGestor = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" })).status, 403);
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10")).status, 401);
+  assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001", { socio: "socio-001" })).status, 403);
+  assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001")).status, 401);
+
+  const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+  assert.equal(abierto.status, 409);
+  assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+
+  const mal = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "noviembre" }, socio: GESTOR });
+  assert.equal(mal.status, 400);
+  assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const vacia = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(vacia.status, 200);
+  assert.deepEqual(vacia.cuerpo.facturas, []);
+
+  const inexistente = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: GESTOR });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+}));
+
+test("octubre: una factura por socio, líneas ordenadas, total e IVA y numeración correlativa", () => conApi(async (api) => {
+  const primera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(primera.status, 201);
+  const facturas = primera.cuerpo.facturas as any[];
+  assert.ok(facturas.length > 0);
+
+  const ids = facturas.map((f) => f.socioId);
+  assert.deepEqual(ids, [...ids].sort((a, b) => a.localeCompare(b)), "las facturas van ordenadas por id de socio");
+
+  facturas.forEach((f, i) => {
+    assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`, "numeración correlativa por orden de socio");
+  });
+
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const inicioDe = new Map<string, string>(estado.reservas.map((r: any) => [r.id, r.inicio]));
+  const sociosCon = new Set<string>();
+  for (const r of estado.reservas) {
+    if (r.inicio.slice(0, 7) !== "2026-10") continue;
+    if (r.estado === "confirmada" || r.estado === "no_presentada" || (r.estado === "cancelada" && (r.penalizacion ?? 0) > 0)) {
+      sociosCon.add(r.socioId);
+    }
+  }
+  assert.deepEqual(ids, [...sociosCon].sort((a, b) => a.localeCompare(b)), "una factura por cada socio con algo que facturar");
+
+  for (const f of facturas) {
+    const suma = f.lineas.reduce((s: number, l: any) => s + l.importe, 0);
+    assert.equal(f.total, suma);
+    assert.equal(f.base, Math.round((f.total * 100) / 121));
+    assert.equal(f.base + f.iva, f.total);
+    const inicios = f.lineas.map((l: any) => inicioDe.get(l.reservaId));
+    assert.deepEqual(inicios, [...inicios].sort(), "las líneas van ordenadas por el inicio de la reserva");
+    for (const l of f.lineas) assert.ok(["Reserva", "Penalización"].includes(l.concepto));
+  }
+
+  const segunda = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(segunda.status, 200);
+  assert.deepEqual(segunda.cuerpo.facturas, facturas, "volver a generar devuelve las mismas facturas");
+
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas, facturas);
+  assert.deepEqual((await api.pedir("GET", `/api/facturas/${facturas[0].numero}`, { socio: GESTOR })).cuerpo.factura, facturas[0]);
+}));
+
+test("el IVA se calcula sobre el total: 6.400 céntimos dan base 5.289 e IVA 1.111", () => conApi(async (api) => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T10:00" } });
+  for (const inicio of ["2026-12-08T09:00", "2026-12-09T09:00", "2026-12-12T09:00"]) {
+    const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-004", pistaId: "pista-1", inicio } });
+    assert.equal(creada.status, 201);
+  }
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-05T10:00" } });
+  const generadas = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+  assert.equal(generadas.status, 201);
+
+  const factura = generadas.cuerpo.facturas.find((f: any) => f.socioId === "socio-004");
+  assert.ok(factura);
+  assert.equal(factura.total, 6400);
+  assert.equal(factura.base, 5289);
+  assert.equal(factura.iva, 1111);
+  // El año de la numeración es el del mes facturado (2026), no el de generación (2027).
+  assert.equal(factura.numero, "F2026-0001");
+}));
+
+test("una cancelación con penalización entra como Penalización y una gratuita no entra", () => conApi(async (api) => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T10:00" } });
+
+  const fuera = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-002", pistaId: "pista-1", inicio: "2026-12-01T12:00" } });
+  const cancelada = await api.pedir("POST", `/api/reservas/${fuera.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1800);
+
+  const gratis = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-2", inicio: "2026-12-10T09:00" } });
+  const gratisCancelada = await api.pedir("POST", `/api/reservas/${gratis.cuerpo.reserva.id}/cancelar`);
+  assert.equal(gratisCancelada.cuerpo.reserva.penalizacion, undefined);
+
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-05T10:00" } });
+  const generadas = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+
+  assert.equal(generadas.cuerpo.facturas.length, 1);
+  const de002 = generadas.cuerpo.facturas[0];
+  assert.equal(de002.socioId, "socio-002");
+  assert.equal(de002.lineas.length, 1);
+  assert.equal(de002.lineas[0].concepto, "Penalización");
+  assert.equal(de002.lineas[0].importe, 1800);
+}));
+
+test("un mes sin facturas no gasta números", () => conApi(async (api) => {
+  const septiembre = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-09" }, socio: GESTOR });
+  assert.equal(septiembre.status, 201);
+  assert.deepEqual(septiembre.cuerpo.facturas, []);
+
+  const repetido = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-09" }, socio: GESTOR });
+  assert.equal(repetido.status, 200);
+  assert.deepEqual(repetido.cuerpo.facturas, []);
+
+  const octubre = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(octubre.cuerpo.facturas[0].numero, "F2026-0001");
+}));
+
+test("numeración correlativa sin huecos, incluso generando meses fuera de orden", () => conApi(async (api) => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-05T10:00" } });
+
+  const noviembre = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+  assert.equal(noviembre.cuerpo.facturas[0].numero, "F2026-0001");
+  const nNoviembre = noviembre.cuerpo.facturas.length;
+
