+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import type { Reserva } from "../src/tipos.ts";
+
+let api: Api;
+beforeEach(async () => { api = await arrancarApi(); });
+afterEach(() => api.cerrar());
+
+function error(respuesta: Respuesta, http: number, codigo: string) {
+  assert.equal(respuesta.status, http);
+  assert.equal(respuesta.cuerpo.error.codigo, codigo);
+  assert.equal(typeof respuesta.cuerpo.error.mensaje, "string");
+}
+
+async function reloj(ahora: string) {
+  const respuesta = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { ahora });
+}
+
+async function crear(inicio = "2027-01-15T12:00", pistaId = "pista-3") {
+  const respuesta = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio },
+  });
+  assert.equal(respuesta.status, 201);
+  return respuesta.cuerpo.reserva as Reserva;
+}
+
+function cancelar(r: Reserva, cuerpo = {}, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo, socio });
+}
+
+for (const [ahora, penalizacion] of [
+  ["2027-01-13T11:59", 0],
+  ["2027-01-13T12:01", 300],
+  ["2027-01-14T11:59", 300],
+  ["2027-01-14T12:01", 600],
+] as const) {
+  test(`C1 · tramos de cancelación desde ${ahora}`, async () => {
+    const r = await crear();
+    await reloj(ahora);
+    if (penalizacion === 600) {
+      error(await cancelar(r), 409, "FUERA_DE_PLAZO");
+      const intacta = await api.pedir("GET", `/api/reservas/${r.id}`);
+      assert.equal(intacta.status, 200);
+      assert.deepEqual(intacta.cuerpo, { reserva: r });
+    }
+    const respuesta = await cancelar(r, { forzar: penalizacion === 600 });
+    assert.equal(respuesta.status, 200);
+    assert.deepEqual(respuesta.cuerpo, {
+      reserva: { ...r, estado: "cancelada", penalizacion }, reembolso: r.importe - penalizacion,
+    });
+  });
+}
+
+for (const [ahora, penalizacion] of [["2027-01-13T12:00", 0], ["2027-01-14T12:00", 300]] as const) {
+  test(`C2 · límite exacto desde ${ahora}`, async () => {
+    const r = await crear();
+    await reloj(ahora);
+    const respuesta = await cancelar(r);
+    assert.equal(respuesta.status, 200);
+    assert.deepEqual(respuesta.cuerpo, {
+      reserva: { ...r, estado: "cancelada", penalizacion }, reembolso: r.importe - penalizacion,
+    });
+  });
+}
+
+for (const [inicio, ahora, penalizacion] of [
+  ["2027-03-28T21:00", "2027-03-26T20:30", 500],
+  ["2027-03-28T21:00", "2027-03-27T20:30", 1000],
+  ["2027-10-31T21:00", "2027-10-29T21:30", 0],
+  ["2027-10-31T21:00", "2027-10-30T21:30", 500],
+] as const) {
+  test(`C3 · horas reales de Madrid entre ${ahora} y ${inicio}`, async () => {
+    const r = await crear(inicio);
+    await reloj(ahora);
+    if (penalizacion === 1000) error(await cancelar(r), 409, "FUERA_DE_PLAZO");
+    const respuesta = await cancelar(r, { forzar: penalizacion === 1000 });
+    assert.equal(respuesta.status, 200);
+    assert.deepEqual(respuesta.cuerpo, {
+      reserva: { ...r, estado: "cancelada", penalizacion }, reembolso: r.importe - penalizacion,
+    });
+  });
+}
+
+test("C4 · el reembolso devuelve el importe entero cuando no hay penalización", async () => {
+  const r = await crear();
+  const respuesta = await cancelar(r);
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, {
+    reserva: { ...r, estado: "cancelada", penalizacion: 0 }, reembolso: 1200,
+  });
+});
+
+test("C5 · solo un gestor puede eximir con motivo suficiente, sin forzar", async () => {
