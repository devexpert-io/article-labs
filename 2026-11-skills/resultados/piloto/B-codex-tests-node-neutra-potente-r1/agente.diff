+
+for (const ahora of ["2027-01-15T12:00", "2027-01-15T12:01"]) {
+  test(`C6 · no cancela reservas empezadas, tampoco con exención, a ${ahora}`, async () => {
+    const r = await crear();
+    await reloj(ahora);
+    error(await cancelar(r, { forzar: true }), 409, "RESERVA_PASADA");
+    error(await cancelar(r, { exento: true, motivo: "Motivo suficiente" }, "socio-040"), 409, "RESERVA_PASADA");
+    const respuesta = await api.pedir("GET", `/api/reservas/${r.id}`);
+    assert.equal(respuesta.status, 200);
+    assert.deepEqual(respuesta.cuerpo, { reserva: r });
+  });
+}
+
+test("C7 · informe exclusivo para gestores y validación del mes", async () => {
+  error(await api.pedir("GET", "/api/informes/caja?mes=2026-11"), 401, "NO_IDENTIFICADO");
+  error(await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-041" }), 403, "SIN_PERMISO");
+  for (const mes of ["", "2026-1", "2026-00", "2026-13", "2026-11-01", "abcd-ef"]) {
+    error(await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: "socio-040" }), 400, "DATOS_INVALIDOS");
+  }
+  error(await api.pedir("GET", "/api/informes/caja", { socio: "socio-040" }), 400, "DATOS_INVALIDOS");
