+test("C8 · mantiene creación y reservas ya canceladas sin recalcular penalizaciones", async () => {
+  const antes = await api.pedir("GET", "/_estado");
+  assert.equal(antes.status, 200);
+  const historicas = antes.cuerpo.reservas.filter((r: Reserva) => r.estado === "cancelada");
+  const r = await crear();
+  assert.equal(r.importe, 1200);
+  assert.equal(r.estado, "confirmada");
+  await reloj("2027-01-14T13:00");
+  const primera = await cancelar(r, { forzar: true });
+  assert.equal(primera.status, 200);
+  assert.equal(primera.cuerpo.reserva.penalizacion, 600);
+  await reloj("2027-01-10T12:00");
+  error(await cancelar(r, { exento: true, motivo: "Exención posterior" }, "socio-040"), 409, "YA_CANCELADA");
+  const conservada = await api.pedir("GET", `/api/reservas/${r.id}`);
+  assert.equal(conservada.status, 200);
+  assert.deepEqual(conservada.cuerpo, { reserva: primera.cuerpo.reserva });
+  error(await cancelar(historicas[0]), 409, "YA_CANCELADA");
+  const despues = await api.pedir("GET", "/_estado");
+  assert.equal(despues.status, 200);
+  assert.deepEqual(despues.cuerpo.reservas.filter((r: Reserva) => historicas.some((h: Reserva) => h.id === r.id)), historicas);
+});
