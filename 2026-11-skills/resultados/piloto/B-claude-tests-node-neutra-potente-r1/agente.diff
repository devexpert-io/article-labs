+test("C7 · el informe cuenta las confirmadas y las no presentadas del historial", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const octubre = estado.reservas.filter((x: any) => x.inicio.startsWith("2026-10-"));
+  const cobradas = octubre.filter((x: any) => x.estado !== "cancelada");
+  assert.ok(octubre.some((x: any) => x.estado === "no_presentada"), "la semilla trae no presentadas en octubre");
+  const r = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.total.reservas, cobradas.length);
+  assert.equal(r.cuerpo.total.ingresos, cobradas.reduce((s: number, x: any) => s + x.importe, 0));
+  assert.equal(r.cuerpo.total.penalizaciones, 0);
+  assert.equal(r.cuerpo.total.total, r.cuerpo.total.ingresos);
+  const pista4 = cobradas.filter((x: any) => x.pistaId === "pista-4");
+  assert.deepEqual(r.cuerpo.pistas[3], {
+    pistaId: "pista-4",
+    reservas: pista4.length,
+    ingresos: pista4.reduce((s: number, x: any) => s + x.importe, 0),
+    penalizaciones: 0,
+    total: pista4.reduce((s: number, x: any) => s + x.importe, 0),
+  });
+});
