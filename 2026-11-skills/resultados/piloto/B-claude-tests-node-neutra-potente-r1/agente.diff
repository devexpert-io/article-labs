+// Spec docs/specs/reembolsos.md: penalizaciones escalonadas, exención y el informe de caja.
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+let api: Api;
+beforeEach(async () => {
+  api = await arrancarApi();
+});
+afterEach(() => api.cerrar());
+
+async function reloj(ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+/** Crea una reserva con el reloj en `creadaEn` y deja el reloj en `ahora`. Devuelve su id. */
+async function reservar(inicio: string, ahora: string, pistaId = "pista-2", socioId = "socio-003", creadaEn = "2026-11-18T10:00") {
+  await reloj(creadaEn);
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  await reloj(ahora);
+  return r.cuerpo.reserva.id as string;
+}
+
+function cancelar(id: string, cuerpo: unknown = {}, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+// Miércoles 25 de noviembre de 2026 a las 12:00 en la pista 2: hora valle, 1800 céntimos.
+const INICIO = "2026-11-25T12:00";
+
+test("C1 · con 48 horas o más de antelación no hay penalización", async () => {
+  const id = await reservar(INICIO, "2026-11-23T11:00");
+  const r = await cancelar(id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 1800);
+});
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 %", async () => {
+  const id = await reservar(INICIO, "2026-11-24T06:00");
+  const r = await cancelar(id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 450);
+  assert.equal(r.cuerpo.reembolso, 1350);
+});
+
+test("C1 · con menos de 24 horas hace falta forzar y la penalización es el 50 %", async () => {
+  const id = await reservar(INICIO, "2026-11-25T09:00");
+  const sin = await cancelar(id);
+  assert.equal(sin.status, 409);
+  assert.equal(sin.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const noForzada = await cancelar(id, { forzar: false });
+  assert.equal(noForzada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  assert.equal((await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva.estado, "confirmada");
+  const forzada = await cancelar(id, { forzar: true });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+  assert.equal(forzada.cuerpo.reembolso, 900);
+});
+
+test("C2 · a 48 horas justas no hay penalización", async () => {
+  const id = await reservar(INICIO, "2026-11-23T12:00");
+  const r = await cancelar(id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 1800);
+});
+
+test("C2 · un minuto por debajo de 48 horas ya se aplica el 25 %", async () => {
+  const id = await reservar(INICIO, "2026-11-23T12:01");
+  const r = await cancelar(id);
+  assert.equal(r.cuerpo.reserva.penalizacion, 450);
+});
+
+test("C2 · a 24 horas justas se aplica el 25 % sin forzar", async () => {
+  const id = await reservar(INICIO, "2026-11-24T12:00");
+  const r = await cancelar(id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 450);
+  assert.equal(r.cuerpo.reembolso, 1350);
+});
+
+test("C2 · un minuto por debajo de 24 horas ya hace falta forzar", async () => {
+  const id = await reservar(INICIO, "2026-11-24T12:01");
+  const r = await cancelar(id);
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+});
+
+// Domingo 28 de marzo de 2027 a las 21:00 en la pista 2: punta, 2800 céntimos. Esa madrugada se adelanta la hora.
+const INICIO_MARZO = "2027-03-28T21:00";
+
+test("C3 · del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas: 25 %", async () => {
+  const id = await reservar(INICIO_MARZO, "2027-03-26T20:30");
+  const r = await cancelar(id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 700);
+  assert.equal(r.cuerpo.reembolso, 2100);
+});
+
+test("C3 · con el adelanto de marzo, 49 horas de reloj son 48 reales: sin penalización", async () => {
+  const id = await reservar(INICIO_MARZO, "2027-03-26T20:00");
+  const r = await cancelar(id);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 2800);
+});
+
+test("C3 · con el retraso de octubre, 47,5 horas de reloj son 48,5 reales: sin penalización", async () => {
+  // Domingo 31 de octubre de 2027: esa madrugada se retrasa la hora.
+  const id = await reservar("2027-10-31T21:00", "2027-10-29T21:30");
+  const r = await cancelar(id);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 2800);
+});
+
+test("C3 · con el retraso de octubre, 23,5 horas de reloj son 24,5 reales: 25 % sin forzar", async () => {
+  const id = await reservar("2027-10-31T21:00", "2027-10-30T21:30");
+  const r = await cancelar(id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 700);
+});
+
+test("C4 · el reembolso es el importe menos la penalización, o el importe entero sin penalización", async () => {
+  const gratis = await reservar("2026-11-25T19:30", "2026-11-18T10:00", "pista-1", "socio-006");
+  const r1 = await cancelar(gratis);
+  assert.equal(r1.cuerpo.reembolso, r1.cuerpo.reserva.importe);
+  assert.equal(r1.cuerpo.reembolso, 2800);
+  const conTramo = await reservar("2026-11-25T19:30", "2026-11-25T08:00", "pista-3", "socio-007");
