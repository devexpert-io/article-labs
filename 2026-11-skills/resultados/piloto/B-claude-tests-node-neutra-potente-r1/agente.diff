+/** Último domingo de un mes (0 = enero), como día del mes. */
+function ultimoDomingo(anio: number, mes: number): number {
+  const ultimo = new Date(Date.UTC(anio, mes + 1, 0));
+  return ultimo.getUTCDate() - ultimo.getUTCDay();
+}
+
+/**
+ * Instante real (milisegundos UTC) de una hora local de Madrid. Horario de verano europeo:
+ * desde el último domingo de marzo a la 01:00 UTC hasta el último domingo de octubre a la 01:00 UTC.
+ */
+function instanteEnMadrid(local: string): number {
+  const comoUtc = Date.parse(`${local}:00Z`);
+  const anio = Number(local.slice(0, 4));
+  const inicioVerano = Date.UTC(anio, 2, ultimoDomingo(anio, 2), 1);
+  const finVerano = Date.UTC(anio, 9, ultimoDomingo(anio, 9), 1);
+  // Se prueba primero con la hora de verano (UTC+2) y, si no cae dentro, es la de invierno (UTC+1).
+  const enVerano = comoUtc - 2 * 3_600_000;
+  if (enVerano >= inicioVerano && enVerano < finVerano) return enVerano;
+  return comoUtc - 3_600_000;
+}
+
+/** Horas reales entre dos horas locales de Madrid, contando el cambio de hora. */
+export function horasEntre(desde: string, hasta: string): number {
+  return (instanteEnMadrid(hasta) - instanteEnMadrid(desde)) / 3_600_000;
+}
+
+function porcentaje(importe: number, tanto: number): number {
+  return Math.round((importe * tanto) / 100);
