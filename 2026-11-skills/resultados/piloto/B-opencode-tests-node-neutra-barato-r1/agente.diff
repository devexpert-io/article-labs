+test("C7 · el informe trae todas las pistas y suma reservas, ingresos y penalizaciones", async () => {
+  await conApi({ AHORA: "2026-12-01T10:00" }, async (api) => {
+    // Una reserva confirmada que empieza en diciembre: cuenta como ingreso.
+    const confirmada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-10T12:00" },
+    });
+    assert.equal(confirmada.status, 201);
+    assert.equal(confirmada.cuerpo.reserva.importe, 1800);
+
+    // Otra que se cancela fuera de plazo: cuenta su penalización del 50 %.
+    const cancelable = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-12-15T12:00" },
+    });
+    assert.equal(cancelable.status, 201);
+    assert.equal(cancelable.cuerpo.reserva.importe, 1200);
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-15T00:00" } })).status, 200);
+    const cancelada = await api.pedir("POST", `/api/reservas/${cancelable.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 600);
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: GESTOR });
+    assert.equal(informe.status, 200);
+    assert.equal(informe.cuerpo.mes, "2026-12");
+    assert.deepEqual(informe.cuerpo.pistas.map((p: { pistaId: string }) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+    const porPista = Object.fromEntries(informe.cuerpo.pistas.map((p: any) => [p.pistaId, p]));
+    assert.deepEqual(porPista["pista-1"], { pistaId: "pista-1", reservas: 1, ingresos: 1800, penalizaciones: 0, total: 1800 });
+    assert.deepEqual(porPista["pista-2"], { pistaId: "pista-2", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+    assert.deepEqual(porPista["pista-3"], { pistaId: "pista-3", reservas: 0, ingresos: 0, penalizaciones: 600, total: 600 });
+    assert.deepEqual(porPista["pista-4"], { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+    assert.deepEqual(informe.cuerpo.total, { reservas: 1, ingresos: 1800, penalizaciones: 600, total: 2400 });
+  });
+});
