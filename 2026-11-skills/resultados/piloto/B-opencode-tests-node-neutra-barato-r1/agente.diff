@@ -0,0 +1,225 @@
+// Penalizaciones escalonadas, exención de gestor e informe de caja (spec `reembolsos`).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const MOTIVO = "Aviso de lesión del jugador";
+
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("C1 · con 48 horas o más de antelación no hay penalización", async () => {
+  await conApi({}, async (api) => {
+    // R-0490 empieza el 20 a las 12:00: 50 horas desde el miércoles a las 10:00.
+    const r = await api.pedir("POST", "/api/reservas/R-0490/cancelar");
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.estado, "cancelada");
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(r.cuerpo.reembolso, r.cuerpo.reserva.importe);
+  });
+});
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 %", async () => {
+  await conApi({}, async (api) => {
+    // R-0524 empieza el 19 a las 10:30: 24,5 horas desde el miércoles a las 10:00.
+    const r = await api.pedir("POST", "/api/reservas/R-0524/cancelar");
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 450);
+    assert.equal(r.cuerpo.reembolso, 1350);
+  });
+});
+
+test("C1 · con menos de 24 horas solo se cancela con forzar y la penalización es el 50 %", async () => {
+  await conApi({}, async (api) => {
+    const fuera = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(fuera.status, 409);
+    assert.equal(fuera.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const sigue = await api.pedir("GET", "/api/reservas/R-0520");
+    assert.equal(sigue.cuerpo.reserva.estado, "confirmada");
+
+    const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+    assert.equal(forzada.cuerpo.reembolso, 600);
+  });
+});
+
+test("C2 · a 48 horas justas no hay penalización", async () => {
+  await conApi({}, async (api) => {
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-17T09:00" } })).status, 200);
+    // R-0520 empieza el 19 a las 09:00: exactamente 48 horas.
+    const r = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(r.cuerpo.reembolso, 1200);
+  });
+});
+
+test("C2 · a 24 horas justas se aplica el 25 % y no hace falta forzar", async () => {
+  await conApi({}, async (api) => {
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T09:00" } })).status, 200);
+    // R-0520 empieza el 19 a las 09:00: exactamente 24 horas.
+    const r = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 300);
+    assert.equal(r.cuerpo.reembolso, 900);
+  });
+});
+
+test("C3 · el cambio de hora se cuenta en horas reales de Madrid", async () => {
+  await conApi({ AHORA: "2027-03-26T20:30" }, async (api) => {
+    // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales,
+    // aunque en hora de reloj parezcan 48,5. Por tanto, tramo del 25 %.
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-003", pistaId: "pista-2", inicio: "2027-03-28T21:00" },
+    });
+    assert.equal(creada.status, 201);
+    assert.equal(creada.cuerpo.reserva.importe, 2800);
+    const r = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 700);
+    assert.equal(r.cuerpo.reembolso, 2100);
+  });
+});
+
+test("C4 · la respuesta de cancelar incluye reembolso = importe - penalización", async () => {
+  await conApi({}, async (api) => {
+    const conPenalizacion = await api.pedir("POST", "/api/reservas/R-0524/cancelar");
+    assert.equal(conPenalizacion.cuerpo.reembolso, conPenalizacion.cuerpo.reserva.importe - conPenalizacion.cuerpo.reserva.penalizacion);
+
+    const sinPenalizacion = await api.pedir("POST", "/api/reservas/R-0490/cancelar");
+    assert.equal(sinPenalizacion.cuerpo.reembolso, sinPenalizacion.cuerpo.reserva.importe);
+  });
+});
+
+test("C5 · un gestor exime sin penalización con exento y un motivo largo, sin forzar", async () => {
+  await conApi({}, async (api) => {
+    // R-0520 está a 23 horas: sin exención haría falta forzar.
+    const r = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      socio: GESTOR,
+      cuerpo: { exento: true, motivo: MOTIVO },
+    });
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.estado, "cancelada");
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(r.cuerpo.reserva.motivoCancelacion, MOTIVO);
+    assert.equal(r.cuerpo.reembolso, r.cuerpo.reserva.importe);
+  });
+});
+
+test("C5 · la exención exige un motivo de al menos 10 caracteres", async () => {
+  await conApi({}, async (api) => {
+    for (const cuerpo of [{ exento: true }, { exento: true, motivo: "corto" }]) {
+      const r = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { socio: GESTOR, cuerpo });
+      assert.equal(r.status, 400);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+  });
+});
+
+test("C5 · eximir sin ser gestor devuelve 403 y sin identificarse 401", async () => {
+  await conApi({}, async (api) => {
+    const socio = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      socio: "socio-003",
+      cuerpo: { exento: true, motivo: MOTIVO },
+    });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const anonimo = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      cuerpo: { exento: true, motivo: MOTIVO },
+    });
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  });
+});
+
+test("C6 · una reserva que ya ha empezado no se cancela, tampoco con exento", async () => {
+  await conApi({}, async (api) => {
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-19T09:30" } })).status, 200);
+    const r = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      socio: GESTOR,
+      cuerpo: { exento: true, motivo: MOTIVO },
+    });
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "RESERVA_PASADA");
+  });
+});
+
