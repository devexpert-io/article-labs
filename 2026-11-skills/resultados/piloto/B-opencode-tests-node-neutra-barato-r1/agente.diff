+  const [anio, mes, dia] = fecha!.split("-").map(Number);
+  const [h, m] = hora!.split(":").map(Number);
+  const comoUtc = Date.UTC(anio!, mes! - 1, dia!, h!, m!);
+  const desfase = relojDeMadrid(comoUtc) - comoUtc;
+  let utc = comoUtc - desfase;
+  const desfaseReal = relojDeMadrid(utc) - utc;
+  if (desfaseReal !== desfase) utc = comoUtc - desfaseReal;
