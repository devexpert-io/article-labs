+test("el informe de caja suma ingresos y penalizaciones por pista y para todo el club", async () => {
+  await conApi("2026-11-18T10:00", async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const delMes = estado.reservas.filter((r: { inicio: string }) => r.inicio.slice(0, 7) === "2026-11");
+    const esperadoPistas = estado.pistas
+      .slice()
+      .sort((a: { id: string }, b: { id: string }) => a.id.localeCompare(b.id))
+      .map((p: { id: string }) => {
+        let reservas = 0;
+        let ingresos = 0;
+        let penalizaciones = 0;
+        for (const r of delMes) {
+          if (r.pistaId !== p.id) continue;
+          if (r.estado === "confirmada" || r.estado === "no_presentada") {
+            reservas += 1;
+            ingresos += r.importe;
+          } else if (r.estado === "cancelada") {
+            penalizaciones += r.penalizacion ?? 0;
+          }
+        }
+        return { pistaId: p.id, reservas, ingresos, penalizaciones, total: ingresos + penalizaciones };
+      });
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+    assert.equal(informe.cuerpo.mes, "2026-11");
+    assert.deepEqual(informe.cuerpo.pistas, esperadoPistas);
+    assert.deepEqual(
+      informe.cuerpo.total,
+      esperadoPistas.reduce(
+        (t: { reservas: number; ingresos: number; penalizaciones: number; total: number }, p: any) => ({
+          reservas: t.reservas + p.reservas,
+          ingresos: t.ingresos + p.ingresos,
+          penalizaciones: t.penalizaciones + p.penalizaciones,
+          total: t.total + p.total,
+        }),
+        { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+      ),
+    );
+  });
+});
+
