+test("el informe de caja solo lo ve un gestor y valida el mes", async () => {
+  await conApi("2026-11-18T10:00", async (api) => {
+    const sinIdentidad = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
+    assert.equal(sinIdentidad.status, 401);
+    assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const noGestor = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-003" });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const mesInvalido = await api.pedir("GET", "/api/informes/caja?mes=2026-1", { socio: "socio-040" });
+    assert.equal(mesInvalido.status, 400);
+    assert.equal(mesInvalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const sinMes = await api.pedir("GET", "/api/informes/caja", { socio: "socio-040" });
+    assert.equal(sinMes.status, 400);
+    assert.equal(sinMes.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  });
+});
