+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+  });
+});
+
+test("la antelación se mide en horas reales de Madrid, con el cambio de hora", async () => {
+  // Del viernes 2027-03-26T20:30 al domingo 2027-03-28T21:00 hay 47,5 horas reales (no 48,5).
+  await conApi("2027-03-26T20:30", async (api) => {
