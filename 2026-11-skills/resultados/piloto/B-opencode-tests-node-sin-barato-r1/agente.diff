+// Penalizaciones escalonadas, exención de gestores e informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(ahora: string, prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi({ AHORA: ahora });
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+/** Crea una reserva en una franja libre del futuro lejano y devuelve su id e importe. */
+async function reservar(api: Api, inicio = "2027-03-03T10:30") {
+  const creada = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio },
+  });
+  assert.equal(creada.status, 201);
+  return creada.cuerpo.reserva as { id: string; importe: number };
+}
+
+test("sin penalización con 48 horas o más", async () => {
+  // De 2027-03-01T09:00 a 2027-03-03T10:30 hay 49,5 horas.
+  await conApi("2027-03-01T09:00", async (api) => {
+    const r = await reservar(api);
+    const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada.cuerpo.reembolso, r.importe);
+  });
+});
+
+test("a 48 horas justas no hay penalización", async () => {
+  await conApi("2027-03-01T10:30", async (api) => {
+    const r = await reservar(api);
+    const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada.cuerpo.reembolso, r.importe);
+  });
+});
+
+test("a 24 horas justas se aplica el 25 % y no hace falta forzar", async () => {
+  await conApi("2027-03-02T10:30", async (api) => {
+    const r = await reservar(api);
+    const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 450);
+    assert.equal(cancelada.cuerpo.reembolso, r.importe - 450);
+  });
+});
+
+test("entre 24 y 48 horas la penalización es el 25 %", async () => {
+  // De 2027-03-02T00:00 a 2027-03-03T10:30 hay 34,5 horas.
+  await conApi("2027-03-02T00:00", async (api) => {
+    const r = await reservar(api);
+    const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 450);
+    assert.equal(cancelada.cuerpo.reembolso, 1350);
+  });
+});
+
+test("por debajo de 24 horas solo se cancela con forzar y la penalización es el 50 %", async () => {
+  await conApi("2027-03-02T11:00", async (api) => {
+    const r = await reservar(api);
+    const sinForzar = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
