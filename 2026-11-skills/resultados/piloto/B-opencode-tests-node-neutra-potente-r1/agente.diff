+test("C7 · el informe cuenta las no_presentadas del historial", async () => {
+  await conApi({}, async (api) => {
+    const estado = await (await api.pedir("GET", "/_estado")).cuerpo;
+    const mes = "2026-10";
+    const delMes = estado.reservas.filter((r: { inicio: string }) => r.inicio.startsWith(`${mes}-`));
+    const esperado = estado.pistas.map((p: { id: string }) => {
+      const conf = delMes.filter((r: { pistaId: string; estado: string }) =>
+        r.pistaId === p.id && (r.estado === "confirmada" || r.estado === "no_presentada"));
+      const canc = delMes.filter((r: { pistaId: string; estado: string }) => r.pistaId === p.id && r.estado === "cancelada");
+      const ingresos = conf.reduce((s: number, r: { importe: number }) => s + r.importe, 0);
+      const penalizaciones = canc.reduce((s: number, r: { penalizacion?: number }) => s + (r.penalizacion ?? 0), 0);
+      return { pistaId: p.id, reservas: conf.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    });
+    const total = esperado.reduce(
+      (s: { reservas: number; ingresos: number; penalizaciones: number; total: number }, p: typeof esperado[number]) => ({
+        reservas: s.reservas + p.reservas,
+        ingresos: s.ingresos + p.ingresos,
+        penalizaciones: s.penalizaciones + p.penalizaciones,
+        total: s.total + p.total,
+      }),
+      { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    );
+
+    const informe = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+    assert.deepEqual(informe.cuerpo.pistas, esperado);
+    assert.deepEqual(informe.cuerpo.total, total);
+  });
+});
