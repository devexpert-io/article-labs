+test("C7 · el informe de caja suma reservas, ingresos y penalizaciones por pista", async () => {
+  await conApi({ AHORA: "2026-12-01T09:00" }, async (api) => {
+    const conf = await crear(api, "socio-001", "pista-1", "2026-12-05T12:00");
+    const conf2 = await crear(api, "socio-003", "pista-2", "2026-12-06T18:00");
+    const pen = await crear(api, "socio-006", "pista-3", "2026-12-07T21:00");
+
+    // Cancela con menos de 24 horas de antelación para que sume una penalización.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-07T20:00" } });
+    const cancelada = await api.pedir("POST", `/api/reservas/${pen.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.status, 200);
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+    assert.equal(informe.cuerpo.mes, "2026-12");
+
+    const pistas = informe.cuerpo.pistas;
+    assert.deepEqual(pistas.map((p: { pistaId: string }) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+
+    const penalizacionPen = Math.round(pen.importe * 0.5);
+    assert.deepEqual(pistas[0], { pistaId: "pista-1", reservas: 1, ingresos: conf.importe, penalizaciones: 0, total: conf.importe });
+    assert.deepEqual(pistas[1], { pistaId: "pista-2", reservas: 1, ingresos: conf2.importe, penalizaciones: 0, total: conf2.importe });
+    assert.deepEqual(pistas[2], { pistaId: "pista-3", reservas: 0, ingresos: 0, penalizaciones: penalizacionPen, total: penalizacionPen });
+    assert.deepEqual(pistas[3], { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+
+    assert.deepEqual(informe.cuerpo.total, {
+      reservas: 2,
+      ingresos: conf.importe + conf2.importe,
+      penalizaciones: penalizacionPen,
+      total: conf.importe + conf2.importe + penalizacionPen,
+    });
+  });
+});
