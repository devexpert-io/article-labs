+// La antelación se mide en horas reales de Madrid, contando el cambio de hora.
+const ZONA_HORARIA = "Europe/Madrid";
+const formatoLocal = new Intl.DateTimeFormat("en-US", {
+  timeZone: ZONA_HORARIA,
+  hourCycle: "h23",
+  year: "numeric",
+  month: "2-digit",
+  day: "2-digit",
+  hour: "2-digit",
+  minute: "2-digit",
+  second: "2-digit",
+});
+
+/** Desfase (en ms) que suma UTC para obtener la hora local de Madrid en ese instante. */
+function desfaseDeMadrid(ms: number): number {
+  const valores: Record<string, number> = {};
+  for (const parte of formatoLocal.formatToParts(new Date(ms))) valores[parte.type] = Number(parte.value);
+  const localComoUtc = Date.UTC(
+    valores.year!, valores.month! - 1, valores.day!,
+    valores.hour!, valores.minute!, valores.second!,
+  );
+  return localComoUtc - ms;
+}
+
+/** Convierte una hora local de Madrid (`AAAA-MM-DDTHH:MM`) a un instante UTC en ms. */
+function aUtc(fechaHora: string): number {
+  const [fecha, hora] = fechaHora.split("T");
+  const [anio, mes, dia] = fecha!.split("-").map(Number);
+  const [hh, mm] = hora!.split(":").map(Number);
+  const comoUtc = Date.UTC(anio!, mes! - 1, dia!, hh!, mm!);
+  return comoUtc - desfaseDeMadrid(comoUtc);
+}
