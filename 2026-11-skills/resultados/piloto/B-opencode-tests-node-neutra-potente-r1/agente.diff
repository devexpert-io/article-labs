@@ -0,0 +1,247 @@
+// La política escalonada de cancelación, la exención y el informe de caja (spec `reembolsos`).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(entorno: Record<string, string>, fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function crear(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, `crear ${inicio}: ${JSON.stringify(r.cuerpo)}`);
+  return r.cuerpo.reserva as { id: string; importe: number; estado: string };
+}
+
+test("C1 · tramos de penalización", async () => {
+  await conApi({ AHORA: "2026-12-07T09:00" }, async (api) => {
+    // 48 horas o más: sin penalización.
+    const a = await crear(api, "socio-001", "pista-1", "2026-12-09T12:00");
+    const ca = await api.pedir("POST", `/api/reservas/${a.id}/cancelar`);
+    assert.equal(ca.status, 200);
+    assert.equal(ca.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(ca.cuerpo.reembolso, a.importe);
+
+    // 24 horas o más, y menos de 48: 25 % del importe.
+    const b = await crear(api, "socio-003", "pista-1", "2026-12-08T12:00");
+    const cb = await api.pedir("POST", `/api/reservas/${b.id}/cancelar`);
+    assert.equal(cb.status, 200);
+    assert.equal(cb.cuerpo.reserva.penalizacion, Math.round(b.importe * 0.25));
+    assert.equal(cb.cuerpo.reembolso, b.importe - Math.round(b.importe * 0.25));
+
+    // Menos de 24 horas: solo con forzar y penalización del 50 %.
+    const c = await crear(api, "socio-006", "pista-1", "2026-12-07T21:00");
+    const sinForzar = await api.pedir("POST", `/api/reservas/${c.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const conForzar = await api.pedir("POST", `/api/reservas/${c.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(conForzar.status, 200);
+    assert.equal(conForzar.cuerpo.reserva.penalizacion, Math.round(c.importe * 0.5));
+    assert.equal(conForzar.cuerpo.reembolso, c.importe - Math.round(c.importe * 0.5));
+  });
+});
+
+test("C2 · límites exactos de 48 y 24 horas", async () => {
+  await conApi({ AHORA: "2026-12-07T09:00" }, async (api) => {
+    // 48 horas justas: sin penalización.
+    const a = await crear(api, "socio-001", "pista-1", "2026-12-09T09:00");
+    const ca = await api.pedir("POST", `/api/reservas/${a.id}/cancelar`);
+    assert.equal(ca.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(ca.cuerpo.reembolso, a.importe);
+
+    // 24 horas justas: 25 % y no hace falta forzar.
+    const b = await crear(api, "socio-003", "pista-1", "2026-12-08T09:00");
+    const cb = await api.pedir("POST", `/api/reservas/${b.id}/cancelar`);
+    assert.equal(cb.status, 200);
+    assert.equal(cb.cuerpo.reserva.penalizacion, Math.round(b.importe * 0.25));
+  });
+});
+
+test("C3 · cambio de hora: la antelación cuenta las horas reales de Madrid", async () => {
+  // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas (no 48,5).
+  await conApi({ AHORA: "2027-03-26T20:30" }, async (api) => {
+    const r = await crear(api, "socio-001", "pista-1", "2027-03-28T21:00");
+    const c = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, Math.round(r.importe * 0.25));
+  });
+});
+
+test("C4 · la cancelación devuelve el reembolso", async () => {
+  await conApi({ AHORA: "2026-12-07T09:00" }, async (api) => {
+    // Sin penalización: reembolso igual al importe entero.
+    const gratis = await crear(api, "socio-001", "pista-1", "2026-12-09T12:00");
+    const c1 = await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`);
+    assert.equal(c1.cuerpo.reembolso, gratis.importe);
+
+    // Con penalización del 25 %: reembolso = importe - penalización.
+    const p25 = await crear(api, "socio-003", "pista-1", "2026-12-08T12:00");
+    const c2 = await api.pedir("POST", `/api/reservas/${p25.id}/cancelar`);
+    assert.equal(c2.cuerpo.reembolso, p25.importe - c2.cuerpo.reserva.penalizacion);
+  });
+});
+
+test("C5 · exención por un gestor", async () => {
+  await conApi({ AHORA: "2026-12-07T09:00" }, async (api) => {
+    // Un gestor exime sin penalización, sin forzar, y guarda el motivo.
+    const r = await crear(api, "socio-001", "pista-1", "2026-12-07T21:00");
+    const ok = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo: "Avalado por dirección" },
+    });
+    assert.equal(ok.status, 200);
+    assert.equal(ok.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(ok.cuerpo.reserva.motivoCancelacion, "Avalado por dirección");
+    assert.equal(ok.cuerpo.reembolso, r.importe);
+
+    // Sin motivo: 400.
+    const sinMotivo = await crear(api, "socio-003", "pista-1", "2026-12-07T19:30");
+    const e1 = await api.pedir("POST", `/api/reservas/${sinMotivo.id}/cancelar`, { socio: "socio-040", cuerpo: { exento: true } });
+    assert.equal(e1.status, 400);
+    assert.equal(e1.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // Motivo corto: 400.
+    const corto = await crear(api, "socio-006", "pista-1", "2026-12-07T18:00");
+    const e2 = await api.pedir("POST", `/api/reservas/${corto.id}/cancelar`, { socio: "socio-040", cuerpo: { exento: true, motivo: "corto" } });
+    assert.equal(e2.status, 400);
+    assert.equal(e2.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // Quien no es gestor: 403.
+    const noGestor = await crear(api, "socio-008", "pista-2", "2026-12-07T19:30");
+    const e3 = await api.pedir("POST", `/api/reservas/${noGestor.id}/cancelar`, {
+      socio: "socio-008",
+      cuerpo: { exento: true, motivo: "Motivo suficientemente largo" },
+    });
+    assert.equal(e3.status, 403);
+    assert.equal(e3.cuerpo.error.codigo, "SIN_PERMISO");
+
+    // Sin X-Socio: 401.
+    const sinSocio = await crear(api, "socio-009", "pista-2", "2026-12-07T18:00");
+    const e4 = await api.pedir("POST", `/api/reservas/${sinSocio.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "Motivo suficientemente largo" },
+    });
+    assert.equal(e4.status, 401);
+    assert.equal(e4.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  });
+});
+
+test("C6 · una reserva ya empezada no se cancela, tampoco con exento", async () => {
+  await conApi({ AHORA: "2026-12-07T09:00" }, async (api) => {
+    const r = await crear(api, "socio-001", "pista-1", "2026-12-07T10:30");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-07T11:00" } });
+    const c = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, {
+      socio: "socio-040",
