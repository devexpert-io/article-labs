+++ b/test/facturas.test.ts
@@ -0,0 +1,143 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Factura, Reserva } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+const generar = (api: Api, mes: unknown) => api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+const reloj = async (api: Api, ahora: string) => {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+};
+
+async function conApi(ejecutar: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try { await ejecutar(api); } finally { api.cerrar(); }
+}
+
+test("facturas: todas las rutas exigen un gestor antes de validar datos", async () => conApi(async (api) => {
+  for (const [metodo, ruta] of [["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F-2026-0001"]]) {
+    for (const socio of [undefined, "socio-999", "socio-001", gestor]) {
+      const r = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      if (socio === gestor) assert.ok([200, 201].includes(r.status));
+      else {
+        assert.equal(r.status, socio === "socio-001" ? 403 : 401);
+        assert.equal(r.cuerpo.error.codigo, socio === "socio-001" ? "SIN_PERMISO" : "NO_IDENTIFICADO");
+      }
+    }
+  }
+}));
+
+test("facturas: valida el mes y solo genera meses terminados según el reloj del club", async () => conApi(async (api) => {
+  for (const mes of [undefined, null, 202610, {}, [], "", "2026-1", "2026-00", "2026-13", "2026-10-01", "2026-10\n"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const ruta of ["/api/facturas", "/api/facturas?mes=2026-13"]) {
+    const r = await api.pedir("GET", ruta, { socio: gestor });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-12", { socio: gestor })).cuerpo, { facturas: [] });
+  await reloj(api, "2026-11-30T23:59");
+  assert.equal((await generar(api, "2026-11")).status, 409);
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+}));
+
+test("facturas: historial de octubre, socios, líneas, conceptos, importes e IVA global", async () => conApi(async (api) => {
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+  const reservas: Reserva[] = antes.reservas.filter((r: Reserva) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(reservas.some((r) => r.estado === "no_presentada"));
+  const r = await generar(api, "2026-10");
+  assert.equal(r.status, 201);
+  const facturas: Factura[] = r.cuerpo.facturas;
+  assert.deepEqual(facturas.map((f) => f.socioId), [...new Set(reservas.map((r) => r.socioId))].sort());
+  assert.ok(!facturas.some((f) => f.socioId === "socio-041"));
+  for (const [i, f] of facturas.entries()) {
+    const propias = reservas.filter((r) => r.socioId === f.socioId).sort((a, b) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+    assert.deepEqual(f.lineas, propias.map((r) => ({ reservaId: r.id, concepto: "Reserva de pista", importe: r.importe })));
+    const total = propias.reduce((suma, r) => suma + r.importe, 0);
+    assert.equal(f.total, total);
+    assert.equal(f.base, Math.round(total / 1.21));
+    assert.equal(f.iva, total - f.base);
+    assert.equal(f.numero, `F-2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.mes, "2026-10");
+    assert.deepEqual((await api.pedir("GET", `/api/facturas/${f.numero}`, { socio: gestor })).cuerpo, { factura: f });
+  }
+  assert.ok(facturas.some((f) => f.base !== f.lineas.reduce((s, l) => s + Math.round(l.importe / 1.21), 0)), "se redondea por factura, no por línea");
+  const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+  for (const clave of ["reservas", "socios", "pistas", "ahora", "contador"]) assert.deepEqual(despues[clave], antes[clave]);
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).cuerpo, r.cuerpo);
+  const repetida = await generar(api, "2026-10");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo, r.cuerpo);
+  const inexistente = await api.pedir("GET", "/api/facturas/F-2026-9999", { socio: gestor });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+}));
+
+test("facturas: penalización, cancelación gratuita y atribución por inicio de reserva", async () => conApi(async (api) => {
+  const crear = async (inicio: string, pistaId = "pista-3") => {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId, inicio } });
+    assert.equal(r.status, 201);
+    return r.cuerpo.reserva as Reserva;
+  };
+  // Se crean fuera de orden para comprobar el orden de las líneas.
+  const gratis = await crear("2026-12-03T09:00");
+  const penalizada = await crear("2026-12-01T09:00");
+  const jugada = await crear("2026-12-02T09:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`)).status, 200);
+  await reloj(api, "2026-11-30T15:00");
+  const cancelada = await api.pedir("POST", `/api/reservas/${penalizada.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1200);
+  await reloj(api, "2026-12-01T00:00");
+  const noviembre = await generar(api, "2026-11");
+  assert.ok(!noviembre.cuerpo.facturas.some((f: Factura) => f.socioId === "socio-041"));
+  await reloj(api, "2027-01-01T00:00");
+  const diciembre = await generar(api, "2026-12");
+  assert.equal(diciembre.status, 201);
+  assert.equal(diciembre.cuerpo.facturas.length, 1);
+  assert.deepEqual(diciembre.cuerpo.facturas[0], {
+    numero: `F-2026-${String(noviembre.cuerpo.facturas.length + 1).padStart(4, "0")}`,
+    mes: "2026-12", socioId: "socio-041",
+    lineas: [
+      { reservaId: penalizada.id, concepto: "Penalización por cancelación", importe: 1200 },
+      { reservaId: jugada.id, concepto: "Reserva de pista", importe: 1200 },
+    ], total: 2400, base: 1983, iva: 417,
+  });
+  const pasada = await api.pedir("POST", `/api/reservas/${jugada.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(pasada.cuerpo.error.codigo, "RESERVA_PASADA");
+}));
+
+test("facturas: secuencia anual, meses vacíos, concurrencia e idempotencia", async () => conApi(async (api) => {
+  const vacio = await generar(api, "2026-09");
+  assert.equal(vacio.status, 201);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  assert.equal((await generar(api, "2026-09")).status, 200);
+  const simultaneas = await Promise.all([generar(api, "2026-10"), generar(api, "2026-10")]);
+  assert.deepEqual(simultaneas.map((r) => r.status).sort(), [200, 201]);
+  assert.deepEqual(simultaneas[0]!.cuerpo, simultaneas[1]!.cuerpo);
+  const octubre = simultaneas[0]!.cuerpo.facturas as Factura[];
+  await reloj(api, "2027-01-01T00:00");
+  assert.equal((await generar(api, "2026-12")).status, 201);
+  const noviembre = (await generar(api, "2026-11")).cuerpo.facturas as Factura[];
+  assert.equal(noviembre[0]!.numero, `F-2026-${String(octubre.length + 1).padStart(4, "0")}`);
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-02T09:00" } });
+  assert.equal(creada.status, 201);
+  await reloj(api, "2027-02-01T00:00");
+  const enero = await generar(api, "2027-01");
+  assert.equal(enero.cuerpo.facturas[0].numero, "F-2027-0001");
+  assert.deepEqual((await generar(api, "2026-10")).cuerpo.facturas, octubre);
+  // Una generación ya guardada sigue siendo la misma incluso al retroceder el reloj de pruebas.
+  await reloj(api, "2026-10-01T00:00");
+  const repetida = await generar(api, "2026-10");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo.facturas, octubre);
+}));
