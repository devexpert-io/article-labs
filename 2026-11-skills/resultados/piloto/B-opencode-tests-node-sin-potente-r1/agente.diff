+// Penalizaciones escalonadas, exención de gestor e informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Cada test arranca su propia API, para que el estado (y el reloj) no se mezclen entre casos.
+async function conApi(fn: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("48 horas o más: cancelación gratuita, sin forzar", async () => {
+  await conApi(async (api) => {
+    // R-0490 empieza el 2026-11-20T12:00, 50 horas después del reloj por defecto.
+    const r = await api.pedir("POST", "/api/reservas/R-0490/cancelar");
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(r.cuerpo.reembolso, 1200);
+  });
+});
+
+test("entre 24 y 48 horas: penalización del 25 %, sin forzar", async () => {
+  await conApi(async (api) => {
+    // R-0524 empieza el 2026-11-19T10:30, 24,5 horas después del reloj por defecto.
+    const r = await api.pedir("POST", "/api/reservas/R-0524/cancelar");
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 450);
+    assert.equal(r.cuerpo.reembolso, 1350);
+  });
+});
+
+test("menos de 24 horas: solo con forzar y penalización del 50 %", async () => {
+  await conApi(async (api) => {
+    // R-0520 empieza el 2026-11-19T09:00, 23 horas después del reloj por defecto.
+    const fuera = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(fuera.status, 409);
+    assert.equal(fuera.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+    assert.equal(forzada.cuerpo.reembolso, 600);
+  });
+});
+
+test("límites exactos: a 48 horas justas no hay penalización y a 24 horas justas es el 25 %", async () => {
+  // R-0520 empieza el 2026-11-19T09:00. A las 09:00 del día 17 faltan exactamente 48 horas.
+  await conApi(async (api) => {
+    const r = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(r.cuerpo.reembolso, 1200);
+  }, { AHORA: "2026-11-17T09:00" });
+
+  // A las 09:00 del día 18 faltan exactamente 24 horas: 25 % y sin necesidad de forzar.
+  await conApi(async (api) => {
+    const r = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 300);
+    assert.equal(r.cuerpo.reembolso, 900);
+  }, { AHORA: "2026-11-18T09:00" });
+});
+
+test("cambio de hora: la antelación se mide en horas reales de Madrid", async () => {
+  // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas
+  // (esa madrugada los relojes se adelantan una hora): menos de 48, así que penaliza el 25 %.
+  await conApi(async (api) => {
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2027-03-28T21:00" },
+    });
+    assert.equal(creada.status, 201);
+    const id = creada.cuerpo.reserva.id;
+    const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 700);
+    assert.equal(r.cuerpo.reembolso, 2100);
+  }, { AHORA: "2027-03-26T20:30" });
+});
+
+test("exención: un gestor exime sin penalización con un motivo de 10+ caracteres", async () => {
+  await conApi(async (api) => {
+    // R-0520 está a 23 horas (fuera de plazo), pero el gestor exime sin forzar.
+    const ok = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
