+/** Zona horaria del club: las horas son reales en Madrid, contando el cambio de hora. */
+const ZONA_HORARIA = "Europe/Madrid";
+
+/** Desfase en minutos (hora local - UTC) de Madrid para un instante UTC dado. */
+function desfaseMadrid(utc: number): number {
+  const partes = new Intl.DateTimeFormat("en-US", {
+    timeZone: ZONA_HORARIA,
+    timeZoneName: "shortOffset",
+  }).formatToParts(new Date(utc));
+  const nombre = partes.find((p) => p.type === "timeZoneName")!.value;
+  const m = /GMT([+-])(\d{1,2})(?::(\d{2}))?/.exec(nombre);
+  if (!m) return 0;
+  const signo = m[1] === "-" ? -1 : 1;
+  return signo * (Number(m[2]) * 60 + Number(m[3] ?? 0));
+}
+
+/** Milisegundos UTC del instante local "AAAA-MM-DDTHH:MM" en Madrid. */
+function enMadrid(local: string): number {
+  const [fecha, hora] = local.split("T") as [string, string];
+  const [anio, mes, dia] = fecha.split("-").map(Number);
+  const [hh, mm] = hora.split(":").map(Number);
+  let utc = Date.UTC(anio!, mes! - 1, dia!, hh!, mm!);
+  for (let i = 0; i < 3; i++) {
+    utc = Date.UTC(anio!, mes! - 1, dia!, hh!, mm!) - desfaseMadrid(utc) * 60_000;
+  }
+  return utc;
+}
+
 function horasEntre(desde: string, hasta: string): number {
-  return (Date.parse(`${hasta}:00Z`) - Date.parse(`${desde}:00Z`)) / 3_600_000;
