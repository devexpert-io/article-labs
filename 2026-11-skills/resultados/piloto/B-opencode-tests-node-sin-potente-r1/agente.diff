+      cuerpo: { exento: true, motivo: "Avalado por la recepción del club" },
+    });
+    assert.equal(ok.status, 200);
+    assert.equal(ok.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(ok.cuerpo.reembolso, 1200);
+    assert.equal(ok.cuerpo.reserva.motivoCancelacion, "Avalado por la recepción del club");
+
+    // Motivo demasiado corto.
+    const corto = await api.pedir("POST", "/api/reservas/R-0524/cancelar", {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo: "corto" },
+    });
+    assert.equal(corto.status, 400);
+    assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // Sin motivo.
+    const sinMotivo = await api.pedir("POST", "/api/reservas/R-0525/cancelar", {
+      socio: "socio-040",
+      cuerpo: { exento: true },
+    });
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // Un socio que no es gestor no puede eximir.
+    const socio = await api.pedir("POST", "/api/reservas/R-0490/cancelar", {
+      socio: "socio-001",
+      cuerpo: { exento: true, motivo: "Motivo de ejemplo válido" },
+    });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    // Sin identificar quién llama.
+    const anonimo = await api.pedir("POST", "/api/reservas/R-0491/cancelar", {
+      cuerpo: { exento: true, motivo: "Motivo de ejemplo válido" },
+    });
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  });
+});
+
+test("reservas pasadas: no se cancelan, ni siquiera con exento", async () => {
+  await conApi(async (api) => {
+    const r = await api.pedir("POST", "/api/reservas/R-0001/cancelar");
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "RESERVA_PASADA");
+    const exenta = await api.pedir("POST", "/api/reservas/R-0001/cancelar", {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo: "Motivo de ejemplo válido" },
+    });
+    assert.equal(exenta.status, 409);
+    assert.equal(exenta.cuerpo.error.codigo, "RESERVA_PASADA");
+  });
+});
+
+test("informe de caja: permisos y formato del mes", async () => {
+  await conApi(async (api) => {
+    const sinSocio = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
+    assert.equal(sinSocio.status, 401);
+    assert.equal(sinSocio.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const noGestor = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-001" });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const malMes = await api.pedir("GET", "/api/informes/caja?mes=2026", { socio: "socio-040" });
+    assert.equal(malMes.status, 400);
+    assert.equal(malMes.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  });
+});
+
+test("informe de caja: una fila por pista (también sin movimientos) y totales", async () => {
