+function instanteMadrid(fechaHora: string): number {
+  const [fecha, hora] = fechaHora.split("T");
+  const [ano, mes, dia] = fecha!.split("-").map(Number);
+  const [hh, mm] = hora!.split(":").map(Number);
+  const utcLocal = Date.UTC(ano!, mes! - 1, dia!, hh!, mm!);
+  const formato = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hourCycle: "h23" });
+  let instante = utcLocal;
+  for (let i = 0; i < 2; i++) {
+    const partes = Object.fromEntries(formato.formatToParts(new Date(instante)).map((p) => [p.type, p.value]));
+    const interpretado = Date.UTC(Number(partes.year), Number(partes.month) - 1, Number(partes.day), Number(partes.hour), Number(partes.minute));
+    instante += utcLocal - interpretado;
+  }
+  return instante;
+}
+
 function invalido(mensaje: string): never {
   throw new ErrorDelClub("DATOS_INVALIDOS", mensaje, 400);
 }
