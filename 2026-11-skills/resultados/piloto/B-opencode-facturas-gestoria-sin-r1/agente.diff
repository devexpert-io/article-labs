--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,220 @@
+// Las facturas mensuales de la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { calcularBase, calcularIva } from "../src/nucleo.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(cuerpo: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await cuerpo(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("solo un gestor genera y consulta facturas", async () => {
+  await conApi(async (api) => {
+    const sinCabecera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+    assert.equal(sinCabecera.status, 401);
+    assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const noGestor = await api.pedir("POST", "/api/facturas", { socio: "socio-001", cuerpo: { mes: "2026-10" } });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10")).status, 401);
+    assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" })).status, 403);
+    assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001", { socio: "socio-001" })).status, 403);
+
+    const gestor = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10" } });
+    assert.equal(gestor.status, 201);
+  });
+});
+
+test("solo se factura un mes cerrado y con formato AAAA-MM", async () => {
+  await conApi(async (api) => {
+    const opciones = { socio: GESTOR };
+    const malFormato = await api.pedir("POST", "/api/facturas", { ...opciones, cuerpo: { mes: "2026-10-01" } });
+    assert.equal(malFormato.status, 400);
+    assert.equal(malFormato.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const sinMes = await api.pedir("POST", "/api/facturas", { ...opciones, cuerpo: {} });
+    assert.equal(sinMes.status, 400);
+
+    const actual = await api.pedir("POST", "/api/facturas", { ...opciones, cuerpo: { mes: "2026-11" } });
+    assert.equal(actual.status, 409);
+    assert.equal(actual.cuerpo.error.codigo, "MES_ABIERTO");
+
+    const futuro = await api.pedir("POST", "/api/facturas", { ...opciones, cuerpo: { mes: "2027-01" } });
+    assert.equal(futuro.status, 409);
+    assert.equal(futuro.cuerpo.error.codigo, "MES_ABIERTO");
+  });
+});
+
+test("una factura por socio con algo que facturar, ordenadas por id, con líneas y total e IVA", async () => {
+  await conApi(async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const inicioDe = new Map(estado.reservas.map((r: { id: string; inicio: string }) => [r.id, r.inicio]));
+
+    const generadas = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10" } });
+    assert.equal(generadas.status, 201);
+    const facturas = generadas.cuerpo.facturas as Array<{
+      numero: string;
+      mes: string;
+      socioId: string;
+      lineas: Array<{ reservaId: string; concepto: string; importe: number }>;
+      total: number;
+      base: number;
+      iva: number;
+    }>;
+
+    // Hay 40 socios con algo que facturar en octubre; Nora Benítez (socio-041) no tiene reservas.
+    assert.equal(facturas.length, 40);
+    assert.equal(facturas.some((f) => f.socioId === "socio-041"), false);
+
+    // Ordenadas por id de socio.
+    const ids = facturas.map((f) => f.socioId);
+    assert.deepEqual(ids, [...ids].sort());
+
+    for (const f of facturas) {
+      assert.equal(f.mes, "2026-10");
+      assert.match(f.numero, /^F2026-\d{4}$/);
+      // Las líneas van ordenadas por el inicio de la reserva.
+      const inicios = f.lineas.map((l) => inicioDe.get(l.reservaId));
+      assert.deepEqual(inicios, [...inicios].sort());
+      // total es la suma de las líneas y la base/iva cuadran.
+      const suma = f.lineas.reduce((s, l) => s + l.importe, 0);
+      assert.equal(f.total, suma);
+      assert.equal(f.base, calcularBase(f.total));
+      assert.equal(f.iva, calcularIva(f.total, f.base));
+      assert.equal(f.base + f.iva, f.total);
+    }
+
+    // La primera factura es la de socio-001: tres reservas, con su base e IVA ya calculados.
+    const primera = facturas[0]!;
+    assert.equal(primera.numero, "F2026-0001");
+    assert.equal(primera.socioId, "socio-001");
+    assert.deepEqual(
+      primera.lineas.map((l) => [l.reservaId, l.concepto, l.importe]),
+      [["R-0120", "Reserva", 1800], ["R-0172", "Reserva", 2800], ["R-0193", "Reserva", 2200]],
+    );
+    assert.equal(primera.total, 6800);
+    assert.equal(primera.base, 5620);
+    assert.equal(primera.iva, 1180);
+  });
+});
+
+test("la base se calcula sobre el total de la factura, no línea a línea", () => {
+  // El ejemplo de la gestoría: tres líneas de 1.800, 1.800 y 2.800 dan 6.400 de total.
+  assert.equal(calcularBase(6400), 5289);
+  assert.equal(calcularIva(6400, calcularBase(6400)), 1111);
+});
+
+test("una cancelación con penalización se factura como Penalización y una gratis no entra", async () => {
+  await conApi(async (api) => {
+    // A finales de octubre para poder cancelar reservas de ese mes.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-10-30T09:00" } });
+
+    // R-0298 empieza en hora y media: se cancela fuera de plazo y con penalización.
+    const conPenalizacion = await api.pedir("POST", "/api/reservas/R-0298/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(conPenalizacion.cuerpo.reserva.estado, "cancelada");
+    assert.equal(conPenalizacion.cuerpo.reserva.penalizacion, 1800);
+
+    // R-0307 empieza mañana a las 10:30 (más de 24 horas): se cancela gratis.
+    const gratis = await api.pedir("POST", "/api/reservas/R-0307/cancelar");
+    assert.equal(gratis.cuerpo.reserva.estado, "cancelada");
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+
+    // Volvemos a noviembre y facturamos octubre, ya cerrado.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:00" } });
+    const generadas = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10" } });
+    const facturas = generadas.cuerpo.facturas as Array<{
+      socioId: string;
+      lineas: Array<{ reservaId: string; concepto: string; importe: number }>;
+    }>;
+
+    const deSocio010 = facturas.find((f) => f.socioId === "socio-010")!;
+    const lineaPenalizacion = deSocio010.lineas.find((l) => l.reservaId === "R-0298");
+    assert.deepEqual(lineaPenalizacion, { reservaId: "R-0298", concepto: "Penalización", importe: 1800 });
+
+    const deSocio029 = facturas.find((f) => f.socioId === "socio-029")!;
+    assert.equal(deSocio029.lineas.some((l) => l.reservaId === "R-0307"), false);
+  });
+});
+
+test("generar dos veces devuelve las mismas facturas y no crea nuevas", async () => {
+  await conApi(async (api) => {
+    const primera = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10" } });
+    assert.equal(primera.status, 201);
+    const segunda = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10" } });
+    assert.equal(segunda.status, 200);
+    assert.deepEqual(segunda.cuerpo, primera.cuerpo);
+  });
+});
+
+test("consultar facturas por mes y por número", async () => {
+  await conApi(async (api) => {
+    // Un mes no generado da una lista vacía.
+    const vacio = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.equal(vacio.status, 200);
+    assert.deepEqual(vacio.cuerpo, { facturas: [] });
+
+    await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10" } });
+    const delMes = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.equal(delMes.cuerpo.facturas.length, 40);
+
+    const porNumero = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: GESTOR });
+    assert.equal(porNumero.status, 200);
+    assert.equal(porNumero.cuerpo.factura.socioId, "socio-001");
+
+    const inexistente = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
