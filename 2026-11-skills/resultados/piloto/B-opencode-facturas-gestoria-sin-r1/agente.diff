+test("la numeración es correlativa por año: entre meses y entre años", async () => {
+  await conApi(async (api) => {
+    // Octubre de 2026, cerrado con el reloj por defecto.
+    const oct = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10" } });
+    assert.equal(oct.status, 201);
+    assert.equal(oct.cuerpo.facturas[0].numero, "F2026-0001");
+    assert.equal(oct.cuerpo.facturas.at(-1).numero, "F2026-0040");
+
+    // Creamos una reserva de diciembre antes de que llegue.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T10:00" } });
+    await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-2", inicio: "2026-12-05T10:30" } });
+
+    // Noviembre de 2026: sigue la serie de 2026.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-05T10:00" } });
+    const nov = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-11" } });
+    assert.equal(nov.status, 201);
+    assert.equal(nov.cuerpo.facturas[0].numero, "F2026-0041");
+
+    // Diciembre de 2026 generado en enero de 2027: el año del número es el del mes facturado.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-10T10:00" } });
+    const dic = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-12" } });
+    assert.equal(dic.status, 201);
+    assert.equal(dic.cuerpo.facturas.length, 1);
+    assert.match(dic.cuerpo.facturas[0].numero, /^F2026-\d{4}$/);
+
+    // Una reserva de enero de 2027 y, tras cerrar enero, la serie de 2027 empieza en 0001.
+    await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-004", pistaId: "pista-2", inicio: "2027-01-20T10:30" } });
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-05T10:00" } });
+    const ene = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2027-01" } });
+    assert.equal(ene.cuerpo.facturas.length, 1);
+    assert.equal(ene.cuerpo.facturas[0].numero, "F2027-0001");
+  });
+});
