+/** Diferencia en ms entre la hora de Madrid y UTC en ese instante (p. ej. 3600000 en invierno). */
+function desfaseMadrid(instante: number): number {
+  const p = Object.fromEntries(zonaMadrid.formatToParts(instante).map((x) => [x.type, x.value]));
+  const comoUtc = Date.UTC(+p.year!, +p.month! - 1, +p.day!, +p.hour!, +p.minute!, +p.second!);
