@@ -0,0 +1,175 @@
+// Penalizaciones escalonadas, exención de un gestor e informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const GESTOR = "socio-040";
+
+async function reloj(ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+/** Crea una reserva con el reloj en una fecha anterior, para poder cancelarla después con otra hora. */
+async function reservar(socioId: string, pistaId: string, inicio: string): Promise<string> {
+  await reloj("2026-11-30T10:00");
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(creada.status, 201, JSON.stringify(creada.cuerpo));
+  return creada.cuerpo.reserva.id;
+}
+
+function cancelar(id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+test("tramos: 48 horas o más no penalizan; 24 horas o más, el 25 %; menos de 24, solo con forzar y el 50 %", async () => {
+  const sinPenalizacion = await reservar("socio-006", "pista-1", "2026-12-03T09:00");
+  await reloj("2026-12-01T09:00"); // 48 horas justas
+  const libre = await cancelar(sinPenalizacion);
+  assert.equal(libre.status, 200);
+  assert.equal(libre.cuerpo.reserva.estado, "cancelada");
+  assert.equal(libre.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(libre.cuerpo.reembolso, 1800);
+
+  const media47 = await reservar("socio-007", "pista-2", "2026-12-03T10:30");
+  await reloj("2026-12-01T11:00"); // 47 horas y media
+  const media = await cancelar(media47);
+  assert.equal(media.cuerpo.reserva.penalizacion, 450);
+  assert.equal(media.cuerpo.reembolso, 1350);
+
+  const medias24 = await reservar("socio-008", "pista-1", "2026-12-03T12:00");
+  await reloj("2026-12-02T12:00"); // 24 horas justas: 25 % y sin forzar
+  const justo = await cancelar(medias24);
+  assert.equal(justo.status, 200);
+  assert.equal(justo.cuerpo.reserva.penalizacion, 450);
+  assert.equal(justo.cuerpo.reembolso, 1350);
+
+  const tarde = await reservar("socio-009", "pista-2", "2026-12-03T13:30");
+  await reloj("2026-12-02T13:31"); // 23 horas y 59 minutos
+  const sinForzar = await cancelar(tarde);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const siguePendiente = await api.pedir("GET", `/api/reservas/${tarde}`);
+  assert.equal(siguePendiente.cuerpo.reserva.estado, "confirmada", "un 409 no cancela la reserva");
+  const forzada = await cancelar(tarde, { forzar: true });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+  assert.equal(forzada.cuerpo.reembolso, 900);
+
+  const otra = await cancelar(tarde, { forzar: true });
+  assert.equal(otra.cuerpo.error.codigo, "YA_CANCELADA");
+});
+
+test("las reservas canceladas conservan su penalización aunque cambie la hora", async () => {
+  const id = await reservar("socio-010", "pista-3", "2026-12-03T15:00");
+  await reloj("2026-12-02T15:00"); // 24 horas justas: 25 % de 1200
+  assert.equal((await cancelar(id)).cuerpo.reserva.penalizacion, 300);
+  await reloj("2026-11-01T10:00");
+  const reserva = (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva;
+  assert.equal(reserva.penalizacion, 300);
+  assert.equal(reserva.estado, "cancelada");
+});
+
+test("cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales (no 48,5),
+  // porque esa madrugada se adelantan los relojes. Por eso ya hay penalización del 25 %.
+  const id = await reservar("socio-015", "pista-3", "2027-03-28T21:00");
+  await reloj("2027-03-26T20:30");
+  const cancelada = await cancelar(id);
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 500, "pista 3 de punta: 25 % de 2000");
+  assert.equal(cancelada.cuerpo.reembolso, 1500);
+
+  // Viernes 21:00 a domingo 21:00: 47 horas reales, también con penalización.
+  const otra = await reservar("socio-016", "pista-1", "2027-03-28T21:00");
+  await reloj("2027-03-26T21:00");
+  assert.equal((await cancelar(otra)).cuerpo.reserva.penalizacion, 700, "pista 1 de punta: 25 % de 2800");
+});
+
+test("exención: un gestor cancela sin penalización con un motivo de al menos 10 caracteres", async () => {
+  const id = await reservar("socio-013", "pista-2", "2026-12-03T15:00");
+  await reloj("2026-12-03T14:30"); // media hora antes: sin forzar, da igual
+
+  const sinIdentificar = await cancelar(id, { exento: true, motivo: "Obra ahora" });
+  assert.equal(sinIdentificar.status, 401);
+  assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const socio = await cancelar(id, { exento: true, motivo: "Obra ahora" }, "socio-013");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const corto = await cancelar(id, { exento: true, motivo: "Obra ahor" }, GESTOR);
+  assert.equal(corto.status, 400);
+  assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const sinMotivo = await cancelar(id, { exento: true }, GESTOR);
+  assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const noBooleano = await cancelar(id, { exento: "si", motivo: "Obra ahora" }, GESTOR);
+  assert.equal(noBooleano.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
