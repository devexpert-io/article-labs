+test("informe de caja: cuenta cobros y penalizaciones por pista y por mes de inicio", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const resumen = (reservas: any[]) => {
+    const cobradas = reservas.filter((r) => r.estado === "confirmada" || r.estado === "no_presentada");
+    const ingresos = cobradas.reduce((s, r) => s + r.importe, 0);
+    const penalizaciones = reservas.filter((r) => r.estado === "cancelada").reduce((s, r) => s + (r.penalizacion ?? 0), 0);
+    return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+  };
+
+  for (const mes of ["2026-12", "2026-11", "2027-03", "2030-01"]) {
+    const informe = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: GESTOR });
+    assert.equal(informe.status, 200);
+    const delMes = estado.reservas.filter((r: any) => r.inicio.startsWith(mes));
+    const pistasEsperadas = [...estado.pistas]
+      .sort((a: any, b: any) => (a.id < b.id ? -1 : 1))
+      .map((p: any) => ({ pistaId: p.id, ...resumen(delMes.filter((r: any) => r.pistaId === p.id)) }));
+    assert.deepEqual(informe.cuerpo, { mes, pistas: pistasEsperadas, total: resumen(delMes) }, mes);
+    assert.equal(informe.cuerpo.pistas.length, estado.pistas.length, "una entrada por pista, también sin movimientos");
+  }
+
+  const marzo = (await api.pedir("GET", "/api/informes/caja?mes=2027-03", { socio: GESTOR })).cuerpo;
+  assert.equal(marzo.total.reservas, 0);
+  assert.equal(marzo.total.ingresos, 0);
+  assert.equal(marzo.total.penalizaciones, 1200, "500 de la pista 3 y 700 de la pista 1");
+
+  const diciembre = (await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: GESTOR })).cuerpo;
+  assert.ok(diciembre.total.penalizaciones > 0);
+  assert.equal(diciembre.pistas.find((p: any) => p.pistaId === "pista-4").reservas, 0);
+});
