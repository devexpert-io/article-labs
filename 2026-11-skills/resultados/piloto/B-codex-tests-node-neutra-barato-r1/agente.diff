diff --git a/test/reembolsos.test.ts b/test/reembolsos.test.ts
new file mode 100644
index 0000000..2c48f71
--- /dev/null
+++ b/test/reembolsos.test.ts
@@ -0,0 +1,100 @@
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => { api = await arrancarApi(); });
+after(() => api.cerrar());
+
+async function reserva(inicio: string, pistaId = "pista-1") {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId, inicio } });
+}
+async function reloj(ahora: string) { return api.pedir("POST", "/_reloj", { cuerpo: { ahora } }); }
+
+test("C1 · tramos de 48, 24 y menos de 24 horas", async () => {
+  await reloj("2027-01-25T09:00");
+  const libre = await reserva("2027-01-27T09:00");
+  const a = await api.pedir("POST", `/api/reservas/${libre.cuerpo.reserva.id}/cancelar`);
+  assert.equal(a.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(a.cuerpo.reembolso, libre.cuerpo.reserva.importe);
+  const media = await reserva("2027-01-26T09:00", "pista-2");
+  const b = await api.pedir("POST", `/api/reservas/${media.cuerpo.reserva.id}/cancelar`);
+  assert.equal(b.cuerpo.reserva.penalizacion, Math.round(media.cuerpo.reserva.importe * 0.25));
+  const corta = await reserva("2027-01-25T10:30", "pista-3");
+  const denegada = await api.pedir("POST", `/api/reservas/${corta.cuerpo.reserva.id}/cancelar`);
+  assert.equal(denegada.status, 409);
+  assert.equal(denegada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const c = await api.pedir("POST", `/api/reservas/${corta.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(c.cuerpo.reserva.penalizacion, Math.round(corta.cuerpo.reserva.importe * 0.5));
+});
+
+test("C2 · los límites exactos de 48 y 24 horas", async () => {
+  await reloj("2027-01-25T09:00");
+  const cuarentaOcho = await reserva("2027-01-27T09:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${cuarentaOcho.cuerpo.reserva.id}/cancelar`)).cuerpo.reserva.penalizacion, undefined);
+  const veinticuatro = await reserva("2027-01-26T09:00", "pista-2");
+  const r = await api.pedir("POST", `/api/reservas/${veinticuatro.cuerpo.reserva.id}/cancelar`);
+  assert.equal(r.cuerpo.reserva.penalizacion, Math.round(veinticuatro.cuerpo.reserva.importe * 0.25));
+});
+
+test("C3 · el cambio de hora se cuenta en horas reales de Madrid", async () => {
+  await reloj("2027-03-26T20:30");
+  const creada = await reserva("2027-03-28T21:00");
+  const r = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+  assert.equal(r.cuerpo.reserva.penalizacion, 700);
+});
+
+test("C4 · reembolso es importe menos penalización", async () => {
+  await reloj("2027-01-25T09:00");
+  const creada = await reserva("2027-01-27T09:00");
+  const r = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+  assert.equal(r.cuerpo.reembolso, r.cuerpo.reserva.importe - (r.cuerpo.reserva.penalizacion ?? 0));
+});
+
+test("C5 · exención exige gestor y motivo válido", async () => {
+  await reloj("2026-11-25T20:00");
+  const creada = await reserva("2026-11-25T21:00");
+  const url = `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`;
+  const anonima = await api.pedir("POST", url, { cuerpo: { exento: true, motivo: "Excepción aprobada" } });
+  assert.equal(anonima.status, 401);
+  assert.equal(anonima.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("POST", url, { socio: "socio-003", cuerpo: { exento: true, motivo: "Excepción aprobada" } });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const gestor = await api.pedir("POST", url, { socio: "socio-040", cuerpo: { exento: true, motivo: "corto" } });
+  assert.equal(gestor.status, 400);
+  assert.equal(gestor.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const bien = await api.pedir("POST", url, { socio: "socio-040", cuerpo: { exento: true, motivo: "Excepción aprobada" } });
+  assert.equal(bien.cuerpo.reserva.penalizacion, 0);
+  assert.equal(bien.cuerpo.reserva.motivoCancelacion, "Excepción aprobada");
+  assert.equal(bien.cuerpo.reembolso, creada.cuerpo.reserva.importe);
+});
+
+test("C6 · una reserva iniciada no se cancela ni con exención", async () => {
+  const pasada = await api.pedir("POST", "/api/reservas/R-0001/cancelar", { socio: "socio-040", cuerpo: { exento: true, motivo: "Excepción aprobada" } });
+  assert.equal(pasada.status, 409);
+  assert.equal(pasada.cuerpo.error.codigo, "RESERVA_PASADA");
+});
+
+test("C7 · informe mensual de caja y permisos", async () => {
+  const sinId = await api.pedir("GET", "/api/informes/caja?mes=2026-10");
+  assert.equal(sinId.status, 401);
+  const noGestor = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-003" });
+  assert.equal(noGestor.status, 403);
+  const invalido = await api.pedir("GET", "/api/informes/caja?mes=2026-13", { socio: "socio-040" });
+  assert.equal(invalido.status, 400);
+  assert.equal(invalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const r = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-040" });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.pistas.length, 4);
+  assert.deepEqual(r.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+  assert.deepEqual(r.cuerpo.total, r.cuerpo.pistas.reduce((t: any, p: any) => ({ reservas: t.reservas + p.reservas, ingresos: t.ingresos + p.ingresos, penalizaciones: t.penalizaciones + p.penalizaciones, total: t.total + p.total }), { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 }));
+});
+
+test("C8 · reservas canceladas existentes no se recalculan", async () => {
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo.reservas.find((r: any) => r.estado === "cancelada");
+  const previa = antes.penalizacion;
+  await api.pedir("POST", `/api/reservas/${antes.id}/cancelar`);
+  const despues = (await api.pedir("GET", "/_estado")).cuerpo.reservas.find((r: any) => r.id === antes.id);
+  assert.equal(despues.penalizacion, previa);
+});
