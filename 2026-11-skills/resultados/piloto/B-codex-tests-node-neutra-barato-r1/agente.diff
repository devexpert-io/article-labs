+function instanteMadrid(fechaHora: string): number {
+  const objetivo = Date.parse(`${fechaHora}:00Z`);
+  let instante = objetivo;
+  const formato = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hourCycle: "h23" });
+  for (let i = 0; i < 3; i++) {
+    const partes = Object.fromEntries(formato.formatToParts(new Date(instante)).map((p) => [p.type, p.value]));
+    const representado = Date.UTC(Number(partes.year), Number(partes.month) - 1, Number(partes.day), Number(partes.hour), Number(partes.minute));
+    const diferencia = objetivo - representado;
+    instante += diferencia;
+    if (!diferencia) break;
+  }
+  return instante;
+}
