+// C7 · Informe de caja
+
+type Fila = { reservas: number; ingresos: number; penalizaciones: number; total: number };
+
+/** El informe esperado, calculado a partir del estado completo. */
+async function informeEsperado(api: Api, mes: string) {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const vacio = (): Fila => ({ reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+  const filas: Record<string, Fila> = Object.fromEntries(estado.pistas.map((p: { id: string }) => [p.id, vacio()]));
+  const total = vacio();
+  for (const r of estado.reservas) {
+    if (!r.inicio.startsWith(`${mes}-`)) continue;
+    for (const f of [filas[r.pistaId]!, total]) {
+      if (r.estado === "cancelada") {
+        f.penalizaciones += r.penalizacion ?? 0;
+        f.total += r.penalizacion ?? 0;
+      } else {
+        f.reservas += 1;
+        f.ingresos += r.importe;
+        f.total += r.importe;
+      }
+    }
+  }
+  const pistas = Object.keys(filas).sort().map((pistaId) => ({ pistaId, ...filas[pistaId]! }));
+  return { mes, pistas, total };
+}
+
+test("C7 · el informe de caja suma reservas, ingresos y penalizaciones por pista y en total", () => conApi(async (api) => {
+  // Dos cancelaciones con penalización en noviembre: 300 (pista 3 a 25 % de 1200) y 1400 (pista 2 a 50 % de 2800, sábado en punta).
+  const a = await reservar(api, "pista-3", INICIO);
+  const b = await reservar(api, "pista-2", "2026-11-28T18:00");
+  await reloj(api, "2026-11-23T00:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${a.id}/cancelar`)).cuerpo.reembolso, 900);
+  await reloj(api, "2026-11-28T09:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${b.id}/cancelar`, { cuerpo: { forzar: true } })).cuerpo.reembolso, 1400);
+
+  const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR });
+  assert.equal(informe.status, 200);
+  const esperado = await informeEsperado(api, "2026-11");
+  assert.deepEqual(informe.cuerpo, esperado);
+  assert.deepEqual(informe.cuerpo.pistas.map((p: { pistaId: string }) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+  assert.equal(informe.cuerpo.total.penalizaciones, 300 + 1400);
+  const sumaDe = (campo: keyof Fila) => informe.cuerpo.pistas.reduce((s: number, p: Fila) => s + p[campo], 0);
+  for (const campo of ["reservas", "ingresos", "penalizaciones", "total"] as const) {
+    assert.equal(informe.cuerpo.total[campo], sumaDe(campo));
+  }
+}));
