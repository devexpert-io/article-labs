+++ b/test/reembolsos.test.ts
@@ -0,0 +1,310 @@
+// Spec docs/specs/reembolsos.md: penalizaciones escalonadas e informe de caja.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-003";
+
+/** Arranca una API con su propia semilla, ejecuta el test y la cierra. */
+async function conApi(cuerpo: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await cuerpo(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+/** Crea una reserva de socio-003 y devuelve su cuerpo. */
+async function reservar(api: Api, pistaId: string, inicio: string) {
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIO, pistaId, inicio } });
+  assert.equal(creada.status, 201);
+  return creada.cuerpo.reserva;
+}
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+/** Pista 3, martes 24 a las 12:00 (valle): 1200 céntimos. */
+const INICIO = "2026-11-24T12:00";
+
+async function cancelarA(api: Api, ahora: string, cuerpo?: unknown, socio?: string) {
+  const reserva = await reservar(api, "pista-3", INICIO);
+  await reloj(api, ahora);
+  const respuesta = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo, socio });
+  return { reserva, respuesta };
+}
+
+function cancelada(reserva: Record<string, unknown>, extra: Record<string, unknown> = {}) {
+  return { ...reserva, estado: "cancelada", ...extra };
+}
+
+function errorCon(respuesta: { status: number; cuerpo: any }, http: number, codigo: string) {
+  assert.equal(respuesta.status, http);
+  assert.equal(respuesta.cuerpo.error.codigo, codigo);
+  assert.equal(typeof respuesta.cuerpo.error.mensaje, "string");
+}
+
+// C1 · Tramos
+
+test("C1 · con 48 horas o más de antelación no hay penalización", () => conApi(async (api) => {
+  const { reserva, respuesta } = await cancelarA(api, "2026-11-21T12:00");
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { reserva: cancelada(reserva), reembolso: 1200 });
+}));
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 % del importe", () => conApi(async (api) => {
+  const { reserva, respuesta } = await cancelarA(api, "2026-11-23T00:00");
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { reserva: cancelada(reserva, { penalizacion: 300 }), reembolso: 900 });
+}));
+
+test("C1 · con menos de 24 horas y sin forzar, 409 FUERA_DE_PLAZO y la reserva sigue confirmada", () => conApi(async (api) => {
+  const { reserva, respuesta } = await cancelarA(api, "2026-11-24T00:00");
+  errorCon(respuesta, 409, "FUERA_DE_PLAZO");
+  const despues = await api.pedir("GET", `/api/reservas/${reserva.id}`);
+  assert.equal(despues.status, 200);
+  assert.deepEqual(despues.cuerpo, { reserva });
+}));
+
+test("C1 · con menos de 24 horas y forzar, la penalización es el 50 % del importe", () => conApi(async (api) => {
+  const { reserva, respuesta } = await cancelarA(api, "2026-11-24T00:00", { forzar: true });
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { reserva: cancelada(reserva, { penalizacion: 600 }), reembolso: 600 });
+}));
+
+// C2 · Límites exactos
+
+test("C2 · a 48 horas justas no hay penalización", () => conApi(async (api) => {
+  const { reserva, respuesta } = await cancelarA(api, "2026-11-22T12:00");
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { reserva: cancelada(reserva), reembolso: 1200 });
+}));
+
+test("C2 · a 47 horas y 59 minutos ya se aplica el 25 %", () => conApi(async (api) => {
+  const { reserva, respuesta } = await cancelarA(api, "2026-11-22T12:01");
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { reserva: cancelada(reserva, { penalizacion: 300 }), reembolso: 900 });
+}));
+
+test("C2 · a 24 horas justas se aplica el 25 % sin necesidad de forzar", () => conApi(async (api) => {
+  const { reserva, respuesta } = await cancelarA(api, "2026-11-23T12:00");
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { reserva: cancelada(reserva, { penalizacion: 300 }), reembolso: 900 });
+}));
+
+test("C2 · a 23 horas y 59 minutos hace falta forzar", () => conApi(async (api) => {
+  const { respuesta } = await cancelarA(api, "2026-11-23T12:01");
+  errorCon(respuesta, 409, "FUERA_DE_PLAZO");
+}));
+
+// C3 · Cambio de hora
+
+test("C3 · del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas: 25 %", () => conApi(async (api) => {
+  // Domingo, punta en la pista 3: 2000 céntimos.
+  const reserva = await reservar(api, "pista-3", "2027-03-28T21:00");
+  await reloj(api, "2027-03-26T20:30");
+  const respuesta = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { reserva: cancelada(reserva, { penalizacion: 500 }), reembolso: 1500 });
+}));
+
+test("C3 · del viernes 26 de marzo de 2027 a las 20:00 al domingo 28 a las 21:00 hay 48 horas justas: gratis", () => conApi(async (api) => {
+  const reserva = await reservar(api, "pista-3", "2027-03-28T21:00");
+  await reloj(api, "2027-03-26T20:00");
+  const respuesta = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { reserva: cancelada(reserva), reembolso: 2000 });
+}));
+
+test("C3 · en octubre los relojes se atrasan: del sábado 30 a las 21:30 al domingo 31 de octubre de 2027 a las 21:00 hay 24,5 horas", () => conApi(async (api) => {
+  const reserva = await reservar(api, "pista-3", "2027-10-31T21:00");
+  await reloj(api, "2027-10-30T21:30");
+  const respuesta = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { reserva: cancelada(reserva, { penalizacion: 500 }), reembolso: 1500 });
+}));
+
+// C4 · Reembolso
+
+test("C4 · el reembolso es importe - penalizacion, o el importe entero sin penalización", () => conApi(async (api) => {
+  const gratis = await cancelarA(api, "2026-11-20T12:00");
+  assert.equal(gratis.respuesta.status, 200);
+  assert.equal(gratis.respuesta.cuerpo.reembolso, gratis.reserva.importe);
+  // Otra reserva de 2800 céntimos (pista 2, sábado): a 30 horas, 25 % = 700.
+  const otra = await reservar(api, "pista-2", "2026-11-28T18:00");
+  await reloj(api, "2026-11-27T12:00");
+  const respuesta = await api.pedir("POST", `/api/reservas/${otra.id}/cancelar`);
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { reserva: cancelada(otra, { penalizacion: 700 }), reembolso: 2800 - 700 });
+}));
