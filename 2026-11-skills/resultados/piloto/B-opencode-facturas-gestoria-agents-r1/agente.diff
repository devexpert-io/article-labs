--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,164 @@
+// La facturación mensual de la gestoría, probada a través de la API y con el núcleo.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import type { EstadoReserva, Reserva } from "../src/tipos.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+function reserva(
+  id: string,
+  socioId: string,
+  inicio: string,
+  importe: number,
+  estado: EstadoReserva = "confirmada",
+  penalizacion?: number,
+): Reserva {
+  return {
+    id,
+    socioId,
+    pistaId: "pista-1",
+    inicio,
+    fin: `${inicio.slice(0, 10)}T10:30`,
+    estado,
+    importe,
+    notas: "",
+    ...(penalizacion !== undefined ? { penalizacion } : {}),
+  };
+}
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+test("solo un gestor genera y consulta facturas", async () => {
+  assert.equal((await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } })).status, 401);
+  const postSocio = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+  assert.equal(postSocio.status, 403);
+  assert.equal(postSocio.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10")).status, 401);
+  const getSocio = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" });
+  assert.equal(getSocio.status, 403);
+  assert.equal((await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR })).status, 201);
+});
+
+test("mes: el formato debe ser AAAA-MM y solo se factura un mes cerrado", async () => {
+  const mal = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026" }, socio: GESTOR });
+  assert.equal(mal.status, 400);
+  assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const actual = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+  assert.equal(actual.status, 409);
+  assert.equal(actual.cuerpo.error.codigo, "MES_ABIERTO");
+
+  const futuro = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2027-01" }, socio: GESTOR });
+  assert.equal(futuro.status, 409);
+  assert.equal(futuro.cuerpo.error.codigo, "MES_ABIERTO");
+});
+
+test("octubre: una factura por socio, ordenadas, con líneas y total/IVA correctos", async () => {
+  const otra = await arrancarApi();
+  try {
+    const primera = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(primera.status, 201);
+    const facturas = primera.cuerpo.facturas;
+    assert.ok(facturas.length > 0, "octubre tiene facturas");
+
+    // Ordenadas por id de socio y una por socio (sin repetir).
+    const ids = facturas.map((f: { socioId: string }) => f.socioId);
+    assert.deepEqual(ids, [...ids].sort());
+    assert.equal(new Set(ids).size, ids.length);
+
+    const estado = (await otra.pedir("GET", "/_estado")).cuerpo;
+    const inicioPorReserva = new Map(estado.reservas.map((r: { id: string; inicio: string }) => [r.id, r.inicio]));
+
+    for (const f of facturas) {
+      assert.equal(f.total, f.lineas.reduce((s: number, l: { importe: number }) => s + l.importe, 0));
+      assert.equal(f.base, Math.round((f.total * 100) / 121));
+      assert.equal(f.base + f.iva, f.total);
+      for (const l of f.lineas) {
+        assert.ok(l.concepto === "Reserva" || l.concepto === "Penalización");
+        assert.equal(l.reservaId, String(l.reservaId));
+      }
+      // Líneas ordenadas por el inicio de la reserva.
+      const inicios = f.lineas.map((l: { reservaId: string }) => inicioPorReserva.get(l.reservaId));
+      assert.deepEqual(inicios, [...inicios].sort());
+    }
+
+    // Generar dos veces: mismas facturas y mismos números, sin crear nuevas.
+    const segunda = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(segunda.status, 200);
+    assert.deepEqual(segunda.cuerpo.facturas, facturas);
+
+    // Consultar el mes y una factura concreta.
+    const lista = await otra.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.deepEqual(lista.cuerpo.facturas, facturas);
+
+    const una = await otra.pedir("GET", `/api/facturas/${facturas[0].numero}`, { socio: GESTOR });
+    assert.deepEqual(una.cuerpo.factura, facturas[0]);
+
+    const noExiste = await otra.pedir("GET", "/api/facturas/F2099-0001", { socio: GESTOR });
+    assert.equal(noExiste.status, 404);
+    assert.equal(noExiste.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+
+    const vacio = await otra.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+    assert.deepEqual(vacio.cuerpo.facturas, []);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("numeración: el año es el del mes facturado (diciembre generado en enero)", async () => {
+  const otra = await arrancarApi();
+  try {
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T08:00" } });
+    assert.equal(
+      (await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-005", pistaId: "pista-1", inicio: "2026-12-05T09:00" } })).status,
+      201,
+    );
+    assert.equal(
+      (await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-002", pistaId: "pista-1", inicio: "2026-12-06T09:00" } })).status,
+      201,
+    );
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-15T10:00" } });
+
+    const r = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+    assert.equal(r.status, 201);
+    assert.deepEqual(r.cuerpo.facturas.map((f: { socioId: string }) => f.socioId), ["socio-002", "socio-005"]);
+    assert.deepEqual(r.cuerpo.facturas.map((f: { numero: string }) => f.numero), ["F2026-0001", "F2026-0002"]);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("base e IVA: el ejemplo de 6.400 céntimos da base 5.289 e IVA 1.111", () => {
+  const estado = crearSemilla();
+  estado.ahora = "2026-11-18T10:00";
+  estado.reservas = [
+    reserva("R-T1", "socio-001", "2026-10-05T09:00", 1800),
+    reserva("R-T2", "socio-001", "2026-10-06T09:00", 1800),
+    reserva("R-T3", "socio-001", "2026-10-07T18:00", 2800),
+  ];
+  const facturas = crearClub(estado).generarFacturas("2026-10").facturas;
+  assert.equal(facturas.length, 1);
+  assert.equal(facturas[0]!.total, 6400);
+  assert.equal(facturas[0]!.base, 5289);
+  assert.equal(facturas[0]!.iva, 1111);
+});
+
+test("cancelación con penalización entra como Penalización y sin penalización no entra", () => {
+  const estado = crearSemilla();
+  estado.ahora = "2026-11-18T10:00";
+  estado.reservas = [
+    reserva("R-T1", "socio-001", "2026-10-05T09:00", 1200, "cancelada", 1200),
+    reserva("R-T2", "socio-001", "2026-10-06T09:00", 1200, "cancelada"),
+  ];
+  const facturas = crearClub(estado).generarFacturas("2026-10").facturas;
+  assert.equal(facturas.length, 1);
+  assert.deepEqual(facturas[0]!.lineas, [{ reservaId: "R-T1", concepto: "Penalización", importe: 1200 }]);
+  assert.equal(facturas[0]!.total, 1200);
+});
