+test("C7 · el informe de la semilla cuenta confirmadas y no presentadas como ingresos, y las canceladas no", () =>
+  conApi(async (api) => {
+    // Cálculo independiente sobre el estado de la semilla, en octubre (hay no presentadas y canceladas).
+    const { reservas, pistas } = (await api.pedir("GET", "/_estado")).cuerpo;
+    const delMes = reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+    const resumen = (rs: any[]) => {
+      const cuentan = rs.filter((r) => r.estado !== "cancelada");
+      const ingresos = cuentan.reduce((s, r) => s + r.importe, 0);
+      const penalizaciones = rs.reduce((s, r) => s + (r.penalizacion ?? 0), 0);
+      return { reservas: cuentan.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    };
+    const esperado = {
+      mes: "2026-10",
+      pistas: [...pistas].sort((a: any, b: any) => a.id.localeCompare(b.id)).map((p: any) => ({ pistaId: p.id, ...resumen(delMes.filter((r: any) => r.pistaId === p.id)) })),
+      total: resumen(delMes),
+    };
+    const r = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, esperado);
+    assert.ok(esperado.total.reservas > 0);
+  }));
