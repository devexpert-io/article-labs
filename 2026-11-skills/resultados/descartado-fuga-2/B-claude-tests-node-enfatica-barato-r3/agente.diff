+++ b/test/reembolsos.test.ts
@@ -0,0 +1,324 @@
+// Spec docs/specs/reembolsos.md: penalizaciones escalonadas, exención de gestor e informe de caja.
+// Cada test arranca su propia API (estado de semilla nuevo) y mueve la hora con POST /_reloj.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+
+const SOCIO = "socio-041"; // Nora Benítez: socio sin reservas.
+const GESTOR = "socio-040"; // Recepción del club.
+const MOTIVO = "Lluvia fuerte: la pista no se puede usar";
+
+/** Ejecuta el test con una API propia. */
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function fijarReloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200, JSON.stringify(r.cuerpo));
+}
+
+async function reservar(api: Api, inicio: string, pistaId = "pista-3", socioId = SOCIO) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+}
+
+function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string): Promise<Respuesta> {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+// Con la semilla, pista-3 cuesta 1200 en valle (martes 1 de diciembre, 10:30) y 2000 en punta (domingos, o desde las 18:00).
+
+test("C1 · sin penalización con 48 horas o más", () =>
+  conApi(async (api) => {
+    await fijarReloj(api, "2026-11-28T10:00"); // Sábado. Hasta el martes 1 a las 10:30 hay 72,5 horas.
+    const reserva = await reservar(api, "2026-12-01T10:30");
+    const r = await cancelar(api, reserva.id);
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo.reserva, { ...reserva, estado: "cancelada" });
+    assert.equal(r.cuerpo.reembolso, 1200);
+  }));
+
+test("C1 · con 24 horas o más y menos de 48, penalización del 25 % sin forzar", () =>
+  conApi(async (api) => {
+    const reserva = await reservar(api, "2026-12-01T10:30");
+    await fijarReloj(api, "2026-11-29T22:30"); // 36 horas antes.
+    const r = await cancelar(api, reserva.id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 300);
+    assert.equal(r.cuerpo.reembolso, 900);
+  }));
+
+test("C1 · con menos de 24 horas, sin forzar da 409 FUERA_DE_PLAZO y con forzar, penalización del 50 %", () =>
+  conApi(async (api) => {
+    const reserva = await reservar(api, "2026-12-01T10:30");
+    await fijarReloj(api, "2026-11-30T12:00"); // 22,5 horas antes.
+    const sinForzar = await cancelar(api, reserva.id);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const conForzar = await cancelar(api, reserva.id, { forzar: true });
+    assert.equal(conForzar.status, 200);
+    assert.equal(conForzar.cuerpo.reserva.estado, "cancelada");
+    assert.equal(conForzar.cuerpo.reserva.penalizacion, 600);
+    assert.equal(conForzar.cuerpo.reembolso, 600);
+  }));
+
+test("C2 · a 48 horas justas no hay penalización", () =>
+  conApi(async (api) => {
+    const reserva = await reservar(api, "2026-12-01T10:30");
+    await fijarReloj(api, "2026-11-29T10:30");
+    const r = await cancelar(api, reserva.id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(r.cuerpo.reembolso, 1200);
+  }));
+
+test("C2 · un minuto antes de las 48 horas ya hay penalización del 25 %", () =>
+  conApi(async (api) => {
+    const reserva = await reservar(api, "2026-12-01T10:30");
+    await fijarReloj(api, "2026-11-29T10:31"); // 47 horas y 59 minutos.
+    const r = await cancelar(api, reserva.id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 300);
+    assert.equal(r.cuerpo.reembolso, 900);
+  }));
+
+test("C2 · a 24 horas justas se aplica el 25 % y no hace falta forzar", () =>
+  conApi(async (api) => {
+    const reserva = await reservar(api, "2026-12-01T10:30");
+    await fijarReloj(api, "2026-11-30T10:30");
+    const r = await cancelar(api, reserva.id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 300);
+  }));
+
+test("C2 · un minuto antes de las 24 horas hace falta forzar y el 50 %", () =>
+  conApi(async (api) => {
+    const reserva = await reservar(api, "2026-12-01T10:30");
+    await fijarReloj(api, "2026-11-30T10:31"); // 23 horas y 59 minutos.
+    const sinForzar = await cancelar(api, reserva.id);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const conForzar = await cancelar(api, reserva.id, { forzar: true });
+    assert.equal(conForzar.cuerpo.reserva.penalizacion, 600);
+  }));
+
+test("C3 · la antelación cuenta horas reales de Madrid: 47,5 horas con el cambio de hora de marzo llevan 25 %", () =>
+  conApi(async (api) => {
+    // Viernes 26 de marzo de 2027 a las 20:30 -> domingo 28 a las 21:00: 47,5 horas reales (48,5 en el reloj de pared).
+    await fijarReloj(api, "2027-03-26T20:30");
+    const reserva = await reservar(api, "2027-03-28T21:00"); // Domingo: punta, 2000.
+    const r = await cancelar(api, reserva.id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 500);
+    assert.equal(r.cuerpo.reembolso, 1500);
+  }));
+
+test("C3 · con el cambio de hora de octubre, 48 horas reales justas no llevan penalización", () =>
+  conApi(async (api) => {
+    // Sábado 30 de octubre de 2027 a las 20:30 -> lunes 1 de noviembre a las 19:30: 48 horas reales (47 en el reloj de pared).
+    await fijarReloj(api, "2027-10-30T20:30");
+    const reserva = await reservar(api, "2027-11-01T19:30"); // Lunes a partir de las 18:00: punta, 2000.
