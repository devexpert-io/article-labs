@@ -0,0 +1,204 @@
+// Las facturas mensuales de la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+test("solo un gestor genera y consulta facturas", async () => {
+  const sinSocio = await api.pedir("GET", "/api/facturas?mes=2026-10");
+  assert.equal(sinSocio.status, 401);
+  assert.equal(sinSocio.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const sinSocioPost = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+  assert.equal(sinSocioPost.status, 401);
+  assert.equal(sinSocioPost.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const noGestor = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const noGestorPost = await api.pedir("POST", "/api/facturas", { socio: "socio-001", cuerpo: { mes: "2026-10" } });
+  assert.equal(noGestorPost.status, 403);
+  assert.equal(noGestorPost.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const noGestorNum = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: "socio-001" });
+  assert.equal(noGestorNum.status, 403);
+  assert.equal(noGestorNum.cuerpo.error.codigo, "SIN_PERMISO");
+});
+
+test("solo se factura un mes cerrado, con formato AAAA-MM", async () => {
+  const invalido = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10-01" } });
+  assert.equal(invalido.status, 400);
+  assert.equal(invalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const abierto = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-11" } });
+  assert.equal(abierto.status, 409);
+  assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+
+  const futuro = await api.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-12" } });
+  assert.equal(futuro.status, 409);
+  assert.equal(futuro.cuerpo.error.codigo, "MES_ABIERTO");
+});
+
+test("consultar un mes sin generar da lista vacía y una factura inexistente, 404", async () => {
+  const vacio = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(vacio.status, 200);
+  assert.deepEqual(vacio.cuerpo.facturas, []);
+
+  const ninguna = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: GESTOR });
+  assert.equal(ninguna.status, 404);
+  assert.equal(ninguna.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("las rutas existentes no cambian", async () => {
+  assert.equal((await api.pedir("GET", "/api/pistas")).status, 200);
+  const reservas = await api.pedir("GET", "/api/reservas?limite=1");
+  assert.equal(reservas.status, 200);
+  assert.ok(reservas.cuerpo.total > 0);
+});
+
+test("octubre: una factura por socio, líneas ordenadas y total con IVA", async () => {
+  const propia = await arrancarApi();
+  try {
+    const estado = (await propia.pedir("GET", "/_estado")).cuerpo;
+    const esperadas = new Map<string, { reservaId: string; concepto: string; importe: number }[]>();
+    for (const r of estado.reservas) {
+      if (r.inicio.slice(0, 7) !== "2026-10") continue;
+      let linea: { reservaId: string; concepto: string; importe: number } | null = null;
+      if (r.estado === "confirmada" || r.estado === "no_presentada") {
+        linea = { reservaId: r.id, concepto: "Reserva", importe: r.importe };
+      } else if (r.estado === "cancelada" && r.penalizacion > 0) {
+        linea = { reservaId: r.id, concepto: "Penalización", importe: r.penalizacion };
+      }
+      if (linea) {
+        const list = esperadas.get(r.socioId) ?? [];
+        list.push(linea);
+        esperadas.set(r.socioId, list);
+      }
+    }
+
+    const gen = await propia.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10" } });
+    assert.equal(gen.status, 201);
+    const facturas = gen.cuerpo.facturas;
+    assert.equal(facturas.length, esperadas.size);
+    const socios = [...esperadas.keys()].sort();
+    for (let i = 0; i < facturas.length; i++) {
+      const f = facturas[i];
+      assert.equal(f.socioId, socios[i]);
+      assert.equal(f.mes, "2026-10");
+      const lineas = esperadas.get(f.socioId)!;
+      assert.deepEqual(f.lineas, lineas);
+      const total = lineas.reduce((s: number, l: { importe: number }) => s + l.importe, 0);
+      assert.equal(f.total, total);
+      assert.equal(f.base, Math.round(total * 100 / 121));
+      assert.equal(f.iva, total - f.base);
+    }
+
+    // Volver a generar devuelve lo mismo y no crea facturas nuevas.
+    const otra = await propia.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-10" } });
+    assert.equal(otra.status, 200);
+    assert.deepEqual(otra.cuerpo.facturas, facturas);
+
+    // Consultar por mes y por número.
+    const porMes = await propia.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.deepEqual(porMes.cuerpo.facturas, facturas);
+    const porNumero = await propia.pedir("GET", `/api/facturas/${facturas[0].numero}`, { socio: GESTOR });
+    assert.deepEqual(porNumero.cuerpo.factura, facturas[0]);
+  } finally {
+    propia.cerrar();
+  }
+});
+
+test("una cancelación con penalización entra como Penalización y sin penalización no entra", async () => {
+  const propia = await arrancarApi();
+  try {
+    const socio = "socio-003";
+    await propia.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T00:00" } });
+    const a = await propia.pedir("POST", "/api/reservas", { cuerpo: { socioId: socio, pistaId: "pista-3", inicio: "2026-12-07T10:30" } });
+    const b = await propia.pedir("POST", "/api/reservas", { cuerpo: { socioId: socio, pistaId: "pista-3", inicio: "2026-12-08T10:30" } });
+    assert.equal(a.status, 201);
+    assert.equal(b.status, 201);
+
+    // b se cancela gratis (faltan más de 24 horas).
+    const gratis = await propia.pedir("POST", `/api/reservas/${b.cuerpo.reserva.id}/cancelar`);
+    assert.equal(gratis.cuerpo.reserva.estado, "cancelada");
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+
+    // a se cancela fuera de plazo, con penalización del 100 %.
+    await propia.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-07T09:00" } });
+    const forzada = await propia.pedir("POST", `/api/reservas/${a.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, a.cuerpo.reserva.importe);
+
+    await propia.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-01T00:00" } });
+    const gen = await propia.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2026-12" } });
+    assert.equal(gen.status, 201);
+    const factura = gen.cuerpo.facturas.find((f: { socioId: string }) => f.socioId === socio);
+    assert.ok(factura, "socio-003 debe tener factura");
+    assert.equal(factura.lineas.length, 1);
+    assert.equal(factura.lineas[0].reservaId, a.cuerpo.reserva.id);
+    assert.equal(factura.lineas[0].concepto, "Penalización");
+    assert.equal(factura.lineas[0].importe, a.cuerpo.reserva.importe);
+  } finally {
+    propia.cerrar();
+  }
+});
+
+test("el IVA se calcula sobre el total: 6.400 céntimos dan base 5.289 e IVA 1.111", async () => {
+  const propia = await arrancarApi();
+  try {
+    const socio = "socio-003";
+    await propia.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T00:00" } });
+    await propia.pedir("POST", "/api/reservas", { cuerpo: { socioId: socio, pistaId: "pista-1", inicio: "2027-01-05T10:30" } });
+    await propia.pedir("POST", "/api/reservas", { cuerpo: { socioId: socio, pistaId: "pista-1", inicio: "2027-01-05T18:00" } });
+    await propia.pedir("POST", "/api/reservas", { cuerpo: { socioId: socio, pistaId: "pista-1", inicio: "2027-01-06T10:30" } });
+    await propia.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-01T00:00" } });
+    const gen = await propia.pedir("POST", "/api/facturas", { socio: GESTOR, cuerpo: { mes: "2027-01" } });
+    assert.equal(gen.status, 201);
