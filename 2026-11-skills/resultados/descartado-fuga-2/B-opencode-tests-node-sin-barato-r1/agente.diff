@@ -0,0 +1,174 @@
+// La política escalonada de cancelación, la exención de gestores y el informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reservar(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(respuesta.status, 201, respuesta.texto);
+  return respuesta.cuerpo.reserva;
+}
+
+async function moverReloj(api: Api, ahora: string) {
+  const respuesta = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(respuesta.status, 200, respuesta.texto);
+}
+
+function informeEsperado(estado: any, mes: string) {
+  const pistas = [...estado.pistas]
+    .sort((a: any, b: any) => a.id.localeCompare(b.id))
+    .map((pista: any) => {
+      const delMes = estado.reservas.filter((r: any) => r.pistaId === pista.id && r.inicio.startsWith(mes));
+      const activas = delMes.filter((r: any) => r.estado === "confirmada" || r.estado === "no_presentada");
+      const canceladas = delMes.filter((r: any) => r.estado === "cancelada");
+      const ingresos = activas.reduce((suma: number, r: any) => suma + r.importe, 0);
+      const penalizaciones = canceladas.reduce((suma: number, r: any) => suma + (r.penalizacion ?? 0), 0);
+      return { pistaId: pista.id, reservas: activas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    });
+  const total = pistas.reduce(
+    (suma: any, p: any) => ({
+      reservas: suma.reservas + p.reservas,
+      ingresos: suma.ingresos + p.ingresos,
+      penalizaciones: suma.penalizaciones + p.penalizaciones,
+      total: suma.total + p.total,
+    }),
+    { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+  );
+  return { mes, pistas, total };
+}
+
+test("los tramos y sus límites exactos aplican la penalización que toca", async () => {
+  await conApi({}, async (api) => {
+    await moverReloj(api, "2027-06-01T10:30");
+    const a48 = await reservar(api, "socio-041", "pista-3", "2027-06-03T10:30");
+    const a24 = await reservar(api, "socio-041", "pista-3", "2027-06-02T10:30");
+    const a23 = await reservar(api, "socio-041", "pista-3", "2027-06-02T09:00");
+
+    const cuarentaYOcho = await api.pedir("POST", `/api/reservas/${a48.id}/cancelar`);
+    assert.equal(cuarentaYOcho.status, 200);
+    assert.equal(cuarentaYOcho.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cuarentaYOcho.cuerpo.reembolso, a48.importe);
+
+    const veinticuatro = await api.pedir("POST", `/api/reservas/${a24.id}/cancelar`);
+    assert.equal(veinticuatro.status, 200);
+    assert.equal(veinticuatro.cuerpo.reserva.penalizacion, a24.importe * 0.25);
+    assert.equal(veinticuatro.cuerpo.reembolso, a24.importe * 0.75);
+
+    const fuera = await api.pedir("POST", `/api/reservas/${a23.id}/cancelar`);
+    assert.equal(fuera.status, 409);
+    assert.equal(fuera.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${a23.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, a23.importe * 0.5);
+    assert.equal(forzada.cuerpo.reembolso, a23.importe * 0.5);
+  });
+});
+
+test("la antelación se cuenta en horas reales de Madrid, con el cambio de hora", async () => {
+  await conApi({ AHORA: "2027-03-26T20:30" }, async (api) => {
+    // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas, no 48,5.
+    const reserva = await reservar(api, "socio-041", "pista-1", "2027-03-28T21:00");
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, reserva.importe * 0.25);
+    assert.equal(cancelada.cuerpo.reembolso, reserva.importe * 0.75);
+  });
+});
+
+test("un gestor puede eximir con motivo, y sin permiso o sin motivo se rechaza", async () => {
+  await conApi({}, async (api) => {
+    const reserva = await reservar(api, "socio-041", "pista-3", "2026-12-01T10:30");
+
+    const anonimo = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "Invitado del club" },
+    });
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const socio = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-001",
+      cuerpo: { exento: true, motivo: "Invitado del club" },
+    });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const sinMotivo = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true },
+    });
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const motivoCorto = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo: "corto" },
+    });
+    assert.equal(motivoCorto.status, 400);
+    assert.equal(motivoCorto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const exenta = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo: "Invitado del club" },
+    });
+    assert.equal(exenta.status, 200);
+    assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "Invitado del club");
+    assert.equal(exenta.cuerpo.reembolso, reserva.importe);
+
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const pasada = estado.reservas.find((r: any) => r.inicio < estado.ahora && r.estado !== "cancelada");
+    const intento = await api.pedir("POST", `/api/reservas/${pasada.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo: "Invitado del club" },
+    });
+    assert.equal(intento.status, 409);
+    assert.equal(intento.cuerpo.error.codigo, "RESERVA_PASADA");
+  });
