+++ b/test/reembolsos.test.ts
@@ -0,0 +1,193 @@
+// Penalizaciones escalonadas al cancelar, exención por un gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+async function reloj(ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+/** Crea una reserva (con el reloj antes de todas las de estos tests) y deja el reloj en `ahora`. Devuelve su id. */
+async function reservar(socioId: string, pistaId: string, inicio: string, ahora: string): Promise<string> {
+  await reloj("2026-11-25T00:00");
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(creada.status, 201, JSON.stringify(creada.cuerpo));
+  await reloj(ahora);
+  return creada.cuerpo.reserva.id;
+}
+
+function cancelar(id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+test("tramos: sin penalización con 48 horas o más, 25 % entre 24 y 48, y 50 % con forzar por debajo de 24", async () => {
+  // Pista 3 en valle: 1200 céntimos. Pista 2 en valle: 1800. Pista 1 en valle: 1800.
+  const holgada = await reservar("socio-003", "pista-2", "2026-12-03T12:00", "2026-12-01T10:30"); // 49,5 h
+  let r = await cancelar(holgada);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 1800);
+
+  const intermedia = await reservar("socio-006", "pista-1", "2026-12-03T12:00", "2026-12-01T12:30"); // 47,5 h
+  r = await cancelar(intermedia);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 450);
+  assert.equal(r.cuerpo.reembolso, 1350);
+
+  const urgente = await reservar("socio-008", "pista-3", "2026-12-04T15:00", "2026-12-03T15:30"); // 23,5 h
+  r = await cancelar(urgente);
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  assert.equal((await api.pedir("GET", `/api/reservas/${urgente}`)).cuerpo.reserva.estado, "confirmada");
+  r = await cancelar(urgente, { forzar: true });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 600);
+  assert.equal(r.cuerpo.reembolso, 600);
+});
+
+test("límites exactos: a 48 horas justas no hay penalización y a 24 justas se aplica el 25 % sin forzar", async () => {
+  const a48 = await reservar("socio-010", "pista-3", "2026-12-10T12:00", "2026-12-08T12:00");
+  let r = await cancelar(a48);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 1200);
+
+  const a24 = await reservar("socio-012", "pista-3", "2026-12-11T13:30", "2026-12-10T13:30");
+  r = await cancelar(a24);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 300);
+  assert.equal(r.cuerpo.reembolso, 900);
+});
+
+test("cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales (se adelanta la hora).
+  const primavera = await reservar("socio-013", "pista-3", "2027-03-28T21:00", "2027-03-26T20:30");
+  let r = await cancelar(primavera);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.importe, 2000);
+  assert.equal(r.cuerpo.reserva.penalizacion, 500);
+  assert.equal(r.cuerpo.reembolso, 1500);
+
+  // Del viernes 29 de octubre de 2027 a las 21:30 al domingo 31 a las 21:00 hay 48,5 horas reales (se atrasa la hora).
+  const otono = await reservar("socio-013", "pista-3", "2027-10-31T21:00", "2027-10-29T21:30");
+  r = await cancelar(otono);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 2000);
+});
+
+test("exención: un gestor cancela sin penalización con un motivo de 10 caracteres o más", async () => {
+  const id = await reservar("socio-014", "pista-1", "2026-12-15T12:00", "2026-12-15T09:00"); // 3 h
+  const motivo = "Lesión con justificante médico";
+
+  let r = await cancelar(id, { exento: true, motivo });
+  assert.equal(r.status, 401);
+  assert.equal(r.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  r = await cancelar(id, { exento: true, motivo }, "socio-014");
+  assert.equal(r.status, 403);
+  assert.equal(r.cuerpo.error.codigo, "SIN_PERMISO");
+  r = await cancelar(id, { exento: true }, GESTOR);
+  assert.equal(r.status, 400);
+  assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  r = await cancelar(id, { exento: true, motivo: "Lesión" }, GESTOR);
+  assert.equal(r.status, 400);
+  assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  r = await cancelar(id, { exento: true, motivo: "123456789" }, GESTOR);
+  assert.equal(r.status, 400);
+  assert.equal((await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva.estado, "confirmada");
+
