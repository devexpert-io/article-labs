+test("informe de caja: cuenta confirmadas y no presentadas, y las canceladas de la semilla conservan su penalización", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const octubre = estado.reservas.filter((x: any) => x.inicio.startsWith("2026-10"));
+  const canceladas = octubre.filter((x: any) => x.estado === "cancelada");
+  assert.ok(canceladas.length > 0);
+  assert.ok(octubre.some((x: any) => x.estado === "no_presentada"));
+  for (const c of canceladas) assert.equal(c.penalizacion, undefined);
+  const cobradas = octubre.filter((x: any) => x.estado !== "cancelada");
+
+  const r = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+  const ingresos = cobradas.reduce((s: number, x: any) => s + x.importe, 0);
+  assert.deepEqual(r.cuerpo.total, { reservas: cobradas.length, ingresos, penalizaciones: 0, total: ingresos });
+  const pista4 = cobradas.filter((x: any) => x.pistaId === "pista-4");
+  assert.equal(r.cuerpo.pistas[3].reservas, pista4.length);
+
+  const repetida = await cancelar(canceladas[0].id, { forzar: true });
+  assert.equal(repetida.status, 409);
+  assert.equal(repetida.cuerpo.error.codigo, "YA_CANCELADA");
+  assert.equal((await api.pedir("GET", `/api/reservas/${canceladas[0].id}`)).cuerpo.reserva.penalizacion, undefined);
+});
