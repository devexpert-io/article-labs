@@ -0,0 +1,40 @@
+// Las reglas de facturación de la gestoría, probadas directamente sobre el núcleo.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+import type { Reserva } from "../src/tipos.ts";
+
+test("el IVA se calcula sobre el total: 6.400 céntimos dan base 5.289 e IVA 1.111", () => {
+  const estado = crearSemilla();
+  const socio = estado.socios[0]!;
+  estado.reservas = [
+    { id: "R-9001", socioId: socio.id, pistaId: "pista-1", inicio: "2026-10-05T09:00", fin: "2026-10-05T10:30", estado: "confirmada", importe: 1800, notas: "" },
+    { id: "R-9002", socioId: socio.id, pistaId: "pista-1", inicio: "2026-10-05T10:30", fin: "2026-10-05T12:00", estado: "confirmada", importe: 1800, notas: "" },
+    { id: "R-9003", socioId: socio.id, pistaId: "pista-1", inicio: "2026-10-05T18:00", fin: "2026-10-05T19:30", estado: "confirmada", importe: 2800, notas: "" },
+  ] satisfies Reserva[];
+  const club = crearClub(estado);
+  const { facturas } = club.generarFacturas("2026-10");
+  assert.equal(facturas.length, 1);
+  const factura = facturas[0]!;
+  assert.equal(factura.total, 6400);
+  assert.equal(factura.base, 5289);
+  assert.equal(factura.iva, 1111);
+  assert.equal(factura.base + factura.iva, factura.total);
+});
+
+test("una cancelación con penalización entra como Penalización y sin penalización no entra", () => {
+  const estado = crearSemilla();
+  const socio = estado.socios[0]!;
+  estado.reservas = [
+    { id: "R-9101", socioId: socio.id, pistaId: "pista-1", inicio: "2026-10-06T09:00", fin: "2026-10-06T10:30", estado: "confirmada", importe: 1800, notas: "" },
+    { id: "R-9102", socioId: socio.id, pistaId: "pista-1", inicio: "2026-10-06T10:30", fin: "2026-10-06T12:00", estado: "cancelada", importe: 1800, penalizacion: 1800, notas: "", motivoCancelacion: "fuera de plazo" },
+    { id: "R-9103", socioId: socio.id, pistaId: "pista-1", inicio: "2026-10-06T12:00", fin: "2026-10-06T13:30", estado: "cancelada", importe: 1800, notas: "" },
+  ] satisfies Reserva[];
+  const club = crearClub(estado);
+  const { facturas } = club.generarFacturas("2026-10");
+  assert.equal(facturas.length, 1);
+  assert.deepEqual(facturas[0]!.lineas.map((l) => l.reservaId), ["R-9101", "R-9102"]);
+  assert.deepEqual(facturas[0]!.lineas.map((l) => l.concepto), ["Reserva", "Penalización"]);
+  assert.deepEqual(facturas[0]!.lineas.map((l) => l.importe), [1800, 1800]);
+});
diff --git a/test/facturas.test.ts b/test/facturas.test.ts
new file mode 100644
index 0000000..16e1cef
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,127 @@
+// Las facturas mensuales de la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+test("solo un gestor genera y consulta facturas", async () => {
+  const sinCabecera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+  assert.equal(sinCabecera.status, 401);
+  assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const getSinCabecera = await api.pedir("GET", "/api/facturas?mes=2026-10");
+  assert.equal(getSinCabecera.status, 401);
+  assert.equal(getSinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const noGestor = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const getNoGestor = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" });
+  assert.equal(getNoGestor.status, 403);
+  assert.equal(getNoGestor.cuerpo.error.codigo, "SIN_PERMISO");
+});
+
+test("mes con formato válido y que ya ha terminado", async () => {
+  const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+  assert.equal(abierto.status, 409);
+  assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+
+  const malFormato = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11-18" }, socio: GESTOR });
+  assert.equal(malFormato.status, 400);
+  assert.equal(malFormato.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const sinMes = await api.pedir("POST", "/api/facturas", { cuerpo: {}, socio: GESTOR });
+  assert.equal(sinMes.status, 400);
+  assert.equal(sinMes.cuerpo.error.codigo, "DATOS_INVALIDOS");
+});
+
+test("generar las facturas de un mes cerrado, repetir y consultarlas", async () => {
+  const primera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(primera.status, 201);
+  const facturas = primera.cuerpo.facturas;
+  assert.ok(Array.isArray(facturas) && facturas.length > 0);
+
+  // Una factura por socio con algo que facturar, ordenadas por id de socio.
+  const ids = facturas.map((f: { socioId: string }) => f.socioId);
+  assert.deepEqual(ids, [...ids].sort());
+  assert.equal(new Set(ids).size, ids.length);
+
+  for (const f of facturas) {
+    assert.match(f.numero, /^F2026-\d{4}$/);
+    assert.equal(f.mes, "2026-10");
+    const total = f.lineas.reduce((s: number, l: { importe: number }) => s + l.importe, 0);
+    assert.equal(f.total, total);
+    assert.equal(f.base, Math.round((total * 100) / 121));
+    assert.equal(f.iva, total - f.base);
+    for (const l of f.lineas) {
+      assert.ok(["Reserva", "Penalización"].includes(l.concepto));
+      assert.ok(l.reservaId);
+      assert.ok(Number.isInteger(l.importe));
+    }
+  }
+
+  // Volver a generar el mismo mes devuelve las mismas facturas y no crea ninguna nueva.
+  const segunda = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(segunda.status, 200);
+  assert.deepEqual(segunda.cuerpo.facturas, facturas);
+
+  // Consultar por mes.
+  const consulta = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(consulta.status, 200);
+  assert.deepEqual(consulta.cuerpo.facturas, facturas);
+
+  // Un mes no generado devuelve una lista vacía.
+  const vacio = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+  assert.equal(vacio.status, 200);
+  assert.deepEqual(vacio.cuerpo.facturas, []);
+
+  // Consultar una factura por número.
+  const una = await api.pedir("GET", `/api/facturas/${facturas[0].numero}`, { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo.factura, facturas[0]);
+
+  const noExiste = await api.pedir("GET", "/api/facturas/F9999-9999", { socio: GESTOR });
+  assert.equal(noExiste.status, 404);
+  assert.equal(noExiste.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("la numeración sigue la serie del año aunque se genere diciembre en enero", async () => {
+  const otra = await arrancarApi();
+  try {
+    const octubre = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(octubre.status, 201);
+    const numerosOctubre = octubre.cuerpo.facturas.map((f: { numero: string }) => Number(f.numero.slice(-4)));
+    assert.equal(numerosOctubre[0], 1);
+    for (let i = 1; i < numerosOctubre.length; i++) assert.equal(numerosOctubre[i], numerosOctubre[i - 1] + 1);
+    const ultimoOctubre = numerosOctubre[numerosOctubre.length - 1];
+
+    // Creamos una reserva en diciembre para que haya algo que facturar.
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-05T10:00" } });
+    const creada = await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-12-06T12:00" } });
+    assert.equal(creada.status, 201);
+
+    // Nos vamos a enero de 2027 y facturamos diciembre.
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-10T10:00" } });
+    const diciembre = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+    assert.equal(diciembre.status, 201);
+    const facturasDiciembre = diciembre.cuerpo.facturas;
+    assert.ok(facturasDiciembre.length > 0);
+    assert.ok(facturasDiciembre.every((f: { numero: string }) => f.numero.startsWith("F2026-")));
+    assert.equal(Number(facturasDiciembre[0].numero.slice(-4)), ultimoOctubre + 1);
+
+    // Volver a generar diciembre no gasta números.
+    const deNuevo = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+    assert.equal(deNuevo.status, 200);
+    assert.deepEqual(deNuevo.cuerpo.facturas, facturasDiciembre);
+  } finally {
+    otra.cerrar();
+  }
+});
