@@ -0,0 +1,185 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado, Factura } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+
+async function iniciar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+function generar(api: Api, mes: string) {
+  return api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+}
+
+async function reservar(api: Api, socioId: string, inicio: string) {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-1", inicio } });
+  assert.equal(respuesta.status, 201, respuesta.texto);
+  return respuesta.cuerpo.reserva;
+}
+
+test("solo un gestor puede generar, listar y obtener facturas", async (t) => {
+  const api = await iniciar(t);
+  for (const [metodo, ruta] of [
+    ["POST", "/api/facturas"],
+    ["GET", "/api/facturas?mes=2026-10"],
+    ["GET", "/api/facturas/F2026-0001"],
+  ]) {
+    for (const socio of [undefined, "socio-999", "socio-001"]) {
+      const r = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      assert.equal(r.status, socio === "socio-001" ? 403 : 401);
+      assert.equal(r.cuerpo.error.codigo, socio === "socio-001" ? "SIN_PERMISO" : "NO_IDENTIFICADO");
+    }
+  }
+  assert.equal((await generar(api, "2026-10")).status, 201);
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).status, 200);
+  assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001", { socio: gestor })).status, 200);
+});
+
+test("valida el mes y solo genera meses cerrados según el reloj del club", async (t) => {
+  const api = await iniciar(t);
+  for (const mes of [undefined, null, 202610, "", "2026-1", "26-10", "2026-00", "2026-13", "2026-10-01", " 2026-10"]) {
+    const r = await api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const consulta = await api.pedir("GET", `/api/facturas${mes === undefined ? "" : `?mes=${encodeURIComponent(String(mes))}`}`, { socio: gestor });
+    assert.equal(consulta.status, 400);
+    assert.equal(consulta.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj(api, "2026-11-30T23:59");
+  assert.equal((await generar(api, "2026-11")).status, 409);
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+});
+
+test("factura el historial de octubre por socio, con líneas ordenadas y sin alterar las reservas", async (t) => {
+  const api = await iniciar(t);
+  const antes: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const facturables = antes.reservas.filter((r) => r.inicio.startsWith("2026-10-") &&
+    (r.estado !== "cancelada" || (r.penalizacion ?? 0) > 0));
+  assert.ok(facturables.some((r) => r.estado === "confirmada"));
+  assert.ok(facturables.some((r) => r.estado === "no_presentada"));
+  const ids = [...new Set(facturables.map((r) => r.socioId))].sort();
+  const respuesta = await generar(api, "2026-10");
+  assert.equal(respuesta.status, 201);
+  const facturas: Factura[] = respuesta.cuerpo.facturas;
+  assert.deepEqual(facturas.map((f) => f.socioId), ids);
+  assert.ok(!facturas.some((f) => f.socioId === "socio-041"));
+  for (const [i, f] of facturas.entries()) {
+    assert.deepEqual(Object.keys(f).sort(), ["numero", "mes", "socioId", "lineas", "total", "base", "iva"].sort());
+    assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.mes, "2026-10");
+    const reservas = facturables.filter((r) => r.socioId === f.socioId).sort((a, b) => a.inicio.localeCompare(b.inicio));
+    assert.deepEqual(f.lineas, reservas.map((r) => ({
+      reservaId: r.id, concepto: r.estado === "cancelada" ? "Penalización" : "Reserva",
+      importe: r.estado === "cancelada" ? r.penalizacion : r.importe,
+    })));
+    const total = reservas.reduce((suma, r) => suma + (r.estado === "cancelada" ? r.penalizacion! : r.importe), 0);
+    assert.equal(f.total, total);
+    assert.equal(f.base, Math.round(total * 100 / 121));
+    assert.equal(f.iva, total - f.base);
+  }
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, antes.reservas);
+  assert.deepEqual((await generar(api, "2026-10")).cuerpo, respuesta.cuerpo);
+});
+
+test("calcula el IVA del total de 6400: base 5289 e IVA 1111", async (t) => {
+  const api = await iniciar(t);
+  // Se crean fuera de orden para comprobar también la ordenación de las líneas.
+  const tarde = await reservar(api, "socio-041", "2026-12-01T18:00");
+  const primera = await reservar(api, "socio-041", "2026-12-01T09:00");
+  const segunda = await reservar(api, "socio-041", "2026-12-01T10:30");
+  await reloj(api, "2027-01-01T00:00");
+  const r = await generar(api, "2026-12");
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.cuerpo.facturas, [{
+    numero: "F2026-0001", mes: "2026-12", socioId: "socio-041",
+    lineas: [primera, segunda, tarde].map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })),
+    total: 6400, base: 5289, iva: 1111,
+  }]);
+});
+
+test("incluye la cancelación penalizada con tilde y excluye cancelaciones gratuitas", async (t) => {
+  const api = await iniciar(t);
+  const penalizada = await reservar(api, "socio-041", "2026-12-01T09:00");
+  const gratuita = await reservar(api, "socio-041", "2026-12-02T09:00");
+  const soloGratuita = await reservar(api, "socio-001", "2026-12-03T09:00");
+  for (const r of [gratuita, soloGratuita]) {
+    const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+  }
+  await reloj(api, "2026-12-01T08:00");
+  const cancelada = await api.pedir("POST", `/api/reservas/${penalizada.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1800);
+  await reloj(api, "2027-01-01T00:00");
+  const r = await generar(api, "2026-12");
+  assert.equal(r.cuerpo.facturas.length, 1);
+  assert.equal(r.cuerpo.facturas[0].socioId, "socio-041");
+  assert.deepEqual(r.cuerpo.facturas[0].lineas, [{ reservaId: penalizada.id, concepto: "Penalización", importe: 1800 }]);
+  assert.equal(r.cuerpo.facturas[0].total, 1800);
+});
+
+test("numera por año del mes facturado, sin huecos, también al generar meses fuera de orden", async (t) => {
+  const api = await iniciar(t);
+  await reservar(api, "socio-041", "2026-12-01T09:00");
+  await reservar(api, "socio-001", "2026-12-01T10:30");
+  await reloj(api, "2027-01-01T00:00");
+  const vacio = await generar(api, "2026-09");
+  assert.equal(vacio.status, 201);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  assert.equal((await generar(api, "2026-09")).status, 200);
+  const diciembre = await generar(api, "2026-12");
+  assert.deepEqual(diciembre.cuerpo.facturas.map((f: Factura) => [f.socioId, f.numero]), [
+    ["socio-001", "F2026-0001"], ["socio-041", "F2026-0002"],
+  ]);
+  const repeticiones = await Promise.all([generar(api, "2026-12"), generar(api, "2026-12")]);
+  for (const r of repeticiones) {
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, diciembre.cuerpo);
+  }
+  const octubre = await generar(api, "2026-10");
+  assert.equal(octubre.cuerpo.facturas[0].numero, "F2026-0003");
+  const noviembre = await generar(api, "2026-11");
+  assert.equal(noviembre.cuerpo.facturas[0].numero, `F2026-${String(3 + octubre.cuerpo.facturas.length).padStart(4, "0")}`);
+  await reservar(api, "socio-041", "2027-01-05T09:00");
+  await reloj(api, "2027-02-01T00:00");
+  const enero = await generar(api, "2027-01");
+  assert.equal(enero.cuerpo.facturas[0].numero, "F2027-0001");
+  assert.deepEqual((await generar(api, "2026-12")).cuerpo, diciembre.cuerpo);
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const numeros = Object.values(estado.facturasPorMes).flat().map((f) => f.numero);
+  assert.equal(new Set(numeros).size, numeros.length);
+});
+
+test("consulta meses generados o vacíos y facturas existentes o desconocidas", async (t) => {
+  const api = await iniciar(t);
+  for (const mes of ["2026-09", "2026-10", "2027-01"]) {
+    const r = await api.pedir("GET", `/api/facturas?mes=${mes}`, { socio: gestor });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, { facturas: [] });
+  }
+  const desconocida = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: gestor });
+  assert.equal(desconocida.status, 404);
+  assert.equal(desconocida.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  const generadas = await generar(api, "2026-10");
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).cuerpo, generadas.cuerpo);
+  for (const factura of generadas.cuerpo.facturas) {
+    const r = await api.pedir("GET", `/api/facturas/${factura.numero}`, { socio: gestor });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, { factura });
+  }
+});
