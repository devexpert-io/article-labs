@@ -0,0 +1,254 @@
+// Penalizaciones escalonadas, exención de gestor, reembolso e informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const SOCIO = "socio-041"; // Nora Benítez: sin reservas, cuota al día.
+const GESTOR = "socio-040"; // La recepción del club.
+const SOCIO_NORMAL = "socio-003";
+
+/** Una API nueva con el reloj del club en `ahora`. Cada caso parte de cero. */
+async function conReloj<T>(ahora: string, caso: (api: Api) => Promise<T>): Promise<T> {
+  const api = await arrancarApi({ AHORA: ahora });
+  try {
+    return await caso(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reservar(api: Api, inicio: string, pistaId = "pista-1", socioId = SOCIO): Promise<string> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.reserva.id;
+}
+
+function cancelar(api: Api, id: string, cuerpo: Record<string, unknown> = {}, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+// pista-1 un martes a mediodía: valle, 1800 céntimos.
+const INICIO = "2026-12-01T12:00";
+
+test("tramos: sin penalización a 48 horas o más", async () => {
+  await conReloj("2026-11-29T12:00", async (api) => {
+    const id = await reservar(api, INICIO);
+    const r = await cancelar(api, id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.estado, "cancelada");
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(r.cuerpo.reembolso, 1800);
+  });
+});
+
+test("tramos: el 25 % entre 24 y 48 horas, sin forzar", async () => {
+  await conReloj("2026-11-29T12:01", async (api) => {
+    const id = await reservar(api, INICIO);
+    const r = await cancelar(api, id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 450);
+    assert.equal(r.cuerpo.reembolso, 1350);
+  });
+});
+
+test("tramos: menos de 24 horas solo con forzar, y entonces el 50 %", async () => {
+  await conReloj("2026-11-30T12:01", async (api) => {
+    const id = await reservar(api, INICIO);
+    const sinForzar = await cancelar(api, id);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const conForzar = await cancelar(api, id, { forzar: true });
+    assert.equal(conForzar.status, 200);
+    assert.equal(conForzar.cuerpo.reserva.penalizacion, 900);
+    assert.equal(conForzar.cuerpo.reembolso, 900);
+  });
+});
+
+test("límite: a 24 horas justas se aplica el 25 % sin forzar", async () => {
+  await conReloj("2026-11-30T12:00", async (api) => {
+    const id = await reservar(api, INICIO);
+    const r = await cancelar(api, id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 450);
+    assert.equal(r.cuerpo.reembolso, 1350);
+  });
+});
+
+test("cambio de hora: del viernes 20:30 al domingo 21:00 hay 47,5 horas reales, así que hay 25 %", async () => {
+  // 26 de marzo de 2027 a las 20:30 (CET) y 28 a las 21:00 (CEST): 47,5 horas, no 48,5.
+  await conReloj("2027-03-26T20:30", async (api) => {
+    const id = await reservar(api, "2027-03-28T21:00", "pista-1");
+    const r = await cancelar(api, id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 700, "25 % de 2800");
+    assert.equal(r.cuerpo.reembolso, 2100);
+  });
+});
+
+test("cambio de hora: 48 horas reales justas, aunque en la hora de reloj sean 49, no tienen penalización", async () => {
+  // 26 de marzo a las 20:00 (CET) y 28 a las 21:00 (CEST): 48 horas reales.
+  await conReloj("2027-03-26T20:00", async (api) => {
+    const id = await reservar(api, "2027-03-28T21:00", "pista-1");
+    const r = await cancelar(api, id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(r.cuerpo.reembolso, 2800);
+  });
+});
+
+test("reserva pasada: no se cancela ni con exento", async () => {
+  await conReloj("2026-11-30T12:00", async (api) => {
+    const id = await reservar(api, INICIO);
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: INICIO } })).status, 200);
+    const normal = await cancelar(api, id, { forzar: true });
+    assert.equal(normal.status, 409);
+    assert.equal(normal.cuerpo.error.codigo, "RESERVA_PASADA");
+    const exenta = await cancelar(api, id, { exento: true, motivo: "Lesión de un socio" }, GESTOR);
+    assert.equal(exenta.status, 409);
+    assert.equal(exenta.cuerpo.error.codigo, "RESERVA_PASADA");
+  });
+});
+
+test("exención: un gestor cancela sin penalización y sin forzar, con motivo", async () => {
+  await conReloj("2026-11-30T13:00", async (api) => {
+    const id = await reservar(api, INICIO);
+    const motivo = "Pista encharcada por la lluvia";
+    const r = await cancelar(api, id, { exento: true, motivo }, GESTOR);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.estado, "cancelada");
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(r.cuerpo.reserva.motivoCancelacion, motivo);
+    assert.equal(r.cuerpo.reembolso, 1800);
+  });
+});
+
+test("exención: el motivo debe tener al menos 10 caracteres", async () => {
+  await conReloj("2026-11-30T13:00", async (api) => {
+    const id = await reservar(api, INICIO);
+    const sinMotivo = await cancelar(api, id, { exento: true }, GESTOR);
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const corto = await cancelar(api, id, { exento: true, motivo: "Lluvia ya" }, GESTOR);
+    assert.equal(corto.status, 400);
+    assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const soloEspacios = await cancelar(api, id, { exento: true, motivo: "          " }, GESTOR);
+    assert.equal(soloEspacios.status, 400);
+    // Ninguno de los intentos anteriores ha cancelado la reserva.
+    assert.equal((await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva.estado, "confirmada");
+  });
+});
+
+test("exención: solo un gestor, y sin X-Socio, 401", async () => {
+  await conReloj("2026-11-30T13:00", async (api) => {
+    const id = await reservar(api, INICIO);
+    const motivo = "Lesión de un socio";
+    const sinQuien = await cancelar(api, id, { exento: true, motivo });
+    assert.equal(sinQuien.status, 401);
+    assert.equal(sinQuien.cuerpo.error.codigo, "NO_IDENTIFICADO");
