+test("informe de caja: cobros por pista, con las pistas sin movimientos y el total del club", async () => {
+  const api = await arrancarApi();
+  try {
+    const { cuerpo: estado } = await api.pedir("GET", "/_estado");
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR });
+    assert.equal(informe.status, 200);
+    assert.equal(informe.cuerpo.mes, "2026-10");
+
+    // Recalculado a partir del estado de la semilla, sin usar la API.
+    const delMes = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+    const esperado = (filtro: (r: any) => boolean) => {
+      const rs = delMes.filter(filtro);
+      const cobradas = rs.filter((r: any) => r.estado === "confirmada" || r.estado === "no_presentada");
+      const ingresos = cobradas.reduce((s: number, r: any) => s + r.importe, 0);
+      const penalizaciones = rs.reduce((s: number, r: any) => s + (r.estado === "cancelada" ? r.penalizacion ?? 0 : 0), 0);
+      return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    };
+    const pistas = estado.pistas.map((p: any) => p.id).sort();
+    assert.deepEqual(informe.cuerpo.pistas.map((p: any) => p.pistaId), pistas);
+    for (const p of informe.cuerpo.pistas) {
+      assert.deepEqual({ reservas: p.reservas, ingresos: p.ingresos, penalizaciones: p.penalizaciones, total: p.total },
+        esperado((r: any) => r.pistaId === p.pistaId), p.pistaId);
+    }
+    assert.deepEqual(
+      { reservas: informe.cuerpo.total.reservas, ingresos: informe.cuerpo.total.ingresos, penalizaciones: informe.cuerpo.total.penalizaciones, total: informe.cuerpo.total.total },
+      esperado(() => true),
+    );
+    assert.ok(informe.cuerpo.total.total > 0);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("informe de caja: una cancelación con penalización cuenta en el mes de inicio de la reserva", async () => {
+  await conReloj("2026-11-30T13:00", async (api) => {
+    const cancelada = await reservar(api, INICIO, "pista-1");
+    await reservar(api, "2026-12-02T12:00", "pista-2");
+    const r = await cancelar(api, cancelada, { forzar: true }, SOCIO);
+    assert.equal(r.cuerpo.reembolso, 900);
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: GESTOR });
+    assert.equal(informe.status, 200);
+    const pista = (id: string) => informe.cuerpo.pistas.find((p: any) => p.pistaId === id);
+    // pista-1: la reserva cancelada solo aporta la penalización de 900.
+    assert.deepEqual(pista("pista-1"), { pistaId: "pista-1", reservas: 0, ingresos: 0, penalizaciones: 900, total: 900 });
+    // pista-2: una reserva confirmada de 1800 (martes a las 12:00, valle).
+    assert.deepEqual(pista("pista-2"), { pistaId: "pista-2", reservas: 1, ingresos: 1800, penalizaciones: 0, total: 1800 });
+    // pista-3 y pista-4: sin movimientos, pero presentes.
+    assert.deepEqual(pista("pista-3"), { pistaId: "pista-3", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+    assert.deepEqual(pista("pista-4"), { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+    assert.deepEqual(informe.cuerpo.total, { reservas: 1, ingresos: 1800, penalizaciones: 900, total: 2700 });
+  });
+});
