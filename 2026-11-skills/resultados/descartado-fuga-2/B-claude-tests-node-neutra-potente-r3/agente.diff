+const NORA = "socio-041";
+
+/** Arranca una API con estado propio, la cierra al terminar. */
+async function conApi(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+/** Crea una reserva con la hora del club en `creadaA` y deja el reloj en `cancelaA`. */
+async function reservaYReloj(api: Api, inicio: string, creadaA: string, cancelaA: string, pistaId = "pista-3") {
+  await reloj(api, creadaA);
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: NORA, pistaId, inicio } });
+  assert.equal(creada.status, 201, JSON.stringify(creada.cuerpo));
+  await reloj(api, cancelaA);
+  return creada.cuerpo.reserva as { id: string; importe: number };
+}
+
+const cancelar = (api: Api, id: string, cuerpo?: unknown, socio?: string) =>
+  api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+
+// Miércoles 25 de noviembre de 2026 a las 12:00, pista 3 en horario de valle: 1200 céntimos.
+const INICIO = "2026-11-25T12:00";
+
+test("C1 · con 48 horas o más de antelación no hay penalización", async () => {
+  await conApi(async (api) => {
+    const r = await reservaYReloj(api, INICIO, "2026-11-18T10:00", "2026-11-20T09:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.estado, "cancelada");
+    assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c.cuerpo.reembolso, 1200);
+  });
+});
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 % y no hace falta forzar", async () => {
+  await conApi(async (api) => {
