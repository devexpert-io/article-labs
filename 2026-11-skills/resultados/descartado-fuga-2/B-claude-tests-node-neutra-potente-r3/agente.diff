+test("C7 · el informe de un mes con historial cuadra con las reservas del mes, por fecha de inicio", async () => {
+  await conApi(async (api) => {
+    await cancelar(api, "R-0520", { forzar: true });
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const delMes = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-11"));
+    const esperado = (filtro: (r: any) => boolean) => {
+      const rs = delMes.filter(filtro);
+      const cobradas = rs.filter((r: any) => r.estado === "confirmada" || r.estado === "no_presentada");
+      const ingresos = cobradas.reduce((s: number, r: any) => s + r.importe, 0);
+      const penalizaciones = rs.filter((r: any) => r.estado === "cancelada").reduce((s: number, r: any) => s + (r.penalizacion ?? 0), 0);
+      return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    };
+    const r = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, {
+      mes: "2026-11",
+      pistas: ["pista-1", "pista-2", "pista-3", "pista-4"].map((pistaId) => ({ pistaId, ...esperado((x) => x.pistaId === pistaId) })),
+      total: esperado(() => true),
+    });
+    assert.equal(r.cuerpo.total.penalizaciones, 600);
+    assert.ok(r.cuerpo.pistas[3].reservas > 0, "la pista 4, cerrada desde el 9, tiene reservas de noviembre");
+  });
+});
