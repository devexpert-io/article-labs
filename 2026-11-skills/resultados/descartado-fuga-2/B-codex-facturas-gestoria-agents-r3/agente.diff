@@ -0,0 +1,150 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado, Factura } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+const generar = (api: Api, mes: unknown) => api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+async function reservar(api: Api, socioId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-1", inicio } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.reserva.id as string;
+}
+
+test("facturas: todos los endpoints requieren un gestor", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const [metodo, ruta] of [
+    ["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F2026-0001"],
+  ]) {
+    for (const [socio, status, codigo] of [
+      [undefined, 401, "NO_IDENTIFICADO"], ["socio-001", 403, "SIN_PERMISO"], ["socio-999", 401, "NO_IDENTIFICADO"],
+    ] as const) {
+      const r = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      assert.equal(r.status, status);
+      assert.equal(r.cuerpo.error.codigo, codigo);
+    }
+  }
+  assert.equal((await generar(api, "2026-10")).status, 201);
+});
+
+test("facturas: valida el mes y solo genera meses cerrados según el reloj del club", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const mes of [undefined, null, 202610, {}, "", "2026-1", "2026-00", "2026-13", "26-10", "2026-10-01", "2026-10\n"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400, JSON.stringify(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const ruta of ["/api/facturas", "/api/facturas?mes=2026-13"]) {
+    const r = await api.pedir("GET", ruta, { socio: gestor });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+});
+
+test("facturas: octubre tiene una factura por socio, líneas cronológicas, IVA y consultas estables", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const sinGenerar = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor });
+  assert.equal(sinGenerar.status, 200);
+  assert.deepEqual(sinGenerar.cuerpo, { facturas: [] });
+  const r = await generar(api, "2026-10");
+  assert.equal(r.status, 201);
+  const facturas: Factura[] = r.cuerpo.facturas;
+  const facturables = estado.reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(facturables.some((r) => r.estado === "no_presentada"));
+  const socios = [...new Set(facturables.map((r) => r.socioId))].sort();
+  assert.deepEqual(facturas.map((f) => f.socioId), socios);
+  assert.ok(!socios.includes("socio-041"));
+  for (const [i, f] of facturas.entries()) {
+    const reservas = facturables.filter((r) => r.socioId === f.socioId).sort((a, b) => a.inicio.localeCompare(b.inicio));
+    const total = reservas.reduce((s, r) => s + r.importe, 0);
+    assert.deepEqual(f, {
+      numero: `F2026-${String(i + 1).padStart(4, "0")}`, mes: "2026-10", socioId: socios[i],
+      lineas: reservas.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })),
+      total, base: Math.round(total * 100 / 121), iva: total - Math.round(total * 100 / 121),
+    });
+    const consulta = await api.pedir("GET", `/api/facturas/${f.numero}`, { socio: gestor });
+    assert.equal(consulta.status, 200);
+    assert.deepEqual(consulta.cuerpo, { factura: f });
+  }
+  // Dos peticiones simultáneas tampoco duplican facturas ni consumen números.
+  for (const repetida of await Promise.all([generar(api, "2026-10"), generar(api, "2026-10")])) {
+    assert.equal(repetida.status, 200);
+    assert.deepEqual(repetida.cuerpo, r.cuerpo);
+  }
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).cuerpo, r.cuerpo);
+  const inexistente = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: gestor });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, estado.reservas);
+});
+
+test("facturas: total de 6400, base 5289, IVA 1111 y cancelaciones con y sin penalización", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  // Se crean desordenadas para comprobar la ordenación de las líneas.
+  const punta = await reservar(api, "socio-041", "2026-12-03T18:00");
+  const primera = await reservar(api, "socio-041", "2026-12-01T09:00");
+  const penalizada = await reservar(api, "socio-041", "2026-12-02T09:00");
+  await reloj(api, "2026-12-01T10:00");
+  const cancelacion = await api.pedir("POST", `/api/reservas/${penalizada}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelacion.status, 200);
+  assert.equal(cancelacion.cuerpo.reserva.penalizacion, 1800);
+  const gratis = await reservar(api, "socio-041", "2026-12-04T09:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratis}/cancelar`)).status, 200);
+  const soloGratis = await reservar(api, "socio-002", "2026-12-05T09:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${soloGratis}/cancelar`)).status, 200);
+  await reloj(api, "2027-01-01T00:00");
+  const r = await generar(api, "2026-12");
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.cuerpo, { facturas: [{
+    numero: "F2026-0001", mes: "2026-12", socioId: "socio-041",
+    lineas: [
+      { reservaId: primera, concepto: "Reserva", importe: 1800 },
+      { reservaId: penalizada, concepto: "Penalización", importe: 1800 },
+      { reservaId: punta, concepto: "Reserva", importe: 2800 },
+    ], total: 6400, base: 5289, iva: 1111,
+  }] });
+});
+
+test("facturas: serie anual continua fuera de orden, diciembre generado en enero y meses vacíos", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  // El orden de creación de reservas tampoco determina el orden de socios.
+  await reservar(api, "socio-041", "2026-12-01T09:00");
+  await reservar(api, "socio-002", "2026-12-02T09:00");
+  await reloj(api, "2027-01-01T00:00");
+  const diciembre = await generar(api, "2026-12");
+  assert.deepEqual(diciembre.cuerpo.facturas.map((f: Factura) => [f.socioId, f.numero]), [
+    ["socio-002", "F2026-0001"], ["socio-041", "F2026-0002"],
+  ]);
+  const vacio = await generar(api, "2026-09");
+  assert.equal(vacio.status, 201);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  assert.equal((await generar(api, "2026-09")).status, 200);
+  const octubre = await generar(api, "2026-10");
+  assert.equal(octubre.cuerpo.facturas[0].numero, "F2026-0003");
+  assert.deepEqual((await generar(api, "2026-12")).cuerpo, diciembre.cuerpo);
+  const noviembre = await generar(api, "2026-11");
+  assert.equal(noviembre.cuerpo.facturas[0].numero, `F2026-${String(3 + octubre.cuerpo.facturas.length).padStart(4, "0")}`);
+  await reservar(api, "socio-041", "2027-01-04T09:00");
+  await reloj(api, "2027-02-01T00:00");
+  const enero = await generar(api, "2027-01");
+  assert.equal(enero.cuerpo.facturas[0].numero, "F2027-0001");
+  assert.deepEqual((await generar(api, "2026-10")).cuerpo, octubre.cuerpo);
+  const todas: Factura[] = [...diciembre.cuerpo.facturas, ...octubre.cuerpo.facturas, ...noviembre.cuerpo.facturas];
+  assert.deepEqual(todas.map((f) => f.numero), todas.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+});
