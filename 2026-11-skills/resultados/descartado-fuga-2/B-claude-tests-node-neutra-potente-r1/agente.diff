+test("C7 · el informe de octubre cuadra con las reservas que empiezan ese mes", async (t) => {
+  const api = await apiNueva(t);
+  const { reservas, pistas } = (await api.pedir("GET", "/_estado")).cuerpo;
+  const esperado = (pistaId?: string) => {
+    const delMes = reservas.filter((r: any) => r.inicio.startsWith("2026-10-") && (!pistaId || r.pistaId === pistaId));
+    const cobradas = delMes.filter((r: any) => r.estado === "confirmada" || r.estado === "no_presentada");
+    const ingresos = cobradas.reduce((s: number, r: any) => s + r.importe, 0);
+    const penalizaciones = delMes.filter((r: any) => r.estado === "cancelada").reduce((s: number, r: any) => s + (r.penalizacion ?? 0), 0);
+    return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+  };
+  const r = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, {
+    mes: "2026-10",
+    pistas: pistas.map((p: any) => p.id).sort().map((pistaId: string) => ({ pistaId, ...esperado(pistaId) })),
+    total: esperado(),
+  });
+  assert.ok(r.cuerpo.total.reservas > 0);
+  assert.ok(r.cuerpo.pistas.find((p: any) => p.pistaId === "pista-4").reservas > 0, "la pista 4 tuvo reservas en octubre");
+});
