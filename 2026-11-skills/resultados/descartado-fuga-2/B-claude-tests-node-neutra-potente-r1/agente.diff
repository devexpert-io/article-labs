--- /dev/null
+++ b/test/reembolsos.test.ts
@@ -0,0 +1,348 @@
+// Spec docs/specs/reembolsos.md: penalizaciones escalonadas, exención por un gestor e informe de caja.
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-041"; // Nora Benítez: cuota al día y sin reservas.
+
+/** Una API con su propio estado, que se cierra al acabar el test. */
+async function apiNueva(t: TestContext): Promise<Api> {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+async function moverReloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+/** Crea una reserva de Nora en la pista 2 (2800 en punta, 1800 en valle) y devuelve su id. */
+async function reservar(api: Api, inicio: string, pistaId = "pista-2"): Promise<string> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIO, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva.id;
+}
+
+function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+// --- C1 · Tramos ---------------------------------------------------------
+
+test("C1 · con 48 horas o más de antelación no hay penalización", async (t) => {
+  const api = await apiNueva(t);
+  const id = await reservar(api, "2026-11-23T18:00", "pista-3"); // lunes 18:00, punta: 2000. Faltan 128 horas.
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 2000);
+});
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 % y no hace falta forzar", async (t) => {
+  const api = await apiNueva(t);
+  const id = await reservar(api, "2026-11-20T09:00"); // viernes 09:00, valle: 1800. Faltan 47 horas.
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r.cuerpo.reserva.penalizacion, 450);
+  assert.equal(r.cuerpo.reembolso, 1350);
+});
+
+test("C1 · con menos de 24 horas sin forzar responde 409 FUERA_DE_PLAZO y no cancela", async (t) => {
+  const api = await apiNueva(t);
+  const id = await reservar(api, "2026-11-19T09:00", "pista-1"); // faltan 23 horas
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const falso = await cancelar(api, id, { forzar: false });
+  assert.equal(falso.status, 409);
+  assert.equal(falso.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const sigue = await api.pedir("GET", `/api/reservas/${id}`);
+  assert.equal(sigue.cuerpo.reserva.estado, "confirmada");
+  assert.equal(sigue.cuerpo.reserva.penalizacion, undefined);
+});
+
+test("C1 · con menos de 24 horas y forzar la penalización es el 50 %", async (t) => {
+  const api = await apiNueva(t);
+  const id = await reservar(api, "2026-11-19T09:00", "pista-1"); // valle: 1800
+  const r = await cancelar(api, id, { forzar: true });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r.cuerpo.reserva.penalizacion, 900);
+  assert.equal(r.cuerpo.reembolso, 900);
+});
+
+// --- C2 · Límites exactos ------------------------------------------------
+
+test("C2 · a 48 horas justas no hay penalización, y un minuto después ya es el 25 %", async (t) => {
+  const api = await apiNueva(t);
+  const id = await reservar(api, "2026-11-20T12:00"); // valle: 1800
+  await moverReloj(api, "2026-11-18T12:00");
+  const justas = await cancelar(api, id);
+  assert.equal(justas.status, 200);
+  assert.equal(justas.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(justas.cuerpo.reembolso, 1800);
+
+  const otra = await reservar(api, "2026-11-20T13:30");
+  await moverReloj(api, "2026-11-18T13:31");
+  const minuto = await cancelar(api, otra);
+  assert.equal(minuto.status, 200);
+  assert.equal(minuto.cuerpo.reserva.penalizacion, 450);
+});
+
+test("C2 · a 24 horas justas se aplica el 25 % sin forzar, y un minuto después hace falta forzar", async (t) => {
+  const api = await apiNueva(t);
+  const id = await reservar(api, "2026-11-20T12:00"); // valle: 1800
+  await moverReloj(api, "2026-11-19T12:00");
+  const justas = await cancelar(api, id);
+  assert.equal(justas.status, 200);
+  assert.equal(justas.cuerpo.reserva.penalizacion, 450);
+  assert.equal(justas.cuerpo.reembolso, 1350);
+
+  const otra = await reservar(api, "2026-11-20T13:30");
+  await moverReloj(api, "2026-11-19T13:31");
+  const minuto = await cancelar(api, otra);
+  assert.equal(minuto.status, 409);
+  assert.equal(minuto.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+});
+
+// --- C3 · Cambio de hora -------------------------------------------------
+
+test("C3 · del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas: 25 %", async (t) => {
+  const api = await apiNueva(t);
+  await moverReloj(api, "2027-03-26T20:30");
+  const id = await reservar(api, "2027-03-28T21:00"); // domingo, punta: 2800
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 700);
+  assert.equal(r.cuerpo.reembolso, 2100);
+});
+
+test("C3 · con el adelanto de marzo, 49 horas de reloj son 48 reales: sin penalización", async (t) => {
+  const api = await apiNueva(t);
+  await moverReloj(api, "2027-03-26T20:00");
+  const id = await reservar(api, "2027-03-28T21:00");
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 2800);
+});
+
+test("C3 · con el retraso de octubre, 23 horas de reloj son 24 reales: 25 % sin forzar", async (t) => {
+  const api = await apiNueva(t);
+  // La madrugada del domingo 31 de octubre de 2027 los relojes se atrasan una hora.
+  await moverReloj(api, "2027-10-30T10:00");
+  const id = await reservar(api, "2027-10-31T09:00"); // domingo, punta: 2800
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
