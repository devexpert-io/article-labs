+test("C7 · una cancelación con penalización suma a penalizaciones y deja de contar como ingreso", async (t) => {
+  const api = await apiNueva(t);
+  const antes = (await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR })).cuerpo;
+  const id = await reservar(api, "2026-11-19T09:00", "pista-1"); // 1800
+  const conReserva = (await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR })).cuerpo;
+  const p1 = (informe: any) => informe.pistas.find((p: any) => p.pistaId === "pista-1");
+  assert.equal(p1(conReserva).reservas, p1(antes).reservas + 1);
+  assert.equal(p1(conReserva).ingresos, p1(antes).ingresos + 1800);
+
+  assert.equal((await cancelar(api, id, { forzar: true })).status, 200); // penalización: 900
+  const despues = (await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR })).cuerpo;
+  assert.deepEqual(p1(despues), {
+    ...p1(antes),
+    penalizaciones: p1(antes).penalizaciones + 900,
+    total: p1(antes).total + 900,
+  });
+  assert.deepEqual(despues.total, {
+    ...antes.total,
+    penalizaciones: antes.total.penalizaciones + 900,
+    total: antes.total.total + 900,
+  });
+});
