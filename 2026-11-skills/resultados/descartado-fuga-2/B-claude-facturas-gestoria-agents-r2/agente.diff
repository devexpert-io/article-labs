index 0000000..ec03e31
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,180 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const generar = (api: Api, mes: unknown, socio = GESTOR) => api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio });
+const reloj = (api: Api, ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+const reservar = async (api: Api, socioId: string, pistaId: string, inicio: string) => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.reserva;
+};
+
+test("permisos: solo un gestor genera y consulta facturas", () => conApi(async (api) => {
+  await reloj(api, "2026-12-01T09:00");
+  const llamadas = [
+    (socio?: string) => api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio }),
+    (socio?: string) => api.pedir("GET", "/api/facturas?mes=2026-10", { socio }),
+    (socio?: string) => api.pedir("GET", "/api/facturas/F2026-0001", { socio }),
+  ];
+  for (const llamada of llamadas) {
+    const anonimo = await llamada();
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await llamada("socio-004");
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  // Ninguna de esas llamadas ha generado nada.
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, 0);
+}));
+
+test("mes: formato AAAA-MM y solo meses cerrados", () => conApi(async (api) => {
+  for (const mes of ["2026-13", "2026-1", "octubre", 202610, undefined]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400, `mes ${mes}`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026/10", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409, `mes ${mes}`);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  // El 1 de diciembre a las 00:00 noviembre ya ha terminado.
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+}));
+
+test("octubre de 2026: una factura por socio, líneas, totales e IVA", () => conApi(async (api) => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const octubre = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+  const facturables = octubre.filter((r: any) => r.estado !== "cancelada" || r.penalizacion > 0);
+  assert.ok(octubre.some((r: any) => r.estado === "cancelada"), "octubre trae cancelaciones");
+  assert.ok(octubre.some((r: any) => r.estado === "no_presentada"), "octubre trae no presentados");
+  const socios = [...new Set(facturables.map((r: any) => r.socioId))].sort();
+
+  const r = await generar(api, "2026-10");
+  assert.equal(r.status, 201);
+  const { facturas } = r.cuerpo;
+  assert.deepEqual(facturas.map((f: any) => f.socioId), socios, "una factura por socio con algo que facturar, por orden de id");
+  assert.deepEqual(facturas.map((f: any) => f.numero), socios.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+  for (const f of facturas) {
+    const suyas = facturables.filter((x: any) => x.socioId === f.socioId).sort((a: any, b: any) => a.inicio.localeCompare(b.inicio));
+    assert.equal(f.mes, "2026-10");
+    assert.deepEqual(f.lineas, suyas.map((x: any) => ({ reservaId: x.id, concepto: "Reserva", importe: x.importe })));
+    assert.equal(f.total, suyas.reduce((s: number, x: any) => s + x.importe, 0));
+    assert.equal(f.base, Math.round(f.total * 100 / 121));
+    assert.equal(f.base + f.iva, f.total);
+  }
+  // Las cancelaciones sin penalización no entran.
+  const lineas = new Set(facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId)));
+  for (const c of octubre.filter((x: any) => x.estado === "cancelada")) assert.ok(!lineas.has(c.id));
+  for (const n of octubre.filter((x: any) => x.estado === "no_presentada")) assert.ok(lineas.has(n.id));
+
+  // Consultar el mes y una factura.
+  const listado = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(listado.status, 200);
+  assert.deepEqual(listado.cuerpo.facturas, facturas);
+  const una = await api.pedir("GET", `/api/facturas/${facturas[2].numero}`, { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo.factura, facturas[2]);
+  const vacio = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  const noExiste = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+  assert.equal(noExiste.status, 404);
+  assert.equal(noExiste.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+
+  // Generar otra vez: las mismas facturas, con 200, sin crear ninguna.
+  const otraVez = await generar(api, "2026-10");
+  assert.equal(otraVez.status, 200);
+  assert.deepEqual(otraVez.cuerpo.facturas, facturas);
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, facturas.length);
+
+  // Las reservas no cambian.
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, estado.reservas);
+}));
+
+test("penalizaciones: una cancelación con penalización entra como Penalización y una gratuita no", () => conApi(async (api) => {
+  const penalizada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(penalizada.cuerpo.reserva.penalizacion, 1200);
+  const socioPenalizado = penalizada.cuerpo.reserva.socioId;
+  const gratis = await reservar(api, "socio-003", "pista-3", "2026-11-25T12:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`)).cuerpo.reserva.penalizacion, undefined);
+
+  await reloj(api, "2026-12-01T09:00");
+  const { facturas } = (await generar(api, "2026-11")).cuerpo;
+  const suya = facturas.find((f: any) => f.socioId === socioPenalizado);
+  assert.deepEqual(suya.lineas.find((l: any) => l.reservaId === "R-0520"), { reservaId: "R-0520", concepto: "Penalización", importe: 1200 });
+  assert.ok(!facturas.some((f: any) => f.lineas.some((l: any) => l.reservaId === gratis.id)));
+}));
+
+test("IVA sobre el total: 1.800 + 1.800 + 2.800 dan base 5.289 e IVA 1.111", () => conApi(async (api) => {
+  // Nora Benítez no tiene reservas: tres en diciembre, dos de valle y una de punta en la pista 1.
+  await reservar(api, "socio-041", "pista-1", "2026-12-02T18:00");
+  await reservar(api, "socio-041", "pista-1", "2026-12-02T09:00");
+  await reservar(api, "socio-041", "pista-1", "2026-12-02T10:30");
+  await reloj(api, "2027-01-05T09:00");
+  const { facturas } = (await generar(api, "2026-12")).cuerpo;
+  assert.equal(facturas.length, 1);
+  const [f] = facturas;
+  assert.equal(f.socioId, "socio-041");
+  assert.deepEqual(f.lineas.map((l: any) => l.importe), [1800, 1800, 2800], "ordenadas por inicio");
+  assert.deepEqual({ total: f.total, base: f.base, iva: f.iva }, { total: 6400, base: 5289, iva: 1111 });
+}));
+
+test("numeración: serie por año del mes facturado, correlativa y fuera de orden", () => conApi(async (api) => {
+  // Reservas futuras para diciembre de 2026 y enero de 2027.
+  await reservar(api, "socio-041", "pista-1", "2026-12-02T09:00");
+  await reservar(api, "socio-003", "pista-2", "2027-01-13T09:00");
+
+  await reloj(api, "2026-11-20T09:00");
+  const octubre = (await generar(api, "2026-10")).cuerpo.facturas;
+  const n = octubre.length;
+  assert.equal(octubre.at(-1).numero, `F2026-${String(n).padStart(4, "0")}`);
+
+  // Un mes sin facturas no gasta números.
+  const septiembre = await generar(api, "2026-09");
+  assert.equal(septiembre.status, 201);
+  assert.deepEqual(septiembre.cuerpo.facturas, []);
+  assert.equal((await generar(api, "2026-09")).status, 200);
+
+  // Diciembre de 2026 generado en enero de 2027 sigue la serie de 2026.
+  await reloj(api, "2027-01-02T09:00");
+  const diciembre = (await generar(api, "2026-12")).cuerpo.facturas;
+  assert.deepEqual(diciembre.map((f: any) => f.numero), [`F2026-${String(n + 1).padStart(4, "0")}`]);
+
+  // Noviembre, generado después de diciembre, sigue donde lo dejó diciembre.
+  const noviembre = (await generar(api, "2026-11")).cuerpo.facturas;
+  assert.ok(noviembre.length > 0);
+  assert.deepEqual(noviembre.map((f: any) => f.numero), noviembre.map((_: unknown, i: number) => `F2026-${String(n + 2 + i).padStart(4, "0")}`));
+  assert.deepEqual(noviembre.map((f: any) => f.socioId), noviembre.map((f: any) => f.socioId).sort());
+
+  // Enero de 2027 empieza la serie de 2027.
+  await reloj(api, "2027-02-01T09:00");
+  const enero = (await generar(api, "2027-01")).cuerpo.facturas;
+  assert.deepEqual(enero.map((f: any) => [f.numero, f.socioId]), [["F2027-0001", "socio-003"]]);
+
+  // Repetir un mes no gasta números.
+  const repetido = await generar(api, "2026-12");
+  assert.equal(repetido.status, 200);
+  assert.deepEqual(repetido.cuerpo.facturas, diciembre);
+
+  // Ni huecos ni repetidos en ninguna serie.
+  const todas = (await api.pedir("GET", "/_estado")).cuerpo.facturas.map((f: any) => f.numero).sort();
+  const de2026 = todas.filter((x: string) => x.startsWith("F2026-"));
+  assert.deepEqual(de2026, de2026.map((_: string, i: number) => `F2026-${String(i + 1).padStart(4, "0")}`));
+  assert.deepEqual(todas.filter((x: string) => x.startsWith("F2027-")), ["F2027-0001"]);
+}));
