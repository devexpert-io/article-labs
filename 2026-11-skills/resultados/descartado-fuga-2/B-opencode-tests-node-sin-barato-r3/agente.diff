+++ b/test/reembolsos.test.ts
@@ -0,0 +1,204 @@
+// La política de cancelación escalonada, la exención de gestores y el informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(ahora: string | undefined, prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi(ahora ? { AHORA: ahora } : {});
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function crear(api: Api, inicio: string, pistaId = "pista-1") {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId, inicio } });
+  assert.equal(respuesta.status, 201, respuesta.texto);
+  return respuesta.cuerpo.reserva as { id: string; importe: number };
+}
+
+function resumen(reservas: any[]) {
+  const cobradas = reservas.filter((r) => r.estado === "confirmada" || r.estado === "no_presentada");
+  const canceladas = reservas.filter((r) => r.estado === "cancelada");
+  const ingresos = cobradas.reduce((suma, r) => suma + r.importe, 0);
+  const penalizaciones = canceladas.reduce((suma, r) => suma + (r.penalizacion ?? 0), 0);
+  return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+}
+
+test("48 horas o más de antelación: no hay penalización (también a las 48 justas)", async () => {
+  await conApi(undefined, async (api) => {
+    const reserva = await crear(api, "2026-11-20T09:00");
+    const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T09:00" } });
+    assert.equal(reloj.status, 200);
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada.cuerpo.reembolso, reserva.importe);
+  });
+});
+
+test("entre 24 y 48 horas: 25 % del importe (también a las 24 justas)", async () => {
+  await conApi(undefined, async (api) => {
+    const reserva = await crear(api, "2026-11-20T09:00");
+    const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-19T09:00" } });
+    assert.equal(reloj.status, 200);
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 450);
+    assert.equal(cancelada.cuerpo.reembolso, reserva.importe - 450);
+  });
+});
+
+test("menos de 24 horas: 409 sin forzar y 50 % con forzar", async () => {
+  await conApi(undefined, async (api) => {
+    const reserva = await crear(api, "2026-11-19T09:00");
+    const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T12:00" } });
+    assert.equal(reloj.status, 200);
+
+    const sinForzar = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+
+    const forzada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+  });
+});
+
+test("el cambio de hora se cuenta en horas reales de Madrid", async () => {
+  await conApi(undefined, async (api) => {
+    // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00: 47,5 horas reales.
+    const reserva = await crear(api, "2027-03-28T21:00");
+    const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-26T20:30" } });
+    assert.equal(reloj.status, 200);
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    // 25 % de 2800 (domingo, punta): con 48,5 horas ingenuas no habría penalización.
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  });
+});
+
+test("un gestor exime con motivo sin necesidad de forzar y lo guarda", async () => {
+  await conApi(undefined, async (api) => {
+    const reserva = await crear(api, "2026-11-19T09:00");
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo: "Compromiso familiar" },
+    });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada.cuerpo.reserva.motivoCancelacion, "Compromiso familiar");
+    assert.equal(cancelada.cuerpo.reembolso, reserva.importe);
+  });
+});
+
+test("la exención exige motivo de al menos 10 caracteres", async () => {
+  for (const cuerpo of [{ exento: true }, { exento: true, motivo: "corto" }]) {
+    await conApi(undefined, async (api) => {
+      const reserva = await crear(api, "2026-11-19T09:00");
+      const respuesta = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { socio: "socio-040", cuerpo });
+      assert.equal(respuesta.status, 400);
+      assert.equal(respuesta.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    });
+  }
+});
+
+test("la exención es solo para gestores identificados", async () => {
+  await conApi(undefined, async (api) => {
+    const reserva = await crear(api, "2026-11-19T09:00");
+    const sinPermiso = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-041",
+      cuerpo: { exento: true, motivo: "Compromiso familiar" },
+    });
+    assert.equal(sinPermiso.status, 403);
+    assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const sinIdentificar = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "Compromiso familiar" },
+    });
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  });
+});
+
+test("una reserva que ya ha empezado no se cancela, tampoco con exento", async () => {
+  await conApi(undefined, async (api) => {
+    const pasadas = await api.pedir("GET", "/api/reservas?hasta=2026-11-17&estado=confirmada&limite=1");
+    const id = pasadas.cuerpo.reservas[0].id;
+    const respuesta = await api.pedir("POST", `/api/reservas/${id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo: "Compromiso familiar" },
+    });
+    assert.equal(respuesta.status, 409);
+    assert.equal(respuesta.cuerpo.error.codigo, "RESERVA_PASADA");
+  });
+});
+
+test("el informe de caja es solo para gestores", async () => {
+  await conApi(undefined, async (api) => {
+    const sinIdentificar = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinPermiso = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-041" });
+    assert.equal(sinPermiso.status, 403);
+    assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const gestor = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-040" });
+    assert.equal(gestor.status, 200);
+  });
+});
