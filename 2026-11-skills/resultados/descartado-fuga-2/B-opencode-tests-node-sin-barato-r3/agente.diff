+test("el informe de caja cuadra con las reservas del mes", async () => {
+  await conApi(undefined, async (api) => {
+    // Una cancelación con penalización para que el informe no salga todo a cero.
+    const reserva = await crear(api, "2026-11-19T09:00");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T12:00" } });
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.status, 200);
+
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const informe = (await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-040" })).cuerpo;
+
+    assert.equal(informe.mes, "2026-11");
+    assert.deepEqual(informe.pistas.map((p: any) => p.pistaId), estado.pistas.map((p: any) => p.id).sort());
+    for (const fila of informe.pistas) {
+      const delMes = estado.reservas.filter((r: any) => r.pistaId === fila.pistaId && r.inicio.slice(0, 7) === "2026-11");
+      assert.deepEqual(fila, { pistaId: fila.pistaId, ...resumen(delMes) });
+    }
+    const delMes = estado.reservas.filter((r: any) => r.inicio.slice(0, 7) === "2026-11");
+    assert.deepEqual(informe.total, resumen(delMes));
+    assert.equal(informe.total.total, informe.pistas.reduce((suma: number, p: any) => suma + p.total, 0));
+    assert.ok(informe.pistas.find((p: any) => p.pistaId === "pista-1").penalizaciones >= 900);
+  });
+});
+
