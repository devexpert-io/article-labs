+test("el informe rechaza un mes mal formado", async () => {
+  await conApi(undefined, async (api) => {
+    for (const mes of ["2026-13", "2026-1", "noviembre", ""]) {
+      const respuesta = await api.pedir("GET", `/api/informes/caja?mes=${encodeURIComponent(mes)}`, { socio: "socio-040" });
