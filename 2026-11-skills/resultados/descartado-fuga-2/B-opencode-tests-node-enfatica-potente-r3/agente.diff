+test("C7 · informe de caja: solo gestores, por mes, con una entrada por pista y el total del club", async () => {
+  const api = await arrancarApi();
+  try {
+    await reloj(api, "2027-03-03T09:00");
+
+    const aCancelar = await crear(api, "socio-003", "pista-2", "2027-03-04T09:00"); // jueves, valle 1800
+    await crear(api, "socio-003", "pista-2", "2027-03-05T09:00"); // viernes, valle 1800
+    await crear(api, "socio-004", "pista-3", "2027-03-08T09:00"); // lunes, valle 1200
+    const cancelada = await api.pedir("POST", `/api/reservas/${aCancelar.id}/cancelar`);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 450); // 25 % de 1800
+
+    const sinIdentidad = await api.pedir("GET", "/api/informes/caja?mes=2027-03");
+    assert.equal(sinIdentidad.status, 401);
+    assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const noGestor = await api.pedir("GET", "/api/informes/caja?mes=2027-03", { socio: "socio-001" });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const malMes = await api.pedir("GET", "/api/informes/caja?mes=2027-3", { socio: "socio-040" });
+    assert.equal(malMes.status, 400);
+    assert.equal(malMes.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2027-03", { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+    assert.deepEqual(informe.cuerpo, {
+      mes: "2027-03",
+      pistas: [
+        { pistaId: "pista-1", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+        { pistaId: "pista-2", reservas: 1, ingresos: 1800, penalizaciones: 450, total: 2250 },
+        { pistaId: "pista-3", reservas: 1, ingresos: 1200, penalizaciones: 0, total: 1200 },
+        { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+      ],
+      total: { reservas: 2, ingresos: 3000, penalizaciones: 450, total: 3450 },
+    });
+  } finally {
+    api.cerrar();
+  }
+});
