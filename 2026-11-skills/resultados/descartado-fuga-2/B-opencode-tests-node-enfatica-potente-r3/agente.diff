+// La política de cancelación escalonada, la exención y el informe de caja, probados por la API.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+async function crear(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva as { id: string; importe: number };
+}
+
+test("C1 · tramos: sin penalización a 48h o más, 25 % entre 24 y 48, 50 % con forzar antes de 24", async () => {
+  const api = await arrancarApi();
+  try {
+    await reloj(api, "2027-03-03T09:00");
+
+    const libre = await crear(api, "socio-003", "pista-2", "2027-03-05T12:00"); // 51 horas, valle 1800
+    const parcial = await crear(api, "socio-004", "pista-2", "2027-03-04T10:30"); // 25,5 horas, valle 1800
+    const total = await crear(api, "socio-005", "pista-2", "2027-03-03T16:30"); // 7,5 horas, valle 1800
+
+    const sinPenalizacion = await api.pedir("POST", `/api/reservas/${libre.id}/cancelar`);
+    assert.equal(sinPenalizacion.status, 200);
+    assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(sinPenalizacion.cuerpo.reembolso, 1800);
+
+    const conParcial = await api.pedir("POST", `/api/reservas/${parcial.id}/cancelar`);
+    assert.equal(conParcial.status, 200);
+    assert.equal(conParcial.cuerpo.reserva.penalizacion, 450);
+    assert.equal(conParcial.cuerpo.reembolso, 1350);
+
+    const fueraDePlazo = await api.pedir("POST", `/api/reservas/${total.id}/cancelar`);
+    assert.equal(fueraDePlazo.status, 409);
+    assert.equal(fueraDePlazo.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+
+    const forzada = await api.pedir("POST", `/api/reservas/${total.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C2 · límites exactos: a 48 horas justas no hay penalización y a 24 justas es el 25 %", async () => {
+  const api = await arrancarApi();
+  try {
+    await reloj(api, "2027-03-03T09:00");
+
+    const justo48 = await crear(api, "socio-003", "pista-2", "2027-03-05T09:00"); // 48 horas justas, valle 1800
+    const justo24 = await crear(api, "socio-004", "pista-2", "2027-03-04T09:00"); // 24 horas justas, valle 1800
+
+    const a48 = await api.pedir("POST", `/api/reservas/${justo48.id}/cancelar`);
+    assert.equal(a48.status, 200);
+    assert.equal(a48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(a48.cuerpo.reembolso, 1800);
+
+    const a24 = await api.pedir("POST", `/api/reservas/${justo24.id}/cancelar`);
+    assert.equal(a24.status, 200);
+    assert.equal(a24.cuerpo.reserva.penalizacion, 450);
+    assert.equal(a24.cuerpo.reembolso, 1350);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C3 · cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  const api = await arrancarApi();
+  try {
+    // Viernes 26 de marzo 20:30 → domingo 28 21:00 son 47,5 horas reales (la madrugada se adelanta una hora).
+    await reloj(api, "2027-03-26T20:30");
+    const reserva = await crear(api, "socio-003", "pista-2", "2027-03-28T21:00"); // domingo, punta 2800
+
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700); // 25 % de 2800, no el 0 % de un cálculo sin cambio de hora
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C4 · reembolso: la respuesta incluye lo que se devuelve al socio", async () => {
+  const api = await arrancarApi();
+  try {
+    await reloj(api, "2027-03-03T09:00");
+    const gratis = await crear(api, "socio-003", "pista-2", "2027-03-05T09:00"); // 48 horas justas
+    const conPenalizacion = await crear(api, "socio-004", "pista-2", "2027-03-04T09:00"); // 24 horas justas
+
+    const a = await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`);
+    assert.equal(a.cuerpo.reserva.importe, 1800);
+    assert.equal(a.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(a.cuerpo.reembolso, a.cuerpo.reserva.importe);
+
+    const b = await api.pedir("POST", `/api/reservas/${conPenalizacion.id}/cancelar`);
+    assert.equal(b.cuerpo.reserva.penalizacion, 450);
+    assert.equal(b.cuerpo.reembolso, b.cuerpo.reserva.importe - b.cuerpo.reserva.penalizacion);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C5 · exención: solo un gestor exime, con un motivo de al menos 10 caracteres", async () => {
+  const api = await arrancarApi();
+  try {
+    await reloj(api, "2027-03-03T09:00");
+
+    const exenta = await crear(api, "socio-003", "pista-2", "2027-03-03T16:30"); // a 7,5 horas: necesitaría forzar
+    const sinMotivo = await crear(api, "socio-003", "pista-2", "2027-03-03T15:00");
+    const motivoCorto = await crear(api, "socio-003", "pista-2", "2027-03-03T13:30");
+    const noGestor = await crear(api, "socio-004", "pista-2", "2027-03-03T12:00");
+    const sinIdentidad = await crear(api, "socio-004", "pista-2", "2027-03-03T10:30");
+
+    const ok = await api.pedir("POST", `/api/reservas/${exenta.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "Competición oficial suspendida por lluvia" },
+      socio: "socio-040",
+    });
+    assert.equal(ok.status, 200);
+    assert.equal(ok.cuerpo.reserva.estado, "cancelada");
+    assert.equal(ok.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(ok.cuerpo.reserva.motivoCancelacion, "Competición oficial suspendida por lluvia");
+    assert.equal(ok.cuerpo.reembolso, 1800);
+
+    const sinMotivoRes = await api.pedir("POST", `/api/reservas/${sinMotivo.id}/cancelar`, {
+      cuerpo: { exento: true },
+      socio: "socio-040",
+    });
+    assert.equal(sinMotivoRes.status, 400);
+    assert.equal(sinMotivoRes.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const cortoRes = await api.pedir("POST", `/api/reservas/${motivoCorto.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "corto" },
+      socio: "socio-040",
+    });
+    assert.equal(cortoRes.status, 400);
+    assert.equal(cortoRes.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const noGestorRes = await api.pedir("POST", `/api/reservas/${noGestor.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "Motivo suficientemente largo" },
