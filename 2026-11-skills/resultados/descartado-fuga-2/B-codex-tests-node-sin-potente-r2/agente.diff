+test("las reservas canceladas conservan la penalización y no admiten recálculo", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const reserva = await crear(api);
+  await reloj(api, "2027-02-20T20:00");
+  const ruta = `/api/reservas/${reserva.id}/cancelar`;
+  const cancelada = await api.pedir("POST", ruta, { cuerpo: { forzar: true, motivo: "Cancelación solicitada" } });
+  assert.equal(cancelada.status, 200);
+  await reloj(api, "2027-02-01T10:00");
+  for (const cuerpo of [{}, { exento: true, motivo: "Exención posterior" }]) {
+    error(await api.pedir("POST", ruta, { socio: gestor, cuerpo }), 409, "YA_CANCELADA");
+  }
+  assert.deepEqual((await api.pedir("GET", `/api/reservas/${reserva.id}`)).cuerpo.reserva, cancelada.cuerpo.reserva);
+  const anteriores = (await api.pedir("GET", "/_estado")).cuerpo.reservas.filter((r: Reserva) => r.estado === "cancelada");
+  await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: gestor });
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas.filter((r: Reserva) => r.estado === "cancelada"), anteriores);
