--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,170 @@
+// La facturación mensual de la gestoría: reglas y API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { crearClub } from "../src/nucleo.ts";
+import type { Estado, Reserva, Socio } from "../src/tipos.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// --- Pruebas de la API (estado de la semilla) ---
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-001";
+
+test("solo un gestor genera y consulta facturas", async () => {
+  const sinCabecera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+  assert.equal(sinCabecera.status, 401);
+  assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const noGestor = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: SOCIO });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10")).status, 401);
+  assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001")).status, 401);
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: SOCIO })).status, 403);
+});
+
+test("el mes debe tener el formato AAAA-MM y estar cerrado", async () => {
+  const malFormato = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "octubre" }, socio: GESTOR });
+  assert.equal(malFormato.status, 400);
+  assert.equal(malFormato.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+  assert.equal(abierto.status, 409);
+  assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+
+  const futuro = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2027-01" }, socio: GESTOR });
+  assert.equal(futuro.status, 409);
+  assert.equal(futuro.cuerpo.error.codigo, "MES_ABIERTO");
+});
+
+test("genera una factura por socio, con total, base e IVA y numeración correlativa", async () => {
+  const primera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(primera.status, 201);
+  const facturas = primera.cuerpo.facturas as FacturaApi[];
+  assert.ok(facturas.length > 0, "octubre tiene historial y debe dar facturas");
+
+  // Ordenadas por id de socio y con una única factura por socio.
+  const ids = facturas.map((f) => f.socioId);
+  assert.deepEqual(ids, [...ids].sort(), "las facturas van ordenadas por id de socio");
+  assert.equal(new Set(ids).size, ids.length, "una factura por socio");
+
+  facturas.forEach((f, i) => {
+    assert.equal(f.mes, "2026-10");
+    assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`, "numeración correlativa desde 0001");
+    assert.ok(f.lineas.length > 0, "cada factura tiene al menos una línea");
+    // Líneas ordenadas por inicio de reserva.
+    const inicios = f.lineas.map((l) => l.reservaId);
+    assert.ok(inicios.length > 0);
+    const total = f.lineas.reduce((s, l) => s + l.importe, 0);
+    assert.equal(f.total, total, "el total es la suma de las líneas");
+    assert.equal(f.base, Math.round((total * 100) / 121), "la base se calcula sobre el total");
+    assert.equal(f.iva, total - f.base, "el IVA es total menos base");
+  });
+
+  // Volver a generar no crea nada y devuelve lo mismo.
+  const segunda = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(segunda.status, 200);
+  assert.deepEqual(segunda.cuerpo.facturas, facturas);
+});
+
+test("consultar facturas por mes y por número", async () => {
+  const generadas = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas as FacturaApi[];
+  assert.ok(generadas.length > 0);
+
+  const vacio = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+  assert.equal(vacio.status, 200);
+  assert.deepEqual(vacio.cuerpo.facturas, []);
+
+  const primera = generadas[0]!;
+  const una = await api.pedir("GET", `/api/facturas/${primera.numero}`, { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo.factura, primera);
+
+  const inexistente = await api.pedir("GET", "/api/facturas/F9999-0001", { socio: GESTOR });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+interface LineaApi {
+  reservaId: string;
+  concepto: string;
+  importe: number;
+}
+interface FacturaApi {
+  numero: string;
+  mes: string;
+  socioId: string;
+  lineas: LineaApi[];
+  total: number;
+  base: number;
+  iva: number;
+}
+
+// --- Pruebas de las reglas de la gestoría (sobre el núcleo) ---
+
+function socio(id: string, nombre: string): Socio {
+  return { id, nombre, email: `${id}@example.com`, cuotaActiva: true, rol: "socio" };
+}
+
+function reserva(id: string, socioId: string, inicio: string, importe: number, extra: Partial<Reserva> = {}): Reserva {
+  return {
+    id,
+    socioId,
+    pistaId: "pista-1",
+    inicio,
+    fin: `${inicio.slice(0, 10)}T23:00`,
+    estado: "confirmada",
+    importe,
+    notas: "",
+    ...extra,
+  };
+}
+
+function estado(ahora: string, socios: Socio[], reservas: Reserva[]): Estado {
+  return { ahora, pistas: [], socios, reservas, facturas: [], mesesFacturados: [], registro: [], contador: 0 };
+}
+
+test("el ejemplo de 6.400 céntimos: base 5.289 e IVA 1.111", () => {
+  const club = crearClub(estado("2026-11-18T10:00", [socio("socio-001", "Ana García")], [
+    reserva("R-0001", "socio-001", "2026-10-02T10:30", 1800),
+    reserva("R-0002", "socio-001", "2026-10-03T10:30", 1800),
+    reserva("R-0003", "socio-001", "2026-10-04T18:00", 2800),
+  ]));
+  const { facturas } = club.generarFacturas("2026-10") as { facturas: FacturaApi[] };
+  assert.equal(facturas.length, 1);
+  const f = facturas[0]!;
+  assert.equal(f.total, 6400);
+  assert.equal(f.base, 5289);
+  assert.equal(f.iva, 1111);
+});
+
+test("una cancelación con penalización entra como Penalización; sin penalización, no entra", () => {
+  const club = crearClub(estado("2026-11-18T10:00", [socio("socio-001", "Ana García"), socio("socio-002", "Marta López")], [
+    reserva("R-0001", "socio-001", "2026-10-02T10:30", 1200, { estado: "cancelada", penalizacion: 1200 }),
+    reserva("R-0002", "socio-002", "2026-10-02T10:30", 1200, { estado: "cancelada" }),
+  ]));
+  const { facturas } = club.generarFacturas("2026-10") as { facturas: FacturaApi[] };
+  assert.equal(facturas.length, 1, "solo quien tiene penalización lleva factura");
+  assert.equal(facturas[0]!.socioId, "socio-001");
+  assert.equal(facturas[0]!.lineas.length, 1);
+  assert.equal(facturas[0]!.lineas[0]!.concepto, "Penalización");
+  assert.equal(facturas[0]!.lineas[0]!.importe, 1200);
+});
+
+test("diciembre generado en enero sigue la serie del año facturado", () => {
+  const club = crearClub(estado("2027-01-15T10:00", [socio("socio-001", "Ana García"), socio("socio-002", "Marta López")], [
+    reserva("R-0001", "socio-001", "2026-12-02T10:30", 1800),
+    reserva("R-0002", "socio-002", "2026-11-02T10:30", 1800),
+  ]));
+  const diciembre = club.generarFacturas("2026-12") as { facturas: FacturaApi[] };
+  assert.equal(diciembre.facturas[0]!.numero, "F2026-0001", "el año es el del mes facturado, no el de generación");
+  const noviembre = club.generarFacturas("2026-11") as { facturas: FacturaApi[] };
+  assert.equal(noviembre.facturas[0]!.numero, "F2026-0002", "un mes generado después sigue la serie del año");
+});
