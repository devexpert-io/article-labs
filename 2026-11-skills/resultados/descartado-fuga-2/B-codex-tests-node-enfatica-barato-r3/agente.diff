+
+test("C9 · README documenta la política, la exención y caja", async () => {
+  const fs = await import("node:fs/promises");
+  const readme = await fs.readFile("README.md", "utf8");
+  assert.equal(readme.includes("48 horas"), true); assert.equal(readme.includes("exento"), true); assert.equal(readme.includes("/api/informes/caja"), true);
