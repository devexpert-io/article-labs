+  assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "Acuerdo con recepción");
+}));
+
+test("C6 · una reserva iniciada no se cancela ni con exención", async () => conApi(async (api) => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-19T09:00" } });
