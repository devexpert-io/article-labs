+}));
+
+test("C7 · informe mensual por pista, permisos y mes inválido", async () => conApi(async (api) => {
+  const anon = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
+  assert.equal(anon.status, 401); assert.deepEqual(anon.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-003" });
+  assert.equal(socio.status, 403); assert.deepEqual(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const invalido = await api.pedir("GET", "/api/informes/caja?mes=2026-1", { socio: "socio-040" });
+  assert.equal(invalido.status, 400); assert.deepEqual(invalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const esperado = estado.pistas.map((p: any) => {
+    const rs = estado.reservas.filter((r: any) => r.pistaId === p.id && r.inicio.startsWith("2026-11-"));
+    const cobrables = rs.filter((r: any) => r.estado === "confirmada" || r.estado === "no_presentada");
+    const penalizaciones = rs.filter((r: any) => r.estado === "cancelada").reduce((s: number, r: any) => s + (r.penalizacion ?? 0), 0);
+    const ingresos = cobrables.reduce((s: number, r: any) => s + r.importe, 0);
+    return { pistaId: p.id, reservas: cobrables.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+  }).sort((a: any, b: any) => a.pistaId.localeCompare(b.pistaId));
+  const resultado = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-040" });
+  assert.equal(resultado.status, 200); assert.deepEqual(resultado.cuerpo.pistas, esperado);
+  assert.deepEqual(resultado.cuerpo.total, esperado.reduce((s: any, p: any) => ({ reservas: s.reservas + p.reservas, ingresos: s.ingresos + p.ingresos, penalizaciones: s.penalizaciones + p.penalizaciones, total: s.total + p.total }), { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 }));
+  const vacio = await api.pedir("GET", "/api/informes/caja?mes=2026-09", { socio: "socio-040" });
+  assert.equal(vacio.status, 200); assert.equal(vacio.cuerpo.pistas.length, 4); assert.deepEqual(vacio.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+}));
+
+test("C8 · una cancelación ya registrada conserva su penalización", async () => conApi(async (api) => {
+  const primera = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  const antes = (await api.pedir("GET", "/api/reservas/R-0520")).cuerpo.reserva.penalizacion;
+  const segunda = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { socio: "socio-040", cuerpo: { exento: true, motivo: "Cambio de decisión" } });
+  assert.equal(primera.status, 200); assert.equal(segunda.status, 409); assert.deepEqual(segunda.cuerpo.error.codigo, "YA_CANCELADA");
+  const despues = (await api.pedir("GET", "/api/reservas/R-0520")).cuerpo.reserva.penalizacion;
+  assert.equal(despues, antes);
