+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try { await fn(api); } finally { api.cerrar(); }
+}
+
+test("C1 · tramos: libre, 25 % y 50 % con forzar", async () => conApi(async (api) => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-17T09:00" } });
+  const libre = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+  assert.equal(libre.status, 200); assert.equal(libre.cuerpo.reserva.penalizacion, undefined); assert.equal(libre.cuerpo.reembolso, 1200);
+  const mediaApi = await arrancarApi();
+  try {
+    await mediaApi.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-17T10:00" } });
+    // 47 hours before the seeded reservation.
+    const media = await mediaApi.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(media.status, 200); assert.equal(media.cuerpo.reserva.penalizacion, 300); assert.equal(media.cuerpo.reembolso, 900);
+  } finally { mediaApi.cerrar(); }
+  const forzadaApi = await arrancarApi();
+  try {
+    const forzada = await forzadaApi.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200); assert.equal(forzada.cuerpo.reserva.penalizacion, 600); assert.equal(forzada.cuerpo.reembolso, 600);
+  } finally { forzadaApi.cerrar(); }
+}));
+
+test("C2 · los límites de 48 y 24 horas son inclusivos", async () => conApi(async (api) => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-17T09:00" } });
+  const a48 = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+  assert.equal(a48.status, 200); assert.equal(a48.cuerpo.reembolso, a48.cuerpo.reserva.importe);
+  // Use a fresh API state for the 24-hour boundary.
+  const otra = await arrancarApi();
+  try {
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T09:00" } });
+    const a24 = await otra.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(a24.status, 200); assert.equal(a24.cuerpo.reserva.penalizacion, 300);
+  } finally { otra.cerrar(); }
+}));
+
+test("C3 · la antelación respeta el cambio de hora de Madrid", async () => conApi(async (api) => {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-26T20:30" } })).status, 200);
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-03-28T21:00" } });
+  assert.equal(creada.status, 201);
+  const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+  assert.equal(cancelada.status, 200); assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+  assert.equal(cancelada.cuerpo.reembolso, 2100);
+}));
+
+test("C4 · el reembolso equivale al importe menos la penalización", async () => conApi(async (api) => {
+  const r = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(r.status, 200); assert.equal(r.cuerpo.reembolso, r.cuerpo.reserva.importe - r.cuerpo.reserva.penalizacion);
+}));
+
+test("C5 · exención, motivo y permisos", async () => conApi(async (api) => {
+  const sinId = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { exento: true, motivo: "Excepción recepción" } });
+  assert.equal(sinId.status, 401); assert.deepEqual(sinId.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { socio: "socio-003", cuerpo: { exento: true, motivo: "Excepción recepción" } });
+  assert.equal(socio.status, 403); assert.deepEqual(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const motivo = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { socio: "socio-040", cuerpo: { exento: true, motivo: "corto" } });
