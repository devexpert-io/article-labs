+test("C4 · el reembolso es el importe menos la penalización, o el importe entero sin penalización", () => conClub(async (api) => {
+  await ponerReloj(api, "2026-11-19T12:00");
+  const sin = await reservar(api, "pista-2", "2026-11-22T12:00"); // 71 horas
+  const parcial = await reservar(api, "pista-3", "2026-11-21T09:00"); // 45 horas
+  const tardia = await reservar(api, "pista-3", "2026-11-20T10:30"); // 22,5 horas, con forzar
+  const r1 = await cancelar(api, sin.id);
+  assert.equal(r1.cuerpo.reembolso, sin.importe);
+  const r2 = await cancelar(api, parcial.id);
