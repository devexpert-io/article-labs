+++ b/test/reembolsos.test.ts
@@ -0,0 +1,310 @@
+// Política de cancelación escalonada, exención de gestores e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-041"; // Nora Benítez: cuota al día y sin reservas.
+
+/** Arranca una API nueva (estado propio) y la cierra al terminar la prueba. */
+async function conClub(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function ponerReloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+async function reservar(api: Api, pistaId: string, inicio: string, socioId = SOCIO) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+}
+
+function cancelar(api: Api, id: string, cuerpo: Record<string, unknown> = {}, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+async function estadoDe(api: Api, id: string): Promise<string> {
+  return (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva.estado;
+}
+
+// --- C1 · Tramos -----------------------------------------------------------
+
+test("C1 · sin penalización con 48 horas o más de antelación", () => conClub(async (api) => {
+  await ponerReloj(api, "2026-11-18T10:00");
+  const reserva = await reservar(api, "pista-3", "2026-11-21T12:00"); // sábado, punta: 2000
+  const r = await cancelar(api, reserva.id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 2000);
+}));
+
+test("C1 · con 24 horas o más y menos de 48, penaliza el 25 %", () => conClub(async (api) => {
+  await ponerReloj(api, "2026-11-19T12:00");
+  const reserva = await reservar(api, "pista-3", "2026-11-21T10:30"); // 46,5 horas antes
+  const r = await cancelar(api, reserva.id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 500);
+  assert.equal(r.cuerpo.reembolso, 1500);
+}));
+
+test("C1 · con menos de 24 horas, sin forzar, no se cancela (409 FUERA_DE_PLAZO)", () => conClub(async (api) => {
+  await ponerReloj(api, "2026-11-20T12:00");
+  const reserva = await reservar(api, "pista-3", "2026-11-21T10:30"); // 22,5 horas antes
+  const r = await cancelar(api, reserva.id);
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  assert.equal(await estadoDe(api, reserva.id), "confirmada");
+}));
+
+test("C1 · con menos de 24 horas y forzar, penaliza el 50 %", () => conClub(async (api) => {
+  await ponerReloj(api, "2026-11-20T12:00");
+  const reserva = await reservar(api, "pista-3", "2026-11-21T10:30");
+  const r = await cancelar(api, reserva.id, { forzar: true });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 1000);
+  assert.equal(r.cuerpo.reembolso, 1000);
+}));
+
+// --- C2 · Límites exactos --------------------------------------------------
+
+test("C2 · a 48 horas justas no hay penalización", () => conClub(async (api) => {
+  await ponerReloj(api, "2026-11-19T10:30");
+  const reserva = await reservar(api, "pista-3", "2026-11-21T10:30");
+  const r = await cancelar(api, reserva.id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 2000);
+}));
+
+test("C2 · a un minuto de las 48 horas ya se penaliza el 25 %", () => conClub(async (api) => {
+  await ponerReloj(api, "2026-11-19T10:31"); // 47 horas y 59 minutos
+  const reserva = await reservar(api, "pista-3", "2026-11-21T10:30");
+  const r = await cancelar(api, reserva.id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 500);
+  assert.equal(r.cuerpo.reembolso, 1500);
+}));
+
+test("C2 · a 24 horas justas se penaliza el 25 % sin necesidad de forzar", () => conClub(async (api) => {
+  await ponerReloj(api, "2026-11-20T10:30");
+  const reserva = await reservar(api, "pista-3", "2026-11-21T10:30");
+  const r = await cancelar(api, reserva.id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 500);
+  assert.equal(r.cuerpo.reembolso, 1500);
+}));
+
+test("C2 · a un minuto de las 24 horas hace falta forzar y cobra el 50 %", () => conClub(async (api) => {
+  await ponerReloj(api, "2026-11-20T10:31"); // 23 horas y 59 minutos
+  const reserva = await reservar(api, "pista-3", "2026-11-21T10:30");
+  const sinForzar = await cancelar(api, reserva.id);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await cancelar(api, reserva.id, { forzar: true });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1000);
+}));
+
+// --- C3 · Cambio de hora ---------------------------------------------------
+
+test("C3 · el cambio de hora de primavera cuenta como una hora real (47,5 horas, no 48,5)", () => conClub(async (api) => {
+  await ponerReloj(api, "2027-03-26T20:30"); // viernes, hora de invierno
+  const reserva = await reservar(api, "pista-3", "2027-03-28T21:00"); // domingo, hora de verano
+  const r = await cancelar(api, reserva.id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, reserva.importe / 4);
+  assert.equal(r.cuerpo.reembolso, reserva.importe - reserva.importe / 4);
+}));
+
+test("C3 · el cambio de hora de otoño suma una hora (48,5 horas, no 47,5)", () => conClub(async (api) => {
+  await ponerReloj(api, "2027-10-30T21:30"); // hora de verano
+  const reserva = await reservar(api, "pista-3", "2027-11-01T21:00"); // hora de invierno
+  const r = await cancelar(api, reserva.id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, reserva.importe);
+}));
+
+// --- C4 · Reembolso --------------------------------------------------------
