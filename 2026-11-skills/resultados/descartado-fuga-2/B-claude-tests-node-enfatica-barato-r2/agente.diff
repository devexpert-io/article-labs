+  assert.equal(octubre.some((r: { estado: string }) => r.estado === "no_presentada"), true, "octubre debe tener no presentadas");
+  assert.equal(octubre.some((r: { estado: string }) => r.estado === "cancelada"), true, "octubre debe tener canceladas");
+  const cobradas = octubre.filter((r: { estado: string }) => r.estado !== "cancelada");
+  const ingresos = cobradas.reduce((suma: number, r: { importe: number }) => suma + r.importe, 0);
+  const r = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo.total, { reservas: cobradas.length, ingresos, penalizaciones: 0, total: ingresos });
+  assert.equal(r.cuerpo.pistas.length, 4);
+}));
