+    const anonimo = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { exento: true, motivo: "Aval del gestor" } });
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const socio = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { exento: true, motivo: "Aval del gestor" }, socio: "socio-003" });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const corto = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { exento: true, motivo: "corto" }, socio: "socio-040" });
+    assert.equal(corto.status, 400);
+    assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const sinMotivo = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { exento: true }, socio: "socio-040" });
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const exento = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { exento: true, motivo: "Aval del gestor por avería" }, socio: "socio-040" });
+    assert.equal(exento.status, 200);
+    assert.equal(exento.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exento.cuerpo.reserva.motivoCancelacion, "Aval del gestor por avería");
+    assert.equal(exento.cuerpo.reembolso, 2800);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C6 · una reserva ya empezada no se cancela, tampoco con exento", async () => {
+  const api = await arrancarApi({ AHORA: "2027-03-10T10:00" });
+  try {
+    const r = await reservar(api, "socio-003", "pista-1", "2027-03-10T12:00");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-10T12:30" } });
+
