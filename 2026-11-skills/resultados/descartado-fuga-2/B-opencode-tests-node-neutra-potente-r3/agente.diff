+++ b/test/reembolsos.test.ts
@@ -0,0 +1,198 @@
+// Penalizaciones escalonadas, exención por un gestor e informe de caja, probados a través de la API.
+// Cada test arranca su propia API (semilla nueva) y fija la hora con AHORA para no depender de otros tests.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function reservar(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201);
+  return r.cuerpo.reserva as { id: string };
+}
+
+test("C1 · la penalización depende del tramo de antelación", async () => {
+  const api = await arrancarApi({ AHORA: "2027-03-10T10:00" });
+  try {
+    // 48 horas o más: sin penalización.
+    const lejos = await reservar(api, "socio-003", "pista-1", "2027-03-13T10:30");
+    const cLejos = await api.pedir("POST", `/api/reservas/${lejos.id}/cancelar`);
+    assert.equal(cLejos.status, 200);
+    assert.equal(cLejos.cuerpo.reserva.penalizacion, undefined);
+
+    // 24 horas o más y menos de 48: penalización del 25 % del importe.
+    const medio = await reservar(api, "socio-003", "pista-1", "2027-03-11T12:00");
+    const cMedio = await api.pedir("POST", `/api/reservas/${medio.id}/cancelar`);
+    assert.equal(cMedio.status, 200);
+    assert.equal(cMedio.cuerpo.reserva.penalizacion, 450);
+    assert.equal(cMedio.cuerpo.reembolso, 1350);
+
+    // Menos de 24 horas: solo con forzar, y la penalización es del 50 %.
+    const cerca = await reservar(api, "socio-003", "pista-2", "2027-03-10T18:00");
+    const sinForzar = await api.pedir("POST", `/api/reservas/${cerca.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const conForzar = await api.pedir("POST", `/api/reservas/${cerca.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(conForzar.status, 200);
+    assert.equal(conForzar.cuerpo.reserva.penalizacion, 1400);
+    assert.equal(conForzar.cuerpo.reembolso, 1400);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C2 · a 48 horas justas no hay penalización y a 24 horas justas se aplica el 25 %", async () => {
+  const api = await arrancarApi({ AHORA: "2027-03-10T09:00" });
+  try {
+    const en48 = await reservar(api, "socio-003", "pista-1", "2027-03-12T09:00");
+    const c48 = await api.pedir("POST", `/api/reservas/${en48.id}/cancelar`);
+    assert.equal(c48.status, 200);
+    assert.equal(c48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c48.cuerpo.reembolso, 1800);
+
+    const en24 = await reservar(api, "socio-003", "pista-1", "2027-03-11T09:00");
+    const c24 = await api.pedir("POST", `/api/reservas/${en24.id}/cancelar`);
+    assert.equal(c24.status, 200);
+    assert.equal(c24.cuerpo.reserva.penalizacion, 450);
+    assert.equal(c24.cuerpo.reembolso, 1350);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C3 · la antelación cuenta las horas reales de Madrid con el cambio de hora", async () => {
+  // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales
+  // (esa madrugada los relojes se adelantan una hora): entra en el tramo del 25 %, no en el gratuito.
+  const api = await arrancarApi({ AHORA: "2027-03-26T20:30" });
+  try {
+    const r = await reservar(api, "socio-003", "pista-1", "2027-03-28T21:00");
+    const c = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, 700);
+    assert.equal(c.cuerpo.reembolso, 2100);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C4 · la cancelación responde el reembolso: importe menos penalización", async () => {
+  const api = await arrancarApi({ AHORA: "2027-03-10T10:00" });
+  try {
+    // Sin penalización: el reembolso es el importe entero.
+    const gratis = await reservar(api, "socio-003", "pista-1", "2027-03-13T10:30");
+    const cGratis = await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`);
+    assert.equal(cGratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cGratis.cuerpo.reembolso, 2800);
+
+    // Con penalización: el reembolso es el importe menos la penalización.
+    const parcial = await reservar(api, "socio-003", "pista-1", "2027-03-11T12:00");
+    const cParcial = await api.pedir("POST", `/api/reservas/${parcial.id}/cancelar`);
+    assert.equal(cParcial.cuerpo.reserva.penalizacion, 450);
+    assert.equal(cParcial.cuerpo.reembolso, 1800 - 450);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C5 · solo un gestor puede eximir, con un motivo de al menos 10 caracteres", async () => {
+  const api = await arrancarApi({ AHORA: "2027-03-10T10:00" });
+  try {
+    // 8 horas antes: fuera de plazo sin exención.
+    const r = await reservar(api, "socio-003", "pista-1", "2027-03-10T18:00");
