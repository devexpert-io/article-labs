diff --git a/test/facturas.test.ts b/test/facturas.test.ts
new file mode 100644
index 0000000..3022b8f
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,159 @@
+// Facturas mensuales (docs/specs/facturas.md), con las reglas de facturación de la gestoría.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const generar = (api: Api, mes: unknown, socio = GESTOR) => api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio });
+const reloj = async (api: Api, ahora: string) => assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+const reservar = async (api: Api, socioId: string, pistaId: string, inicio: string) => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.reserva;
+};
+
+test("solo un gestor genera y consulta facturas", () => conApi(async (api) => {
+  await reloj(api, "2026-12-01T10:00");
+  for (const [metodo, ruta, cuerpo] of [
+    ["POST", "/api/facturas", { mes: "2026-10" }],
+    ["GET", "/api/facturas?mes=2026-10", undefined],
+    ["GET", "/api/facturas/F2026-0001", undefined],
+  ] as const) {
+    const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-001" });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas.length, 0, "no se ha generado nada");
+}));
+
+test("mes con formato AAAA-MM y ya terminado", () => conApi(async (api) => {
+  for (const mes of [undefined, "2026-10-01", "2026-13", "2026-1", 202610]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400, `mes ${mes}`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=octubre", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj(api, "2026-11-30T23:59");
+  assert.equal((await generar(api, "2026-11")).cuerpo.error.codigo, "MES_ABIERTO");
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+}));
+
+test("octubre: una factura por socio con sus líneas, total, IVA y números; repetir y consultar", () => conApi(async (api) => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const octubre = estado.reservas
+    .filter((r: any) => r.inicio.startsWith("2026-10"))
+    .sort((a: any, b: any) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+  assert.ok(octubre.some((r: any) => r.estado === "cancelada"), "octubre tiene cancelaciones");
+  assert.ok(octubre.some((r: any) => r.estado === "no_presentada"), "octubre tiene no presentados");
+  const facturables = octubre.filter((r: any) => r.estado !== "cancelada" || r.penalizacion > 0);
+  const socios = [...new Set(facturables.map((r: any) => r.socioId))].sort() as string[];
+
+  const r = await generar(api, "2026-10");
+  assert.equal(r.status, 201);
+  const facturas = r.cuerpo.facturas;
+  assert.deepEqual(facturas.map((f: any) => f.socioId), socios, "una por socio con algo que facturar, por orden de id");
+  facturas.forEach((f: any, i: number) => {
+    assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.mes, "2026-10");
+    const esperadas = facturables.filter((x: any) => x.socioId === f.socioId)
+      .map((x: any) => ({ reservaId: x.id, concepto: "Reserva", importe: x.importe }));
+    assert.deepEqual(f.lineas, esperadas);
+    const total = esperadas.reduce((s: number, l: any) => s + l.importe, 0);
+    assert.equal(f.total, total);
+    assert.equal(f.base, Math.round((total * 100) / 121));
+    assert.equal(f.iva, total - f.base);
+  });
+  const facturadas = new Set(facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId)));
+  for (const c of octubre.filter((x: any) => x.estado === "cancelada")) assert.ok(!facturadas.has(c.id), `${c.id} cancelada sin penalización`);
+  for (const n of octubre.filter((x: any) => x.estado === "no_presentada")) assert.ok(facturadas.has(n.id), `${n.id} no presentada`);
+
+  const otra = await generar(api, "2026-10");
+  assert.equal(otra.status, 200);
+  assert.deepEqual(otra.cuerpo.facturas, facturas);
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, facturas.length, "no crea facturas nuevas");
+
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas, facturas);
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR })).cuerpo.facturas, []);
+  const una = await api.pedir("GET", `/api/facturas/${facturas[2].numero}`, { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo.factura, facturas[2]);
+  const ninguna = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+  assert.equal(ninguna.status, 404);
+  assert.equal(ninguna.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+
+  // Lo demás no cambia.
+  assert.equal((await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=1")).cuerpo.total, 315);
+}));
+
+test("una cancelación con penalización entra como Penalización y una sin penalización no entra", () => conApi(async (api) => {
+  const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1200);
+  const gratis = await reservar(api, "socio-003", "pista-3", "2026-11-24T12:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`)).cuerpo.reserva.estado, "cancelada");
+
+  await reloj(api, "2026-12-01T09:00");
+  const facturas = (await generar(api, "2026-11")).cuerpo.facturas;
+  const marta = facturas.find((f: any) => f.socioId === "socio-002");
+  assert.deepEqual(marta.lineas.find((l: any) => l.reservaId === "R-0520"), { reservaId: "R-0520", concepto: "Penalización", importe: 1200 });
+  assert.ok(!facturas.some((f: any) => f.lineas.some((l: any) => l.reservaId === gratis.id)), "la cancelación gratuita no se factura");
+}));
+
+test("IVA sobre el total: 6.400 céntimos dan base 5.289 e IVA 1.111", () => conApi(async (api) => {
+  // Nora Benítez no tiene reservas: le ponemos 1.800 + 1.800 + 2.800 en diciembre.
+  await reservar(api, "socio-041", "pista-1", "2026-12-01T09:00");
+  await reservar(api, "socio-041", "pista-1", "2026-12-02T09:00");
+  await reservar(api, "socio-041", "pista-1", "2026-12-05T09:00");
+  await reloj(api, "2027-01-05T10:00");
+  const [nora] = (await generar(api, "2026-12")).cuerpo.facturas;
+  assert.deepEqual(nora.lineas.map((l: any) => l.importe), [1800, 1800, 2800]);
+  assert.deepEqual({ total: nora.total, base: nora.base, iva: nora.iva }, { total: 6400, base: 5289, iva: 1111 });
+}));
+
+test("numeración: serie por año del mes facturado, correlativa aunque se genere fuera de orden", () => conApi(async (api) => {
+  await reservar(api, "socio-041", "pista-1", "2026-12-01T09:00");
+  await reservar(api, "socio-003", "pista-3", "2027-01-12T09:00");
+
+  // Diciembre de 2026, generado en enero de 2027, después de noviembre y antes que octubre.
+  await reloj(api, "2027-01-05T10:00");
+  const noviembre = (await generar(api, "2026-11")).cuerpo.facturas;
+  const diciembre = (await generar(api, "2026-12")).cuerpo.facturas;
+  assert.equal(diciembre.length, 1);
