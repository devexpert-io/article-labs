+    const estadoRespuesta = await api.pedir("GET", "/_estado");
+    assert.equal(estadoRespuesta.status, 200);
+    const estado: Estado = estadoRespuesta.cuerpo;
+    if (mes === "2026-10") assert.ok(estado.reservas.some(r => r.estado === "no_presentada" && r.inicio.startsWith(mes)));
+    const pistas = estado.pistas.map(p => {
+      const reservas = estado.reservas.filter(r => r.pistaId === p.id && r.inicio.startsWith(mes));
+      const cobradas = reservas.filter(r => r.estado === "confirmada" || r.estado === "no_presentada");
+      const ingresos = cobradas.reduce((s, r) => s + r.importe, 0);
+      const penalizaciones = reservas.filter(r => r.estado === "cancelada").reduce((s, r) => s + (r.penalizacion ?? 0), 0);
+      return { pistaId: p.id, reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    }).sort((a, b) => a.pistaId.localeCompare(b.pistaId));
+    const total = pistas.reduce((s, p) => ({ reservas: s.reservas + p.reservas, ingresos: s.ingresos + p.ingresos,
+      penalizaciones: s.penalizaciones + p.penalizaciones, total: s.total + p.total }),
+    { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+    const r = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: "socio-040" });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, { mes, pistas, total });
+    if (mes === "2026-12") assert.deepEqual(r.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 300, total: 300 });
+    if (mes === "2027-01") assert.deepEqual(r.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+  }
+});
+
+test("C8 · crear conserva precios y reglas, y las canceladas no se recalculan", async () => {
+  const inicial = await api.pedir("GET", "/_estado");
+  assert.equal(inicial.status, 200);
+  const historicas = (inicial.cuerpo as Estado).reservas.filter(r => r.estado === "cancelada");
+  assert.ok(historicas.length > 0);
+  const reserva = await crear("2026-12-01T12:00", "pista-3");
+  assert.equal(reserva.importe, 1200);
+  const r = await cancelar(reserva.id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reembolso, 1200);
+  error(await cancelar(reserva.id, { exento: true, motivo: "Motivo suficiente" }, "socio-040"), 409, "YA_CANCELADA");
+  for (const anterior of historicas.slice(0, 1)) {
+    error(await cancelar(anterior.id, { forzar: true }), 409, "YA_CANCELADA");
+  }
+  const final = await api.pedir("GET", "/_estado");
+  assert.equal(final.status, 200);
+  assert.deepEqual((final.cuerpo as Estado).reservas.filter(r => historicas.some(h => h.id === r.id)), historicas);
+});
