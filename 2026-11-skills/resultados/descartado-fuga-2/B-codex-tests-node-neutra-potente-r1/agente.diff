+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+  assert.equal(typeof r.cuerpo.error.mensaje, "string");
+}
+
+async function reloj(ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { ahora });
+}
+
+async function crear(inicio = "2027-03-28T21:00", pistaId = "pista-1") : Promise<Reserva> {
+  const r = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio },
+  });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.estado, "confirmada");
+  return r.cuerpo.reserva;
+}
+
+function cancelar(id: string, cuerpo: unknown = {}, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+for (const [ahora, porcentaje, forzar] of [
+  ["2027-03-25T21:00", 0, false],
+  ["2027-03-27T09:00", 0.25, false],
+  ["2027-03-28T09:00", 0.5, true],
+] as const) {
+  test(`C1 · tramo de penalización ${porcentaje * 100} %`, async () => {
+    const reserva = await crear();
+    await reloj(ahora);
+    if (forzar) {
+      error(await cancelar(reserva.id), 409, "FUERA_DE_PLAZO");
+      error(await cancelar(reserva.id, { forzar: false }), 409, "FUERA_DE_PLAZO");
+      const intacta = await api.pedir("GET", `/api/reservas/${reserva.id}`);
+      assert.equal(intacta.status, 200);
+      assert.deepEqual(intacta.cuerpo, { reserva });
+    }
+    const r = await cancelar(reserva.id, { forzar });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, {
+      reserva: { ...reserva, estado: "cancelada", penalizacion: reserva.importe * porcentaje },
+      reembolso: reserva.importe * (1 - porcentaje),
