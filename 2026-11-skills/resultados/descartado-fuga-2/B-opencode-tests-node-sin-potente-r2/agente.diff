+++ b/test/reembolsos.test.ts
@@ -0,0 +1,178 @@
+// La política de cancelación escalonada, la exención de gestor y el informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(entorno: Record<string, string>, fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+/** Crea una reserva futura sin competencia y devuelve su id e importe. */
+async function crear(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(respuesta.status, 201, `crear ${inicio}: ${JSON.stringify(respuesta.cuerpo)}`);
+  return respuesta.cuerpo.reserva as { id: string; importe: number };
+}
+
+test("tramos: 48h o más gratis, 24-48h el 25 %, menos de 24h el 50 % con forzar", async () => {
+  await conApi({ AHORA: "2027-01-05T09:00" }, async (api) => {
+    const lejana = await crear(api, "socio-003", "pista-1", "2027-01-20T12:00");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-18T12:00" } }); // 48 horas justas
+    const gratis = await api.pedir("POST", `/api/reservas/${lejana.id}/cancelar`);
+    assert.equal(gratis.cuerpo.reserva.estado, "cancelada");
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, lejana.importe);
+
+    const parcial = await crear(api, "socio-004", "pista-2", "2027-01-20T18:00");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-19T06:00" } }); // 36 horas antes
+    const p25 = await api.pedir("POST", `/api/reservas/${parcial.id}/cancelar`);
+    assert.equal(p25.cuerpo.reserva.penalizacion, Math.round(parcial.importe * 0.25));
+    assert.equal(p25.cuerpo.reembolso, parcial.importe - Math.round(parcial.importe * 0.25));
+
+    const corta = await crear(api, "socio-005", "pista-3", "2027-01-20T15:00");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-20T09:00" } }); // 6 horas antes
+    const sinForzar = await api.pedir("POST", `/api/reservas/${corta.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${corta.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, Math.round(corta.importe * 0.5));
+    assert.equal(forzada.cuerpo.reembolso, corta.importe - Math.round(corta.importe * 0.5));
+  });
+});
+
+test("límites exactos: a 48 horas justas no hay penalización y a 24 horas justas es el 25 %", async () => {
+  await conApi({ AHORA: "2027-01-05T09:00" }, async (api) => {
+    const justo48 = await crear(api, "socio-003", "pista-1", "2027-01-12T10:30");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-10T10:30" } }); // 48 h exactas
+    const r48 = await api.pedir("POST", `/api/reservas/${justo48.id}/cancelar`);
+    assert.equal(r48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(r48.cuerpo.reembolso, justo48.importe);
+
+    const justo24 = await crear(api, "socio-004", "pista-2", "2027-01-12T12:00");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-11T12:00" } }); // 24 h exactas, sin forzar
+    const r24 = await api.pedir("POST", `/api/reservas/${justo24.id}/cancelar`);
+    assert.equal(r24.cuerpo.reserva.penalizacion, Math.round(justo24.importe * 0.25));
+    assert.equal(r24.cuerpo.reembolso, justo24.importe - Math.round(justo24.importe * 0.25));
+  });
+});
+
+test("cambio de hora: la antelación cuenta las horas reales de Madrid", async () => {
+  await conApi({ AHORA: "2027-03-24T09:00" }, async (api) => {
+    // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas (esa madrugada se adelanta una hora).
+    const reserva = await crear(api, "socio-003", "pista-1", "2027-03-28T21:00");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-26T20:30" } });
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, Math.round(reserva.importe * 0.25));
+  });
+});
+
+test("exención: un gestor exime con motivo y se registra", async () => {
+  await conApi({ AHORA: "2027-01-05T09:00" }, async (api) => {
+    const reserva = await crear(api, "socio-003", "pista-1", "2027-01-10T21:00");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-10T09:00" } }); // menos de 24 h
+    const exenta = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo: "Compromiso del club con el socio" },
+    });
+    assert.equal(exenta.status, 200);
+    assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "Compromiso del club con el socio");
+    assert.equal(exenta.cuerpo.reembolso, reserva.importe);
+  });
+});
+
+test("exención: el motivo es obligatorio y de al menos 10 caracteres", async () => {
+  await conApi({ AHORA: "2027-01-05T09:00" }, async (api) => {
+    const sinMotivo = await crear(api, "socio-003", "pista-1", "2027-01-10T21:00");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-10T09:00" } });
+    const sin = await api.pedir("POST", `/api/reservas/${sinMotivo.id}/cancelar`, { socio: "socio-040", cuerpo: { exento: true } });
+    assert.equal(sin.status, 400);
+    assert.equal(sin.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const cortoMotivo = await crear(api, "socio-004", "pista-2", "2027-01-10T21:00");
+    const corto = await api.pedir("POST", `/api/reservas/${cortoMotivo.id}/cancelar`, { socio: "socio-040", cuerpo: { exento: true, motivo: "corto" } });
+    assert.equal(corto.status, 400);
+    assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  });
+});
+
+test("exención: solo un gestor puede eximir", async () => {
+  await conApi({ AHORA: "2027-01-05T09:00" }, async (api) => {
+    const reserva = await crear(api, "socio-003", "pista-1", "2027-01-10T21:00");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-10T09:00" } });
+    const noGestor = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-003",
+      cuerpo: { exento: true, motivo: "Motivo suficientemente largo" },
+    });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const sinIdentidad = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "Motivo suficientemente largo" },
+    });
+    assert.equal(sinIdentidad.status, 401);
+    assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  });
+});
+
+test("una reserva ya empezada no se cancela, tampoco con exento", async () => {
