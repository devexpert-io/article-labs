+  assert.equal(creada.status, 201);
+  assert.deepEqual(creada.cuerpo, {
+    reserva: { id: creada.cuerpo.reserva.id, socioId: "socio-004", pistaId: "pista-2", inicio: "2026-11-21T16:30", fin: "2026-11-21T18:00", estado: "confirmada", importe: 2800, notas: "" },
+  });
+
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo.reservas.filter((x: any) => x.estado === "cancelada");
+  const reserva = await reservaDelSabado(api, "2026-12-05T10:00");
+  const forzada = await cancelar(api, reserva.id, { forzar: true });
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1400);
+  await reloj(api, "2026-12-01T10:00");
+  const otraVez = await cancelar(api, reserva.id);
+  assert.equal(otraVez.status, 409);
+  assert.equal(otraVez.cuerpo.error.codigo, "YA_CANCELADA");
+  const leida = await api.pedir("GET", `/api/reservas/${reserva.id}`);
+  assert.equal(leida.cuerpo.reserva.penalizacion, 1400);
+  const despues = (await api.pedir("GET", "/_estado")).cuerpo.reservas.filter((x: any) => x.estado === "cancelada" && x.id !== reserva.id);
+  assert.deepEqual(despues, antes);
+}));
