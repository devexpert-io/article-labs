+test("C7 · el informe de octubre cuadra con las reservas de la semilla", () => conApi(async (api) => {
+  const { reservas, pistas } = (await api.pedir("GET", "/_estado")).cuerpo;
+  const delMes = reservas.filter((x: any) => x.inicio.startsWith("2026-10"));
+  const cifras = (lista: any[]) => {
+    const cobradas = lista.filter((x) => x.estado !== "cancelada");
+    const ingresos = cobradas.reduce((s, x) => s + x.importe, 0);
+    const penalizaciones = lista.filter((x) => x.estado === "cancelada").reduce((s, x) => s + (x.penalizacion ?? 0), 0);
+    return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+  };
+  const r = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, {
+    mes: "2026-10",
+    pistas: pistas.map((p: any) => p.id).sort().map((pistaId: string) => ({ pistaId, ...cifras(delMes.filter((x: any) => x.pistaId === pistaId)) })),
+    total: cifras(delMes),
+  });
+  assert.equal(r.cuerpo.total.reservas > 0, true);
+}));
+
+test("C8 · crear reservas funciona igual y las canceladas conservan su penalización", () => conApi(async (api) => {
