@@ -0,0 +1,289 @@
+// Spec docs/specs/reembolsos.md: penalizaciones escalonadas e informe de caja.
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const MOTIVO = "Lesión justificada con parte médico";
+// Sábado 5 de diciembre de 2026 a las 16:30 en la pista 2: hora punta, 2800 céntimos.
+const SABADO = "2026-12-05T16:30";
+
+/** Cada test arranca su propia API con la semilla nueva. */
+async function conApi(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+async function reservar(api: Api, inicio: string, pistaId = "pista-2", socioId = "socio-003") {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201);
+  return r.cuerpo.reserva;
+}
+
+/** Reserva el sábado con el reloj en noviembre y mueve el reloj a `ahora`. */
+async function reservaDelSabado(api: Api, ahora: string) {
+  await reloj(api, "2026-11-30T10:00");
+  const reserva = await reservar(api, SABADO);
+  assert.equal(reserva.importe, 2800);
+  await reloj(api, ahora);
+  return reserva;
+}
+
+const cancelar = (api: Api, id: string, cuerpo: unknown = {}, socio?: string) =>
+  api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+
+test("C1 · con 48 horas o más de antelación no hay penalización", () => conApi(async (api) => {
+  const reserva = await reservaDelSabado(api, "2026-12-02T10:00");
+  const r = await cancelar(api, reserva.id);
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { reserva: { ...reserva, estado: "cancelada" }, reembolso: 2800 });
+}));
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 %", () => conApi(async (api) => {
+  const reserva = await reservaDelSabado(api, "2026-12-04T10:00");
+  const r = await cancelar(api, reserva.id);
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { reserva: { ...reserva, estado: "cancelada", penalizacion: 700 }, reembolso: 2100 });
+}));
+
+test("C1 · con menos de 24 horas sin forzar responde 409 FUERA_DE_PLAZO y no cancela", () => conApi(async (api) => {
+  const reserva = await reservaDelSabado(api, "2026-12-05T10:00");
+  const r = await cancelar(api, reserva.id);
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const sigue = await api.pedir("GET", `/api/reservas/${reserva.id}`);
+  assert.equal(sigue.status, 200);
+  assert.deepEqual(sigue.cuerpo, { reserva });
+}));
+
+test("C1 · con menos de 24 horas y forzar la penalización es el 50 %", () => conApi(async (api) => {
+  const reserva = await reservaDelSabado(api, "2026-12-05T10:00");
+  const r = await cancelar(api, reserva.id, { forzar: true });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { reserva: { ...reserva, estado: "cancelada", penalizacion: 1400 }, reembolso: 1400 });
+}));
+
+test("C2 · a 48 horas justas no hay penalización y un minuto después sí", () => conApi(async (api) => {
+  const justa = await reservaDelSabado(api, "2026-12-03T16:30");
+  const r = await cancelar(api, justa.id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 2800);
+
+  await reloj(api, "2026-11-30T10:00");
+  const otra = await reservar(api, SABADO);
+  await reloj(api, "2026-12-03T16:31");
+  const tarde = await cancelar(api, otra.id);
+  assert.equal(tarde.status, 200);
+  assert.equal(tarde.cuerpo.reserva.penalizacion, 700);
+  assert.equal(tarde.cuerpo.reembolso, 2100);
+}));
+
+test("C2 · a 24 horas justas se aplica el 25 % sin forzar; un minuto después hace falta forzar", () => conApi(async (api) => {
+  const justa = await reservaDelSabado(api, "2026-12-04T16:30");
+  const r = await cancelar(api, justa.id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 700);
+  assert.equal(r.cuerpo.reembolso, 2100);
+
+  await reloj(api, "2026-11-30T10:00");
+  const otra = await reservar(api, SABADO);
+  await reloj(api, "2026-12-04T16:31");
+  const tarde = await cancelar(api, otra.id);
+  assert.equal(tarde.status, 409);
+  assert.equal(tarde.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+}));
+
+test("C3 · del viernes 26-03-2027 20:30 al domingo 28 21:00 hay 47,5 horas reales: 25 %", () => conApi(async (api) => {
+  await reloj(api, "2027-03-26T20:30");
+  const reserva = await reservar(api, "2027-03-28T21:00");
+  assert.equal(reserva.importe, 2800);
+  const r = await cancelar(api, reserva.id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 700);
+  assert.equal(r.cuerpo.reembolso, 2100);
+}));
+
+test("C3 · en el cambio de hora de otoño se cuenta la hora de más", () => conApi(async (api) => {
+  // Del sábado 30-10-2027 a las 22:00 al domingo 31 a las 21:00 hay 24 horas reales (23 en el reloj).
+  await reloj(api, "2027-10-30T09:00");
+  const reserva = await reservar(api, "2027-10-31T21:00");
+  await reloj(api, "2027-10-30T22:00");
+  const r = await cancelar(api, reserva.id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, Math.round(reserva.importe / 4));
+  assert.equal(r.cuerpo.reembolso, reserva.importe - Math.round(reserva.importe / 4));
+}));
+
+test("C4 · reembolso es importe menos penalización, o el importe entero sin penalización", () => conApi(async (api) => {
+  await reloj(api, "2026-11-30T10:00");
+  const valle = await reservar(api, "2026-12-01T09:00", "pista-3"); // martes, valle: 1200
+  const punta = await reservar(api, SABADO);
+  await reloj(api, "2026-11-30T12:00");
+  const forzada = await cancelar(api, valle.id, { forzar: true });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+  assert.equal(forzada.cuerpo.reembolso, forzada.cuerpo.reserva.importe - forzada.cuerpo.reserva.penalizacion);
+  const gratis = await cancelar(api, punta.id);
+  assert.equal(gratis.status, 200);
+  assert.equal(gratis.cuerpo.reembolso, 2800);
+}));
+
+test("C5 · un gestor exime con motivo, sin forzar, a menos de 24 horas", () => conApi(async (api) => {
+  const reserva = await reservaDelSabado(api, "2026-12-05T16:00");
+  const r = await cancelar(api, reserva.id, { exento: true, motivo: MOTIVO }, GESTOR);
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { reserva: { ...reserva, estado: "cancelada", motivoCancelacion: MOTIVO }, reembolso: 2800 });
+}));
+
