+probar("C7 · el informe de octubre cuenta las reservas confirmadas y las no presentadas, por fecha de inicio", async (api) => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const delMes = estado.reservas.filter((r: { inicio: string }) => r.inicio.startsWith("2026-10"));
+  const activas = delMes.filter((r: { estado: string }) => r.estado !== "cancelada");
+  const ingresos = activas.reduce((s: number, r: { importe: number }) => s + r.importe, 0);
+  const penalizaciones = delMes.reduce((s: number, r: { penalizacion?: number }) => s + (r.penalizacion ?? 0), 0);
+
+  const r = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.total.reservas, activas.length);
+  assert.equal(r.cuerpo.total.ingresos, ingresos);
+  assert.equal(r.cuerpo.total.penalizaciones, penalizaciones);
+  assert.equal(r.cuerpo.total.total, ingresos + penalizaciones);
+  assert.equal(r.cuerpo.pistas.reduce((s: number, p: { ingresos: number }) => s + p.ingresos, 0), ingresos);
+  assert.ok(activas.some((r: { estado: string }) => r.estado === "no_presentada"), "la semilla de octubre tiene no presentadas");
+});
