+probar("C3 · el cambio de hora cuenta: a las 20:00 del viernes hay 48 horas reales justas, sin penalización", async (api) => {
+  const id = await reservar(api, "2027-03-28T21:00");
+  await fijarHora(api, "2027-03-26T20:00");
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
