+// Penalizaciones escalonadas, exención de gestor e informe de caja (docs/specs/reembolsos.md), probadas a través de la API.
+// Cada test arranca su propia API con una semilla nueva. La hora se mueve con POST /_reloj.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-003";
+// Socio sin reservas en la semilla, con la cuota al día.
+const SIN_RESERVAS = "socio-041";
+
+function probar(nombre: string, prueba: (api: Api) => Promise<void>) {
+  test(nombre, async () => {
+    const api = await arrancarApi();
+    try {
+      await prueba(api);
+    } finally {
+      api.cerrar();
+    }
+  });
+}
+
+/** Reserva una franja libre (para socio sin reservas, pista 3 por defecto: 12 € en valle). */
+async function reservar(api: Api, inicio: string, pistaId = "pista-3", socioId = SIN_RESERVAS): Promise<string> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, `no se pudo reservar ${pistaId} ${inicio}: ${r.texto}`);
+  return r.cuerpo.reserva.id;
+}
+
+async function fijarHora(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+// Jueves 10 de diciembre de 2026 a las 12:00: franja de valle, sin nada en la semilla.
+const JUEVES = "2026-12-10T12:00";
+
+probar("C1 · sin penalización con 48 horas o más de antelación", async (api) => {
+  const id = await reservar(api, JUEVES);
+  await fijarHora(api, "2026-12-07T12:00"); // 72 horas antes
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 1200);
+});
+
+probar("C1 · entre 24 y 48 horas la penalización es el 25 % del importe", async (api) => {
+  const id = await reservar(api, JUEVES);
+  await fijarHora(api, "2026-12-08T18:00"); // 42 horas antes
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 300);
+  assert.equal(r.cuerpo.reembolso, 900);
+});
+
+probar("C1 · a menos de 24 horas no se cancela sin forzar, y con forzar la penalización es el 50 %", async (api) => {
+  const id = await reservar(api, JUEVES);
+  await fijarHora(api, "2026-12-09T18:00"); // 18 horas antes
+  const sinForzar = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const sigue = await api.pedir("GET", `/api/reservas/${id}`);
+  assert.equal(sigue.cuerpo.reserva.estado, "confirmada", "una cancelación rechazada no cambia la reserva");
+
+  const forzada = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+  assert.equal(forzada.cuerpo.reembolso, 600);
+});
+
+probar("C2 · a 48 horas justas no hay penalización", async (api) => {
+  const id = await reservar(api, JUEVES);
+  await fijarHora(api, "2026-12-08T12:00");
