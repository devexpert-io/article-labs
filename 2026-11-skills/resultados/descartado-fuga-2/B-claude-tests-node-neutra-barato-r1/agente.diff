+++ b/test/reembolsos.test.ts
@@ -0,0 +1,313 @@
+// La política de cancelación escalonada, las exenciones de gestor y el informe de caja, probados a través de la API.
+// Cada test arranca su propia API con su hora, así que no depende de los demás.
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const SOCIO = "socio-003"; // socio normal, con la cuota al día
+const GESTOR = "socio-040"; // la recepción del club
+const PISTA = "pista-3";
+const MOTIVO = "Pista inundada por la lluvia";
+
+async function abrirApi(t: TestContext, ahora?: string): Promise<Api> {
+  const api = await arrancarApi(ahora ? { AHORA: ahora } : {});
+  t.after(() => api.cerrar());
+  return api;
+}
+
+async function fijarHora(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function reservar(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva as { id: string; importe: number };
+}
+
+function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+async function estadoDe(api: Api, id: string): Promise<string> {
+  return (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva.estado;
+}
+
+// --- C1 · Tramos ---------------------------------------------------------------------------------
+
+test("C1 · con 48 horas o más de antelación no hay penalización", async (t) => {
+  const api = await abrirApi(t, "2026-11-23T10:00"); // 74 horas antes
+  const r = await reservar(api, SOCIO, PISTA, "2026-11-26T12:00");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.estado, "cancelada");
+  assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+});
+
+test("C1 · con 24 horas o más y menos de 48, la penalización es el 25 % del importe", async (t) => {
+  const api = await abrirApi(t, "2026-11-24T20:00"); // 40 horas antes
+  const r = await reservar(api, SOCIO, PISTA, "2026-11-26T12:00");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.estado, "cancelada");
+  assert.equal(c.cuerpo.reserva.penalizacion, Math.round(r.importe * 0.25));
+});
+
+test("C1 · a menos de 24 horas sin forzar, 409 FUERA_DE_PLAZO y la reserva sigue confirmada", async (t) => {
+  const api = await abrirApi(t, "2026-11-25T20:00"); // 16 horas antes
+  const r = await reservar(api, SOCIO, PISTA, "2026-11-26T12:00");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 409);
+  assert.equal(c.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  assert.equal(await estadoDe(api, r.id), "confirmada");
+});
+
+test("C1 · a menos de 24 horas con forzar, la penalización es el 50 % del importe", async (t) => {
+  const api = await abrirApi(t, "2026-11-25T20:00"); // 16 horas antes
+  const r = await reservar(api, SOCIO, PISTA, "2026-11-26T12:00");
+  const c = await cancelar(api, r.id, { forzar: true });
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.estado, "cancelada");
+  assert.equal(c.cuerpo.reserva.penalizacion, Math.round(r.importe * 0.5));
+});
+
+// --- C2 · Límites exactos ------------------------------------------------------------------------
+
+test("C2 · a 48 horas justas no hay penalización", async (t) => {
+  const api = await abrirApi(t, "2026-11-24T12:00");
+  const r = await reservar(api, SOCIO, PISTA, "2026-11-26T12:00");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(c.cuerpo.reembolso, r.importe);
+});
+
+test("C2 · a un minuto de las 48 horas ya se aplica el 25 %", async (t) => {
+  const api = await abrirApi(t, "2026-11-24T12:01"); // 47 horas y 59 minutos antes
+  const r = await reservar(api, SOCIO, PISTA, "2026-11-26T12:00");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.penalizacion, Math.round(r.importe * 0.25));
+});
+
+test("C2 · a 24 horas justas se aplica el 25 % y no hace falta forzar", async (t) => {
+  const api = await abrirApi(t, "2026-11-25T12:00");
+  const r = await reservar(api, SOCIO, PISTA, "2026-11-26T12:00");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.penalizacion, Math.round(r.importe * 0.25));
+});
+
+test("C2 · a un minuto de las 24 horas hace falta forzar", async (t) => {
+  const api = await abrirApi(t, "2026-11-25T12:01"); // 23 horas y 59 minutos antes
+  const r = await reservar(api, SOCIO, PISTA, "2026-11-26T12:00");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 409);
+  assert.equal(c.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+});
+
+// --- C3 · Cambio de hora -------------------------------------------------------------------------
+
+test("C3 · del viernes 26 de marzo 20:30 al domingo 28 a las 21:00 hay 47,5 horas: se aplica el 25 %", async (t) => {
+  const api = await abrirApi(t); // 2026-11-18, antes del cambio de hora de 2027
+  const r = await reservar(api, SOCIO, PISTA, "2027-03-28T21:00");
+  await fijarHora(api, "2027-03-26T20:30");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.penalizacion, Math.round(r.importe * 0.25));
+});
+
+test("C3 · del viernes 26 de marzo 20:00 al domingo 28 a las 21:00 hay 48 horas justas: sin penalización", async (t) => {
+  const api = await abrirApi(t);
+  const r = await reservar(api, SOCIO, PISTA, "2027-03-28T21:00");
+  await fijarHora(api, "2027-03-26T20:00");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(c.cuerpo.reembolso, r.importe);
+});
+
+// --- C4 · Reembolso ------------------------------------------------------------------------------
+
+test("C4 · el reembolso es el importe menos la penalización, o el importe entero sin penalización", async (t) => {
