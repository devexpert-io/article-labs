+  const cancelada = await cancelar(api, c.id);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, Math.round(c.importe * 0.25));
+
+  const penal = Math.round(c.importe * 0.25);
+  const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: GESTOR });
+  assert.equal(informe.status, 200);
+  assert.deepEqual(informe.cuerpo, {
+    mes: "2026-12",
+    pistas: [
+      { pistaId: "pista-1", reservas: 1, ingresos: b.importe, penalizaciones: 0, total: b.importe },
+      { pistaId: "pista-2", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+      { pistaId: "pista-3", reservas: 1, ingresos: a.importe, penalizaciones: penal, total: a.importe + penal },
+      { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    ],
+    total: {
+      reservas: 2,
+      ingresos: a.importe + b.importe,
+      penalizaciones: penal,
+      total: a.importe + b.importe + penal,
+    },
+  });
