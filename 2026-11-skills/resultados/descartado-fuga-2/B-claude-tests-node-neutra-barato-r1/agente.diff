+test("C7 · el informe reparte reservas, ingresos y penalizaciones por pista, y el total suma todo", async (t) => {
+  const api = await abrirApi(t); // 2026-11-18
+  const a = await reservar(api, "socio-003", "pista-3", "2026-12-05T12:00");
+  const b = await reservar(api, "socio-006", "pista-1", "2026-12-05T19:30");
+  const c = await reservar(api, "socio-007", "pista-3", "2026-12-06T12:00");
