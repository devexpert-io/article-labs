+/** Reservas de enero de 2027 para el informe: dos cobradas, una cancelada con penalización y una de febrero. */
+async function reservasDeEnero(api: Api): Promise<void> {
+  await reservar(api, "2027-01-11T10:30", "pista-1", "socio-001");
+  await reservar(api, "2027-01-16T18:00", "pista-2", "socio-003");
+  const cancelada = await reservar(api, "2027-01-20T12:00", "pista-3", "socio-006");
+  await reservar(api, "2027-02-01T09:00", "pista-1", SOCIO);
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-20T11:00" } })).status, 200);
+  assert.equal((await cancelar(api, cancelada, { forzar: true })).status, 200);
+}
