+test("C7 · el informe suma ingresos y penalizaciones por pista y para el club", async () => {
+  await conClub("2026-12-01T10:00", async (api) => {
+    await reservasDeEnero(api);
+    const r = await api.pedir("GET", "/api/informes/caja?mes=2027-01", { socio: GESTOR });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, {
+      mes: "2027-01",
+      pistas: [
+        { pistaId: "pista-1", reservas: 1, ingresos: 1800, penalizaciones: 0, total: 1800 },
+        { pistaId: "pista-2", reservas: 1, ingresos: 2800, penalizaciones: 0, total: 2800 },
+        // La cancelada con penalización no cuenta como reserva, pero su penalización sí.
+        { pistaId: "pista-3", reservas: 0, ingresos: 0, penalizaciones: 600, total: 600 },
+        { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+      ],
+      total: { reservas: 2, ingresos: 4600, penalizaciones: 600, total: 5200 },
+    });
+  });
+});
