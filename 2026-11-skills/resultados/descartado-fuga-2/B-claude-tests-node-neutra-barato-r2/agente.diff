@@ -0,0 +1,326 @@
+// Penalizaciones escalonadas, exención de gestor, reembolso e informe de caja (docs/specs/reembolsos.md).
+// Cada prueba arranca su propia API con la hora que necesita. Las reservas se crean en diciembre de 2026 o
+// después, donde la semilla no tiene nada.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-041";
+const MOTIVO = "Lluvia: la pista estaba inundada";
+
+/** Arranca una API con la hora `ahora`, ejecuta la prueba y la cierra. */
+async function conClub(ahora: string, prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi({ AHORA: ahora });
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+/** Crea una reserva y devuelve su id. La pista 1 a las 12:00 del martes 15 de diciembre cuesta 1800 céntimos. */
+async function reservar(api: Api, inicio: string, pistaId = "pista-1", socioId = SOCIO): Promise<string> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.reserva.id;
+}
+
+const cancelar = (api: Api, id: string, cuerpo?: unknown, socio?: string) =>
+  api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+
+const INICIO = "2026-12-15T12:00";
+
+test("C1 · entre 24 y 48 horas de antelación se cobra el 25 % sin forzar", async () => {
+  await conClub("2026-12-14T00:00", async (api) => {
+    const id = await reservar(api, INICIO);
+    const r = await cancelar(api, id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.estado, "cancelada");
+    assert.equal(r.cuerpo.reserva.penalizacion, 450);
+  });
+});
+
+test("C1 · a menos de 24 horas, sin forzar, no se cancela (409 FUERA_DE_PLAZO)", async () => {
+  await conClub("2026-12-14T18:00", async (api) => {
+    const id = await reservar(api, INICIO);
+    const r = await cancelar(api, id);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const sigue = await api.pedir("GET", `/api/reservas/${id}`);
+    assert.equal(sigue.cuerpo.reserva.estado, "confirmada");
+  });
+});
+
+test("C1 · a menos de 24 horas, con forzar, se cobra el 50 %", async () => {
+  await conClub("2026-12-14T18:00", async (api) => {
+    const id = await reservar(api, INICIO);
+    const r = await cancelar(api, id, { forzar: true });
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 900);
+  });
+});
+
+test("C1 · con 48 horas o más no hay penalización", async () => {
+  await conClub("2026-12-08T12:00", async (api) => {
+    const id = await reservar(api, INICIO);
+    const r = await cancelar(api, id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.estado, "cancelada");
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  });
+});
+
+test("C2 · a 48 horas justas no hay penalización", async () => {
+  await conClub("2026-12-13T12:00", async (api) => {
+    const id = await reservar(api, INICIO);
+    const r = await cancelar(api, id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(r.cuerpo.reembolso, 1800);
+  });
+});
+
+test("C2 · el último minuto antes de 48 horas ya cobra el 25 %", async () => {
+  await conClub("2026-12-13T12:01", async (api) => {
+    const id = await reservar(api, INICIO);
+    const r = await cancelar(api, id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 450);
+  });
+});
+
+test("C2 · a 24 horas justas se aplica el 25 % y no hace falta forzar", async () => {
+  await conClub("2026-12-14T12:00", async (api) => {
+    const id = await reservar(api, INICIO);
+    const r = await cancelar(api, id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 450);
+  });
+});
+
+test("C2 · el último minuto antes de 24 horas exige forzar", async () => {
+  await conClub("2026-12-14T12:01", async (api) => {
+    const id = await reservar(api, INICIO);
+    const sinForzar = await cancelar(api, id);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await cancelar(api, id, { forzar: true });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+  });
+});
+
+test("C3 · de viernes 20:30 a domingo 21:00 con el cambio de hora hay 47,5 horas, no 48,5", async () => {
+  // Del 26 al 28 de marzo de 2027 se adelanta el reloj. Con 47,5 horas reales hay penalización del 25 %
+  // (la punta de un domingo cuesta 2800: 700 de penalización, 2100 de reembolso).
