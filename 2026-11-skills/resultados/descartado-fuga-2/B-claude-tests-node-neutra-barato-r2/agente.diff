+});
+
+test("C3 · el cambio de hora de otoño también cuenta en horas reales", async () => {
+  // Del sábado 24 de octubre de 2026 a las 18:30 (hora de verano) al domingo 25 a las 18:00 (hora de invierno)
+  // hay 24,5 horas reales, aunque el reloj de pared marque 23,5. Sin forzar, con el 25 %.
+  await conClub("2026-10-24T18:30", async (api) => {
+    const id = await reservar(api, "2026-10-25T18:00");
+    const r = await cancelar(api, id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 700);
+  });
+});
+
+test("C4 · sin penalización, el reembolso es el importe entero", async () => {
+  await conClub("2026-12-08T12:00", async (api) => {
+    const id = await reservar(api, INICIO);
+    const r = await cancelar(api, id);
+    assert.equal(r.cuerpo.reembolso, 1800);
+    assert.equal(r.cuerpo.reserva.importe, 1800);
+  });
+});
+
+test("C4 · el reembolso descuenta la penalización del 25 % y del 50 %", async () => {
+  await conClub("2026-12-14T00:00", async (api) => {
+    const id = await reservar(api, INICIO);
+    const r = await cancelar(api, id);
+    assert.equal(r.cuerpo.reembolso, 1350);
+  });
+  await conClub("2026-12-14T18:00", async (api) => {
+    const id = await reservar(api, INICIO);
+    const r = await cancelar(api, id, { forzar: true });
+    assert.equal(r.cuerpo.reembolso, 900);
+  });
+});
