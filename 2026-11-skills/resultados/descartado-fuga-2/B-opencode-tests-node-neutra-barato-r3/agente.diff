+// La política escalonada de cancelación, la exención de gestores y el informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function nuevoClub(): Promise<Api> {
+  return arrancarApi();
+}
+
+async function ponerReloj(api: Api, ahora: string): Promise<void> {
+  const respuesta = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(respuesta.status, 200);
+}
+
+async function crear(api: Api, socioId: string, pistaId: string, inicio: string) {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+}
+
+test("C1 · tramos: sin penalización a 48 horas o más, 25 % entre 24 y 48 y 50 % con forzar por debajo de 24", async () => {
+  const api = await nuevoClub();
+  try {
+    await ponerReloj(api, "2026-12-01T10:00");
+
+    // 4 días de antelación: sin penalización.
+    const lejana = await crear(api, "socio-003", "pista-3", "2026-12-05T10:30");
+    assert.equal(lejana.status, 201);
+    assert.equal(lejana.cuerpo.reserva.importe, 2000);
+    const gratis = await api.pedir("POST", `/api/reservas/${lejana.cuerpo.reserva.id}/cancelar`);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.estado, "cancelada");
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+
+    // 32 horas: 25 % del importe, sin forzar.
+    const media = await crear(api, "socio-003", "pista-3", "2026-12-02T18:00");
+    assert.equal(media.status, 201);
+    assert.equal(media.cuerpo.reserva.importe, 2000);
+    const reducida = await api.pedir("POST", `/api/reservas/${media.cuerpo.reserva.id}/cancelar`);
+    assert.equal(reducida.status, 200);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, 500);
+
+    // 11 horas: sin forzar no se puede, y con forzar el 50 %.
+    const cercana = await crear(api, "socio-003", "pista-3", "2026-12-01T21:00");
+    assert.equal(cercana.status, 201);
+    assert.equal(cercana.cuerpo.reserva.importe, 2000);
+    const fuera = await api.pedir("POST", `/api/reservas/${cercana.cuerpo.reserva.id}/cancelar`);
+    assert.equal(fuera.status, 409);
+    assert.equal(fuera.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${cercana.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 1000);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C2 · límites exactos: a 48 horas no hay penalización y a 24 horas se aplica el 25 % sin forzar", async () => {
+  const api = await nuevoClub();
+  try {
+    await ponerReloj(api, "2026-12-01T10:30");
+
+    // Exactamente 48 horas.
+    const a48 = await crear(api, "socio-003", "pista-3", "2026-12-03T10:30");
+    assert.equal(a48.status, 201);
+    assert.equal(a48.cuerpo.reserva.importe, 1200);
+    const cancelada48 = await api.pedir("POST", `/api/reservas/${a48.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada48.status, 200);
+    assert.equal(cancelada48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada48.cuerpo.reembolso, 1200);
+
+    // Exactamente 24 horas.
+    const a24 = await crear(api, "socio-003", "pista-3", "2026-12-02T10:30");
+    assert.equal(a24.status, 201);
+    assert.equal(a24.cuerpo.reserva.importe, 1200);
+    const cancelada24 = await api.pedir("POST", `/api/reservas/${a24.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada24.status, 200);
+    assert.equal(cancelada24.cuerpo.reserva.penalizacion, 300);
+    assert.equal(cancelada24.cuerpo.reembolso, 900);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C3 · el cambio de hora cuenta horas reales de Madrid: 47,5 horas son el tramo del 25 %", async () => {
+  const api = await nuevoClub();
+  try {
+    // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00: 47,5 horas reales.
+    await ponerReloj(api, "2027-03-26T20:30");
+    const reserva = await crear(api, "socio-003", "pista-3", "2027-03-28T21:00");
+    assert.equal(reserva.status, 201);
+    assert.equal(reserva.cuerpo.reserva.importe, 2000);
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200, "47,5 horas está dentro del plazo y no necesita forzar");
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 500);
+    assert.equal(cancelada.cuerpo.reembolso, 1500);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C4 · el reembolso es el importe menos la penalización", async () => {
+  const api = await nuevoClub();
+  try {
+    await ponerReloj(api, "2026-12-01T10:00");
+
+    const sinPenalizacion = await crear(api, "socio-003", "pista-3", "2026-12-05T10:30");
+    const gratis = await api.pedir("POST", `/api/reservas/${sinPenalizacion.cuerpo.reserva.id}/cancelar`);
+    assert.equal(sinPenalizacion.cuerpo.reserva.importe, 2000);
+    assert.equal(gratis.cuerpo.reembolso, 2000);
+
+    const conPenalizacion = await crear(api, "socio-003", "pista-3", "2026-12-02T18:00");
+    const cobrada = await api.pedir("POST", `/api/reservas/${conPenalizacion.cuerpo.reserva.id}/cancelar`);
+    assert.equal(conPenalizacion.cuerpo.reserva.importe, 2000);
+    assert.equal(cobrada.cuerpo.reserva.penalizacion, 500);
+    assert.equal(cobrada.cuerpo.reembolso, 1500);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C5 · un gestor exime con motivo de 10 caracteres o más, sin forzar", async () => {
+  const api = await nuevoClub();
+  try {
+    await ponerReloj(api, "2026-12-01T10:00");
+    const reserva = await crear(api, "socio-003", "pista-3", "2026-12-01T21:00");
+    assert.equal(reserva.status, 201);
+    const ruta = `/api/reservas/${reserva.cuerpo.reserva.id}/cancelar`;
+
+    // Sin identificarse.
+    const anonimo = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo: "Motivo suficientemente largo" } });
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    // Identificado, pero no es gestor.
+    const socio = await api.pedir("POST", ruta, { socio: "socio-003", cuerpo: { exento: true, motivo: "Motivo suficientemente largo" } });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    // Gestor sin motivo y con motivo demasiado corto.
+    const sinMotivo = await api.pedir("POST", ruta, { socio: "socio-040", cuerpo: { exento: true } });
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
