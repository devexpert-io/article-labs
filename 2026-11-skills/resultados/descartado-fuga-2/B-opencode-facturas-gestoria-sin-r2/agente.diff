@@ -0,0 +1,188 @@
+// Las facturas mensuales de la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+/** Lo que debería facturarse a cada socio de un mes, calculado desde el estado en bruto. */
+function facturasEsperadas(reservas: any[], mes: string) {
+  const porSocio = new Map<string, { inicio: string; linea: { reservaId: string; concepto: string; importe: number } }[]>();
+  for (const r of reservas) {
+    if (r.inicio.slice(0, 7) !== mes) continue;
+    let linea: { reservaId: string; concepto: string; importe: number } | undefined;
+    if (r.estado === "confirmada" || r.estado === "no_presentada") {
+      linea = { reservaId: r.id, concepto: "reserva", importe: r.importe };
+    } else if (r.estado === "cancelada" && r.penalizacion !== undefined) {
+      linea = { reservaId: r.id, concepto: "penalización", importe: r.penalizacion };
+    }
+    if (!linea) continue;
+    const entradas = porSocio.get(r.socioId) ?? [];
+    entradas.push({ inicio: r.inicio, linea });
+    porSocio.set(r.socioId, entradas);
+  }
+  return [...porSocio.keys()].sort().map((socioId) => {
+    const lineas = porSocio.get(socioId)!
+      .sort((a, b) => (a.inicio < b.inicio ? -1 : a.inicio > b.inicio ? 1 : a.linea.reservaId.localeCompare(b.linea.reservaId)))
+      .map((e) => e.linea);
+    const total = lineas.reduce((suma, l) => suma + l.importe, 0);
+    const base = Math.round((total * 100) / 121);
+    return { socioId, lineas, total, base, iva: total - base };
+  });
+}
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+test("generar y consultar facturas exige ser gestor", async () => {
+  const sinSocio = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+  assert.equal(sinSocio.status, 401);
+  assert.equal(sinSocio.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const noGestor = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10")).status, 401);
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" })).status, 403);
+  assert.equal((await api.pedir("GET", "/api/facturas/F-2026-0001")).status, 401);
+  assert.equal((await api.pedir("GET", "/api/facturas/F-2026-0001", { socio: "socio-001" })).status, 403);
+});
+
+test("el mes tiene que tener el formato AAAA-MM y estar cerrado", async () => {
+  const mal = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "octubre" }, socio: GESTOR });
+  assert.equal(mal.status, 400);
+  assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const mesTrece = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-13" }, socio: GESTOR });
+  assert.equal(mesTrece.status, 400);
+
+  const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+  assert.equal(abierto.status, 409);
+  assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+});
+
+test("octubre de 2026: una factura por socio, con líneas, total e IVA", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const esperadas = facturasEsperadas(estado.reservas, "2026-10");
+  assert.ok(esperadas.length > 0, "octubre debe tener facturas");
+
+  const respuesta = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(respuesta.status, 201);
+  const facturas = respuesta.cuerpo.facturas as any[];
+
+  assert.deepEqual(facturas.map((f) => f.socioId), [...facturas.map((f) => f.socioId)].sort(), "ordenadas por id de socio");
+  assert.equal(facturas.length, esperadas.length);
+
+  facturas.forEach((factura, i) => {
+    const esperada = esperadas[i]!;
+    assert.equal(factura.mes, "2026-10");
+    assert.equal(factura.socioId, esperada.socioId);
+    assert.deepEqual(factura.lineas, esperada.lineas);
+    assert.equal(factura.total, esperada.total);
+    assert.equal(factura.base, esperada.base);
+    assert.equal(factura.iva, esperada.iva);
+    assert.equal(factura.total, factura.base + factura.iva);
+    assert.equal(factura.numero, `F-2026-${String(i + 1).padStart(4, "0")}`, "numeración correlativa por año");
+  });
+});
+
+test("volver a generar un mes devuelve las mismas facturas sin crear nuevas", async () => {
+  const primera = (await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR })).cuerpo.facturas;
+  const repetida = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo.facturas, primera);
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.facturas.filter((f: { mes: string }) => f.mes === "2026-10").length, primera.length);
+});
+
+test("consultar facturas por mes y por número", async () => {
+  const generadas = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas as any[];
+  assert.ok(generadas.length > 0);
+
+  const vacio = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+  assert.equal(vacio.status, 200);
+  assert.deepEqual(vacio.cuerpo.facturas, []);
+
+  const primera = generadas[0]!;
+  const una = await api.pedir("GET", `/api/facturas/${primera.numero}`, { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo.factura, primera);
+
+  const inexistente = await api.pedir("GET", "/api/facturas/F-2026-9999", { socio: GESTOR });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("las penalizaciones se facturan como su propio concepto", async () => {
+  const propia = await arrancarApi();
+  try {
+    // Una reserva fuera del historial de la semilla, para una socia sin reservas previas.
+    const creada = await propia.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-26T10:30" },
+    });
+    assert.equal(creada.status, 201);
+    const id = creada.cuerpo.reserva.id;
+    const importe = creada.cuerpo.reserva.importe;
+
+    await propia.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T11:00" } });
+    const cancelada = await propia.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, importe);
+
+    await propia.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T10:00" } });
+    const generadas = await propia.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    assert.equal(generadas.status, 201);
+
+    const factura = (generadas.cuerpo.facturas as any[]).find((f) => f.socioId === "socio-041");
+    assert.ok(factura, "socio-041 debe tener factura en noviembre");
+    const lineas = factura.lineas.filter((l: { reservaId: string }) => l.reservaId === id);
+    assert.equal(lineas.length, 1, "la reserva cancelada no se factura dos veces");
+    assert.equal(lineas[0].concepto, "penalización");
