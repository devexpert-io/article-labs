@@ -0,0 +1,252 @@
+// La política de cancelación escalonada, las exenciones y el informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function moverReloj(api: Api, ahora: string) {
+  const respuesta = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { ahora });
+}
+
+async function reservar(api: Api, datos: { socio: string; pista: string; inicio: string }) {
+  return api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: datos.socio, pistaId: datos.pista, inicio: datos.inicio },
+  });
+}
+
+function cifrasDe(estado: any, mes: string) {
+  const cifras = (reservas: any[]) => {
+    const cobradas = reservas.filter((r) => r.estado === "confirmada" || r.estado === "no_presentada");
+    const canceladas = reservas.filter((r) => r.estado === "cancelada");
+    const ingresos = cobradas.reduce((suma: number, r: any) => suma + r.importe, 0);
+    const penalizaciones = canceladas.reduce((suma: number, r: any) => suma + (r.penalizacion ?? 0), 0);
+    return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+  };
+  const delMes = estado.reservas.filter((r: any) => r.inicio.slice(0, 7) === mes);
+  const pistas = [...estado.pistas]
+    .sort((a: any, b: any) => a.id.localeCompare(b.id))
+    .map((p: any) => ({ pistaId: p.id, ...cifras(delMes.filter((r: any) => r.pistaId === p.id)) }));
+  return { mes, pistas, total: cifras(delMes) };
+}
+
+test("C1 · tramos: sin penalización desde 48 h, 25 % entre 24 y 48 h, 50 % con forzar por debajo de 24 h", () =>
+  conApi(async (api) => {
+    await moverReloj(api, "2026-11-25T10:30");
+
+    const lejana = await reservar(api, { socio: "socio-003", pista: "pista-1", inicio: "2026-11-27T12:00" });
+    assert.equal(lejana.status, 201);
+    assert.equal(lejana.cuerpo.reserva.importe, 1800);
+    const gratis = await api.pedir("POST", `/api/reservas/${lejana.cuerpo.reserva.id}/cancelar`);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.estado, "cancelada");
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, 1800);
+
+    const media = await reservar(api, { socio: "socio-006", pista: "pista-1", inicio: "2026-11-26T13:30" });
+    assert.equal(media.status, 201);
+    const reducida = await api.pedir("POST", `/api/reservas/${media.cuerpo.reserva.id}/cancelar`);
+    assert.equal(reducida.status, 200);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, 450);
+    assert.equal(reducida.cuerpo.reembolso, 1350);
+
+    const tardia = await reservar(api, { socio: "socio-008", pista: "pista-1", inicio: "2026-11-26T09:00" });
+    assert.equal(tardia.status, 201);
+    const sinForzar = await api.pedir("POST", `/api/reservas/${tardia.cuerpo.reserva.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.deepEqual(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${tardia.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+  }));
+
+test("C2 · límites exactos: a 48 h justas no hay penalización y a 24 h justas se aplica el 25 % sin forzar", () =>
+  conApi(async (api) => {
+    await moverReloj(api, "2026-11-25T10:30");
+
+    const a48 = await reservar(api, { socio: "socio-003", pista: "pista-1", inicio: "2026-11-27T10:30" });
+    assert.equal(a48.status, 201);
+    const limite48 = await api.pedir("POST", `/api/reservas/${a48.cuerpo.reserva.id}/cancelar`);
+    assert.equal(limite48.status, 200);
+    assert.equal(limite48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(limite48.cuerpo.reembolso, 1800);
+
+    const a24 = await reservar(api, { socio: "socio-006", pista: "pista-1", inicio: "2026-11-26T10:30" });
+    assert.equal(a24.status, 201);
+    const limite24 = await api.pedir("POST", `/api/reservas/${a24.cuerpo.reserva.id}/cancelar`);
+    assert.equal(limite24.status, 200);
+    assert.equal(limite24.cuerpo.reserva.penalizacion, 450);
+    assert.equal(limite24.cuerpo.reembolso, 1350);
+  }));
+
+test("C3 · cambio de hora: 47,5 horas reales de Madrid no llegan al tramo gratuito", () =>
+  conApi(async (api) => {
+    // Sin cambio de hora: 48,5 horas de reloj entre el viernes y el domingo.
+    await moverReloj(api, "2027-03-19T20:30");
+    const sinCambio = await reservar(api, { socio: "socio-003", pista: "pista-1", inicio: "2027-03-21T21:00" });
+    assert.equal(sinCambio.status, 201);
+    const gratis = await api.pedir("POST", `/api/reservas/${sinCambio.cuerpo.reserva.id}/cancelar`);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, 2800);
+
+    // La madrugada del 28 de marzo de 2027 los relojes se adelantan: 48,5 horas de reloj son 47,5 reales.
+    await moverReloj(api, "2027-03-26T20:30");
+    const conCambio = await reservar(api, { socio: "socio-006", pista: "pista-1", inicio: "2027-03-28T21:00" });
+    assert.equal(conCambio.status, 201);
+    const penalizada = await api.pedir("POST", `/api/reservas/${conCambio.cuerpo.reserva.id}/cancelar`);
+    assert.equal(penalizada.status, 200);
+    assert.equal(penalizada.cuerpo.reserva.penalizacion, 700);
+    assert.equal(penalizada.cuerpo.reembolso, 2100);
+  }));
+
+test("C4 · reembolso: importe menos penalización, o el importe entero si no hay penalización", () =>
+  conApi(async (api) => {
+    await moverReloj(api, "2026-11-25T10:30");
+
+    const conPenalizacion = await reservar(api, { socio: "socio-003", pista: "pista-1", inicio: "2026-11-26T13:30" });
+    assert.equal(conPenalizacion.status, 201);
+    const reducida = await api.pedir("POST", `/api/reservas/${conPenalizacion.cuerpo.reserva.id}/cancelar`);
+    assert.equal(reducida.status, 200);
+    assert.equal(reducida.cuerpo.reserva.importe, 1800);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, 450);
+    assert.equal(reducida.cuerpo.reembolso, 1350);
+
+    const sinPenalizacion = await reservar(api, { socio: "socio-006", pista: "pista-1", inicio: "2026-11-27T12:00" });
+    assert.equal(sinPenalizacion.status, 201);
+    const gratuita = await api.pedir("POST", `/api/reservas/${sinPenalizacion.cuerpo.reserva.id}/cancelar`);
+    assert.equal(gratuita.status, 200);
+    assert.equal(gratuita.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratuita.cuerpo.reembolso, 1800);
