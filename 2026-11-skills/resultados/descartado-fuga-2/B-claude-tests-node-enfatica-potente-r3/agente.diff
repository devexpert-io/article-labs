+test("C7 · el informe cuenta las reservas no presentadas y no las canceladas", () => conApi(async (api) => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const octubre = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+  assert.ok(octubre.some((r: any) => r.estado === "no_presentada"));
+  assert.ok(octubre.some((r: any) => r.estado === "cancelada"));
+  const esperado = (filtro: (r: any) => boolean) => {
+    const cobradas = octubre.filter((r: any) => filtro(r) && r.estado !== "cancelada");
+    const ingresos = cobradas.reduce((s: number, r: any) => s + r.importe, 0);
+    return { reservas: cobradas.length, ingresos, penalizaciones: 0, total: ingresos };
+  };
+  const r = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, {
+    mes: "2026-10",
+    pistas: ["pista-1", "pista-2", "pista-3", "pista-4"].map((pistaId) => ({ pistaId, ...esperado((x) => x.pistaId === pistaId) })),
+    total: esperado(() => true),
+  });
+}));
