@@ -0,0 +1,323 @@
+// Spec docs/specs/reembolsos.md: penalizaciones escalonadas, exención y el informe de caja.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-003";
+
+/** Cada test arranca su propia API con la semilla nueva. */
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { ahora });
+}
+
+/** Crea una reserva con el reloj en `desde` (por defecto, muy antes) y devuelve la reserva creada. */
+async function reservar(api: Api, pistaId: string, inicio: string, socioId = SOCIO, desde = "2027-01-01T10:00") {
+  await reloj(api, desde);
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201);
+  return r.cuerpo.reserva;
+}
+
+/** Miércoles 13 de enero de 2027 a las 12:00 en la pista 2: hora valle, 1800 céntimos. */
+const INICIO = "2027-01-13T12:00";
+
+async function prepararYCancelar(api: Api, ahora: string, cuerpo?: unknown, socio?: string) {
+  const creada = await reservar(api, "pista-2", INICIO);
+  await reloj(api, ahora);
+  return { creada, r: await api.pedir("POST", `/api/reservas/${creada.id}/cancelar`, { cuerpo, socio }) };
+}
+
+function esperarCancelada(r: { status: number; cuerpo: any }, creada: any, penalizacion: number | undefined, extra: object = {}) {
+  assert.equal(r.status, 200);
+  const reserva = { ...creada, estado: "cancelada", ...(penalizacion === undefined ? {} : { penalizacion }), ...extra };
+  assert.deepEqual(r.cuerpo, { reserva, reembolso: creada.importe - (penalizacion ?? 0) });
+}
+
+function esperarError(r: { status: number; cuerpo: any }, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+  assert.equal(typeof r.cuerpo.error.mensaje, "string");
+}
+
+// C1 · Tramos
+
+test("C1 · con 48 horas o más de antelación no hay penalización", () => conApi(async (api) => {
+  const { creada, r } = await prepararYCancelar(api, "2027-01-10T12:00");
+  assert.equal(creada.importe, 1800);
+  esperarCancelada(r, creada, undefined);
+}));
+
+test("C1 · con 24 horas o más y menos de 48 la penalización es el 25 %", () => conApi(async (api) => {
+  const { creada, r } = await prepararYCancelar(api, "2027-01-12T06:00");
+  esperarCancelada(r, creada, 450);
+}));
+
+test("C1 · con menos de 24 horas y sin forzar, 409 FUERA_DE_PLAZO y la reserva sigue confirmada", () => conApi(async (api) => {
+  const { creada, r } = await prepararYCancelar(api, "2027-01-13T02:00");
+  esperarError(r, 409, "FUERA_DE_PLAZO");
+  const sigue = await api.pedir("GET", `/api/reservas/${creada.id}`);
+  assert.equal(sigue.status, 200);
+  assert.deepEqual(sigue.cuerpo, { reserva: creada });
+}));
+
+test("C1 · con menos de 24 horas y forzar la penalización es el 50 %", () => conApi(async (api) => {
+  const { creada, r } = await prepararYCancelar(api, "2027-01-13T02:00", { forzar: true });
+  esperarCancelada(r, creada, 900);
+}));
+
+// C2 · Límites exactos
+
+test("C2 · a 48 horas justas no hay penalización", () => conApi(async (api) => {
+  const { creada, r } = await prepararYCancelar(api, "2027-01-11T12:00");
+  esperarCancelada(r, creada, undefined);
+}));
+
+test("C2 · un minuto después de las 48 horas ya se aplica el 25 %", () => conApi(async (api) => {
+  const { creada, r } = await prepararYCancelar(api, "2027-01-11T12:01");
+  esperarCancelada(r, creada, 450);
+}));
+
+test("C2 · a 24 horas justas se aplica el 25 % y no hace falta forzar", () => conApi(async (api) => {
+  const { creada, r } = await prepararYCancelar(api, "2027-01-12T12:00");
+  esperarCancelada(r, creada, 450);
+}));
+
+test("C2 · un minuto después de las 24 horas, sin forzar, 409 FUERA_DE_PLAZO", () => conApi(async (api) => {
+  const { r } = await prepararYCancelar(api, "2027-01-12T12:01");
+  esperarError(r, 409, "FUERA_DE_PLAZO");
+}));
+
+// C3 · Cambio de hora
+
+test("C3 · del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas: 25 %", () => conApi(async (api) => {
+  const creada = await reservar(api, "pista-2", "2027-03-28T21:00", SOCIO, "2027-03-01T10:00");
+  assert.equal(creada.importe, 2800);
+  await reloj(api, "2027-03-26T20:30");
+  const r = await api.pedir("POST", `/api/reservas/${creada.id}/cancelar`);
+  esperarCancelada(r, creada, 700);
+}));
+
+test("C3 · en primavera, a las 20:00 del viernes faltan 48 horas reales: sin penalización", () => conApi(async (api) => {
+  const creada = await reservar(api, "pista-2", "2027-03-28T21:00", SOCIO, "2027-03-01T10:00");
+  await reloj(api, "2027-03-26T20:00");
+  const r = await api.pedir("POST", `/api/reservas/${creada.id}/cancelar`);
+  esperarCancelada(r, creada, undefined);
+}));
+
+test("C3 · en otoño se atrasa la hora: del viernes 29 de octubre de 2027 a las 21:30 al domingo 31 a las 21:00 hay 48,5 horas", () => conApi(async (api) => {
+  const creada = await reservar(api, "pista-2", "2027-10-31T21:00", SOCIO, "2027-10-01T10:00");
+  await reloj(api, "2027-10-29T21:30");
+  const r = await api.pedir("POST", `/api/reservas/${creada.id}/cancelar`);
+  esperarCancelada(r, creada, undefined);
+}));
+
+test("C3 · en otoño, a las 22:30 del viernes faltan 47,5 horas reales: 25 %", () => conApi(async (api) => {
+  const creada = await reservar(api, "pista-2", "2027-10-31T21:00", SOCIO, "2027-10-01T10:00");
+  await reloj(api, "2027-10-29T22:30");
+  const r = await api.pedir("POST", `/api/reservas/${creada.id}/cancelar`);
+  esperarCancelada(r, creada, 700);
+}));
+
+// C4 · Reembolso
+
+test("C4 · el reembolso es importe - penalizacion, o el importe entero sin penalización", () => conApi(async (api) => {
+  const gratis = await reservar(api, "pista-3", "2027-01-25T12:00", "socio-003"); // a 122 horas
