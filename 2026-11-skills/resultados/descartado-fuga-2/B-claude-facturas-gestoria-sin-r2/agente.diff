+// Facturas mensuales por socio (docs/specs/facturas.md).
+//
+// SUPUESTOS PENDIENTES DE CONFIRMAR CON LA GESTORÍA: la spec remite a sus "reglas de facturación",
+// que no están en el repositorio. Todo lo que depende de ellas está en este bloque de constantes y
+// funciones para poder ajustarlo en un solo sitio.
+import { ErrorDelClub } from "./nucleo.ts";
+import type { Estado, Factura, LineaFactura, Reserva, Socio } from "./tipos.ts";
+
+/** Supuesto: los precios del club llevan el IVA incluido, al 21 %. */
+export const IVA_POR_CIENTO = 21;
+
+/** Supuesto: base = total / 1,21 redondeada al céntimo (mitades hacia arriba) sobre el total de la factura; iva = total − base. */
+export function desglosarIva(total: number): { base: number; iva: number } {
+  const base = Math.round((total * 100) / (100 + IVA_POR_CIENTO));
+  return { base, iva: total - base };
+}
+
+/** Supuesto: F-AAAA-NNNN, correlativo por el año del mes facturado, empezando en 0001 cada año. */
+export function formatoNumero(anio: string, n: number): string {
+  return `F-${anio}-${String(n).padStart(4, "0")}`;
+}
+
+/**
+ * Supuesto: se factura cada reserva por el mes de su inicio. Las confirmadas y las no presentadas, por su importe;
+ * las canceladas, solo si tienen penalización, por la penalización. Las canceladas gratis no se facturan.
+ */
+export function lineaDe(r: Reserva, nombrePista: string): LineaFactura | undefined {
+  if (r.estado === "confirmada") return { reservaId: r.id, concepto: `Reserva ${nombrePista} ${r.inicio}`, importe: r.importe };
+  if (r.estado === "no_presentada") return { reservaId: r.id, concepto: `Reserva ${nombrePista} ${r.inicio} (no presentado)`, importe: r.importe };
+  if (r.penalizacion) return { reservaId: r.id, concepto: `Penalización por cancelación ${nombrePista} ${r.inicio}`, importe: r.penalizacion };
+  return undefined;
+}
+
+// --- Fin de los supuestos de la gestoría ---
+
+const MES = /^(\d{4})-(0[1-9]|1[0-2])$/;
+
+function soloGestor(quien: Socio | undefined) {
+  if (!quien) throw new ErrorDelClub("NO_IDENTIFICADO", "Hace falta la cabecera X-Socio", 401);
+  if (quien.rol !== "gestor") throw new ErrorDelClub("SIN_PERMISO", "Solo un gestor puede generar y consultar facturas", 403);
+}
+
+function validarMes(mes: unknown): string {
+  if (typeof mes !== "string" || !MES.test(mes)) throw new ErrorDelClub("DATOS_INVALIDOS", "mes es obligatorio, con el formato AAAA-MM", 400);
+  return mes;
+}
+
+/** Primer instante del mes siguiente, AAAA-MM-01T00:00. */
+function inicioDelMesSiguiente(mes: string): string {
+  const [a, m] = mes.split("-").map(Number) as [number, number];
+  return m === 12 ? `${a + 1}-01-01T00:00` : `${a}-${String(m + 1).padStart(2, "0")}-01T00:00`;
+}
+
+export function crearFacturacion(estado: Estado) {
+  const delMes = (mes: string) => estado.facturas.filter((f) => f.mes === mes);
+
+  return {
+    /** Devuelve también `nuevas` para que la API responda 201 la primera vez. */
+    generarFacturas(quien: Socio | undefined, mesRecibido: unknown) {
+      soloGestor(quien);
+      const mes = validarMes(mesRecibido);
+      if (estado.mesesFacturados.includes(mes)) return { nuevas: false, facturas: delMes(mes) };
+      if (estado.ahora < inicioDelMesSiguiente(mes)) throw new ErrorDelClub("MES_ABIERTO", `El mes ${mes} todavía no ha terminado`);
+
+      const anio = mes.slice(0, 4);
+      let ultimo = estado.facturas.filter((f) => f.numero.startsWith(formatoNumero(anio, 0).slice(0, -4))).length;
+      const reservas = estado.reservas
+        .filter((r) => r.inicio.startsWith(`${mes}-`))
+        .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+      const socios = [...estado.socios].sort((a, b) => a.id.localeCompare(b.id));
+      const nuevas: Factura[] = [];
+      for (const socio of socios) {
+        const lineas: LineaFactura[] = [];
+        for (const r of reservas) {
+          if (r.socioId !== socio.id) continue;
+          const pista = estado.pistas.find((p) => p.id === r.pistaId);
+          const linea = lineaDe(r, pista?.nombre ?? r.pistaId);
+          if (linea) lineas.push(linea);
+        }
+        if (lineas.length === 0) continue;
+        const total = lineas.reduce((s, l) => s + l.importe, 0);
+        ultimo += 1;
+        nuevas.push({ numero: formatoNumero(anio, ultimo), mes, socioId: socio.id, lineas, total, ...desglosarIva(total) });
+      }
+      estado.facturas.push(...nuevas);
+      estado.mesesFacturados.push(mes);
+      return { nuevas: true, facturas: nuevas };
+    },
+
+    listarFacturas(quien: Socio | undefined, mesRecibido: unknown) {
+      soloGestor(quien);
+      return { facturas: delMes(validarMes(mesRecibido)) };
+    },
+
+    obtenerFactura(quien: Socio | undefined, numero: string) {
+      soloGestor(quien);
+      const factura = estado.facturas.find((f) => f.numero === numero);
+      if (!factura) throw new ErrorDelClub("FACTURA_NO_ENCONTRADA", `No existe la factura ${numero}`, 404);
+      return { factura };
+    },
+  };
+}
