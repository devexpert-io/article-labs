+++ b/test/facturas.test.ts
@@ -0,0 +1,165 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { desglosarIva } from "../src/facturacion.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const generar = (mes: unknown, socio = GESTOR) => api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio });
+const reloj = (ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+
+// Los tests de este fichero comparten la API y van en orden: el reloj y las facturas avanzan de uno a otro.
+
+test("permisos: sin X-Socio 401 y con un socio que no es gestor 403", async () => {
+  for (const [metodo, ruta] of [["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F-2026-0001"]] as const) {
+    const anonimo = await api.pedir(metodo, ruta, { cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+    assert.equal(anonimo.status, 401, `${metodo} ${ruta}`);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined, socio: "socio-001" });
+    assert.equal(socio.status, 403, `${metodo} ${ruta}`);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  // Los intentos sin permiso no generan nada.
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas, []);
+});
+
+test("mes: formato AAAA-MM y solo meses cerrados", async () => {
+  for (const mes of [undefined, "2026-1", "2026-13", "2026-00", "2026-10-01", 202610]) {
+    const r = await generar(mes);
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=octubre", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12"]) {
+    const r = await generar(mes);
+    assert.equal(r.status, 409, mes);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+});
+
+test("octubre de 2026: una factura por socio con algo que facturar, con sus líneas, total e IVA", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const r = await generar("2026-10");
+  assert.equal(r.status, 201);
+  const facturas = r.cuerpo.facturas;
+  const ids = facturas.map((f: any) => f.socioId);
+  assert.deepEqual(ids, [...ids].sort(), "ordenadas por id de socio");
+  assert.equal(facturas.length, 40);
+  assert.ok(!ids.includes("socio-041"), "Nora Benítez no tiene nada que facturar");
+  assert.deepEqual(facturas.map((f: any) => f.numero), Array.from({ length: 40 }, (_, i) => `F-2026-${String(i + 1).padStart(4, "0")}`));
+
+  for (const f of facturas) {
+    assert.equal(f.mes, "2026-10");
+    const esperadas = estado.reservas
+      .filter((x: any) => x.socioId === f.socioId && x.inicio.startsWith("2026-10-") && x.estado !== "cancelada")
+      .sort((a: any, b: any) => a.inicio.localeCompare(b.inicio));
+    assert.deepEqual(f.lineas.map((l: any) => l.reservaId), esperadas.map((x: any) => x.id), f.socioId);
+    assert.deepEqual(f.lineas.map((l: any) => l.importe), esperadas.map((x: any) => x.importe));
+    assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+    assert.equal(f.base + f.iva, f.total);
+    assert.equal(f.base, Math.round((f.total * 100) / 121));
+  }
+  // Las canceladas sin penalización no se facturan.
+  const canceladas = new Set(estado.reservas.filter((x: any) => x.inicio.startsWith("2026-10-") && x.estado === "cancelada").map((x: any) => x.id));
+  assert.ok(canceladas.size > 0);
+  assert.ok(facturas.every((f: any) => f.lineas.every((l: any) => !canceladas.has(l.reservaId))));
+  // Una no presentada se factura por su importe.
+  const noPresentada = estado.reservas.find((x: any) => x.inicio.startsWith("2026-10-") && x.estado === "no_presentada");
+  const suya = facturas.find((f: any) => f.socioId === noPresentada.socioId);
+  assert.equal(suya.lineas.find((l: any) => l.reservaId === noPresentada.id).importe, noPresentada.importe);
+
+  assert.deepEqual(facturas[0], {
+    numero: "F-2026-0001",
+    mes: "2026-10",
+    socioId: "socio-001",
+    lineas: [
+      { reservaId: "R-0120", concepto: "Reserva Pista 1 2026-10-12T09:00", importe: 1800 },
+      { reservaId: "R-0172", concepto: "Reserva Pista 2 2026-10-17T21:00", importe: 2800 },
+      { reservaId: "R-0193", concepto: "Reserva Pista 4 2026-10-18T12:00", importe: 2200 },
+    ],
+    total: 6800,
+    base: 5620,
+    iva: 1180,
+  });
+});
+
+test("redondeo del IVA al céntimo", () => {
+  assert.deepEqual(desglosarIva(6800), { base: 5620, iva: 1180 }); // 5619,83 sube
+  assert.deepEqual(desglosarIva(1000), { base: 826, iva: 174 }); // 826,45 baja
+  assert.deepEqual(desglosarIva(1210), { base: 1000, iva: 210 });
+  assert.deepEqual(desglosarIva(0), { base: 0, iva: 0 });
+});
+
+test("generar dos veces devuelve las mismas facturas y no crea ninguna", async () => {
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo.facturas.length;
+  const primera = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  const otra = await generar("2026-10");
+  assert.equal(otra.status, 200);
+  assert.deepEqual(otra.cuerpo.facturas, primera.cuerpo.facturas);
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, antes);
+});
+
+test("consultar: por mes y por número", async () => {
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas.length, 40);
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR })).cuerpo, { facturas: [] });
+  const una = await api.pedir("GET", "/api/facturas/F-2026-0002", { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.equal(una.cuerpo.factura.socioId, "socio-002");
+  const ninguna = await api.pedir("GET", "/api/facturas/F-2026-9999", { socio: GESTOR });
+  assert.equal(ninguna.status, 404);
+  assert.equal(ninguna.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("penalizaciones y numeración entre meses y entre años", async () => {
+  // Marta López cancela fuera de plazo su reserva del jueves 19 (1200): se le factura la penalización.
+  assert.equal((await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } })).status, 200);
+  const diciembre = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-14T18:00" } });
+  const enero = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2027-01-11T09:00" } });
