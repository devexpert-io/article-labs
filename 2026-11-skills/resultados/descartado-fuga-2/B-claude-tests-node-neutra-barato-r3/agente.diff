+// Penalizaciones escalonadas, exenciones de gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+/** Cada test arranca su propia API, con la semilla nueva y el reloj en 2026-11-18T10:00. */
+function prueba(nombre: string, cuerpo: (api: Api) => Promise<void>) {
+  test(nombre, async () => {
+    const api = await arrancarApi();
+    try {
+      await cuerpo(api);
+    } finally {
+      api.cerrar();
+    }
+  });
+}
+
+/** Crea una reserva con un socio (que debe estar al día y tener menos de tres futuras) y devuelve su id. */
+async function reservar(api: Api, socioId: string, pistaId: string, inicio: string): Promise<string> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva.id;
+}
+
+async function enHora(api: Api, ahora: string): Promise<void> {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200, JSON.stringify(r.cuerpo));
+}
+
+function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+prueba("C1 · tramos: 48 h o más sin penalización, 25 % entre 24 y 48 h, y 50 % con forzar por debajo de 24 h", async (api) => {
+  const a = await reservar(api, "socio-030", "pista-3", "2026-12-10T12:00"); // 1200 céntimos
+  const b = await reservar(api, "socio-031", "pista-1", "2026-12-10T12:00"); // 1800 céntimos
+  const c = await reservar(api, "socio-032", "pista-2", "2026-12-10T12:00"); // 1800 céntimos
+
+  await enHora(api, "2026-12-07T12:00"); // 72 horas
+  const sinPenalizacion = await cancelar(api, a);
+  assert.equal(sinPenalizacion.status, 200);
+  assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, 0);
+  assert.equal(sinPenalizacion.cuerpo.reembolso, 1200);
+
+  await enHora(api, "2026-12-08T13:00"); // 47 horas
+  const parcial = await cancelar(api, b);
+  assert.equal(parcial.status, 200);
+  assert.equal(parcial.cuerpo.reserva.penalizacion, 450);
+  assert.equal(parcial.cuerpo.reembolso, 1350);
+
+  await enHora(api, "2026-12-10T09:00"); // 3 horas
+  const sinForzar = await cancelar(api, c);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await cancelar(api, c, { forzar: true });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+  assert.equal(forzada.cuerpo.reembolso, 900);
+});
+
+prueba("C2 · límites exactos: 48 h justas no penalizan, 24 h justas cobran el 25 % sin forzar, y un minuto menos exige forzar", async (api) => {
+  const enLimite48 = await reservar(api, "socio-030", "pista-3", "2026-12-10T12:00");
+  const enLimite24 = await reservar(api, "socio-031", "pista-2", "2026-12-10T12:00");
+  const unMinutoMenos = await reservar(api, "socio-032", "pista-1", "2026-12-10T12:00");
+  const cuarentaYOcho = await reservar(api, "socio-034", "pista-1", "2026-12-10T15:00");
+
+  await enHora(api, "2026-12-08T12:00");
+  const justas48 = await cancelar(api, enLimite48);
+  assert.equal(justas48.status, 200);
+  assert.equal(justas48.cuerpo.reserva.penalizacion, 0);
+  assert.equal(justas48.cuerpo.reembolso, 1200);
+
+  await enHora(api, "2026-12-08T15:01"); // 47 h 59 min antes de las 15:00 del jueves
+  const menosDeCuarentaYOcho = await cancelar(api, cuarentaYOcho);
+  assert.equal(menosDeCuarentaYOcho.status, 200);
+  assert.equal(menosDeCuarentaYOcho.cuerpo.reserva.penalizacion, 450); // 25 % de 1800
+
+  await enHora(api, "2026-12-09T12:00");
+  const justas24 = await cancelar(api, enLimite24);
+  assert.equal(justas24.status, 200, JSON.stringify(justas24.cuerpo));
+  assert.equal(justas24.cuerpo.reserva.penalizacion, 450);
+  assert.equal(justas24.cuerpo.reembolso, 1350);
+
+  await enHora(api, "2026-12-09T12:01"); // 23 h 59 min
+  const unMinuto = await cancelar(api, unMinutoMenos);
