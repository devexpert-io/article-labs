+
+  await enHora(api, "2027-03-27T21:00"); // 23 horas reales, aunque el reloj de pared diga 24
+  const fueraDePlazo = await cancelar(api, pista2);
+  assert.equal(fueraDePlazo.status, 409);
+  assert.equal(fueraDePlazo.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await cancelar(api, pista2, { forzar: true });
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1400); // 50 % de 2800
+});
+
+prueba("C4 · reembolso: importe menos penalización, o el importe entero si no hay penalización", async (api) => {
+  const parcial = await reservar(api, "socio-030", "pista-3", "2026-12-10T19:30"); // punta, 2000
+  const forzada = await reservar(api, "socio-031", "pista-1", "2026-12-10T19:30"); // punta, 2800
+  const libre = await reservar(api, "socio-032", "pista-2", "2026-12-14T09:00"); // valle, 1800
