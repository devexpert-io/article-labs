+test("el informe incluye no presentadas y respeta las cancelaciones de la semilla", async (t) => {
+  const api = await preparar(t);
+  const antes: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const octubre = antes.reservas.filter((r) => r.inicio.startsWith("2026-10-"));
+  assert.ok(octubre.some((r) => r.estado === "no_presentada"));
+  assert.ok(octubre.some((r) => r.estado === "cancelada"));
+  const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-040" });
+  assert.equal(informe.status, 200);
+  let reservas = 0;
+  let ingresos = 0;
+  for (const fila of informe.cuerpo.pistas) {
+    const cobradas = octubre.filter((r) => r.pistaId === fila.pistaId && r.estado !== "cancelada");
+    const importe = cobradas.reduce((suma, r) => suma + r.importe, 0);
+    assert.deepEqual(fila, { pistaId: fila.pistaId, reservas: cobradas.length, ingresos: importe, penalizaciones: 0, total: importe });
+    reservas += cobradas.length;
+    ingresos += importe;
+  }
+  assert.deepEqual(informe.cuerpo.total, { reservas, ingresos, penalizaciones: 0, total: ingresos });
+  const historica = octubre.find((r) => r.estado === "cancelada")!;
+  error(await api.pedir("POST", `/api/reservas/${historica.id}/cancelar`, { cuerpo: { forzar: true } }), 409, "YA_CANCELADA");
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, antes.reservas);
+});
