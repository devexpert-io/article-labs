+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import type { Estado } from "../src/tipos.ts";
+
+async function preparar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function crear(api: Api, inicio = "2026-12-03T12:00", pistaId = "pista-1", socioId = "socio-041") {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(respuesta.status, 201, respuesta.texto);
+  return respuesta.cuerpo.reserva;
+}
+
+function error(respuesta: Respuesta, status: number, codigo: string) {
+  assert.equal(respuesta.status, status, respuesta.texto);
+  assert.equal(respuesta.cuerpo.error.codigo, codigo);
+}
+
+for (const [ahora, porcentaje] of [
+  ["2026-12-01T11:59", 0],
+  ["2026-12-01T12:00", 0],
+  ["2026-12-01T12:01", 0.25],
+  ["2026-12-02T11:59", 0.25],
+  ["2026-12-02T12:00", 0.25],
+  ["2026-12-02T12:01", 0.5],
+  ["2026-12-03T11:59", 0.5],
+] as const) {
+  test(`tramo y reembolso con reloj ${ahora}: ${porcentaje * 100} %`, async (t) => {
+    const api = await preparar(t);
+    const reserva = await crear(api);
+    await reloj(api, ahora);
+    const ruta = `/api/reservas/${reserva.id}/cancelar`;
+    if (porcentaje === 0.5) {
+      for (const cuerpo of [{}, { forzar: false }]) {
+        error(await api.pedir("POST", ruta, { cuerpo }), 409, "FUERA_DE_PLAZO");
+        assert.deepEqual((await api.pedir("GET", `/api/reservas/${reserva.id}`)).cuerpo.reserva, reserva);
+      }
+    }
+    const respuesta = await api.pedir("POST", ruta, { cuerpo: { forzar: porcentaje === 0.5, motivo: "Cambio de planes" } });
+    assert.equal(respuesta.status, 200);
+    assert.equal(respuesta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(respuesta.cuerpo.reserva.penalizacion, reserva.importe * porcentaje);
+    assert.equal(respuesta.cuerpo.reembolso, reserva.importe * (1 - porcentaje));
+    assert.equal(respuesta.cuerpo.reserva.motivoCancelacion, "Cambio de planes");
+  });
