+/** Diferencia en milisegundos entre la hora de Madrid y UTC en el instante `ms`. */
+function desfaseMadrid(ms: number): number {
+  const p = Object.fromEntries(formatoMadrid.formatToParts(new Date(ms)).map((x) => [x.type, x.value]));
