@@ -0,0 +1,321 @@
+// Spec docs/specs/reembolsos.md: penalizaciones escalonadas, exención e informe de caja.
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const NORA = "socio-041"; // sin reservas en la semilla
+const MOTIVO = "Lesión justificada con parte médico";
+
+/** Cada test arranca su propia API con una semilla nueva. */
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reservar(api: Api, pistaId: string, inicio: string, socioId = NORA) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+}
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+function cancelar(api: Api, id: string, cuerpo: Record<string, unknown> = {}, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+/** Comprueba la respuesta entera de una cancelación correcta. */
+function assertCancelada(respuesta: { status: number; cuerpo: any }, reserva: any, penalizacion: number | undefined, extra: Record<string, unknown> = {}) {
+  assert.equal(respuesta.status, 200);
+  const esperada = { ...reserva, estado: "cancelada", ...(penalizacion ? { penalizacion } : {}), ...extra };
+  assert.deepEqual(respuesta.cuerpo, { reserva: esperada, reembolso: reserva.importe - (penalizacion ?? 0) });
+}
+
+function assertError(respuesta: { status: number; cuerpo: any }, http: number, codigo: string) {
+  assert.equal(respuesta.status, http);
+  assert.equal(respuesta.cuerpo.error.codigo, codigo);
+  assert.equal(typeof respuesta.cuerpo.error.mensaje, "string");
+}
+
+// Miércoles 25 de noviembre de 2026 a las 12:00 en la pista 3: valle, 1200 céntimos.
+const INICIO = "2026-11-25T12:00";
+
+test("C1 · con 48 horas o más de antelación no hay penalización", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-11-23T10:00"); // 50 horas
+  assertCancelada(await cancelar(api, r.id), r, undefined);
+}));
+
+test("C1 · con 24 horas o más y menos de 48 la penalización es el 25 %", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-11-24T10:00"); // 26 horas
+  assertCancelada(await cancelar(api, r.id), r, 300);
+}));
+
+test("C1 · con menos de 24 horas sin forzar responde 409 FUERA_DE_PLAZO y no cancela", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-11-24T13:00"); // 23 horas
+  assertError(await cancelar(api, r.id), 409, "FUERA_DE_PLAZO");
+  assertError(await cancelar(api, r.id, { forzar: false }), 409, "FUERA_DE_PLAZO");
+  const tras = await api.pedir("GET", `/api/reservas/${r.id}`);
+  assert.equal(tras.status, 200);
+  assert.deepEqual(tras.cuerpo, { reserva: r });
+}));
+
+test("C1 · con menos de 24 horas y forzar la penalización es el 50 %", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-11-24T13:00");
+  assertCancelada(await cancelar(api, r.id, { forzar: true }), r, 600);
+}));
+
+test("C2 · a 48 horas justas no hay penalización", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-11-23T12:00");
+  assertCancelada(await cancelar(api, r.id), r, undefined);
+}));
+
+test("C2 · un minuto por debajo de 48 horas ya se aplica el 25 %", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-11-23T12:01");
+  assertCancelada(await cancelar(api, r.id), r, 300);
+}));
+
+test("C2 · a 24 horas justas se aplica el 25 % sin necesidad de forzar", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-11-24T12:00");
+  assertCancelada(await cancelar(api, r.id), r, 300);
+}));
+
+test("C2 · un minuto por debajo de 24 horas ya hace falta forzar", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-11-24T12:01");
+  assertError(await cancelar(api, r.id), 409, "FUERA_DE_PLAZO");
+  assertCancelada(await cancelar(api, r.id, { forzar: true }), r, 600);
+}));
+
+// Domingo 28 de marzo de 2027 a las 21:00 en la pista 3: punta, 2000 céntimos. Esa madrugada se adelanta la hora.
+const DOMINGO_CAMBIO = "2027-03-28T21:00";
+
+test("C3 · del viernes 26 de marzo a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas: 25 %", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", DOMINGO_CAMBIO);
+  assert.equal(r.importe, 2000);
+  await reloj(api, "2027-03-26T20:30");
+  assertCancelada(await cancelar(api, r.id), r, 500);
+}));
+
+test("C3 · con el adelanto de marzo, 48 horas de reloj son 47 reales: 25 %", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", DOMINGO_CAMBIO);
+  await reloj(api, "2027-03-26T21:00");
+  assertCancelada(await cancelar(api, r.id), r, 500);
+}));
+
+test("C3 · con el adelanto de marzo, 48 horas reales justas no tienen penalización", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", DOMINGO_CAMBIO);
+  await reloj(api, "2027-03-26T20:00");
+  assertCancelada(await cancelar(api, r.id), r, undefined);
+}));
+
+test("C3 · con el retraso de octubre, 47 horas de reloj son 48 reales: sin penalización", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", "2027-10-31T21:00");
+  await reloj(api, "2027-10-29T22:00");
+  assertCancelada(await cancelar(api, r.id), r, undefined);
+}));
+
+test("C3 · con el adelanto de marzo, 24 horas de reloj son 23 reales: hace falta forzar", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", DOMINGO_CAMBIO);
+  await reloj(api, "2027-03-27T21:00");
+  assertError(await cancelar(api, r.id), 409, "FUERA_DE_PLAZO");
+  assertCancelada(await cancelar(api, r.id, { forzar: true }), r, 1000);
+}));
+
+test("C4 · el reembolso es el importe menos la penalización, o el importe entero sin penalización", () => conApi(async (api) => {
+  const punta = await reservar(api, "pista-1", "2026-11-25T18:00"); // 2800
