@@ -0,0 +1,168 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("solo un gestor genera y consulta facturas", () => conApi({}, async (api) => {
+  for (const [metodo, ruta, cuerpo] of [
+    ["POST", "/api/facturas", { mes: "2026-10" }],
+    ["GET", "/api/facturas?mes=2026-10", undefined],
+    ["GET", "/api/facturas/F2026-0001", undefined],
+  ] as const) {
+    const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+    assert.equal(anonimo.status, 401, `${metodo} ${ruta}`);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-004" });
+    assert.equal(socio.status, 403, `${metodo} ${ruta}`);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas.length, 0, "no se ha generado nada");
+}));
+
+test("el mes tiene que tener el formato AAAA-MM y estar cerrado", () => conApi({}, async (api) => {
+  for (const mes of [undefined, "2026-10-01", "2026-13", "2026-1", 202610]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=octubre", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12"]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 409, mes);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T00:00" } });
+  assert.equal((await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).status, 201);
+}));
+
+test("octubre de 2026: una factura por socio con lo que se factura, numerada por orden de socio", () => conApi({}, async (api) => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const generado = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(generado.status, 201);
+  const facturas = generado.cuerpo.facturas;
+
+  // Lo esperado, calculado a partir de la semilla con las reglas de la gestoría.
+  const deOctubre = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+  const facturables = deOctubre.filter((r: any) => r.estado !== "cancelada" || r.penalizacion > 0);
+  const socios = [...new Set(facturables.map((r: any) => r.socioId))].sort();
+  assert.ok(deOctubre.some((r: any) => r.estado === "cancelada"), "la semilla trae cancelaciones en octubre");
+  assert.ok(deOctubre.some((r: any) => r.estado === "no_presentada"), "la semilla trae no presentadas en octubre");
+  assert.deepEqual(facturas.map((f: any) => f.socioId), socios);
+  assert.deepEqual(facturas.map((f: any) => f.numero), socios.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+
+  for (const f of facturas) {
+    assert.equal(f.mes, "2026-10");
+    const suyas = facturables.filter((r: any) => r.socioId === f.socioId).sort((a: any, b: any) => a.inicio.localeCompare(b.inicio));
+    assert.deepEqual(f.lineas, suyas.map((r: any) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })));
+    assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+    assert.equal(f.base, Math.round((f.total * 100) / 121));
+    assert.equal(f.iva, f.total - f.base);
+  }
+  // Las no presentadas se facturan y las canceladas sin penalización, no.
+  const lineas = facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId));
+  for (const r of deOctubre) {
+    assert.equal(lineas.includes(r.id), r.estado !== "cancelada", `${r.id} (${r.estado})`);
+  }
+  // Un socio sin nada que facturar no lleva factura.
+  assert.ok(!facturas.some((f: any) => f.socioId === "socio-041"));
+
+  // Consultar.
+  const listado = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(listado.status, 200);
+  assert.deepEqual(listado.cuerpo.facturas, facturas);
+  const una = await api.pedir("GET", `/api/facturas/${facturas[2].numero}`, { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo.factura, facturas[2]);
+  const ninguna = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+  assert.equal(ninguna.status, 404);
+  assert.equal(ninguna.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR })).cuerpo.facturas, []);
+
+  // Generar dos veces devuelve lo mismo y no crea ni gasta números.
+  const otraVez = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(otraVez.status, 200);
+  assert.deepEqual(otraVez.cuerpo.facturas, facturas);
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, facturas.length);
+}));
+
+test("base e IVA sobre el total: 1.800 + 1.800 + 2.800 dan base 5.289 e IVA 1.111", () => conApi({ AHORA: "2027-01-10T10:00" }, async (api) => {
+  // Nora Benítez no tiene reservas: le hacemos tres en febrero de 2027 (dos de valle y una de punta en la pista 1).
+  for (const inicio of ["2027-02-02T09:00", "2027-02-03T10:30", "2027-02-04T18:00"]) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio } });
+    assert.equal(r.status, 201);
+  }
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-01T09:00" } });
+  const { facturas } = (await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2027-02" }, socio: GESTOR })).cuerpo;
+  assert.equal(facturas.length, 1);
+  const [f] = facturas;
+  assert.equal(f.numero, "F2027-0001");
+  assert.deepEqual(f.lineas.map((l: any) => l.importe), [1800, 1800, 2800]);
+  assert.equal(f.total, 6400);
+  assert.equal(f.base, 5289);
+  assert.equal(f.iva, 1111);
+}));
+
+test("una cancelación con penalización entra como Penalización y una gratuita no entra", () => conApi({}, async (api) => {
+  // R-0520: Marta López, jueves 19 a las 09:00, fuera de plazo.
+  const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1200);
+  const nueva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-002", pistaId: "pista-3", inicio: "2026-11-24T12:00" } });
+  const gratis = nueva.cuerpo.reserva.id;
+  await api.pedir("POST", `/api/reservas/${gratis}/cancelar`);
+
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T09:00" } });
+  const { facturas } = (await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).cuerpo;
+  const marta = facturas.find((f: any) => f.socioId === "socio-002");
+  assert.ok(marta, "Marta López tiene factura por la penalización");
+  assert.deepEqual(marta.lineas.find((l: any) => l.reservaId === "R-0520"), { reservaId: "R-0520", concepto: "Penalización", importe: 1200 });
+  assert.ok(!facturas.some((f: any) => f.lineas.some((l: any) => l.reservaId === gratis)), "la cancelación gratuita no se factura");
+  // Las líneas van por inicio de la reserva.
+  for (const f of facturas) {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const inicios = f.lineas.map((l: any) => estado.reservas.find((r: any) => r.id === l.reservaId).inicio);
+    assert.deepEqual(inicios, [...inicios].sort());
+  }
+}));
+
+test("numeración: una serie por año del mes facturado, sin huecos, aunque se generen fuera de orden", () => conApi({}, async (api) => {
+  const pedir = async (mes: string) => (await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR })).cuerpo.facturas;
+  // Una reserva en diciembre de 2026 y otra en enero de 2027.
+  await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-12-15T18:00" } });
+  await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2027-01-12T18:00" } });
+
+  const octubre = await pedir("2026-10");
+  const n = octubre.length;
+  // Septiembre no tiene facturas: no gasta números.
+  assert.deepEqual(await pedir("2026-09"), []);
+
+  // Diciembre de 2026 generado en enero de 2027 sigue la serie de 2026.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-05T10:00" } });
+  const diciembre = await pedir("2026-12");
+  assert.deepEqual(diciembre.map((f: any) => f.numero), [`F2026-${String(n + 1).padStart(4, "0")}`]);
+
+  // Noviembre, generado después de diciembre, sigue donde lo dejó diciembre.
+  const noviembre = await pedir("2026-11");
+  assert.deepEqual(noviembre.map((f: any) => f.numero), noviembre.map((_: any, i: number) => `F2026-${String(n + 2 + i).padStart(4, "0")}`));
+
+  // Enero de 2027 empieza su propia serie.
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-01T00:00" } });
+  assert.deepEqual((await pedir("2027-01")).map((f: any) => f.numero), ["F2027-0001"]);
+
+  // Todos los números de 2026 son correlativos, sin huecos ni repetidos.
+  const todas = (await api.pedir("GET", "/_estado")).cuerpo.facturas.map((f: any) => f.numero).filter((x: string) => x.startsWith("F2026-")).sort();
+  assert.deepEqual(todas, todas.map((_: string, i: number) => `F2026-${String(i + 1).padStart(4, "0")}`));
+  // Repetir un mes no gasta números.
+  assert.deepEqual(await pedir("2026-11"), noviembre);
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, n + 1 + noviembre.length + 1);
+}));
