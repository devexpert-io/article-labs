+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import type { Estado, Reserva } from "../src/tipos.ts";
+
+let api: Api;
+beforeEach(async () => { api = await arrancarApi(); });
+afterEach(() => api.cerrar());
+
+function error(respuesta: Respuesta, status: number, codigo: string) {
+  assert.equal(respuesta.status, status);
+  assert.equal(respuesta.cuerpo.error.codigo, codigo);
+  assert.equal(typeof respuesta.cuerpo.error.mensaje, "string");
+}
+
+async function reloj(ahora: string) {
+  const respuesta = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { ahora });
+}
+
+async function crear(inicio = "2027-02-10T12:00", pistaId = "pista-3") : Promise<Reserva> {
+  const respuesta = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio, notas: "Prueba" },
+  });
+  assert.equal(respuesta.status, 201);
+  assert.deepEqual(respuesta.cuerpo.reserva, {
+    id: respuesta.cuerpo.reserva.id, socioId: "socio-041", pistaId, inicio,
+    fin: `${inicio.slice(0, 10)}T${inicio.endsWith("21:00") ? "22:30" : "13:30"}`,
+    estado: "confirmada", importe: pistaId === "pista-3" ? (inicio.endsWith("21:00") ? 2000 : 1200) : 1800,
+    notas: "Prueba",
+  });
+  return respuesta.cuerpo.reserva;
+}
+
+async function cancelar(r: Reserva, penalizacion: number, cuerpo: Record<string, unknown> = {}, socio?: string) {
+  const respuesta = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo, socio });
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, {
+    reserva: { ...r, estado: "cancelada", penalizacion, ...(typeof cuerpo.motivo === "string" ? { motivoCancelacion: cuerpo.motivo } : {}) },
+    reembolso: r.importe - penalizacion,
+  });
+}
