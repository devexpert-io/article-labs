+test("C7 · el historial incluye las no presentadas y excluye importes de canceladas", async () => {
+  const respuestaEstado = await api.pedir("GET", "/_estado");
+  assert.equal(respuestaEstado.status, 200);
+  const estado: Estado = respuestaEstado.cuerpo;
+  assert.equal(estado.reservas.some((r) => r.estado === "no_presentada" && r.inicio.startsWith("2026-10")), true);
+  const pistas = estado.pistas.map((p) => {
+    const delMes = estado.reservas.filter((r) => r.pistaId === p.id && r.inicio.startsWith("2026-10"));
+    const cobradas = delMes.filter((r) => r.estado !== "cancelada");
+    const ingresos = cobradas.reduce((suma, r) => suma + r.importe, 0);
+    return { pistaId: p.id, reservas: cobradas.length, ingresos, penalizaciones: 0, total: ingresos };
+  });
+  const respuesta = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-040" });
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { mes: "2026-10", pistas, total: {
+    reservas: pistas.reduce((n, p) => n + p.reservas, 0), ingresos: pistas.reduce((n, p) => n + p.ingresos, 0),
+    penalizaciones: 0, total: pistas.reduce((n, p) => n + p.total, 0),
+  } });
+});
