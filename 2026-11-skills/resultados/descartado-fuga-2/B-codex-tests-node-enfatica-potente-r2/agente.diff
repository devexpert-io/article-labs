+/** Convierte la hora local en un instante usando el desfase de Madrid para esa fecha. */
+function instanteMadrid(local: string): number {
+  const nominal = Date.parse(`${local}:00Z`);
+  let instante = nominal;
+  for (let i = 0; i < 3; i++) {
+    const partes = Object.fromEntries(relojMadrid.formatToParts(instante).map((p) => [p.type, p.value]));
+    const representado = Date.parse(`${partes.year}-${partes.month}-${partes.day}T${partes.hour}:${partes.minute}:00Z`);
+    const corregido = instante + nominal - representado;
+    if (corregido === instante) break;
+    instante = corregido;
+  }
+  return instante;
+}
