@@ -0,0 +1,237 @@
+// La política escalonada de cancelación, la exención y el informe de caja (spec reembolsos).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function moverReloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+async function crear(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201);
+  return r.cuerpo.reserva;
+}
+
+test("C1 · tramos de penalización: 48h+ gratis, 24–48h al 25 % y <24h al 50 % solo con forzar", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  await moverReloj(api, "2027-01-10T10:00");
+
+  // 50 horas de antelación: sin penalización.
+  const lejos = await crear(api, "socio-001", "pista-1", "2027-01-12T12:00");
+  const c1 = await api.pedir("POST", `/api/reservas/${lejos.id}/cancelar`);
+  assert.equal(c1.status, 200);
+  assert.equal(c1.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(c1.cuerpo.reembolso, 1800);
+
+  // 30,5 horas: penalización del 25 %.
+  const media = await crear(api, "socio-002", "pista-2", "2027-01-11T16:30");
+  const c2 = await api.pedir("POST", `/api/reservas/${media.id}/cancelar`);
+  assert.equal(c2.status, 200);
+  assert.equal(c2.cuerpo.reserva.penalizacion, 450);
+  assert.equal(c2.cuerpo.reembolso, 1350);
+
+  // 23 horas: exige forzar y penaliza el 50 %.
+  const cerca = await crear(api, "socio-003", "pista-3", "2027-01-11T09:00");
+  const sinForzar = await api.pedir("POST", `/api/reservas/${cerca.id}/cancelar`);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const conForzar = await api.pedir("POST", `/api/reservas/${cerca.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(conForzar.status, 200);
+  assert.equal(conForzar.cuerpo.reserva.penalizacion, 600);
+  assert.equal(conForzar.cuerpo.reembolso, 600);
+});
+
+test("C2 · límites exactos: a 48 horas justas no hay penalización y a 24 horas justas es el 25 % sin forzar", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  await moverReloj(api, "2027-01-10T12:00");
+
+  const a48 = await crear(api, "socio-001", "pista-1", "2027-01-12T12:00");
+  const c48 = await api.pedir("POST", `/api/reservas/${a48.id}/cancelar`);
+  assert.equal(c48.status, 200);
+  assert.equal(c48.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(c48.cuerpo.reembolso, 1800);
+
+  const a24 = await crear(api, "socio-002", "pista-2", "2027-01-11T12:00");
+  const c24 = await api.pedir("POST", `/api/reservas/${a24.id}/cancelar`);
+  assert.equal(c24.status, 200);
+  assert.equal(c24.cuerpo.reserva.penalizacion, 450);
+  assert.equal(c24.cuerpo.reembolso, 1350);
+});
+
+test("C3 · cambio de hora: la antelación cuenta las horas reales de Madrid", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  await moverReloj(api, "2027-03-26T20:30");
+
+  // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas (no 48,5): toca el 25 %.
+  const r = await crear(api, "socio-001", "pista-1", "2027-03-28T21:00");
+  assert.equal(r.importe, 2800);
+  const c = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.penalizacion, 700);
+  assert.equal(c.cuerpo.reembolso, 2100);
+});
+
+test("C4 · reembolso: la respuesta incluye reembolso = importe - penalización", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  await moverReloj(api, "2027-01-10T10:00");
+
+  const conPenalizacion = await crear(api, "socio-001", "pista-1", "2027-01-11T09:00");
+  const forzada = await api.pedir("POST", `/api/reservas/${conPenalizacion.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+  assert.equal(forzada.cuerpo.reembolso, 900);
+  assert.equal(forzada.cuerpo.reserva.importe - forzada.cuerpo.reserva.penalizacion, forzada.cuerpo.reembolso);
+
+  const sinPenalizacion = await crear(api, "socio-002", "pista-2", "2027-01-13T10:30");
+  const gratis = await api.pedir("POST", `/api/reservas/${sinPenalizacion.id}/cancelar`);
+  assert.equal(gratis.status, 200);
+  assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.cuerpo.reembolso, 1800);
+});
+
+test("C5 · exención: un gestor puede eximir con motivo; sin gestor o sin motivo se rechaza", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  await moverReloj(api, "2027-01-10T10:00");
+
+  // Exención correcta (menos de 24 h, sin forzar): cancelada sin penalización y con motivo.
+  const r1 = await crear(api, "socio-001", "pista-1", "2027-01-11T09:00");
+  const exenta = await api.pedir("POST", `/api/reservas/${r1.id}/cancelar`, {
+    socio: "socio-040",
+    cuerpo: { exento: true, motivo: "Incidencia en la pista" },
+  });
+  assert.equal(exenta.status, 200);
+  assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "Incidencia en la pista");
+  assert.equal(exenta.cuerpo.reembolso, 1800);
+
+  // Un socio que no es gestor no puede eximir.
+  const r2 = await crear(api, "socio-002", "pista-2", "2027-01-11T09:00");
+  const noGestor = await api.pedir("POST", `/api/reservas/${r2.id}/cancelar`, {
+    socio: "socio-001",
+    cuerpo: { exento: true, motivo: "Incidencia en la pista" },
+  });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+  // Sin cabecera X-Socio no se sabe quién llama.
+  const r3 = await crear(api, "socio-003", "pista-3", "2027-01-11T09:00");
+  const sinIdentidad = await api.pedir("POST", `/api/reservas/${r3.id}/cancelar`, {
+    cuerpo: { exento: true, motivo: "Incidencia en la pista" },
+  });
+  assert.equal(sinIdentidad.status, 401);
+  assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  // Motivo demasiado corto.
+  const r4 = await crear(api, "socio-001", "pista-1", "2027-01-11T10:30");
+  const corto = await api.pedir("POST", `/api/reservas/${r4.id}/cancelar`, {
+    socio: "socio-040",
+    cuerpo: { exento: true, motivo: "corto" },
+  });
+  assert.equal(corto.status, 400);
+  assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  // Motivo ausente.
+  const r5 = await crear(api, "socio-002", "pista-2", "2027-01-11T10:30");
+  const sinMotivo = await api.pedir("POST", `/api/reservas/${r5.id}/cancelar`, {
