+  await crear(api, "socio-002", "pista-2", "2027-01-20T18:00"); // confirmada, 2800
+  const c = await crear(api, "socio-003", "pista-3", "2027-01-21T12:00"); // cancelada con penalización
+  await moverReloj(api, "2027-01-21T10:00");
