+  try {
+    // Permisos y formato
+    let sinIdentidad = await api.pedir("GET", "/api/informes/caja?mes=2026-12");
+    assert.equal(sinIdentidad.status, 401);
+    assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    let noGestor = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: "socio-003" });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    let malFormato = await api.pedir("GET", "/api/informes/caja?mes=2026-12-01", { socio: "socio-040" });
+    assert.equal(malFormato.status, 400);
+    assert.equal(malFormato.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // Dos confirmadas (ingresos) y una cancelada (penalización)
+    const a = await crear(api, "2026-12-05T09:00", "socio-001", "pista-1");
+    const b = await crear(api, "2026-12-05T10:30", "socio-002", "pista-2");
+    const c = await crear(api, "2026-12-05T12:00", "socio-003", "pista-3");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-04T11:00" } });
+    const cancelada = await api.pedir("POST", `/api/reservas/${c.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+
+    const ia = a.cuerpo.reserva.importe;
+    const ib = b.cuerpo.reserva.importe;
+    const pc = cancelada.cuerpo.reserva.penalizacion;
+    assert.equal(pc, Math.round(c.cuerpo.reserva.importe * 0.25));
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+    assert.equal(informe.cuerpo.mes, "2026-12");
+    assert.deepEqual(informe.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+
+    const porPista = Object.fromEntries(informe.cuerpo.pistas.map((p: any) => [p.pistaId, p]));
+    assert.deepEqual(porPista["pista-1"], { pistaId: "pista-1", reservas: 1, ingresos: ia, penalizaciones: 0, total: ia });
+    assert.deepEqual(porPista["pista-2"], { pistaId: "pista-2", reservas: 1, ingresos: ib, penalizaciones: 0, total: ib });
+    assert.deepEqual(porPista["pista-3"], { pistaId: "pista-3", reservas: 0, ingresos: 0, penalizaciones: pc, total: pc });
+    assert.deepEqual(porPista["pista-4"], { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+
+    assert.deepEqual(informe.cuerpo.total, {
+      reservas: 2,
+      ingresos: ia + ib,
+      penalizaciones: pc,
+      total: ia + ib + pc,
+    });
+  } finally {
+    api.cerrar();
+  }
