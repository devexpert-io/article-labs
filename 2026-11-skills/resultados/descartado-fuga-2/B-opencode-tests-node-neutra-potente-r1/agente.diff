+// Penalizaciones escalonadas, exención y reembolso, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function crear(api: Api, inicio: string, socioId = "socio-003", pistaId = "pista-1") {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+}
+
+test("C1 y C2 · tramos de penalización y límites exactos, con reembolso", async () => {
+  const api = await arrancarApi({ AHORA: "2026-12-10T09:00" });
+  try {
+    const slot = "2026-12-12T09:00";
+    const reloj = (ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+
+    // 48 horas justas → sin penalización (C2)
+    let r = await crear(api, slot);
+    const importe = r.cuerpo.reserva.importe;
+    await reloj("2026-12-10T09:00");
+    let c = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c.cuerpo.reembolso, importe);
+
+    // Más de 48 horas → sin penalización (C1)
+    r = await crear(api, slot);
+    await reloj("2026-12-09T09:00");
+    c = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+    assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c.cuerpo.reembolso, importe);
+
+    // 24 horas justas → 25 %, sin forzar (C2)
+    r = await crear(api, slot);
+    await reloj("2026-12-11T09:00");
+    c = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, Math.round(importe * 0.25));
+    assert.equal(c.cuerpo.reembolso, importe - Math.round(importe * 0.25));
+
+    // Entre 24 y 48 horas → 25 %, sin forzar (C1)
+    r = await crear(api, slot);
+    await reloj("2026-12-11T08:00");
+    c = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, Math.round(importe * 0.25));
+
+    // Menos de 24 horas: sin forzar, 409 FUERA_DE_PLAZO (C1)
+    r = await crear(api, slot);
+    await reloj("2026-12-12T08:00");
+    c = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+    assert.equal(c.status, 409);
+    assert.equal(c.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    // Con forzar → 50 % y reembolso del 50 % (C1)
+    c = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, Math.round(importe * 0.5));
+    assert.equal(c.cuerpo.reembolso, importe - Math.round(importe * 0.5));
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C3 · cambio de hora: 47,5 horas reales de Madrid dan el 25 %", async () => {
+  const api = await arrancarApi({ AHORA: "2027-03-26T20:30" });
+  try {
+    const r = await crear(api, "2027-03-28T21:00");
+    assert.equal(r.status, 201);
+    // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales (se adelanta el reloj).
+    const c = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, Math.round(r.cuerpo.reserva.importe * 0.25));
+  } finally {
