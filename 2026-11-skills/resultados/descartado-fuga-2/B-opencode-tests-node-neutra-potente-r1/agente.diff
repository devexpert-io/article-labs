+
+test("C6 · una reserva ya empezada no se cancela, tampoco con exento", async () => {
+  const api = await arrancarApi({ AHORA: "2026-12-10T09:00" });
+  try {
+    const r = await crear(api, "2026-12-12T09:00", "socio-001");
