@@ -0,0 +1,134 @@
+// Las reglas de facturación de la gestoría, probadas sobre el núcleo y a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { crearClub } from "../src/nucleo.ts";
+import type { Estado } from "../src/tipos.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+function clubDe(parcial: Partial<Estado>): ReturnType<typeof crearClub> {
+  const estado: Estado = {
+    ahora: "2027-01-10T10:00",
+    pistas: [],
+    socios: [{ id: "socio-001", nombre: "Ana", email: "ana@example.com", cuotaActiva: true, rol: "socio" }],
+    reservas: [],
+    registro: [],
+    contador: 0,
+    facturas: [],
+    mesesFacturados: [],
+    ...parcial,
+  };
+  return crearClub(estado);
+}
+
+test("base e IVA: tres líneas de 1.800, 1.800 y 2.800 dan total 6.400, base 5.289 e IVA 1.111", () => {
+  const club = clubDe({
+    reservas: [
+      { id: "R-1", socioId: "socio-001", pistaId: "pista-1", inicio: "2026-12-01T10:30", fin: "2026-12-01T12:00", estado: "confirmada", importe: 1800, notas: "" },
+      { id: "R-2", socioId: "socio-001", pistaId: "pista-1", inicio: "2026-12-01T12:00", fin: "2026-12-01T13:30", estado: "confirmada", importe: 1800, notas: "" },
+      { id: "R-3", socioId: "socio-001", pistaId: "pista-1", inicio: "2026-12-01T18:00", fin: "2026-12-01T19:30", estado: "confirmada", importe: 2800, notas: "" },
+    ],
+  });
+  const { facturas } = club.generarFacturas("2026-12");
+  assert.equal(facturas.length, 1);
+  assert.equal(facturas[0]!.total, 6400);
+  assert.equal(facturas[0]!.base, 5289);
+  assert.equal(facturas[0]!.iva, 1111);
+  assert.equal(facturas[0]!.base + facturas[0]!.iva, facturas[0]!.total);
+});
+
+test("una cancelación con penalización entra como Penalización y sin penalización no entra", () => {
+  const club = clubDe({
+    reservas: [
+      { id: "R-1", socioId: "socio-001", pistaId: "pista-1", inicio: "2026-12-01T10:30", fin: "2026-12-01T12:00", estado: "confirmada", importe: 1800, notas: "" },
+      { id: "R-2", socioId: "socio-001", pistaId: "pista-1", inicio: "2026-12-01T12:00", fin: "2026-12-01T13:30", estado: "cancelada", importe: 1800, notas: "", penalizacion: 1800 },
+      { id: "R-3", socioId: "socio-001", pistaId: "pista-1", inicio: "2026-12-01T13:30", fin: "2026-12-01T15:00", estado: "cancelada", importe: 1800, notas: "" },
+    ],
+  });
+  const { facturas } = club.generarFacturas("2026-12");
+  assert.equal(facturas.length, 1);
+  assert.deepEqual(facturas[0]!.lineas.map((l) => l.concepto), ["Reserva", "Penalización"]);
+  assert.deepEqual(facturas[0]!.lineas.map((l) => l.importe), [1800, 1800]);
+  assert.equal(facturas[0]!.total, 3600);
+});
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+test("solo un gestor genera y consulta facturas", async () => {
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10")).status, 401);
+  const sinIdentidad = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+  assert.equal(sinIdentidad.status, 401);
+  assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const noGestor = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" })).status, 403);
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).status, 200);
+});
+
+test("mes inválido y mes abierto se rechazan", async () => {
+  const mal = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-13" }, socio: GESTOR });
+  assert.equal(mal.status, 400);
+  assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+  assert.equal(abierto.status, 409);
+  assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+});
+
+test("generar octubre: 201 la primera vez, 200 después, con las mismas facturas", async () => {
+  const primera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(primera.status, 201);
+  const facturas = primera.cuerpo.facturas as Array<{ numero: string; socioId: string; total: number; base: number; iva: number; lineas: Array<{ importe: number }> }>;
+  assert.ok(facturas.length > 0, "octubre tiene algo que facturar");
+  const ids = facturas.map((f) => f.socioId);
+  assert.deepEqual(ids, [...ids].sort(), "las facturas van ordenadas por id de socio");
+  assert.equal(facturas[0]!.numero, "F2026-0001");
+  for (let i = 0; i < facturas.length; i++) {
+    const f = facturas[i]!;
+    assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`, "numeración correlativa sin huecos");
+    assert.equal(f.total, f.lineas.reduce((s, l) => s + l.importe, 0));
+    assert.equal(f.base + f.iva, f.total);
+  }
+  const segunda = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(segunda.status, 200);
+  assert.deepEqual(segunda.cuerpo.facturas, facturas);
+});
+
+test("consultar facturas: por mes, por número y sin resultados", async () => {
+  const lista = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(lista.status, 200);
+  assert.ok(lista.cuerpo.facturas.length > 0);
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR })).cuerpo.facturas, []);
+  const numero = lista.cuerpo.facturas[0].numero;
+  const una = await api.pedir("GET", `/api/facturas/${numero}`, { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.equal(una.cuerpo.factura.numero, numero);
+  const noExiste = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+  assert.equal(noExiste.status, 404);
+  assert.equal(noExiste.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("numeración: diciembre generado en enero sigue la serie de 2026 y enero empieza en 0001", async () => {
+  const otra = await arrancarApi();
+  try {
+    // Nora Benítez (socio-041) no tiene reservas: creamos una en diciembre y otra en enero.
+    assert.equal((await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-14T10:30" } })).status, 201);
+    assert.equal((await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-11T10:30" } })).status, 201);
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-15T10:00" } });
+
+    const diciembre = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+    assert.equal(diciembre.status, 201);
+    assert.equal(diciembre.cuerpo.facturas[0].numero, "F2026-0001", "el año es el del mes facturado");
+
+    const enero = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2027-01" }, socio: GESTOR });
+    assert.equal(enero.status, 201);
+    assert.equal(enero.cuerpo.facturas[0].numero, "F2027-0001", "cada año empieza en 0001");
+  } finally {
+    otra.cerrar();
+  }
+});
