+// Penalizaciones escalonadas, exención por un gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const MOTIVO = "Lesión justificada con parte médico";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+async function reloj(ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+/** Crea una reserva con el reloj en `creadaEn` y devuelve su id. */
+async function reservar(socioId: string, pistaId: string, inicio: string, creadaEn: string): Promise<string> {
+  await reloj(creadaEn);
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva.id;
+}
+
+function cancelar(id: string, cuerpo: Record<string, unknown> = {}, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+const ANTES = "2026-12-01T10:00";
+
+test("tramos: sin penalización a 48 horas o más, 25 % desde 24 horas y 50 % con forzar por debajo", async () => {
+  // Pista 3 en valle: 1200 céntimos.
+  const lejos = await reservar("socio-003", "pista-3", "2026-12-10T12:00", ANTES);
+  await reloj("2026-12-07T09:00");
+  const sinPenalizacion = await cancelar(lejos);
+  assert.equal(sinPenalizacion.status, 200);
+  assert.equal(sinPenalizacion.cuerpo.reserva.estado, "cancelada");
+  assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(sinPenalizacion.cuerpo.reembolso, 1200);
+
+  const media = await reservar("socio-003", "pista-3", "2026-12-10T13:30", ANTES);
+  await reloj("2026-12-09T09:00");
+  const conCuarto = await cancelar(media);
+  assert.equal(conCuarto.status, 200);
+  assert.equal(conCuarto.cuerpo.reserva.penalizacion, 300);
+  assert.equal(conCuarto.cuerpo.reembolso, 900);
+
+  const cerca = await reservar("socio-003", "pista-3", "2026-12-10T16:30", ANTES);
+  await reloj("2026-12-10T09:00");
+  const sinForzar = await cancelar(cerca);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzarFalso = await cancelar(cerca, { forzar: false });
+  assert.equal(forzarFalso.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await cancelar(cerca, { forzar: true });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+  assert.equal(forzada.cuerpo.reembolso, 600);
+});
+
+test("límites exactos: a 48 horas justas no hay penalización y a 24 justas es el 25 % sin forzar", async () => {
+  const a48 = await reservar("socio-006", "pista-1", "2026-12-15T12:00", ANTES);
+  const casi48 = await reservar("socio-006", "pista-1", "2026-12-15T13:30", ANTES);
+  const a24 = await reservar("socio-006", "pista-1", "2026-12-15T15:00", ANTES);
+
+  await reloj("2026-12-13T12:00");
+  const justo48 = await cancelar(a48);
+  assert.equal(justo48.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(justo48.cuerpo.reembolso, 1800);
+
+  await reloj("2026-12-13T13:31");
+  const pasado48 = await cancelar(casi48);
+  assert.equal(pasado48.cuerpo.reserva.penalizacion, 450);
+  assert.equal(pasado48.cuerpo.reembolso, 1350);
+
+  await reloj("2026-12-14T15:00");
+  const justo24 = await cancelar(a24);
+  assert.equal(justo24.status, 200);
+  assert.equal(justo24.cuerpo.reserva.penalizacion, 450);
+  assert.equal(justo24.cuerpo.reembolso, 1350);
+
+  const casi24 = await reservar("socio-006", "pista-1", "2026-12-15T16:30", ANTES);
+  await reloj("2026-12-14T16:31");
+  assert.equal((await cancelar(casi24)).cuerpo.error.codigo, "FUERA_DE_PLAZO");
+});
+
+test("cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  // Primavera: del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas.
+  const primavera = await reservar("socio-007", "pista-1", "2027-03-28T21:00", "2027-03-20T10:00");
+  await reloj("2027-03-26T20:30");
+  const r1 = await cancelar(primavera);
+  assert.equal(r1.status, 200);
+  assert.equal(r1.cuerpo.reserva.penalizacion, 700, "47,5 horas reales: 25 % de 2800");
+  assert.equal(r1.cuerpo.reembolso, 2100);
+
+  // Otoño: del viernes 29 de octubre de 2027 a las 21:30 al domingo 31 a las 21:00 hay 48,5 horas, no 47,5.
+  const otono = await reservar("socio-007", "pista-1", "2027-10-31T21:00", "2027-10-20T10:00");
+  await reloj("2027-10-29T21:30");
+  const r2 = await cancelar(otono);
+  assert.equal(r2.cuerpo.reserva.penalizacion, undefined, "48,5 horas reales: sin penalización");
+  assert.equal(r2.cuerpo.reembolso, 2800);
+
+  // Primavera, frontera de 24 horas: del sábado 27 a las 20:30 al domingo 28 a las 21:00 hay 23,5 horas, no 24,5.
+  const cerca = await reservar("socio-007", "pista-2", "2027-03-28T21:00", "2027-03-20T10:00");
+  await reloj("2027-03-27T20:30");
+  assert.equal((await cancelar(cerca)).cuerpo.error.codigo, "FUERA_DE_PLAZO", "23,5 horas reales, no 24,5");
+});
+
+test("exención: un gestor cancela sin penalización con un motivo de al menos 10 caracteres", async () => {
+  const id = await reservar("socio-008", "pista-2", "2026-12-17T19:30", ANTES);
+  await reloj("2026-12-17T18:00");
+
+  const anonimo = await cancelar(id, { exento: true, motivo: MOTIVO });
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await cancelar(id, { exento: true, motivo: MOTIVO }, "socio-008");
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const sinMotivo = await cancelar(id, { exento: true }, GESTOR);
+  assert.equal(sinMotivo.status, 400);
+  assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const corto = await cancelar(id, { exento: true, motivo: "Lesión" }, GESTOR);
+  assert.equal(corto.status, 400);
+  assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const sigue = await api.pedir("GET", `/api/reservas/${id}`);
+  assert.equal(sigue.cuerpo.reserva.estado, "confirmada");
+
