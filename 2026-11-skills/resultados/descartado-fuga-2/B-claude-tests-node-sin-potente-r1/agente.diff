+    const mitad = await crear("socio-006", "pista-3", "2027-02-04T13:30");
+    const gratis = await crear("socio-006", "pista-3", "2027-02-20T13:30");
+    // Fuera del mes: no cuenta.
+    await crear("socio-007", "pista-2", "2027-03-01T12:00");
+    await otra.pedir("POST", `/api/reservas/${gratis}/cancelar`);
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-03T09:00" } });
+    assert.equal((await otra.pedir("POST", `/api/reservas/${cuarto}/cancelar`)).cuerpo.reserva.penalizacion, 450);
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-04T09:00" } });
+    assert.equal((await otra.pedir("POST", `/api/reservas/${mitad}/cancelar`, { cuerpo: { forzar: true } })).cuerpo.reserva.penalizacion, 600);
+
+    const informe = await otra.pedir("GET", "/api/informes/caja?mes=2027-02", { socio: GESTOR });
