+      mes: "2027-02",
+      pistas: [
+        { pistaId: "pista-1", reservas: 2, ingresos: 4600, penalizaciones: 450, total: 5050 },
+        { pistaId: "pista-2", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+        { pistaId: "pista-3", reservas: 0, ingresos: 0, penalizaciones: 600, total: 600 },
+        { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
