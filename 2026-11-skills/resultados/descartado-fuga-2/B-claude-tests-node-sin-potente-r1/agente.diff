+test("informe de caja: cuenta las confirmadas y las no presentadas de la semilla", async () => {
+  const otra = await arrancarApi();
+  try {
+    const estado = (await otra.pedir("GET", "/_estado")).cuerpo;
+    const octubre = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+    const cobradas = octubre.filter((r: any) => r.estado !== "cancelada");
+    assert.ok(octubre.some((r: any) => r.estado === "no_presentada"));
+    const informe = (await otra.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR })).cuerpo;
+    assert.deepEqual(informe.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+    const ingresos = cobradas.reduce((s: number, r: any) => s + r.importe, 0);
+    assert.deepEqual(informe.total, { reservas: cobradas.length, ingresos, penalizaciones: 0, total: ingresos });
+    for (const p of informe.pistas) {
+      const suyas = cobradas.filter((r: any) => r.pistaId === p.pistaId);
+      assert.equal(p.reservas, suyas.length);
+      assert.equal(p.ingresos, suyas.reduce((s: number, r: any) => s + r.importe, 0));
+    }
+  } finally {
+    otra.cerrar();
+  }
+});
