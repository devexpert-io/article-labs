+function instanteMadrid(local: string): number {
+  const [fecha, hora] = local.split("T");
+  const [y, m, d] = fecha!.split("-").map(Number);
+  const [hh, mm] = hora!.split(":").map(Number);
+  const pretendido = Date.UTC(y!, m! - 1, d!, hh!, mm!);
+  const partes = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/Madrid", timeZoneName: "longOffset", hour: "2-digit", minute: "2-digit", year: "numeric", month: "2-digit", day: "2-digit", hourCycle: "h23" }).formatToParts(new Date(pretendido));
+  const offset = partes.find((p) => p.type === "timeZoneName")!.value;
+  const match = /GMT([+-])(\d{2}):(\d{2})/.exec(offset);
+  const minutos = match ? (match[1] === "+" ? 1 : -1) * (Number(match[2]) * 60 + Number(match[3])) : 0;
+  return pretendido - minutos * 60_000;
+}
+
 function horasEntre(desde: string, hasta: string): number {
-  return (Date.parse(`${hasta}:00Z`) - Date.parse(`${desde}:00Z`)) / 3_600_000;
+  return (instanteMadrid(hasta) - instanteMadrid(desde)) / 3_600_000;
 }
 
