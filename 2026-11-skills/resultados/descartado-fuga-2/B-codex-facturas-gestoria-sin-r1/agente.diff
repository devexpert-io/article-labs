--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,141 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Factura, Reserva } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+const generar = (api: Api, mes: unknown) => api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+const reloj = (api: Api, ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+
+test("facturas: permisos en los tres endpoints, antes de validar datos", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const [metodo, ruta] of [["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F-2026-0001"]]) {
+    for (const [socio, status, codigo] of [[undefined, 401, "NO_IDENTIFICADO"], ["socio-999", 401, "NO_IDENTIFICADO"], ["socio-002", 403, "SIN_PERMISO"]] as const) {
+      const r = await api.pedir(metodo!, ruta!, { socio });
+      assert.equal(r.status, status);
+      assert.equal(r.cuerpo.error.codigo, codigo);
+    }
+  }
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.facturas, []);
+});
+
+test("facturas: validación del mes y cierre según el reloj del club", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const mes of [undefined, null, 202610, {}, "", "2026-1", "2026-00", "2026-13", "2026-10-01", " 2026-10"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const ruta of ["/api/facturas", "/api/facturas?mes=2026-13"]) {
+    const r = await api.pedir("GET", ruta, { socio: gestor });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj(api, "2026-11-30T23:59");
+  assert.equal((await generar(api, "2026-11")).status, 409);
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+});
+
+test("facturas: historial de octubre, líneas, orden, IVA y consultas", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).cuerpo, { facturas: [] });
+  const estadoAntes = (await api.pedir("GET", "/_estado")).cuerpo;
+  const reservas: Reserva[] = estadoAntes.reservas;
+  const facturables = reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(facturables.some((r) => r.estado === "no_presentada"));
+  const r = await generar(api, "2026-10");
+  assert.equal(r.status, 201);
+  assert.deepEqual(Object.keys(r.cuerpo), ["facturas"]);
+  const facturas: Factura[] = r.cuerpo.facturas;
+  assert.deepEqual(facturas.map((f) => f.socioId), [...new Set(facturables.map((r) => r.socioId))].sort());
+  assert.ok(!facturas.some((f) => f.socioId === "socio-041"));
+  for (const [i, f] of facturas.entries()) {
+    const suyas = facturables.filter((r) => r.socioId === f.socioId).sort((a, b) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+    assert.equal(f.numero, `F-2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.mes, "2026-10");
+    assert.deepEqual(f.lineas, suyas.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })));
+    const total = suyas.reduce((s, r) => s + r.importe, 0);
+    assert.equal(f.total, total);
+    assert.equal(f.base, Math.round(total / 1.21));
+    assert.equal(f.iva, total - f.base);
+    assert.ok(Number.isInteger(f.iva));
+    const consulta = await api.pedir("GET", `/api/facturas/${f.numero}`, { socio: gestor });
+    assert.equal(consulta.status, 200);
+    assert.deepEqual(consulta.cuerpo, { factura: f });
+  }
+  assert.ok(facturas.some((f) => f.base !== f.lineas.reduce((s, l) => s + Math.round(l.importe / 1.21), 0)), "el redondeo se aplica al total, no a cada línea");
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).cuerpo, r.cuerpo);
+  const inexistente = await api.pedir("GET", "/api/facturas/F-2026-9999", { socio: gestor });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, reservas);
+  const repetida = await generar(api, "2026-10");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo, r.cuerpo);
+});
+
+test("facturas: cancelaciones gratuitas y penalizaciones en el mes de inicio", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const marta = estado.reservas.find((r: Reserva) => r.socioId === "socio-002" && r.inicio === "2026-11-19T09:00");
+  const forzada = await api.pedir("POST", `/api/reservas/${marta.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1200);
+  const crear = async (inicio: string) => {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio } });
+    assert.equal(r.status, 201);
+    return r.cuerpo.reserva as Reserva;
+  };
+  const gratis = await crear("2026-11-30T09:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`)).status, 200);
+  const diciembre = await crear("2026-12-01T09:00");
+  await reloj(api, "2026-11-30T10:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${diciembre.id}/cancelar`, { cuerpo: { forzar: true } })).status, 200);
+  await reloj(api, "2026-12-01T00:00");
+  const noviembre: Factura[] = (await generar(api, "2026-11")).cuerpo.facturas;
+  assert.ok(!noviembre.some((f) => f.socioId === "socio-041"));
+  assert.deepEqual(noviembre.find((f) => f.socioId === marta.socioId)!.lineas.find((l) => l.reservaId === marta.id), {
+    reservaId: marta.id, concepto: "Penalización por cancelación", importe: 1200,
+  });
+  await reloj(api, "2027-01-01T00:00");
+  const diciembreFacturado = await generar(api, "2026-12");
+  assert.equal(diciembreFacturado.cuerpo.facturas.length, 1);
+  assert.deepEqual(diciembreFacturado.cuerpo.facturas[0].lineas, [{ reservaId: diciembre.id, concepto: "Penalización por cancelación", importe: 1200 }]);
+  assert.equal(diciembreFacturado.cuerpo.facturas[0].base, 992);
+  assert.equal(diciembreFacturado.cuerpo.facturas[0].iva, 208);
+});
+
+test("facturas: secuencia anual, meses vacíos, repetición y generación simultánea", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const vacio = await generar(api, "2026-09");
+  assert.equal(vacio.status, 201);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  assert.equal((await generar(api, "2026-09")).status, 200);
+  const octubre = await Promise.all([generar(api, "2026-10"), generar(api, "2026-10")]);
+  assert.deepEqual(octubre.map((r) => r.status).sort(), [200, 201]);
+  assert.deepEqual(octubre[0]!.cuerpo, octubre[1]!.cuerpo);
+  const n = octubre[0]!.cuerpo.facturas.length;
+  await reloj(api, "2026-12-01T00:00");
+  const noviembre = await generar(api, "2026-11");
+  assert.equal(noviembre.cuerpo.facturas[0].numero, `F-2026-${String(n + 1).padStart(4, "0")}`);
+  const nueva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-02T09:00" } });
+  assert.equal(nueva.status, 201);
+  await reloj(api, "2027-02-01T00:00");
+  const enero = await generar(api, "2027-01");
+  assert.equal(enero.cuerpo.facturas[0].numero, "F-2027-0001");
+  assert.deepEqual((await generar(api, "2026-10")).cuerpo, octubre[0]!.cuerpo);
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.facturas.length, n + noviembre.cuerpo.facturas.length + 1);
+  assert.equal(new Set(estado.facturas.map((f: Factura) => f.numero)).size, estado.facturas.length);
+});
