index 0000000..053a766
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,193 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const baseEsperada = (total: number) => Math.round((total * 100) / 121);
+
+test("solo un gestor genera y consulta facturas", async () => {
+  const rutas: [string, string, unknown?][] = [
+    ["POST", "/api/facturas", { mes: "2026-10" }],
+    ["GET", "/api/facturas?mes=2026-10"],
+    ["GET", "/api/facturas/F2026-0001"],
+  ];
+  for (const [metodo, ruta, cuerpo] of rutas) {
+    const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+    assert.equal(anonimo.status, 401, `${metodo} ${ruta}`);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-001" });
+    assert.equal(socio.status, 403, `${metodo} ${ruta}`);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  // Nada de lo anterior ha generado facturas.
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.facturas, []);
+});
+
+test("el mes tiene que ser AAAA-MM y estar cerrado", async () => {
+  for (const mes of [undefined, "2026-13", "2026-1", "octubre", 202610]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  const malGet = await api.pedir("GET", "/api/facturas?mes=2026-00", { socio: GESTOR });
+  assert.equal(malGet.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 409, mes);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+});
+
+test("octubre: una factura por socio, con sus líneas, el IVA y la numeración", async () => {
+  const otra = await arrancarApi();
+  try {
+    const estado = (await otra.pedir("GET", "/_estado")).cuerpo;
+    const deOctubre = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+    const facturables = deOctubre.filter((r: any) => r.estado !== "cancelada" || (r.penalizacion ?? 0) > 0);
+    const canceladasGratis = deOctubre.filter((r: any) => r.estado === "cancelada" && !r.penalizacion);
+    assert.ok(canceladasGratis.length > 0, "la semilla tiene cancelaciones sin penalización en octubre");
+    assert.ok(deOctubre.some((r: any) => r.estado === "no_presentada"), "y reservas no presentadas");
+
+    const generada = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(generada.status, 201);
+    const { facturas } = generada.cuerpo;
+
+    const socios = [...new Set(facturables.map((r: any) => r.socioId))].sort();
+    assert.deepEqual(facturas.map((f: any) => f.socioId), socios, "una factura por socio con algo que facturar, por orden de id");
+    assert.deepEqual(
+      facturas.map((f: any) => f.numero),
+      socios.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`),
+    );
+    for (const f of facturas) {
+      assert.equal(f.mes, "2026-10");
+      const suyas = facturables
+        .filter((r: any) => r.socioId === f.socioId)
+        .sort((a: any, b: any) => a.inicio.localeCompare(b.inicio));
+      assert.deepEqual(f.lineas, suyas.map((r: any) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })));
+      assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+      assert.equal(f.base, baseEsperada(f.total));
+      assert.equal(f.base + f.iva, f.total);
+    }
+    const lineas = facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId));
+    for (const r of canceladasGratis) assert.ok(!lineas.includes(r.id), `${r.id} cancelada sin penalización no se factura`);
+
+    // Generar otra vez: las mismas facturas, sin crear ninguna.
+    const repetida = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(repetida.status, 200);
+    assert.deepEqual(repetida.cuerpo.facturas, facturas);
+    assert.equal((await otra.pedir("GET", "/_estado")).cuerpo.facturas.length, facturas.length);
+
+    // Consultar.
+    const lista = await otra.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.equal(lista.status, 200);
+    assert.deepEqual(lista.cuerpo.facturas, facturas);
+    const sinGenerar = await otra.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+    assert.deepEqual(sinGenerar.cuerpo, { facturas: [] });
+    const una = await otra.pedir("GET", `/api/facturas/${facturas[2].numero}`, { socio: GESTOR });
+    assert.equal(una.status, 200);
+    assert.deepEqual(una.cuerpo.factura, facturas[2]);
+    const noExiste = await otra.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+    assert.equal(noExiste.status, 404);
+    assert.equal(noExiste.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("penalizaciones, IVA sobre el total y numeración entre meses y años", async () => {
+  const otra = await arrancarApi();
+  const gestor = (metodo: string, ruta: string, cuerpo?: unknown) => otra.pedir(metodo, ruta, { cuerpo, socio: GESTOR });
+  const generar = (mes: string) => gestor("POST", "/api/facturas", { mes });
+  const reloj = (ahora: string) => otra.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  const reservar = async (socioId: string, pistaId: string, inicio: string) => {
+    const r = await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+    assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+    return r.cuerpo.reserva.id as string;
+  };
+  try {
+    // Noviembre: Marta cancela fuera de plazo (penalización) y socio-003 cancela gratis.
+    const forzada = await otra.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 1200);
+    const gratis = await reservar("socio-003", "pista-3", "2026-11-24T12:00");
+    await otra.pedir("POST", `/api/reservas/${gratis}/cancelar`);
+
+    // Diciembre: Nora Benítez juega 1.800 + 1.800 + 2.800 céntimos.
+    const nora = [
+      await reservar("socio-041", "pista-1", "2026-12-01T18:00"),
+      await reservar("socio-041", "pista-1", "2026-12-01T09:00"),
+      await reservar("socio-041", "pista-1", "2026-12-01T10:30"),
+    ];
+    await reservar("socio-003", "pista-2", "2026-12-02T09:00");
+
+    await reloj("2026-12-05T10:00");
+    const noviembre = (await generar("2026-11")).cuerpo.facturas;
+    const marta = noviembre.find((f: any) => f.socioId === "socio-002");
+    const penalizacion = marta.lineas.find((l: any) => l.reservaId === "R-0520");
+    assert.deepEqual(penalizacion, { reservaId: "R-0520", concepto: "Penalización", importe: 1200 });
+    const lineasNoviembre = noviembre.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId));
+    assert.ok(!lineasNoviembre.includes(gratis), "la cancelación sin penalización no se factura");
+    const ultimoNoviembre = noviembre.length;
+    assert.equal(noviembre.at(-1).numero, `F2026-${String(ultimoNoviembre).padStart(4, "0")}`);
+
+    // Diciembre generado en enero de 2027: sigue la serie de 2026.
+    await reloj("2027-01-10T10:00");
+    const diciembre = await generar("2026-12");
+    assert.equal(diciembre.status, 201);
