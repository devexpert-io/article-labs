@@ -0,0 +1,212 @@
+// Facturas mensuales (docs/specs/facturas.md) y las reglas de facturación de la gestoría.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function generar(api: Api, mes: string) {
+  return api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+}
+
+async function reservar(api: Api, socioId: string, pistaId: string, inicio: string): Promise<string> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva.id;
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+test("permisos: solo un gestor genera y consulta facturas", async () => {
+  const api = await arrancarApi();
+  try {
+    for (const [metodo, ruta, cuerpo] of [
+      ["POST", "/api/facturas", { mes: "2026-10" }],
+      ["GET", "/api/facturas?mes=2026-10", undefined],
+      ["GET", "/api/facturas/F2026-0001", undefined],
+    ] as const) {
+      const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+      assert.equal(anonimo.status, 401);
+      assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+      const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-004" });
+      assert.equal(socio.status, 403);
+      assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+    }
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    assert.equal(estado.facturas.length, 0, "sin permiso no se genera nada");
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("mes: formato AAAA-MM y solo meses cerrados", async () => {
+  const api = await arrancarApi();
+  try {
+    for (const mes of ["2026-13", "2026-1", "octubre", 202610, undefined]) {
+      const r = await generar(api, mes as string);
+      assert.equal(r.status, 400, String(mes));
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-1", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+    for (const mes of ["2026-11", "2026-12"]) {
+      const abierto = await generar(api, mes);
+      assert.equal(abierto.status, 409);
+      assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+    }
+    await reloj(api, "2026-12-01T00:00");
+    assert.equal((await generar(api, "2026-11")).status, 201, "a las 00:00 del día 1 el mes anterior ya está cerrado");
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("octubre de 2026: una factura por socio, líneas, totales y numeración", async () => {
+  const api = await arrancarApi();
+  try {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const deOctubre = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+    const facturables = deOctubre.filter((r: any) => r.estado !== "cancelada" || r.penalizacion > 0);
+
+    const r = await generar(api, "2026-10");
+    assert.equal(r.status, 201);
+    const facturas = r.cuerpo.facturas;
+    const socios = [...new Set(facturables.map((x: any) => x.socioId))].sort();
+    assert.deepEqual(facturas.map((f: any) => f.socioId), socios, "una por socio con algo que facturar, por id de socio");
+    assert.deepEqual(facturas.map((f: any) => f.numero), facturas.map((_: unknown, i: number) => `F2026-${String(i + 1).padStart(4, "0")}`));
+
+    for (const f of facturas) {
+      assert.equal(f.mes, "2026-10");
+      const suyas = facturables.filter((x: any) => x.socioId === f.socioId).sort((a: any, b: any) => a.inicio.localeCompare(b.inicio));
+      assert.deepEqual(f.lineas, suyas.map((x: any) => ({ reservaId: x.id, concepto: "Reserva", importe: x.importe })));
+      assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+      assert.equal(f.base, Math.round((f.total * 100) / 121));
+      assert.equal(f.base + f.iva, f.total);
+    }
+    // Las no presentadas se facturan; las canceladas sin penalización, no.
+    const lineas = new Set(facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId)));
+    const noPresentada = deOctubre.find((x: any) => x.estado === "no_presentada");
+    const cancelada = deOctubre.find((x: any) => x.estado === "cancelada");
+    assert.ok(lineas.has(noPresentada.id));
+    assert.ok(!lineas.has(cancelada.id));
+
+    const consultadas = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.equal(consultadas.status, 200);
+    assert.deepEqual(consultadas.cuerpo.facturas, facturas);
+    const una = await api.pedir("GET", `/api/facturas/${facturas[2].numero}`, { socio: GESTOR });
+    assert.deepEqual(una.cuerpo.factura, facturas[2]);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("generar dos veces devuelve las mismas facturas sin gastar números", async () => {
+  const api = await arrancarApi();
+  try {
+    const primera = await generar(api, "2026-10");
+    const segunda = await generar(api, "2026-10");
+    assert.equal(primera.status, 201);
+    assert.equal(segunda.status, 200);
+    assert.deepEqual(segunda.cuerpo.facturas, primera.cuerpo.facturas);
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    assert.equal(estado.facturas.length, primera.cuerpo.facturas.length);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("consultar: un mes sin generar da lista vacía y un número que no existe, 404", async () => {
+  const api = await arrancarApi();
+  try {
+    const vacio = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.equal(vacio.status, 200);
+    assert.deepEqual(vacio.cuerpo, { facturas: [] });
+    const noExiste = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: GESTOR });
+    assert.equal(noExiste.status, 404);
+    assert.equal(noExiste.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("IVA sobre el total, penalizaciones y numeración entre meses y años", async () => {
+  const api = await arrancarApi();
+  try {
+    // Nora (socio-041) juega en diciembre: 1.800 + 1.800 + 2.800 = 6.400 céntimos.
+    const nora = [
+      await reservar(api, "socio-041", "pista-1", "2026-12-01T18:00"),
+      await reservar(api, "socio-041", "pista-1", "2026-12-01T09:00"),
+      await reservar(api, "socio-041", "pista-1", "2026-12-01T10:30"),
+    ];
+    // socio-006: una cancelación con penalización, otra gratuita y una reserva normal.
+    const conPenalizacion = await reservar(api, "socio-006", "pista-3", "2026-12-02T09:00");
+    const normal = await reservar(api, "socio-006", "pista-3", "2026-12-02T10:30");
+    const gratis = await reservar(api, "socio-006", "pista-2", "2026-12-03T09:00");
+    assert.equal((await api.pedir("POST", `/api/reservas/${gratis}/cancelar`)).cuerpo.reserva.penalizacion, undefined);
+    await reloj(api, "2026-12-01T12:00");
+    const forzada = await api.pedir("POST", `/api/reservas/${conPenalizacion}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 1200);
+    const deEnero = await reservar(api, "socio-006", "pista-1", "2027-01-04T09:00");
+
+    // Diciembre de 2026 generado en enero de 2027, después de octubre y de un mes sin facturas.
+    await reloj(api, "2027-01-05T10:00");
+    const octubre = (await generar(api, "2026-10")).cuerpo.facturas;
+    const n = octubre.length;
+    const septiembre = await generar(api, "2026-09");
+    assert.equal(septiembre.status, 201);
+    assert.deepEqual(septiembre.cuerpo.facturas, [], "un mes sin nada que facturar no lleva facturas");
+    const diciembre = (await generar(api, "2026-12")).cuerpo.facturas;
+    const numero = (i: number, anio = "2026") => `F${anio}-${String(i).padStart(4, "0")}`;
+    assert.deepEqual(diciembre.map((f: any) => [f.numero, f.socioId]), [[numero(n + 1), "socio-006"], [numero(n + 2), "socio-041"]]);
+
+    const [delSocio6, deNora] = diciembre;
+    assert.deepEqual(deNora.lineas, [
