@@ -0,0 +1,171 @@
+// Facturas mensuales para la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const generar = (mes: unknown, socio = GESTOR) => api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio });
+const reloj = async (ahora: string) => assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+const reservar = async (socioId: string, pistaId: string, inicio: string) => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+};
+
+test("solo un gestor genera y consulta facturas", async () => {
+  for (const [metodo, ruta] of [["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F2026-0001"]] as const) {
+    const sin = await api.pedir(metodo, ruta, { cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+    assert.equal(sin.status, 401);
+    assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined, socio: "socio-001" });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  // Nada de lo anterior ha generado facturas.
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.facturas, []);
+});
+
+test("el mes tiene que tener formato AAAA-MM y estar cerrado", async () => {
+  for (const mes of [undefined, "2026-13", "2026-1", "octubre", 202610]) {
+    const r = await generar(mes);
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026/10", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12"]) {
+    const r = await generar(mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+});
+
+test("octubre de 2026: una factura por socio, con sus líneas, IVA y números", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const octubre = estado.reservas
+    .filter((r: any) => r.inicio.startsWith("2026-10"))
+    .sort((a: any, b: any) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+  const esperadas = new Map<string, any[]>();
+  for (const r of octubre) {
+    if (r.estado === "cancelada" && !(r.penalizacion > 0)) continue;
+    const linea = r.estado === "cancelada"
+      ? { reservaId: r.id, concepto: "Penalización", importe: r.penalizacion }
+      : { reservaId: r.id, concepto: "Reserva", importe: r.importe };
+    esperadas.set(r.socioId, [...(esperadas.get(r.socioId) ?? []), linea]);
+  }
+  const socios = [...esperadas.keys()].sort();
+  assert.ok(octubre.some((r: any) => r.estado === "no_presentada"), "octubre tiene reservas no presentadas");
+  assert.ok(octubre.some((r: any) => r.estado === "cancelada"), "octubre tiene cancelaciones");
+
+  const r = await generar("2026-10");
+  assert.equal(r.status, 201);
+  const facturas = r.cuerpo.facturas;
+  assert.deepEqual(facturas.map((f: any) => f.socioId), socios);
+  facturas.forEach((f: any, i: number) => {
+    assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.mes, "2026-10");
+    assert.deepEqual(f.lineas, esperadas.get(f.socioId));
+    const total = f.lineas.reduce((s: number, l: any) => s + l.importe, 0);
+    assert.equal(f.total, total);
+    assert.equal(f.base, Math.round((total * 100) / 121));
+    assert.equal(f.iva, total - f.base);
+  });
+  // Las canceladas sin penalización no entran en ninguna factura.
+  const facturadas = new Set(facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId)));
+  for (const c of octubre.filter((x: any) => x.estado === "cancelada")) assert.ok(!facturadas.has(c.id));
+
+  // Generar otra vez: las mismas facturas, con 200, sin crear nuevas.
+  const otra = await generar("2026-10");
+  assert.equal(otra.status, 200);
+  assert.deepEqual(otra.cuerpo.facturas, facturas);
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, facturas.length);
+
+  // Consultar.
+  const listado = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(listado.status, 200);
+  assert.deepEqual(listado.cuerpo.facturas, facturas);
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR })).cuerpo, { facturas: [] });
+  const una = await api.pedir("GET", `/api/facturas/${facturas[2].numero}`, { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo.factura, facturas[2]);
+  const no = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+  assert.equal(no.status, 404);
+  assert.equal(no.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("diciembre generado en enero: IVA sobre el total, penalizaciones y numeración entre meses y años", async () => {
+  const octubre = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas;
+  const ultimoOctubre = Number(octubre.at(-1).numero.slice(6));
+
+  // Diciembre: Nora Benítez (socio-041) reserva 1.800 + 1.800 + 2.800 céntimos.
+  await reloj("2026-11-25T10:00");
+  const nora = [
+    await reservar("socio-041", "pista-1", "2026-12-01T09:00"),
+    await reservar("socio-041", "pista-1", "2026-12-02T09:00"),
+    await reservar("socio-041", "pista-1", "2026-12-02T18:00"),
+  ];
+  assert.deepEqual(nora.map((r) => r.importe), [1800, 1800, 2800]);
+  // socio-003 cancelará fuera de plazo (con penalización) y socio-006 a tiempo (sin penalización).
+  const conPenalizacion = await reservar("socio-003", "pista-3", "2026-12-03T09:00");
+  const gratis = await reservar("socio-006", "pista-2", "2026-12-10T09:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`)).cuerpo.reserva.penalizacion, undefined);
+  // Enero de 2027: socio-007 juega el día 4.
+  const enero = await reservar("socio-007", "pista-1", "2027-01-04T09:00");
+  await reloj("2026-12-02T20:00");
+  const cancelada = await api.pedir("POST", `/api/reservas/${conPenalizacion.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1200);
+
+  // Un mes sin nada que facturar no gasta números.
+  await reloj("2027-01-05T10:00");
+  const septiembre = await generar("2026-09");
+  assert.equal(septiembre.status, 201);
+  assert.deepEqual(septiembre.cuerpo.facturas, []);
+  assert.equal((await generar("2026-09")).status, 200);
+
+  // Diciembre se genera en enero, antes que noviembre: sigue la serie de 2026 tras octubre.
+  const diciembre = await generar("2026-12");
+  assert.equal(diciembre.status, 201);
+  assert.deepEqual(diciembre.cuerpo.facturas, [
+    {
+      numero: `F2026-${String(ultimoOctubre + 1).padStart(4, "0")}`,
+      mes: "2026-12",
+      socioId: "socio-003",
+      lineas: [{ reservaId: conPenalizacion.id, concepto: "Penalización", importe: 1200 }],
+      total: 1200,
+      base: 992,
+      iva: 208,
+    },
+    {
+      numero: `F2026-${String(ultimoOctubre + 2).padStart(4, "0")}`,
+      mes: "2026-12",
+      socioId: "socio-041",
+      lineas: nora.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })),
+      total: 6400,
+      base: 5289,
+      iva: 1111,
+    },
+  ]);
+
