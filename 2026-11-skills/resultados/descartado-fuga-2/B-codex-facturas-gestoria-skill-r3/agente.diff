+        const total = lineas.reduce((suma, l) => suma + l.importe, 0);
+        const base = Math.round(total * 100 / 121);
+        numero += 1;
+        return { numero: `F${anio}-${String(numero).padStart(4, "0")}`, mes, socioId, lineas, total, base, iva: total - base };
+      });
+      estado.facturasPorMes[mes] = facturas;
+      return { facturas, nuevas: true };
