+++ b/test/facturas.test.ts
@@ -0,0 +1,148 @@
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado, Factura } from "../src/tipos.ts";
+
+let api: Api;
+const gestor = "socio-040";
+beforeEach(async () => { api = await arrancarApi(); });
+afterEach(() => api.cerrar());
+
+async function reloj(ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+async function generar(mes: string, status = 201): Promise<Factura[]> {
+  const respuesta = await api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+  assert.equal(respuesta.status, status, respuesta.texto);
+  return respuesta.cuerpo.facturas;
+}
+async function reservar(socioId: string, inicio: string) {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-1", inicio } });
+  assert.equal(respuesta.status, 201, respuesta.texto);
+  return respuesta.cuerpo.reserva.id as string;
+}
+
+test("solo el gestor puede generar, listar y consultar facturas", async () => {
+  for (const [metodo, ruta] of [
+    ["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F2026-0001"],
+  ]) {
+    for (const socio of [undefined, "socio-999", "socio-001"]) {
+      const r = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      assert.equal(r.status, socio === "socio-001" ? 403 : 401);
+      assert.equal(r.cuerpo.error.codigo, socio === "socio-001" ? "SIN_PERMISO" : "NO_IDENTIFICADO");
+    }
+  }
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.facturasPorMes, {});
+});
+
+test("valida el mes y solo genera meses cerrados según el reloj del club", async () => {
+  for (const mes of [undefined, null, 202610, "", "26-10", "2026-1", "2026-00", "2026-13", "2026-10-01", "2026-10\n"]) {
+    const post = await api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+    assert.equal(post.status, 400);
+    assert.equal(post.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const get = await api.pedir("GET", `/api/facturas${mes === undefined ? "" : `?mes=${encodeURIComponent(String(mes))}`}`, { socio: gestor });
+    assert.equal(get.status, 400);
+    assert.equal(get.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj("2026-11-30T23:59");
+  assert.equal((await api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes: "2026-11" } })).status, 409);
+  await reloj("2026-12-01T00:00");
+  assert.ok((await generar("2026-11")).length > 0);
+});
+
+test("octubre genera una factura por socio con líneas ordenadas, incluidas las no presentadas", async () => {
+  const antes: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const facturables = antes.reservas.filter((r) => r.inicio.startsWith("2026-10-") && r.estado !== "cancelada");
+  assert.ok(facturables.some((r) => r.estado === "no_presentada"));
+  assert.ok(antes.reservas.some((r) => r.inicio.startsWith("2026-10-") && r.estado === "cancelada"));
+  const socios = [...new Set(facturables.map((r) => r.socioId))].sort();
+  const facturas = await generar("2026-10");
+  assert.deepEqual(facturas.map((f) => f.socioId), socios);
+  assert.ok(!facturas.some((f) => f.socioId === "socio-041"));
+  for (const [i, factura] of facturas.entries()) {
+    const reservas = facturables.filter((r) => r.socioId === factura.socioId).sort((a, b) => a.inicio.localeCompare(b.inicio));
+    const total = reservas.reduce((suma, r) => suma + r.importe, 0);
+    assert.deepEqual(factura, {
+      numero: `F2026-${String(i + 1).padStart(4, "0")}`, mes: "2026-10", socioId: socios[i],
+      lineas: reservas.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })),
+      total, base: Math.round(total * 100 / 121), iva: total - Math.round(total * 100 / 121),
+    });
+  }
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, antes.reservas);
+  assert.equal((await api.pedir("POST", `/api/reservas/${facturables[0]!.id}/cancelar`)).cuerpo.error.codigo, "RESERVA_PASADA");
+});
+
+test("calcula el IVA sobre 6400 y factura las penalizaciones por el mes de inicio", async () => {
+  await reloj("2026-11-30T10:00");
+  const punta = await reservar("socio-041", "2026-12-03T18:00");
+  const valle1 = await reservar("socio-041", "2026-12-01T09:00");
+  const valle2 = await reservar("socio-041", "2026-12-02T09:00");
+  const gratis = await reservar("socio-002", "2026-12-04T09:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratis}/cancelar`)).status, 200);
+  const penalizada = await reservar("socio-002", "2026-12-01T10:30");
+  // La cancelación ocurre en noviembre; se factura en diciembre, cuando empieza la reserva.
+  await reloj("2026-11-30T12:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${penalizada}/cancelar`, { cuerpo: { forzar: true } })).status, 200);
+  await reloj("2027-01-01T00:00");
+  const facturas = await generar("2026-12");
+  assert.deepEqual(facturas, [
+    { numero: "F2026-0001", mes: "2026-12", socioId: "socio-002", lineas: [{ reservaId: penalizada, concepto: "Penalización", importe: 1800 }], total: 1800, base: 1488, iva: 312 },
+    { numero: "F2026-0002", mes: "2026-12", socioId: "socio-041", lineas: [
+      { reservaId: valle1, concepto: "Reserva", importe: 1800 },
+      { reservaId: valle2, concepto: "Reserva", importe: 1800 },
+      { reservaId: punta, concepto: "Reserva", importe: 2800 },
+    ], total: 6400, base: 5289, iva: 1111 },
+  ]);
+  assert.ok(!(await generar("2026-11")).flatMap((f) => f.lineas).some((l) => l.reservaId === penalizada));
+});
+
+test("la serie continúa entre meses fuera de orden, omite meses vacíos y reinicia cada año", async () => {
+  await reloj("2026-12-01T00:00");
+  await reservar("socio-041", "2026-12-01T09:00");
+  await reservar("socio-002", "2026-12-02T09:00");
+  await reloj("2027-01-01T00:00");
+  assert.deepEqual(await generar("2026-09"), []);
+  assert.deepEqual(await generar("2026-09", 200), []);
+  const diciembre = await generar("2026-12");
+  assert.deepEqual(diciembre.map((f) => f.numero), ["F2026-0001", "F2026-0002"]);
+  const noviembre = await generar("2026-11");
+  assert.equal(noviembre[0]!.numero, "F2026-0003");
+  assert.deepEqual(await generar("2026-12", 200), diciembre);
+  const octubre = await generar("2026-10");
+  assert.equal(octubre[0]!.numero, `F2026-${String(noviembre.length + 3).padStart(4, "0")}`);
+  const numeros = [...diciembre, ...noviembre, ...octubre].map((f) => f.numero);
+  assert.equal(new Set(numeros).size, numeros.length);
+  assert.equal(numeros.at(-1), `F2026-${String(numeros.length).padStart(4, "0")}`);
+  await reservar("socio-041", "2027-01-31T21:00");
+  await reloj("2027-02-01T00:00");
+  assert.equal((await generar("2027-01"))[0]!.numero, "F2027-0001");
+});
+
+test("consulta meses y facturas, conserva resultados y no duplica generaciones simultáneas", async () => {
+  for (const mes of ["2026-10", "2027-01"]) {
+    const r = await api.pedir("GET", `/api/facturas?mes=${mes}`, { socio: gestor });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, { facturas: [] });
+  }
+  const respuestas = await Promise.all([1, 2].map(() => api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes: "2026-10" } })));
+  assert.deepEqual(respuestas.map((r) => r.status).sort(), [200, 201]);
+  assert.deepEqual(respuestas[0]!.cuerpo, respuestas[1]!.cuerpo);
+  const facturas: Factura[] = respuestas[0]!.cuerpo.facturas;
+  assert.deepEqual(await generar("2026-10", 200), facturas);
+  const lista = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor });
+  assert.equal(lista.status, 200);
+  assert.deepEqual(lista.cuerpo, { facturas });
+  for (const factura of facturas) {
+    const r = await api.pedir("GET", `/api/facturas/${factura.numero}`, { socio: gestor });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, { factura });
+  }
+  const inexistente = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: gestor });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
