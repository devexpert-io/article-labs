+test("C7 · el informe de caja es para gestores y resume el mes por pista", async () => {
+  const sinSocio = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
+  assert.equal(sinSocio.status, 401);
+  assert.equal(sinSocio.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const noGestor = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-001" });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const mal = await api.pedir("GET", "/api/informes/caja?mes=2026-1", { socio: GESTOR });
+  assert.equal(mal.status, 400);
+  assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const mes = "2026-11";
+  const pistas = estado.pistas
+    .map((p: { id: string }) => {
+      const delMes = estado.reservas.filter((r: { pistaId: string; inicio: string }) => r.pistaId === p.id && r.inicio.slice(0, 7) === mes);
+      const confirmadas = delMes.filter((r: { estado: string }) => r.estado === "confirmada" || r.estado === "no_presentada");
+      const canceladas = delMes.filter((r: { estado: string }) => r.estado === "cancelada");
+      const reservas = confirmadas.length;
+      const ingresos = confirmadas.reduce((s: number, r: { importe: number }) => s + r.importe, 0);
+      const penalizaciones = canceladas.reduce((s: number, r: { penalizacion?: number }) => s + (r.penalizacion ?? 0), 0);
+      return { pistaId: p.id, reservas, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    })
+    .sort((a: { pistaId: string }, b: { pistaId: string }) => a.pistaId.localeCompare(b.pistaId));
+  const total = {
+    reservas: pistas.reduce((s: number, p: { reservas: number }) => s + p.reservas, 0),
+    ingresos: pistas.reduce((s: number, p: { ingresos: number }) => s + p.ingresos, 0),
+    penalizaciones: pistas.reduce((s: number, p: { penalizaciones: number }) => s + p.penalizaciones, 0),
+  };
+
+  const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR });
+  assert.equal(informe.status, 200);
+  assert.deepEqual(informe.cuerpo, { mes, pistas, total: { ...total, total: total.ingresos + total.penalizaciones } });
+
+  // Un mes sin movimientos también incluye todas las pistas, a cero.
+  const diciembre = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: GESTOR });
+  assert.equal(diciembre.status, 200);
+  assert.deepEqual(diciembre.cuerpo.pistas.map((p: { pistaId: string }) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+  for (const p of diciembre.cuerpo.pistas) {
+    assert.deepEqual(p, { pistaId: p.pistaId, reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+  }
+  assert.deepEqual(diciembre.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+});
+
