+// Las horas entre dos instantes locales del club se cuentan de verdad en Madrid
+// (Europe/Madrid), con su cambio de hora: un salto de reloj de una hora cambia la cuenta.
+const ZONA = "Europe/Madrid";
+const formatoZona = new Intl.DateTimeFormat("en-US", {
+  timeZone: ZONA,
+  timeZoneName: "longOffset",
+  hour12: false,
+  year: "numeric",
+  month: "2-digit",
+  day: "2-digit",
+  hour: "2-digit",
+  minute: "2-digit",
+  second: "2-digit",
+});
+
+function desplazamientoEnMs(instante: number): number {
+  const partes = formatoZona.formatToParts(new Date(instante));
+  const nombre = partes.find((p) => p.type === "timeZoneName")!.value; // "GMT+01:00"
+  const signo = nombre.startsWith("GMT-") ? -1 : 1;
+  const [hh, mm] = nombre.slice(4).split(":").map(Number);
+  return signo * (hh! * 3_600_000 + mm! * 60_000);
+}
+
+/** Convierte una hora local del club (AAAA-MM-DDTHH:MM) a un instante real en ms. */
+function aInstante(local: string): number {
+  const [fecha, hora] = local.split("T");
+  const [a, m, d] = fecha!.split("-").map(Number);
+  const [hh, mm] = hora!.split(":").map(Number);
+  const comoUtc = Date.UTC(a!, m! - 1, d!, hh!, mm!, 0);
+  let instante = comoUtc;
+  for (let i = 0; i < 4; i++) {
+    const candidato = comoUtc - desplazamientoEnMs(instante);
+    if (candidato === instante) break;
+    instante = candidato;
+  }
+  return instante;
+}
+
 function horasEntre(desde: string, hasta: string): number {
-  return (Date.parse(`${hasta}:00Z`) - Date.parse(`${desde}:00Z`)) / 3_600_000;
+  return (aInstante(hasta) - aInstante(desde)) / 3_600_000;
 }
 
