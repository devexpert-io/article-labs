+/** Pone el reloj más allá de la semilla, para empezar con las pistas libres y sin reservas futuras. */
+async function reloj(ahora: string): Promise<void> {
+  const respuesta = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(respuesta.status, 200);
+}
+
+test("C1 · los tramos de antelación fijan la penalización", async () => {
+  await reloj("2026-11-25T12:00");
+  const lejos = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-001", pistaId: "pista-1", inicio: "2026-11-27T15:00" } });
+  const media = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-001", pistaId: "pista-1", inicio: "2026-11-26T15:00" } });
+  const cerca = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-001", pistaId: "pista-1", inicio: "2026-11-25T21:00" } });
+
+  // 48 horas o más: sin penalización.
+  const sinPenalizacion = await api.pedir("POST", `/api/reservas/${lejos.cuerpo.reserva.id}/cancelar`);
+  assert.equal(sinPenalizacion.status, 200);
+  assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(sinPenalizacion.cuerpo.reembolso, 1800);
+
+  // 24 horas o más, y menos de 48: 25 % del importe.
+  const parcial = await api.pedir("POST", `/api/reservas/${media.cuerpo.reserva.id}/cancelar`);
+  assert.equal(parcial.cuerpo.reserva.penalizacion, 450);
+  assert.equal(parcial.cuerpo.reembolso, 1350);
