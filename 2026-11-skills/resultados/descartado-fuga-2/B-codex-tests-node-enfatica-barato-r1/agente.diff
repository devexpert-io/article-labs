+function instanteMadrid(fechaHora: string): number {
+  const pared = Date.parse(`${fechaHora}:00Z`);
+  const formato = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/Madrid", timeZoneName: "longOffset", hour: "2-digit" });
+  const offset = formato.formatToParts(new Date(pared)).find((p) => p.type === "timeZoneName")?.value ?? "GMT+01:00";
+  const [, signo, hh, mm] = /GMT([+-])(\d{2}):(\d{2})/.exec(offset)!;
+  return pared - (signo === "+" ? 1 : -1) * (Number(hh) * 60 + Number(mm)) * 60_000;
+}
