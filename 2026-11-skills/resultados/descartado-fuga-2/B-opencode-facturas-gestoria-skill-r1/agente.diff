+// La facturación mensual para la gestoría, probada por la API y por el núcleo.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { crearClub } from "../src/nucleo.ts";
+import type { Estado, EstadoReserva, Reserva, Socio } from "../src/tipos.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// --- Ayudas para montar estados a medida (tests unitarios del núcleo) ---
+
+function reserva(r: {
+  id: string;
+  socioId: string;
+  inicio: string;
+  importe: number;
+  estado?: EstadoReserva;
+  penalizacion?: number;
+}): Reserva {
+  return {
+    id: r.id,
+    socioId: r.socioId,
+    pistaId: "pista-1",
+    inicio: r.inicio,
+    fin: "2099-01-01T00:00",
+    estado: r.estado ?? "confirmada",
+    importe: r.importe,
+    notas: "",
+    ...(r.penalizacion !== undefined ? { penalizacion: r.penalizacion } : {}),
+  };
+}
+
+const sociosDePrueba: Socio[] = [
+  { id: "socio-001", nombre: "Ana García", email: "ana@example.com", cuotaActiva: true, rol: "socio" },
+  { id: "socio-002", nombre: "Marta López", email: "marta@example.com", cuotaActiva: true, rol: "socio" },
+];
+
+function estadoCon(reservas: Reserva[], ahora = "2026-11-18T10:00", socios: Socio[] = sociosDePrueba): Estado {
+  return { ahora, pistas: [], socios, reservas, registro: [], contador: reservas.length, facturas: [] };
+}
+
+// --- Tests unitarios del cálculo y la numeración ---
+
+test("el IVA se calcula sobre el total: 6.400 céntimos dan base 5.289 e IVA 1.111", () => {
+  const club = crearClub(estadoCon([
+    reserva({ id: "R-1", socioId: "socio-001", inicio: "2026-10-01T09:00", importe: 1800 }),
+    reserva({ id: "R-2", socioId: "socio-001", inicio: "2026-10-01T10:30", importe: 1800 }),
+    reserva({ id: "R-3", socioId: "socio-001", inicio: "2026-10-01T18:00", importe: 2800 }),
+  ]));
+  const { facturas } = club.generarFacturas("2026-10");
+  assert.equal(facturas.length, 1);
+  assert.equal(facturas[0]!.total, 6400);
+  assert.equal(facturas[0]!.base, 5289);
+  assert.equal(facturas[0]!.iva, 1111);
+});
+
+test("una cancelación con penalización entra como 'Penalización' y sin penalización no entra", () => {
+  const club = crearClub(estadoCon([
+    reserva({ id: "R-1", socioId: "socio-001", inicio: "2026-10-01T09:00", estado: "cancelada", importe: 1800, penalizacion: 500 }),
+    reserva({ id: "R-2", socioId: "socio-001", inicio: "2026-10-01T10:30", estado: "cancelada", importe: 1800 }),
+    reserva({ id: "R-3", socioId: "socio-001", inicio: "2026-10-01T12:00", importe: 1200 }),
+  ]));
+  const { facturas } = club.generarFacturas("2026-10");
+  assert.equal(facturas.length, 1);
+  assert.deepEqual(facturas[0]!.lineas, [
+    { reservaId: "R-1", concepto: "Penalización", importe: 500 },
+    { reservaId: "R-3", concepto: "Reserva", importe: 1200 },
+  ]);
+});
+
+test("numeración: una serie por año, por orden de socio, y un mes sin facturas no gasta números", () => {
+  const club = crearClub(estadoCon([
+    reserva({ id: "R-dic-1", socioId: "socio-001", inicio: "2026-12-01T09:00", importe: 1000 }),
+    reserva({ id: "R-dic-2", socioId: "socio-002", inicio: "2026-12-02T09:00", importe: 1000 }),
+    reserva({ id: "R-ene-1", socioId: "socio-001", inicio: "2027-01-05T09:00", importe: 1000 }),
+    reserva({ id: "R-feb-1", socioId: "socio-002", inicio: "2027-02-05T09:00", importe: 1000 }),
+  ], "2027-03-10T10:00"));
+  assert.deepEqual(club.generarFacturas("2026-11").facturas, [], "noviembre no tiene facturas ni gasta números");
+  const diciembre = club.generarFacturas("2026-12").facturas;
+  assert.deepEqual(diciembre.map((f) => f.numero), ["F2026-0001", "F2026-0002"]);
+  const enero = club.generarFacturas("2027-01").facturas;
+  assert.deepEqual(enero.map((f) => f.numero), ["F2027-0001"]);
+  const febrero = club.generarFacturas("2027-02").facturas;
+  assert.deepEqual(febrero.map((f) => f.numero), ["F2027-0002"]);
+});
+
+test("numeración fuera de orden: el mes generado después sigue la serie del año", () => {
+  const club = crearClub(estadoCon([
+    reserva({ id: "R-feb", socioId: "socio-001", inicio: "2027-02-01T09:00", importe: 1000 }),
+    reserva({ id: "R-ene", socioId: "socio-001", inicio: "2027-01-01T09:00", importe: 1000 }),
+  ], "2027-04-10T10:00"));
+  const febrero = club.generarFacturas("2027-02").facturas;
+  assert.equal(febrero[0]!.numero, "F2027-0001");
+  const enero = club.generarFacturas("2027-01").facturas;
+  assert.equal(enero[0]!.numero, "F2027-0002");
+});
+
+// --- Tests de la API ---
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+async function generarOctubre() {
+  return api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-040" });
+}
+
+test("solo un gestor genera y consulta facturas", async () => {
+  const sinCabecera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+  assert.equal(sinCabecera.status, 401);
+  assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10")).status, 401);
+  assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001")).status, 401);
+
+  const noGestor = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" })).status, 403);
+  assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001", { socio: "socio-001" })).status, 403);
+});
+
+test("el mes debe tener formato AAAA-MM y estar cerrado", async () => {
+  const malFormato = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026" }, socio: "socio-040" });
+  assert.equal(malFormato.status, 400);
+  assert.equal(malFormato.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const actual = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: "socio-040" });
+  assert.equal(actual.status, 409);
+  assert.equal(actual.cuerpo.error.codigo, "MES_ABIERTO");
+
+  const futuro = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: "socio-040" });
+  assert.equal(futuro.status, 409);
+  assert.equal(futuro.cuerpo.error.codigo, "MES_ABIERTO");
+});
+
+test("una factura por socio, ordenadas por id de socio, con las líneas por inicio", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const reservasOctubre = estado.reservas
+    .filter((r: { inicio: string }) => r.inicio.startsWith("2026-10-"))
+    .sort((a: { inicio: string; id: string }, b: { inicio: string; id: string }) =>
+      (a.inicio === b.inicio ? a.id.localeCompare(b.id) : a.inicio.localeCompare(b.inicio)));
+  const lineasPorSocio = new Map<string, Array<{ reservaId: string; concepto: string; importe: number }>>();
+  for (const r of reservasOctubre) {
+    const lineas: Array<{ reservaId: string; concepto: string; importe: number }> = [];
+    if (r.estado === "confirmada" || r.estado === "no_presentada") {
+      lineas.push({ reservaId: r.id, concepto: "Reserva", importe: r.importe });
+    } else if (r.estado === "cancelada" && r.penalizacion > 0) {
+      lineas.push({ reservaId: r.id, concepto: "Penalización", importe: r.penalizacion });
+    }
+    for (const linea of lineas) {
+      if (!lineasPorSocio.has(r.socioId)) lineasPorSocio.set(r.socioId, []);
+      lineasPorSocio.get(r.socioId)!.push(linea);
+    }
+  }
+  const sociosEsperados = [...lineasPorSocio.keys()].sort();
+
+  const respuesta = await generarOctubre();
+  assert.equal(respuesta.status, 201);
+  const { facturas } = respuesta.cuerpo;
+  assert.deepEqual(facturas.map((f: { socioId: string }) => f.socioId), sociosEsperados);
+  for (const factura of facturas) {
+    assert.deepEqual(factura.lineas, lineasPorSocio.get(factura.socioId));
+  }
+  assert.ok(!facturas.some((f: { socioId: string }) => f.socioId === "socio-041"), "Nora, sin reservas, no lleva factura");
+});
+
+test("total, base e IVA cuadran en todas las facturas de octubre", async () => {
+  const { facturas } = (await generarOctubre()).cuerpo;
+  assert.ok(facturas.length > 0);
+  for (const factura of facturas) {
+    const total = factura.lineas.reduce((suma: number, l: { importe: number }) => suma + l.importe, 0);
+    assert.equal(factura.total, total);
+    assert.equal(factura.base, Math.round((total * 100) / 121));
+    assert.equal(factura.iva, total - factura.base);
+    assert.equal(factura.base + factura.iva, total);
+  }
+});
