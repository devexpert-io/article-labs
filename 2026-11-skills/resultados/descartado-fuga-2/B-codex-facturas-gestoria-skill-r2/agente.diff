@@ -0,0 +1,139 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado, Factura } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+const generar = (api: Api, mes: unknown) => api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+const reloj = (api: Api, ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+async function crear(api: Api, inicio: string, socioId = "socio-041") {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-1", inicio } });
+  assert.equal(respuesta.status, 201, respuesta.texto);
+  return respuesta.cuerpo.reserva;
+}
+
+test("facturas: permisos en los tres endpoints", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const [metodo, ruta] of [["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F2026-0001"]]) {
+    for (const socio of [undefined, "socio-999", "socio-001"]) {
+      const r = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      assert.equal(r.status, socio === "socio-001" ? 403 : 401);
+      assert.equal(r.cuerpo.error.codigo, socio === "socio-001" ? "SIN_PERMISO" : "NO_IDENTIFICADO");
+    }
+  }
+});
+
+test("facturas: valida el mes y usa el reloj del club para el cierre", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const mes of [undefined, null, 202610, "", "2026-1", "26-10", "2026-00", "2026-13", "2026-10-01", "2026-10\n"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const ruta of ["/api/facturas", "/api/facturas?mes=2026-13"]) {
+    const r = await api.pedir("GET", ruta, { socio: gestor });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj(api, "2026-11-30T23:59");
+  assert.equal((await generar(api, "2026-11")).status, 409);
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+});
+
+test("facturas: historial de octubre, orden, importes, consultas e idempotencia", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const noGenerado = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor });
+  assert.equal(noGenerado.status, 200);
+  assert.deepEqual(noGenerado.cuerpo, { facturas: [] });
+  const primera = await generar(api, "2026-10");
+  assert.equal(primera.status, 201);
+  const facturas: Factura[] = primera.cuerpo.facturas;
+  const facturables = estado.reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(facturables.some((r) => r.estado === "no_presentada"));
+  assert.deepEqual(facturas.map((f) => f.socioId), [...new Set(facturables.map((r) => r.socioId))].sort());
+  assert.ok(!facturas.some((f) => f.socioId === "socio-041"));
+  for (const [i, f] of facturas.entries()) {
+    assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.mes, "2026-10");
+    const reservas = facturables.filter((r) => r.socioId === f.socioId).sort((a, b) => a.inicio.localeCompare(b.inicio));
+    assert.deepEqual(f.lineas, reservas.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })));
+    assert.equal(f.total, reservas.reduce((total, r) => total + r.importe, 0));
+    assert.equal(f.base, Math.round(f.total * 100 / 121));
+    assert.equal(f.iva, f.total - f.base);
+    const consulta = await api.pedir("GET", `/api/facturas/${f.numero}`, { socio: gestor });
+    assert.equal(consulta.status, 200);
+    assert.deepEqual(consulta.cuerpo, { factura: f });
+  }
+  const repetida = await generar(api, "2026-10");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo, primera.cuerpo);
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).cuerpo, primera.cuerpo);
+  const inexistente = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: gestor });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, estado.reservas);
+});
+
+test("facturas: IVA sobre 6400, penalización y cancelación gratuita", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  // Se crean fuera de orden para comprobar que se ordenan por inicio.
+  const punta = await crear(api, "2026-12-03T18:00");
+  const penalizada = await crear(api, "2026-12-02T09:00");
+  const valle = await crear(api, "2026-12-01T09:00");
+  const gratis = await crear(api, "2026-12-04T09:00", "socio-004");
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`)).status, 200);
+  await reloj(api, "2026-12-01T10:00");
+  const cancelada = await api.pedir("POST", `/api/reservas/${penalizada.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1800);
+  await reloj(api, "2027-01-01T00:00");
+  const r = await generar(api, "2026-12");
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.cuerpo.facturas, [{
+    numero: "F2026-0001", mes: "2026-12", socioId: "socio-041",
+    lineas: [
+      { reservaId: valle.id, concepto: "Reserva", importe: 1800 },
+      { reservaId: penalizada.id, concepto: "Penalización", importe: 1800 },
+      { reservaId: punta.id, concepto: "Reserva", importe: 2800 },
+    ],
+    total: 6400, base: 5289, iva: 1111,
+  }]);
+});
+
+test("facturas: serie anual, meses fuera de orden, meses vacíos y peticiones simultáneas", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  await crear(api, "2026-12-01T09:00");
+  await crear(api, "2027-01-04T09:00");
+  await reloj(api, "2027-02-01T00:00");
+  for (let i = 0; i < 2; i++) {
+    const vacio = await generar(api, "2026-09");
+    assert.equal(vacio.status, i === 0 ? 201 : 200);
+    assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  }
+  const diciembre = await generar(api, "2026-12");
+  assert.equal(diciembre.cuerpo.facturas[0].numero, "F2026-0001");
+  const enero = await generar(api, "2027-01");
+  assert.equal(enero.cuerpo.facturas[0].numero, "F2027-0001");
+  const concurrentes = await Promise.all([generar(api, "2026-10"), generar(api, "2026-10")]);
+  assert.deepEqual(concurrentes.map((r) => r.status).sort(), [200, 201]);
+  assert.deepEqual(concurrentes[0]!.cuerpo, concurrentes[1]!.cuerpo);
+  const octubre: Factura[] = concurrentes[0]!.cuerpo.facturas;
+  assert.equal(octubre[0]!.numero, "F2026-0002");
+  assert.deepEqual((await generar(api, "2026-12")).cuerpo, diciembre.cuerpo);
+  const noviembre = await generar(api, "2026-11");
+  assert.equal(noviembre.cuerpo.facturas[0].numero, `F2026-${String(octubre.length + 2).padStart(4, "0")}`);
+  const todas: Factura[] = [diciembre, concurrentes[0]!, noviembre].flatMap((r) => r.cuerpo.facturas);
+  assert.deepEqual(todas.map((f) => f.numero), todas.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+});
