+// La antelación se mide en horas reales de Madrid, contando los cambios de hora.
+const FORMATEADOR_MADRID = new Intl.DateTimeFormat("en-US", {
+  timeZone: "Europe/Madrid",
+  year: "numeric",
+  month: "2-digit",
+  day: "2-digit",
