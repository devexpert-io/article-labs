+test("C7 · el informe suma reservas, ingresos y penalizaciones por pista y en total", async () => {
+  await conApi(async (api) => {
+    // Primero una penalización real en noviembre para que el informe la cuente.
+    const reserva = await reservaEn(api, "2026-11-23T18:00", "pista-1");
+    await moverReloj(api, "2026-11-23T10:00");
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 1400);
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+    assert.equal(informe.cuerpo.mes, "2026-11");
+
+    const estado = await estadoDe(api);
+    const delMes = estado.reservas.filter((r: any) => r.inicio.slice(0, 7) === "2026-11");
+    const pistas = [...estado.pistas]
+      .sort((a: any, b: any) => a.id.localeCompare(b.id))
+      .map((p: any) => {
+        const dePista = delMes.filter((r: any) => r.pistaId === p.id);
+        const activas = dePista.filter((r: any) => r.estado === "confirmada" || r.estado === "no_presentada");
+        const ingresos = activas.reduce((suma: number, r: any) => suma + r.importe, 0);
+        const penalizaciones = dePista
+          .filter((r: any) => r.estado === "cancelada")
+          .reduce((suma: number, r: any) => suma + (r.penalizacion ?? 0), 0);
+        return { pistaId: p.id, reservas: activas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+      });
+    const total = pistas.reduce(
+      (suma: any, p: any) => ({
+        reservas: suma.reservas + p.reservas,
+        ingresos: suma.ingresos + p.ingresos,
+        penalizaciones: suma.penalizaciones + p.penalizaciones,
+        total: suma.total + p.total,
+      }),
+      { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    );
+    assert.deepEqual(informe.cuerpo.pistas, pistas);
+    assert.deepEqual(informe.cuerpo.total, total);
+    assert.equal(pistas[0].penalizaciones >= 1400, true);
+    assert.equal(total.penalizaciones >= 1400, true);
+  });
+});
