+// Política de cancelación escalonada, exenciones e informe de caja (spec `reembolsos`).
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Cada test levanta su propia API con una semilla nueva y la cierra al terminar.
+async function conApi(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function estadoDe(api: Api): Promise<any> {
+  return (await api.pedir("GET", "/_estado")).cuerpo;
+}
+
+async function moverReloj(api: Api, ahora: string): Promise<void> {
+  const respuesta = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { ahora });
+}
+
+async function reservaEn(api: Api, inicio: string, pistaId: string): Promise<any> {
+  const estado = await estadoDe(api);
+  const encontrada = estado.reservas.find(
+    (r: any) => r.inicio === inicio && r.pistaId === pistaId && r.estado === "confirmada",
+  );
+  assert.equal(Boolean(encontrada), true, `debe existir una reserva confirmada en ${inicio} de ${pistaId}`);
+  return encontrada;
+}
+
+test("C1 · con 48 horas o más no hay penalización", async () => {
+  await conApi(async (api) => {
+    const reserva = await reservaEn(api, "2026-11-23T18:00", "pista-1");
+    await moverReloj(api, "2026-11-21T10:00"); // 56 horas
+    const respuesta = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(respuesta.status, 200);
+    assert.equal(respuesta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(respuesta.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(respuesta.cuerpo.reembolso, 2800);
+  });
+});
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 % del importe", async () => {
+  await conApi(async (api) => {
+    const reserva = await reservaEn(api, "2026-11-23T18:00", "pista-1");
+    await moverReloj(api, "2026-11-22T10:00"); // 32 horas
+    const respuesta = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(respuesta.status, 200);
+    assert.equal(respuesta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(respuesta.cuerpo.reserva.penalizacion, 700);
+    assert.equal(respuesta.cuerpo.reembolso, 2100);
+  });
+});
+
+test("C1 · con menos de 24 horas sin forzar da FUERA_DE_PLAZO y con forzar cobra el 50 %", async () => {
+  await conApi(async (api) => {
+    const reserva = await reservaEn(api, "2026-11-23T18:00", "pista-1");
+    await moverReloj(api, "2026-11-23T10:00"); // 8 horas
+    const sinForzar = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.estado, "cancelada");
