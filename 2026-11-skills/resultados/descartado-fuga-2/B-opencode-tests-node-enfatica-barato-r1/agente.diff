+/** Desfase de Madrid respecto a UTC, en minutos, en un instante dado. */
+function desfaseMadrid(instante: number): number {
+  const partes = FORMATEADOR_MADRID.formatToParts(new Date(instante));
+  const dato = (tipo: string) => Number(partes.find((p) => p.type === tipo)!.value);
+  const comoUtc = Date.UTC(dato("year"), dato("month") - 1, dato("day"), dato("hour"), dato("minute"), dato("second"));
+  return (comoUtc - instante) / 60_000;
+}
+
+/** Instante UTC (ms) de una fecha y hora local de Madrid. */
+function instanteMadrid(local: string): number {
+  const ingenuo = Date.parse(`${local}:00Z`);
+  let instante = ingenuo - desfaseMadrid(ingenuo) * 60_000;
+  instante = ingenuo - desfaseMadrid(instante) * 60_000;
+  return instante;
+}
