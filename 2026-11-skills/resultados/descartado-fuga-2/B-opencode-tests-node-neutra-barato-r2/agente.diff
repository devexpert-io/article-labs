+test("C7 · el informe cuenta las reservas no presentadas y las pistas sin movimientos", async () => {
+  await conApi(async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const esperado = [...estado.pistas]
+      .sort((a: { id: string }, b: { id: string }) => a.id.localeCompare(b.id))
+      .map((p: { id: string }) => {
+        const delMes = estado.reservas.filter((r: any) => r.pistaId === p.id && r.inicio.slice(0, 7) === "2026-10");
+        const activas = delMes.filter((r: any) => r.estado === "confirmada" || r.estado === "no_presentada");
+        const ingresos = activas.reduce((suma: number, r: any) => suma + r.importe, 0);
+        const penalizaciones = delMes
+          .filter((r: any) => r.estado === "cancelada")
+          .reduce((suma: number, r: any) => suma + (r.penalizacion ?? 0), 0);
+        return { pistaId: p.id, reservas: activas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+      });
+
+    assert.ok(estado.reservas.some((r: any) => r.inicio.startsWith("2026-10") && r.estado === "no_presentada"));
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR });
+    assert.equal(informe.status, 200);
+    assert.deepEqual(informe.cuerpo.pistas, esperado);
+  });
+});
+
