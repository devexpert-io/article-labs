+// Penalizaciones escalonadas, exenciones de gestor e informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const MOTIVO = "Cancelación por enfermedad";
+
+async function conApi(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function crear(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.reserva;
+}
+
+async function moverReloj(api: Api, ahora: string): Promise<void> {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200, r.texto);
+}
+
+test("C1 · tramos: 48 horas o más sin penalización, 24-48 al 25 % y menos de 24 solo con forzar al 50 %", async () => {
+  await conApi(async (api) => {
+    const larga = await crear(api, "socio-006", "pista-1", "2027-04-10T12:00");
+    const media = await crear(api, "socio-016", "pista-1", "2027-05-10T12:00");
+    const corta = await crear(api, "socio-020", "pista-1", "2027-06-10T12:00");
+
+    await moverReloj(api, "2027-04-07T12:00"); // 72 horas antes.
+    const sinPenalizacion = await api.pedir("POST", `/api/reservas/${larga.id}/cancelar`);
+    assert.equal(sinPenalizacion.status, 200);
+    assert.equal(sinPenalizacion.cuerpo.reserva.estado, "cancelada");
+    assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(sinPenalizacion.cuerpo.reembolso, larga.importe);
+
+    await moverReloj(api, "2027-05-09T00:00"); // 36 horas antes.
+    const reducida = await api.pedir("POST", `/api/reservas/${media.id}/cancelar`);
+    assert.equal(reducida.status, 200);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, Math.round(media.importe * 0.25));
+    assert.equal(reducida.cuerpo.reembolso, media.importe - Math.round(media.importe * 0.25));
+
+    await moverReloj(api, "2027-06-10T00:00"); // 12 horas antes.
+    const fuera = await api.pedir("POST", `/api/reservas/${corta.id}/cancelar`);
+    assert.equal(fuera.status, 409);
+    assert.equal(fuera.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${corta.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, Math.round(corta.importe * 0.5));
+    assert.equal(forzada.cuerpo.reembolso, corta.importe - Math.round(corta.importe * 0.5));
+  });
+});
+
+test("C2 · límites exactos: 48 horas justas sin penalización y 24 horas justas al 25 % sin forzar", async () => {
+  await conApi(async (api) => {
+    const a48 = await crear(api, "socio-006", "pista-1", "2027-07-10T12:00");
+    const a24 = await crear(api, "socio-016", "pista-1", "2027-07-20T12:00");
+
+    await moverReloj(api, "2027-07-08T12:00"); // Exactamente 48 horas.
+    const limite48 = await api.pedir("POST", `/api/reservas/${a48.id}/cancelar`);
+    assert.equal(limite48.status, 200);
+    assert.equal(limite48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(limite48.cuerpo.reembolso, a48.importe);
+
+    await moverReloj(api, "2027-07-19T12:00"); // Exactamente 24 horas.
+    const limite24 = await api.pedir("POST", `/api/reservas/${a24.id}/cancelar`);
+    assert.equal(limite24.status, 200);
+    assert.equal(limite24.cuerpo.reserva.penalizacion, Math.round(a24.importe * 0.25));
+    assert.equal(limite24.cuerpo.reembolso, a24.importe - Math.round(a24.importe * 0.25));
+  });
+});
+
+test("C3 · cambio de hora: 47,5 horas reales de Madrid llevan al tramo del 25 %", async () => {
+  await conApi(async (api) => {
+    const reserva = await crear(api, "socio-006", "pista-1", "2027-03-28T21:00");
+    await moverReloj(api, "2027-03-26T20:30"); // 47,5 horas después del cambio de hora.
+
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, Math.round(reserva.importe * 0.25));
+    assert.equal(cancelada.cuerpo.reembolso, reserva.importe - Math.round(reserva.importe * 0.25));
+  });
+});
+
+test("C4 · la respuesta de cancelar incluye el reembolso: importe menos penalización", async () => {
+  await conApi(async (api) => {
+    const conPenalizacion = await crear(api, "socio-006", "pista-1", "2027-04-10T12:00");
+    await moverReloj(api, "2027-04-09T12:00"); // 24 horas: 25 %.
+    const cancelada = await api.pedir("POST", `/api/reservas/${conPenalizacion.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reembolso, conPenalizacion.importe - cancelada.cuerpo.reserva.penalizacion);
+
+    const gratuita = await crear(api, "socio-016", "pista-2", "2027-04-20T12:00");
+    const sinPenalizacion = await api.pedir("POST", `/api/reservas/${gratuita.id}/cancelar`);
+    assert.equal(sinPenalizacion.status, 200);
+    assert.equal(sinPenalizacion.cuerpo.reembolso, gratuita.importe);
+  });
+});
+
+test("C5 · un gestor exime con exento y motivo; sin permiso, sin identidad o sin motivo se rechaza", async () => {
+  await conApi(async (api) => {
+    const reserva = await crear(api, "socio-006", "pista-1", "2027-08-10T12:00");
+    await moverReloj(api, "2027-08-10T00:00"); // Menos de 24 horas: haría falta forzar.
+
+    const noGestor = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-003",
+      cuerpo: { exento: true, motivo: MOTIVO },
+    });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const sinIdentidad = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: MOTIVO },
+    });
+    assert.equal(sinIdentidad.status, 401);
+    assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinMotivo = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: GESTOR,
+      cuerpo: { exento: true },
+    });
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const motivoCorto = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: GESTOR,
