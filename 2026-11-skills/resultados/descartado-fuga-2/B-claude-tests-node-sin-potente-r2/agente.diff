+// Penalizaciones escalonadas, exención por un gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-003";
+
+let api: Api;
+let socios: string[] = [];
+let turno = 0;
+before(async () => {
+  api = await arrancarApi();
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  socios = estado.socios.filter((s: any) => s.cuotaActiva && s.rol === "socio").map((s: any) => s.id);
+});
+after(() => api.cerrar());
+
+async function reloj(ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+/** Crea una reserva (en pista 3, 1200 céntimos en valle entre semana) y deja el reloj del club en `ahora`. Va rotando de socio para no topar con el límite de reservas futuras. */
+async function reservar(inicio: string, ahora: string, pistaId = "pista-3") {
+  await reloj("2027-01-01T08:00");
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: socios[turno++ % socios.length], pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  await reloj(ahora);
+  return r.cuerpo.reserva as { id: string; importe: number };
+}
+
+const cancelar = (id: string, cuerpo: unknown = {}, socio?: string) =>
+  api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+
+test("tramos: sin penalización con 48 h o más, 25 % con 24 h o más y 50 % con menos de 24 h y forzar", async () => {
+  // Miércoles 10 de marzo de 2027 a las 12:00, en valle.
+  const holgada = await reservar("2027-03-10T12:00", "2027-03-07T12:00");
+  const sin = await cancelar(holgada.id);
+  assert.equal(sin.status, 200);
+  assert.equal(sin.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(sin.cuerpo.reembolso, 1200);
+
+  const media = await reservar("2027-03-10T12:00", "2027-03-09T00:00");
+  const veinticinco = await cancelar(media.id);
+  assert.equal(veinticinco.status, 200);
+  assert.equal(veinticinco.cuerpo.reserva.penalizacion, 300);
+  assert.equal(veinticinco.cuerpo.reembolso, 900);
+
+  const justa = await reservar("2027-03-10T12:00", "2027-03-10T00:00");
+  const sinForzar = await cancelar(justa.id);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await cancelar(justa.id, { forzar: true });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.estado, "cancelada");
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+  assert.equal(forzada.cuerpo.reembolso, 600);
+});
+
+test("límites exactos: a 48 h justas no hay penalización y a 24 h justas es el 25 % sin forzar", async () => {
+  const a48 = await reservar("2027-03-10T12:00", "2027-03-08T12:00");
+  const gratis = await cancelar(a48.id);
+  assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.cuerpo.reembolso, 1200);
+
+  const casi48 = await reservar("2027-03-10T12:00", "2027-03-08T12:01");
+  assert.equal((await cancelar(casi48.id)).cuerpo.reserva.penalizacion, 300);
+
+  const a24 = await reservar("2027-03-10T12:00", "2027-03-09T12:00");
+  const justa = await cancelar(a24.id);
+  assert.equal(justa.status, 200);
+  assert.equal(justa.cuerpo.reserva.penalizacion, 300);
+
+  const casi24 = await reservar("2027-03-10T12:00", "2027-03-09T12:01");
+  assert.equal((await cancelar(casi24.id)).cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  assert.equal((await cancelar(casi24.id, { forzar: true })).cuerpo.reserva.penalizacion, 600);
+});
+
+test("cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas.
+  const primavera = await reservar("2027-03-28T21:00", "2027-03-26T20:30");
+  const r1 = await cancelar(primavera.id);
+  assert.equal(r1.cuerpo.reserva.penalizacion, primavera.importe / 4);
+  // A las 20:00 del viernes faltan 48 horas reales (49 en el reloj de pared).
+  const primavera48 = await reservar("2027-03-28T21:00", "2027-03-26T20:00");
+  assert.equal((await cancelar(primavera48.id)).cuerpo.reserva.penalizacion, undefined);
+  // En otoño se atrasa una hora: del sábado 30 de octubre a las 10:00 al domingo 31 a las 09:00 hay 24 horas, no 23.
+  const otono = await reservar("2027-10-31T09:00", "2027-10-30T10:00");
+  const r2 = await cancelar(otono.id);
+  assert.equal(r2.status, 200);
+  assert.equal(r2.cuerpo.reserva.penalizacion, otono.importe / 4);
+});
+
+test("exención: un gestor cancela sin penalización con un motivo de al menos 10 caracteres", async () => {
+  const r = await reservar("2027-03-10T12:00", "2027-03-10T11:00");
+  const motivo = "Lesión justificada con parte médico";
+
+  const anonimo = await cancelar(r.id, { exento: true, motivo });
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await cancelar(r.id, { exento: true, motivo }, SOCIO);
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  for (const malo of [{}, { motivo: "corto" }, { motivo: "123456789" }, { motivo: 1234567890 }]) {
+    const sinMotivo = await cancelar(r.id, { exento: true, ...malo }, GESTOR);
+    assert.equal(sinMotivo.status, 400, JSON.stringify(malo));
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva.estado, "confirmada");
+
+  const ok = await cancelar(r.id, { exento: true, motivo }, GESTOR);
+  assert.equal(ok.status, 200);
+  assert.equal(ok.cuerpo.reserva.estado, "cancelada");
+  assert.equal(ok.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(ok.cuerpo.reserva.motivoCancelacion, motivo);
+  assert.equal(ok.cuerpo.reembolso, r.importe);
+
+  const diez = await reservar("2027-03-10T12:00", "2027-03-09T20:00");
+  const conDiez = await cancelar(diez.id, { exento: true, motivo: "1234567890" }, GESTOR);
