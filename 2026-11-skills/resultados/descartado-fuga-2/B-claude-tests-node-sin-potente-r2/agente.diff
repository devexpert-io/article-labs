+  const gratis = await reservar("2027-04-06T13:30", "2027-01-01T08:00", "pista-1");
+  await cancelar(gratis.id);
+  // Una reserva de mayo no cuenta en abril.
+  await reservar("2027-05-04T09:00", "2027-01-01T08:00", "pista-1");
+
+  const abril = await api.pedir("GET", "/api/informes/caja?mes=2027-04", { socio: GESTOR });
