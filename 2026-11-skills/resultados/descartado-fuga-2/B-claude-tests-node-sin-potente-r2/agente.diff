+test("informe de caja: reservas, ingresos y penalizaciones por pista y del club", async () => {
+  // Abril de 2027 empieza vacío. Martes 6 de abril, en valle: pista 1 a 1800 y pista 3 a 1200.
+  const vacio = await api.pedir("GET", "/api/informes/caja?mes=2027-04", { socio: GESTOR });
+  assert.equal(vacio.status, 200);
+  const cero = { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 };
+  assert.deepEqual(vacio.cuerpo, {
+    mes: "2027-04",
+    pistas: ["pista-1", "pista-2", "pista-3", "pista-4"].map((pistaId) => ({ pistaId, ...cero })),
+    total: cero,
+  });
+
+  await reservar("2027-04-06T09:00", "2027-01-01T08:00", "pista-1");
+  await reservar("2027-04-06T10:30", "2027-01-01T08:00", "pista-3");
