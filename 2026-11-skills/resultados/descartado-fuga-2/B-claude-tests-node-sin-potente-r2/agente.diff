+test("informe de caja: cuenta las confirmadas y las no presentadas del historial", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const octubre = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+  const cobradas = octubre.filter((r: any) => r.estado !== "cancelada");
+  const informe = (await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR })).cuerpo;
+  const ingresos = cobradas.reduce((s: number, r: any) => s + r.importe, 0);
+  assert.equal(informe.total.reservas, cobradas.length);
+  assert.ok(cobradas.some((r: any) => r.estado === "no_presentada"));
+  assert.equal(informe.total.ingresos, ingresos);
+  assert.equal(informe.total.penalizaciones, 0);
+  assert.equal(informe.total.total, ingresos);
+  const pista4 = cobradas.filter((r: any) => r.pistaId === "pista-4");
+  assert.equal(informe.pistas.find((p: any) => p.pistaId === "pista-4").reservas, pista4.length);
+});
