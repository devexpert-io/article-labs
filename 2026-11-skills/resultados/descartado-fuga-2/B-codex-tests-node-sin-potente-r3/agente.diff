+/** Convierte la hora local del club a un instante, sin depender de la zona del proceso. */
+function instanteMadrid(fecha: string): number {
+  const local = Date.parse(`${fecha}:00Z`);
+  let instante = local;
+  for (let intento = 0; intento < 3; intento += 1) {
+    const zona = zonaMadrid.formatToParts(instante).find((p) => p.type === "timeZoneName")!.value;
+    const desfase = /GMT([+-])(\d{2}):(\d{2})/.exec(zona)!;
+    const minutos = (Number(desfase[2]) * 60 + Number(desfase[3])) * (desfase[1] === "+" ? 1 : -1);
+    const siguiente = local - minutos * 60_000;
+    if (siguiente === instante) break;
+    instante = siguiente;
+  }
+  return instante;
+}
