+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import type { Reserva } from "../src/tipos.ts";
+
+let api: Api;
+beforeEach(async () => { api = await arrancarApi({ TZ: "Pacific/Honolulu" }); });
+afterEach(() => api.cerrar());
+
+function error(respuesta: Respuesta, status: number, codigo: string) {
+  assert.equal(respuesta.status, status);
+  assert.equal(respuesta.cuerpo.error.codigo, codigo);
+  assert.equal(typeof respuesta.cuerpo.error.mensaje, "string");
+}
+
+async function crear(inicio = "2026-12-10T12:00", pistaId = "pista-1"): Promise<Reserva> {
+  const respuesta = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio },
+  });
+  assert.equal(respuesta.status, 201);
+  return respuesta.cuerpo.reserva;
+}
+
+async function reloj(ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function obtener(id: string): Promise<Reserva> {
+  const respuesta = await api.pedir("GET", `/api/reservas/${id}`);
+  assert.equal(respuesta.status, 200);
+  return respuesta.cuerpo.reserva;
+}
+
+for (const caso of [
+  { nombre: "más de 48 horas", ahora: "2026-12-08T11:59", porcentaje: 0 },
+  { nombre: "48 horas exactas", ahora: "2026-12-08T12:00", porcentaje: 0 },
+  { nombre: "un minuto menos de 48 horas", ahora: "2026-12-08T12:01", porcentaje: 0.25 },
+  { nombre: "entre 24 y 48 horas", ahora: "2026-12-09T00:00", porcentaje: 0.25 },
+  { nombre: "24 horas exactas", ahora: "2026-12-09T12:00", porcentaje: 0.25 },
+  { nombre: "un minuto menos de 24 horas", ahora: "2026-12-09T12:01", porcentaje: 0.5 },
+  { nombre: "un minuto antes del inicio", ahora: "2026-12-10T11:59", porcentaje: 0.5 },
+]) {
+  test(`cancelación y reembolso: ${caso.nombre}`, async () => {
+    const reserva = await crear();
+    assert.equal(reserva.importe, 1800);
+    await reloj(caso.ahora);
+    const ruta = `/api/reservas/${reserva.id}/cancelar`;
+    if (caso.porcentaje === 0.5) {
+      for (const cuerpo of [{}, { forzar: false }]) {
+        error(await api.pedir("POST", ruta, { cuerpo }), 409, "FUERA_DE_PLAZO");
+        assert.deepEqual(await obtener(reserva.id), reserva);
+      }
+    }
+    const respuesta = await api.pedir("POST", ruta, {
+      cuerpo: { forzar: caso.porcentaje === 0.5, motivo: "Cambio de planes" },
+    });
+    assert.equal(respuesta.status, 200);
+    assert.equal(respuesta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(respuesta.cuerpo.reserva.penalizacion ?? 0, reserva.importe * caso.porcentaje);
+    assert.equal(respuesta.cuerpo.reembolso, reserva.importe * (1 - caso.porcentaje));
+    assert.equal(respuesta.cuerpo.reserva.motivoCancelacion, "Cambio de planes");
+    assert.deepEqual(await obtener(reserva.id), respuesta.cuerpo.reserva);
+  });
+}
+
+for (const caso of [
