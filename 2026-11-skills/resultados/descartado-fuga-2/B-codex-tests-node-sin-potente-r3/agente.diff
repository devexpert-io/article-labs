+  { nombre: "primavera: 23 horas reales", inicio: "2027-03-28T21:00", ahora: "2027-03-27T21:00", porcentaje: 0.5 },
+  { nombre: "otoño: 48 horas reales", inicio: "2027-10-31T19:30", ahora: "2027-10-29T20:30", porcentaje: 0 },
+  { nombre: "otoño: 25 horas reales", inicio: "2027-10-31T21:00", ahora: "2027-10-30T21:00", porcentaje: 0.25 },
