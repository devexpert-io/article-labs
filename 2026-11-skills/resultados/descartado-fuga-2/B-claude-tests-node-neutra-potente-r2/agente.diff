+test("C7 · en el historial cuentan las confirmadas y las no presentadas, no las canceladas", () => conApi(async (api) => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const octubre = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+  const cobradas = octubre.filter((r: any) => r.estado !== "cancelada");
+  assert.ok(octubre.some((r: any) => r.estado === "no_presentada"));
+  assert.ok(octubre.some((r: any) => r.estado === "cancelada"));
+  const r = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR });
+  assert.equal(r.status, 200);
+  const ingresos = cobradas.reduce((s: number, x: any) => s + x.importe, 0);
+  assert.deepEqual(r.cuerpo.total, { reservas: cobradas.length, ingresos, penalizaciones: 0, total: ingresos });
+  const pista4 = cobradas.filter((x: any) => x.pistaId === "pista-4");
+  assert.equal(r.cuerpo.pistas[3].reservas, pista4.length);
+}));
