+// Spec docs/specs/reembolsos.md: penalizaciones escalonadas, exención y informe de caja.
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const NORA = "socio-041"; // Sin reservas en la semilla.
+const MARTA = "socio-002";
+
+/** Cada test arranca su propia API, con la semilla recién creada. */
+async function conApi(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+async function reservar(api: Api, socioId: string, pistaId: string, inicio: string): Promise<{ id: string; importe: number }> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+}
+
+/** Reserva la pista 3 el miércoles 25 de noviembre a las 12:00 (valle, 1200) y pone el reloj en `ahora`. */
+async function reservaDel25(api: Api, ahora: string) {
+  const reserva = await reservar(api, NORA, "pista-3", "2026-11-25T12:00");
+  assert.equal(reserva.importe, 1200);
+  await reloj(api, ahora);
+  return reserva;
+}
+
+const cancelar = (api: Api, id: string, cuerpo?: unknown, socio?: string) =>
+  api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+
+test("C1 · con 48 horas o más de antelación no hay penalización", () => conApi(async (api) => {
+  const { id } = await reservaDel25(api, "2026-11-20T12:00");
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 1200);
+}));
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 %", () => conApi(async (api) => {
+  const { id } = await reservaDel25(api, "2026-11-23T20:00");
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 300);
+  assert.equal(r.cuerpo.reembolso, 900);
+}));
+
+test("C1 · con menos de 24 horas, sin forzar, 409 FUERA_DE_PLAZO", () => conApi(async (api) => {
+  const { id } = await reservaDel25(api, "2026-11-25T09:00");
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const sigue = await api.pedir("GET", `/api/reservas/${id}`);
+  assert.equal(sigue.cuerpo.reserva.estado, "confirmada");
+}));
+
+test("C1 · con menos de 24 horas y forzar, la penalización es el 50 %", () => conApi(async (api) => {
+  const { id } = await reservaDel25(api, "2026-11-25T09:00");
+  const r = await cancelar(api, id, { forzar: true });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r.cuerpo.reserva.penalizacion, 600);
+  assert.equal(r.cuerpo.reembolso, 600);
+}));
+
+test("C2 · a 48 horas justas no hay penalización", () => conApi(async (api) => {
+  const { id } = await reservaDel25(api, "2026-11-23T12:00");
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 1200);
+}));
+
+test("C2 · un minuto por debajo de 48 horas ya se aplica el 25 %", () => conApi(async (api) => {
+  const { id } = await reservaDel25(api, "2026-11-23T12:01");
+  const r = await cancelar(api, id);
+  assert.equal(r.cuerpo.reserva.penalizacion, 300);
+  assert.equal(r.cuerpo.reembolso, 900);
+}));
+
+test("C2 · a 24 horas justas se aplica el 25 % sin necesidad de forzar", () => conApi(async (api) => {
+  const { id } = await reservaDel25(api, "2026-11-24T12:00");
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 300);
+  assert.equal(r.cuerpo.reembolso, 900);
+}));
+
+test("C2 · un minuto por debajo de 24 horas hace falta forzar", () => conApi(async (api) => {
+  const { id } = await reservaDel25(api, "2026-11-24T12:01");
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+}));
+
+test("C3 · en el cambio de hora de primavera, del viernes 20:30 al domingo 21:00 hay 47,5 horas: 25 %", () => conApi(async (api) => {
+  await reloj(api, "2027-03-26T20:30");
+  const { id, importe } = await reservar(api, NORA, "pista-3", "2027-03-28T21:00");
+  assert.equal(importe, 2000);
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 500);
+  assert.equal(r.cuerpo.reembolso, 1500);
+}));
+
+test("C3 · en el cambio de hora de primavera, del viernes 20:00 al domingo 21:00 hay 48 horas justas: gratis", () => conApi(async (api) => {
+  await reloj(api, "2027-03-26T20:00");
+  const { id } = await reservar(api, NORA, "pista-3", "2027-03-28T21:00");
+  const r = await cancelar(api, id);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 2000);
+}));
+
+test("C3 · en el cambio de hora de otoño, 47,5 horas de reloj son 48,5 reales: gratis", () => conApi(async (api) => {
+  await reloj(api, "2026-10-23T21:30");
+  const { id } = await reservar(api, NORA, "pista-2", "2026-10-25T21:00");
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 2800);
