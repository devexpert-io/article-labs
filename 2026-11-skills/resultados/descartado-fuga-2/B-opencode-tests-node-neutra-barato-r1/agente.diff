+test("C7 · el informe cuenta confirmadas y no presentadas, y las pistas cerradas", async () => {
+  await conApi(async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const octubre = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10") && (r.estado === "confirmada" || r.estado === "no_presentada"));
+    assert.ok(octubre.some((r: any) => r.estado === "no_presentada"), "la semilla debe tener no presentadas en octubre");
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+    assert.deepEqual(informe.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+    assert.equal(informe.cuerpo.total.reservas, octubre.length);
+    assert.equal(informe.cuerpo.total.ingresos, octubre.reduce((suma: number, r: any) => suma + r.importe, 0));
+    assert.equal(informe.cuerpo.total.penalizaciones, 0);
+    assert.equal(informe.cuerpo.total.total, informe.cuerpo.total.ingresos);
+  });
+});
