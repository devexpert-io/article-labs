+test("C7 · el informe de caja suma ingresos y penalizaciones por pista", async () => {
+  await conApi(async (api) => {
+    await reloj(api, "2026-11-30T10:00");
+    await crear(api, "socio-003", "pista-1", "2026-12-02T10:30"); // sigue confirmada
+    const cancelada = await crear(api, "socio-004", "pista-2", "2026-12-01T18:00");
+    const cancelacion = await api.pedir("POST", `/api/reservas/${cancelada.id}/cancelar`);
+    assert.equal(cancelacion.cuerpo.reserva.penalizacion, 700);
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+    assert.equal(informe.cuerpo.mes, "2026-12");
+    assert.deepEqual(informe.cuerpo.pistas, [
+      { pistaId: "pista-1", reservas: 1, ingresos: 1800, penalizaciones: 0, total: 1800 },
+      { pistaId: "pista-2", reservas: 0, ingresos: 0, penalizaciones: 700, total: 700 },
+      { pistaId: "pista-3", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+      { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    ]);
+    assert.deepEqual(informe.cuerpo.total, { reservas: 1, ingresos: 1800, penalizaciones: 700, total: 2500 });
+
+    const vacio = await api.pedir("GET", "/api/informes/caja?mes=2027-01", { socio: "socio-040" });
+    assert.equal(vacio.status, 200);
+    assert.equal(vacio.cuerpo.pistas.length, 4);
+    assert.ok(vacio.cuerpo.pistas.every((p: any) => p.reservas === 0 && p.ingresos === 0 && p.penalizaciones === 0 && p.total === 0));
+    assert.deepEqual(vacio.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
