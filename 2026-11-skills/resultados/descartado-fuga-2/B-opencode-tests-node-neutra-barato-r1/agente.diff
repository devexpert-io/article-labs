+// Penalizaciones escalonadas, exenciones e informe de caja. Un arranque nuevo por test.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reloj(api: Api, ahora: string) {
+  const respuesta = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(respuesta.status, 200, `no se pudo mover el reloj: ${respuesta.texto}`);
+}
+
+async function crear(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(respuesta.status, 201, `no se pudo crear la reserva: ${respuesta.texto}`);
+  return respuesta.cuerpo.reserva;
+}
+
+test("C1 · tramos de penalización: sin penalización, 25 % y 50 % con forzar", async () => {
+  await conApi(async (api) => {
+    await reloj(api, "2026-11-30T10:00");
+
+    const larga = await crear(api, "socio-003", "pista-1", "2026-12-02T10:30"); // 48,5 horas
+    const sinPenalizacion = await api.pedir("POST", `/api/reservas/${larga.id}/cancelar`);
+    assert.equal(sinPenalizacion.status, 200);
+    assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(sinPenalizacion.cuerpo.reembolso, larga.importe);
+
+    const media = await crear(api, "socio-003", "pista-1", "2026-12-01T18:00"); // 32 horas, punta
+    const reducida = await api.pedir("POST", `/api/reservas/${media.id}/cancelar`);
+    assert.equal(reducida.status, 200);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, 700);
+    assert.equal(reducida.cuerpo.reembolso, 2100);
+
+    const corta = await crear(api, "socio-003", "pista-1", "2026-12-01T09:00"); // 23 horas
+    const fuera = await api.pedir("POST", `/api/reservas/${corta.id}/cancelar`);
+    assert.equal(fuera.status, 409);
+    assert.equal(fuera.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${corta.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+  });
+});
+
+test("C2 · límites exactos: 48 horas sin penalización y 24 horas con el 25 %", async () => {
+  await conApi(async (api) => {
+    await reloj(api, "2026-11-30T10:30");
+
+    const a48 = await crear(api, "socio-003", "pista-1", "2026-12-02T10:30");
+    const r48 = await api.pedir("POST", `/api/reservas/${a48.id}/cancelar`);
+    assert.equal(r48.status, 200);
+    assert.equal(r48.cuerpo.reserva.penalizacion, undefined);
+
+    const a24 = await crear(api, "socio-003", "pista-1", "2026-12-01T10:30");
+    const r24 = await api.pedir("POST", `/api/reservas/${a24.id}/cancelar`); // sin forzar
+    assert.equal(r24.status, 200);
+    assert.equal(r24.cuerpo.reserva.penalizacion, 450);
+    assert.equal(r24.cuerpo.reembolso, 1350);
+  });
+});
+
+test("C3 · el cambio de hora de Madrid cuenta como horas reales", async () => {
+  await conApi(async (api) => {
+    await reloj(api, "2027-03-26T20:30");
+    // Del viernes 26 a las 20:30 al domingo 28 a las 21:00: 47,5 horas reales, no 48,5.
+    const reserva = await crear(api, "socio-003", "pista-1", "2027-03-28T21:00");
+    assert.equal(reserva.importe, 2800);
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  });
+});
+
+test("C4 · el reembolso es el importe menos la penalización", async () => {
+  await conApi(async (api) => {
+    await reloj(api, "2026-11-30T10:00");
+
+    const larga = await crear(api, "socio-003", "pista-1", "2026-12-02T10:30");
+    const sin = await api.pedir("POST", `/api/reservas/${larga.id}/cancelar`);
+    assert.equal(sin.cuerpo.reserva.estado, "cancelada");
+    assert.equal(sin.cuerpo.reembolso, larga.importe);
+
+    const media = await crear(api, "socio-003", "pista-1", "2026-12-01T18:00");
+    const con = await api.pedir("POST", `/api/reservas/${media.id}/cancelar`);
+    assert.equal(con.cuerpo.reembolso, media.importe - con.cuerpo.reserva.penalizacion);
+    assert.equal(con.cuerpo.reembolso, 2100);
+  });
+});
+
+test("C5 · un gestor exime con motivo, sin forzar y sin penalización", async () => {
+  await conApi(async (api) => {
+    await reloj(api, "2026-11-30T10:00");
+    const reserva = await crear(api, "socio-003", "pista-1", "2026-12-01T09:00"); // menos de 24 horas
+    const cuerpo = { exento: true, motivo: "Ajuste de recepción" };
+
+    const sinSocio = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo });
