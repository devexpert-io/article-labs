+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import type { Reserva } from "../src/tipos.ts";
+
+let api: Api;
+beforeEach(async () => { api = await arrancarApi(); });
+afterEach(() => api.cerrar());
+
+async function reloj(ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { ahora });
+}
+async function crear(inicio = "2027-01-20T18:00", pistaId = "pista-1", socioId = "socio-041"): Promise<Reserva> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.estado, "confirmada");
+  assert.equal(r.cuerpo.reserva.inicio, inicio);
+  return r.cuerpo.reserva;
+}
+function cancelar(r: Reserva, cuerpo: unknown = {}, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo, socio });
+}
+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+  assert.equal(typeof r.cuerpo.error.mensaje, "string");
+}
+function cancelada(r: Respuesta, original: Reserva, penalizacion: number) {
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, {
+    reserva: { ...original, estado: "cancelada", penalizacion },
+    reembolso: original.importe - penalizacion,
+  });
+}
+
+for (const [ahora, penalizacion] of [
+  ["2027-01-18T17:59", 0],
+  ["2027-01-18T18:01", 700],
+  ["2027-01-19T18:01", 1400],
+] as const) {
+  test(`C1 · tramos de cancelación a ${ahora}`, async () => {
+    const r = await crear();
+    await reloj(ahora);
+    if (penalizacion === 1400) {
+      error(await cancelar(r), 409, "FUERA_DE_PLAZO");
+      error(await cancelar(r, { forzar: false }), 409, "FUERA_DE_PLAZO");
+      const intacta = await api.pedir("GET", `/api/reservas/${r.id}`);
+      assert.equal(intacta.status, 200);
+      assert.deepEqual(intacta.cuerpo, { reserva: r });
+    }
