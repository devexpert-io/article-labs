+// Convierte la hora local usando el desfase de Madrid en esa fecha, incluido el horario de verano.
+function instanteMadrid(local: string): number {
+  const nominal = Date.parse(`${local}:00Z`);
+  let instante = nominal;
+  for (let intento = 0; intento < 3; intento++) {
+    const zona = zonaMadrid.formatToParts(instante).find((p) => p.type === "timeZoneName")!.value;
