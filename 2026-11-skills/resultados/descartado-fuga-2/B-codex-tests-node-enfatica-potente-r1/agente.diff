+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { beforeEach, afterEach, test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import type { Estado, Reserva } from "../src/tipos.ts";
+
+let api: Api;
+beforeEach(async () => { api = await arrancarApi(); });
+afterEach(() => api.cerrar());
+
+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+  assert.equal(typeof r.cuerpo.error.mensaje, "string");
+}
+async function reloj(ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { ahora });
+}
+async function crear(inicio = "2027-01-10T12:00", pistaId = "pista-1", socioId = "socio-041") {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { inicio, pistaId, socioId } });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.inicio, inicio);
+  assert.equal(r.cuerpo.reserva.estado, "confirmada");
+  return r.cuerpo.reserva as Reserva;
+}
+async function cancelar(r: Reserva, cuerpo = {}, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo, socio });
+}
+function cancelada(respuesta: Respuesta, r: Reserva, penalizacion: number, motivo?: string) {
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, {
+    reserva: { ...r, estado: "cancelada", penalizacion, ...(motivo === undefined ? {} : { motivoCancelacion: motivo }) },
+    reembolso: r.importe - penalizacion,
+  });
+}
+
+for (const [ahora, penalizacion, forzar] of [
+  ["2027-01-08T11:59", 0, false],
+  ["2027-01-08T12:01", 700, false],
+  ["2027-01-09T11:59", 700, false],
+  ["2027-01-09T12:01", 1400, true],
+  ["2027-01-10T11:59", 1400, true],
+] as const) {
+  test(`C1 · tramo de cancelación a ${ahora}`, async () => {
+    const r = await crear();
+    await reloj(ahora);
+    if (forzar) {
+      error(await cancelar(r), 409, "FUERA_DE_PLAZO");
+      error(await cancelar(r, { forzar: false }), 409, "FUERA_DE_PLAZO");
+      const intacta = await api.pedir("GET", `/api/reservas/${r.id}`);
+      assert.equal(intacta.status, 200);
+      assert.deepEqual(intacta.cuerpo, { reserva: r });
+    }
+    cancelada(await cancelar(r, { forzar }), r, penalizacion);
+  });
+}
+for (const [ahora, penalizacion] of [["2027-01-08T12:00", 0], ["2027-01-09T12:00", 700]] as const) {
+  test(`C2 · límite exacto a ${ahora}`, async () => {
+    const r = await crear();
+    await reloj(ahora);
+    cancelada(await cancelar(r), r, penalizacion);
+  });
+}
+for (const [inicio, ahora, penalizacion] of [
+  ["2027-03-28T21:00", "2027-03-26T20:30", 700],
+  ["2027-10-31T21:00", "2027-10-29T21:30", 0],
+  ["2027-03-28T21:00", "2027-03-27T21:00", 1400],
+] as const) {
+  test(`C3 · horas reales de Madrid desde ${ahora}`, async () => {
+    const r = await crear(inicio);
+    await reloj(ahora);
+    if (penalizacion === 1400) error(await cancelar(r), 409, "FUERA_DE_PLAZO");
+    cancelada(await cancelar(r, { forzar: penalizacion === 1400 }), r, penalizacion);
+  });
+}
+
+test("C4 · reembolso íntegro o descontando la penalización en céntimos", async () => {
+  const r = await crear();
+  await reloj("2027-01-08T12:01");
+  cancelada(await cancelar(r), r, 700);
+  const gratis = await crear("2027-01-12T12:00");
+  cancelada(await cancelar(gratis), gratis, 0);
+});
+
+test("C5 · exención con motivo de diez caracteres y sin forzar en el último minuto", async () => {
+  const r = await crear();
+  await reloj("2027-01-10T11:59");
+  const motivo = "0123456789";
+  cancelada(await cancelar(r, { exento: true, motivo }, "socio-040"), r, 0, motivo);
+  const guardada = await api.pedir("GET", `/api/reservas/${r.id}`);
+  assert.equal(guardada.status, 200);
+  assert.deepEqual(guardada.cuerpo.reserva, { ...r, estado: "cancelada", penalizacion: 0, motivoCancelacion: motivo });
+});
+
+test("C5 · exención exige identidad, rol y motivo válido", async () => {
+  const r = await crear();
+  await reloj("2027-01-10T11:59");
+  const cuerpo = { exento: true, motivo: "Lesión justificada" };
+  error(await cancelar(r, cuerpo), 401, "NO_IDENTIFICADO");
+  error(await cancelar(r, cuerpo, "socio-999"), 401, "NO_IDENTIFICADO");
+  error(await cancelar(r, cuerpo, "socio-041"), 403, "SIN_PERMISO");
+  for (const motivo of [undefined, "", "123456789", "          ", 1234567890]) {
+    error(await cancelar(r, { exento: true, motivo }, "socio-040"), 400, "DATOS_INVALIDOS");
+  }
+  for (const cuerpo of [{ exento: "true" }, { forzar: "true" }]) {
+    error(await cancelar(r, cuerpo, "socio-040"), 400, "DATOS_INVALIDOS");
+  }
+  cancelada(await cancelar(r, { forzar: true, exento: false }), r, 1400);
+});
+
+test("C6 · una reserva iniciada o pasada no admite cancelación ni exención", async () => {
+  const r = await crear();
+  for (const ahora of [r.inicio, "2027-01-10T12:01"]) {
+    await reloj(ahora);
+    for (const cuerpo of [{}, { forzar: true }, { exento: true, motivo: "Lesión justificada" }]) {
+      error(await cancelar(r, cuerpo, "socio-040"), 409, "RESERVA_PASADA");
+    }
+  }
+});
+
+test("C7 · caja suma confirmadas, no presentadas y penalizaciones por mes de inicio", async () => {
+  const cancelacion = await crear("2026-12-01T12:00");
+  await reloj("2026-11-30T12:00");
+  cancelada(await cancelar(cancelacion), cancelacion, 450);
+  const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: "socio-040" });
