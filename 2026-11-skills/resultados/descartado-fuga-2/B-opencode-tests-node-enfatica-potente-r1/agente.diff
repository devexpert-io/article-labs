+// La política de penalizaciones escalonadas y el informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("C1 · los tramos: 48 h o más gratis, 24–48 h el 25 %, menos de 24 h solo con forzar y el 50 %", () => conApi(async (api) => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T10:00" } });
+
+  // 50 horas de antelación: gratis.
+  const libre = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-27T12:00" } });
+  assert.equal(libre.status, 201);
+  const gratis = await api.pedir("POST", `/api/reservas/${libre.cuerpo.reserva.id}/cancelar`);
+  assert.equal(gratis.status, 200);
+  assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(gratis.cuerpo.reembolso, 1200);
+
+  // 26 horas de antelación: 25 %.
+  const cuarto = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-26T12:00" } });
+  const cCuarto = await api.pedir("POST", `/api/reservas/${cuarto.cuerpo.reserva.id}/cancelar`);
+  assert.equal(cCuarto.cuerpo.reserva.penalizacion, 300);
+  assert.equal(cCuarto.cuerpo.reembolso, 900);
+
+  // 23 horas de antelación: solo con forzar, y el 50 %.
+  const medio = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-26T09:00" } });
+  const sinForzar = await api.pedir("POST", `/api/reservas/${medio.cuerpo.reserva.id}/cancelar`);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await api.pedir("POST", `/api/reservas/${medio.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+  assert.equal(forzada.cuerpo.reembolso, 600);
+}));
+
+test("C2 · a 48 horas justas no hay penalización y a 24 justas se aplica el 25 % sin forzar", () => conApi(async (api) => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T09:00" } });
+
+  const limite48 = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-27T09:00" } });
+  const c48 = await api.pedir("POST", `/api/reservas/${limite48.cuerpo.reserva.id}/cancelar`);
+  assert.equal(c48.status, 200);
+  assert.equal(c48.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(c48.cuerpo.reembolso, 1200);
+
+  const limite24 = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-26T09:00" } });
+  const c24 = await api.pedir("POST", `/api/reservas/${limite24.cuerpo.reserva.id}/cancelar`);
+  assert.equal(c24.status, 200);
+  assert.equal(c24.cuerpo.reserva.penalizacion, 300);
+  assert.equal(c24.cuerpo.reembolso, 900);
+}));
+
+test("C3 · la antelación cuenta las horas reales de Madrid, con el cambio de hora", () => conApi(async (api) => {
+  // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas (no 48,5), por el cambio de hora.
