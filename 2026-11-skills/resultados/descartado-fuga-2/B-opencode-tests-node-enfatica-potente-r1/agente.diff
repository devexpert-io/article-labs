+
+test("C5 · un gestor exime con exento y motivo; si no, 400/403/401", () => conApi(async (api) => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T10:00" } });
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-25T12:00" } });
