+    estado: "confirmada", importe, notas: "",
+  };
+  assert.deepEqual(r.cuerpo, { reserva: esperada });
+  return esperada;
+}
+
+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+  assert.equal(typeof r.cuerpo.error.mensaje, "string");
+}
+
+async function sinCambios(reserva: Reserva) {
+  const r = await api.pedir("GET", `/api/reservas/${reserva.id}`);
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { reserva });
+}
+
+function cancelada(r: Respuesta, reserva: Reserva, penalizacion: number, motivo?: string) {
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, {
+    reserva: { ...reserva, estado: "cancelada", penalizacion,
+      ...(motivo === undefined ? {} : { motivoCancelacion: motivo }) },
+    reembolso: reserva.importe - penalizacion,
+  });
+}
+
+for (const caso of [
+  { criterio: 1, ahora: "2027-01-13T11:00", penalizacion: 0, forzar: false },
+  { criterio: 1, ahora: "2027-01-14T00:00", penalizacion: 300, forzar: false },
+  { criterio: 1, ahora: "2027-01-15T11:59", penalizacion: 600, forzar: true },
+  { criterio: 2, ahora: "2027-01-13T12:00", penalizacion: 0, forzar: false },
+  { criterio: 2, ahora: "2027-01-13T12:01", penalizacion: 300, forzar: false },
+  { criterio: 2, ahora: "2027-01-14T12:00", penalizacion: 300, forzar: false },
+  { criterio: 2, ahora: "2027-01-14T12:01", penalizacion: 600, forzar: true },
+]) {
+  test(`C${caso.criterio} · tramo a ${caso.ahora}, penalización ${caso.penalizacion}`, async () => {
+    const reserva = await crear();
+    await reloj(caso.ahora);
+    if (caso.forzar) {
+      for (const cuerpo of [{}, { forzar: false }]) {
+        error(await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo }), 409, "FUERA_DE_PLAZO");
+        await sinCambios(reserva);
+      }
+    }
+    cancelada(await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { forzar: caso.forzar },
+    }), reserva, caso.penalizacion);
+  });
+}
+
+for (const caso of [
+  { inicio: "2027-03-28T21:00", ahora: "2027-03-26T20:30", penalizacion: 500 },
+  { inicio: "2027-10-31T21:00", ahora: "2027-10-29T21:30", penalizacion: 0 },
+  { inicio: "2027-03-28T21:00", ahora: "2027-03-27T21:00", penalizacion: 1000 },
+]) {
+  test(`C3 · horas reales de Madrid desde ${caso.ahora} a ${caso.inicio}`, async () => {
+    const reserva = await crear(caso.inicio, "pista-3", 2000);
