+    if (caso.penalizacion === 1000) {
+      error(await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`), 409, "FUERA_DE_PLAZO");
+    }
+    cancelada(await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { forzar: caso.penalizacion === 1000 },
+    }), reserva, caso.penalizacion);
+  });
+}
+
+test("C4 · reembolso parcial y persistencia del motivo", async () => {
