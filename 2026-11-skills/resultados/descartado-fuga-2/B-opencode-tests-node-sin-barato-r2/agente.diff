+/** Minutos que Madrid lleva de ventaja sobre UTC en ese instante (120 en verano, 60 en invierno). */
+function desfaseMadrid(instante: number): number {
+  const partes = FORMATO_MADRID.formatToParts(new Date(instante));
+  const valor = (tipo: string) => Number(partes.find((p) => p.type === tipo)!.value);
+  const comoUtc = Date.UTC(valor("year"), valor("month") - 1, valor("day"), valor("hour"), valor("minute"), valor("second"));
+  return (comoUtc - instante) / 60_000;
+}
+
+/** Instante real (ms UTC) de una hora local del club, teniendo en cuenta el cambio de hora. */
+function instanteLocal(fechaHora: string): number {
+  const [fecha, hora] = fechaHora.split("T");
+  const [anio, mes, dia] = fecha!.split("-").map(Number);
+  const [h, m] = hora!.split(":").map(Number);
+  const ingenuo = Date.UTC(anio!, mes! - 1, dia!, h!, m!);
+  let instante = ingenuo - desfaseMadrid(ingenuo) * 60_000;
+  // La segunda pasada corrige el caso en que la primera cae en el otro lado del cambio de hora.
+  instante = ingenuo - desfaseMadrid(instante) * 60_000;
+  return instante;
+}
+
+/** Horas reales transcurridas entre dos horas locales del club. */
 function horasEntre(desde: string, hasta: string): number {
-  return (Date.parse(`${hasta}:00Z`) - Date.parse(`${desde}:00Z`)) / 3_600_000;
+  return (instanteLocal(hasta) - instanteLocal(desde)) / 3_600_000;
+}
