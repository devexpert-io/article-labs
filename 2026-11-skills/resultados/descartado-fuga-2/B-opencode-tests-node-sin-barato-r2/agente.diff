@@ -0,0 +1,282 @@
+// Política escalonada de cancelación, exenciones e informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi<T>(ahora: string, prueba: (api: Api) => Promise<T>): Promise<T> {
+  const api = await arrancarApi({ AHORA: ahora });
+  try {
+    return await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reservar(api: Api, inicio: string, socioId = "socio-041", pistaId = "pista-1") {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(respuesta.status, 201, JSON.stringify(respuesta.cuerpo));
+  return respuesta.cuerpo.reserva;
+}
+
+// 2026-11-25 es miércoles: la franja de 21:00 es punta y la pista 1 cuesta 2800.
+const INICIO = "2026-11-25T21:00";
+const IMPORTE = 2800;
+
+test("tramos: 48 horas o más no tiene penalización", async () => {
+  await conApi("2026-11-23T19:00", async (api) => {
+    const reserva = await reservar(api, INICIO);
+    assert.equal(reserva.importe, IMPORTE);
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada.cuerpo.reembolso, IMPORTE);
+  });
+});
+
+test("límites: a 48 horas justas no hay penalización", async () => {
+  await conApi("2026-11-23T21:00", async (api) => {
+    const reserva = await reservar(api, INICIO);
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada.cuerpo.reembolso, IMPORTE);
+  });
+});
+
+test("tramos: menos de 48 horas y 24 o más aplica el 25 %", async () => {
+  await conApi("2026-11-23T21:30", async (api) => {
+    const reserva = await reservar(api, INICIO);
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  });
+});
+
+test("límites: a 24 horas justas se aplica el 25 % y no hace falta forzar", async () => {
+  await conApi("2026-11-24T21:00", async (api) => {
+    const reserva = await reservar(api, INICIO);
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  });
+});
+
+test("tramos: menos de 24 horas exige forzar y aplica el 50 %", async () => {
+  await conApi("2026-11-24T21:30", async (api) => {
+    const reserva = await reservar(api, INICIO);
+    const sinForzar = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 1400);
+    assert.equal(forzada.cuerpo.reembolso, 1400);
+  });
+});
+
+test("cambio de hora: 47,5 horas reales en Madrid aplican el 25 %", async () => {
+  // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00:
+  // esa madrugada los relojes se adelantan una hora, así que son 47,5 horas, no 48,5.
+  await conApi("2027-03-26T20:30", async (api) => {
+    const reserva = await reservar(api, "2027-03-28T21:00");
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  });
+});
+
+test("cambio de hora: 49 horas de reloj son 48 reales y no hay penalización", async () => {
+  await conApi("2027-03-26T20:00", async (api) => {
+    const reserva = await reservar(api, "2027-03-28T21:00");
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada.cuerpo.reembolso, IMPORTE);
+  });
+});
+
+test("un gestor exime de la penalización con un motivo de al menos 10 caracteres", async () => {
+  await conApi("2026-11-24T21:30", async (api) => {
+    const reserva = await reservar(api, INICIO);
+    const motivo = "Aviso médico del socio";
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo },
+    });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada.cuerpo.reserva.motivoCancelacion, motivo);
+    assert.equal(cancelada.cuerpo.reembolso, IMPORTE);
+  });
+});
+
+test("la exención con motivo ausente o corto es DATOS_INVALIDOS", async () => {
+  await conApi("2026-11-24T21:30", async (api) => {
+    const sinMotivo = await reservar(api, INICIO, "socio-041", "pista-1");
+    const ausente = await api.pedir("POST", `/api/reservas/${sinMotivo.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true },
+    });
+    assert.equal(ausente.status, 400);
+    assert.equal(ausente.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const corto = await reservar(api, INICIO, "socio-003", "pista-2");
+    const demasiadoCorto = await api.pedir("POST", `/api/reservas/${corto.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo: "corto" },
+    });
+    assert.equal(demasiadoCorto.status, 400);
+    assert.equal(demasiadoCorto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  });
