+const ZONA_CLUB = "Europe/Madrid";
+const FORMATO_MADRID = new Intl.DateTimeFormat("en-CA", {
+  timeZone: ZONA_CLUB,
+  year: "numeric",
+  month: "2-digit",
+  day: "2-digit",
+  hour: "2-digit",
+  minute: "2-digit",
