+
+function informeEsperado(estado: any, mes: string) {
+  const delMes = estado.reservas.filter((r: any) => r.inicio.slice(0, 7) === mes);
+  const pistas = [...estado.pistas]
+    .sort((a: any, b: any) => a.id.localeCompare(b.id))
+    .map((p: any) => {
+      const propias = delMes.filter((r: any) => r.pistaId === p.id);
+      const reservas = propias.filter((r: any) => r.estado === "confirmada" || r.estado === "no_presentada");
+      const ingresos = reservas.reduce((suma: number, r: any) => suma + r.importe, 0);
+      const penalizaciones = propias
+        .filter((r: any) => r.estado === "cancelada")
+        .reduce((suma: number, r: any) => suma + (r.penalizacion ?? 0), 0);
+      return { pistaId: p.id, reservas: reservas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    });
+  const total = {
+    reservas: pistas.reduce((suma, p) => suma + p.reservas, 0),
+    ingresos: pistas.reduce((suma, p) => suma + p.ingresos, 0),
+    penalizaciones: pistas.reduce((suma, p) => suma + p.penalizaciones, 0),
+    total: pistas.reduce((suma, p) => suma + p.total, 0),
+  };
+  return { mes, pistas, total };
+}
+
+test("el informe de caja cuenta reservas y penalizaciones por pista", async () => {
+  const api = await arrancarApi();
+  try {
+    const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+    assert.deepEqual(informe.cuerpo, informeEsperado(antes, "2026-11"));
+    assert.deepEqual(informe.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+    assert.equal(informe.cuerpo.total.penalizaciones, 0);
+
+    // Cancelar fuera de plazo una reserva de noviembre suma su penalización y quita sus ingresos.
+    const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+    const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+    const informeDespues = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-040" });
+    assert.deepEqual(informeDespues.cuerpo, informeEsperado(despues, "2026-11"));
+    const pista3 = informeDespues.cuerpo.pistas.find((p: any) => p.pistaId === "pista-3")!;
+    assert.equal(pista3.penalizaciones, 600);
+    assert.equal(pista3.total, informe.cuerpo.pistas.find((p: any) => p.pistaId === "pista-3")!.total - 600);
+  } finally {
+    api.cerrar();
+  }
+});
