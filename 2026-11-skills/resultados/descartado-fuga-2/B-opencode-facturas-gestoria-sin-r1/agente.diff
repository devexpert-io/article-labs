+
+test("8. consultar facturas por mes y por número", async () => {
+  await conApi(async (api) => {
+    let r = await api.pedir("GET", "/api/facturas?mes=2026-05", { socio: GESTOR });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo.facturas, []);
+
+    const gen = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    r = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.deepEqual(r.cuerpo.facturas, gen.cuerpo.facturas);
+
+    const primera = gen.cuerpo.facturas[0];
+    r = await api.pedir("GET", `/api/facturas/${primera.numero}`, { socio: GESTOR });
+    assert.deepEqual(r.cuerpo.factura, primera);
+
+    r = await api.pedir("GET", "/api/facturas/F9999-0001", { socio: GESTOR });
+    assert.equal(r.status, 404);
+    assert.equal(r.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  });
+});
+
