+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+
+    const r3 = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-02-10T10:30" } });
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-03-01T10:00" } });
+
+    const gen = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-02" }, socio: GESTOR });
+    const factura = gen.cuerpo.facturas.find((f: { socioId: string }) => f.socioId === "socio-041");
+    assert.deepEqual(factura.lineas, [
+      { reservaId: r1.cuerpo.reserva.id, concepto: "Penalización", importe: 1800 },
+      { reservaId: r3.cuerpo.reserva.id, concepto: "Reserva", importe: 1800 },
+    ]);
+  });
+});
+
+test("5. total, base e IVA: 6.400 céntimos dan base 5.289 e IVA 1.111", async () => {
+  await conApi(async (api) => {
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-01-01T10:00" } });
+    await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-01-05T10:30" } });
+    await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-01-05T12:00" } });
+    await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-01-05T18:00" } });
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-02-01T10:00" } });
+
+    const gen = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-01" }, socio: GESTOR });
+    const factura = gen.cuerpo.facturas.find((f: { socioId: string }) => f.socioId === "socio-041");
+    assert.deepEqual(factura.lineas.map((l: { importe: number }) => l.importe), [1800, 1800, 2800]);
+    assert.equal(factura.total, 6400);
+    assert.equal(factura.base, 5289);
+    assert.equal(factura.iva, 1111);
+    assert.equal(factura.base + factura.iva, factura.total);
+  });
+});
+
+test("6. numeración F<año>-NNNN correlativa y por orden de socio", async () => {
+  await conApi(async (api) => {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    const facturas = r.cuerpo.facturas;
+    assert.ok(facturas.length > 0);
+    facturas.forEach((f: { numero: string }, i: number) => {
+      assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
