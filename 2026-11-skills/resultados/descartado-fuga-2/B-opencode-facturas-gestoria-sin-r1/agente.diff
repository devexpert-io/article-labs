+    assert.deepEqual(ids, [...ids].sort());
+  });
+});
+
+test("6b. un mes sin facturas no gasta números", async () => {
+  await conApi(async (api) => {
+    const vacio = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-07" }, socio: GESTOR });
+    assert.equal(vacio.status, 201);
+    assert.deepEqual(vacio.cuerpo.facturas, []);
+    const octubre = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(octubre.cuerpo.facturas[0].numero, "F2026-0001");
+  });
+});
+
+test("6c. numeración entre meses y años: diciembre generado en enero", async () => {
+  await conApi(async (api) => {
+    const octubre = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    const n = octubre.cuerpo.facturas.length;
+    assert.ok(n > 0);
+
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T10:00" } });
+    await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-05T10:30" } });
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-15T10:00" } });
+
+    const diciembre = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+    assert.equal(diciembre.cuerpo.facturas[0].numero, `F2026-${String(n + 1).padStart(4, "0")}`);
