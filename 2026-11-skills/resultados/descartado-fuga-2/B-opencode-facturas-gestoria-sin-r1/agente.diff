@@ -0,0 +1,213 @@
+// Facturas mensuales de la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("1. permisos: solo un gestor genera y consulta facturas", async () => {
+  await conApi(async (api) => {
+    for (const peticion of [
+      () => api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } }),
+      () => api.pedir("GET", "/api/facturas?mes=2026-10"),
+      () => api.pedir("GET", "/api/facturas/F2026-0001"),
+    ]) {
+      const r = await peticion();
+      assert.equal(r.status, 401);
+      assert.equal(r.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    }
+    for (const peticion of [
+      () => api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" }),
+      () => api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" }),
+      () => api.pedir("GET", "/api/facturas/F2026-0001", { socio: "socio-001" }),
+    ]) {
+      const r = await peticion();
+      assert.equal(r.status, 403);
+      assert.equal(r.cuerpo.error.codigo, "SIN_PERMISO");
+    }
+  });
+});
+
+test("2. mes con formato AAAA-MM y que ya ha terminado", async () => {
+  await conApi(async (api) => {
+    for (const mes of ["2026-13", "2026-1", "octubre", undefined]) {
+      const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+      assert.equal(r.status, 400);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    for (const mes of ["2026-11", "2026-12"]) {
+      const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+      assert.equal(r.status, 409);
+      assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+    }
+  });
+});
+
+test("3. una factura por socio con algo que facturar, ordenadas por id", async () => {
+  await conApi(async (api) => {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(r.status, 201);
+    const ids = r.cuerpo.facturas.map((f: { socioId: string }) => f.socioId);
+    assert.deepEqual(ids, [...ids].sort());
+    assert.equal(new Set(ids).size, ids.length);
+
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const esperados = estado.socios
+      .filter((s: { id: string }) =>
+        estado.reservas.some(
+          (rv: { socioId: string; inicio: string; estado: string; penalizacion?: number }) =>
+            rv.socioId === s.id && rv.inicio.startsWith("2026-10") && (rv.estado !== "cancelada" || (rv.penalizacion ?? 0) > 0)))
+      .map((s: { id: string }) => s.id)
+      .sort();
+    assert.deepEqual(ids, esperados);
+  });
+});
+
+test("4. líneas ordenadas por inicio, con reservaId, concepto e importe", async () => {
+  await conApi(async (api) => {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    for (const factura of r.cuerpo.facturas) {
+      const inicios = factura.lineas.map((l: { reservaId: string }) =>
+        estado.reservas.find((rv: { id: string }) => rv.id === l.reservaId)!.inicio);
+      for (let i = 1; i < inicios.length; i++) assert.ok(inicios[i - 1]! <= inicios[i]!, "ordenadas por inicio");
+      for (const linea of factura.lineas) {
+        assert.equal(typeof linea.reservaId, "string");
+        assert.ok(["Reserva", "Penalización"].includes(linea.concepto));
+        assert.equal(typeof linea.importe, "number");
+      }
+    }
+  });
+});
+
+test("4b. la penalización entra con concepto Penalización y la cancelación gratuita no entra", async () => {
+  await conApi(async (api) => {
