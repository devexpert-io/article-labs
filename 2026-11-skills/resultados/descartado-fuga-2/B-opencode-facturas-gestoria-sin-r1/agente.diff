+    assert.equal(segunda.status, 200);
+    assert.deepEqual(segunda.cuerpo.facturas, primera.cuerpo.facturas);
+    const listado = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.equal(listado.cuerpo.facturas.length, primera.cuerpo.facturas.length);
