@@ -0,0 +1,150 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Factura, Reserva } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+const generar = (api: Api, mes: unknown) => api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+const reloj = (api: Api, ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+
+async function conApi(probar: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try { await probar(api); } finally { api.cerrar(); }
+}
+
+test("facturas: generar y ambas consultas requieren un gestor", async () => conApi(async (api) => {
+  for (const [metodo, ruta] of [["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/2026-0001"]]) {
+    for (const socio of [undefined, "socio-999", "socio-001", gestor]) {
+      const r = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      if (socio === gestor) assert.ok(r.status < 300);
+      else {
+        assert.equal(r.status, socio === "socio-001" ? 403 : 401);
+        assert.equal(r.cuerpo.error.codigo, socio === "socio-001" ? "SIN_PERMISO" : "NO_IDENTIFICADO");
+      }
+    }
+  }
+}));
+
+test("facturas: valida mes, usa el reloj del club y no consume números al fallar o consultar", async () => conApi(async (api) => {
+  for (const mes of [undefined, null, 202610, {}, "", "2026-1", "26-10", "2026-00", "2026-13", "2026-10-01", "2026-10\n"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const consulta = await api.pedir("GET", `/api/facturas?mes=${encodeURIComponent(String(mes))}`, { socio: gestor });
+    assert.equal(consulta.status, 400);
+    assert.equal(consulta.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas", { socio: gestor })).status, 400);
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+    assert.deepEqual((await api.pedir("GET", `/api/facturas?mes=${mes}`, { socio: gestor })).cuerpo, { facturas: [] });
+  }
+  await reloj(api, "2026-10-31T23:59");
+  assert.equal((await generar(api, "2026-10")).status, 409);
+  await reloj(api, "2026-11-01T00:00");
+  const octubre = await generar(api, "2026-10");
+  assert.equal(octubre.status, 201);
+  assert.equal(octubre.cuerpo.facturas[0].numero, "2026-0001");
+}));
+
+test("facturas: octubre incluye todo el historial facturable, ordenado, con IVA sobre el total", async () => conApi(async (api) => {
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+  const reservas: Reserva[] = antes.reservas.filter((r: Reserva) => r.inicio.startsWith("2026-10"));
+  assert.equal(reservas.length, 315);
+  assert.ok(reservas.some((r) => r.estado === "no_presentada"));
+  assert.ok(reservas.some((r) => r.estado === "cancelada"));
+  const r = await generar(api, "2026-10");
+  assert.equal(r.status, 201);
+  assert.deepEqual(Object.keys(r.cuerpo), ["facturas"]);
+  const facturas: Factura[] = r.cuerpo.facturas;
+  const socios = [...new Set(reservas.filter((r) => r.estado !== "cancelada").map((r) => r.socioId))].sort();
+  assert.deepEqual(facturas.map((f) => f.socioId), socios);
+  assert.ok(!socios.includes("socio-041"));
+  let diferenciaRedondeo = false;
+  for (const [i, f] of facturas.entries()) {
+    const propias = reservas.filter((r) => r.socioId === f.socioId && r.estado !== "cancelada")
+      .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+    assert.deepEqual(f.lineas, propias.map((r) => ({ reservaId: r.id, concepto: r.estado === "no_presentada" ? "No presentada" : "Reserva", importe: r.importe })));
+    assert.equal(f.numero, `2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.mes, "2026-10");
+    assert.equal(f.total, propias.reduce((suma, r) => suma + r.importe, 0));
+    assert.equal(f.base, Math.round(f.total / 1.21));
+    assert.equal(f.iva, f.total - f.base);
+    assert.ok(Number.isInteger(f.base) && Number.isInteger(f.iva));
+    if (f.base !== propias.reduce((suma, r) => suma + Math.round(r.importe / 1.21), 0)) diferenciaRedondeo = true;
+  }
+  assert.ok(diferenciaRedondeo, "el historial distingue redondear por factura de redondear por línea");
+  const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.deepEqual(despues.reservas, antes.reservas);
+  assert.deepEqual(despues.socios, antes.socios);
+  assert.deepEqual(despues.pistas, antes.pistas);
+  assert.equal(despues.contador, antes.contador);
+}));
+
+test("facturas: penalizaciones, cancelaciones gratuitas y asignación al mes de inicio", async () => conApi(async (api) => {
+  await reloj(api, "2026-11-30T10:00");
+  async function crear(inicio: string, pistaId: string) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId, inicio } });
+    assert.equal(r.status, 201);
+    return r.cuerpo.reserva as Reserva;
+  }
+  const penalizada = await crear("2026-12-01T09:00", "pista-3");
+  const gratis = await crear("2026-12-02T09:00", "pista-1");
+  const confirmada = await crear("2026-12-03T09:00", "pista-1");
+  const cancelada = await api.pedir("POST", `/api/reservas/${penalizada.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1200);
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`)).status, 200);
+  await reloj(api, "2026-12-01T00:00");
+  assert.ok(!(await generar(api, "2026-11")).cuerpo.facturas.some((f: Factura) => f.socioId === "socio-041"));
+  await reloj(api, "2027-01-01T00:00");
+  const diciembre = await generar(api, "2026-12");
+  assert.equal(diciembre.status, 201);
+  assert.equal(diciembre.cuerpo.facturas.length, 1);
+  const f: Factura = diciembre.cuerpo.facturas[0];
+  assert.deepEqual(f.lineas, [
+    { reservaId: penalizada.id, concepto: "Penalización", importe: 1200 },
+    { reservaId: confirmada.id, concepto: "Reserva", importe: 1800 },
+  ]);
+  assert.equal(f.total, 3000);
+  assert.equal(f.base, 2479);
+  assert.equal(f.iva, 521);
+  const pasada = await api.pedir("POST", `/api/reservas/${confirmada.id}/cancelar`);
+  assert.equal(pasada.status, 409);
+  assert.equal(pasada.cuerpo.error.codigo, "RESERVA_PASADA");
+  assert.deepEqual((await generar(api, "2026-12")).cuerpo, diciembre.cuerpo);
+}));
+
+test("facturas: consultas, repetición concurrente, meses vacíos y numeración entre meses y años", async () => conApi(async (api) => {
+  const vacio = await generar(api, "2026-09");
+  assert.equal(vacio.status, 201);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  assert.equal((await generar(api, "2026-09")).status, 200);
+  const resultados = await Promise.all([generar(api, "2026-10"), generar(api, "2026-10")]);
+  assert.deepEqual(resultados.map((r) => r.status).sort(), [200, 201]);
+  const octubre = resultados[0].cuerpo;
+  assert.deepEqual(resultados[1].cuerpo, octubre);
+  assert.equal(octubre.facturas[0].numero, "2026-0001");
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).cuerpo, octubre);
+  for (const f of octubre.facturas) {
+    const consulta = await api.pedir("GET", `/api/facturas/${f.numero}`, { socio: gestor });
+    assert.equal(consulta.status, 200);
+    assert.deepEqual(consulta.cuerpo, { factura: f });
+  }
+  const inexistente = await api.pedir("GET", "/api/facturas/2026-9999", { socio: gestor });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  await reloj(api, "2027-01-01T00:00");
+  const nueva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-02T09:00" } });
+  assert.equal(nueva.status, 201);
+  await reloj(api, "2027-02-01T00:00");
+  const enero = await generar(api, "2027-01");
+  assert.equal(enero.cuerpo.facturas[0].numero, "2027-0001");
+  const noviembre = await generar(api, "2026-11");
+  assert.equal(noviembre.cuerpo.facturas[0].numero, `2026-${String(octubre.facturas.length + 1).padStart(4, "0")}`);
+  assert.deepEqual((await generar(api, "2026-10")).cuerpo, octubre);
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.contadorFacturasPorAno["2026"], octubre.facturas.length + noviembre.cuerpo.facturas.length);
+  assert.equal(estado.contadorFacturasPorAno["2027"], 1);
+}));
