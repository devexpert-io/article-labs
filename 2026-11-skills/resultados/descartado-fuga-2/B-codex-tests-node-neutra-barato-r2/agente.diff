+function instanteMadrid(fechaHora: string): number {
+  const objetivo = Date.parse(`${fechaHora}:00Z`);
+  const formato = new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", second: "2-digit", hourCycle: "h23" });
+  let estimado = objetivo;
+  for (let i = 0; i < 2; i++) {
+    const partes = Object.fromEntries(formato.formatToParts(estimado).map((p) => [p.type, p.value]));
+    const mostrado = Date.UTC(Number(partes.year), Number(partes.month) - 1, Number(partes.day), Number(partes.hour), Number(partes.minute), Number(partes.second));
+    estimado += objetivo - mostrado;
+  }
+  return estimado;
+}
