+function instanteMadrid(fechaHora: string): number {
+  const [fecha, hora] = fechaHora.split("T");
+  const [anyo, mes, dia] = fecha!.split("-").map(Number);
+  const [hh, mm] = hora!.split(":").map(Number);
+  // Busca el instante UTC cuya representación en Europe/Madrid coincide con el texto local.
+  const objetivo = Date.UTC(anyo!, mes! - 1, dia!, hh!, mm!);
+  let candidato = objetivo;
+  const formato = new Intl.DateTimeFormat("en-CA", {
+    timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit",
+    hour: "2-digit", minute: "2-digit", hourCycle: "h23",
+  });
+  for (let i = 0; i < 3; i++) {
+    const partes = Object.fromEntries(formato.formatToParts(new Date(candidato)).map((p) => [p.type, p.value]));
+    const mostrado = Date.UTC(Number(partes.year), Number(partes.month) - 1, Number(partes.day), Number(partes.hour), Number(partes.minute));
+    candidato += objetivo - mostrado;
+  }
+  return candidato;
+}
+
 function horasEntre(desde: string, hasta: string): number {
-  return (Date.parse(`${hasta}:00Z`) - Date.parse(`${desde}:00Z`)) / 3_600_000;
+  return (instanteMadrid(hasta) - instanteMadrid(desde)) / 3_600_000;
 }
 
