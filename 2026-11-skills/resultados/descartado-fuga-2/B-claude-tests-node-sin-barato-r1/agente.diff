+test("informe de caja: una entrada por pista, también las vacías, y cifras del mes", async () => {
+  await conClub("2026-11-18T10:00", async (api) => {
+    // Un mes sin movimientos: todas las pistas, a cero.
+    const vacio = await api.pedir("GET", "/api/informes/caja?mes=2030-01", { socio: GESTOR });
+    assert.equal(vacio.status, 200);
+    assert.deepEqual(vacio.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+    assert.deepEqual(vacio.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+
+    // Las cifras se comprueban contra el estado completo del club.
+    const informe = async (mes: string) => (await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: GESTOR })).cuerpo;
+    const esperado = (estado: any, mes: string) => {
+      const pistas = [...estado.pistas].sort((a: any, b: any) => (a.id < b.id ? -1 : 1)).map((p: any) => {
+        const delMes = estado.reservas.filter((r: any) => r.pistaId === p.id && r.inicio.startsWith(mes));
+        const cobradas = delMes.filter((r: any) => r.estado !== "cancelada");
+        const ingresos = cobradas.reduce((s: number, r: any) => s + r.importe, 0);
+        const penalizaciones = delMes.reduce((s: number, r: any) => s + (r.penalizacion ?? 0), 0);
+        return { pistaId: p.id, reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+      });
+      const total = Object.fromEntries(["reservas", "ingresos", "penalizaciones", "total"].map((k) => [k, pistas.reduce((s: number, p: any) => s + p[k], 0)]));
+      return { pistas, total };
+    };
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    for (const mes of ["2026-10", "2026-11"]) {
+      const cuerpo = await informe(mes);
+      assert.equal(cuerpo.mes, mes);
+      assert.deepEqual(cuerpo.pistas, esperado(estado, mes).pistas, mes);
+      assert.deepEqual(cuerpo.total, esperado(estado, mes).total, mes);
+    }
+
+    // Cancelar con penalización cambia la caja: sale de ingresos y entra en penalizaciones.
+    const antes = await informe("2026-11");
+    const cancelada = await cancelar(api, "R-0520", { forzar: true });
+    assert.equal(cancelada.status, 200);
+    const despues = await informe("2026-11");
+    const pista3 = (c: any) => c.pistas.find((p: any) => p.pistaId === "pista-3");
+    assert.equal(pista3(antes).ingresos - pista3(despues).ingresos, 1200);
+    assert.equal(pista3(despues).penalizaciones, 600);
+    assert.equal(despues.total.penalizaciones, antes.total.penalizaciones + 600);
+    assert.equal(despues.total.reservas, antes.total.reservas - 1);
+    assert.equal(despues.total.total, despues.total.ingresos + despues.total.penalizaciones);
+  });
+});
