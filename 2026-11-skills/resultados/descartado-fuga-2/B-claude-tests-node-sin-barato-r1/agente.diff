+// Política de cancelación escalonada, exención de gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const SOCIO = "socio-041"; // Nora Benítez: cuota al día y sin reservas.
+const GESTOR = "socio-040"; // La recepción del club.
+
+/** Arranca la API con el reloj en `ahora`, ejecuta la prueba y la cierra. */
+async function conClub(ahora: string, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reservar(api: Api, pistaId: string, inicio: string, socioId = SOCIO): Promise<any> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+}
+
+const cancelar = (api: Api, id: string, cuerpo?: unknown, socio?: string) =>
+  api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+
+test("tramos: sin penalización con 48 horas o más", async () => {
+  await conClub("2026-11-18T09:00", async (api) => {
+    // 48 horas justas: no hay penalización.
+    const justas = await reservar(api, "pista-1", "2026-11-20T09:00");
+    const r = await cancelar(api, justas.id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.estado, "cancelada");
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(r.cuerpo.reembolso, justas.importe);
+    // Más de 48 horas.
+    const lejos = await reservar(api, "pista-2", "2026-11-22T12:00");
+    const lejana = await cancelar(api, lejos.id);
+    assert.equal(lejana.cuerpo.reembolso, lejos.importe);
+  });
+});
+
+test("tramos: entre 24 y 48 horas, 25 % del importe sin forzar", async () => {
+  // 47,5 horas: ya no es gratis.
+  await conClub("2026-11-18T09:30", async (api) => {
+    const reserva = await reservar(api, "pista-1", "2026-11-20T09:00");
+    const r = await cancelar(api, reserva.id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, Math.round(reserva.importe * 0.25));
+    assert.equal(r.cuerpo.reembolso, reserva.importe - Math.round(reserva.importe * 0.25));
+  });
+});
+
+test("límites: a 24 horas justas se aplica el 25 % sin forzar", async () => {
+  await conClub("2026-11-18T09:00", async (api) => {
+    const reserva = await reservar(api, "pista-1", "2026-11-19T09:00");
+    const r = await cancelar(api, reserva.id);
+    assert.equal(r.status, 200, JSON.stringify(r.cuerpo));
+    assert.equal(r.cuerpo.reserva.penalizacion, reserva.importe / 4);
+    assert.equal(r.cuerpo.reembolso, reserva.importe * 3 / 4);
+  });
+});
+
+test("tramos: menos de 24 horas, solo con forzar y 50 %", async () => {
+  await conClub("2026-11-18T09:30", async (api) => {
+    const reserva = await reservar(api, "pista-1", "2026-11-19T09:00"); // 23,5 horas
+    const sin = await cancelar(api, reserva.id);
+    assert.equal(sin.status, 409);
+    assert.equal(sin.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const falso = await cancelar(api, reserva.id, { forzar: false });
+    assert.equal(falso.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await cancelar(api, reserva.id, { forzar: true });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, reserva.importe / 2);
+    assert.equal(forzada.cuerpo.reembolso, reserva.importe / 2);
+  });
+});
+
+test("cambio de hora: las horas se cuentan reales en Madrid", async () => {
+  // El domingo 28 de marzo de 2027 se adelanta el reloj: de 20:00 del viernes a 21:00 del domingo hay 48 horas reales.
+  await conClub("2027-03-26T20:00", async (api) => {
+    const reserva = await reservar(api, "pista-1", "2027-03-28T21:00");
+    const r = await cancelar(api, reserva.id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined, "48 horas reales: sin penalización");
+  });
+  // Del viernes a las 20:30 al domingo a las 21:00 hay 47,5 horas reales: ya hay penalización.
+  await conClub("2027-03-26T20:30", async (api) => {
+    const reserva = await reservar(api, "pista-1", "2027-03-28T21:00");
+    const r = await cancelar(api, reserva.id);
+    assert.equal(r.cuerpo.reserva.penalizacion, Math.round(reserva.importe * 0.25));
+  });
+  // Con el reloj del club a 21:00 del viernes, el mismo domingo a las 21:00 son 47 horas reales.
+  await conClub("2027-03-26T21:00", async (api) => {
+    const reserva = await reservar(api, "pista-1", "2027-03-28T21:00");
+    const r = await cancelar(api, reserva.id);
+    assert.equal(r.cuerpo.reserva.penalizacion, Math.round(reserva.importe * 0.25));
+  });
+});
+
+test("exención: un gestor cancela sin penalización con motivo, sin forzar", async () => {
+  await conClub("2026-11-18T09:30", async (api) => {
+    // Dentro de las 24 horas: aun así, sin penalización.
+    const reserva = await reservar(api, "pista-1", "2026-11-19T09:00");
+    const r = await cancelar(api, reserva.id, { exento: true, motivo: "Lesión de un jugador" }, GESTOR);
+    assert.equal(r.status, 200, JSON.stringify(r.cuerpo));
+    assert.equal(r.cuerpo.reserva.estado, "cancelada");
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(r.cuerpo.reserva.motivoCancelacion, "Lesión de un jugador");
+    assert.equal(r.cuerpo.reembolso, reserva.importe);
+  });
+});
+
+test("exención: validaciones del motivo y de quien lo pide", async () => {
