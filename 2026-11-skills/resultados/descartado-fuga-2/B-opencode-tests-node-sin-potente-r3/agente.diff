+test("el informe de caja cuenta las no presentadas como ingreso", async () => {
+  const api = await arrancarApi();
+  try {
+    const estado = await api.pedir("GET", "/_estado");
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-040" });
+
+    const delMes = estado.cuerpo.reservas.filter((r: { inicio: string }) => r.inicio.startsWith("2026-11"));
+    const cobradas = delMes.filter((r: { estado: string }) => r.estado !== "cancelada");
+    const ingresos = cobradas.reduce((suma: number, r: { importe: number }) => suma + r.importe, 0);
+    const penalizaciones = delMes
+      .filter((r: { estado: string }) => r.estado === "cancelada")
+      .reduce((suma: number, r: { penalizacion?: number }) => suma + (r.penalizacion ?? 0), 0);
+
+    assert.deepEqual(informe.cuerpo.total, {
+      reservas: cobradas.length,
+      ingresos,
+      penalizaciones,
+      total: ingresos + penalizaciones,
+    });
+  } finally {
+    api.cerrar();
+  }
+});
