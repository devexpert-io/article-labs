+++ b/test/reembolsos.test.ts
@@ -0,0 +1,221 @@
+// La política de cancelación escalonada, la exención y el informe de caja, probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function crearReserva(api: Api, inicio: string, pistaId = "pista-1", socioId = "socio-041") {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(respuesta.status, 201, JSON.stringify(respuesta.cuerpo));
+  return respuesta.cuerpo.reserva as { id: string; importe: number };
+}
+
+test("cancelar aplica la penalización escalonada por tramos", async () => {
+  const api = await arrancarApi();
+  try {
+    // Con 48 horas o más de antelación: sin penalización.
+    const lejos = await crearReserva(api, "2026-12-10T12:00", "pista-1");
+    const gratis = await api.pedir("POST", `/api/reservas/${lejos.id}/cancelar`);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, lejos.importe);
+
+    // Entre 24 y 48 horas: 25 % del importe, sin forzar.
+    const parcial = await crearReserva(api, "2026-12-11T18:00", "pista-1");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-10T12:00" } });
+    const al25 = await api.pedir("POST", `/api/reservas/${parcial.id}/cancelar`);
+    assert.equal(al25.status, 200);
+    assert.equal(al25.cuerpo.reserva.penalizacion, parcial.importe * 0.25);
+    assert.equal(al25.cuerpo.reembolso, parcial.importe * 0.75);
+
+    // Con menos de 24 horas: exige forzar y penaliza el 50 %.
+    const tarde = await crearReserva(api, "2026-12-11T21:00", "pista-2");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-11T19:00" } });
+    const sinForzar = await api.pedir("POST", `/api/reservas/${tarde.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${tarde.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, tarde.importe * 0.5);
+    assert.equal(forzada.cuerpo.reembolso, tarde.importe * 0.5);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("los límites exactos de 48 y 24 horas", async () => {
+  const api = await arrancarApi();
+  try {
+    // A 48 horas justas no hay penalización.
+    const a48 = await crearReserva(api, "2026-12-10T12:00", "pista-1");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-08T12:00" } });
+    const gratis = await api.pedir("POST", `/api/reservas/${a48.id}/cancelar`);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+
+    // A 24 horas justas se aplica el 25 % y no hace falta forzar.
+    const a24 = await crearReserva(api, "2026-12-11T12:00", "pista-1");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-10T12:00" } });
+    const parcial = await api.pedir("POST", `/api/reservas/${a24.id}/cancelar`);
+    assert.equal(parcial.cuerpo.reserva.penalizacion, a24.importe * 0.25);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("la antelación se cuenta en horas reales de Madrid, con el cambio de hora", async () => {
+  const api = await arrancarApi({ AHORA: "2027-03-26T20:30" });
+  try {
+    // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales, no 48,5.
+    const reserva = await crearReserva(api, "2027-03-28T21:00", "pista-1");
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, reserva.importe * 0.25);
+    assert.equal(cancelada.cuerpo.reembolso, reserva.importe * 0.75);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("un gestor puede eximir la penalización con motivo", async () => {
+  const api = await arrancarApi();
+  try {
+    const reserva = await crearReserva(api, "2026-11-24T12:00", "pista-1");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-24T10:00" } }); // faltan 2 horas
+
+    // Sin identificarse: 401.
+    const anonimo = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "El socio avisó con tiempo suficiente por teléfono" },
+    });
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    // Un socio que no es gestor: 403.
+    const socio = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "El socio avisó con tiempo suficiente por teléfono" },
+      socio: "socio-003",
+    });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    // Motivo corto o ausente: 400.
+    const corto = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "corto" },
+      socio: "socio-040",
+    });
+    assert.equal(corto.status, 400);
+    assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const sinMotivo = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true },
+      socio: "socio-040",
+    });
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // Gestor con motivo válido: cancela sin penalización y guarda el motivo.
+    const exenta = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "El socio avisó con tiempo suficiente por teléfono" },
+      socio: "socio-040",
+    });
+    assert.equal(exenta.status, 200);
+    assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "El socio avisó con tiempo suficiente por teléfono");
+    assert.equal(exenta.cuerpo.reembolso, reserva.importe);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("una reserva que ya ha empezado no se cancela, ni con exento", async () => {
+  const api = await arrancarApi();
+  try {
+    const reserva = await crearReserva(api, "2026-12-10T12:00", "pista-1");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-10T12:00" } });
+
+    const pasada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(pasada.status, 409);
+    assert.equal(pasada.cuerpo.error.codigo, "RESERVA_PASADA");
+
+    const exenta = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "El socio avisó con tiempo suficiente por teléfono" },
+      socio: "socio-040",
+    });
+    assert.equal(exenta.status, 409);
+    assert.equal(exenta.cuerpo.error.codigo, "RESERVA_PASADA");
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("el informe de caja es solo para gestores y valida el mes", async () => {
+  const api = await arrancarApi();
+  try {
+    const anonimo = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
