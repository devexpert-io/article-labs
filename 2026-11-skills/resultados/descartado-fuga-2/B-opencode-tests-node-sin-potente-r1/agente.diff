+// La política escalonada de cancelación, la exención y el informe de caja, probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const abiertas: Api[] = [];
+async function club(ahora: string): Promise<Api> {
+  const api = await arrancarApi({ AHORA: ahora });
+  abiertas.push(api);
+  return api;
+}
+after(() => {
+  for (const api of abiertas) api.cerrar();
+});
+
+function crear(api: Api, socioId: string, pistaId: string, inicio: string) {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+}
+
+test("tramos: 48h o más gratis, entre 24 y 48 el 25 %, y menos de 24 el 50 % solo con forzar", async () => {
+  const api = await club("2027-06-01T09:00");
+
+  // 72 horas de antelación: sin penalización.
+  const lejos = await crear(api, "socio-001", "pista-1", "2027-06-04T09:00");
+  const cLejos = await api.pedir("POST", `/api/reservas/${lejos.cuerpo.reserva.id}/cancelar`);
+  assert.equal(cLejos.status, 200);
+  assert.equal(cLejos.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(cLejos.cuerpo.reembolso, 1800);
+
+  // 27 horas de antelación: 25 % del importe.
+  const media = await crear(api, "socio-001", "pista-1", "2027-06-02T12:00");
+  const cMedia = await api.pedir("POST", `/api/reservas/${media.cuerpo.reserva.id}/cancelar`);
+  assert.equal(cMedia.cuerpo.reserva.penalizacion, 450);
+  assert.equal(cMedia.cuerpo.reembolso, 1350);
+
+  // 12 horas de antelación: sin forzar es FUERA_DE_PLAZO; con forzar, el 50 %.
+  const corta = await crear(api, "socio-001", "pista-1", "2027-06-01T21:00");
+  const sinForzar = await api.pedir("POST", `/api/reservas/${corta.cuerpo.reserva.id}/cancelar`);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await api.pedir("POST", `/api/reservas/${corta.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1400);
+  assert.equal(forzada.cuerpo.reembolso, 1400);
+});
+
+test("límites exactos: a 48 horas justas no hay penalización y a 24 justas se aplica el 25 %", async () => {
+  const api = await club("2027-06-01T09:00");
+
+  const a48 = await crear(api, "socio-001", "pista-1", "2027-06-03T09:00");
+  const c48 = await api.pedir("POST", `/api/reservas/${a48.cuerpo.reserva.id}/cancelar`);
+  assert.equal(c48.status, 200);
+  assert.equal(c48.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(c48.cuerpo.reembolso, 1800);
+
+  const a24 = await crear(api, "socio-001", "pista-1", "2027-06-02T09:00");
+  const c24 = await api.pedir("POST", `/api/reservas/${a24.cuerpo.reserva.id}/cancelar`);
+  assert.equal(c24.status, 200);
+  assert.equal(c24.cuerpo.reserva.penalizacion, 450);
+  assert.equal(c24.cuerpo.reembolso, 1350);
+});
+
+test("cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  const api = await club("2027-03-26T20:30");
+  // Del viernes 20:30 al domingo 21:00 hay 47,5 horas reales (esa madrugada se adelanta una hora).
+  const r = await crear(api, "socio-001", "pista-1", "2027-03-28T21:00");
+  assert.equal(r.status, 201);
+  const c = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+  assert.equal(c.status, 200);
+  assert.equal(c.cuerpo.reserva.penalizacion, 700);
+  assert.equal(c.cuerpo.reembolso, 2100);
+});
+
+test("exención: solo un gestor, con motivo de 10 caracteres o más, y sin penalización", async () => {
+  const api = await club("2027-06-01T09:00");
+  const r = await crear(api, "socio-001", "pista-1", "2027-06-01T21:00");
+  const id = r.cuerpo.reserva.id;
+
+  const sinId = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { exento: true, motivo: "Motivo suficientemente largo" } });
+  assert.equal(sinId.status, 401);
+  assert.equal(sinId.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const noGestor = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { exento: true, motivo: "Motivo suficientemente largo" }, socio: "socio-001" });
