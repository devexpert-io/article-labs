+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const sinMotivo = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { exento: true }, socio: "socio-040" });
+  assert.equal(sinMotivo.status, 400);
+  assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const motivoCorto = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { exento: true, motivo: "corto" }, socio: "socio-040" });
+  assert.equal(motivoCorto.status, 400);
+  assert.equal(motivoCorto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const ok = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { exento: true, motivo: "Compensación acordada con el socio" }, socio: "socio-040" });
+  assert.equal(ok.status, 200);
+  assert.equal(ok.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(ok.cuerpo.reserva.motivoCancelacion, "Compensación acordada con el socio");
+  assert.equal(ok.cuerpo.reembolso, 2800);
+});
+
+test("una reserva que ya ha empezado no se cancela, tampoco con exento", async () => {
+  const api = await club("2027-06-01T09:00");
+  const r = await crear(api, "socio-001", "pista-1", "2027-06-01T12:00");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-06-01T12:30" } });
+
+  const normal = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`);
+  assert.equal(normal.status, 409);
+  assert.equal(normal.cuerpo.error.codigo, "RESERVA_PASADA");
+
+  const exento = await api.pedir("POST", `/api/reservas/${r.cuerpo.reserva.id}/cancelar`, { cuerpo: { exento: true, motivo: "Motivo suficientemente largo" }, socio: "socio-040" });
+  assert.equal(exento.status, 409);
+  assert.equal(exento.cuerpo.error.codigo, "RESERVA_PASADA");
+});
+
+test("informe de caja: por mes, por pista, con totales y solo para gestores", async () => {
+  const api = await club("2027-06-01T09:00");
+
+  const sinId = await api.pedir("GET", "/api/informes/caja?mes=2027-06");
+  assert.equal(sinId.status, 401);
+  assert.equal(sinId.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const noGestor = await api.pedir("GET", "/api/informes/caja?mes=2027-06", { socio: "socio-001" });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const mal = await api.pedir("GET", "/api/informes/caja?mes=2027-6", { socio: "socio-040" });
+  assert.equal(mal.status, 400);
+  assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
