diff --git a/test/facturas.test.ts b/test/facturas.test.ts
new file mode 100644
index 0000000..e078b4b
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,172 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Factura, Reserva } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+
+async function iniciar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+function generar(api: Api, mes: unknown) {
+  return api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+}
+
+async function reservar(api: Api, inicio: string, socioId = "socio-041") {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-1", inicio } });
+  assert.equal(respuesta.status, 201, respuesta.texto);
+  return respuesta.cuerpo.reserva as Reserva;
+}
+
+test("facturas: todos los endpoints requieren identidad de gestor", async (t) => {
+  const api = await iniciar(t);
+  for (const [metodo, ruta] of [
+    ["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F2026-0001"],
+  ]) {
+    for (const [socio, status, codigo] of [
+      [undefined, 401, "NO_IDENTIFICADO"], ["socio-999", 401, "NO_IDENTIFICADO"], ["socio-001", 403, "SIN_PERMISO"],
+    ] as const) {
+      const respuesta = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      assert.equal(respuesta.status, status);
+      assert.equal(respuesta.cuerpo.error.codigo, codigo);
+    }
+  }
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.facturas, []);
+});
+
+test("facturas: valida el mes y solo genera meses terminados según el reloj del club", async (t) => {
+  const api = await iniciar(t);
+  for (const mes of [undefined, null, 202610, "", "2026-1", "26-10", "2026-00", "2026-13", "2026-10-01", "2026-10\n"]) {
+    const respuesta = await generar(api, mes);
+    assert.equal(respuesta.status, 400);
+    assert.equal(respuesta.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    if (typeof mes === "string") {
+      const consulta = await api.pedir("GET", `/api/facturas?mes=${encodeURIComponent(mes)}`, { socio: gestor });
+      assert.equal(consulta.status, 400);
+      assert.equal(consulta.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas", { socio: gestor })).status, 400);
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const respuesta = await generar(api, mes);
+    assert.equal(respuesta.status, 409);
+    assert.equal(respuesta.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj(api, "2026-11-30T23:59");
+  assert.equal((await generar(api, "2026-11")).status, 409);
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+});
+
+test("facturas: historial de octubre, líneas ordenadas, importes, consulta e idempotencia", async (t) => {
+  const api = await iniciar(t);
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).cuerpo, { facturas: [] });
+  const reservas: Reserva[] = (await api.pedir("GET", "/_estado")).cuerpo.reservas;
+  const facturables = reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(facturables.some((r) => r.estado === "no_presentada"));
+  const socios = [...new Set(facturables.map((r) => r.socioId))].sort();
+  const respuesta = await generar(api, "2026-10");
+  assert.equal(respuesta.status, 201);
+  const facturas: Factura[] = respuesta.cuerpo.facturas;
+  assert.deepEqual(facturas.map((f) => f.socioId), socios);
+  assert.ok(!socios.includes("socio-041"));
+  for (const [i, factura] of facturas.entries()) {
+    assert.equal(factura.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(factura.mes, "2026-10");
+    const lineas = facturables.filter((r) => r.socioId === factura.socioId)
+      .sort((a, b) => a.inicio.localeCompare(b.inicio))
+      .map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe }));
+    assert.deepEqual(factura.lineas, lineas);
+    assert.equal(factura.total, lineas.reduce((suma, l) => suma + l.importe, 0));
+    assert.equal(factura.base, Math.round(factura.total * 100 / 121));
+    assert.equal(factura.iva, factura.total - factura.base);
+  }
+  const repetida = await generar(api, "2026-10");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo, respuesta.cuerpo);
+  const consulta = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor });
+  assert.equal(consulta.status, 200);
+  assert.deepEqual(consulta.cuerpo, respuesta.cuerpo);
+  const individual = await api.pedir("GET", `/api/facturas/${facturas[0]!.numero}`, { socio: gestor });
+  assert.equal(individual.status, 200);
+  assert.deepEqual(individual.cuerpo, { factura: facturas[0] });
+  const inexistente = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: gestor });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, reservas);
+});
+
+test("facturas: IVA sobre el total de 6400 y líneas por inicio, no por creación", async (t) => {
+  const api = await iniciar(t);
+  const ultima = await reservar(api, "2026-12-03T18:00");
+  const primera = await reservar(api, "2026-12-01T09:00");
+  const segunda = await reservar(api, "2026-12-02T09:00");
+  await reloj(api, "2027-01-01T00:00");
+  const respuesta = await generar(api, "2026-12");
+  assert.equal(respuesta.status, 201);
+  assert.deepEqual(respuesta.cuerpo.facturas, [{
+    numero: "F2026-0001", mes: "2026-12", socioId: "socio-041",
+    lineas: [primera, segunda, ultima].map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })),
+    total: 6400, base: 5289, iva: 1111,
+  }]);
+});
+
+test("facturas: penalizaciones, cancelaciones gratuitas y reservas sin cambios", async (t) => {
+  const api = await iniciar(t);
+  const gratis = await reservar(api, "2026-12-03T09:00");
+  const penalizada = await reservar(api, "2026-12-01T09:00");
+  const cancelacion = await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`);
+  assert.equal(cancelacion.status, 200);
+  assert.equal(cancelacion.cuerpo.reserva.penalizacion, undefined);
+  await reloj(api, "2026-11-30T10:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${penalizada.id}/cancelar`)).cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await api.pedir("POST", `/api/reservas/${penalizada.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1800);
+  await reloj(api, "2027-01-01T00:00");
+  const respuesta = await generar(api, "2026-12");
+  assert.equal(respuesta.status, 201);
+  assert.deepEqual(respuesta.cuerpo.facturas, [{
+    numero: "F2026-0001", mes: "2026-12", socioId: "socio-041",
+    lineas: [{ reservaId: penalizada.id, concepto: "Penalización", importe: 1800 }],
+    total: 1800, base: 1488, iva: 312,
+  }]);
+  assert.deepEqual((await api.pedir("GET", `/api/reservas/${penalizada.id}`)).cuerpo, forzada.cuerpo);
+});
+
+test("facturas: serie anual sin huecos entre meses fuera de orden, vacíos y años", async (t) => {
+  const api = await iniciar(t);
+  await reservar(api, "2026-12-01T09:00");
+  await reservar(api, "2026-12-02T09:00", "socio-002");
+  await reloj(api, "2027-01-01T00:00");
+  const diciembre = await generar(api, "2026-12");
+  assert.equal(diciembre.status, 201);
+  assert.deepEqual(diciembre.cuerpo.facturas.map((f: Factura) => [f.socioId, f.numero]), [
+    ["socio-002", "F2026-0001"], ["socio-041", "F2026-0002"],
+  ]);
+  const vacio = await generar(api, "2026-09");
+  assert.equal(vacio.status, 201);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  assert.equal((await generar(api, "2026-09")).status, 200);
+  const octubre = await generar(api, "2026-10");
+  assert.equal(octubre.cuerpo.facturas[0].numero, "F2026-0003");
+  const repetida = await generar(api, "2026-12");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo, diciembre.cuerpo);
+  const noviembre = await generar(api, "2026-11");
+  assert.equal(noviembre.cuerpo.facturas[0].numero, `F2026-${String(octubre.cuerpo.facturas.length + 3).padStart(4, "0")}`);
+  await reservar(api, "2027-01-04T09:00");
+  await reloj(api, "2027-02-01T00:00");
+  const enero = await generar(api, "2027-01");
+  assert.equal(enero.cuerpo.facturas[0].numero, "F2027-0001");
+  assert.equal(enero.cuerpo.facturas.length, 1);
+  const facturas: Factura[] = (await api.pedir("GET", "/_estado")).cuerpo.facturas;
+  assert.equal(new Set(facturas.map((f) => f.numero)).size, facturas.length);
+});
