+++ b/test/facturas.test.ts
@@ -0,0 +1,183 @@
+// La facturación mensual de la gestoría, probada a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { baseEiva } from "../src/nucleo.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const gestor = "socio-040";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+test("la base y el IVA se calculan sobre el total con medio céntimo hacia arriba", () => {
+  assert.deepEqual(baseEiva(6400), { base: 5289, iva: 1111 });
+  for (const total of [0, 1, 100, 121, 1800, 2800, 6400, 99999]) {
+    const { base, iva } = baseEiva(total);
+    assert.equal(base + iva, total, `base + iva debe cuadrar con el total ${total}`);
+    assert.equal(base, Math.round((total * 100) / 121));
+  }
+});
+
+test("solo un gestor genera y consulta facturas", async () => {
+  const sin = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+  assert.equal(sin.status, 401);
+  assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const socio = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+  assert.equal(socio.status, 403);
+  assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10")).status, 401);
+  assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001", { socio: "socio-001" })).status, 403);
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).status, 200);
+});
+
+test("el mes debe tener el formato AAAA-MM y estar cerrado", async () => {
+  const formato = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026/10" }, socio: gestor });
+  assert.equal(formato.status, 400);
+  assert.equal(formato.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const mesInvalido = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-13" }, socio: gestor });
+  assert.equal(mesInvalido.status, 400);
+  assert.equal(mesInvalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const actual = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: gestor });
+  assert.equal(actual.status, 409);
+  assert.equal(actual.cuerpo.error.codigo, "MES_ABIERTO");
+
+  const futuro = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: gestor });
+  assert.equal(futuro.status, 409);
+  assert.equal(futuro.cuerpo.error.codigo, "MES_ABIERTO");
+});
+
+test("octubre genera una factura por socio, con líneas, totales, IVA y numeración", async () => {
+  const primera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: gestor });
+  assert.equal(primera.status, 201);
+  const facturas: any[] = primera.cuerpo.facturas;
+  assert.ok(facturas.length > 0, "octubre tiene facturas");
+
+  // Una factura por socio, ordenadas por id de socio y sin repetir.
+  const ids = facturas.map((f) => f.socioId);
+  assert.deepEqual(ids, [...ids].sort((a: string, b: string) => a.localeCompare(b)), "ordenadas por id de socio");
+  assert.equal(new Set(ids).size, ids.length, "una factura por socio");
+
+  // La numeración es correlativa por año, empezando en 0001.
+  facturas.forEach((f, i) => {
+    assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.mes, "2026-10");
+  });
+
+  // Cada línea responde a una reserva facturable, ordenada por inicio, y total/base/IVA cuadran.
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const esperadas = new Map<string, any[]>();
+  for (const r of estado.reservas) {
+    if (r.inicio.slice(0, 7) !== "2026-10") continue;
+    if (r.estado === "cancelada" && !(r.penalizacion > 0)) continue;
+    const linea = {
+      reservaId: r.id,
+      concepto: r.estado === "cancelada" ? "Penalización" : "Reserva",
+      importe: r.estado === "cancelada" ? r.penalizacion : r.importe,
+    };
+    if (!esperadas.has(r.socioId)) esperadas.set(r.socioId, []);
+    esperadas.get(r.socioId)!.push(linea);
+  }
+  assert.deepEqual(ids, [...esperadas.keys()].sort((a, b) => a.localeCompare(b)), "solo se factura a quien tiene algo");
+
+  for (const f of facturas) {
+    assert.deepEqual(f.lineas, esperadas.get(f.socioId));
+    const total = f.lineas.reduce((suma: number, l: any) => suma + l.importe, 0);
+    assert.equal(f.total, total);
+    assert.equal(f.base, Math.round((total * 100) / 121));
+    assert.equal(f.iva, total - f.base);
+    assert.equal(f.base + f.iva, f.total);
+  }
+
+  // Volver a generar devuelve las mismas facturas y no crea nuevas.
+  const segunda = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: gestor });
+  assert.equal(segunda.status, 200);
+  assert.deepEqual(segunda.cuerpo.facturas, facturas);
+  const trasRepetir = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(trasRepetir.facturas.length, facturas.length);
+
+  // Consulta por mes, por número y factura inexistente.
+  const porMes = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor });
+  assert.equal(porMes.status, 200);
+  assert.deepEqual(porMes.cuerpo.facturas, facturas);
+
+  const porNumero = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: gestor });
+  assert.equal(porNumero.status, 200);
+  assert.deepEqual(porNumero.cuerpo.factura, facturas[0]);
+
+  const vacio = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: gestor });
+  assert.equal(vacio.status, 200);
+  assert.deepEqual(vacio.cuerpo.facturas, []);
+
+  const inexistente = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: gestor });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("una cancelación con penalización entra como Penalización y sin penalización no", async () => {
+  const propia = await arrancarApi({ AHORA: "2026-09-20T10:00" });
+  try {
+    // Cancelación gratuita (> 24 h): no lleva penalización.
+    const a = await propia.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-09-30T09:00" } });
+    assert.equal(a.status, 201);
+    const cancelaA = await propia.pedir("POST", `/api/reservas/${a.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelaA.cuerpo.reserva.estado, "cancelada");
+    assert.equal(cancelaA.cuerpo.reserva.penalizacion, undefined);
+
+    // Fuera de plazo con forzar: penalización del 100 %.
+    const b = await propia.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-09-20T18:00" } });
+    assert.equal(b.status, 201);
+    const cancelaB = await propia.pedir("POST", `/api/reservas/${b.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.ok(cancelaB.cuerpo.reserva.penalizacion > 0);
+
+    // Cerrar septiembre y facturarlo.
+    await propia.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-10-02T10:00" } });
+    const facturas = await propia.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-09" }, socio: gestor });
+    assert.equal(facturas.status, 201);
+    assert.equal(facturas.cuerpo.facturas.length, 1);
+    const f = facturas.cuerpo.facturas[0];
+    assert.equal(f.socioId, "socio-041");
+    assert.equal(f.lineas.length, 1);
+    assert.equal(f.lineas[0].reservaId, b.cuerpo.reserva.id);
+    assert.equal(f.lineas[0].concepto, "Penalización");
+    assert.equal(f.lineas[0].importe, cancelaB.cuerpo.reserva.penalizacion);
+    assert.equal(f.total, cancelaB.cuerpo.reserva.penalizacion);
+    assert.equal(f.lineas.some((l: any) => l.reservaId === a.cuerpo.reserva.id), false);
+  } finally {
+    propia.cerrar();
+  }
+});
+
+test("la numeración sigue la serie del año aunque se genere fuera de orden o al año siguiente", async () => {
+  const propia = await arrancarApi();
+  try {
+    const oct = await propia.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: gestor });
+    assert.equal(oct.status, 201);
+    const n = oct.cuerpo.facturas.length;
+
+    // Noviembre generado en diciembre: continúa la serie de 2026.
+    await propia.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T10:00" } });
+    const nov = await propia.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: gestor });
+    assert.equal(nov.status, 201);
+    assert.ok(nov.cuerpo.facturas.length > 0);
+    assert.equal(nov.cuerpo.facturas[0].numero, `F2026-${String(n + 1).padStart(4, "0")}`);
+
+    // Diciembre generado en enero de 2027: sigue la serie de 2026, no la de 2027.
+    await propia.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-15T10:00" } });
+    const creada = await propia.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-20T09:00" } });
