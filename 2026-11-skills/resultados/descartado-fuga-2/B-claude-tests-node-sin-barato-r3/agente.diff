+test("el informe de octubre de 2026 cuadra con el historial de la semilla", async () => {
+  const api = await arrancarApi();
+  try {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const delMes = estado.reservas.filter((r: { inicio: string }) => r.inicio.startsWith("2026-10"));
+    const cobradas = delMes.filter((r: { estado: string }) => r.estado !== "cancelada");
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR });
+    assert.equal(informe.status, 200);
+    assert.equal(informe.cuerpo.total.reservas, cobradas.length);
+    assert.equal(informe.cuerpo.total.ingresos, cobradas.reduce((suma: number, r: { importe: number }) => suma + r.importe, 0));
+    assert.equal(informe.cuerpo.total.penalizaciones, 0);
+    assert.equal(informe.cuerpo.pistas.reduce((suma: number, p: { reservas: number }) => suma + p.reservas, 0), cobradas.length);
+  } finally {
+    api.cerrar();
+  }
+});
