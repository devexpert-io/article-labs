@@ -0,0 +1,222 @@
+// La penalización escalonada, la exención de los gestores, el reembolso y el informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-003";
+
+/** Arranca la API con el reloj en `ahora`, ejecuta la prueba y apaga la API. */
+async function conReloj(ahora: string, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi({ AHORA: ahora });
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function reservar(api: Api, pistaId: string, inicio: string, socioId = SOCIO) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva as { id: string; importe: number };
+}
+
+async function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+async function estadoDe(api: Api, id: string) {
+  return (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva;
+}
+
+test("sin penalización con 48 horas o más, también justas", async () => {
+  await conReloj("2027-02-01T12:00", async (api) => {
+    const r = await reservar(api, "pista-1", "2027-02-03T12:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.estado, "cancelada");
+    assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c.cuerpo.reembolso, 1800);
+  });
+});
+
+test("entre 24 y 48 horas la penalización es del 25 %; a 24 horas justas no hace falta forzar", async () => {
+  await conReloj("2027-02-01T12:00", async (api) => {
+    const a = await reservar(api, "pista-1", "2027-02-03T12:00");
+    const b = await reservar(api, "pista-2", "2027-02-02T12:00", "socio-004");
+
+    await reloj(api, "2027-02-01T12:01");
+    const casi48 = await cancelar(api, a.id);
+    assert.equal(casi48.status, 200, "47 h 59 min es el tramo del 25 %, sin forzar");
+    assert.equal(casi48.cuerpo.reserva.penalizacion, 450);
+    assert.equal(casi48.cuerpo.reembolso, 1350);
+
+    await reloj(api, "2027-02-01T12:00");
+    const justas24 = await cancelar(api, b.id);
+    assert.equal(justas24.status, 200, "a 24 horas justas no hace falta forzar");
+    assert.equal(justas24.cuerpo.reserva.penalizacion, 450);
+    assert.equal(justas24.cuerpo.reembolso, 1350);
+  });
+});
+
+test("con menos de 24 horas solo se cancela con forzar, y la penalización es del 50 %", async () => {
+  await conReloj("2027-02-01T12:00", async (api) => {
+    const r = await reservar(api, "pista-1", "2027-02-02T10:30"); // faltan 22 horas y media
+
+    const sinForzar = await cancelar(api, r.id);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const conForzarFalso = await cancelar(api, r.id, { forzar: false });
+    assert.equal(conForzarFalso.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    assert.equal((await estadoDe(api, r.id)).estado, "confirmada");
+
+    const forzada = await cancelar(api, r.id, { forzar: true });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+  });
+});
+
+test("la antelación se cuenta en horas reales de Madrid: el cambio de hora de marzo cuenta", async () => {
+  // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales, no 48,5.
+  await conReloj("2027-03-26T20:30", async (api) => {
+    const r = await reservar(api, "pista-1", "2027-03-28T21:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, 700, "47,5 horas: tramo del 25 % sobre 2800");
+    assert.equal(c.cuerpo.reembolso, 2100);
+  });
+});
+
+test("la antelación se cuenta en horas reales de Madrid: el cambio de hora de octubre también", async () => {
+  // Del viernes 29 de octubre de 2027 a las 11:00 al domingo 31 a las 10:30 hay 48,5 horas reales: sin penalización.
+  await conReloj("2027-10-29T11:00", async (api) => {
+    const r = await reservar(api, "pista-1", "2027-10-31T10:30");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c.cuerpo.reembolso, 2800);
+  });
+});
+
+test("una reserva que ya ha empezado no se cancela, tampoco eximiéndola", async () => {
+  await conReloj("2027-02-01T12:00", async (api) => {
+    const r = await reservar(api, "pista-1", "2027-02-02T10:30");
+    await reloj(api, "2027-02-02T11:00");
+    const exenta = await cancelar(api, r.id, { exento: true, motivo: "Se lesionó el socio" }, GESTOR);
+    assert.equal(exenta.status, 409);
+    assert.equal(exenta.cuerpo.error.codigo, "RESERVA_PASADA");
+    const forzada = await cancelar(api, r.id, { forzar: true });
+    assert.equal(forzada.cuerpo.error.codigo, "RESERVA_PASADA");
+  });
+});
+
+test("un gestor exime de la penalización con un motivo de al menos 10 caracteres", async () => {
+  await conReloj("2027-02-01T12:00", async (api) => {
+    const r = await reservar(api, "pista-1", "2027-02-02T10:30"); // faltan 22 horas y media
+
+    const sinMotivo = await cancelar(api, r.id, { exento: true }, GESTOR);
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const corto = await cancelar(api, r.id, { exento: true, motivo: "abcdefghi" }, GESTOR);
+    assert.equal(corto.status, 400);
+    assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const noBooleano = await cancelar(api, r.id, { exento: "sí", motivo: "abcdefghij" }, GESTOR);
+    assert.equal(noBooleano.status, 400);
+
+    const deSocio = await cancelar(api, r.id, { exento: true, motivo: "Se lesionó el socio" }, SOCIO);
+    assert.equal(deSocio.status, 403);
+    assert.equal(deSocio.cuerpo.error.codigo, "SIN_PERMISO");
+    const anonimo = await cancelar(api, r.id, { exento: true, motivo: "Se lesionó el socio" });
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    assert.equal((await estadoDe(api, r.id)).estado, "confirmada", "ninguno de los intentos fallidos cancela");
