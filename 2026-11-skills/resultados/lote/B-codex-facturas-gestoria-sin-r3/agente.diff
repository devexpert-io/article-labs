@@ -0,0 +1,149 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Factura, Reserva } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+const generar = (api: Api, mes: unknown) => api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+const reloj = async (api: Api, ahora: string) => {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+};
+
+test("facturas: generar y consultar requiere un gestor, antes de validar los datos", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const [metodo, ruta] of [["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F-2026-0001"]]) {
+    for (const [socio, status, codigo] of [[undefined, 401, "NO_IDENTIFICADO"], ["socio-999", 401, "NO_IDENTIFICADO"], ["socio-001", 403, "SIN_PERMISO"]] as const) {
+      const r = await api.pedir(metodo!, ruta!, { socio });
+      assert.equal(r.status, status);
+      assert.equal(r.cuerpo.error.codigo, codigo);
+    }
+  }
+  assert.equal((await generar(api, "2026-10")).status, 201);
+});
+
+test("facturas: validación del mes y cierre según el reloj del club", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const mes of [undefined, null, 202610, {}, "", "2026-1", "26-10", "2026-00", "2026-13", "2026-10-01", " 2026-10"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const ruta of ["/api/facturas", "/api/facturas?mes=2026-00", "/api/facturas?mes=2026-13", "/api/facturas?mes=2026-1"]) {
+    const r = await api.pedir("GET", ruta, { socio: gestor });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj(api, "2026-11-30T23:59");
+  assert.equal((await generar(api, "2026-11")).status, 409);
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+});
+
+test("facturas: historial de octubre, socios, líneas ordenadas, totales e IVA por factura", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const reservas: Reserva[] = (await api.pedir("GET", "/_estado")).cuerpo.reservas;
+  const facturables = reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(facturables.some((r) => r.estado === "no_presentada"));
+  const respuesta = await generar(api, "2026-10");
+  assert.equal(respuesta.status, 201);
+  assert.deepEqual(Object.keys(respuesta.cuerpo), ["facturas"]);
+  const facturas: Factura[] = respuesta.cuerpo.facturas;
+  const socios = [...new Set(facturables.map((r) => r.socioId))].sort();
+  assert.deepEqual(facturas.map((f) => f.socioId), socios);
+  assert.ok(!socios.includes("socio-041"));
+  let distintoDeRedondearLineas = false;
+  for (const [i, f] of facturas.entries()) {
+    const suyas = facturables.filter((r) => r.socioId === f.socioId)
+      .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+    assert.deepEqual(f.lineas, suyas.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })));
+    assert.equal(f.numero, `F-2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.mes, "2026-10");
+    const total = suyas.reduce((suma, r) => suma + r.importe, 0);
+    // División entera con redondeo al céntimo: evita reproducir el cálculo en coma flotante.
+    const base = Number((BigInt(total) * 100n + 60n) / 121n);
+    assert.equal(f.total, total);
+    assert.equal(f.base, base);
+    assert.equal(f.iva, total - base);
+    assert.ok(Number.isInteger(f.base) && Number.isInteger(f.iva));
+    if (base !== suyas.reduce((suma, r) => suma + Math.round(r.importe / 1.21), 0)) distintoDeRedondearLineas = true;
+  }
+  assert.ok(distintoDeRedondearLineas, "el historial distingue el redondeo global del redondeo por línea");
+});
+
+test("facturas: cancelación penalizada, gratuita y asignación al mes de inicio", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const penalizada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(penalizada.status, 200);
+  const crear = async (inicio: string) => {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio } });
+    assert.equal(r.status, 201);
+    return r.cuerpo.reserva as Reserva;
+  };
+  const gratuita = await crear("2026-11-24T12:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratuita.id}/cancelar`)).status, 200);
+  const diciembre = await crear("2026-12-01T09:00");
+  await reloj(api, "2026-11-30T10:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${diciembre.id}/cancelar`, { cuerpo: { forzar: true } })).status, 200);
+  await reloj(api, "2026-12-01T00:00");
+  const noviembre: Factura[] = (await generar(api, "2026-11")).cuerpo.facturas;
+  const lineas = noviembre.flatMap((f) => f.lineas);
+  assert.deepEqual(lineas.find((l) => l.reservaId === "R-0520"), { reservaId: "R-0520", concepto: "Penalización por cancelación", importe: 1200 });
+  assert.ok(!lineas.some((l) => [gratuita.id, diciembre.id].includes(l.reservaId)));
+  assert.ok(!noviembre.some((f) => f.socioId === "socio-041"));
+  await reloj(api, "2027-01-01T00:00");
+  const diciembreFacturas: Factura[] = (await generar(api, "2026-12")).cuerpo.facturas;
+  const factura = diciembreFacturas.find((f) => f.socioId === "socio-041")!;
+  assert.deepEqual(factura.lineas, [{ reservaId: diciembre.id, concepto: "Penalización por cancelación", importe: 1200 }]);
+  assert.equal(factura.base, 992);
+  assert.equal(factura.iva, 208);
+});
+
+test("facturas: consultas, repetición concurrente y numeración entre meses y años", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const consultar = (mes: string) => api.pedir("GET", `/api/facturas?mes=${mes}`, { socio: gestor });
+  assert.deepEqual((await consultar("2026-10")).cuerpo, { facturas: [] });
+  assert.deepEqual((await consultar("2027-01")).cuerpo, { facturas: [] });
+  const falta = await api.pedir("GET", "/api/facturas/F-2026-0001", { socio: gestor });
+  assert.equal(falta.status, 404);
+  assert.equal(falta.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  assert.equal((await generar(api, "2026-09")).status, 201);
+  assert.equal((await generar(api, "2026-09")).status, 200);
+  const simultaneas = await Promise.all(Array.from({ length: 4 }, () => generar(api, "2026-10")));
+  assert.deepEqual(simultaneas.map((r) => r.status).sort(), [200, 200, 200, 201]);
+  const octubre: Factura[] = simultaneas[0]!.cuerpo.facturas;
+  for (const r of simultaneas) assert.deepEqual(r.cuerpo, { facturas: octubre });
+  assert.equal(octubre[0]!.numero, "F-2026-0001");
+  assert.deepEqual((await consultar("2026-10")).cuerpo.facturas, octubre);
+  for (const factura of octubre) {
+    const r = await api.pedir("GET", `/api/facturas/${factura.numero}`, { socio: gestor });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, { factura });
+  }
+  await reloj(api, "2026-12-01T00:00");
+  const noviembre: Factura[] = (await generar(api, "2026-11")).cuerpo.facturas;
+  assert.equal(noviembre[0]!.numero, `F-2026-${String(octubre.length + 1).padStart(4, "0")}`);
+  const reserva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2027-01-02T09:00" } });
+  assert.equal(reserva.status, 201);
+  await reloj(api, "2027-02-01T00:00");
+  assert.equal((await generar(api, "2026-12")).status, 201);
+  assert.equal((await generar(api, "2026-12")).status, 200);
+  const enero: Factura[] = (await generar(api, "2027-01")).cuerpo.facturas;
+  assert.equal(enero[0]!.numero, "F-2027-0001");
+  assert.equal(enero.length, 1);
+  assert.deepEqual((await generar(api, "2026-10")).cuerpo.facturas, octubre);
+  assert.equal(new Set([...octubre, ...noviembre, ...enero].map((f) => f.numero)).size, octubre.length + noviembre.length + enero.length);
+  // Las facturas guardan una instantánea incluso si la ayuda de pruebas retrasa el reloj.
+  await reloj(api, "2026-10-01T00:00");
+  assert.equal((await generar(api, "2026-10")).status, 200);
+  assert.deepEqual((await generar(api, "2026-10")).cuerpo.facturas, octubre);
+});
