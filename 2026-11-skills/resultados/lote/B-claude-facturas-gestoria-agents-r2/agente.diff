@@ -0,0 +1,171 @@
+// Facturas mensuales: reglas de la spec docs/specs/facturas.md y de la gestoría (AGENTS.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+async function reservar(a: Api, socioId: string, pistaId: string, inicio: string): Promise<string> {
+  const r = await a.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva.id;
+}
+
+async function reloj(a: Api, ahora: string) {
+  assert.equal((await a.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+test("permisos: sin X-Socio 401 y con un socio que no es gestor 403", async () => {
+  for (const [metodo, ruta, cuerpo] of [
+    ["POST", "/api/facturas", { mes: "2026-10" }],
+    ["GET", "/api/facturas?mes=2026-10", undefined],
+    ["GET", "/api/facturas/F2026-0001", undefined],
+  ] as const) {
+    const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+    assert.equal(anonimo.status, 401, ruta);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-003" });
+    assert.equal(socio.status, 403, ruta);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.facturas.length, 0, "no se ha generado nada");
+});
+
+test("mes con formato AAAA-MM y ya terminado", async () => {
+  for (const mes of [undefined, "2026-13", "2026-1", "octubre", 202610]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026/10", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12"]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+});
+
+test("octubre de 2026: una factura por socio con lo facturable, en orden, y generar dos veces da lo mismo", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const facturables = estado.reservas.filter((r: any) =>
+    r.inicio.startsWith("2026-10") && (r.estado === "confirmada" || r.estado === "no_presentada" || (r.penalizacion ?? 0) > 0));
+  const socios = [...new Set(facturables.map((r: any) => r.socioId))].sort();
+  assert.ok(facturables.some((r: any) => r.estado === "no_presentada"), "la semilla trae no presentadas en octubre");
+  const canceladas = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10") && r.estado === "cancelada").map((r: any) => r.id);
+  assert.ok(canceladas.length > 0);
+
+  const generada = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(generada.status, 201);
+  const { facturas } = generada.cuerpo;
+  assert.deepEqual(facturas.map((f: any) => f.socioId), socios);
+  assert.deepEqual(facturas.map((f: any) => f.numero), socios.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+  for (const f of facturas) {
+    const suyas = facturables.filter((r: any) => r.socioId === f.socioId).sort((a: any, b: any) => a.inicio.localeCompare(b.inicio));
+    assert.equal(f.mes, "2026-10");
+    assert.deepEqual(f.lineas, suyas.map((r: any) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })));
+    const total = suyas.reduce((s: number, r: any) => s + r.importe, 0);
+    assert.equal(f.total, total);
+    assert.equal(f.base, Math.round((total * 100) / 121));
+    assert.equal(f.base + f.iva, f.total);
+    for (const l of f.lineas) assert.ok(!canceladas.includes(l.reservaId), "las canceladas sin penalización no entran");
+  }
+
+  const repetida = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo.facturas, facturas);
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, facturas.length);
+
+  const listado = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(listado.status, 200);
+  assert.deepEqual(listado.cuerpo.facturas, facturas);
+  const una = await api.pedir("GET", `/api/facturas/${facturas[2].numero}`, { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo.factura, facturas[2]);
+  const vacio = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  const noExiste = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+  assert.equal(noExiste.status, 404);
+  assert.equal(noExiste.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("diciembre: IVA sobre el total, penalizaciones y numeración entre meses y años", async () => {
+  const otra = await arrancarApi();
+  try {
+    // socio-006: tres reservas de 1.800, 1.800 y 2.800 en diciembre.
+    const a = await reservar(otra, "socio-006", "pista-1", "2026-12-01T09:00");
+    const b = await reservar(otra, "socio-006", "pista-1", "2026-12-02T09:00");
+    const c = await reservar(otra, "socio-006", "pista-1", "2026-12-02T18:00");
+    // socio-016: una cancelada a tiempo (gratis) y otra fuera de plazo con penalización.
+    const gratis = await reservar(otra, "socio-016", "pista-2", "2026-12-10T09:00");
+    assert.equal((await otra.pedir("POST", `/api/reservas/${gratis}/cancelar`)).cuerpo.reserva.penalizacion, undefined);
+    const penalizada = await reservar(otra, "socio-016", "pista-2", "2026-12-03T09:00");
+    // socio-020: solo una cancelación gratuita, no lleva factura.
+    const sinNada = await reservar(otra, "socio-020", "pista-3", "2026-12-15T09:00");
+    await otra.pedir("POST", `/api/reservas/${sinNada}/cancelar`);
+    await reloj(otra, "2026-12-02T12:00");
+    const forzada = await otra.pedir("POST", `/api/reservas/${penalizada}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 1800);
+    // Una reserva de enero de 2027 para la serie del año siguiente.
+    await reloj(otra, "2026-12-20T10:00");
+    const enero = await reservar(otra, "socio-006", "pista-3", "2027-01-12T09:00");
+
+    // Diciembre generado en enero de 2027: sigue la serie de 2026 y empieza en 0001 aunque se genere antes que octubre.
+    await reloj(otra, "2027-01-05T10:00");
+    assert.equal((await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2027-01" }, socio: GESTOR })).cuerpo.error.codigo, "MES_ABIERTO");
+    const dic = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+    assert.equal(dic.status, 201);
+    assert.deepEqual(dic.cuerpo.facturas, [
+      {
+        numero: "F2026-0001", mes: "2026-12", socioId: "socio-006",
+        lineas: [
+          { reservaId: a, concepto: "Reserva", importe: 1800 },
+          { reservaId: b, concepto: "Reserva", importe: 1800 },
+          { reservaId: c, concepto: "Reserva", importe: 2800 },
+        ],
+        total: 6400, base: 5289, iva: 1111,
+      },
+      {
+        numero: "F2026-0002", mes: "2026-12", socioId: "socio-016",
+        lineas: [{ reservaId: penalizada, concepto: "Penalización", importe: 1800 }],
+        total: 1800, base: 1488, iva: 312,
+      },
+    ]);
+
+    // Un mes sin facturas no gasta números.
+    const septiembre = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-09" }, socio: GESTOR });
+    assert.equal(septiembre.status, 201);
+    assert.deepEqual(septiembre.cuerpo.facturas, []);
+    assert.equal((await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-09" }, socio: GESTOR })).status, 200);
+
+    // Octubre, generado después, sigue donde lo dejó diciembre.
+    const oct = (await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR })).cuerpo.facturas;
+    assert.equal(oct[0].numero, "F2026-0003");
+    assert.deepEqual(oct.map((f: any) => f.numero), oct.map((_: unknown, i: number) => `F2026-${String(i + 3).padStart(4, "0")}`));
