+
+    // Regenerar diciembre no gasta números.
+    const otraVez = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+    assert.equal(otraVez.status, 200);
+    assert.deepEqual(otraVez.cuerpo.facturas, dic.cuerpo.facturas);
+
+    // Enero de 2027 empieza su propia serie.
+    await reloj(otra, "2027-02-01T09:00");
+    const ene = (await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2027-01" }, socio: GESTOR })).cuerpo.facturas;
+    assert.deepEqual(ene.map((f: any) => [f.numero, f.lineas[0].reservaId]), [["F2027-0001", enero]]);
+
+    // Sin huecos ni repetidos en la serie de 2026.
+    const todas = (await otra.pedir("GET", "/_estado")).cuerpo.facturas.filter((f: any) => f.numero.startsWith("F2026-"));
+    const numeros = todas.map((f: any) => Number(f.numero.slice(6))).sort((x: number, y: number) => x - y);
+    assert.deepEqual(numeros, numeros.map((_: unknown, i: number) => i + 1));
+  } finally {
+    otra.cerrar();
+  }
