@@ -0,0 +1,191 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+async function mover(otra: Api, ahora: string) {
+  assert.equal((await otra.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function reservar(otra: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+}
+
+/** Las facturas que esperan las reglas de la gestoría, calculadas aparte a partir del estado. */
+function esperadas(estado: any, mes: string) {
+  const socios = estado.socios.map((s: any) => s.id).sort();
+  const resultado: { socioId: string; lineas: any[]; total: number }[] = [];
+  for (const socioId of socios) {
+    const lineas = estado.reservas
+      .filter((r: any) => r.socioId === socioId && r.inicio.startsWith(mes))
+      .sort((a: any, b: any) => a.inicio.localeCompare(b.inicio))
+      .flatMap((r: any) => {
+        if (r.estado === "confirmada" || r.estado === "no_presentada") return [{ reservaId: r.id, concepto: "Reserva", importe: r.importe }];
+        if (r.estado === "cancelada" && r.penalizacion > 0) return [{ reservaId: r.id, concepto: "Penalización", importe: r.penalizacion }];
+        return [];
+      });
+    if (lineas.length) resultado.push({ socioId, lineas, total: lineas.reduce((s: number, l: any) => s + l.importe, 0) });
+  }
+  return resultado;
+}
+
+test("solo un gestor genera y consulta facturas", async () => {
+  for (const [metodo, ruta] of [["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F2026-0001"]] as const) {
+    const cuerpo = metodo === "POST" ? { mes: "2026-10" } : undefined;
+    const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-004" });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.facturas.length, 0, "sin permiso no se genera nada");
+});
+
+test("mes con formato AAAA-MM y ya terminado según la hora del club", async () => {
+  for (const mes of [undefined, "2026-10-01", "2026-13", "26-10", 202610]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=octubre", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 409, mes);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+});
+
+test("la base y el IVA se calculan sobre el total: 1.800 + 1.800 + 2.800 dan base 5.289 e IVA 1.111", async () => {
+  const otra = await arrancarApi();
+  try {
+    // Nora Benítez (socio-041) no tiene reservas: le reservamos dos franjas de valle y una de punta en la pista 1.
+    await reservar(otra, "socio-041", "pista-1", "2026-11-25T09:00");
+    await reservar(otra, "socio-041", "pista-1", "2026-11-26T09:00");
+    await reservar(otra, "socio-041", "pista-1", "2026-11-26T19:30");
+    await mover(otra, "2026-12-01T00:00");
+    const r = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    assert.equal(r.status, 201);
+    const nora = r.cuerpo.facturas.find((f: any) => f.socioId === "socio-041");
+    assert.deepEqual(nora.lineas.map((l: any) => l.importe), [1800, 1800, 2800]);
+    assert.equal(nora.total, 6400);
+    assert.equal(nora.base, 5289);
+    assert.equal(nora.iva, 1111);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("octubre: una factura por socio con algo que facturar, ordenadas y numeradas desde F2026-0001", async () => {
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo, { facturas: [] });
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const previstas = esperadas(estado, "2026-10");
+  assert.ok(previstas.length > 0);
+  assert.ok(estado.reservas.some((r: any) => r.inicio.startsWith("2026-10") && r.estado === "cancelada"), "octubre tiene cancelaciones");
+  assert.ok(estado.reservas.some((r: any) => r.inicio.startsWith("2026-10") && r.estado === "no_presentada"), "octubre tiene no presentadas");
+
+  const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(r.status, 201);
+  const facturas = r.cuerpo.facturas;
+  assert.equal(facturas.length, previstas.length);
+  facturas.forEach((f: any, i: number) => {
+    assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.mes, "2026-10");
+    assert.equal(f.socioId, previstas[i]!.socioId);
+    assert.deepEqual(f.lineas, previstas[i]!.lineas);
+    assert.equal(f.total, previstas[i]!.total);
+    assert.equal(f.base, Math.round((f.total * 100) / 121));
+    assert.equal(f.base + f.iva, f.total);
+  });
+  const sinFactura = estado.socios.map((s: any) => s.id).filter((id: string) => !facturas.some((f: any) => f.socioId === id));
+  assert.ok(sinFactura.includes("socio-041"), "Nora Benítez no lleva factura");
+  const conLineas = new Set(facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId)));
+  for (const reserva of estado.reservas.filter((x: any) => x.inicio.startsWith("2026-10") && x.estado === "cancelada")) {
+    assert.ok(!conLineas.has(reserva.id), `${reserva.id} se canceló sin penalización y no se factura`);
+  }
+
+  // Generar otra vez: las mismas facturas, con 200, y ninguna nueva.
+  const otraVez = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(otraVez.status, 200);
+  assert.deepEqual(otraVez.cuerpo.facturas, facturas);
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, facturas.length);
+
+  // Consultar.
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas, facturas);
+  const una = await api.pedir("GET", `/api/facturas/${facturas[2].numero}`, { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo.factura, facturas[2]);
+  const ninguna = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+  assert.equal(ninguna.status, 404);
+  assert.equal(ninguna.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("penalizaciones, numeración entre meses y entre años, y diciembre generado en enero", async () => {
+  const otra = await arrancarApi();
+  try {
+    const pedir = (metodo: string, ruta: string, cuerpo?: unknown) => otra.pedir(metodo, ruta, { cuerpo, socio: GESTOR });
+    // Noviembre: Marta López cancela fuera de plazo (con penalización) y Pablo cancela gratis.
+    const penalizada = (await otra.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } })).cuerpo.reserva;
+    assert.equal(penalizada.socioId, "socio-002");
+    assert.equal(penalizada.penalizacion, 1200);
+    const gratis = await reservar(otra, "socio-003", "pista-3", "2026-11-28T12:00");
