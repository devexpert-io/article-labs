@@ -0,0 +1,149 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi } from "./ayuda.ts";
+import type { Estado, Factura } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+
+async function preparar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const generar = (mes: unknown) => api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+  const reloj = async (ahora: string) => {
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+  };
+  const reservar = async (inicio: string, socioId = "socio-041") => {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-1", inicio } });
+    assert.equal(r.status, 201, r.texto);
+    return r.cuerpo.reserva;
+  };
+  return { api, generar, reloj, reservar };
+}
+
+test("facturas: solo el gestor genera y consulta, incluso con datos inválidos", async (t) => {
+  const { api } = await preparar(t);
+  for (const [metodo, ruta] of [["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"],
+    ["GET", "/api/facturas/F2026-0001"]]) {
+    for (const [socio, status, codigo] of [[undefined, 401, "NO_IDENTIFICADO"],
+      ["socio-999", 401, "NO_IDENTIFICADO"], ["socio-001", 403, "SIN_PERMISO"]] as const) {
+      const r = await api.pedir(metodo!, ruta!, { socio });
+      assert.equal(r.status, status);
+      assert.equal(r.cuerpo.error.codigo, codigo);
+    }
+  }
+});
+
+test("facturas: valida el mes y solo genera meses terminados según el reloj del club", async (t) => {
+  const { api, generar, reloj } = await preparar(t);
+  for (const mes of [undefined, null, 202610, {}, [], "", "2026-1", "26-10", "2026-00", "2026-13", "2026-10-01", "2026-10\n"]) {
+    const r = await generar(mes);
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const ruta of ["/api/facturas", "/api/facturas?mes=2026-13"]) {
+    const r = await api.pedir("GET", ruta, { socio: gestor });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj("2026-11-30T23:59");
+  assert.equal((await generar("2026-11")).status, 409);
+  await reloj("2026-12-01T00:00");
+  assert.equal((await generar("2026-11")).status, 201);
+});
+
+test("facturas: el historial de octubre determina socios, líneas, totales y consultas", async (t) => {
+  const { api, generar } = await preparar(t);
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const sinGenerar = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor });
+  assert.equal(sinGenerar.status, 200);
+  assert.deepEqual(sinGenerar.cuerpo, { facturas: [] });
+  const generada = await generar("2026-10");
+  assert.equal(generada.status, 201);
+  const facturas: Factura[] = generada.cuerpo.facturas;
+  const reservas = estado.reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(reservas.some((r) => r.estado === "no_presentada"));
+  const socios = [...new Set(reservas.map((r) => r.socioId))].sort();
+  assert.deepEqual(facturas.map((f) => f.socioId), socios);
+  assert.ok(!socios.includes("socio-041"));
+  for (const [i, f] of facturas.entries()) {
+    assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.mes, "2026-10");
+    const propias = reservas.filter((r) => r.socioId === f.socioId).sort((a, b) => a.inicio.localeCompare(b.inicio));
+    assert.deepEqual(f.lineas, propias.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })));
+    assert.equal(f.total, propias.reduce((total, r) => total + r.importe, 0));
+    assert.equal(f.base, Math.round(f.total * 100 / 121));
+    assert.equal(f.iva, f.total - f.base);
+    const consulta = await api.pedir("GET", `/api/facturas/${f.numero}`, { socio: gestor });
+    assert.equal(consulta.status, 200);
+    assert.deepEqual(consulta.cuerpo, { factura: f });
+  }
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).cuerpo, generada.cuerpo);
+  const falta = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: gestor });
+  assert.equal(falta.status, 404);
+  assert.equal(falta.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  const repeticiones = await Promise.all([generar("2026-10"), generar("2026-10")]);
+  for (const r of repeticiones) {
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, generada.cuerpo);
+  }
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, estado.reservas);
+});
+
+test("facturas: incluye penalizaciones y excluye cancelaciones gratuitas", async (t) => {
+  const { api, generar, reloj, reservar } = await preparar(t);
+  const gratis = await reservar("2026-11-25T09:00");
+  const cancelada = await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`);
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+  const reservas: Estado["reservas"] = (await api.pedir("GET", "/_estado")).cuerpo.reservas;
+  const marta = reservas.find((r) => r.socioId === "socio-002" && r.inicio === "2026-11-19T09:00")!;
+  const penalizada = await api.pedir("POST", `/api/reservas/${marta.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(penalizada.status, 200);
+  await reloj("2026-12-01T00:00");
+  const facturas: Factura[] = (await generar("2026-11")).cuerpo.facturas;
+  assert.ok(!facturas.some((f) => f.socioId === "socio-041"));
+  assert.ok(!facturas.flatMap((f) => f.lineas).some((l) => l.reservaId === gratis.id));
+  const factura = facturas.find((f) => f.socioId === marta.socioId)!;
+  assert.deepEqual(factura.lineas.find((l) => l.reservaId === marta.id),
+    { reservaId: marta.id, concepto: "Penalización", importe: 1200 });
+});
+
+test("facturas: IVA sobre 6400, diciembre generado en enero y series entre meses y años", async (t) => {
+  const { api, generar, reloj, reservar } = await preparar(t);
+  const tarde = await reservar("2026-12-03T18:00");
+  const primera = await reservar("2026-12-01T09:00");
+  const segunda = await reservar("2026-12-02T09:00");
+  const vacia = await generar("2026-09");
+  assert.equal(vacia.status, 201);
+  assert.deepEqual(vacia.cuerpo, { facturas: [] });
+  assert.equal((await generar("2026-09")).status, 200);
+  await reloj("2027-01-01T00:00");
+  const diciembre = await generar("2026-12");
+  assert.equal(diciembre.status, 201);
+  assert.deepEqual(diciembre.cuerpo.facturas, [{
+    numero: "F2026-0001", mes: "2026-12", socioId: "socio-041",
+    lineas: [primera, segunda, tarde].map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })),
+    total: 6400, base: 5289, iva: 1111,
+  }]);
+  await reservar("2027-01-04T09:00");
+  await reloj("2027-02-01T00:00");
+  const enero = await generar("2027-01");
+  assert.equal(enero.cuerpo.facturas[0].numero, "F2027-0001");
+  assert.equal((await generar("2026-12")).status, 200);
+  const noviembre = await generar("2026-11");
+  assert.equal(noviembre.cuerpo.facturas[0].numero, "F2026-0002");
+  const octubre = await generar("2026-10");
+  const siguientes = noviembre.cuerpo.facturas.length + 2;
+  assert.equal(octubre.cuerpo.facturas[0].numero, `F2026-${String(siguientes).padStart(4, "0")}`);
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const serie = estado.facturas.filter((f) => f.mes.startsWith("2026"));
+  assert.deepEqual(serie.map((f) => f.numero), serie.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+  assert.deepEqual((await generar("2026-12")).cuerpo, diciembre.cuerpo);
+  const consulta = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: gestor });
+  assert.deepEqual(consulta.cuerpo, { facturas: [] });
+});
