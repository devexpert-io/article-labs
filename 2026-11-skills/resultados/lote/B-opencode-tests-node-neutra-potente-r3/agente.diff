+// Reembolsos: penalizaciones escalonadas, exención y el informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function crear(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201);
+  return r.cuerpo.reserva;
+}
+
+test("C1 · tramos de penalización según la antelación", async () => {
+  const api = await arrancarApi({ AHORA: "2026-12-10T10:00" });
+  try {
+    const gratis = await crear(api, "socio-004", "pista-1", "2026-12-12T12:00"); // 50 horas
+    const parcial = await crear(api, "socio-002", "pista-2", "2026-12-11T12:00"); // 26 horas
+    const apremio = await crear(api, "socio-003", "pista-3", "2026-12-10T18:00"); // 8 horas
+
+    // 48 horas o más: sin penalización y sin forzar.
+    const c1 = await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`);
+    assert.equal(c1.status, 200);
+    assert.equal(c1.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c1.cuerpo.reembolso, gratis.importe);
+
+    // Entre 24 y 48 horas: 25 % sin forzar.
+    const c2 = await api.pedir("POST", `/api/reservas/${parcial.id}/cancelar`);
+    assert.equal(c2.status, 200);
+    assert.equal(c2.cuerpo.reserva.penalizacion, Math.round(parcial.importe / 4));
+    assert.equal(c2.cuerpo.reembolso, parcial.importe - Math.round(parcial.importe / 4));
+
+    // Menos de 24 horas: hace falta forzar y la penalización es el 50 %.
+    const sinForzar = await api.pedir("POST", `/api/reservas/${apremio.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const conForzar = await api.pedir("POST", `/api/reservas/${apremio.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(conForzar.cuerpo.reserva.penalizacion, Math.round(apremio.importe / 2));
+    assert.equal(conForzar.cuerpo.reembolso, apremio.importe - Math.round(apremio.importe / 2));
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C2 · límites exactos: 48 horas sin penalización y 24 horas con el 25 %", async () => {
+  const a48 = await arrancarApi({ AHORA: "2026-11-20T10:30" });
+  try {
+    const r = await a48.pedir("POST", "/api/reservas/R-0522/cancelar"); // empieza 2026-11-22T10:30
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(r.cuerpo.reembolso, r.cuerpo.reserva.importe);
+  } finally {
+    a48.cerrar();
+  }
+
+  const a24 = await arrancarApi({ AHORA: "2026-11-19T18:00" });
+  try {
+    const r = await a24.pedir("POST", "/api/reservas/R-0521/cancelar"); // empieza 2026-11-20T18:00, importe 2800
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 700);
+    assert.equal(r.cuerpo.reembolso, 2100);
+  } finally {
+    a24.cerrar();
+  }
+});
+
+test("C3 · la antelación cuenta el cambio de hora de Madrid", async () => {
+  // Del viernes 26 al domingo 28 de marzo de 2027 hay 47,5 horas reales, no 48,5.
+  const api = await arrancarApi({ AHORA: "2027-03-26T20:30" });
+  try {
+    const reserva = await crear(api, "socio-004", "pista-1", "2027-03-28T21:00");
+    const r = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, Math.round(reserva.importe / 4));
+    assert.equal(r.cuerpo.reembolso, reserva.importe - Math.round(reserva.importe / 4));
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C4 · cancelar devuelve el reembolso, importe menos penalización", async () => {
+  const api = await arrancarApi({ AHORA: "2026-12-10T10:00" });
+  try {
+    const reserva = await crear(api, "socio-002", "pista-2", "2026-12-10T18:00"); // 8 horas
+    const r = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(r.cuerpo.reserva.penalizacion, Math.round(reserva.importe / 2));
+    assert.equal(r.cuerpo.reembolso, reserva.importe - r.cuerpo.reserva.penalizacion);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C5 · exención: solo un gestor, con un motivo de 10 caracteres o más", async () => {
+  const api = await arrancarApi();
+  try {
+    // Sin X-Socio.
+    const sinSocio = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
