+test("C7 · el informe de caja agrega por pista y mes, con no_presentadas", async () => {
+  const api = await arrancarApi();
+  try {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const mes = "2026-11";
+    const delMes = estado.reservas.filter((r: { inicio: string }) => r.inicio.slice(0, 7) === mes);
+    assert.ok(delMes.some((r: { estado: string }) => r.estado === "no_presentada"), "noviembre trae no_presentadas");
+
+    const esperado = estado.pistas
+      .slice()
+      .sort((a: { id: string }, b: { id: string }) => a.id.localeCompare(b.id))
+      .map((p: { id: string }) => {
+        const dePista = delMes.filter((r: { pistaId: string }) => r.pistaId === p.id);
+        const conIngreso = dePista.filter((r: { estado: string }) => r.estado === "confirmada" || r.estado === "no_presentada");
+        const ingresos = conIngreso.reduce((s: number, r: { importe: number }) => s + r.importe, 0);
+        const penalizaciones = dePista
+          .filter((r: { estado: string }) => r.estado === "cancelada")
+          .reduce((s: number, r: { penalizacion?: number }) => s + (r.penalizacion ?? 0), 0);
+        return { pistaId: p.id, reservas: conIngreso.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+      });
+    const total = esperado.reduce(
+      (acc: { reservas: number; ingresos: number; penalizaciones: number; total: number }, p: typeof esperado[number]) => ({
+        reservas: acc.reservas + p.reservas,
+        ingresos: acc.ingresos + p.ingresos,
+        penalizaciones: acc.penalizaciones + p.penalizaciones,
+        total: acc.total + p.total,
+      }),
+      { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    );
+
+    const informe = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+    assert.equal(informe.cuerpo.mes, mes);
+    assert.deepEqual(informe.cuerpo.pistas, esperado);
+    assert.deepEqual(informe.cuerpo.total, total);
+  } finally {
+    api.cerrar();
+  }
+});
