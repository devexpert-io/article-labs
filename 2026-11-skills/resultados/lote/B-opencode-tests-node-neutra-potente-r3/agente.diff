+    // Un socio normal no puede eximir.
+    const noGestor = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      cuerpo: { exento: true, motivo: "motivo suficientemente largo" },
+      socio: "socio-001",
+    });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    // Motivo demasiado corto o ausente.
+    const corto = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      cuerpo: { exento: true, motivo: "corto" },
+      socio: "socio-040",
+    });
+    assert.equal(corto.status, 400);
+    assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const sinMotivo = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      cuerpo: { exento: true },
+      socio: "socio-040",
+    });
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // Exención válida: sin forzar, sin penalización y con el motivo guardado.
+    const ok = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      cuerpo: { exento: true, motivo: "Avalado por la dirección del club" },
+      socio: "socio-040",
+    });
+    assert.equal(ok.status, 200);
+    assert.equal(ok.cuerpo.reserva.estado, "cancelada");
+    assert.equal(ok.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(ok.cuerpo.reserva.motivoCancelacion, "Avalado por la dirección del club");
+    assert.equal(ok.cuerpo.reembolso, ok.cuerpo.reserva.importe);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C6 · una reserva ya empezada no se cancela, tampoco con exento", async () => {
+  const api = await arrancarApi({ AHORA: "2026-11-20T10:00" });
+  try {
+    const normal = await api.pedir("POST", "/api/reservas/R-0520/cancelar"); // empezó 2026-11-19T09:00
+    assert.equal(normal.status, 409);
+    assert.equal(normal.cuerpo.error.codigo, "RESERVA_PASADA");
+    const exento = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      cuerpo: { exento: true, motivo: "motivo suficientemente largo" },
+      socio: "socio-040",
+    });
