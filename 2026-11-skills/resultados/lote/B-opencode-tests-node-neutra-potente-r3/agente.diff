+});
+
+function desfaseMadridMinutos(instante: number): number {
+  const parte = FORMATO_MADRID.formatToParts(new Date(instante)).find((p) => p.type === "timeZoneName");
+  const texto = parte?.value ?? "GMT+1";
+  const m = /GMT([+-])(\d{1,2})(?::(\d{2}))?/.exec(texto);
+  if (!m) return 60;
+  const signo = m[1] === "-" ? -1 : 1;
+  return signo * (Number(m[2]) * 60 + Number(m[3] ?? 0));
+}
+
+/** Instante (epoch en ms) en el que el reloj de Madrid marca la fecha y hora locales dadas. */
+function instanteMadrid(local: string): number {
+  const comoUTC = Date.parse(`${local}:00Z`);
+  let instante = comoUTC;
+  for (let i = 0; i < 3; i++) instante = comoUTC - desfaseMadridMinutos(instante) * 60_000;
