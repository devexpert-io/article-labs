@@ -0,0 +1,189 @@
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { beforeEach, afterEach, test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import type { Estado, Reserva } from "../src/tipos.ts";
+
+let api: Api;
+beforeEach(async () => { api = await arrancarApi(); });
+afterEach(() => api.cerrar());
+
+async function reloj(ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { ahora });
+}
+async function crear(inicio = "2027-01-15T12:00", pistaId = "pista-3"): Promise<Reserva> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { inicio, pistaId, socioId: "socio-041" } });
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.cuerpo.reserva, {
+    id: r.cuerpo.reserva.id, socioId: "socio-041", pistaId, inicio,
+    fin: `${inicio.slice(0, 10)}T${inicio.endsWith("21:00") ? "22:30" : "13:30"}`,
+    importe: pistaId === "pista-3" ? (inicio.endsWith("21:00") ? 2000 : 1200) : 1800,
+    estado: "confirmada", notas: "",
+  });
+  return r.cuerpo.reserva;
+}
+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+  assert.equal(typeof r.cuerpo.error.mensaje, "string");
+}
+async function cancelar(r: Reserva, penalizacion: number, cuerpo = {}) {
+  const respuesta = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo });
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, {
+    reserva: { ...r, estado: "cancelada", ...(penalizacion ? { penalizacion } : {}) },
+    reembolso: r.importe - penalizacion,
+  });
+}
+
+for (const [ahora, penalizacion, forzar] of [
+  ["2027-01-13T11:59", 0, false],
+  ["2027-01-13T12:01", 300, false],
+  ["2027-01-14T12:01", 600, true],
+  ["2027-01-15T11:59", 600, true],
+] as const) {
+  test(`C1 · tramo de cancelación desde ${ahora}`, async () => {
+    const r = await crear();
+    await reloj(ahora);
+    if (forzar) {
+      for (const cuerpo of [{}, { forzar: false }]) {
+        error(await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo }), 409, "FUERA_DE_PLAZO");
+      }
+      const intacta = await api.pedir("GET", `/api/reservas/${r.id}`);
+      assert.equal(intacta.status, 200);
+      assert.deepEqual(intacta.cuerpo, { reserva: r });
+    }
+    await cancelar(r, penalizacion, { forzar });
+  });
+}
+for (const [ahora, penalizacion] of [["2027-01-13T12:00", 0], ["2027-01-14T12:00", 300]] as const) {
+  test(`C2 · límite exacto desde ${ahora}`, async () => {
