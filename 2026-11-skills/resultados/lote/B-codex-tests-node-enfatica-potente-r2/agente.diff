+/** Convierte la hora local del club a un instante, usando el desfase de Madrid de esa fecha. */
+function instanteMadrid(fecha: string): number {
+  const local = Date.parse(`${fecha}:00Z`);
+  let instante = local;
+  for (let i = 0; i < 3; i++) {
+    const zona = zonaMadrid.formatToParts(instante).find((p) => p.type === "timeZoneName")!.value;
+    const [, signo, horas, minutos] = /GMT([+-])(\d{2}):(\d{2})/.exec(zona)!;
+    const desfase = (Number(horas) * 60 + Number(minutos)) * (signo === "+" ? 1 : -1);
+    instante = local - desfase * 60_000;
+  }
+  return instante;
