@@ -0,0 +1,68 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi } from "./ayuda.ts";
+
+async function conApi(fn: (api: Awaited<ReturnType<typeof arrancarApi>>) => Promise<void>) {
+  const api = await arrancarApi();
+  try { await fn(api); } finally { api.cerrar(); }
+}
+
+test("C1-C2 · aplica los tramos y sus límites exactos", async () => conApi(async (api) => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-17T09:00" } });
+  const sin = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+  assert.equal(sin.status, 200);
+  assert.deepEqual([sin.cuerpo.reserva.penalizacion, sin.cuerpo.reembolso], [undefined, 1200]);
+}));
+
+test("C1 · entre 24 y 48 horas aplica 25 %, y bajo 24 exige forzar con 50 %", async () => conApi(async (api) => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T09:00" } });
+  const veinticuatro = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+  assert.equal(veinticuatro.status, 200);
+  assert.deepEqual([veinticuatro.cuerpo.reserva.penalizacion, veinticuatro.cuerpo.reembolso], [300, 900]);
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:00" } });
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-2", inicio: "2026-11-19T09:00" } });
+  const id = creada.cuerpo.reserva.id;
+  const bloqueada = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(bloqueada.status, 409);
+  assert.deepEqual(bloqueada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.deepEqual([forzada.cuerpo.reserva.penalizacion, forzada.cuerpo.reembolso], [900, 900]);
+}));
+
+test("C3 · mide horas reales al cruzar el cambio de hora", async () => conApi(async (api) => {
+  const reserva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-2", inicio: "2027-03-28T21:00" } });
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-26T20:30" } });
+  const cancelada = await api.pedir("POST", `/api/reservas/${reserva.cuerpo.reserva.id}/cancelar`);
+  assert.equal(cancelada.status, 200);
+  assert.deepEqual(cancelada.cuerpo.reserva.penalizacion, 700);
+}));
+
+test("C5-C6 · exención exige gestor y motivo y no permite reservas iniciadas", async () => conApi(async (api) => {
+  const noGestor = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { socio: "socio-003", cuerpo: { exento: true, motivo: "Motivo suficientemente largo" } });
+  assert.equal(noGestor.status, 403); assert.deepEqual(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+  const sinIdentidad = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { exento: true, motivo: "Motivo suficientemente largo" } });
+  assert.equal(sinIdentidad.status, 401); assert.deepEqual(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const corto = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { socio: "socio-040", cuerpo: { exento: true, motivo: "corto" } });
+  assert.equal(corto.status, 400); assert.deepEqual(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-19T09:00" } });
+  const pasada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { socio: "socio-040", cuerpo: { exento: true, motivo: "Motivo suficientemente largo" } });
+  assert.equal(pasada.status, 409); assert.deepEqual(pasada.cuerpo.error.codigo, "RESERVA_PASADA");
+}));
+
+test("C5 · el gestor exime y conserva el motivo", async () => conApi(async (api) => {
+  const r = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { socio: "socio-040", cuerpo: { exento: true, motivo: "Incidencia comunicada" } });
+  assert.equal(r.status, 200); assert.deepEqual([r.cuerpo.reserva.penalizacion, r.cuerpo.reembolso, r.cuerpo.reserva.motivoCancelacion], [undefined, 1200, "Incidencia comunicada"]);
+}));
+
+test("C7 · informe mensual solo gestor, agrega movimientos y valida el mes", async () => conApi(async (api) => {
+  const anonimo = await api.pedir("GET", "/api/informes/caja?mes=2026-10");
+  assert.equal(anonimo.status, 401); assert.deepEqual(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-003" });
+  assert.equal(socio.status, 403); assert.deepEqual(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const invalido = await api.pedir("GET", "/api/informes/caja?mes=2026-13", { socio: "socio-040" });
+  assert.equal(invalido.status, 400); assert.deepEqual(invalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const vacio = await api.pedir("GET", "/api/informes/caja?mes=2026-09", { socio: "socio-040" });
+  assert.equal(vacio.status, 200);
+  assert.deepEqual(vacio.cuerpo, { mes: "2026-09", pistas: ["pista-1", "pista-2", "pista-3", "pista-4"].map((pistaId) => ({ pistaId, reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 })), total: { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 } });
+}));
