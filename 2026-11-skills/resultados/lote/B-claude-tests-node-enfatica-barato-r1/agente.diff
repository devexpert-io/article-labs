+prueba("C7 · el informe reparte reservas, ingresos y penalizaciones por pista, con las pistas sin movimientos", async (api) => {
+  await reservar(api, "2026-12-01T19:30", "pista-2"); // 2800, confirmada
+  const aCancelar = await reservar(api, "2026-12-02T10:30", "pista-3"); // 1200
+  const exenta = await reservar(api, "2026-12-05T10:30", "pista-1"); // 2800 (sábado, punta)
+  await ir(api, "2026-12-01T10:30");
+  const penalizada = await cancelar(api, aCancelar); // 24 horas justas: 25 % de 1200 = 300
+  assert.equal(penalizada.cuerpo.reserva.penalizacion, 300);
+  const eximida = await cancelar(api, exenta, { exento: true, motivo: "Obras en la pista uno" }, GESTOR);
