+  const r = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: GESTOR });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, {
+    mes: "2026-12",
+    pistas: [
