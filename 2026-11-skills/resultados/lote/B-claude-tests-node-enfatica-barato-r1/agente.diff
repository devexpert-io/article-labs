@@ -0,0 +1,267 @@
+// Política de cancelación escalonada, exención de gestor, reembolso e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const CLIENTE = "socio-041"; // Nora Benítez: cuota al día y sin reservas.
+const GESTOR = "socio-040"; // Recepción del club.
+const MOTIVO = "Pista encharcada por la lluvia";
+
+/** Una API nueva con su estado (y su hora) propios, cerrada al terminar la prueba. */
+function prueba(nombre: string, fn: (api: Api) => Promise<void>, entorno?: Record<string, string>) {
+  test(nombre, async () => {
+    const api = await arrancarApi(entorno);
+    try {
+      await fn(api);
+    } finally {
+      api.cerrar();
+    }
+  });
+}
+
+/** Reserva para CLIENTE en la hora indicada, con la hora del club todavía en 2026-11-18T10:00. */
+async function reservar(api: Api, inicio: string, pistaId = "pista-2"): Promise<string> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: CLIENTE, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva.id;
+}
+
+async function ir(api: Api, ahora: string): Promise<void> {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+function cancelar(api: Api, id: string, cuerpo: Record<string, unknown> = {}, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+// Tramos: 2026-12-01T19:30 es martes de punta (pista 2, 2800 céntimos).
+
+prueba("C1 · con 48 horas o más de antelación no hay penalización", async (api) => {
+  const id = await reservar(api, "2026-12-03T10:30"); // jueves, valle: 1800
+  await ir(api, "2026-11-30T10:30"); // 72 horas antes
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 1800);
+});
+
+prueba("C1 · entre 24 y 48 horas de antelación, penalización del 25 %", async (api) => {
+  const id = await reservar(api, "2026-12-01T19:30");
+  await ir(api, "2026-11-29T21:00"); // 46,5 horas antes
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 700);
+  assert.equal(r.cuerpo.reembolso, 2100);
+});
+
+prueba("C1 · con menos de 24 horas, sin forzar: 409 FUERA_DE_PLAZO y la reserva sigue confirmada", async (api) => {
+  const id = await reservar(api, "2026-12-01T19:30");
+  await ir(api, "2026-11-30T21:00"); // 22,5 horas antes
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const consulta = await api.pedir("GET", `/api/reservas/${id}`);
+  assert.equal(consulta.cuerpo.reserva.estado, "confirmada");
+});
+
+prueba("C1 · con menos de 24 horas y forzar, penalización del 50 %", async (api) => {
+  const id = await reservar(api, "2026-12-01T19:30");
+  await ir(api, "2026-11-30T21:00");
+  const r = await cancelar(api, id, { forzar: true });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 1400);
+  assert.equal(r.cuerpo.reembolso, 1400);
+});
+
+prueba("C2 · a 48 horas justas no hay penalización", async (api) => {
+  const id = await reservar(api, "2026-12-01T19:30");
+  await ir(api, "2026-11-29T19:30");
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 2800);
+});
+
+prueba("C2 · a un minuto de las 48 horas ya hay penalización del 25 %", async (api) => {
+  const id = await reservar(api, "2026-12-01T19:30");
+  await ir(api, "2026-11-29T19:31"); // 47 horas y 59 minutos
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 700);
+});
+
+prueba("C2 · a 24 horas justas se aplica el 25 % sin forzar", async (api) => {
+  const id = await reservar(api, "2026-12-01T19:30");
+  await ir(api, "2026-11-30T19:30");
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 700);
+});
+
+prueba("C2 · a un minuto de las 24 horas exige forzar", async (api) => {
+  const id = await reservar(api, "2026-12-01T19:30");
+  await ir(api, "2026-11-30T19:31"); // 23 horas y 59 minutos
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 409);
+  assert.equal(r.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+});
+
+prueba("C3 · el cambio de hora de marzo cuenta horas reales: 47,5 horas dan el 25 %", async (api) => {
+  const id = await reservar(api, "2027-03-28T21:00"); // domingo, punta: 2800
+  await ir(api, "2027-03-26T20:30"); // 47,5 horas reales (48,5 en reloj)
+  const r = await cancelar(api, id);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 700);
+  assert.equal(r.cuerpo.reembolso, 2100);
+});
+
+prueba("C3 · el cambio de hora de marzo cuenta horas reales: 23,5 horas exigen forzar", async (api) => {
+  const id = await reservar(api, "2027-03-28T13:30"); // domingo, punta: 2800
+  await ir(api, "2027-03-27T13:00"); // 23,5 horas reales (24,5 en reloj)
+  const sinForzar = await cancelar(api, id);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await cancelar(api, id, { forzar: true });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1400);
+});
+
+prueba("C4 · el reembolso es el importe menos la penalización", async (api) => {
+  const id = await reservar(api, "2026-12-01T19:30");
+  await ir(api, "2026-11-29T21:00");
+  const r = await cancelar(api, id);
+  assert.equal(r.cuerpo.reserva.importe, 2800);
+  assert.equal(r.cuerpo.reserva.penalizacion, 700);
+  assert.equal(r.cuerpo.reembolso, 2800 - 700);
+});
+
+prueba("C5 · un gestor exime de la penalización con exento y motivo, sin forzar", async (api) => {
+  const id = await reservar(api, "2026-12-01T19:30");
+  await ir(api, "2026-11-30T21:00"); // 22,5 horas: con un socio normal daría FUERA_DE_PLAZO
+  const r = await cancelar(api, id, { exento: true, motivo: MOTIVO }, GESTOR);
+  assert.equal(r.status, 200);
