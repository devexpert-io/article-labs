+test("C7 · el informe de caja suma reservas, ingresos y penalizaciones por pista, con las pistas sin movimientos", async () => {
+  const api = await arrancarApi();
+  try {
+    // Todo en diciembre de 2026, con la hora del club a 1 de diciembre a las 12:00.
+    const r1 = await reservar(api, "2026-12-02T10:30", "pista-1"); // 1800, se cancela con forzar a 22,5 h: 900
+    const r2 = await reservar(api, "2026-12-02T18:00", "pista-1"); // 2800 punta, se cancela a 30 h: 700
+    await reservar(api, "2026-12-02T12:00", "pista-2"); // 1800, confirmada
+    await reloj(api, "2026-12-01T12:00");
+    assert.equal((await cancelar(api, r1, { forzar: true })).cuerpo.reserva.penalizacion, 900);
+    assert.equal((await cancelar(api, r2)).cuerpo.reserva.penalizacion, 700);
