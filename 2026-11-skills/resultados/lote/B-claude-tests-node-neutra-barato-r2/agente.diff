+
+test("C4 · la respuesta de cancelar trae el reembolso, importe menos penalización", async () => {
+  const api = await arrancarApi();
+  try {
+    const id = await reservar(api, INICIO);
+    await reloj(api, "2026-11-23T12:00");
+    const r = await cancelar(api, id);
+    assert.equal(r.status, 200);
+    assert.deepEqual(Object.keys(r.cuerpo).sort(), ["reembolso", "reserva"]);
+    assert.equal(r.cuerpo.reembolso, r.cuerpo.reserva.importe - r.cuerpo.reserva.penalizacion);
