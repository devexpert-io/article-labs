+        { pistaId: "pista-2", reservas: 1, ingresos: 1800, penalizaciones: 0, total: 1800 },
+        { pistaId: "pista-3", ...sinMovimiento },
+        { pistaId: "pista-4", ...sinMovimiento },
+      ],
+      total: { reservas: 1, ingresos: 1800, penalizaciones: 1600, total: 3400 },
+    });
+  } finally {
+    api.cerrar();
+  }
