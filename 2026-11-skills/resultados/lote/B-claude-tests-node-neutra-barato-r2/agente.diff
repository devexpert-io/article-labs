+// Penalizaciones escalonadas, exención de gestor e informe de caja (docs/specs/reembolsos.md).
+// Cada test arranca su propia API y mueve el reloj del club con POST /_reloj.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-041"; // Nora Benítez: sin reservas en la semilla.
+
+// Pista 1 en martes o miércoles: 1800 céntimos en valle. Partes del 25 %: 450. Del 50 %: 900.
+const INICIO = "2026-11-25T10:30";
+
+async function reloj(api: Api, ahora: string): Promise<void> {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function reservar(api: Api, inicio: string, pistaId = "pista-1", socioId = SOCIO): Promise<string> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva.id;
+}
+
+function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+test("C1 · sin penalización con 48 horas o más de antelación", async () => {
+  const api = await arrancarApi();
+  try {
+    const id = await reservar(api, INICIO);
+    await reloj(api, "2026-11-20T10:30");
+    const r = await cancelar(api, id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.estado, "cancelada");
+    assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(r.cuerpo.reembolso, 1800);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 %", async () => {
+  const api = await arrancarApi();
+  try {
+    const id = await reservar(api, INICIO);
+    await reloj(api, "2026-11-23T12:00"); // 46,5 horas
+    const r = await cancelar(api, id);
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, 450);
+    assert.equal(r.cuerpo.reembolso, 1350);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C1 · con menos de 24 horas solo se cancela con forzar, y entonces la penalización es el 50 %", async () => {
+  const api = await arrancarApi();
+  try {
+    const id = await reservar(api, INICIO);
+    await reloj(api, "2026-11-24T12:00"); // 22,5 horas
+    const sinForzar = await cancelar(api, id);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const sigue = await api.pedir("GET", `/api/reservas/${id}`);
+    assert.equal(sigue.cuerpo.reserva.estado, "confirmada");
+
+    const forzada = await cancelar(api, id, { forzar: true });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C2 · a 48 horas justas no hay penalización", async () => {
+  const api = await arrancarApi();
+  try {
+    const id = await reservar(api, INICIO);
+    await reloj(api, "2026-11-23T10:30");
