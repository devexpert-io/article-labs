+/** Cuántos milisegundos lleva Madrid por delante de UTC en ese instante (1 h en invierno, 2 h en verano). */
+function desfaseMadrid(instante: number): number {
+  const partes = Object.fromEntries(FORMATO_ZONA.formatToParts(new Date(instante)).map((p) => [p.type, p.value]));
+  const comoUtc = Date.UTC(Number(partes.year), Number(partes.month) - 1, Number(partes.day), Number(partes.hour), Number(partes.minute), Number(partes.second));
+  return comoUtc - instante;
+}
+
+/** Instante real (ms desde epoch) de una hora local del club, teniendo en cuenta el cambio de hora. */
+function instanteMadrid(local: string): number {
+  const comoUtc = Date.parse(`${local}:00Z`);
+  const primera = comoUtc - desfaseMadrid(comoUtc);
+  return comoUtc - desfaseMadrid(primera);
+}
+
+/** Horas reales transcurridas entre dos horas locales del club (con el cambio de hora contado). */
+function milisegundosEntre(desde: string, hasta: string): number {
+  return instanteMadrid(hasta) - instanteMadrid(desde);
+}
