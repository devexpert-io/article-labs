@@ -0,0 +1,230 @@
+// Penalizaciones escalonadas, exención por un gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function reservar(api: Api, socioId: string, pistaId: string, inicio: string): Promise<{ id: string; importe: number }> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.reserva;
+}
+
+function cancelar(api: Api, id: string, cuerpo: Record<string, unknown> = {}, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+test("tramos y límites exactos de la penalización", async () => {
+  await conApi(async (api) => {
+    // Jueves 10 de diciembre a las 12:00, valle: 1800 en pistas 1 y 2, 1200 en pista 3.
+    const justo48 = await reservar(api, "socio-041", "pista-1", "2026-12-10T12:00");
+    const menos48 = await reservar(api, "socio-002", "pista-2", "2026-12-10T12:00");
+    const justo24 = await reservar(api, "socio-004", "pista-3", "2026-12-10T12:00");
+    const menos24 = await reservar(api, "socio-005", "pista-1", "2026-12-10T13:30");
+    const mucho = await reservar(api, "socio-003", "pista-2", "2026-12-10T13:30");
+
+    await reloj(api, "2026-12-01T10:00");
+    const holgada = await cancelar(api, mucho.id);
+    assert.equal(holgada.status, 200);
+    assert.equal(holgada.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(holgada.cuerpo.reembolso, 1800);
+
+    await reloj(api, "2026-12-08T12:00");
+    const a48 = await cancelar(api, justo48.id);
+    assert.equal(a48.status, 200);
+    assert.equal(a48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(a48.cuerpo.reembolso, 1800);
+
+    await reloj(api, "2026-12-08T12:01");
+    const casi48 = await cancelar(api, menos48.id);
+    assert.equal(casi48.status, 200);
+    assert.equal(casi48.cuerpo.reserva.penalizacion, 450);
+    assert.equal(casi48.cuerpo.reembolso, 1350);
+
+    await reloj(api, "2026-12-09T12:00");
+    const a24 = await cancelar(api, justo24.id);
+    assert.equal(a24.status, 200, "a 24 horas justas no hace falta forzar");
+    assert.equal(a24.cuerpo.reserva.penalizacion, 300);
+    assert.equal(a24.cuerpo.reembolso, 900);
+
+    await reloj(api, "2026-12-09T13:31");
+    const sinForzar = await cancelar(api, menos24.id);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const noForzada = await cancelar(api, menos24.id, { forzar: false });
+    assert.equal(noForzada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await cancelar(api, menos24.id, { forzar: true });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.estado, "cancelada");
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+  });
+});
+
+test("la antelación se cuenta en horas reales de Madrid, con el cambio de hora", async () => {
+  await conApi(async (api) => {
+    await reloj(api, "2027-03-01T10:00");
+    const domingoNoche = await reservar(api, "socio-041", "pista-1", "2027-03-28T21:00");
+    const domingoManana = await reservar(api, "socio-002", "pista-1", "2027-03-28T09:00");
+    const otono = await reservar(api, "socio-004", "pista-1", "2027-10-31T21:00");
+
+    // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales: 25 %.
+    await reloj(api, "2027-03-26T20:30");
+    const primavera = await cancelar(api, domingoNoche.id);
+    assert.equal(primavera.status, 200);
+    assert.equal(primavera.cuerpo.reserva.penalizacion, 700);
+    assert.equal(primavera.cuerpo.reembolso, 2100);
+
+    // Del sábado 27 a las 08:30 al domingo 28 a las 09:00 hay 23,5 horas reales: hace falta forzar.
+    await reloj(api, "2027-03-27T08:30");
+    const tarde = await cancelar(api, domingoManana.id);
+    assert.equal(tarde.status, 409);
+    assert.equal(tarde.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+
+    // En otoño los relojes se atrasan: del viernes 29 a las 21:30 al domingo 31 a las 21:00 hay 48,5 horas.
+    await reloj(api, "2027-10-29T21:30");
+    const atrasada = await cancelar(api, otono.id);
+    assert.equal(atrasada.status, 200);
+    assert.equal(atrasada.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(atrasada.cuerpo.reembolso, 2800);
+  });
+});
+
+test("un gestor puede eximir de la penalización con un motivo", async () => {
+  await conApi(async (api) => {
+    // R-0520: Marta López, jueves 19 a las 09:00 en la pista 3 (1200), a 23 horas.
+    const motivo = "Lesión justificada con parte médico";
+    const anonimo = await cancelar(api, "R-0520", { exento: true, motivo });
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await cancelar(api, "R-0520", { exento: true, motivo }, "socio-002");
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+    const sinMotivo = await cancelar(api, "R-0520", { exento: true }, GESTOR);
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const corto = await cancelar(api, "R-0520", { exento: true, motivo: "123456789" }, GESTOR);
+    assert.equal(corto.status, 400);
+    assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    assert.equal((await api.pedir("GET", "/api/reservas/R-0520")).cuerpo.reserva.estado, "confirmada");
+
+    const exenta = await cancelar(api, "R-0520", { exento: true, motivo: "1234567890" }, GESTOR);
+    assert.equal(exenta.status, 200, "no hace falta forzar");
+    assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "1234567890");
+    assert.equal(exenta.cuerpo.reembolso, 1200);
+
+    // A un minuto del inicio también se puede eximir.
