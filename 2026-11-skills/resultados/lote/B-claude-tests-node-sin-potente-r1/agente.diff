+test("informe de caja del mes", async () => {
+  await conApi(async (api) => {
+    const anonimo = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-002" });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+    for (const mes of ["", "?mes=2026-1", "?mes=2026-13", "?mes=2026-11-01", "?mes=noviembre"]) {
+      const mal = await api.pedir("GET", `/api/informes/caja${mes}`, { socio: GESTOR });
+      assert.equal(mal.status, 400, mes);
+      assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+
+    // Penalizaciones de noviembre: R-0520 con forzar (600) y una al 25 % en la pista 2 (450).
+    await cancelar(api, "R-0520", { forzar: true });
+    const tardia = await reservar(api, "socio-041", "pista-2", "2026-11-26T12:00");
+    await reloj(api, "2026-11-24T13:00");
+    assert.equal((await cancelar(api, tardia.id)).cuerpo.reserva.penalizacion, 450);
+
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    for (const mes of ["2026-10", "2026-11"]) {
+      const informe = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: GESTOR });
+      assert.equal(informe.status, 200);
+      assert.equal(informe.cuerpo.mes, mes);
+      const delMes = estado.reservas.filter((r: any) => r.inicio.startsWith(mes));
+      const cifras = (rs: any[]) => {
+        const cobradas = rs.filter((r) => r.estado === "confirmada" || r.estado === "no_presentada");
+        const ingresos = cobradas.reduce((s, r) => s + r.importe, 0);
+        const penalizaciones = rs.filter((r) => r.estado === "cancelada").reduce((s, r) => s + (r.penalizacion ?? 0), 0);
+        return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+      };
+      assert.deepEqual(informe.cuerpo.pistas, ["pista-1", "pista-2", "pista-3", "pista-4"].map((pistaId) =>
+        ({ pistaId, ...cifras(delMes.filter((r: any) => r.pistaId === pistaId)) })));
+      assert.deepEqual(informe.cuerpo.total, cifras(delMes));
+    }
+    const noviembre = (await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR })).cuerpo;
+    assert.equal(noviembre.total.penalizaciones, 1050);
+    assert.equal(noviembre.pistas.find((p: any) => p.pistaId === "pista-3").penalizaciones, 600);
+    assert.equal(noviembre.pistas.find((p: any) => p.pistaId === "pista-2").penalizaciones, 450);
+    const octubre = (await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR })).cuerpo;
+    assert.equal(octubre.total.reservas, estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada").length);
+    assert.ok(octubre.pistas.find((p: any) => p.pistaId === "pista-4").reservas > 0);
+
+    const vacio = await api.pedir("GET", "/api/informes/caja?mes=2025-01", { socio: GESTOR });
+    const cero = { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 };
+    assert.deepEqual(vacio.cuerpo, {
+      mes: "2025-01",
+      pistas: ["pista-1", "pista-2", "pista-3", "pista-4"].map((pistaId) => ({ pistaId, ...cero })),
+      total: cero,
+    });
+  });
+});
