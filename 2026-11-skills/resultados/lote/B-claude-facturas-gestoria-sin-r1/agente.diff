@@ -0,0 +1,222 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+/** Cada API de un test empieza de la semilla, para que la numeración no dependa del orden de los tests. */
+async function conApi(entorno: Record<string, string>, cuerpo: (api: Api) => Promise<void>) {
+  const otra = await arrancarApi(entorno);
+  try {
+    await cuerpo(otra);
+  } finally {
+    otra.cerrar();
+  }
+}
+
+test("permisos: solo un gestor genera y consulta facturas", async () => {
+  for (const [metodo, ruta, cuerpo] of [
+    ["POST", "/api/facturas", { mes: "2026-10" }],
+    ["GET", "/api/facturas?mes=2026-10", undefined],
+    ["GET", "/api/facturas/2026-0001", undefined],
+  ] as const) {
+    const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+    assert.equal(anonimo.status, 401, `${metodo} ${ruta}`);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-004" });
+    assert.equal(socio.status, 403, `${metodo} ${ruta}`);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.facturas.length, 0, "sin permiso no se genera nada");
+});
+
+test("mes: formato AAAA-MM y solo meses cerrados", async () => {
+  for (const mes of [undefined, "2026-1", "2026-13", "2026-00", "octubre", 202610]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 400, `mes ${mes}`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026/10", { socio: GESTOR })).status, 400);
+  assert.equal((await api.pedir("GET", "/api/facturas", { socio: GESTOR })).status, 400);
+  for (const mes of ["2026-11", "2026-12"]) {
+    const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(abierto.status, 409);
+    assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await conApi({ AHORA: "2026-11-30T23:59" }, async (otra) => {
+    const r = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+    assert.equal((await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T00:00" } })).status, 200);
+    assert.equal((await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).status, 201);
+  });
+});
+
+test("octubre: una factura por socio con algo que facturar, con sus líneas, total e IVA", async () => {
+  await conApi({}, async (otra) => {
+    const r = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(r.status, 201);
+    const facturas = r.cuerpo.facturas;
+    const reservas = (await otra.pedir("GET", "/_estado")).cuerpo.reservas.filter((x: any) => x.inicio.startsWith("2026-10-"));
+    const facturables = reservas.filter((x: any) => x.estado !== "cancelada");
+
+    // Una por socio con reservas facturables, ordenadas por socio, y ninguna para los demás.
+    const conAlgo = [...new Set(facturables.map((x: any) => x.socioId))].sort();
+    assert.deepEqual(facturas.map((f: any) => f.socioId), conAlgo);
+    assert.equal(facturas.length, 40);
+    assert.ok(!facturas.some((f: any) => f.socioId === "socio-041"), "Nora Benítez no tiene factura");
+
+    // Las canceladas sin penalización no se facturan; confirmadas y no presentadas, sí.
+    const lineas = facturas.flatMap((f: any) => f.lineas);
+    assert.equal(lineas.length, facturables.length);
+    const idsCanceladas = new Set(reservas.filter((x: any) => x.estado === "cancelada").map((x: any) => x.id));
+    assert.ok(!lineas.some((l: any) => idsCanceladas.has(l.reservaId)));
+    assert.ok(lineas.some((l: any) => l.reservaId === "R-0022"), "R-0022 (no presentada) se factura");
+
+    for (const f of facturas) {
+      assert.equal(f.mes, "2026-10");
+      const inicios = f.lineas.map((l: any) => reservas.find((x: any) => x.id === l.reservaId).inicio);
+      assert.deepEqual(inicios, [...inicios].sort(), "líneas por inicio de la reserva");
+      for (const l of f.lineas) {
+        const reserva = reservas.find((x: any) => x.id === l.reservaId);
+        assert.equal(reserva.socioId, f.socioId);
+        assert.equal(l.importe, reserva.importe);
+        assert.equal(typeof l.concepto, "string");
+      }
+      assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+      assert.equal(f.base + f.iva, f.total);
+      assert.equal(f.base, Math.round((f.total * 100) / 121));
+    }
+
+    const primera = facturas[0];
+    assert.equal(primera.numero, "2026-0001");
+    assert.equal(primera.socioId, "socio-001");
+    assert.deepEqual(primera.lineas, [
+      { reservaId: "R-0120", concepto: "Reserva de Pista 1, 2026-10-12 09:00", importe: 1800 },
+      { reservaId: "R-0172", concepto: "Reserva de Pista 2, 2026-10-17 21:00", importe: 2800 },
+      { reservaId: "R-0193", concepto: "Reserva de Pista 4, 2026-10-18 12:00", importe: 2200 },
+    ]);
+    assert.deepEqual({ total: primera.total, base: primera.base, iva: primera.iva }, { total: 6800, base: 5620, iva: 1180 });
+  });
+});
+
+test("redondeo del IVA: la base se redondea al céntimo y el IVA es la diferencia", async () => {
+  await conApi({}, async (otra) => {
+    const { facturas } = (await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR })).cuerpo;
+    // 20400 / 1,21 = 16859,50…: la base sube a 16860 y el IVA se queda en 3540.
+    const marta = facturas.find((f: any) => f.socioId === "socio-002");
+    assert.deepEqual({ total: marta.total, base: marta.base, iva: marta.iva }, { total: 20400, base: 16860, iva: 3540 });
+    // 13800 / 1,21 = 11404,96…: base 11405, IVA 2395.
+    const tercera = facturas.find((f: any) => f.socioId === "socio-003");
+    assert.deepEqual({ total: tercera.total, base: tercera.base, iva: tercera.iva }, { total: 13800, base: 11405, iva: 2395 });
+  });
+});
+
+test("penalizaciones: una cancelación fuera de plazo se factura como penalización", async () => {
+  await conApi({}, async (otra) => {
+    // Marta López cancela fuera de plazo su reserva del jueves 19 (1200 céntimos).
+    const cancelada = await otra.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 1200);
+    // Y otra reserva cancelada a tiempo, que no se factura.
+    const nueva = await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-11-24T12:00" } });
+    await otra.pedir("POST", `/api/reservas/${nueva.cuerpo.reserva.id}/cancelar`);
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T09:00" } });
+    const { facturas } = (await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).cuerpo;
+    const marta = facturas.find((f: any) => f.socioId === "socio-002");
+    const linea = marta.lineas.find((l: any) => l.reservaId === "R-0520");
+    assert.deepEqual(linea, { reservaId: "R-0520", concepto: "Penalización por cancelación fuera de plazo: Pista 3, 2026-11-19 09:00", importe: 1200 });
+    assert.equal(marta.total, marta.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+    assert.ok(!facturas.some((f: any) => f.socioId === "socio-041"), "la cancelación gratuita no se factura");
+  });
