+test("numeración correlativa entre meses y entre años, y generar dos veces no crea nada", async () => {
+  await conApi({}, async (otra) => {
+    // Una reserva en diciembre, para tener algo que facturar ese mes.
+    const diciembre = await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-10T18:00" } });
+    assert.equal(diciembre.status, 201);
+
+    const octubre = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    const numerosOctubre = octubre.cuerpo.facturas.map((f: any) => f.numero);
+    assert.deepEqual(numerosOctubre, Array.from({ length: 40 }, (_, i) => `2026-${String(i + 1).padStart(4, "0")}`));
+
+    // Generar otra vez: 200, las mismas facturas, y ninguna nueva.
+    const repetida = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(repetida.status, 200);
+    assert.deepEqual(repetida.cuerpo.facturas, octubre.cuerpo.facturas);
+    assert.equal((await otra.pedir("GET", "/_estado")).cuerpo.facturas.length, 40);
+
+    // Noviembre sigue la numeración del año.
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-02T10:00" } });
+    const noviembre = (await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).cuerpo.facturas;
+    assert.ok(noviembre.length > 0);
+    assert.deepEqual(noviembre.map((f: any) => f.numero), noviembre.map((_: any, i: number) => `2026-${String(41 + i).padStart(4, "0")}`));
+    assert.deepEqual(noviembre.map((f: any) => f.socioId), noviembre.map((f: any) => f.socioId).sort());
+
+    // Diciembre se factura en enero: la numeración empieza de nuevo con el año.
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-04T09:00" } });
+    const enero = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+    assert.equal(enero.status, 201);
+    assert.deepEqual(enero.cuerpo.facturas.map((f: any) => [f.numero, f.socioId, f.mes]), [["2027-0001", "socio-003", "2026-12"]]);
+
+    // Repetir un mes ya generado en otro año no cambia sus números.
+    const otraVez = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    assert.equal(otraVez.status, 200);
+    assert.deepEqual(otraVez.cuerpo.facturas, noviembre);
+
+    // Sin saltos ni repeticiones en todo lo generado.
+    const todas = (await otra.pedir("GET", "/_estado")).cuerpo.facturas.map((f: any) => f.numero);
+    assert.equal(new Set(todas).size, todas.length);
+    assert.equal(todas.length, 40 + noviembre.length + 1);
+  });
+});
