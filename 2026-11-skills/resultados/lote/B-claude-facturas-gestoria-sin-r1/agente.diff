+/** El primer instante del mes siguiente, AAAA-MM-01T00:00. */
+function inicioDelMesSiguiente(mes: string): string {
+  const [a, m] = mes.split("-").map(Number);
+  const siguiente = m === 12 ? `${a! + 1}-01` : `${String(a).padStart(4, "0")}-${String(m! + 1).padStart(2, "0")}`;
+  return `${siguiente}-01T00:00`;
+}
+
+function mesValido(mes: unknown): string {
+  if (typeof mes !== "string" || !MES.test(mes) || Number(mes.slice(5)) < 1 || Number(mes.slice(5)) > 12) {
+    invalido("mes es obligatorio, con el formato AAAA-MM");
+  }
+  return mes as string;
+}
+
+function exigirGestor(quien: Socio | undefined): void {
+  if (!quien) throw new ErrorDelClub("NO_IDENTIFICADO", "Hace falta la cabecera X-Socio de un gestor", 401);
+  if (quien.rol !== "gestor") throw new ErrorDelClub("SIN_PERMISO", "Solo un gestor puede generar y consultar facturas", 403);
+}
+
+/** Base imponible e IVA de un total con IVA incluido. La base se redondea al céntimo y el IVA es la diferencia. */
+export function desglosarIva(total: number): { base: number; iva: number } {
+  const base = Math.round((total * 100) / (100 + IVA_PORCENTAJE));
+  return { base, iva: total - base };
+}
