@@ -0,0 +1,163 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado, Factura } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+const generar = (api: Api, mes: unknown) => api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+const consultar = (api: Api, mes: string) => api.pedir("GET", `/api/facturas?mes=${mes}`, { socio: gestor });
+const reloj = (api: Api, ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+
+test("todos los endpoints de facturas exigen identidad de gestor", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const [metodo, ruta] of [
+    ["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F-2026-0001"],
+  ]) {
+    for (const [socio, status, codigo] of [
+      [undefined, 401, "NO_IDENTIFICADO"], ["socio-999", 401, "NO_IDENTIFICADO"], ["socio-001", 403, "SIN_PERMISO"],
+    ] as const) {
+      const r = await api.pedir(metodo, ruta, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      assert.equal(r.status, status);
+      assert.equal(r.cuerpo.error.codigo, codigo);
+    }
+  }
+  assert.deepEqual((await consultar(api, "2026-10")).cuerpo, { facturas: [] });
+});
+
+test("el mes se valida y solo se genera tras terminar según el reloj del club", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const mes of [undefined, null, 202610, {}, [], "", "2026-1", "26-10", "2026-00", "2026-13", "2026-10-01", "2026-10 "]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400, JSON.stringify(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const ruta of ["/api/facturas", "/api/facturas?mes=2026-13", "/api/facturas?mes=octubre"]) {
+    const r = await api.pedir("GET", ruta, { socio: gestor });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+    assert.deepEqual((await consultar(api, mes)).cuerpo, { facturas: [] });
+  }
+  await reloj(api, "2026-11-30T23:59");
+  assert.equal((await generar(api, "2026-11")).status, 409);
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+});
+
+test("octubre: una factura por socio, líneas, IVA global, numeración y consultas", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const antes: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const respuesta = await generar(api, "2026-10");
+  assert.equal(respuesta.status, 201);
+  const facturas: Factura[] = respuesta.cuerpo.facturas;
+  const facturables = antes.reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  const socios = [...new Set(facturables.map((r) => r.socioId))].sort();
+  assert.deepEqual(facturas.map((f) => f.socioId), socios);
+  assert.equal(facturas.length, 40);
+  assert.ok(!facturas.some((f) => f.socioId === "socio-041"));
+  let distintoDelRedondeoPorLinea = false;
+  for (const [i, f] of facturas.entries()) {
+    const reservas = facturables.filter((r) => r.socioId === f.socioId)
+      .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+    assert.equal(f.mes, "2026-10");
+    assert.equal(f.numero, `F-2026-${String(i + 1).padStart(4, "0")}`);
+    assert.deepEqual(f.lineas, reservas.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })));
+    assert.equal(f.total, reservas.reduce((s, r) => s + r.importe, 0));
+    // Oráculo entero: redondeo al más próximo de total / 1,21.
+    assert.equal(f.base, Math.floor((f.total * 100 + 60) / 121));
+    assert.equal(f.iva, f.total - f.base);
+    assert.ok([f.total, f.base, f.iva].every(Number.isInteger));
+    if (f.base !== reservas.reduce((s, r) => s + Math.round(r.importe * 100 / 121), 0)) distintoDelRedondeoPorLinea = true;
+    const individual = await api.pedir("GET", `/api/facturas/${f.numero}`, { socio: gestor });
+    assert.equal(individual.status, 200);
+    assert.deepEqual(individual.cuerpo, { factura: f });
+  }
+  assert.ok(distintoDelRedondeoPorLinea, "el historial debe detectar el redondeo incorrecto por línea");
+  assert.deepEqual(facturas[0], {
+    numero: "F-2026-0001", mes: "2026-10", socioId: "socio-001",
+    lineas: [
+      { reservaId: "R-0120", concepto: "Reserva", importe: 1800 },
+      { reservaId: "R-0172", concepto: "Reserva", importe: 2800 },
+      { reservaId: "R-0193", concepto: "Reserva", importe: 2200 },
+    ], total: 6800, base: 5620, iva: 1180,
+  });
+  assert.ok(facturables.some((r) => r.estado === "no_presentada"));
+  assert.deepEqual((await consultar(api, "2026-10")).cuerpo, respuesta.cuerpo);
+  const repetida = await generar(api, "2026-10");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo, respuesta.cuerpo);
+  const despues: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.deepEqual(despues.reservas, antes.reservas);
+  assert.deepEqual(despues.pistas, antes.pistas);
+  assert.deepEqual(despues.socios, antes.socios);
+  assert.equal(despues.contadoresFacturas["2026"], 40);
+  const desconocida = await api.pedir("GET", "/api/facturas/F-2026-9999", { socio: gestor });
+  assert.equal(desconocida.status, 404);
+  assert.equal(desconocida.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("cancelaciones gratuitas y penalizadas se atribuyen al mes de inicio", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const penalizada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(penalizada.status, 200);
+  const crear = async (inicio: string) => {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio } });
+    assert.equal(r.status, 201);
+    return r.cuerpo.reserva;
+  };
+  const gratuita = await crear("2026-12-01T09:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratuita.id}/cancelar`)).status, 200);
+  const diciembre = await crear("2026-12-01T10:30");
+  await reloj(api, "2026-11-30T20:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${diciembre.id}/cancelar`, { cuerpo: { forzar: true } })).status, 200);
+  await reloj(api, "2026-12-01T00:00");
+  const noviembre: Factura[] = (await generar(api, "2026-11")).cuerpo.facturas;
+  const marta = noviembre.find((f) => f.socioId === "socio-002")!;
+  assert.deepEqual(marta.lineas.find((l) => l.reservaId === "R-0520"), {
+    reservaId: "R-0520", concepto: "Penalización", importe: 1200,
+  });
+  assert.ok(!noviembre.some((f) => f.socioId === "socio-041"));
+  await reloj(api, "2027-01-01T00:00");
+  const respuesta = await generar(api, "2026-12");
+  assert.deepEqual(respuesta.cuerpo.facturas, [{
+    numero: "F-2026-0041", mes: "2026-12", socioId: "socio-041",
+    lineas: [{ reservaId: diciembre.id, concepto: "Penalización", importe: 1200 }],
+    total: 1200, base: 992, iva: 208,
+  }]);
+});
+
+test("serie anual sin huecos, meses vacíos, generación concurrente y años independientes", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  assert.equal((await generar(api, "2026-09")).status, 201);
+  const vacio = await generar(api, "2026-09");
+  assert.equal(vacio.status, 200);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  const respuestas = await Promise.all([generar(api, "2026-10"), generar(api, "2026-10")]);
+  assert.deepEqual(respuestas.map((r) => r.status).sort(), [200, 201]);
+  assert.deepEqual(respuestas[0].cuerpo, respuestas[1].cuerpo);
+  await reloj(api, "2026-12-01T00:00");
+  const noviembre: Factura[] = (await generar(api, "2026-11")).cuerpo.facturas;
+  assert.equal(noviembre[0].numero, "F-2026-0041");
+  assert.equal(noviembre.at(-1)!.numero, "F-2026-0080");
+  const crear = async (inicio: string) => {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio } });
+    assert.equal(r.status, 201);
+  };
+  await crear("2026-12-31T21:00");
+  await crear("2027-01-01T09:00");
+  await reloj(api, "2027-02-01T00:00");
+  // Generar primero el nuevo año no reinicia ni consume el contador del anterior.
+  assert.equal((await generar(api, "2027-01")).cuerpo.facturas[0].numero, "F-2027-0001");
+  assert.equal((await generar(api, "2026-12")).cuerpo.facturas[0].numero, "F-2026-0081");
+  assert.deepEqual((await generar(api, "2026-10")).cuerpo, respuestas[0].cuerpo);
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.contadoresFacturas, { "2026": 81, "2027": 1 });
+});
