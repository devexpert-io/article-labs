     estado.reservas.some((r) => r.pistaId === pistaId && r.inicio === inicio && r.estado === "confirmada");
 
   return {
+    generarFacturas(mes: unknown) {
+      validarMes(mes);
+      const existentes = estado.facturasPorMes[mes];
+      if (existentes) return { facturas: existentes, creadas: false };
+      if (mes >= estado.ahora.slice(0, 7)) {
+        throw new ErrorDelClub("MES_ABIERTO", "Solo se pueden facturar meses que ya han terminado");
+      }
+
+      const porSocio = new Map<string, LineaFactura[]>();
+      const reservas = estado.reservas.filter((r) => r.inicio.slice(0, 7) === mes)
+        .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+      for (const r of reservas) {
+        const cancelada = r.estado === "cancelada";
+        const importe = cancelada ? (r.penalizacion ?? 0) : r.importe;
+        if (importe <= 0) continue;
+        const lineas = porSocio.get(r.socioId) ?? [];
+        lineas.push({ reservaId: r.id, concepto: cancelada ? "Penalización" : "Reserva", importe });
+        porSocio.set(r.socioId, lineas);
+      }
+
+      // Criterios provisionales documentados en README: IVA incluido y serie anual.
+      const ano = mes.slice(0, 4);
+      let contador = estado.contadoresFacturas[ano] ?? 0;
+      const facturas: Factura[] = [...porSocio].sort(([a], [b]) => a.localeCompare(b))
+        .map(([socioId, lineas]) => {
+          const total = lineas.reduce((suma, linea) => suma + linea.importe, 0);
+          const base = Math.round(total * 100 / 121);
+          contador += 1;
+          return { numero: `F-${ano}-${String(contador).padStart(4, "0")}`, mes, socioId,
+            lineas, total, base, iva: total - base };
+        });
+      estado.facturasPorMes[mes] = facturas;
+      estado.contadoresFacturas[ano] = contador;
+      return { facturas, creadas: true };
+    },
+
+    listarFacturas(mes: unknown) {
+      validarMes(mes);
+      return { facturas: estado.facturasPorMes[mes] ?? [] };
+    },
+
+    obtenerFactura(numero: string) {
+      const factura = Object.values(estado.facturasPorMes).flat().find((f) => f.numero === numero);
+      if (!factura) throw new ErrorDelClub("FACTURA_NO_ENCONTRADA", `No existe la factura ${numero}`, 404);
+      return { factura };
+    },
+
     listarPistas() {
       return { pistas: estado.pistas };
     },
