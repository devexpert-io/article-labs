+// Penalizaciones escalonadas, exención de gestor e informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040"; // La recepción del club: rol gestor.
+const SOCIO = "socio-041"; // Nora Benítez: cuota al día y sin reservas.
+
+/** Cada prueba arranca su propia API con la semilla nueva. */
+async function conClub(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function fijarAhora(api: Api, ahora: string): Promise<void> {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+/** Crea una reserva de Nora (o del socio indicado) en la franja pedida. */
+async function reservar(api: Api, inicio: string, pistaId = "pista-1", socioId = SOCIO) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva as { id: string; importe: number };
+}
+
+function cancelar(api: Api, id: string, cuerpo: unknown = {}, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+async function estadoDe(api: Api, id: string) {
+  const r = await api.pedir("GET", `/api/reservas/${id}`);
+  assert.equal(r.status, 200);
+  return r.cuerpo.reserva;
+}
+
+// La reserva de estas pruebas es el 25 de noviembre a las 12:00 en la pista 1 (miércoles, precio de valle: 1800).
+
+test("C1 · con 72 horas de antelación no hay penalización y se devuelve todo", () =>
+  conClub(async (api) => {
+    const r = await reservar(api, "2026-11-25T12:00");
+    await fijarAhora(api, "2026-11-22T12:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.estado, "cancelada");
+    assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c.cuerpo.reembolso, 1800);
+  }));
+
+test("C1 · entre 24 y 48 horas de antelación, la penalización es el 25 % del importe", () =>
+  conClub(async (api) => {
+    const r = await reservar(api, "2026-11-25T12:00");
+    await fijarAhora(api, "2026-11-23T13:00"); // 47 horas
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, 450);
+    assert.equal(c.cuerpo.reembolso, 1350);
+  }));
+
+test("C1 · con menos de 24 horas, sin forzar es 409 FUERA_DE_PLAZO y con forzar se cobra el 50 %", () =>
+  conClub(async (api) => {
+    const r = await reservar(api, "2026-11-25T12:00");
+    await fijarAhora(api, "2026-11-24T13:00"); // 23 horas
+    const sinForzar = await cancelar(api, r.id);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    assert.equal((await estadoDe(api, r.id)).estado, "confirmada");
+    const forzada = await cancelar(api, r.id, { forzar: true });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+  }));
+
+test("C2 · a 48 horas justas no hay penalización", () =>
+  conClub(async (api) => {
+    const r = await reservar(api, "2026-11-25T12:00");
+    await fijarAhora(api, "2026-11-23T12:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c.cuerpo.reembolso, 1800);
+  }));
+
+test("C2 · a 47 horas y 59 minutos ya hay penalización del 25 %", () =>
+  conClub(async (api) => {
+    const r = await reservar(api, "2026-11-25T12:00");
+    await fijarAhora(api, "2026-11-23T12:01");
