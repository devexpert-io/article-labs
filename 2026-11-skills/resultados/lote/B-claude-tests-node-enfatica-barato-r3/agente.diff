+
+test("C3 · el cambio de hora de marzo también cuenta para el tramo de 24 horas", () =>
+  conClub(async (api) => {
+    // Del sábado 27 a las 21:00 al domingo 28 a las 21:00 hay 23 horas reales (24 en el reloj de pared).
+    const r = await reservar(api, "2027-03-28T21:00");
+    await fijarAhora(api, "2027-03-27T21:00");
+    const sinForzar = await cancelar(api, r.id);
+    assert.equal(sinForzar.status, 409);
