+// La política escalonada de cancelación, la exención y el informe de caja, probadas por la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(fn: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("cancelar escala la penalización según la antelación", async () => {
+  await conApi(async (api) => {
+    // Ahora: 2026-11-18T10:00. R-0520 empieza el 19 a las 09:00 (faltan 23 h): tramo del 50 %.
+    const fuera = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(fuera.status, 409);
+    assert.equal(fuera.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 600); // 50 % de 1200
+    assert.equal(forzada.cuerpo.reembolso, 600);
+
+    // Entre 24 y 48 h: el 19 a las 18:00 faltan 32 h → 25 %.
+    const parcial = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-006", pistaId: "pista-3", inicio: "2026-11-19T18:00" } });
+    assert.equal(parcial.status, 201);
+    const c25 = await api.pedir("POST", `/api/reservas/${parcial.cuerpo.reserva.id}/cancelar`);
+    assert.equal(c25.cuerpo.reserva.penalizacion, 500); // 25 % de 2000
+    assert.equal(c25.cuerpo.reembolso, 1500);
+
+    // 48 h o más: el 20 a las 18:00 faltan 56 h → gratis.
+    const lejos = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-006", pistaId: "pista-3", inicio: "2026-11-20T18:00" } });
+    const gratis = await api.pedir("POST", `/api/reservas/${lejos.cuerpo.reserva.id}/cancelar`);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, 2000);
+  });
+});
+
+test("límites exactos: a 48 h no hay penalización y a 24 h se aplica el 25 %", async () => {
+  await conApi(async (api) => {
+    // A las 48 h justas.
+    const r48 = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-006", pistaId: "pista-1", inicio: "2026-12-03T09:00" } });
+    assert.equal(r48.status, 201);
+    const c48 = await api.pedir("POST", `/api/reservas/${r48.cuerpo.reserva.id}/cancelar`);
+    assert.equal(c48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c48.cuerpo.reembolso, 1800);
+
+    // A las 24 h justas: 25 % sin necesidad de forzar.
+    const r24 = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-006", pistaId: "pista-1", inicio: "2026-12-02T09:00" } });
+    const c24 = await api.pedir("POST", `/api/reservas/${r24.cuerpo.reserva.id}/cancelar`);
+    assert.equal(c24.cuerpo.reserva.penalizacion, 450); // 25 % de 1800
+    assert.equal(c24.cuerpo.reembolso, 1350);
+  }, { AHORA: "2026-12-01T09:00" });
+});
+
+test("la antelación cuenta las horas reales de Madrid, con el cambio de hora", async () => {
+  await conApi(async (api) => {
+    // Del viernes 26/03/2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 h (no 48,5),
+    // porque esa madrugada se adelanta una hora. Cae en el tramo del 25 %.
