+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // Quien no es gestor.
+    const r4 = (await crear("socio-023", "2026-11-19T15:00")).cuerpo.reserva;
+    const noGestor = await api.pedir("POST", `/api/reservas/${r4.id}/cancelar`, {
