+    assert.equal(mal.status, 400);
+    assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const sinMes = await api.pedir("GET", "/api/informes/caja", { socio: "socio-040" });
+    assert.equal(sinMes.status, 400);
+    assert.equal(sinMes.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // El mes de octubre se comprueba contra el propio estado de la semilla.
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const mes = "2026-10";
+    const informe = (await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: "socio-040" })).cuerpo;
+    assert.equal(informe.mes, mes);
+    assert.deepEqual(informe.pistas.map((p: any) => p.pistaId), [...estado.pistas].map((p: any) => p.id).sort());
+
+    let reservas = 0;
+    let ingresos = 0;
+    let penalizaciones = 0;
+    for (const p of informe.pistas) {
+      const delMes = estado.reservas.filter((r: any) => r.pistaId === p.pistaId && r.inicio.slice(0, 7) === mes);
+      const cobradas = delMes.filter((r: any) => r.estado === "confirmada" || r.estado === "no_presentada");
+      const canceladas = delMes.filter((r: any) => r.estado === "cancelada");
+      const suma = cobradas.reduce((s: number, r: any) => s + r.importe, 0);
+      const pen = canceladas.reduce((s: number, r: any) => s + (r.penalizacion ?? 0), 0);
+      assert.equal(p.reservas, cobradas.length);
+      assert.equal(p.ingresos, suma);
+      assert.equal(p.penalizaciones, pen);
+      assert.equal(p.total, suma + pen);
+      reservas += cobradas.length;
+      ingresos += suma;
+      penalizaciones += pen;
+    }
+    assert.deepEqual(informe.total, { reservas, ingresos, penalizaciones, total: ingresos + penalizaciones });
+
+    // Un mes sin movimientos trae todas las pistas a cero.
+    const vacio = (await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: "socio-040" })).cuerpo;
+    assert.equal(vacio.pistas.length, estado.pistas.length);
+    assert.deepEqual(vacio.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+    for (const p of vacio.pistas) {
+      assert.equal(p.reservas, 0);
+      assert.equal(p.ingresos, 0);
+      assert.equal(p.penalizaciones, 0);
+      assert.equal(p.total, 0);
+    }
+  });
+});
