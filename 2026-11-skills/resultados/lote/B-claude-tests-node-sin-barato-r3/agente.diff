+// Penalizaciones escalonadas, exención de gestor e informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-041"; // Nora Benítez: sin reservas en la semilla y con la cuota al día.
+const MOTIVO = "Lesión de un socio en la rodilla";
+
+/** Arranca la API con el reloj del club en `ahora` y la cierra al terminar. */
+async function conClub(ahora: string, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi({ AHORA: ahora });
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reservar(api: Api, inicio: string, pistaId = "pista-3", socioId = SOCIO) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva as { id: string; importe: number };
+}
+
+function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+test("tramos: 48 horas o más no penalizan, justo a las 48 horas tampoco", async () => {
+  // Pista 3 un miércoles a las 09:00 (valle, 1200 céntimos). Desde el lunes 07 a las 09:00 hay 48 horas justas.
+  await conClub("2026-12-07T09:00", async (api) => {
+    const r = await reservar(api, "2026-12-09T09:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.estado, "cancelada");
+    assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c.cuerpo.reembolso, 1200);
+  });
+});
+
+test("tramos: entre 24 y 48 horas se cobra el 25 % sin forzar", async () => {
+  await conClub("2026-12-07T10:00", async (api) => {
+    // Faltan 47 horas.
+    const r = await reservar(api, "2026-12-09T09:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, 300);
+    assert.equal(c.cuerpo.reembolso, 900);
+  });
+  await conClub("2026-12-08T09:00", async (api) => {
+    // Exactamente 24 horas: el 25 % y sin forzar.
+    const r = await reservar(api, "2026-12-09T09:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, 300);
+    assert.equal(c.cuerpo.reembolso, 900);
+  });
+});
+
+test("tramos: con menos de 24 horas solo se cancela con forzar, y entonces el 50 %", async () => {
+  await conClub("2026-12-08T09:30", async (api) => {
+    // Faltan 23 horas y media.
+    const r = await reservar(api, "2026-12-09T09:00");
+    const sinForzar = await cancelar(api, r.id);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    assert.equal((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva.estado, "confirmada", "sin forzar no se cancela");
+    const forzada = await cancelar(api, r.id, { forzar: true });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+    assert.equal(forzada.cuerpo.reembolso, 600);
