+    // Faltan 23 horas y media, y aun así no hace falta forzar.
+    const eximida = await cancelar(api, r.id, { exento: true, motivo: MOTIVO }, GESTOR);
+    assert.equal(eximida.status, 200);
+    assert.equal(eximida.cuerpo.reserva.estado, "cancelada");
