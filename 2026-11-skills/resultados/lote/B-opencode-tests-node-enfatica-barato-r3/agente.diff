+test("C7 · informe de caja: solo gestores, por pista y por mes, con reservas, ingresos y penalizaciones", async () => {
+  await conApi(async (api) => {
+    const sinIdentificar = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
+    assert.equal(sinIdentificar.status, 401);
+    assert.deepEqual(sinIdentificar.cuerpo, {
+      error: { codigo: "NO_IDENTIFICADO", mensaje: "Para consultar el informe de caja hay que identificarse" },
+    });
+
+    const sinPermiso = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-001" });
+    assert.equal(sinPermiso.status, 403);
+    assert.deepEqual(sinPermiso.cuerpo, {
+      error: { codigo: "SIN_PERMISO", mensaje: "Solo un gestor puede consultar el informe de caja" },
+    });
+
+    const mesInvalido = await api.pedir("GET", "/api/informes/caja?mes=2026-1", { socio: "socio-040" });
+    assert.equal(mesInvalido.status, 400);
+    assert.deepEqual(mesInvalido.cuerpo, {
+      error: { codigo: "DATOS_INVALIDOS", mensaje: "mes es obligatorio, con el formato AAAA-MM" },
+    });
+
+    const sinMes = await api.pedir("GET", "/api/informes/caja", { socio: "socio-040" });
+    assert.equal(sinMes.status, 400);
+    assert.deepEqual(sinMes.cuerpo, {
+      error: { codigo: "DATOS_INVALIDOS", mensaje: "mes es obligatorio, con el formato AAAA-MM" },
+    });
+
+    const antes = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-040" });
+    assert.equal(antes.status, 200);
+    assert.equal(antes.cuerpo.mes, "2026-11");
+    assert.deepEqual(
+      antes.cuerpo.pistas.map((p: { pistaId: string }) => p.pistaId),
+      ["pista-1", "pista-2", "pista-3", "pista-4"],
+    );
+
+    const cancelada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(cancelada.status, 200);
+
+    const despues = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-040" });
+    assert.equal(despues.status, 200);
+    const pista3Antes = antes.cuerpo.pistas.find((p: { pistaId: string }) => p.pistaId === "pista-3");
+    const pista3Despues = despues.cuerpo.pistas.find((p: { pistaId: string }) => p.pistaId === "pista-3");
+    assert.deepEqual(
+      {
+        reservas: pista3Despues.reservas - pista3Antes.reservas,
+        ingresos: pista3Despues.ingresos - pista3Antes.ingresos,
+        penalizaciones: pista3Despues.penalizaciones - pista3Antes.penalizaciones,
+        total: pista3Despues.total - pista3Antes.total,
+      },
+      { reservas: -1, ingresos: -1200, penalizaciones: 600, total: -600 },
+    );
+    assert.deepEqual(
+      {
+        reservas: despues.cuerpo.total.reservas - antes.cuerpo.total.reservas,
+        ingresos: despues.cuerpo.total.ingresos - antes.cuerpo.total.ingresos,
+        penalizaciones: despues.cuerpo.total.penalizaciones - antes.cuerpo.total.penalizaciones,
+        total: despues.cuerpo.total.total - antes.cuerpo.total.total,
+      },
+      { reservas: -1, ingresos: -1200, penalizaciones: 600, total: -600 },
+    );
+
+    const suma = despues.cuerpo.pistas.reduce(
+      (acumulado: { reservas: number; ingresos: number; penalizaciones: number; total: number }, p: any) => ({
+        reservas: acumulado.reservas + p.reservas,
+        ingresos: acumulado.ingresos + p.ingresos,
+        penalizaciones: acumulado.penalizaciones + p.penalizaciones,
+        total: acumulado.total + p.total,
+      }),
+      { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    );
+    assert.deepEqual(despues.cuerpo.total, suma);
+
+    const vacio = await api.pedir("GET", "/api/informes/caja?mes=2027-01", { socio: "socio-040" });
+    assert.equal(vacio.status, 200);
+    assert.deepEqual(vacio.cuerpo, {
+      mes: "2027-01",
+      pistas: [
+        { pistaId: "pista-1", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+        { pistaId: "pista-2", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+        { pistaId: "pista-3", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+        { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+      ],
+      total: { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    });
+  });
+});
