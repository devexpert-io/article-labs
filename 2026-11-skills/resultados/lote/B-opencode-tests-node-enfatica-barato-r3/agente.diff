@@ -0,0 +1,294 @@
+// Penalizaciones escalonadas, exenciones e informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Arranca una API nueva (semilla y reloj limpios) y la cierra al terminar. */
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}): Promise<void> {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const RESERVA_MARTA = {
+  id: "R-0520",
+  socioId: "socio-002",
+  pistaId: "pista-3",
+  inicio: "2026-11-19T09:00",
+  fin: "2026-11-19T10:30",
+  estado: "cancelada",
+  importe: 1200,
+  notas: "",
+};
+
+test("C1 · tramos: 48 horas o más sin penalización, entre 48 y 24 el 25 %, y por debajo el 50 % solo con forzar", async () => {
+  await conApi(async (api) => {
+    const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-16T09:00" } });
+    assert.equal(reloj.status, 200);
+    const lejos = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(lejos.status, 200);
+    assert.deepEqual(lejos.cuerpo.reserva, RESERVA_MARTA);
+    assert.equal(lejos.cuerpo.reembolso, 1200);
+  });
+
+  await conApi(async (api) => {
+    const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T03:00" } });
+    assert.equal(reloj.status, 200);
+    const medio = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(medio.status, 200);
+    assert.deepEqual(medio.cuerpo.reserva, { ...RESERVA_MARTA, penalizacion: 300 });
+    assert.equal(medio.cuerpo.reembolso, 900);
+  });
+
+  await conApi(async (api) => {
+    const sinForzar = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(sinForzar.status, 409);
+    assert.deepEqual(sinForzar.cuerpo, {
+      error: {
+        codigo: "FUERA_DE_PLAZO",
+        mensaje: "Faltan 23 horas para la reserva: con menos de 24 horas hay que forzar y se cobra una penalización del 50 % del importe.",
+      },
+    });
+    const conForzar = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(conForzar.status, 200);
+    assert.deepEqual(conForzar.cuerpo.reserva, { ...RESERVA_MARTA, penalizacion: 600 });
+    assert.equal(conForzar.cuerpo.reembolso, 600);
+  });
+});
+
+test("C2 · límites exactos: a 48 horas no hay penalización y a 24 horas se aplica el 25 % sin forzar", async () => {
+  await conApi(async (api) => {
+    const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-17T09:00" } });
+    assert.equal(reloj.status, 200);
+    const exacto48 = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(exacto48.status, 200);
+    assert.deepEqual(exacto48.cuerpo.reserva, RESERVA_MARTA);
+    assert.equal(exacto48.cuerpo.reembolso, 1200);
+  });
+
+  await conApi(async (api) => {
+    const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T09:00" } });
+    assert.equal(reloj.status, 200);
+    const exacto24 = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(exacto24.status, 200);
+    assert.deepEqual(exacto24.cuerpo.reserva, { ...RESERVA_MARTA, penalizacion: 300 });
+    assert.equal(exacto24.cuerpo.reembolso, 900);
+  });
+});
+
+test("C3 · cambio de hora: del viernes 26 de marzo de 2027 al domingo 28 a las 21:00 faltan 47,5 horas", async () => {
+  await conApi(async (api) => {
+    const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-26T20:30" } });
+    assert.equal(reloj.status, 200);
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: "2027-03-28T21:00" },
+    });
+    assert.equal(creada.status, 201);
+    assert.equal(creada.cuerpo.reserva.importe, 2800);
+    const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  });
+});
+
+test("C4 · reembolso: es el importe menos la penalización", async () => {
+  await conApi(async (api) => {
+    const cancelada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reembolso, cancelada.cuerpo.reserva.importe - cancelada.cuerpo.reserva.penalizacion);
+    assert.equal(cancelada.cuerpo.reembolso, 600);
+  });
+});
+
+test("C5 · exención: un gestor cancela sin penalización con motivo, y los demás reciben su error", async () => {
+  await conApi(async (api) => {
+    const motivo = "Lesión del socio titular";
+    const corto = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      cuerpo: { exento: true, motivo: "corto" },
+      socio: "socio-040",
+    });
+    assert.equal(corto.status, 400);
+    assert.deepEqual(corto.cuerpo, {
+      error: { codigo: "DATOS_INVALIDOS", mensaje: "Para eximir de la penalización hace falta un motivo de al menos 10 caracteres" },
+    });
+
+    const sinMotivo = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      cuerpo: { exento: true },
+      socio: "socio-040",
+    });
+    assert.equal(sinMotivo.status, 400);
+    assert.deepEqual(sinMotivo.cuerpo, {
+      error: { codigo: "DATOS_INVALIDOS", mensaje: "Para eximir de la penalización hace falta un motivo de al menos 10 caracteres" },
+    });
+
+    const sinPermiso = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      cuerpo: { exento: true, motivo },
+      socio: "socio-001",
+    });
+    assert.equal(sinPermiso.status, 403);
+    assert.deepEqual(sinPermiso.cuerpo, {
+      error: { codigo: "SIN_PERMISO", mensaje: "Solo un gestor puede eximir de la penalización" },
+    });
+
+    const sinIdentificar = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      cuerpo: { exento: true, motivo },
+    });
+    assert.equal(sinIdentificar.status, 401);
