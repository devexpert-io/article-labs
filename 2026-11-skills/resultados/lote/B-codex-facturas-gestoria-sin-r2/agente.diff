@@ -0,0 +1,136 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Factura, Reserva } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+async function iniciar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+const generar = (api: Api, mes: unknown) => api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+const reloj = (api: Api, ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+
+// Los conceptos, el IVA y el formato de numeración son supuestos documentados en README.
+test("facturas: permisos en las tres rutas, antes de validar los datos", async (t) => {
+  const api = await iniciar(t);
+  for (const [metodo, ruta] of [
+    ["POST", "/api/facturas"],
+    ["GET", "/api/facturas?mes=2026-10"],
+    ["GET", "/api/facturas/F-2026-0001"],
+  ]) {
+    for (const socio of [undefined, "socio-999", "socio-001"]) {
+      const r = await api.pedir(metodo!, ruta!, { socio });
+      assert.equal(r.status, socio === "socio-001" ? 403 : 401);
+      assert.equal(r.cuerpo.error.codigo, socio === "socio-001" ? "SIN_PERMISO" : "NO_IDENTIFICADO");
+    }
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).status, 200);
+});
+
+test("facturas: valida meses y usa exclusivamente el reloj del club para el cierre", async (t) => {
+  const api = await iniciar(t);
+  for (const mes of [undefined, null, 202610, {}, [], "", "2026-1", "26-10", "2026-00", "2026-13", "2026-10-01", " 2026-10"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const ruta of ["/api/facturas", "/api/facturas?mes=2026-00", "/api/facturas?mes=2026-13"]) {
+    const r = await api.pedir("GET", ruta, { socio: gestor });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj(api, "2026-10-31T23:59");
+  assert.equal((await generar(api, "2026-10")).status, 409);
+  await reloj(api, "2026-11-01T00:00");
+  assert.equal((await generar(api, "2026-10")).status, 201);
+});
+
+test("facturas: octubre incluye cada reserva cobrada, ordena socios y líneas y desglosa el IVA global", async (t) => {
+  const api = await iniciar(t);
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const reservas: Reserva[] = estado.reservas;
+  const octubre = reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(octubre.some((r) => r.estado === "no_presentada"));
+  const antes = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor });
+  assert.deepEqual(antes.cuerpo, { facturas: [] });
+  const r = await generar(api, "2026-10");
+  assert.equal(r.status, 201);
+  const facturas: Factura[] = r.cuerpo.facturas;
+  const socios = [...new Set(octubre.map((r) => r.socioId))].sort();
+  assert.deepEqual(facturas.map((f) => f.socioId), socios);
+  assert.ok(!socios.includes("socio-041"));
+  let distingueRedondeo = false;
+  for (const [i, f] of facturas.entries()) {
+    const suyas = octubre.filter((r) => r.socioId === f.socioId)
+      .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+    assert.deepEqual(f.lineas, suyas.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })));
+    assert.equal(f.numero, `F-2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.mes, "2026-10");
+    const total = suyas.reduce((s, r) => s + r.importe, 0);
+    assert.equal(f.total, total);
+    assert.equal(f.base, Math.round(total * 100 / 121));
+    assert.equal(f.iva, total - f.base);
+    assert.ok([f.base, f.iva, f.total].every(Number.isInteger));
+    if (suyas.reduce((s, r) => s + Math.round(r.importe * 100 / 121), 0) !== f.base) distingueRedondeo = true;
+    const consulta = await api.pedir("GET", `/api/facturas/${f.numero}`, { socio: gestor });
+    assert.equal(consulta.status, 200);
+    assert.deepEqual(consulta.cuerpo, { factura: f });
+  }
+  assert.ok(distingueRedondeo, "El historial distingue redondear por factura de redondear por línea");
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).cuerpo, r.cuerpo);
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, reservas);
+  const noExiste = await api.pedir("GET", "/api/facturas/F-2026-9999", { socio: gestor });
+  assert.equal(noExiste.status, 404);
+  assert.equal(noExiste.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("facturas: cancelación gratuita excluida y penalización facturada por inicio, sin cambiar reservas", async (t) => {
+  const api = await iniciar(t);
+  const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  const reserva = forzada.cuerpo.reserva;
+  assert.equal(reserva.penalizacion, 1200);
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-12-01T09:00" } });
+  assert.equal(creada.status, 201);
+  const gratis = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+  assert.equal(gratis.status, 200);
+  await reloj(api, "2026-12-01T00:00");
+  const noviembre = await generar(api, "2026-11");
+  assert.equal(noviembre.status, 201);
+  const f = noviembre.cuerpo.facturas.find((f: Factura) => f.socioId === reserva.socioId);
+  assert.deepEqual(f.lineas.filter((l: any) => l.reservaId === reserva.id), [
+    { reservaId: reserva.id, concepto: "Penalización por cancelación", importe: 1200 },
+  ]);
+  assert.equal((await api.pedir("GET", `/api/reservas/${reserva.id}`)).cuerpo.reserva.estado, "cancelada");
+  await reloj(api, "2027-01-01T00:00");
+  assert.deepEqual((await generar(api, "2026-12")).cuerpo, { facturas: [] });
+});
+
+test("facturas: repetición concurrente, meses vacíos y contadores independientes por año del mes", async (t) => {
+  const api = await iniciar(t);
+  const [a, b] = await Promise.all([generar(api, "2026-10"), generar(api, "2026-10")]);
+  assert.deepEqual([a.status, b.status].sort(), [200, 201]);
+  assert.deepEqual(a.cuerpo, b.cuerpo);
+  assert.equal((await generar(api, "2026-09")).status, 201);
+  assert.equal((await generar(api, "2026-09")).status, 200);
+  await reloj(api, "2027-01-01T00:00");
+  const noviembre = await generar(api, "2026-11");
+  assert.equal(noviembre.cuerpo.facturas[0].numero, `F-2026-${String(a.cuerpo.facturas.length + 1).padStart(4, "0")}`);
+  const nueva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-01-02T09:00" } });
+  assert.equal(nueva.status, 201);
+  await reloj(api, "2027-02-01T00:00");
+  const enero = await generar(api, "2027-01");
+  assert.equal(enero.cuerpo.facturas[0].numero, "F-2027-0001");
+  assert.deepEqual((await generar(api, "2026-10")).cuerpo, a.cuerpo);
+  await reloj(api, "2026-10-01T00:00");
+  const repetida = await generar(api, "2026-10");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo, a.cuerpo);
+});
