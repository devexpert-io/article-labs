+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import type { Estado } from "../src/tipos.ts";
+
+async function iniciar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { ahora });
+}
+
+async function crear(api: Api, inicio = "2027-03-28T21:00", pistaId = "pista-1") {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId, inicio } });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.inicio, inicio);
+  return r.cuerpo.reserva;
+}
+
+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+  assert.equal(typeof r.cuerpo.error.mensaje, "string");
+}
+
+for (const [ahora, porcentaje, forzar] of [
+  ["2027-03-25T21:00", 0, false],
+  ["2027-03-27T09:00", 0.25, false],
+  ["2027-03-28T20:59", 0.5, true],
+] as const) {
+  test(`C1 · tramo del ${porcentaje * 100} % y consentimiento para cancelar`, async (t) => {
+    const api = await iniciar(t);
+    const reserva = await crear(api);
+    await reloj(api, ahora);
+    if (forzar) {
+      for (const cuerpo of [{}, { forzar: false }]) {
+        error(await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo }), 409, "FUERA_DE_PLAZO");
+      }
+      const intacta = await api.pedir("GET", `/api/reservas/${reserva.id}`);
+      assert.equal(intacta.status, 200);
+      assert.deepEqual(intacta.cuerpo, { reserva });
+    }
+    const r = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar } });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, {
+      reserva: { ...reserva, estado: "cancelada", penalizacion: reserva.importe * porcentaje },
+      reembolso: reserva.importe * (1 - porcentaje),
+    });
+  });
+}
+
+for (const [ahora, porcentaje] of [
+  ["2027-01-08T21:00", 0],
+  ["2027-01-08T21:01", 0.25],
+  ["2027-01-09T21:00", 0.25],
