+  assert.equal(estadoRespuesta.status, 200);
+  const estado: Estado = estadoRespuesta.cuerpo;
+  assert.ok(estado.reservas.some((r) => r.estado === "no_presentada" && r.inicio.startsWith("2026-10")));
+  const pistas = estado.pistas.map((p) => {
+    const cobradas = estado.reservas.filter((r) => r.pistaId === p.id && r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+    const ingresos = cobradas.reduce((suma, r) => suma + r.importe, 0);
+    return { pistaId: p.id, reservas: cobradas.length, ingresos, penalizaciones: 0, total: ingresos };
+  });
+  const ingresos = pistas.reduce((suma, p) => suma + p.ingresos, 0);
+  const r = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-040" });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { mes: "2026-10", pistas, total: { reservas: pistas.reduce((suma, p) => suma + p.reservas, 0), ingresos, penalizaciones: 0, total: ingresos } });
