--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,175 @@
+// Facturas mensuales de la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-001";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+interface Linea {
+  reservaId: string;
+  concepto: string;
+  importe: number;
+}
+interface Factura {
+  numero: string;
+  mes: string;
+  socioId: string;
+  lineas: Linea[];
+  total: number;
+  base: number;
+  iva: number;
+}
+
+function facturable(r: { estado: string; penalizacion?: number }): boolean {
+  return r.estado !== "cancelada" || (typeof r.penalizacion === "number" && r.penalizacion > 0);
+}
+
+async function reservasDelMes(mes: string) {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  return estado.reservas.filter((r: { inicio: string }) => r.inicio.startsWith(mes));
+}
+
+test("solo un gestor genera y consulta facturas", async () => {
+  const sin = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+  assert.equal(sin.status, 401);
+  assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const noGestor = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: SOCIO });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10")).status, 401);
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: SOCIO })).status, 403);
+  assert.equal((await api.pedir("GET", "/api/facturas/FAC-2026-0001")).status, 401);
+  assert.equal((await api.pedir("GET", "/api/facturas/FAC-2026-0001", { socio: SOCIO })).status, 403);
+});
+
+test("mes con formato AAAA-MM y ya terminado", async () => {
+  for (const mes of ["2026-13", "2026-00", "octubre", "2026/10"]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 400, `mes ${mes} debe dar 400`);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+  assert.equal(abierto.status, 409);
+  assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+  const futuro = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+  assert.equal(futuro.status, 409);
+  assert.equal(futuro.cuerpo.error.codigo, "MES_ABIERTO");
+});
+
+test("genera una factura por socio con algo que facturar, ordenadas por id", async () => {
+  const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(r.status, 201);
+  const facturas: Factura[] = r.cuerpo.facturas;
+  assert.ok(facturas.length > 0);
+
+  const delMes = await reservasDelMes("2026-10");
+  const esperados = [...new Set(delMes.filter(facturable).map((x: { socioId: string }) => x.socioId))].sort();
+  assert.deepEqual(facturas.map((f) => f.socioId), esperados, "una factura por cada socio con algo que facturar, ordenadas por id");
+});
+
+test("cada factura tiene líneas, total, base e iva correctos", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const facturas: Factura[] = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas;
+  for (const f of facturas) {
+    assert.equal(f.mes, "2026-10");
+    assert.ok(/^FAC-\d{4}-\d{4}$/.test(f.numero), `numero con formato: ${f.numero}`);
+    const total = f.lineas.reduce((s, l) => s + l.importe, 0);
+    assert.equal(f.total, total, "total es la suma de las líneas");
+    assert.equal(f.base, Math.round((f.total * 100) / 121), "base = total / 1,21 redondeado");
+    assert.equal(f.iva, f.total - f.base, "iva = total - base");
+    // Líneas ordenadas por el inicio de la reserva.
+    const inicios = f.lineas.map((l) => estado.reservas.find((x: { id: string }) => x.id === l.reservaId).inicio);
+    assert.deepEqual(inicios, [...inicios].sort(), "líneas ordenadas por el inicio de la reserva");
+  }
+});
+
+test("numeración correlativa por año, sin saltos ni repeticiones", async () => {
+  const facturas: Factura[] = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas;
+  assert.equal(facturas[0].numero, "FAC-2026-0001");
+  for (let i = 1; i < facturas.length; i++) {
+    const anterior = Number(facturas[i - 1].numero.split("-").pop());
+    const actual = Number(facturas[i].numero.split("-").pop());
+    assert.equal(actual, anterior + 1, "números correlativos sin saltos");
+  }
+});
+
+test("generar dos veces devuelve las mismas facturas", async () => {
+  const primera: Factura[] = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas;
+  const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo.facturas, primera, "mismas facturas y números");
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.facturas.filter((f: Factura) => f.mes === "2026-10").length, primera.length, "no crea facturas nuevas");
+});
+
+test("consultar facturas de un mes y una factura por número", async () => {
+  const facturas: Factura[] = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas;
+  assert.ok(facturas.length > 0);
+  const vacio = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+  assert.equal(vacio.status, 200);
+  assert.deepEqual(vacio.cuerpo.facturas, []);
+  const una = await api.pedir("GET", `/api/facturas/${facturas[0].numero}`, { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.equal(una.cuerpo.factura.numero, facturas[0].numero);
+  const inexistente = await api.pedir("GET", "/api/facturas/FAC-9999-9999", { socio: GESTOR });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("las penalizaciones entran en la factura como líneas", async () => {
+  const otra = await arrancarApi();
+  try {
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-10-20T10:00" } });
+    const estado = (await otra.pedir("GET", "/_estado")).cuerpo;
+    const objetivo = estado.reservas.find(
+      (r: { estado: string; inicio: string }) => r.estado === "confirmada" && r.inicio > "2026-10-20T10:00" && r.inicio < "2026-10-21T10:00",
+    );
+    assert.ok(objetivo, "hay una reserva confirmada en octubre para penalizar");
+    const cancelada = await otra.pedir("POST", `/api/reservas/${objetivo.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, objetivo.importe);
+
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:00" } });
+    const facturas: Factura[] = (await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR })).cuerpo.facturas;
+    const f = facturas.find((x) => x.socioId === objetivo.socioId);
+    const linea = f!.lineas.find((l) => l.reservaId === objetivo.id);
+    assert.equal(linea!.concepto, "Penalización");
+    assert.equal(linea!.importe, objetivo.importe);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("la numeración continúa entre meses y se reinicia cada año", async () => {
+  const otra = await arrancarApi();
+  try {
+    const octubre: Factura[] = (await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR })).cuerpo.facturas;
+    const ultimoOctubre = Number(octubre.at(-1)!.numero.split("-").pop());
+
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T10:00" } });
+    const noviembre: Factura[] = (await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR })).cuerpo.facturas;
+    assert.equal(Number(noviembre[0].numero.split("-").pop()), ultimoOctubre + 1, "noviembre continúa la numeración de octubre");
+    assert.ok(noviembre.every((f) => f.numero.startsWith("FAC-2026-")));
+
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-05T10:00" } });
+    const creada = await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2027-01-10T09:00" } });
+    assert.equal(creada.status, 201);
+
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-01T10:00" } });
+    const enero: Factura[] = (await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2027-01" }, socio: GESTOR })).cuerpo.facturas;
