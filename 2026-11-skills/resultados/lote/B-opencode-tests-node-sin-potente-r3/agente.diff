+// La política de cancelación escalonada, la exención y el informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Nora Benítez no tiene reservas en la semilla: así cada test empieza limpio.
+const SOCIO = "socio-041";
+
+async function crearReserva(api: Api, inicio: string, pistaId = "pista-2") {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIO, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva as { id: string; importe: number };
+}
+
+test("tramos: 48 h o más gratis, de 24 a 48 h el 25 % y menos de 24 h el 50 % con forzar", async () => {
+  const api = await arrancarApi({ AHORA: "2027-11-15T09:00" });
+  try {
+    const a = await crearReserva(api, "2027-11-18T09:00"); // 72 h antes
+    const b = await crearReserva(api, "2027-11-16T16:30"); // 31,5 h antes
+    const c = await crearReserva(api, "2027-11-15T18:00"); // 9 h antes
+
+    const ra = await api.pedir("POST", `/api/reservas/${a.id}/cancelar`);
+    assert.equal(ra.status, 200);
+    assert.equal(ra.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(ra.cuerpo.reembolso, a.importe);
+
+    const rb = await api.pedir("POST", `/api/reservas/${b.id}/cancelar`);
+    assert.equal(rb.cuerpo.reserva.penalizacion, Math.round(b.importe * 0.25));
+    assert.equal(rb.cuerpo.reembolso, b.importe - Math.round(b.importe * 0.25));
+
+    const sinForzar = await api.pedir("POST", `/api/reservas/${c.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+
+    const rc = await api.pedir("POST", `/api/reservas/${c.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(rc.cuerpo.reserva.penalizacion, Math.round(c.importe * 0.5));
+    assert.equal(rc.cuerpo.reembolso, c.importe - Math.round(c.importe * 0.5));
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("límites exactos: a 48 h justas no hay penalización y a 24 h justas se aplica el 25 %", async () => {
+  const api = await arrancarApi({ AHORA: "2027-11-15T09:00" });
+  try {
+    const a = await crearReserva(api, "2027-11-17T09:00"); // 48 h justas
+    const b = await crearReserva(api, "2027-11-16T09:00"); // 24 h justas
+
+    const ra = await api.pedir("POST", `/api/reservas/${a.id}/cancelar`);
+    assert.equal(ra.status, 200);
+    assert.equal(ra.cuerpo.reserva.penalizacion, undefined);
+
+    const rb = await api.pedir("POST", `/api/reservas/${b.id}/cancelar`);
+    assert.equal(rb.status, 200);
+    assert.equal(rb.cuerpo.reserva.penalizacion, Math.round(b.importe * 0.25));
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("cambio de hora: de viernes 20:30 a domingo 21:00 hay 47,5 horas reales (25 %)", async () => {
+  const api = await arrancarApi({ AHORA: "2027-03-26T20:30" });
+  try {
+    const r = await crearReserva(api, "2027-03-28T21:00");
+    const res = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    // Sin el cambio de hora serían 48,5 h; con él, 47,5 h: menos de 48, así que 25 %.
+    assert.equal(res.status, 200);
+    assert.equal(res.cuerpo.reserva.penalizacion, Math.round(r.importe * 0.25));
+    assert.equal(res.cuerpo.reembolso, r.importe - Math.round(r.importe * 0.25));
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("exención: solo un gestor, con un motivo de al menos 10 caracteres", async () => {
