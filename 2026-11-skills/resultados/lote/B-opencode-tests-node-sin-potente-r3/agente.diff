+  }
+});
+
+test("informe de caja: permisos, formato y contenido", async () => {
+  const api = await arrancarApi();
+  try {
+    const sin = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
+    assert.equal(sin.status, 401);
+    assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const socio = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-001" });
