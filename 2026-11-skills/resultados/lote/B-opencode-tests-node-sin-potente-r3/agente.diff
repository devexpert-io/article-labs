+
+test("una reserva que ya ha empezado no se cancela, tampoco con exento", async () => {
+  const api = await arrancarApi({ AHORA: "2027-11-15T09:00" });
+  try {
+    const r = await crearReserva(api, "2027-11-15T18:00");
