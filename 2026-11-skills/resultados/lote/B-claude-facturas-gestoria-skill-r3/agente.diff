diff --git a/test/facturas.test.ts b/test/facturas.test.ts
new file mode 100644
index 0000000..e88fe99
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,175 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const generar = (api: Api, mes: unknown) => api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+const reloj = (api: Api, ahora: string) => api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+async function reservar(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+}
+
+test("solo un gestor genera y consulta facturas", () => conApi(async (api) => {
+  const peticiones: [string, string, unknown?][] = [
+    ["POST", "/api/facturas", { mes: "2026-10" }],
+    ["GET", "/api/facturas?mes=2026-10"],
+    ["GET", "/api/facturas/F2026-0001"],
+  ];
+  for (const [metodo, ruta, cuerpo] of peticiones) {
+    const anonima = await api.pedir(metodo, ruta, { cuerpo });
+    assert.equal(anonima.status, 401, ruta);
+    assert.equal(anonima.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-001" });
+    assert.equal(socio.status, 403, ruta);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  // Nada de lo anterior ha generado facturas.
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.facturas, []);
+}));
+
+test("solo se factura un mes cerrado y con formato AAAA-MM", () => conApi(async (api) => {
+  for (const mes of [undefined, "2026-1", "2026-13", "2026-00", "2026-10-01", 202610]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=octubre", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409, mes);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+}));
+
+test("octubre de 2026: una factura por socio, con sus líneas, total, base e IVA", () => conApi(async (api) => {
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo;
+  const respuesta = await generar(api, "2026-10");
+  assert.equal(respuesta.status, 201);
+  const facturas = respuesta.cuerpo.facturas;
+
+  // Lo esperado, calculado aparte desde las reservas de la semilla.
+  const deOctubre = antes.reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+  const facturables = deOctubre.filter((r: any) => r.estado !== "cancelada" || r.penalizacion > 0);
+  const socios = [...new Set(facturables.map((r: any) => r.socioId))].sort();
+  assert.ok(socios.length > 10);
+  assert.deepEqual(facturas.map((f: any) => f.socioId), socios, "una por socio con algo que facturar, por orden de id");
+  assert.deepEqual(facturas.map((f: any) => f.numero), socios.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+
+  for (const f of facturas) {
+    assert.equal(f.mes, "2026-10");
+    const suyas = facturables
+      .filter((r: any) => r.socioId === f.socioId)
+      .sort((a: any, b: any) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+    assert.deepEqual(f.lineas, suyas.map((r: any) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })));
+    const total = suyas.reduce((s: number, r: any) => s + r.importe, 0);
+    assert.equal(f.total, total);
+    assert.equal(f.base, Math.round((total * 100) / 121));
+    assert.equal(f.base + f.iva, f.total);
+  }
+  // Las canceladas sin penalización no entran y las no presentadas sí.
+  const lineas = new Set(facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId)));
+  const canceladas = deOctubre.filter((r: any) => r.estado === "cancelada");
+  const noPresentadas = deOctubre.filter((r: any) => r.estado === "no_presentada");
+  assert.ok(canceladas.length > 0 && noPresentadas.length > 0);
+  for (const r of canceladas) assert.ok(!lineas.has(r.id), r.id);
+  for (const r of noPresentadas) assert.ok(lineas.has(r.id), r.id);
+  // Los socios sin reservas ese mes no llevan factura.
+  assert.ok(!facturas.some((f: any) => f.socioId === "socio-041"));
+
+  // Generar otra vez: las mismas facturas, sin crear ninguna.
+  const otra = await generar(api, "2026-10");
+  assert.equal(otra.status, 200);
+  assert.deepEqual(otra.cuerpo.facturas, facturas);
+  const despues = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(despues.facturas.length, facturas.length);
+  // Facturar no toca las reservas.
+  assert.deepEqual(despues.reservas, antes.reservas);
+
+  // Consultar.
+  const listadas = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(listadas.status, 200);
+  assert.deepEqual(listadas.cuerpo.facturas, facturas);
+  const una = await api.pedir("GET", `/api/facturas/${facturas[2].numero}`, { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo.factura, facturas[2]);
+  const vacia = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+  assert.deepEqual(vacia.cuerpo, { facturas: [] });
+  const noExiste = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+  assert.equal(noExiste.status, 404);
+  assert.equal(noExiste.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+}));
+
+test("las cancelaciones con penalización entran como Penalización y las gratuitas no", () => conApi(async (api) => {
+  const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1200);
+  const gratis = await reservar(api, "socio-003", "pista-3", "2026-11-24T12:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`)).status, 200);
+
+  await reloj(api, "2026-12-01T09:00");
+  const facturas = (await generar(api, "2026-11")).cuerpo.facturas;
+  const marta = facturas.find((f: any) => f.socioId === "socio-002");
+  assert.ok(marta);
+  assert.deepEqual(marta.lineas.find((l: any) => l.reservaId === "R-0520"), { reservaId: "R-0520", concepto: "Penalización", importe: 1200 });
+  const lineas = facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId));
+  assert.ok(!lineas.includes(gratis.id));
+}));
+
+test("IVA sobre el total y numeración por año del mes facturado", () => conApi(async (api) => {
+  // Diciembre: socio-003 juega tres veces (1.800 + 1.800 + 2.800).
+  await reloj(api, "2026-12-01T08:00");
+  await reservar(api, "socio-003", "pista-1", "2026-12-02T18:00");
+  await reservar(api, "socio-003", "pista-1", "2026-12-02T09:00");
+  await reservar(api, "socio-003", "pista-2", "2026-12-02T09:00");
+
+  // Diciembre de 2026 generado en enero de 2027, antes que noviembre y octubre.
+  await reloj(api, "2027-01-05T10:00");
+  const diciembre = await generar(api, "2026-12");
+  assert.equal(diciembre.status, 201);
+  assert.equal(diciembre.cuerpo.facturas.length, 1);
+  const f = diciembre.cuerpo.facturas[0];
+  assert.equal(f.numero, "F2026-0001");
+  assert.equal(f.socioId, "socio-003");
+  assert.deepEqual(f.lineas.map((l: any) => l.importe), [1800, 1800, 2800], "ordenadas por inicio");
+  assert.deepEqual({ total: f.total, base: f.base, iva: f.iva }, { total: 6400, base: 5289, iva: 1111 });
+
+  // Un mes sin facturas no gasta números.
+  const septiembre = await generar(api, "2026-09");
+  assert.equal(septiembre.status, 201);
+  assert.deepEqual(septiembre.cuerpo.facturas, []);
