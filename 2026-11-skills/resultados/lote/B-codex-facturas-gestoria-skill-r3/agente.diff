+import assert from "node:assert/strict";
+import { test } from "node:test";
+import type { Estado, Factura } from "../src/tipos.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const gestor = "socio-040";
+const generar = (api: Api, mes: unknown) => api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+const reloj = async (api: Api, ahora: string) => {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+};
+const reservar = async (api: Api, socioId: string, inicio: string) => {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-1", inicio } });
+  assert.equal(respuesta.status, 201);
+  return respuesta.cuerpo.reserva;
+};
+
+test("solo el gestor puede generar y consultar facturas", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const [metodo, ruta] of [
+    ["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F2026-0001"],
+  ]) {
+    for (const [socio, status, codigo] of [
+      [undefined, 401, "NO_IDENTIFICADO"], ["socio-999", 401, "NO_IDENTIFICADO"], ["socio-001", 403, "SIN_PERMISO"],
+    ] as const) {
+      const respuesta = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      assert.equal(respuesta.status, status);
+      assert.equal(respuesta.cuerpo.error.codigo, codigo);
+    }
+  }
+  assert.equal((await generar(api, "2026-10")).status, 201);
+  for (const ruta of ["/api/facturas?mes=2026-10", "/api/facturas/F2026-0001"]) {
+    assert.equal((await api.pedir("GET", ruta, { socio: gestor })).status, 200);
+  }
