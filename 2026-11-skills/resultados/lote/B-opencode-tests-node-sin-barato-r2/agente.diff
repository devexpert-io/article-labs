+test("el informe de caja cuenta confirmadas y no presentadas, y no las canceladas", async () => {
+  await conApi({}, async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+
+    // Cálculo independiente sobre el estado para el mes de octubre de 2026 (historial de la semilla).
+    const pistas = [...estado.pistas].sort((a: { id: string }, b: { id: string }) => a.id.localeCompare(b.id));
+    const esperadas = pistas.map((p: { id: string }) => {
+      const delMes = estado.reservas.filter((r: { pistaId: string; inicio: string }) => r.pistaId === p.id && r.inicio.slice(0, 7) === "2026-10");
+      const activas = delMes.filter((r: { estado: string }) => r.estado === "confirmada" || r.estado === "no_presentada");
+      const ingresos = activas.reduce((s: number, r: { importe: number }) => s + r.importe, 0);
+      const penalizaciones = delMes
+        .filter((r: { estado: string }) => r.estado === "cancelada")
+        .reduce((s: number, r: { penalizacion?: number }) => s + (r.penalizacion ?? 0), 0);
+      return { pistaId: p.id, reservas: activas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    });
+    const total = esperadas.reduce(
+      (s: { reservas: number; ingresos: number; penalizaciones: number; total: number }, p: typeof esperadas[number]) => ({
+        reservas: s.reservas + p.reservas,
+        ingresos: s.ingresos + p.ingresos,
+        penalizaciones: s.penalizaciones + p.penalizaciones,
+        total: s.total + p.total,
+      }),
+      { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    );
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-040" });
+    assert.equal(informe.status, 200, informe.texto);
+    assert.deepEqual(informe.cuerpo.pistas, esperadas);
+    assert.deepEqual(informe.cuerpo.total, total);
+  });
