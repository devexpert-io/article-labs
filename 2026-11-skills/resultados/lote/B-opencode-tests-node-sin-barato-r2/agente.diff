+    assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const noGestor = await api.pedir("POST", ruta, { cuerpo, socio: "socio-001" });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const motivoCorto = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo: "corto" }, socio: "socio-040" });
+    assert.equal(motivoCorto.status, 400);
+    assert.equal(motivoCorto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const sinMotivo = await api.pedir("POST", ruta, { cuerpo: { exento: true }, socio: "socio-040" });
