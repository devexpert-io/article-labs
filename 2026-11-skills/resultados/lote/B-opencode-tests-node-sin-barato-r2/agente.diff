+    // La reserva sigue confirmada tras los intentos rechazados.
+    const antes = await api.pedir("GET", `/api/reservas/${reserva.id}`);
+    assert.equal(antes.cuerpo.reserva.estado, "confirmada");
+
+    const exenta = await api.pedir("POST", ruta, { cuerpo, socio: "socio-040" });
+    assert.equal(exenta.status, 200, exenta.texto);
+    assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "Aviso del médico");
+    assert.equal(exenta.cuerpo.reembolso, reserva.importe);
+  });
+});
+
+test("una reserva que ya ha empezado no se cancela, ni con exento", async () => {
+  await conApi({}, async (api) => {
+    const reserva = await crear(api, "socio-001", "pista-1", "2027-06-15T12:00");
+    await moverReloj(api, "2027-06-15T13:00");
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "Aviso del médico" },
+      socio: "socio-040",
+    });
+    assert.equal(cancelada.status, 409);
+    assert.equal(cancelada.cuerpo.error.codigo, "RESERVA_PASADA");
+  });
+});
+
+test("el informe de caja del mes: solo gestores, por pista y con total", async () => {
+  await conApi({}, async (api) => {
+    const ruta = "/api/informes/caja?mes=2027-05";
+
+    const sinIdentidad = await api.pedir("GET", ruta);
+    assert.equal(sinIdentidad.status, 401);
+    assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const noGestor = await api.pedir("GET", ruta, { socio: "socio-001" });
+    assert.equal(noGestor.status, 403);
