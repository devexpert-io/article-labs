+// La política nueva de cancelación (penalizaciones escalonadas, exención) y el informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function crear(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(creada.status, 201, creada.texto);
+  return creada.cuerpo.reserva as { id: string; importe: number };
+}
+
+async function moverReloj(api: Api, ahora: string) {
+  const movido = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(movido.status, 200, movido.texto);
+}
+
+test("los tramos de penalización y sus límites exactos", async () => {
+  await conApi({}, async (api) => {
+    const a48 = await crear(api, "socio-001", "pista-1", "2027-06-15T12:00");
+    const a24 = await crear(api, "socio-003", "pista-2", "2027-06-16T12:00");
+    const a23 = await crear(api, "socio-006", "pista-3", "2027-06-17T12:00");
+    const a47 = await crear(api, "socio-008", "pista-1", "2027-06-18T12:00");
+    assert.equal(a48.importe, 1800);
+    assert.equal(a24.importe, 1800);
+    assert.equal(a23.importe, 1200);
+    assert.equal(a47.importe, 1800);
+
+    // 48 horas justas: sin penalización.
+    await moverReloj(api, "2027-06-13T12:00");
+    const gratis = await api.pedir("POST", `/api/reservas/${a48.id}/cancelar`);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, a48.importe);
+
+    // 24 horas justas: 25 % y no hace falta forzar.
+    await moverReloj(api, "2027-06-15T12:00");
+    const reducida = await api.pedir("POST", `/api/reservas/${a24.id}/cancelar`);
+    assert.equal(reducida.status, 200);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, 450);
+    assert.equal(reducida.cuerpo.reembolso, 1350);
+
+    // Menos de 24 horas sin forzar: fuera de plazo.
+    await moverReloj(api, "2027-06-16T13:00");
+    const fuera = await api.pedir("POST", `/api/reservas/${a23.id}/cancelar`);
+    assert.equal(fuera.status, 409);
+    assert.equal(fuera.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${a23.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+    assert.equal(forzada.cuerpo.reembolso, 600);
+
+    // 47 horas: sigue siendo el tramo del 25 %.
+    const cuarentaYSiete = await api.pedir("POST", `/api/reservas/${a47.id}/cancelar`);
+    assert.equal(cuarentaYSiete.status, 200);
+    assert.equal(cuarentaYSiete.cuerpo.reserva.penalizacion, 450);
+    assert.equal(cuarentaYSiete.cuerpo.reembolso, 1350);
+  });
+});
+
+test("la antelación se mide en horas reales de Madrid, con el cambio de hora", async () => {
+  await conApi({}, async (api) => {
+    // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales.
+    const reserva = await crear(api, "socio-001", "pista-1", "2027-03-28T21:00");
+    assert.equal(reserva.importe, 2800);
+    await moverReloj(api, "2027-03-26T20:30");
+
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200, cancelada.texto);
+    // Si se contaran horas de pared (48,5) no habría penalización; son 47,5 y toca el 25 %.
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  });
+});
+
+test("exención: solo un gestor, con motivo de al menos 10 caracteres", async () => {
+  await conApi({}, async (api) => {
+    const reserva = await crear(api, "socio-001", "pista-1", "2027-06-15T12:00");
