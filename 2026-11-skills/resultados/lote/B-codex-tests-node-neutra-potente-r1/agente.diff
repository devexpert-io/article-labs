+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import type { Estado, Reserva } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { ahora });
+}
+
+async function crear(api: Api, inicio = "2027-03-28T21:00", pistaId = "pista-1") {
+  const r = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio },
+  });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.estado, "confirmada");
+  return r.cuerpo.reserva as Reserva;
+}
+
+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+  assert.equal(typeof r.cuerpo.error.mensaje, "string");
+}
+
+for (const caso of [
+  { nombre: "más de 48 horas", ahora: "2027-03-25T21:00", porcentaje: 0 },
+  { nombre: "entre 24 y 48 horas", ahora: "2027-03-27T15:00", porcentaje: 0.25 },
+  { nombre: "último minuto antes de las 24 horas", ahora: "2027-03-27T20:01", porcentaje: 0.5 },
+  { nombre: "un minuto antes del inicio", ahora: "2027-03-28T20:59", porcentaje: 0.5 },
+]) {
+  test(`C1 · ${caso.nombre}`, async (t) => {
+    const api = await arrancarApi();
+    t.after(() => api.cerrar());
+    const reserva = await crear(api);
+    await reloj(api, caso.ahora);
+    const ruta = `/api/reservas/${reserva.id}/cancelar`;
+    if (caso.porcentaje === 0.5) {
+      for (const cuerpo of [{}, { forzar: false }]) {
+        error(await api.pedir("POST", ruta, { cuerpo }), 409, "FUERA_DE_PLAZO");
+      }
+      const intacta = await api.pedir("GET", `/api/reservas/${reserva.id}`);
+      assert.equal(intacta.status, 200);
+      assert.deepEqual(intacta.cuerpo, { reserva });
+    }
+    const r = await api.pedir("POST", ruta, { cuerpo: { forzar: caso.porcentaje === 0.5 } });
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.estado, "cancelada");
+    assert.equal(r.cuerpo.reserva.penalizacion ?? 0, reserva.importe * caso.porcentaje);
+    assert.equal(r.cuerpo.reembolso, reserva.importe * (1 - caso.porcentaje));
+  });
+}
+
+for (const caso of [
+  { nombre: "48 horas exactas", ahora: "2027-03-26T20:00", porcentaje: 0 },
+  { nombre: "24 horas exactas", ahora: "2027-03-27T20:00", porcentaje: 0.25 },
