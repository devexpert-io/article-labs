+test("C7 · informe protegido, meses inválidos y mes sin movimientos", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const [socio, status, codigo] of [
+    [undefined, 401, "NO_IDENTIFICADO"], ["socio-999", 401, "NO_IDENTIFICADO"], ["socio-041", 403, "SIN_PERMISO"],
+  ] as const) {
+    error(await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio }), status, codigo);
+  }
+  for (const query of ["", "?mes=", "?mes=2026-1", "?mes=2026-00", "?mes=2026-13", "?mes=2026-11-01", "?mes=texto"]) {
+    error(await api.pedir("GET", `/api/informes/caja${query}`, { socio: gestor }), 400, "DATOS_INVALIDOS");
+  }
+  const r = await api.pedir("GET", "/api/informes/caja?mes=2027-01", { socio: gestor });
+  const cero = { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 };
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, {
+    mes: "2027-01", pistas: [1, 2, 3, 4].map((id) => ({ pistaId: `pista-${id}`, ...cero })), total: cero,
+  });
+});
