+test("C7 · caja por inicio: confirmadas, no presentadas y penalizaciones", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const nueva = await crear(api, "2026-12-01T09:00");
+  await reloj(api, "2026-11-30T10:00");
+  const cancelada = await api.pedir("POST", `/api/reservas/${nueva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 900);
+  const estado = await api.pedir("GET", "/_estado");
+  assert.equal(estado.status, 200);
+  const reservas = (estado.cuerpo as Estado).reservas;
+  assert.ok(reservas.some((r) => r.estado === "no_presentada" && r.inicio.startsWith("2026-11")));
+  for (const mes of ["2026-11", "2026-12"]) {
+    const r = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: gestor });
+    assert.equal(r.status, 200);
+    const pistas = [1, 2, 3, 4].map((id) => {
+      const pistaId = `pista-${id}`;
+      let cantidad = 0, ingresos = 0, penalizaciones = 0;
+      for (const reserva of reservas) {
+        if (reserva.pistaId !== pistaId || !reserva.inicio.startsWith(mes)) continue;
+        if (reserva.estado === "cancelada") penalizaciones += reserva.penalizacion ?? 0;
+        else { cantidad++; ingresos += reserva.importe; }
+      }
+      return { pistaId, reservas: cantidad, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    });
+    const total = { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 };
+    for (const p of pistas) for (const campo of ["reservas", "ingresos", "penalizaciones", "total"] as const) total[campo] += p[campo];
+    assert.deepEqual(r.cuerpo, { mes, pistas, total });
+    if (mes === "2026-12") assert.deepEqual(total, { reservas: 0, ingresos: 0, penalizaciones: 900, total: 900 });
+  }
+});
