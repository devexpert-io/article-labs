+test("C8 · precios y creación intactos; cancelar otra vez conserva la penalización", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const inicial = await api.pedir("GET", "/_estado");
+  assert.equal(inicial.status, 200);
+  const historicas = (inicial.cuerpo as Estado).reservas.filter((r) => r.estado === "cancelada");
+  const nueva = await crear(api, "2027-03-28T21:00", "pista-3");
+  assert.deepEqual(nueva, {
+    id: nueva.id, socioId: "socio-041", pistaId: "pista-3", inicio: "2027-03-28T21:00",
+    fin: "2027-03-28T22:30", estado: "confirmada", importe: 2000, notas: "",
+  });
+  await reloj(api, "2027-03-28T20:00");
+  const ruta = `/api/reservas/${nueva.id}/cancelar`;
+  const cancelada = await api.pedir("POST", ruta, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1000);
+  error(await api.pedir("POST", ruta, { socio: gestor, cuerpo: { exento: true, motivo: "Exención posterior" } }), 409, "YA_CANCELADA");
+  const guardada = await api.pedir("GET", `/api/reservas/${nueva.id}`);
+  assert.equal(guardada.status, 200);
+  assert.deepEqual(guardada.cuerpo, { reserva: cancelada.cuerpo.reserva });
+  const final = await api.pedir("GET", "/_estado");
+  assert.equal(final.status, 200);
+  assert.deepEqual((final.cuerpo as Estado).reservas.filter((r) => historicas.some((h) => h.id === r.id)), historicas);
+});
