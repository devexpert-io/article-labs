+        const total = lineas.reduce((suma, l) => suma + l.importe, 0);
+        const base = Math.round((total * 100) / 121);
+        facturas.push({
+          numero: `F${anio}-${String(siguiente).padStart(4, "0")}`,
+          mes: m,
+          socioId: socio.id,
+          lineas,
+          total,
+          base,
+          iva: total - base,
+        });
+        siguiente += 1;
+      }
