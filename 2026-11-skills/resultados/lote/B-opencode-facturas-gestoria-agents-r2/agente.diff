@@ -0,0 +1,229 @@
+// Las facturas mensuales de la gestoría, probadas a través de la API y del núcleo.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import type { Estado, Reserva } from "../src/tipos.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(fn: (api: Api) => Promise<void>, entorno: Record<string, string> = {}): Promise<void> {
+  const api = await arrancarApi(entorno);
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+function estadoMinimo(ahora: string): Estado {
+  return {
+    ahora,
+    pistas: [],
+    socios: [{ id: "socio-001", nombre: "Ana García", email: "ana@example.com", cuotaActiva: true, rol: "socio" }],
+    reservas: [],
+    registro: [],
+    contador: 0,
+    facturas: [],
+    mesesFacturados: [],
+  };
+}
+
+function reserva(
+  id: string,
+  socioId: string,
+  inicio: string,
+  importe: number,
+  estado: Reserva["estado"] = "confirmada",
+  penalizacion?: number,
+): Reserva {
+  return {
+    id,
+    socioId,
+    pistaId: "pista-1",
+    inicio,
+    fin: inicio,
+    estado,
+    importe,
+    notas: "",
+    ...(penalizacion !== undefined ? { penalizacion } : {}),
+  };
+}
+
+test("solo un gestor genera y consulta facturas", async () => {
+  await conApi(async (api) => {
+    assert.equal((await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } })).status, 401);
+    assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10")).status, 401);
+    assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001")).status, 401);
+    const post = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+    assert.equal(post.status, 403);
+    assert.equal(post.cuerpo.error.codigo, "SIN_PERMISO");
+    const get = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" });
+    assert.equal(get.status, 403);
+    assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001", { socio: "socio-001" })).status, 403);
+  });
+});
+
+test("el mes debe ser un AAAA-MM ya terminado", async () => {
+  await conApi(async (api) => {
+    for (const mes of ["octubre", "2026-13", "2026-00", "26-10"]) {
+      const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+      assert.equal(r.status, 400, mes);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    for (const mes of ["2026-11", "2026-12"]) {
+      const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+      assert.equal(r.status, 409, mes);
+      assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+    }
+  });
+});
+
+test("generar octubre: una factura por socio, líneas y totales correctos", async () => {
+  await conApi(async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const reservas = new Map<string, any>(estado.reservas.map((r: any) => [r.id, r]));
+    const respuesta = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(respuesta.status, 201);
+    const facturas: any[] = respuesta.cuerpo.facturas;
+    assert.ok(facturas.length > 0);
+
+    // Ordenadas por id de socio.
+    const ids = facturas.map((f) => f.socioId);
+    assert.deepEqual(ids, [...ids].sort());
+
+    for (const f of facturas) {
+      assert.equal(f.mes, "2026-10");
+      // Líneas ordenadas por el inicio de la reserva.
+      const inicios = f.lineas.map((l: any) => reservas.get(l.reservaId).inicio);
+      assert.deepEqual(inicios, [...inicios].sort());
+      let total = 0;
+      for (const l of f.lineas) {
+        total += l.importe;
+        const r = reservas.get(l.reservaId);
+        if (r.estado === "cancelada") {
+          assert.equal(l.concepto, "Penalización");
+          assert.equal(l.importe, r.penalizacion);
+        } else {
+          assert.equal(l.concepto, "Reserva");
+          assert.equal(l.importe, r.importe);
+        }
+      }
+      assert.equal(f.total, total);
+      assert.equal(f.base, Math.round((f.total * 100) / 121));
+      assert.equal(f.iva, f.total - f.base);
+      assert.equal(f.base + f.iva, f.total);
+    }
+
+    // Numeración correlativa por año, desde 0001.
+    assert.equal(facturas[0].numero, "F2026-0001");
+    for (let i = 0; i < facturas.length; i++) {
+      assert.equal(facturas[i].numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+    }
+
+    // Todo socio con algo facturable en octubre lleva factura, y nadie más.
+    const facturables = new Set<string>();
+    for (const r of estado.reservas) {
+      if (r.inicio.startsWith("2026-10") && (r.estado !== "cancelada" || (r.penalizacion ?? 0) > 0)) {
+        facturables.add(r.socioId);
+      }
+    }
+    for (const s of estado.socios) {
+      assert.equal(facturas.some((f) => f.socioId === s.id), facturables.has(s.id), s.id);
+    }
+  });
+});
+
+test("generar dos veces un mes devuelve las mismas facturas sin gastar números", async () => {
+  await conApi(async (api) => {
+    const primera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(primera.status, 201);
+    const segunda = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(segunda.status, 200);
+    assert.deepEqual(segunda.cuerpo.facturas, primera.cuerpo.facturas);
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    assert.equal(estado.facturas.length, primera.cuerpo.facturas.length);
+  });
+});
+
+test("consultar facturas por mes y por número", async () => {
+  await conApi(async (api) => {
+    const antes = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.equal(antes.status, 200);
+    assert.deepEqual(antes.cuerpo.facturas, []);
+    const gen = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    const facturas = gen.cuerpo.facturas;
+    const porMes = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.deepEqual(porMes.cuerpo.facturas, facturas);
+    const primera = facturas[0];
+    const porNumero = await api.pedir("GET", `/api/facturas/${primera.numero}`, { socio: GESTOR });
+    assert.deepEqual(porNumero.cuerpo.factura, primera);
+    const inexistente = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+    assert.equal(inexistente.status, 404);
+    assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  });
+});
+
+test("la numeración sigue entre meses aunque se generen fuera de orden", async () => {
+  await conApi(async (api) => {
+    // Noviembre primero y luego octubre: octubre continúa la serie de 2026.
+    const nov = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    assert.equal(nov.status, 201);
+    const numerosNov = nov.cuerpo.facturas.map((f: any) => f.numero);
+    assert.ok(numerosNov.length > 0);
+    assert.equal(numerosNov[0], "F2026-0001");
+    const oct = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(oct.status, 201);
+    const numerosOct = oct.cuerpo.facturas.map((f: any) => f.numero);
+    assert.ok(numerosOct.length > 0);
+    const ultimo = Number(numerosNov[numerosNov.length - 1].slice(-4));
+    for (let i = 0; i < numerosOct.length; i++) {
+      assert.equal(numerosOct[i], `F2026-${String(ultimo + 1 + i).padStart(4, "0")}`);
+    }
+  }, { AHORA: "2026-12-05T10:00" });
+});
+
+test("diciembre generado en enero usa el año 2026 (POST /_reloj)", async () => {
+  await conApi(async (api) => {
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-10T10:00" } });
+    const dic = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+    assert.equal(dic.status, 201);
+    assert.deepEqual(dic.cuerpo.facturas, []); // diciembre no tiene reservas
+    const oct = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.ok(oct.cuerpo.facturas.length > 0);
+    for (const f of oct.cuerpo.facturas) {
+      assert.ok(f.numero.startsWith("F2026-"));
+    }
+  });
+});
+
+test("el IVA se calcula sobre el total: ejemplo de 6.400 céntimos", () => {
+  const estado = estadoMinimo("2026-12-01T10:00");
+  estado.reservas = [
+    reserva("R-0001", "socio-001", "2026-10-01T09:00", 1800),
+    reserva("R-0002", "socio-001", "2026-10-01T10:30", 1800),
+    reserva("R-0003", "socio-001", "2026-10-01T18:00", 2800),
+  ];
+  const { facturas } = crearClub(estado).generarFacturas("2026-10");
+  assert.equal(facturas.length, 1);
+  const f = facturas[0]!;
+  assert.equal(f.total, 6400);
+  assert.equal(f.base, 5289);
+  assert.equal(f.iva, 1111);
+  assert.equal(f.base + f.iva, f.total);
+});
+
+test("una cancelación con penalización factura 'Penalización' y sin penalización no", () => {
+  const estado = estadoMinimo("2026-12-01T10:00");
+  estado.reservas = [
+    reserva("R-0001", "socio-001", "2026-10-01T09:00", 1800, "cancelada", 1800),
+    reserva("R-0002", "socio-001", "2026-10-02T09:00", 1800, "cancelada"),
+  ];
