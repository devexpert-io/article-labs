+
+test("C3 · cambio de hora de marzo: del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas (25 %)", async () => {
+  await conApi(async (api) => {
+    await reloj(api, "2027-03-20T10:00");
