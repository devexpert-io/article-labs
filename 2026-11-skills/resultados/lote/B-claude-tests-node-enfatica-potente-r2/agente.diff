+/** El informe esperado, calculado a partir del estado completo. */
+function informeEsperado(estado: any, mes: string) {
+  const vacio = () => ({ reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+  const total = vacio();
+  const pistas = [...estado.pistas].map((p: any) => p.id).sort().map((pistaId: string) => {
+    const fila = { pistaId, ...vacio() };
+    for (const r of estado.reservas.filter((x: any) => x.pistaId === pistaId && x.inicio.startsWith(mes))) {
+      if (r.estado === "cancelada") fila.penalizaciones += r.penalizacion ?? 0;
+      else {
+        fila.reservas += 1;
+        fila.ingresos += r.importe;
+      }
+    }
+    fila.total = fila.ingresos + fila.penalizaciones;
+    for (const k of ["reservas", "ingresos", "penalizaciones", "total"] as const) total[k] += fila[k];
+    return fila;
+  });
+  return { mes, pistas, total };
+}
