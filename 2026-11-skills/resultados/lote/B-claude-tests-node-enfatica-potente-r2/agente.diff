+    for (const mes of ["2026-10", "2026-11"]) {
+      const r = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: GESTOR });
+      assert.equal(r.status, 200);
+      assert.deepEqual(r.cuerpo, informeEsperado(estado, mes));
+    }
+    const nov = (await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR })).cuerpo;
+    assert.equal(nov.total.penalizaciones, 600);
+    assert.equal(nov.pistas.find((p: any) => p.pistaId === "pista-3").penalizaciones, 600);
+  });
+});
