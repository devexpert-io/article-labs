+
+test("C3 · cambio de hora de marzo: a 48 horas reales justas (19:30 del viernes) no hay penalización", async () => {
+  await conApi(async (api) => {
+    await reloj(api, "2027-03-20T10:00");
+    const r = await reservar(api, "pista-2", "2027-03-28T21:00");
+    await reloj(api, "2027-03-26T20:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.deepEqual(c.cuerpo, { reserva: { ...r, estado: "cancelada" }, reembolso: 2800 });
+  });
+});
+
+test("C3 · cambio de hora de octubre: 47,5 horas de reloj son 48,5 horas reales y no hay penalización", async () => {
+  await conApi(async (api) => {
+    await reloj(api, "2027-10-20T10:00");
+    const r = await reservar(api, "pista-2", "2027-10-31T21:00");
+    await reloj(api, "2027-10-29T21:30");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.deepEqual(c.cuerpo, { reserva: { ...r, estado: "cancelada" }, reembolso: 2800 });
+  });
+});
