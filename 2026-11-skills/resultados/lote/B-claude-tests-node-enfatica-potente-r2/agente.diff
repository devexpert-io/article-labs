+// Spec reembolsos: penalizaciones escalonadas, exención por un gestor e informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+/** Cada test arranca su propia API con la semilla nueva. */
+async function conApi(cuerpo: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await cuerpo(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { ahora });
+}
+
+/** Crea una reserva de Nora Benítez (sin reservas en la semilla) y devuelve la reserva creada. */
+async function reservar(api: Api, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId, inicio } });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.estado, "confirmada");
+  return r.cuerpo.reserva;
+}
+
+async function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+// Miércoles 2 de diciembre de 2026 a las 10:30, pista 3 en valle: 1200 céntimos.
+const INICIO = "2026-12-02T10:30";
+
+test("C1 · con 48 horas o más de antelación no hay penalización", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "pista-3", INICIO);
+    await reloj(api, "2026-11-29T10:30");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.deepEqual(c.cuerpo, { reserva: { ...r, estado: "cancelada" }, reembolso: 1200 });
+  });
+});
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 % del importe", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "pista-3", INICIO);
+    await reloj(api, "2026-11-30T20:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.deepEqual(c.cuerpo, { reserva: { ...r, estado: "cancelada", penalizacion: 300 }, reembolso: 900 });
+  });
+});
+
+test("C1 · con menos de 24 horas sin forzar responde 409 FUERA_DE_PLAZO y no cancela", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "pista-3", INICIO);
+    await reloj(api, "2026-12-01T20:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 409);
+    assert.equal(c.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const sigue = await api.pedir("GET", `/api/reservas/${r.id}`);
+    assert.equal(sigue.status, 200);
+    assert.deepEqual(sigue.cuerpo, { reserva: r });
+  });
+});
+
+test("C1 · con menos de 24 horas y forzar la penalización es el 50 %", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "pista-3", INICIO);
+    await reloj(api, "2026-12-01T20:00");
+    const c = await cancelar(api, r.id, { forzar: true });
+    assert.equal(c.status, 200);
+    assert.deepEqual(c.cuerpo, { reserva: { ...r, estado: "cancelada", penalizacion: 600 }, reembolso: 600 });
+  });
+});
+
+test("C2 · a 48 horas justas no hay penalización", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "pista-3", INICIO);
+    await reloj(api, "2026-11-30T10:30");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.deepEqual(c.cuerpo, { reserva: { ...r, estado: "cancelada" }, reembolso: 1200 });
+  });
+});
+
+test("C2 · un minuto después de las 48 horas ya se aplica el 25 %", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "pista-3", INICIO);
