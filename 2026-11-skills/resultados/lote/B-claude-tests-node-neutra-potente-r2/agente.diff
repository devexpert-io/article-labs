+test("C7 · el informe suma reservas e ingresos de las confirmadas y penalizaciones de las canceladas del mes", async () => {
+  await conApi(async (api) => {
+    // Enero de 2027: miércoles 20 en valle y sábado 23 en punta.
+    const a = await reservar(api, "socio-003", "pista-1", "2027-01-20T12:00"); // 1800, se queda
+    await reservar(api, "socio-006", "pista-1", "2027-01-23T12:00"); //            2800, se queda
+    await reservar(api, "socio-007", "pista-3", "2027-01-31T21:00"); //            2000, se queda (último día del mes)
+    const c = await reservar(api, "socio-008", "pista-3", "2027-01-20T12:00"); //  1200, se cancela al 25 % → 300
+    const d = await reservar(api, "socio-009", "pista-1", "2027-01-23T13:30"); //  2800, se cancela al 50 % → 1400
+    const e = await reservar(api, "socio-012", "pista-3", "2027-01-23T13:30"); //  2000, se cancela gratis
+    await reservar(api, "socio-013", "pista-1", "2027-02-01T09:00"); //            febrero: no cuenta
+    await reservar(api, "socio-014", "pista-2", "2026-12-31T21:00"); //            diciembre: no cuenta
+    assert.equal(a.importe, 1800);
+
+    assert.equal((await cancelar(api, e.id)).cuerpo.reembolso, 2000);
+    await reloj(api, "2027-01-19T00:00");
+    assert.equal((await cancelar(api, c.id)).cuerpo.reserva.penalizacion, 300);
+    await reloj(api, "2027-01-23T10:00");
+    assert.equal((await cancelar(api, d.id, { forzar: true })).cuerpo.reserva.penalizacion, 1400);
+
+    const r = await api.pedir("GET", "/api/informes/caja?mes=2027-01", { socio: GESTOR });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, {
+      mes: "2027-01",
+      pistas: [
+        { pistaId: "pista-1", reservas: 2, ingresos: 4600, penalizaciones: 1400, total: 6000 },
+        { pistaId: "pista-2", ...VACIO },
+        { pistaId: "pista-3", reservas: 1, ingresos: 2000, penalizaciones: 300, total: 2300 },
+        { pistaId: "pista-4", ...VACIO },
+      ],
+      total: { reservas: 3, ingresos: 6600, penalizaciones: 1700, total: 8300 },
+    });
+  });
+});
