+});
+
+test("C3 · en el cambio de hora de marzo, del viernes 20:00 al domingo 21:00 hay 48 horas reales: sin penalización", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "socio-003", "pista-2", "2027-03-28T21:00");
+    await reloj(api, "2027-03-26T20:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c.cuerpo.reembolso, 2800);
+  });
+});
+
+test("C3 · en el cambio de hora de octubre, del viernes 21:30 al domingo 21:00 hay 48,5 horas reales: sin penalización", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "socio-003", "pista-2", "2027-10-31T21:00");
+    await reloj(api, "2027-10-29T21:30");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c.cuerpo.reembolso, 2800);
+  });
+});
+
+test("C3 · en el cambio de hora de marzo, del sábado 20:30 al domingo 21:00 hay 23,5 horas reales: hace falta forzar", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "socio-003", "pista-2", "2027-03-28T21:00");
+    // Sin contar el cambio de hora serían 24,5 horas.
