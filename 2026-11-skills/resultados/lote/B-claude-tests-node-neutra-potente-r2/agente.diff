+// Spec docs/specs/reembolsos.md: penalizaciones escalonadas, exención y informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+/** Arranca una API con su propia semilla, ejecuta la prueba y la cierra. */
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reservar(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva as { id: string; importe: number };
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+function cancelar(api: Api, id: string, cuerpo?: Record<string, unknown>, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+// Miércoles 25 de noviembre a las 12:00, pista 3 en horario de valle: 1200 céntimos.
+const INICIO = "2026-11-25T12:00";
+
+test("C1 · con 48 horas o más de antelación no hay penalización", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "socio-003", "pista-3", INICIO);
+    await reloj(api, "2026-11-22T12:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.estado, "cancelada");
+    assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c.cuerpo.reembolso, 1200);
+  });
+});
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 %", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "socio-003", "pista-3", INICIO);
+    await reloj(api, "2026-11-23T20:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, 300);
+    assert.equal(c.cuerpo.reembolso, 900);
+  });
+});
+
+test("C1 · con menos de 24 horas, sin forzar, 409 FUERA_DE_PLAZO y la reserva sigue confirmada", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "socio-003", "pista-3", INICIO);
+    await reloj(api, "2026-11-25T09:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 409);
+    assert.equal(c.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const sigue = await api.pedir("GET", `/api/reservas/${r.id}`);
+    assert.equal(sigue.cuerpo.reserva.estado, "confirmada");
+    assert.equal(sigue.cuerpo.reserva.penalizacion, undefined);
+  });
+});
+
+test("C1 · con menos de 24 horas y forzar la penalización es el 50 %", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, "socio-003", "pista-3", INICIO);
+    await reloj(api, "2026-11-25T09:00");
+    const c = await cancelar(api, r.id, { forzar: true });
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, 600);
+    assert.equal(c.cuerpo.reembolso, 600);
+  });
+});
+
+test("C2 · a 48 horas justas no hay penalización y un minuto después sí", async () => {
+  await conApi(async (api) => {
+    const a = await reservar(api, "socio-003", "pista-3", INICIO);
+    const b = await reservar(api, "socio-006", "pista-2", INICIO);
+    await reloj(api, "2026-11-23T12:00");
+    const justas = await cancelar(api, a.id);
+    assert.equal(justas.status, 200);
+    assert.equal(justas.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(justas.cuerpo.reembolso, 1200);
+    await reloj(api, "2026-11-23T12:01");
+    const despues = await cancelar(api, b.id);
+    assert.equal(despues.cuerpo.reserva.penalizacion, 450);
+    assert.equal(despues.cuerpo.reembolso, 1350);
+  });
+});
+
+test("C2 · a 24 horas justas se aplica el 25 % sin forzar y un minuto después hace falta forzar", async () => {
+  await conApi(async (api) => {
+    const a = await reservar(api, "socio-003", "pista-3", INICIO);
+    const b = await reservar(api, "socio-006", "pista-2", INICIO);
+    await reloj(api, "2026-11-24T12:00");
+    const justas = await cancelar(api, a.id);
+    assert.equal(justas.status, 200);
+    assert.equal(justas.cuerpo.reserva.penalizacion, 300);
+    assert.equal(justas.cuerpo.reembolso, 900);
+    await reloj(api, "2026-11-24T12:01");
+    const despues = await cancelar(api, b.id);
+    assert.equal(despues.status, 409);
+    assert.equal(despues.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  });
+});
+
+test("C3 · en el cambio de hora de marzo, del viernes 20:30 al domingo 21:00 hay 47,5 horas reales: 25 %", async () => {
+  await conApi(async (api) => {
+    // Domingo, horario de punta en la pista 2: 2800 céntimos.
