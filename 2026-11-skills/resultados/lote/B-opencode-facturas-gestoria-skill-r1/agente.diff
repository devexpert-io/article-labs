@@ -0,0 +1,225 @@
+// La facturación mensual para la gestoría, probada a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { baseDe } from "../src/nucleo.ts";
+
+const GESTOR = "socio-040";
+
+async function generar(api: Api, mes: string) {
+  return api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+}
+
+test("la base imponible se calcula sobre el total, no línea a línea (ejemplo de la gestoría)", () => {
+  // Tres líneas de 1.800, 1.800 y 2.800 céntimos: total 6.400, base 5.289, IVA 1.111.
+  assert.equal(baseDe(6400), 5289);
+  assert.equal(6400 - baseDe(6400), 1111);
+});
+
+test("solo un gestor puede generar y consultar facturas", async () => {
+  const api = await arrancarApi();
+  try {
+    const sinCabecera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+    assert.equal(sinCabecera.status, 401);
+    assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const noGestor = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10")).status, 401);
+    assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" })).status, 403);
+    assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001", { socio: "socio-001" })).status, 403);
+
+    assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).status, 200);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("solo se factura un mes cerrado, con el formato AAAA-MM", async () => {
+  const api = await arrancarApi(); // ahora: 2026-11-18T10:00
+  try {
+    const mal = await generar(api, "2026");
+    assert.equal(mal.status, 400);
+    assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const abierto = await generar(api, "2026-11");
+    assert.equal(abierto.status, 409);
+    assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+
+    const cerrado = await generar(api, "2026-10");
+    assert.equal(cerrado.status, 201);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("se genera una factura por socio, ordenada por id, con líneas y total e IVA correctos", async () => {
+  const api = await arrancarApi();
+  try {
+    const primera = await generar(api, "2026-10");
+    assert.equal(primera.status, 201);
+    const facturas = primera.cuerpo.facturas;
+    assert.ok(facturas.length > 0, "octubre tiene reservas facturables");
+
+    // Ordenadas por id de socio y numeración correlativa del año.
+    const ids = facturas.map((f: any) => f.socioId);
+    assert.deepEqual(ids, [...ids].sort((a: string, b: string) => a.localeCompare(b)));
+
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const inicioDe = new Map(estado.reservas.map((r: any) => [r.id, r.inicio]));
+
+    facturas.forEach((f: any, i: number) => {
+      assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+      assert.equal(f.mes, "2026-10");
+      // Cada línea es una reserva distinta y va con su reservaId, concepto e importe.
+      const idsLineas = f.lineas.map((l: any) => l.reservaId);
+      assert.equal(new Set(idsLineas).size, idsLineas.length);
+      for (const l of f.lineas) {
+        assert.equal(l.concepto, "Reserva");
+        assert.ok(l.importe > 0);
+      }
+      // Líneas ordenadas por el inicio de la reserva.
+      const inicios = idsLineas.map((id: string) => inicioDe.get(id));
+      assert.deepEqual(inicios, [...inicios].sort());
+      const total = f.lineas.reduce((suma: number, l: any) => suma + l.importe, 0);
+      assert.equal(f.total, total);
+      assert.equal(f.base, baseDe(total));
+      assert.equal(f.iva, total - f.base);
+      assert.equal(f.base + f.iva, f.total);
+    });
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("generar dos veces un mes devuelve las mismas facturas y no crea nuevas", async () => {
+  const api = await arrancarApi();
+  try {
+    const primera = await generar(api, "2026-10");
+    assert.equal(primera.status, 201);
+    const segunda = await generar(api, "2026-10");
+    assert.equal(segunda.status, 200);
+    assert.deepEqual(segunda.cuerpo.facturas, primera.cuerpo.facturas);
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    assert.equal(estado.facturas.length, primera.cuerpo.facturas.length);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("consultar facturas: por mes y por número", async () => {
+  const api = await arrancarApi();
+  try {
+    assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas, []);
+
+    const generadas = (await generar(api, "2026-10")).cuerpo.facturas;
+    const porMes = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas;
+    assert.deepEqual(porMes, generadas);
+
+    const primera = generadas[0];
+    const una = await api.pedir("GET", `/api/facturas/${primera.numero}`, { socio: GESTOR });
+    assert.equal(una.status, 200);
+    assert.deepEqual(una.cuerpo.factura, primera);
+
+    const inexistente = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+    assert.equal(inexistente.status, 404);
+    assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("una cancelación con penalización entra como Penalización y una sin penalización no entra", async () => {
+  const api = await arrancarApi(); // ahora: 2026-11-18T10:00
+  try {
+    // Una franja libre el mismo día, para poder cancelarla fuera de plazo con penalización.
+    const disp = (await api.pedir("GET", "/api/disponibilidad?fecha=2026-11-18")).cuerpo;
+    let objetivo: { pistaId: string; inicio: string } | null = null;
+    for (const p of disp.pistas) {
+      for (const f of p.franjas) {
+        if (f.estado === "libre" && f.inicio > "2026-11-18T10:00" && f.inicio < "2026-11-19T10:00") {
+          objetivo = { pistaId: p.pistaId, inicio: f.inicio };
+          break;
+        }
+      }
+      if (objetivo) break;
+    }
+    assert.ok(objetivo, "debe quedar una franja libre ese día");
+
+    // Nora Benítez (socio-041) no tiene reservas: así su factura de noviembre depende solo de estas.
+    const conPenalizacion = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: objetivo.pistaId, inicio: objetivo.inicio },
+    });
+    assert.equal(conPenalizacion.status, 201);
+    const canceladaConPenalizacion = await api.pedir("POST", `/api/reservas/${conPenalizacion.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(canceladaConPenalizacion.status, 200);
+    assert.ok(canceladaConPenalizacion.cuerpo.reserva.penalizacion > 0);
+
+    // Una reserva con más de 24 horas de margen: se cancela gratis, sin penalización.
+    const sinPenalizacion = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: objetivo.pistaId, inicio: "2026-11-24T12:00" },
+    });
+    assert.equal(sinPenalizacion.status, 201);
+    const canceladaGratis = await api.pedir("POST", `/api/reservas/${sinPenalizacion.cuerpo.reserva.id}/cancelar`);
+    assert.equal(canceladaGratis.status, 200);
+    assert.equal(canceladaGratis.cuerpo.reserva.penalizacion, undefined);
+
+    // Cerramos noviembre y lo facturamos.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T10:00" } });
+    const generadas = (await generar(api, "2026-11")).cuerpo.facturas;
+    const deNora = generadas.filter((f: any) => f.socioId === "socio-041");
+    assert.equal(deNora.length, 1);
+    const lineas = deNora[0].lineas;
+    assert.equal(lineas.length, 1);
+    assert.equal(lineas[0].reservaId, conPenalizacion.cuerpo.reserva.id);
+    assert.equal(lineas[0].concepto, "Penalización");
+    assert.equal(lineas[0].importe, canceladaConPenalizacion.cuerpo.reserva.penalizacion);
+    assert.ok(!lineas.some((l: any) => l.reservaId === sinPenalizacion.cuerpo.reserva.id));
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("la numeración sigue por año y por mes, con el año del mes facturado", async () => {
+  const api = await arrancarApi({ AHORA: "2027-01-15T10:00" });
+  try {
+    // Un mes sin facturas no gasta números.
+    const vacio = (await generar(api, "2026-09")).cuerpo.facturas;
+    assert.equal(vacio.length, 0);
+
+    // Noviembre de 2026 generado en enero de 2027: el número usa el año del mes (2026).
+    const noviembre = (await generar(api, "2026-11")).cuerpo.facturas;
+    assert.ok(noviembre.length > 0);
+    assert.equal(noviembre[0].numero, "F2026-0001");
+    assert.ok(noviembre.every((f: any) => f.numero.startsWith("F2026-")));
+
+    // Octubre, generado después y fuera de orden, sigue la serie de 2026 donde la dejó noviembre.
