+function instanteMadrid(local: string): number {
+  const comoUtc = Date.parse(`${local}:00Z`);
+  let instante = comoUtc - desfaseMadrid(comoUtc) * 60_000;
+  instante = comoUtc - desfaseMadrid(instante) * 60_000;
+  return instante;
