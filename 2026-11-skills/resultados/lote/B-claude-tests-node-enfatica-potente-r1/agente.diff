+  });
+});
+
+test("C3 · del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales", async () => {
+  await conApi(async (api) => {
+    // Domingo, punta: pista 1 = 2800 céntimos. Sin el cambio de hora serían 48,5 horas y no habría penalización.
+    const r = await reservar(api, "2027-03-28T21:00", "2027-03-26T20:30");
+    const res = await cancelar(api, r.id);
+    assert.equal(res.status, 200);
+    assert.equal(res.cuerpo.reserva.penalizacion, 700);
