+// Spec docs/specs/reembolsos.md: penalizaciones escalonadas, exención por un gestor e informe de caja.
+// Cada test arranca su propia API con la semilla nueva.
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-003";
+
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { ahora });
+}
+
+/** Crea una reserva con la hora del club en `ahora` y deja el reloj en `cancelarA`. */
+async function reservar(api: Api, inicio: string, cancelarA: string, pistaId = "pista-1", socioId = SOCIO) {
+  await reloj(api, "2027-01-01T09:00");
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(creada.status, 201);
+  await reloj(api, cancelarA);
+  return creada.cuerpo.reserva as { id: string; importe: number };
+}
+
+async function cancelar(api: Api, id: string, cuerpo: unknown = {}, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+async function estadoDe(api: Api, id: string) {
+  const r = await api.pedir("GET", `/api/reservas/${id}`);
+  assert.equal(r.status, 200);
+  return r.cuerpo.reserva;
+}
+
+// Miércoles 13 de enero de 2027 a las 12:00, en valle: pista 1 = 1800 céntimos.
+const INICIO = "2027-01-13T12:00";
+
+test("C1 · con 48 horas o más de antelación no hay penalización", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, INICIO, "2027-01-10T12:00");
+    const res = await cancelar(api, r.id);
+    assert.equal(res.status, 200);
+    assert.equal(res.cuerpo.reserva.estado, "cancelada");
+    assert.equal(res.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(res.cuerpo.reembolso, 1800);
+  });
+});
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 % del importe", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, INICIO, "2027-01-12T06:00");
+    const res = await cancelar(api, r.id);
+    assert.equal(res.status, 200);
+    assert.equal(res.cuerpo.reserva.estado, "cancelada");
+    assert.equal(res.cuerpo.reserva.penalizacion, 450);
+    assert.equal(res.cuerpo.reembolso, 1350);
+  });
+});
+
+test("C1 · con menos de 24 horas, sin forzar responde 409 FUERA_DE_PLAZO y no cancela", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, INICIO, "2027-01-13T02:00");
+    const res = await cancelar(api, r.id);
+    assert.equal(res.status, 409);
+    assert.equal(res.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    assert.equal((await estadoDe(api, r.id)).estado, "confirmada");
+  });
+});
+
+test("C1 · con menos de 24 horas y forzar la penalización es el 50 %", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, INICIO, "2027-01-13T02:00");
+    const res = await cancelar(api, r.id, { forzar: true });
+    assert.equal(res.status, 200);
+    assert.equal(res.cuerpo.reserva.estado, "cancelada");
+    assert.equal(res.cuerpo.reserva.penalizacion, 900);
+    assert.equal(res.cuerpo.reembolso, 900);
+  });
+});
+
+test("C2 · a 48 horas justas no hay penalización", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, INICIO, "2027-01-11T12:00");
+    const res = await cancelar(api, r.id);
+    assert.equal(res.status, 200);
+    assert.equal(res.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(res.cuerpo.reembolso, 1800);
