+test("C8 · las reservas ya canceladas conservan su penalización y no se vuelven a cancelar", async () => {
+  await conApi(async (api) => {
+    const canceladas = async () =>
+      (await api.pedir("GET", "/_estado")).cuerpo.reservas.filter((x: { estado: string }) => x.estado === "cancelada");
+    const antes = await canceladas();
+    const r = await reservar(api, INICIO, "2027-01-13T02:00");
+    assert.equal((await cancelar(api, r.id, { forzar: true })).cuerpo.reserva.penalizacion, 900);
+    await reloj(api, "2027-01-05T09:00");
+    const otra = await cancelar(api, r.id, { exento: true, motivo: "Intento de recalcular" }, GESTOR);
+    assert.equal(otra.status, 409);
+    assert.equal(otra.cuerpo.error.codigo, "YA_CANCELADA");
+    assert.equal((await estadoDe(api, r.id)).penalizacion, 900);
+    const despues = await canceladas();
+    assert.deepEqual(despues.filter((x: { id: string }) => x.id !== r.id), antes);
+  });
+});
