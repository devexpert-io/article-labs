+
+test("C2 · a 24 horas justas se aplica el 25 % sin necesidad de forzar", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, INICIO, "2027-01-12T12:00");
+    const res = await cancelar(api, r.id);
