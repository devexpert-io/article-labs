+test("C7 · el informe cuenta las confirmadas y las no presentadas del historial, por fecha de inicio", async () => {
+  await conApi(async (api) => {
+    const reservas: { pistaId: string; inicio: string; estado: string; importe: number; penalizacion?: number }[] =
+      (await api.pedir("GET", "/_estado")).cuerpo.reservas;
+    const delMes = reservas.filter((r) => r.inicio.startsWith("2026-10"));
+    assert.equal(delMes.some((r) => r.estado === "no_presentada"), true);
+    const cifras = (lista: typeof delMes) => {
+      const cobradas = lista.filter((r) => r.estado !== "cancelada");
+      const ingresos = cobradas.reduce((s, r) => s + r.importe, 0);
+      const penalizaciones = lista.filter((r) => r.estado === "cancelada").reduce((s, r) => s + (r.penalizacion ?? 0), 0);
+      return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    };
+    const res = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: GESTOR });
+    assert.equal(res.status, 200);
+    assert.deepEqual(res.cuerpo, {
+      mes: "2026-10",
+      pistas: ["pista-1", "pista-2", "pista-3", "pista-4"].map((pistaId) => ({ pistaId, ...cifras(delMes.filter((r) => r.pistaId === pistaId)) })),
+      total: cifras(delMes),
+    });
+  });
+});
