+/** Minutos que Madrid va por delante de UTC en ese instante. */
+function desfaseMadrid(instante: number): number {
+  const p = Object.fromEntries(RELOJ_MADRID.formatToParts(new Date(instante)).map((x) => [x.type, x.value]));
+  const local = Date.UTC(Number(p.year), Number(p.month) - 1, Number(p.day), Number(p.hour), Number(p.minute));
