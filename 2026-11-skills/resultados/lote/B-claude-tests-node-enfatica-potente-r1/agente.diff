+
+test("C2 · a 23 horas y 59 minutos ya hace falta forzar", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, INICIO, "2027-01-12T12:01");
+    const res = await cancelar(api, r.id);
+    assert.equal(res.status, 409);
