+// Penalizaciones escalonadas, exención de gestor e informe de caja (spec reembolsos).
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-003";
+
+async function conApi(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("C1 · tramos: 48 horas o más gratis, 24 a 48 el 25 % y menos de 24 solo con forzar y el 50 %", async () => {
+  await conApi(async (api) => {
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T08:00" } })).status, 200);
+
+    // R-0490 empieza el 20 a las 12:00: faltan 52 horas.
+    const gratis = await api.pedir("POST", "/api/reservas/R-0490/cancelar");
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, 1200);
+
+    // R-0520 empieza el 19 a las 09:00: faltan 25 horas.
+    const reducida = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(reducida.status, 200);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, 300);
+    assert.equal(reducida.cuerpo.reembolso, 900);
+
+    // R-0524 empieza el 19 a las 10:30 y ahora son las 12:00: faltan 22,5 horas.
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T12:00" } })).status, 200);
+    const fuera = await api.pedir("POST", "/api/reservas/R-0524/cancelar");
+    assert.equal(fuera.status, 409);
+    assert.deepEqual(fuera.cuerpo, {
+      error: {
+        codigo: "FUERA_DE_PLAZO",
+        mensaje: "Faltan 22 horas para la reserva y solo se cancela con forzar: true, con una penalización del 50 % del importe.",
+      },
+    });
+    const forzada = await api.pedir("POST", "/api/reservas/R-0524/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+  });
+});
+
+test("C2 · límites exactos: 48 horas justas sin penalización y 24 horas justas con el 25 %", async () => {
+  await conApi(async (api) => {
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T09:00" } })).status, 200);
+    // R-0520 empieza el 19 a las 09:00: exactamente 24 horas.
+    const a24 = await api.pedir("POST", "/api/reservas/R-0520/cancelar");
+    assert.equal(a24.status, 200);
+    assert.equal(a24.cuerpo.reserva.penalizacion, 300);
+    assert.equal(a24.cuerpo.reembolso, 900);
+    assert.equal((await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } })).cuerpo.error.codigo, "YA_CANCELADA");
+
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T12:00" } })).status, 200);
+    // R-0490 empieza el 20 a las 12:00: exactamente 48 horas.
+    const a48 = await api.pedir("POST", "/api/reservas/R-0490/cancelar");
+    assert.equal(a48.status, 200);
+    assert.equal(a48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(a48.cuerpo.reembolso, 1200);
+  });
+});
+
+test("C3 · cambio de hora: la antelación son horas reales de Madrid", async () => {
+  await conApi(async (api) => {
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-03-28T21:00" },
+    });
+    assert.equal(creada.status, 201);
+    assert.equal(creada.cuerpo.reserva.importe, 2800);
+
+    // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales.
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-26T20:30" } })).status, 200);
+    const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  });
+});
+
+test("C4 · reembolso: es el importe menos la penalización", async () => {
+  await conApi(async (api) => {
+    const conPenalizacion = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(conPenalizacion.status, 200);
+    assert.equal(conPenalizacion.cuerpo.reserva.importe, 1200);
+    assert.equal(conPenalizacion.cuerpo.reserva.penalizacion, 600);
+    assert.equal(conPenalizacion.cuerpo.reembolso, 600);
+
+    const sinPenalizacion = await api.pedir("POST", "/api/reservas/R-0490/cancelar");
+    assert.equal(sinPenalizacion.status, 200);
+    assert.equal(sinPenalizacion.cuerpo.reserva.importe, 1200);
+    assert.equal(sinPenalizacion.cuerpo.reembolso, 1200);
+  });
+});
+
+test("C5 · exención: solo un gestor con motivo de 10 caracteres o más", async () => {
+  await conApi(async (api) => {
+    const sinIdentificar = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      cuerpo: { exento: true, motivo: "Avería en la pista" },
