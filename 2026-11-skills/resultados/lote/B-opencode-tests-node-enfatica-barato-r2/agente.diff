+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const noGestor = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      socio: SOCIO,
+      cuerpo: { exento: true, motivo: "Avería en la pista" },
+    });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const sinMotivo = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      socio: GESTOR,
+      cuerpo: { exento: true },
+    });
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const motivoCorto = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      socio: GESTOR,
+      cuerpo: { exento: true, motivo: "Avería" },
+    });
+    assert.equal(motivoCorto.status, 400);
+    assert.equal(motivoCorto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const exenta = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+      socio: GESTOR,
+      cuerpo: { exento: true, motivo: "Avería en la pista" },
+    });
+    assert.equal(exenta.status, 200);
+    assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "Avería en la pista");
+    assert.equal(exenta.cuerpo.reembolso, 1200);
+  });
+});
+
+test("C6 · una reserva que ya ha empezado no se cancela, tampoco exenta", async () => {
+  await conApi(async (api) => {
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-19T10:00" } })).status, 200);
+    const normal = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
