+  assert.equal((await cancelar(api, conMulta.id, { forzar: true })).cuerpo.reserva.penalizacion, 600);
+  assert.equal((await cancelar(api, sinMulta.id)).cuerpo.reembolso, 1200);
+  assert.equal((await cancelar(api, otroMes.id)).status, 200);
