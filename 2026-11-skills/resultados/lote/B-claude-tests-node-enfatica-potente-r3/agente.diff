+test("C7 · las no presentadas cuentan como ingresos y las canceladas no", () => conApi(async (api) => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const octubre = estado.reservas.filter((r: { inicio: string }) => r.inicio.startsWith("2026-10"));
+  const cobradas = octubre.filter((r: { estado: string }) => r.estado !== "cancelada");
+  assert.ok(octubre.some((r: { estado: string }) => r.estado === "no_presentada"));
+  assert.ok(octubre.some((r: { estado: string }) => r.estado === "cancelada"));
