+  const ingresos = cobradas.reduce((s: number, x: { importe: number }) => s + x.importe, 0);
+  assert.deepEqual(r.cuerpo.total, { reservas: cobradas.length, ingresos, penalizaciones: 0, total: ingresos });
+  assert.equal(r.cuerpo.pistas.reduce((s: number, p: { reservas: number }) => s + p.reservas, 0), cobradas.length);
+}));
