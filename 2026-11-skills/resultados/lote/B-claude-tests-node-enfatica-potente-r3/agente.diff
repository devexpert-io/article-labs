@@ -0,0 +1,289 @@
+// Spec docs/specs/reembolsos.md: penalizaciones escalonadas, exención y informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-041"; // Nora Benítez: cuota al día y sin reservas.
+
+/** Cada test arranca su propia API con la semilla limpia. */
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reservar(api: Api, pistaId: string, inicio: string, socioId = SOCIO) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201);
+  return r.cuerpo.reserva;
+}
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+function assertError(r: { status: number; cuerpo: any }, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+  assert.equal(typeof r.cuerpo.error.mensaje, "string");
+}
+
+// pista-3 en valle (martes 2026-12-01 12:00): 1200 céntimos.
+const INICIO = "2026-12-01T12:00";
+
+test("C1 · con 48 horas o más no hay penalización", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-11-28T09:00");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.deepEqual(c.cuerpo, { reserva: { ...r, estado: "cancelada" }, reembolso: 1200 });
+}));
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 %", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-11-30T09:00");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.deepEqual(c.cuerpo, { reserva: { ...r, estado: "cancelada", penalizacion: 300 }, reembolso: 900 });
+}));
+
+test("C1 · con menos de 24 horas, sin forzar, 409 FUERA_DE_PLAZO y la reserva sigue confirmada", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-11-30T12:01");
+  assertError(await cancelar(api, r.id), 409, "FUERA_DE_PLAZO");
+  assertError(await cancelar(api, r.id, { forzar: false }), 409, "FUERA_DE_PLAZO");
+  const sigue = await api.pedir("GET", `/api/reservas/${r.id}`);
+  assert.equal(sigue.status, 200);
+  assert.deepEqual(sigue.cuerpo, { reserva: r });
+}));
+
+test("C1 · con menos de 24 horas y forzar la penalización es el 50 %", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-12-01T11:59");
+  const c = await cancelar(api, r.id, { forzar: true, motivo: "Lesión" });
+  assert.equal(c.status, 200);
+  assert.deepEqual(c.cuerpo, {
+    reserva: { ...r, estado: "cancelada", penalizacion: 600, motivoCancelacion: "Lesión" },
+    reembolso: 600,
+  });
+}));
+
+test("C2 · a 48 horas justas no hay penalización", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-11-29T12:00");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.deepEqual(c.cuerpo, { reserva: { ...r, estado: "cancelada" }, reembolso: 1200 });
+}));
+
+test("C2 · un minuto después de las 48 horas ya se aplica el 25 %", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-11-29T12:01");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.deepEqual(c.cuerpo, { reserva: { ...r, estado: "cancelada", penalizacion: 300 }, reembolso: 900 });
+}));
+
+test("C2 · a 24 horas justas se aplica el 25 % sin forzar", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-11-30T12:00");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.deepEqual(c.cuerpo, { reserva: { ...r, estado: "cancelada", penalizacion: 300 }, reembolso: 900 });
+}));
+
+test("C2 · un minuto después de las 24 horas ya hace falta forzar", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", INICIO);
+  await reloj(api, "2026-11-30T12:01");
+  assertError(await cancelar(api, r.id), 409, "FUERA_DE_PLAZO");
+}));
+
+test("C3 · del 26 de marzo de 2027 a las 20:30 al 28 a las 21:00 hay 47,5 horas reales: 25 %", () => conApi(async (api) => {
+  // Domingo, punta en pista-3: 2000 céntimos.
+  const r = await reservar(api, "pista-3", "2027-03-28T21:00");
+  await reloj(api, "2027-03-26T20:30");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.deepEqual(c.cuerpo, { reserva: { ...r, estado: "cancelada", penalizacion: 500 }, reembolso: 1500 });
+}));
+
+test("C3 · en marzo, a 48 horas reales justas (21:00 del viernes) no hay penalización", () => conApi(async (api) => {
+  const r = await reservar(api, "pista-3", "2027-03-28T21:00");
+  await reloj(api, "2027-03-26T20:00");
+  const c = await cancelar(api, r.id);
+  assert.equal(c.status, 200);
+  assert.deepEqual(c.cuerpo, { reserva: { ...r, estado: "cancelada" }, reembolso: 2000 });
+}));
+
+test("C3 · en octubre, cuando se retrasa la hora, 23 horas de reloj son 24 reales y no hace falta forzar", () => conApi(async (api) => {
+  // El 31 de octubre de 2027 a las 03:00 los relojes vuelven a las 02:00. Domingo, punta: 2000.
+  const r = await reservar(api, "pista-3", "2027-10-31T10:30");
+  await reloj(api, "2027-10-30T11:30");
+  const c = await cancelar(api, r.id);
