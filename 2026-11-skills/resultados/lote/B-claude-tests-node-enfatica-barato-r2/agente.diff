+test("C5 · exención: un gestor cancela sin penalización con un motivo de 10 caracteres o más", () =>
+  conApi(async (api) => {
+    const reserva = await reservar(api, "2026-11-21T09:00", "pista-1"); // 23 horas: sin exención pediría forzar
+    await enHora(api, "2026-11-20T10:00");
+
+    // Sin cabecera X-Socio no se sabe quién pide la exención.
+    const anonimo = await cancelar(api, reserva.id, { exento: true, motivo: "Lesión hoy" });
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    // Un socio que no es gestor no puede eximir.
+    const socio = await cancelar(api, reserva.id, { exento: true, motivo: "Lesión hoy" }, SOCIO);
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    // El motivo es obligatorio y tiene que tener al menos 10 caracteres.
+    const sinMotivo = await cancelar(api, reserva.id, { exento: true }, GESTOR);
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const corto = await cancelar(api, reserva.id, { exento: true, motivo: "Lesión ho" }, GESTOR); // 9 caracteres
+    assert.equal(corto.status, 400);
+    assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    assert.equal((await estadoDe(api, reserva.id)).estado, "confirmada");
+
+    // Con 10 caracteres sí, y sin forzar.
+    const exenta = await cancelar(api, reserva.id, { exento: true, motivo: "Lesión hoy" }, GESTOR);
+    assert.equal(exenta.status, 200);
+    assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exenta.cuerpo.reembolso, reserva.importe);
+    assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "Lesión hoy");
+  }));
+
+test("C6 · reservas pasadas: una reserva que ya ha empezado no se cancela, tampoco con exención", () =>
