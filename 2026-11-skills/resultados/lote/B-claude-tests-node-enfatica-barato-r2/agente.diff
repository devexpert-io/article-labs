+test("C7 · informe de caja: ingresos de las reservas y penalizaciones, por pista y en total", () =>
+  conApi(async (api) => {
+    const a = await reservar(api, "2027-03-10T10:30", "pista-1");
+    const b = await reservar(api, "2027-03-10T12:00", "pista-2");
+    const c = await reservar(api, "2027-03-10T15:00", "pista-3");
+
+    // Martes 9 de marzo a las 10:00: B (26 horas antes) paga el 25 %; C se exime como gestor.
+    await enHora(api, "2027-03-09T10:00");
+    const penalizada = await cancelar(api, b.id, undefined, SOCIO);
+    assert.equal(penalizada.status, 200);
+    const exenta = await cancelar(api, c.id, { exento: true, motivo: "Cliente con lesión" }, GESTOR);
+    assert.equal(exenta.status, 200);
+
+    // Una reserva de abril no cuenta en marzo.
+    const deAbril = await reservar(api, "2027-04-02T10:30", "pista-1");
+    assert.equal((await estadoDe(api, deAbril.id)).estado, "confirmada");
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2027-03", { socio: GESTOR });
+    const pen = b.importe * 0.25;
+    assert.deepEqual(informe.cuerpo, {
+      mes: "2027-03",
+      pistas: [
+        { pistaId: "pista-1", reservas: 1, ingresos: a.importe, penalizaciones: 0, total: a.importe },
+        { pistaId: "pista-2", reservas: 0, ingresos: 0, penalizaciones: pen, total: pen },
+        { pistaId: "pista-3", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+        { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+      ],
+      total: { reservas: 1, ingresos: a.importe, penalizaciones: pen, total: a.importe + pen },
+    });
+  }));
+
