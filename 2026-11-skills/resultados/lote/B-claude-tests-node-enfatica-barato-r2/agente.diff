+    await enHora(api, "2026-11-20T10:00");
+    const forzada = await cancelar(api, creada.cuerpo.reserva.id, { forzar: true });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, creada.cuerpo.reserva.importe * 0.5);
+
+    // El reloj avanza: la reserva ya cancelada conserva su penalización y no se puede volver a cancelar.
+    await enHora(api, "2026-11-21T08:00");
+    const despues = await estadoDe(api, creada.cuerpo.reserva.id);
+    assert.equal(despues.penalizacion, creada.cuerpo.reserva.importe * 0.5);
+    assert.equal(despues.estado, "cancelada");
