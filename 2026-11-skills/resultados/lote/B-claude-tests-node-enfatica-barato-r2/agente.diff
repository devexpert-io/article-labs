+test("C8 · lo demás no cambia: crear reservas funciona igual y una penalización ya cobrada no se recalcula", () =>
+  conApi(async (api) => {
+    const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIO, pistaId: "pista-2", inicio: "2026-11-21T09:00" } });
+    assert.equal(creada.status, 201);
