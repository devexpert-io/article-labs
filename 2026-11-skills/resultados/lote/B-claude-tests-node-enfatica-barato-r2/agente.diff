+    assert.equal(repetida.status, 409);
+    assert.equal(repetida.cuerpo.error.codigo, "YA_CANCELADA");
+    assert.equal((await estadoDe(api, creada.cuerpo.reserva.id)).penalizacion, creada.cuerpo.reserva.importe * 0.5);
