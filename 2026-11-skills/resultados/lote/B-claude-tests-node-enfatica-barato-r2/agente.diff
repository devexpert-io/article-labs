diff --git a/test/reembolsos.test.ts b/test/reembolsos.test.ts
new file mode 100644
index 0000000..27d826c
--- /dev/null
+++ b/test/reembolsos.test.ts
@@ -0,0 +1,291 @@
+// Penalizaciones escalonadas, exención de gestor, reembolso e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Socio sin reservas y con la cuota al día (socio-041, Nora Benítez) y gestor de la semilla (socio-040).
+const SOCIO = "socio-041";
+const GESTOR = "socio-040";
+
+/** Ejecuta la prueba con una API nueva, con su propio estado y su propio reloj. */
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function enHora(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+async function reservar(api: Api, inicio: string, pistaId: string, socioId = SOCIO) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva as { id: string; importe: number; inicio: string };
+}
+
+function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+async function estadoDe(api: Api, id: string) {
+  return (await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva;
+}
+
+test("C1 · tramos: sin penalización con 48 horas o más, 25 % entre 24 y 48, y con menos de 24 solo con forzar y el 50 %", () =>
+  conApi(async (api) => {
+    const lejos = await reservar(api, "2026-11-23T10:30", "pista-1"); // 72,5 horas desde el viernes 20 a las 10:00
+    const media = await reservar(api, "2026-11-21T12:00", "pista-2"); // 26 horas
+    const cerca = await reservar(api, "2026-11-21T09:00", "pista-3"); // 23 horas
+    await enHora(api, "2026-11-20T10:00");
+
+    const sinPenalizacion = await cancelar(api, lejos.id);
+    assert.equal(sinPenalizacion.status, 200);
+    assert.equal(sinPenalizacion.cuerpo.reserva.estado, "cancelada");
+    assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, undefined);
+
+    const veinticinco = await cancelar(api, media.id);
+    assert.equal(veinticinco.status, 200);
+    assert.equal(veinticinco.cuerpo.reserva.penalizacion, media.importe * 0.25);
+
+    const sinForzar = await cancelar(api, cerca.id);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    assert.equal((await estadoDe(api, cerca.id)).estado, "confirmada");
+
+    const forzada = await cancelar(api, cerca.id, { forzar: true });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, cerca.importe * 0.5);
+  }));
+
+test("C2 · límites exactos: a 48 horas justas no hay penalización, a 24 justas es el 25 %, y a un minuto del límite cuenta el tramo de abajo", () =>
+  conApi(async (api) => {
+    const a48 = await reservar(api, "2026-11-22T10:30", "pista-3");
+    const ultimoMinuto48 = await reservar(api, "2026-11-22T16:30", "pista-3");
+    const a24 = await reservar(api, "2026-11-21T10:30", "pista-1");
+
+    // Justo 48 horas antes de la primera: sin penalización.
+    await enHora(api, "2026-11-20T10:30");
+    const exacta48 = await cancelar(api, a48.id);
+    assert.equal(exacta48.status, 200);
+    assert.equal(exacta48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exacta48.cuerpo.reembolso, a48.importe);
+
+    // A 47 horas y 59 minutos de la segunda: ya es el 25 %.
+    await enHora(api, "2026-11-20T16:31");
+    const menosDeUnMinuto = await cancelar(api, ultimoMinuto48.id);
+    assert.equal(menosDeUnMinuto.status, 200);
+    assert.equal(menosDeUnMinuto.cuerpo.reserva.penalizacion, ultimoMinuto48.importe * 0.25);
+
+    // Justo 24 horas antes de la tercera: 25 % y sin forzar.
+    await enHora(api, "2026-11-20T10:30");
+    const exacta24 = await cancelar(api, a24.id);
+    assert.equal(exacta24.status, 200);
+    assert.equal(exacta24.cuerpo.reserva.penalizacion, a24.importe * 0.25);
+
+    // A 23 horas y 59 minutos de la cuarta: ya hace falta forzar. (Se crea ahora, porque el socio ya tiene tres reservas futuras.)
+    const ultimoMinuto24 = await reservar(api, "2026-11-21T12:00", "pista-2");
+    await enHora(api, "2026-11-20T12:01");
+    const menosDeUnMinuto24 = await cancelar(api, ultimoMinuto24.id);
+    assert.equal(menosDeUnMinuto24.status, 409);
+    assert.equal(menosDeUnMinuto24.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  }));
+
+test("C3 · cambio de hora: la antelación se cuenta en horas reales de Madrid", () =>
+  conApi(async (api) => {
+    // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales (no 48,5).
+    const dosDias = await reservar(api, "2027-03-28T21:00", "pista-1");
+    const desdeOtro = await reservar(api, "2027-03-28T21:00", "pista-2");
+
+    await enHora(api, "2027-03-26T20:30");
+    const cambio = await cancelar(api, dosDias.id);
+    assert.equal(cambio.status, 200);
+    assert.equal(cambio.cuerpo.reserva.penalizacion, dosDias.importe * 0.25);
+
+    // Desde el viernes a las 21:00 hay 47 horas reales: también 25 %.
+    await enHora(api, "2027-03-26T21:00");
+    const otra = await cancelar(api, desdeOtro.id);
+    assert.equal(otra.status, 200);
+    assert.equal(otra.cuerpo.reserva.penalizacion, desdeOtro.importe * 0.25);
+  }));
+
+test("C4 · reembolso: importe menos penalización, o el importe entero si no hay penalización", () =>
+  conApi(async (api) => {
+    const sinPenalizacion = await reservar(api, "2026-11-23T10:30", "pista-1");
+    const veinticinco = await reservar(api, "2026-11-21T12:00", "pista-2");
+    const cincuenta = await reservar(api, "2026-11-21T09:00", "pista-3");
+    await enHora(api, "2026-11-20T10:00");
+
+    const a = await cancelar(api, sinPenalizacion.id);
+    assert.deepEqual(Object.keys(a.cuerpo).sort(), ["reembolso", "reserva"]);
+    assert.equal(a.cuerpo.reembolso, sinPenalizacion.importe);
+
+    const b = await cancelar(api, veinticinco.id);
+    assert.equal(b.cuerpo.reembolso, veinticinco.importe - veinticinco.importe * 0.25);
+
+    const c = await cancelar(api, cincuenta.id, { forzar: true });
+    assert.equal(c.cuerpo.reembolso, cincuenta.importe - cincuenta.importe * 0.5);
+    assert.equal(c.cuerpo.reembolso, cincuenta.importe / 2);
+  }));
