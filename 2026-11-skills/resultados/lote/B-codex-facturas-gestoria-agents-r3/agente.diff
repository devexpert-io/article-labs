index 0000000..a2eacb7
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,171 @@
+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import type { Estado, Factura } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+
+async function iniciar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+
+function comprobarError(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+  assert.equal(typeof r.cuerpo.error.mensaje, "string");
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function generar(api: Api, mes: string) {
+  return api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+}
+
+async function reservar(api: Api, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio },
+  });
+  assert.equal(r.status, 201);
+  return r.cuerpo.reserva;
+}
+
+test("solo los gestores generan y consultan facturas", async (t) => {
+  const api = await iniciar(t);
+  for (const [metodo, ruta] of [
+    ["POST", "/api/facturas"],
+    ["GET", "/api/facturas?mes=2026-10"],
+    ["GET", "/api/facturas/F2026-0001"],
+  ]) {
+    for (const socio of [undefined, "socio-999", "socio-001"]) {
+      const r = await api.pedir(metodo, ruta, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      comprobarError(r, socio === "socio-001" ? 403 : 401, socio === "socio-001" ? "SIN_PERMISO" : "NO_IDENTIFICADO");
+    }
+  }
+  assert.equal((await generar(api, "2026-10")).status, 201);
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).status, 200);
+  assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001", { socio: gestor })).status, 200);
+});
+
+test("valida el mes y solo genera meses terminados según el reloj del club", async (t) => {
+  const api = await iniciar(t);
+  for (const mes of [undefined, null, 202610, "", "2026-1", "2026-00", "2026-13", "2026-10-01", " 2026-10", "2026-10\n"]) {
+    comprobarError(await api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } }), 400, "DATOS_INVALIDOS");
+  }
+  for (const ruta of ["/api/facturas", "/api/facturas?mes=2026-13"]) {
+    comprobarError(await api.pedir("GET", ruta, { socio: gestor }), 400, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    comprobarError(await generar(api, mes), 409, "MES_ABIERTO");
+  }
+  await reloj(api, "2026-11-30T23:59");
+  comprobarError(await generar(api, "2026-11"), 409, "MES_ABIERTO");
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+});
+
+test("octubre: una factura por socio, líneas por inicio, IVA, consultas y repetición sin alterar reservas", async (t) => {
+  const api = await iniciar(t);
+  const antes: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const sinGenerar = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor });
+  assert.equal(sinGenerar.status, 200);
+  assert.deepEqual(sinGenerar.cuerpo, { facturas: [] });
+  comprobarError(await api.pedir("GET", "/api/facturas/F2026-0001", { socio: gestor }), 404, "FACTURA_NO_ENCONTRADA");
+  const primera = await generar(api, "2026-10");
+  assert.equal(primera.status, 201);
+  const facturas: Factura[] = primera.cuerpo.facturas;
+  const facturables = antes.reservas.filter((r) => r.inicio.startsWith("2026-10-") && r.estado !== "cancelada");
+  assert.ok(facturables.some((r) => r.estado === "no_presentada"));
+  const socios = [...new Set(facturables.map((r) => r.socioId))].sort();
+  assert.deepEqual(facturas.map((f) => f.socioId), socios);
+  assert.ok(!socios.includes("socio-041"));
+  for (const [i, factura] of facturas.entries()) {
+    const reservas = facturables.filter((r) => r.socioId === factura.socioId).sort((a, b) => a.inicio.localeCompare(b.inicio));
+    const total = reservas.reduce((suma, r) => suma + r.importe, 0);
+    assert.deepEqual(factura, {
+      numero: `F2026-${String(i + 1).padStart(4, "0")}`, mes: "2026-10", socioId: socios[i],
+      lineas: reservas.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })),
+      total, base: Math.round(total * 100 / 121), iva: total - Math.round(total * 100 / 121),
+    });
+    const consulta = await api.pedir("GET", `/api/facturas/${factura.numero}`, { socio: gestor });
+    assert.equal(consulta.status, 200);
+    assert.deepEqual(consulta.cuerpo, { factura });
+  }
+  const repetida = await generar(api, "2026-10");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo, primera.cuerpo);
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).cuerpo, primera.cuerpo);
+  const despues: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.deepEqual(despues.reservas, antes.reservas);
+  assert.equal(despues.facturas.length, facturas.length);
+});
+
+test("el IVA se redondea sobre los 6.400 céntimos: base 5.289 e IVA 1.111", async (t) => {
+  const api = await iniciar(t);
+  // Se crean fuera de orden para comprobar también el orden de las líneas.
+  const punta = await reservar(api, "2026-12-01T18:00");
+  const valle1 = await reservar(api, "2026-12-01T09:00");
+  const valle2 = await reservar(api, "2026-12-01T10:30");
+  await reloj(api, "2027-01-01T00:00");
+  const r = await generar(api, "2026-12");
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.cuerpo.facturas, [{
+    numero: "F2026-0001", mes: "2026-12", socioId: "socio-041",
+    lineas: [valle1, valle2, punta].map((reserva) => ({ reservaId: reserva.id, concepto: "Reserva", importe: reserva.importe })),
+    total: 6400, base: 5289, iva: 1111,
+  }]);
+});
+
+test("solo las cancelaciones con penalización se facturan, con concepto Penalización", async (t) => {
+  const api = await iniciar(t);
+  const penalizada = await reservar(api, "2026-12-01T09:00");
+  const gratuita = await reservar(api, "2026-12-02T09:00");
+  const cancelada = await api.pedir("POST", `/api/reservas/${gratuita.id}/cancelar`);
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+  await reloj(api, "2026-11-30T12:00");
+  const forzada = await api.pedir("POST", `/api/reservas/${penalizada.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 1800);
+  await reloj(api, "2027-01-01T00:00");
+  const r = await generar(api, "2026-12");
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.facturas.length, 1);
+  assert.deepEqual(r.cuerpo.facturas[0].lineas, [{ reservaId: penalizada.id, concepto: "Penalización", importe: 1800 }]);
+  assert.equal(r.cuerpo.facturas[0].total, 1800);
+});
+
+test("series por año facturado, meses fuera de orden, vacíos y peticiones simultáneas sin huecos", async (t) => {
+  const api = await iniciar(t);
+  await reservar(api, "2026-12-01T09:00");
+  await reservar(api, "2027-01-01T09:00");
+  await reloj(api, "2027-01-01T00:00");
+  const diciembre = await generar(api, "2026-12");
+  assert.equal(diciembre.cuerpo.facturas[0].numero, "F2026-0001");
+  const vacio = await generar(api, "2026-09");
+  assert.equal(vacio.status, 201);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  const vacioRepetido = await generar(api, "2026-09");
+  assert.equal(vacioRepetido.status, 200);
+  assert.deepEqual(vacioRepetido.cuerpo, vacio.cuerpo);
+  const simultaneas = await Promise.all([generar(api, "2026-10"), generar(api, "2026-10")]);
+  assert.deepEqual(simultaneas.map((r) => r.status).sort(), [200, 201]);
+  assert.deepEqual(simultaneas[0].cuerpo, simultaneas[1].cuerpo);
+  const octubre: Factura[] = simultaneas[0].cuerpo.facturas;
+  assert.equal(octubre[0].numero, "F2026-0002");
+  assert.equal((await generar(api, "2026-12")).status, 200);
+  const noviembre = await generar(api, "2026-11");
+  assert.equal(noviembre.cuerpo.facturas[0].numero, `F2026-${String(octubre.length + 2).padStart(4, "0")}`);
+  const de2026: Factura[] = [...diciembre.cuerpo.facturas, ...octubre, ...noviembre.cuerpo.facturas];
+  assert.deepEqual(de2026.map((f) => f.numero), de2026.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+  await reloj(api, "2027-02-01T00:00");
+  const enero = await generar(api, "2027-01");
+  assert.equal(enero.status, 201);
+  assert.equal(enero.cuerpo.facturas[0].numero, "F2027-0001");
+  const diciembreRepetido = await generar(api, "2026-12");
+  assert.equal(diciembreRepetido.status, 200);
+  assert.deepEqual(diciembreRepetido.cuerpo, diciembre.cuerpo);
+});
