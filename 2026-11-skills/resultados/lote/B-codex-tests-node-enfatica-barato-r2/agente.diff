diff --git a/test/reembolsos.test.ts b/test/reembolsos.test.ts
new file mode 100644
index 0000000..2c2dae1
--- /dev/null
+++ b/test/reembolsos.test.ts
@@ -0,0 +1,129 @@
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+beforeEach(async () => { api = await arrancarApi(); });
+afterEach(() => api.cerrar());
+
+async function nueva(api: Api, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-3", inicio } });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.estado, "confirmada");
+  return r.cuerpo.reserva;
+}
+
+test("C1 · aplica 0 %, 25 % y 50 % según la antelación", async () => {
+  const r48 = await nueva(api, "2026-12-01T12:00");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-29T12:00" } });
+  const gratis = await api.pedir("POST", `/api/reservas/${r48.id}/cancelar`);
+  assert.equal(gratis.status, 200);
+  assert.equal(gratis.cuerpo.reembolso, r48.importe);
+  const r24 = await nueva(api, "2026-12-02T12:00");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T00:00" } });
+  const parcial = await api.pedir("POST", `/api/reservas/${r24.id}/cancelar`);
+  assert.equal(parcial.status, 200);
+  assert.equal(parcial.cuerpo.reserva.penalizacion, 300);
+  const rCorta = await nueva(api, "2026-12-04T12:00");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-03T13:00" } });
+  const noForzada = await api.pedir("POST", `/api/reservas/${rCorta.id}/cancelar`);
+  assert.equal(noForzada.status, 409);
+  assert.deepEqual(noForzada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await api.pedir("POST", `/api/reservas/${rCorta.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+});
+
+test("C2 · los límites exactos de 48 y 24 horas no cambian de tramo", async () => {
+  const r = await nueva(api, "2026-12-03T12:00");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T12:00" } });
+  const respuesta = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+  assert.equal(respuesta.status, 200);
+  assert.equal(respuesta.cuerpo.reserva.penalizacion, 0);
+  const r24 = await nueva(api, "2026-12-05T12:00");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-04T12:00" } });
+  const justo24 = await api.pedir("POST", `/api/reservas/${r24.id}/cancelar`);
+  assert.equal(justo24.status, 200);
+  assert.equal(justo24.cuerpo.reserva.penalizacion, Math.round(r24.importe * 0.25));
+});
+
+test("C3 · el cambio de hora se calcula en horas reales de Madrid", async () => {
+  const r = await nueva(api, "2027-03-28T21:00");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-26T20:30" } });
+  const respuesta = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+  assert.equal(respuesta.status, 200);
+  assert.equal(respuesta.cuerpo.reserva.penalizacion, Math.round(r.importe * 0.25));
+});
+
+test("C4 · devuelve el importe reembolsado después de la penalización", async () => {
+  const r = await nueva(api, "2026-12-06T12:00");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-05T12:00" } });
+  const respuesta = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+  assert.equal(respuesta.status, 200);
+  assert.equal(respuesta.cuerpo.reembolso, r.importe - respuesta.cuerpo.reserva.penalizacion);
+});
+
+test("C5 · solo gestores pueden eximir con motivo válido", async () => {
+  const r = await nueva(api, "2026-12-07T12:00");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-07T11:00" } });
+  const anonimo = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { exento: true, motivo: "Motivo suficientemente largo" } });
+  assert.equal(anonimo.status, 401);
+  assert.deepEqual(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { socio: "socio-001", cuerpo: { exento: true, motivo: "Motivo suficientemente largo" } });
+  assert.equal(socio.status, 403);
+  assert.deepEqual(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const invalido = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { socio: "socio-040", cuerpo: { exento: true, motivo: "corto" } });
+  assert.equal(invalido.status, 400);
+  assert.deepEqual(invalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const exenta = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { socio: "socio-040", cuerpo: { exento: true, motivo: "Aprobado por recepción" } });
+  assert.equal(exenta.status, 200);
+  assert.equal(exenta.cuerpo.reserva.penalizacion, 0);
+  assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "Aprobado por recepción");
+});
+
+test("C6 · no permite cancelar una reserva ya empezada ni eximirla", async () => {
+  const r = await nueva(api, "2026-12-08T12:00");
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-08T12:00" } });
+  const respuesta = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { socio: "socio-040", cuerpo: { exento: true, motivo: "Motivo suficientemente largo" } });
+  assert.equal(respuesta.status, 409);
+  assert.deepEqual(respuesta.cuerpo.error.codigo, "RESERVA_PASADA");
+});
+
+test("C7 · el informe mensual calcula importes y exige gestor", async () => {
+  const sinIdentidad = await api.pedir("GET", "/api/informes/caja?mes=2026-10");
+  assert.equal(sinIdentidad.status, 401);
+  assert.deepEqual(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-001" });
+  assert.equal(socio.status, 403);
+  assert.deepEqual(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const invalido = await api.pedir("GET", "/api/informes/caja?mes=2026-13", { socio: "socio-040" });
+  assert.equal(invalido.status, 400);
+  assert.deepEqual(invalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const informe = await api.pedir("GET", "/api/informes/caja?mes=2099-01", { socio: "socio-040" });
+  assert.equal(informe.status, 200);
+  assert.deepEqual(informe.cuerpo, {
+    mes: "2099-01",
+    pistas: ["pista-1", "pista-2", "pista-3", "pista-4"].map((pistaId) => ({ pistaId, reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 })),
+    total: { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+  });
+});
+
+test("C8 · las canceladas históricas conservan su penalización y crear sigue operativo", async () => {
+  const inicial = await api.pedir("GET", "/_estado");
+  const anterior = inicial.cuerpo.reservas.find((r: any) => r.estado === "cancelada");
+  const penalizacion = anterior?.penalizacion;
+  const creada = await nueva(api, "2026-12-09T12:00");
+  const estado = await api.pedir("GET", "/_estado");
+  assert.equal(estado.status, 200);
+  assert.equal(estado.cuerpo.reservas.find((r: any) => r.id === anterior.id).penalizacion, penalizacion);
+  assert.equal(estado.cuerpo.reservas.some((r: any) => r.id === creada.id), true);
+});
+
+test("C9 · la documentación publica reglas y contrato de caja y cancelación", async () => {
+  const { readFile } = await import("node:fs/promises");
+  const readme = await readFile(new URL("../README.md", import.meta.url), "utf8");
+  assert.equal(readme.includes("25 %"), true);
+  assert.equal(readme.includes("exento"), true);
+  assert.equal(readme.includes("/api/informes/caja"), true);
+  assert.equal(readme.includes("reembolso"), true);
+});
