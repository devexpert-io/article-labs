+// Penalizaciones escalonadas, reembolsos e informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Arranca una API nueva para un test y la cierra al terminar: estado aislado por test. */
+async function conApi(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const GESTOR = "socio-040";
+
+test("C1 · tramos: 48h+ sin penalización, 24–48h al 25 % y menos de 24h solo con forzar al 50 %", async () => {
+  await conApi(async (api) => {
+    const crear = (inicio: string) => api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio } });
+    const a = await crear("2026-11-25T12:00");
+    const b = await crear("2026-11-26T12:00");
+    const c = await crear("2026-11-27T12:00");
+
+    // 50 horas antes: sin penalización.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-23T10:00" } });
+    const gratis = await api.pedir("POST", `/api/reservas/${a.cuerpo.reserva.id}/cancelar`);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, 1800);
+
+    // 26 horas antes: 25 %.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T10:00" } });
+    const cuarto = await api.pedir("POST", `/api/reservas/${b.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cuarto.cuerpo.reserva.penalizacion, 450);
+    assert.equal(cuarto.cuerpo.reembolso, 1350);
+
+    // 2 horas antes: sin forzar no se puede y, con forzar, 50 %.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-27T10:00" } });
+    const rechazada = await api.pedir("POST", `/api/reservas/${c.cuerpo.reserva.id}/cancelar`);
+    assert.equal(rechazada.status, 409);
+    assert.equal(rechazada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${c.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+  });
+});
+
+test("C2 · límites exactos: 48 horas justas sin penalización y 24 horas justas al 25 % sin forzar", async () => {
+  await conApi(async (api) => {
+    const crear = (inicio: string) => api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio } });
+    const a = await crear("2026-11-25T12:00");
+    const b = await crear("2026-11-26T12:00");
+
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-23T12:00" } });
+    const justo48 = await api.pedir("POST", `/api/reservas/${a.cuerpo.reserva.id}/cancelar`);
+    assert.equal(justo48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(justo48.cuerpo.reembolso, 1800);
+
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T12:00" } });
+    const justo24 = await api.pedir("POST", `/api/reservas/${b.cuerpo.reserva.id}/cancelar`);
+    assert.equal(justo24.status, 200);
+    assert.equal(justo24.cuerpo.reserva.penalizacion, 450);
+    assert.equal(justo24.cuerpo.reembolso, 1350);
+  });
+});
+
+test("C3 · cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  await conApi(async (api) => {
+    const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-03-28T21:00" } });
+    // Viernes 26 a las 20:30 → domingo 28 a las 21:00 son 47,5 horas reales: esa madrugada se adelanta una hora.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-26T20:30" } });
+    const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700); // 25 % de 2800 (domingo, punta)
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  });
+});
+
+test("C4 · reembolso: importe menos penalización, o el importe entero sin penalización", async () => {
+  await conApi(async (api) => {
+    const crear = (inicio: string) => api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio } });
+
+    const gratis = await crear("2026-11-25T12:00");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-23T10:00" } });
+    const r1 = await api.pedir("POST", `/api/reservas/${gratis.cuerpo.reserva.id}/cancelar`);
+    assert.equal(r1.cuerpo.reembolso, 1800);
+
+    const mitad = await crear("2026-11-26T12:00");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T10:00" } });
+    const r2 = await api.pedir("POST", `/api/reservas/${mitad.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(r2.cuerpo.reserva.penalizacion, 900);
+    assert.equal(r2.cuerpo.reembolso, r2.cuerpo.reserva.importe - r2.cuerpo.reserva.penalizacion);
+  });
+});
+
+test("C5 · exención: solo un gestor exime, con un motivo de al menos 10 caracteres", async () => {
+  await conApi(async (api) => {
+    const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T12:00" } });
+    const ruta = `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`;
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-25T10:00" } });
+
+    // Sin cabecera X-Socio: no se sabe quién es.
+    const anonimo = await api.pedir("POST", ruta, { cuerpo: { exento: true, motivo: "Motivo lo bastante largo" } });
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    // Un socio normal no es gestor.
+    const socio = await api.pedir("POST", ruta, { socio: "socio-003", cuerpo: { exento: true, motivo: "Motivo lo bastante largo" } });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    // Sin motivo, o demasiado corto, son datos inválidos.
+    const sinMotivo = await api.pedir("POST", ruta, { socio: GESTOR, cuerpo: { exento: true } });
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const corto = await api.pedir("POST", ruta, { socio: GESTOR, cuerpo: { exento: true, motivo: "corto" } });
+    assert.equal(corto.status, 400);
+    assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // Un gestor exime sin penalización ni forzar, y guarda el motivo.
+    const exenta = await api.pedir("POST", ruta, { socio: GESTOR, cuerpo: { exento: true, motivo: "Avería en la pista, sin cargo" } });
+    assert.equal(exenta.status, 200);
+    assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "Avería en la pista, sin cargo");
+    assert.equal(exenta.cuerpo.reembolso, 1800);
+  });
+});
+
