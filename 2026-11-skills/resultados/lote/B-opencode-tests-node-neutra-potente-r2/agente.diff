+/** Convierte una hora local del club (Europe/Madrid) a su instante UTC, contando el cambio de hora. */
+function aUtc(local: string): number {
+  const [fecha, hora] = local.split("T");
+  const [anio, mes, dia] = fecha.split("-").map(Number);
+  const [hh, mm] = hora.split(":").map(Number);
+  const pared = Date.UTC(anio, mes - 1, dia, hh, mm);
+  let utc = pared;
+  for (let i = 0; i < 3; i++) {
+    const partes = formatoMadrid.formatToParts(new Date(utc));
+    const valor = (tipo: string) => Number(partes.find((p) => p.type === tipo)?.value);
+    const enPared = Date.UTC(valor("year"), valor("month") - 1, valor("day"), valor("hour"), valor("minute"), valor("second"));
+    utc = pared - (enPared - utc);
+  }
+  return utc;
+}
