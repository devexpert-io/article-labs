+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { ahora });
+}
+
+async function crear(api: Api, inicio = "2027-01-15T21:00", pistaId = "pista-1") {
+  const r = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio },
+  });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.inicio, inicio);
+  assert.equal(r.cuerpo.reserva.pistaId, pistaId);
+  assert.equal(r.cuerpo.reserva.estado, "confirmada");
+  return r.cuerpo.reserva;
+}
+
+function error(r: Respuesta, http: number, codigo: string) {
+  assert.equal(r.status, http);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+  assert.equal(typeof r.cuerpo.error.mensaje, "string");
+}
+
+for (const [nombre, ahora, porcentaje] of [
+  ["C1 · más de 48 horas", "2027-01-13T20:59", 0],
+  ["C1 · entre 24 y 48 horas", "2027-01-14T09:00", 0.25],
+  ["C1 · menos de 24 horas", "2027-01-15T20:59", 0.5],
+  ["C2 · exactamente 48 horas", "2027-01-13T21:00", 0],
+  ["C2 · un minuto por debajo de 48 horas", "2027-01-13T21:01", 0.25],
+  ["C2 · exactamente 24 horas sin forzar", "2027-01-14T21:00", 0.25],
+  ["C2 · un minuto por debajo de 24 horas", "2027-01-14T21:01", 0.5],
+] as const) {
+  test(nombre, async (t) => {
+    const api = await arrancarApi();
+    t.after(() => api.cerrar());
+    const reserva = await crear(api);
+    await reloj(api, ahora);
+    const ruta = `/api/reservas/${reserva.id}/cancelar`;
+    if (porcentaje === 0.5) {
+      error(await api.pedir("POST", ruta), 409, "FUERA_DE_PLAZO");
+      const intacta = await api.pedir("GET", `/api/reservas/${reserva.id}`);
+      assert.equal(intacta.status, 200);
+      assert.deepEqual(intacta.cuerpo, { reserva });
+    }
+    const r = await api.pedir("POST", ruta, { cuerpo: { forzar: porcentaje === 0.5 } });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, {
+      reserva: { ...reserva, estado: "cancelada", penalizacion: reserva.importe * porcentaje },
+      reembolso: reserva.importe * (1 - porcentaje),
+    });
+  });
+}
