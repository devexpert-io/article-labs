diff --git a/test/reembolsos.test.ts b/test/reembolsos.test.ts
new file mode 100644
index 0000000..e777d91
--- /dev/null
+++ b/test/reembolsos.test.ts
@@ -0,0 +1,245 @@
+// Penalizaciones escalonadas, exención de gestor, reembolso e informe de caja (docs/specs/reembolsos.md), probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Arranca la API con su propio estado, fija la hora del club y la cierra al terminar. */
+async function conApi(ahora: string, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+/** Reserva la primera pista libre a esa franja. Socio por defecto: Nora Benítez, sin reservas ni penalizaciones. */
+async function reservar(api: Api, inicio: string, socioId = "socio-041") {
+  const { cuerpo } = await api.pedir("GET", `/api/disponibilidad?fecha=${inicio.slice(0, 10)}`);
+  for (const pista of cuerpo.pistas) {
+    const franja = pista.franjas.find((f: { inicio: string }) => f.inicio === inicio);
+    if (franja?.estado !== "libre") continue;
+    const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: pista.pistaId, inicio } });
+    assert.equal(creada.status, 201);
+    return creada.cuerpo.reserva as { id: string; importe: number; pistaId: string };
+  }
+  assert.fail(`No hay ninguna pista libre a las ${inicio}`);
+}
+
+const cancelar = (api: Api, id: string, cuerpo?: unknown, socio?: string) =>
+  api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+
+test("C1 · con 48 horas o más no hay penalización; entre 24 y 48, el 25 %; con menos de 24, solo con forzar y el 50 %", async () => {
+  await conApi("2026-11-18T10:00", async (api) => {
+    const lejos = await reservar(api, "2026-11-21T10:30");
+    const libre = await cancelar(api, lejos.id);
+    assert.equal(libre.status, 200);
+    assert.equal(libre.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(libre.cuerpo.reembolso, lejos.importe);
+
+    const medio = await reservar(api, "2026-11-19T19:30");
+    const parcial = await cancelar(api, medio.id);
+    assert.equal(parcial.status, 200);
+    assert.equal(parcial.cuerpo.reserva.penalizacion, medio.importe / 4);
+    assert.equal(parcial.cuerpo.reembolso, medio.importe * 0.75);
+  });
+  await conApi("2026-11-19T10:00", async (api) => {
+    const r = await reservar(api, "2026-11-19T19:30");
+    const sinForzar = await cancelar(api, r.id);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    assert.equal((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva.estado, "confirmada");
+    const forzada = await cancelar(api, r.id, { forzar: true });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, r.importe / 2);
+    assert.equal(forzada.cuerpo.reembolso, r.importe / 2);
+  });
+});
+
+test("C2 · 48 horas justas no penalizan; 24 horas justas penalizan el 25 % sin forzar; un minuto menos cambia el tramo", async () => {
+  await conApi("2026-11-18T10:30", async (api) => {
+    const justas48 = await reservar(api, "2026-11-20T10:30");
+    const sinPena = await cancelar(api, justas48.id);
+    assert.equal(sinPena.status, 200);
+    assert.equal(sinPena.cuerpo.reserva.penalizacion, undefined);
+  });
+  await conApi("2026-11-18T10:30", async (api) => {
+    const justas24 = await reservar(api, "2026-11-19T10:30");
+    const cuarto = await cancelar(api, justas24.id);
+    assert.equal(cuarto.status, 200, "a 24 horas justas no hace falta forzar");
+    assert.equal(cuarto.cuerpo.reserva.penalizacion, justas24.importe / 4);
+  });
+  await conApi("2026-11-18T10:30", async (api) => {
+    const r = await reservar(api, "2026-11-19T10:30");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:31" } });
+    const menos = await cancelar(api, r.id);
+    assert.equal(menos.status, 409, "a 23 horas y 59 minutos ya hace falta forzar");
+    assert.equal(menos.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  });
+  await conApi("2026-11-18T10:30", async (api) => {
+    const r = await reservar(api, "2026-11-20T10:30");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:31" } });
+    const casi48 = await cancelar(api, r.id);
+    assert.equal(casi48.status, 200);
+    assert.equal(casi48.cuerpo.reserva.penalizacion, r.importe / 4, "a 47 horas y 59 minutos ya hay penalización del 25 %");
+  });
+});
+
+test("C3 · la antelación cuenta horas reales de Madrid, con el cambio de hora de marzo", async () => {
+  // Viernes 26 de marzo de 2027 a las 20:30 hasta domingo 28 a las 21:00: 47,5 horas reales (se adelanta el reloj).
+  await conApi("2027-03-26T20:30", async (api) => {
+    const r = await reservar(api, "2027-03-28T21:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, r.importe / 4, "47,5 horas reales son menos de 48: 25 %");
+  });
+  // Jueves 25 a las 20:30 hasta sábado 27 a las 21:00, sin cambio de hora: 48,5 horas, sin penalización.
+  await conApi("2027-03-25T20:30", async (api) => {
+    const r = await reservar(api, "2027-03-27T21:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c.cuerpo.reembolso, r.importe);
+  });
+});
+
+test("C4 · el reembolso es el importe menos la penalización, o el importe entero si no hay penalización", async () => {
+  await conApi("2026-11-18T10:00", async (api) => {
+    const r = await reservar(api, "2026-11-19T19:30");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.deepEqual(
+      { reembolso: c.cuerpo.reembolso, penalizacion: c.cuerpo.reserva.penalizacion },
+      { reembolso: r.importe - r.importe / 4, penalizacion: r.importe / 4 },
+    );
+    const otra = await reservar(api, "2026-11-22T12:00");
+    const sinPena = await cancelar(api, otra.id);
+    assert.equal(sinPena.cuerpo.reembolso, otra.importe);
+  });
+});
+
