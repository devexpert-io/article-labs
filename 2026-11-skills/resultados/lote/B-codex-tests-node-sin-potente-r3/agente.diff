+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado } from "../src/tipos.ts";
+
+async function crear(api: Api, inicio = "2026-12-10T12:00", pistaId = "pista-1") {
+  const respuesta = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio },
+  });
+  assert.equal(respuesta.status, 201);
+  return respuesta.cuerpo.reserva;
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+for (const caso of [
+  { ahora: "2026-12-08T11:59", porcentaje: 0 },
+  { ahora: "2026-12-08T12:00", porcentaje: 0 },
+  { ahora: "2026-12-08T12:01", porcentaje: 0.25 },
+  { ahora: "2026-12-09T00:00", porcentaje: 0.25 },
+  { ahora: "2026-12-09T12:00", porcentaje: 0.25 },
+  { ahora: "2026-12-09T12:01", porcentaje: 0.5 },
+  { ahora: "2026-12-10T11:59", porcentaje: 0.5 },
+]) {
+  test(`tramo y reembolso al cancelar desde ${caso.ahora}`, async (t) => {
+    const api = await arrancarApi();
+    t.after(() => api.cerrar());
+    const reserva = await crear(api);
+    assert.equal(reserva.importe, 1800);
+    await reloj(api, caso.ahora);
+    const ruta = `/api/reservas/${reserva.id}/cancelar`;
+    if (caso.porcentaje === 0.5) {
+      for (const cuerpo of [{}, { forzar: false }]) {
+        const rechazada = await api.pedir("POST", ruta, { cuerpo });
+        assert.equal(rechazada.status, 409);
+        assert.equal(rechazada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+      }
+      assert.equal((await api.pedir("GET", `/api/reservas/${reserva.id}`)).cuerpo.reserva.estado, "confirmada");
+    }
+    const respuesta = await api.pedir("POST", ruta, { cuerpo: { forzar: caso.porcentaje === 0.5 } });
+    assert.equal(respuesta.status, 200);
+    assert.equal(respuesta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(respuesta.cuerpo.reserva.penalizacion, reserva.importe * caso.porcentaje);
+    assert.equal(respuesta.cuerpo.reembolso, reserva.importe * (1 - caso.porcentaje));
+  });
