+// Penalizaciones escalonadas, exenciones e informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function crear(api: Api, socioId: string, pistaId: string, inicio: string) {
+  return api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+}
+
+function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+test("C1 · con 48 horas o más de antelación no hay penalización", async () => {
+  await conApi({ AHORA: "2027-01-09T10:30" }, async (api) => {
+    const creada = await crear(api, "socio-003", "pista-1", "2027-01-12T10:30");
+    assert.equal(creada.status, 201);
+    const cancelada = await cancelar(api, creada.cuerpo.reserva.id);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, undefined);
+  });
+});
+
+test("C1 · entre 24 y 48 horas la penalización es el 25 % del importe", async () => {
+  await conApi({ AHORA: "2027-01-11T00:30" }, async (api) => {
+    const creada = await crear(api, "socio-003", "pista-1", "2027-01-12T10:30");
+    const cancelada = await cancelar(api, creada.cuerpo.reserva.id);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 450);
+  });
+});
+
+test("C1 · por debajo de 24 horas exige forzar y la penalización es el 50 %", async () => {
+  await conApi({ AHORA: "2027-01-12T10:00" }, async (api) => {
+    const creada = await crear(api, "socio-003", "pista-1", "2027-01-12T10:30");
+    const sinForzar = await cancelar(api, creada.cuerpo.reserva.id);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await cancelar(api, creada.cuerpo.reserva.id, { forzar: true });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+  });
+});
+
+test("C2 · a 48 horas justas no hay penalización y a 24 horas justas se aplica el 25 % sin forzar", async () => {
+  await conApi({ AHORA: "2027-01-10T10:30" }, async (api) => {
+    const a48 = await crear(api, "socio-003", "pista-1", "2027-01-12T10:30");
+    const cancelada48 = await cancelar(api, a48.cuerpo.reserva.id);
+    assert.equal(cancelada48.status, 200);
+    assert.equal(cancelada48.cuerpo.reserva.penalizacion, undefined);
+
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-11T10:30" } });
+    const a24 = await crear(api, "socio-006", "pista-1", "2027-01-12T10:30");
+    const cancelada24 = await cancelar(api, a24.cuerpo.reserva.id);
+    assert.equal(cancelada24.status, 200);
+    assert.equal(cancelada24.cuerpo.reserva.penalizacion, 450);
+  });
+});
+
+test("C3 · la antelación cuenta horas reales de Madrid con el cambio de hora", async () => {
+  await conApi({ AHORA: "2027-03-26T20:30" }, async (api) => {
+    // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales,
+    // no 48,5: esa madrugada los relojes se adelantan una hora.
+    const creada = await crear(api, "socio-003", "pista-1", "2027-03-28T21:00");
+    assert.equal(creada.status, 201);
+    assert.equal(creada.cuerpo.reserva.importe, 2800);
+    const cancelada = await cancelar(api, creada.cuerpo.reserva.id);
