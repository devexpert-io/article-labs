+});
+
+test("C5 · eximir con el motivo ausente o demasiado corto es DATOS_INVALIDOS", async () => {
+  await conApi({ AHORA: "2027-01-10T10:30" }, async (api) => {
+    const sinMotivo = await crear(api, "socio-003", "pista-1", "2027-01-12T10:30");
+    const respuestaSin = await cancelar(api, sinMotivo.cuerpo.reserva.id, { exento: true }, "socio-040");
+    assert.equal(respuestaSin.status, 400);
