+
+test("C5 · eximir sin ser gestor es SIN_PERMISO y sin identidad es NO_IDENTIFICADO", async () => {
+  await conApi({ AHORA: "2027-01-10T10:30" }, async (api) => {
+    const deSocio = await crear(api, "socio-003", "pista-1", "2027-01-12T10:30");
+    const sinPermiso = await cancelar(api, deSocio.cuerpo.reserva.id, { exento: true, motivo: "Pista rota" }, "socio-003");
