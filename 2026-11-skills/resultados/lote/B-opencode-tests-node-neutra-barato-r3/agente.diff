+test("C7 · el informe de un mes con historial incluye todas las pistas y los no presentados", async () => {
+  await conApi({}, async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+    assert.deepEqual(informe.cuerpo.pistas.map((p: { pistaId: string }) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+
+    const delMes = estado.reservas.filter((r: { inicio: string }) => r.inicio.slice(0, 7) === "2026-10");
+    const cobradas = delMes.filter((r: { estado: string }) => r.estado === "confirmada" || r.estado === "no_presentada");
+    const canceladas = delMes.filter((r: { estado: string }) => r.estado === "cancelada");
+    assert.equal(informe.cuerpo.total.reservas, cobradas.length);
+    assert.equal(informe.cuerpo.total.ingresos, cobradas.reduce((s: number, r: { importe: number }) => s + r.importe, 0));
+    assert.equal(informe.cuerpo.total.penalizaciones, canceladas.reduce((s: number, r: { penalizacion?: number }) => s + (r.penalizacion ?? 0), 0));
+    assert.ok(cobradas.some((r: { estado: string }) => r.estado === "no_presentada"), "octubre tiene reservas no presentadas");
+  });
+});
