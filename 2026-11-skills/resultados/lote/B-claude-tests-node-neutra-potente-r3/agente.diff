+
+test("C3 · en el cambio de hora de marzo, del viernes 19:00 al domingo 21:00 hay 49 horas: gratis", () => conApi(async (api) => {
+  await reloj(api, "2027-03-20T10:00");
+  const r = await reservar(api, "2027-03-28T21:00");
+  await reloj(api, "2027-03-26T19:00");
