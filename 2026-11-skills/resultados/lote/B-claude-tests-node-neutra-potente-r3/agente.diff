+
+test("C3 · en el cambio de hora de octubre, del viernes 21:30 al domingo 21:00 hay 48,5 horas: gratis", () => conApi(async (api) => {
+  await reloj(api, "2027-10-20T10:00");
+  const r = await reservar(api, "2027-10-31T21:00");
+  await reloj(api, "2027-10-29T21:30");
+  const res = await cancelar(api, r.id);
+  assert.equal(res.status, 200);
+  assert.equal(res.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(res.cuerpo.reembolso, 2000);
+}));
+
+test("C4 · el reembolso es el importe menos la penalización, o el importe entero sin penalización", () => conApi(async (api) => {
+  const cara = await reservar(api, "2026-11-25T19:30", "pista-1"); // punta: 2800
+  await reloj(api, "2026-11-24T10:00");
+  const conPenalizacion = await cancelar(api, cara.id);
+  assert.equal(conPenalizacion.cuerpo.reserva.penalizacion, 700);
+  assert.equal(conPenalizacion.cuerpo.reembolso, 2100);
+  await reloj(api, "2026-11-20T10:00");
