+test("C7 · el informe suma reservas confirmadas y no presentadas, y las penalizaciones de las canceladas", () => conApi(async (api) => {
+  await reloj(api, "2026-11-28T10:00");
+  const r1 = await reservar(api, "2026-11-30T19:30", "pista-1"); // 2800
+  const r2 = await reservar(api, "2026-12-01T12:00", "pista-3"); // empieza en diciembre
+  await reloj(api, "2026-11-29T10:00");
+  assert.equal((await cancelar(api, r1.id)).cuerpo.reserva.penalizacion, 700);
+  const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR });
+  assert.equal(informe.status, 200);
+
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const delMes = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-11"));
+  const fila = (lista: any[]) => {
+    const cobradas = lista.filter((r) => r.estado !== "cancelada");
+    const ingresos = cobradas.reduce((s, r) => s + r.importe, 0);
+    const penalizaciones = lista.filter((r) => r.estado === "cancelada").reduce((s, r) => s + (r.penalizacion ?? 0), 0);
+    return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+  };
+  assert.deepEqual(informe.cuerpo, {
+    mes: "2026-11",
+    pistas: ["pista-1", "pista-2", "pista-3", "pista-4"].map((pistaId) => ({ pistaId, ...fila(delMes.filter((r: any) => r.pistaId === pistaId)) })),
+    total: fila(delMes),
+  });
+  assert.equal(informe.cuerpo.total.penalizaciones, 700);
+  assert.ok(informe.cuerpo.total.reservas > 0);
+  assert.ok(delMes.some((r: any) => r.estado === "no_presentada"));
+  assert.ok(!delMes.some((r: any) => r.id === r2.id));
+}));
+
