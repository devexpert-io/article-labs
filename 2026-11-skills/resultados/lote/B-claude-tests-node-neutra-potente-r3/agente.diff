+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.reservas.find((x: any) => x.id === r.id).penalizacion, 600);
+  const despues = estado.reservas.filter((x: any) => antes.some((a: any) => a.id === x.id));
+  assert.deepEqual(despues, antes);
