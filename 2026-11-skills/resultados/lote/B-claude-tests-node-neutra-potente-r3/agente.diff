+// Spec docs/specs/reembolsos.md: penalizaciones escalonadas e informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-041"; // Nora Benítez: cuota al día y sin reservas.
+// Miércoles 25 de noviembre a las 12:00 en la pista 3: hora valle, 1200 céntimos.
+const INICIO = "2026-11-25T12:00";
+
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reservar(api: Api, inicio = INICIO, pistaId = "pista-3"): Promise<{ id: string; importe: number }> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIO, pistaId, inicio } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.reserva;
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+test("C1 · con 48 horas o más no hay penalización", () => conApi(async (api) => {
+  const r = await reservar(api);
+  await reloj(api, "2026-11-22T12:00");
+  const res = await cancelar(api, r.id);
+  assert.equal(res.status, 200);
+  assert.equal(res.cuerpo.reserva.estado, "cancelada");
+  assert.equal(res.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(res.cuerpo.reembolso, 1200);
+}));
+
+test("C1 · entre 24 y 48 horas la penalización es del 25 %", () => conApi(async (api) => {
+  const r = await reservar(api);
+  await reloj(api, "2026-11-23T20:00");
+  const res = await cancelar(api, r.id);
+  assert.equal(res.status, 200);
+  assert.equal(res.cuerpo.reserva.penalizacion, 300);
+  assert.equal(res.cuerpo.reembolso, 900);
+}));
+
+test("C1 · con menos de 24 horas sin forzar responde 409 FUERA_DE_PLAZO y no cancela", () => conApi(async (api) => {
+  const r = await reservar(api);
+  await reloj(api, "2026-11-25T08:00");
+  const res = await cancelar(api, r.id);
+  assert.equal(res.status, 409);
+  assert.equal(res.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  assert.equal((await api.pedir("GET", `/api/reservas/${r.id}`)).cuerpo.reserva.estado, "confirmada");
+}));
+
+test("C1 · con menos de 24 horas y forzar la penalización es del 50 %", () => conApi(async (api) => {
+  const r = await reservar(api);
+  await reloj(api, "2026-11-25T08:00");
+  const res = await cancelar(api, r.id, { forzar: true });
+  assert.equal(res.status, 200);
+  assert.equal(res.cuerpo.reserva.penalizacion, 600);
+  assert.equal(res.cuerpo.reembolso, 600);
+}));
+
+test("C2 · a 48 horas justas no hay penalización", () => conApi(async (api) => {
+  const r = await reservar(api);
+  await reloj(api, "2026-11-23T12:00");
+  const res = await cancelar(api, r.id);
+  assert.equal(res.status, 200);
+  assert.equal(res.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(res.cuerpo.reembolso, 1200);
+}));
+
+test("C2 · un minuto menos de 48 horas ya cobra el 25 %", () => conApi(async (api) => {
+  const r = await reservar(api);
+  await reloj(api, "2026-11-23T12:01");
+  const res = await cancelar(api, r.id);
+  assert.equal(res.cuerpo.reserva.penalizacion, 300);
+}));
+
+test("C2 · a 24 horas justas se aplica el 25 % sin forzar", () => conApi(async (api) => {
+  const r = await reservar(api);
+  await reloj(api, "2026-11-24T12:00");
+  const res = await cancelar(api, r.id);
+  assert.equal(res.status, 200);
+  assert.equal(res.cuerpo.reserva.penalizacion, 300);
+  assert.equal(res.cuerpo.reembolso, 900);
