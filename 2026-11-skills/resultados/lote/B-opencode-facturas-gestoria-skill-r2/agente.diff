+
+/**
+ * Construye las facturas de un mes siguiendo las reglas de la gestoría:
+ * una factura por socio con algo que facturar, sus líneas por reserva que
+ * empieza ese mes y la numeración correlativa por año.
+ */
+function generarFacturasDelMes(estado: Estado, mes: string): Factura[] {
+  const año = mes.slice(0, 4);
+  const usados = estado.facturas
+    .filter((f) => f.numero.startsWith(`F${año}-`))
+    .map((f) => Number(f.numero.slice(-4)));
+  let siguiente = usados.length === 0 ? 1 : Math.max(...usados) + 1;
+
+  const socios = [...estado.socios].sort((a, b) => a.id.localeCompare(b.id));
+  const facturas: Factura[] = [];
+  for (const socio of socios) {
+    const reservas = estado.reservas
+      .filter((r) => r.socioId === socio.id && r.inicio.slice(0, 7) === mes)
+      .sort((a, b) => (a.inicio === b.inicio ? a.id.localeCompare(b.id) : a.inicio.localeCompare(b.inicio)));
+    const lineas: LineaFactura[] = [];
+    for (const r of reservas) {
+      if (r.estado === "confirmada" || r.estado === "no_presentada") {
+        lineas.push({ reservaId: r.id, concepto: "Reserva", importe: r.importe });
+      } else if (r.estado === "cancelada" && (r.penalizacion ?? 0) > 0) {
+        lineas.push({ reservaId: r.id, concepto: "Penalización", importe: r.penalizacion! });
+      }
+    }
+    if (lineas.length === 0) continue;
+    const total = lineas.reduce((suma, l) => suma + l.importe, 0);
+    const base = Math.round((total * 100) / 121);
+    facturas.push({
+      numero: `F${año}-${String(siguiente).padStart(4, "0")}`,
+      mes,
+      socioId: socio.id,
+      lineas,
+      total,
+      base,
+      iva: total - base,
+    });
+    siguiente += 1;
+  }
+  return facturas;
+}
