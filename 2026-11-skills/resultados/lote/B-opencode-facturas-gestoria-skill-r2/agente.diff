+// Facturas mensuales de la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+test("solo un gestor genera y consulta facturas", async () => {
+  const api = await arrancarApi();
+  try {
+    const sinCabecera = await api.pedir("GET", "/api/facturas?mes=2026-10");
+    assert.equal(sinCabecera.status, 401);
+    assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinCabeceraPost = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+    assert.equal(sinCabeceraPost.status, 401);
+
+    const sinCabeceraNumero = await api.pedir("GET", "/api/facturas/F2026-0001");
+    assert.equal(sinCabeceraNumero.status, 401);
+
+    const noGestor = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const noGestorPost = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+    assert.equal(noGestorPost.status, 403);
+
+    const gestor = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.equal(gestor.status, 200);
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("solo se factura un mes cerrado, con formato AAAA-MM", async () => {
+  const api = await arrancarApi(); // ahora = 2026-11-18
+  try {
+    const mal = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-1" }, socio: GESTOR });
+    assert.equal(mal.status, 400);
+    assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    assert.equal(abierto.status, 409);
+    assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+
+    const futuro = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+    assert.equal(futuro.status, 409);
+    assert.equal(futuro.cuerpo.error.codigo, "MES_ABIERTO");
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("genera una factura por socio con sus líneas, IVA y numeración", async () => {
+  const api = await arrancarApi({ AHORA: "2026-12-01T08:00" });
+  try {
