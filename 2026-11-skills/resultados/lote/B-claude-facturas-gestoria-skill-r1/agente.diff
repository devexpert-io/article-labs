@@ -0,0 +1,238 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, describe, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+/** Las facturas que deberían salir de un mes, calculadas a partir del estado con las reglas de la gestoría. */
+function esperadas(estado: any, mes: string) {
+  const porSocio = new Map<string, { reservaId: string; concepto: string; importe: number }[]>();
+  const delMes = estado.reservas
+    .filter((r: any) => r.inicio.startsWith(mes))
+    .sort((a: any, b: any) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+  for (const r of delMes) {
+    let linea;
+    if (r.estado === "confirmada" || r.estado === "no_presentada") linea = { reservaId: r.id, concepto: "Reserva", importe: r.importe };
+    else if (r.penalizacion > 0) linea = { reservaId: r.id, concepto: "Penalización", importe: r.penalizacion };
+    if (!linea) continue;
+    if (!porSocio.has(r.socioId)) porSocio.set(r.socioId, []);
+    porSocio.get(r.socioId)!.push(linea);
+  }
+  return [...porSocio.keys()].sort().map((socioId) => {
+    const lineas = porSocio.get(socioId)!;
+    const total = lineas.reduce((s, l) => s + l.importe, 0);
+    const base = Math.round((total * 100) / 121);
+    return { mes, socioId, lineas, total, base, iva: total - base };
+  });
+}
+
+const sinNumero = (facturas: any[]) => facturas.map(({ numero: _n, ...resto }) => resto);
+const numeros = (facturas: any[]) => facturas.map((f) => f.numero);
+const serie = (anio: number, desde: number, cuantas: number) =>
+  Array.from({ length: cuantas }, (_, i) => `F${anio}-${String(desde + i).padStart(4, "0")}`);
+
+describe("facturas de octubre de 2026", () => {
+  let api: Api;
+  before(async () => {
+    api = await arrancarApi();
+  });
+  after(() => api.cerrar());
+
+  test("solo un gestor genera y consulta facturas", async () => {
+    for (const [metodo, ruta, cuerpo] of [
+      ["POST", "/api/facturas", { mes: "2026-10" }],
+      ["GET", "/api/facturas?mes=2026-10", undefined],
+      ["GET", "/api/facturas/F2026-0001", undefined],
+    ] as const) {
+      const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+      assert.equal(anonimo.status, 401, `${metodo} ${ruta}`);
+      assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+      const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-003" });
+      assert.equal(socio.status, 403, `${metodo} ${ruta}`);
+      assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+    }
+    // Nada de lo anterior ha generado facturas.
+    assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.facturas, []);
+  });
+
+  test("mes debe ser AAAA-MM y estar cerrado", async () => {
+    for (const cuerpo of [{}, { mes: "2026-13" }, { mes: "2026-1" }, { mes: "octubre" }, { mes: 202610 }]) {
+      const r = await api.pedir("POST", "/api/facturas", { cuerpo, socio: GESTOR });
+      assert.equal(r.status, 400, JSON.stringify(cuerpo));
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10-01", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+    for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+      const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+      assert.equal(r.status, 409, mes);
+      assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+    }
+  });
+
+  test("genera una factura por socio con algo que facturar, con sus líneas, IVA y numeración", async () => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(r.status, 201);
+    const { facturas } = r.cuerpo;
+    const previstas = esperadas(estado, "2026-10");
+    assert.ok(previstas.length > 10, "octubre tiene historial");
+    assert.deepEqual(sinNumero(facturas), previstas);
+    assert.deepEqual(numeros(facturas), serie(2026, 1, previstas.length));
+
+    // Ninguna factura para quien no tiene nada que facturar ese mes.
+    const conFactura = new Set(facturas.map((f: any) => f.socioId));
+    assert.ok(!conFactura.has("socio-041"));
+    // Las canceladas sin penalización (todas las del historial) no entran.
+    const canceladas = estado.reservas.filter((x: any) => x.inicio.startsWith("2026-10") && x.estado === "cancelada");
+    assert.ok(canceladas.length > 0);
+    const facturadas = new Set(facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId)));
+    for (const c of canceladas) assert.ok(!facturadas.has(c.id), `${c.id} cancelada sin penalización`);
+    // Las no presentadas sí entran, como Reserva.
+    const noPresentada = estado.reservas.find((x: any) => x.inicio.startsWith("2026-10") && x.estado === "no_presentada");
+    const linea = facturas.flatMap((f: any) => f.lineas).find((l: any) => l.reservaId === noPresentada.id);
+    assert.deepEqual(linea, { reservaId: noPresentada.id, concepto: "Reserva", importe: noPresentada.importe });
+
+    for (const f of facturas) {
+      assert.equal(f.base + f.iva, f.total);
+      const inicios = f.lineas.map((l: any) => estado.reservas.find((x: any) => x.id === l.reservaId).inicio);
+      assert.deepEqual(inicios, [...inicios].sort());
+    }
+  });
+
+  test("generar otra vez devuelve las mismas facturas y no crea ninguna", async () => {
+    const primera = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    const otra = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(otra.status, 200);
+    assert.deepEqual(otra.cuerpo.facturas, primera.cuerpo.facturas);
+    assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, primera.cuerpo.facturas.length);
+  });
+
+  test("consultar facturas por mes y por número", async () => {
+    const octubre = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas;
+    assert.ok(octubre.length > 0);
+    const sinGenerar = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+    assert.equal(sinGenerar.status, 200);
+    assert.deepEqual(sinGenerar.cuerpo, { facturas: [] });
+    const una = await api.pedir("GET", "/api/facturas/F2026-0002", { socio: GESTOR });
+    assert.equal(una.status, 200);
+    assert.deepEqual(una.cuerpo, { factura: octubre[1] });
+    const no = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+    assert.equal(no.status, 404);
+    assert.equal(no.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  });
+
+  test("reservar, cancelar y consultar reservas sigue igual", async () => {
+    const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-2", inicio: "2026-11-25T09:00" } });
+    assert.equal(creada.status, 201);
+    assert.equal(creada.cuerpo.reserva.importe, 1800);
+    const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.estado, "cancelada");
+    const octubre = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=1");
+    assert.equal(octubre.cuerpo.total, 315);
+  });
+});
+
+describe("facturas entre meses y años", () => {
+  let api: Api;
+  before(async () => {
+    api = await arrancarApi();
+  });
+  after(() => api.cerrar());
+
+  const reservar = async (socioId: string, pistaId: string, inicio: string) => {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+    assert.equal(r.status, 201, `${socioId} ${inicio}: ${r.texto}`);
+    return r.cuerpo.reserva;
+  };
+  const reloj = async (ahora: string) => assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+  const generar = (mes: string) => api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+
+  test("diciembre: IVA sobre el total, penalizaciones y numeración generada en enero", async () => {
+    // Después de la última reserva de la semilla nadie tiene reservas futuras.
+    await reloj("2026-11-25T00:00");
+    // Tres reservas de 1.800, 1.800 y 2.800: total 6.400.
+    const r1 = await reservar("socio-003", "pista-1", "2026-12-01T09:00");
+    const r2 = await reservar("socio-003", "pista-1", "2026-12-02T09:00");
+    const r3 = await reservar("socio-003", "pista-1", "2026-12-03T18:00");
+    assert.deepEqual([r1.importe, r2.importe, r3.importe], [1800, 1800, 2800]);
+    const penalizada = await reservar("socio-006", "pista-3", "2026-12-10T09:00");
+    const gratis = await reservar("socio-006", "pista-3", "2026-12-11T09:00");
+    const otra = await reservar("socio-008", "pista-3", "2026-12-14T09:00");
+    const enero = await reservar("socio-013", "pista-3", "2027-01-12T09:00");
+
+    await reloj("2026-12-09T12:00");
+    const cancelada = await api.pedir("POST", `/api/reservas/${penalizada.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 1200);
+    const sinPenalizacion = await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`);
+    assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, undefined);
+
+    // Diciembre todavía está abierto el 31 a última hora.
+    await reloj("2026-12-31T23:59");
+    assert.equal((await generar("2026-12")).cuerpo.error.codigo, "MES_ABIERTO");
+
+    await reloj("2027-01-10T10:00");
+    const octubre = await generar("2026-10");
+    assert.equal(octubre.status, 201);
+    const n = octubre.cuerpo.facturas.length;
+
+    // Diciembre se genera antes que noviembre y sigue la serie de 2026.
+    const diciembre = await generar("2026-12");
+    assert.equal(diciembre.status, 201);
+    assert.deepEqual(diciembre.cuerpo.facturas, [
+      {
+        numero: serie(2026, n + 1, 1)[0],
+        mes: "2026-12",
+        socioId: "socio-003",
+        lineas: [r1, r2, r3].map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })),
+        total: 6400,
+        base: 5289,
+        iva: 1111,
+      },
+      {
+        numero: serie(2026, n + 2, 1)[0],
+        mes: "2026-12",
+        socioId: "socio-006",
+        lineas: [{ reservaId: penalizada.id, concepto: "Penalización", importe: 1200 }],
+        total: 1200,
+        base: 992,
+        iva: 208,
+      },
+      {
+        numero: serie(2026, n + 3, 1)[0],
+        mes: "2026-12",
+        socioId: "socio-008",
+        lineas: [{ reservaId: otra.id, concepto: "Reserva", importe: 1200 }],
+        total: 1200,
+        base: 992,
+        iva: 208,
+      },
