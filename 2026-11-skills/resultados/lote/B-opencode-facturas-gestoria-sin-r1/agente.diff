@@ -0,0 +1,175 @@
+// Facturas mensuales de la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+test("solo un gestor genera y consulta facturas", async () => {
+  const generarSin = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+  assert.equal(generarSin.status, 401);
+  assert.equal(generarSin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const generarSocio = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+  assert.equal(generarSocio.status, 403);
+  assert.equal(generarSocio.cuerpo.error.codigo, "SIN_PERMISO");
+  const listarSin = await api.pedir("GET", "/api/facturas?mes=2026-10");
+  assert.equal(listarSin.status, 401);
+  const listarSocio = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" });
+  assert.equal(listarSocio.status, 403);
+  const unaSin = await api.pedir("GET", "/api/facturas/FAC-2026-0001");
+  assert.equal(unaSin.status, 401);
+});
+
+test("mes cerrado: formato AAAA-MM y que ya haya terminado", async () => {
+  const malFormato = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-1" }, socio: GESTOR });
+  assert.equal(malFormato.status, 400);
+  assert.equal(malFormato.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const sinMes = await api.pedir("POST", "/api/facturas", { cuerpo: {}, socio: GESTOR });
+  assert.equal(sinMes.status, 400);
+  assert.equal(sinMes.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const mesActual = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+  assert.equal(mesActual.status, 409);
+  assert.equal(mesActual.cuerpo.error.codigo, "MES_ABIERTO");
+  const mesFuturo = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+  assert.equal(mesFuturo.status, 409);
+  assert.equal(mesFuturo.cuerpo.error.codigo, "MES_ABIERTO");
+  const octubre = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(octubre.status, 201);
+});
+
+test("una factura por socio, ordenadas por id de socio", async () => {
+  const lista = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(lista.status, 200);
+  const facturas = lista.cuerpo.facturas;
+  assert.equal(facturas.length, 40);
+  const socios = facturas.map((f: { socioId: string }) => f.socioId);
+  assert.deepEqual(socios, [...socios].sort());
+  // Nora Benítez (socio-041) no tiene reservas en octubre, así que no tiene factura.
+  assert.equal(socios.includes("socio-041"), false);
+});
+
+test("líneas, total e IVA", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const factura = (await api.pedir("GET", "/api/facturas/FAC-2026-0001", { socio: GESTOR })).cuerpo.factura;
+  assert.equal(factura.socioId, "socio-001");
+  assert.equal(factura.mes, "2026-10");
+  assert.equal(factura.lineas.length, 3);
+  for (const linea of factura.lineas) assert.equal(linea.concepto, "Reserva");
+  // Ordenadas por el inicio de la reserva.
+  const inicios = factura.lineas.map((l: { reservaId: string }) => estado.reservas.find((r: { id: string }) => r.id === l.reservaId).inicio);
+  assert.deepEqual(inicios, [...inicios].sort());
+  const total = factura.lineas.reduce((s: number, l: { importe: number }) => s + l.importe, 0);
+  assert.equal(factura.total, total);
+  assert.equal(factura.total, 6800);
+  assert.equal(factura.base, 5620);
+  assert.equal(factura.iva, 1180);
+  assert.equal(factura.base + factura.iva, factura.total);
+
+  // Caso con una sola línea y redondeo claro: socio-013, 2200 céntimos.
+  const otra = (await api.pedir("GET", "/api/facturas/FAC-2026-0013", { socio: GESTOR })).cuerpo.factura;
+  assert.equal(otra.socioId, "socio-013");
+  assert.equal(otra.lineas.length, 1);
+  assert.equal(otra.total, 2200);
+  assert.equal(otra.base, 1818);
+  assert.equal(otra.iva, 382);
+});
+
+test("generar dos veces devuelve las mismas facturas", async () => {
+  const primera = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas;
+  const repetida = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo.facturas, primera);
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.facturas.length, 40);
+});
+
+test("consultar facturas", async () => {
+  const lista = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(lista.status, 200);
+  assert.equal(lista.cuerpo.facturas.length, 40);
+  const vacia = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+  assert.equal(vacia.status, 200);
+  assert.deepEqual(vacia.cuerpo.facturas, []);
+  const una = await api.pedir("GET", "/api/facturas/FAC-2026-0040", { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.equal(una.cuerpo.factura.socioId, "socio-040");
+  const inexistente = await api.pedir("GET", "/api/facturas/FAC-2099-0001", { socio: GESTOR });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("facturar no rompe reservar", async () => {
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-004", pistaId: "pista-2", inicio: "2026-11-24T15:00" } });
+  assert.equal(creada.status, 201);
+});
+
+test("numeración correlativa por año, entre meses y entre años", async () => {
+  const otra = await arrancarApi();
+  try {
+    const octubre = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(octubre.status, 201);
+    assert.equal(octubre.cuerpo.facturas[0].numero, "FAC-2026-0001");
+    assert.equal(octubre.cuerpo.facturas.at(-1).numero, "FAC-2026-0040");
+
+    // Se crea una reserva en enero de 2027 y se cierra enero.
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-15T10:00" } });
+    const reserva = await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-001", pistaId: "pista-1", inicio: "2027-01-20T10:30" } });
+    assert.equal(reserva.status, 201);
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-15T10:00" } });
+
+    // Noviembre de 2026 continúa la numeración de 2026.
+    const noviembre = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    assert.equal(noviembre.cuerpo.facturas[0].numero, "FAC-2026-0041");
+
+    // Enero de 2027 reinicia la numeración.
+    const enero = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2027-01" }, socio: GESTOR });
+    assert.equal(enero.cuerpo.facturas.length, 1);
+    assert.equal(enero.cuerpo.facturas[0].numero, "FAC-2027-0001");
+    assert.equal(enero.cuerpo.facturas[0].socioId, "socio-001");
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("las penalizaciones se facturan como líneas", async () => {
+  const otra = await arrancarApi();
+  try {
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-10-25T10:00" } });
+    // Se busca una franja libre ese mismo día para reservarla y cancelarla con penalización.
+    const disp = await otra.pedir("GET", "/api/disponibilidad?fecha=2026-10-25");
+    let hueco: { pistaId: string; inicio: string } | undefined;
+    for (const pista of disp.cuerpo.pistas) {
