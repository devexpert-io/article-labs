@@ -0,0 +1,178 @@
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado, Factura } from "../src/tipos.ts";
+
+let api: Api;
+const gestor = "socio-040";
+beforeEach(async () => { api = await arrancarApi(); });
+afterEach(() => api.cerrar());
+
+async function generar(mes: unknown) {
+  return api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+}
+
+async function reloj(ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function reservar(socioId: string, inicio: string) {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-1", inicio } });
+  assert.equal(respuesta.status, 201, respuesta.texto);
+  return respuesta.cuerpo.reserva.id as string;
+}
+
+test("solo un gestor puede generar y consultar facturas", async () => {
+  for (const [metodo, ruta] of [
+    ["POST", "/api/facturas"],
+    ["GET", "/api/facturas?mes=2026-10"],
+    ["GET", "/api/facturas/F2026-0001"],
+  ]) {
+    for (const socio of [undefined, "socio-999", "socio-001"]) {
+      const respuesta = await api.pedir(metodo!, ruta!, { socio, ...(metodo === "POST" ? { cuerpo: { mes: "2026-10" } } : {}) });
+      assert.equal(respuesta.status, socio === "socio-001" ? 403 : 401);
+      assert.equal(respuesta.cuerpo.error.codigo, socio === "socio-001" ? "SIN_PERMISO" : "NO_IDENTIFICADO");
+    }
+  }
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.facturasPorMes, {});
+  assert.equal((await generar("2026-10")).status, 201);
+});
+
+test("valida el mes y solo genera meses terminados según el reloj del club", async () => {
+  for (const mes of [undefined, null, 202610, {}, [], "", "2026-1", "26-10", "2026-00", "2026-13", "2026-10-01", " 2026-10"]) {
+    const respuesta = await generar(mes);
+    assert.equal(respuesta.status, 400);
+    assert.equal(respuesta.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const ruta of ["/api/facturas", "/api/facturas?mes=2026-13", "/api/facturas?mes=2026-1"]) {
+    const respuesta = await api.pedir("GET", ruta, { socio: gestor });
+    assert.equal(respuesta.status, 400);
+    assert.equal(respuesta.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const respuesta = await generar(mes);
+    assert.equal(respuesta.status, 409);
+    assert.equal(respuesta.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj("2026-11-30T23:59");
+  assert.equal((await generar("2026-11")).status, 409);
+  await reloj("2026-12-01T00:00");
+  assert.equal((await generar("2026-11")).status, 201);
+});
+
+test("factura el historial de octubre por socio e inicio, incluidas las no presentadas", async () => {
+  const antes: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const respuesta = await generar("2026-10");
+  assert.equal(respuesta.status, 201);
+  const facturas: Factura[] = respuesta.cuerpo.facturas;
+  const facturables = antes.reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(facturables.some((r) => r.estado === "no_presentada"));
+  assert.deepEqual(facturas.map((f) => f.socioId), [...new Set(facturables.map((r) => r.socioId))].sort());
+  assert.ok(!facturas.some((f) => f.socioId === "socio-041"));
+  for (const [i, factura] of facturas.entries()) {
+    const reservas = facturables.filter((r) => r.socioId === factura.socioId).sort((a, b) => a.inicio.localeCompare(b.inicio));
+    assert.deepEqual(factura, {
+      numero: `F2026-${String(i + 1).padStart(4, "0")}`,
+      mes: "2026-10", socioId: factura.socioId,
+      lineas: reservas.map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })),
+      total: reservas.reduce((total, r) => total + r.importe, 0),
+      base: Math.round(factura.total * 100 / 121), iva: factura.total - factura.base,
+    });
+  }
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, antes.reservas);
+  const consulta = await api.pedir("GET", "/api/reservas/R-0001");
+  assert.equal(consulta.status, 200);
+  assert.deepEqual(consulta.cuerpo.reserva, antes.reservas.find((r) => r.id === "R-0001"));
+});
+
+test("desglosa el IVA sobre el total: 6400 céntimos dan base 5289 e IVA 1111", async () => {
+  // Crearlas fuera de orden comprueba también el orden de las líneas.
+  const ultima = await reservar("socio-041", "2026-12-01T18:00");
+  const primera = await reservar("socio-041", "2026-12-01T09:00");
+  const segunda = await reservar("socio-041", "2026-12-01T12:00");
+  await reloj("2027-01-01T00:00");
+  const respuesta = await generar("2026-12");
+  assert.equal(respuesta.status, 201);
+  assert.deepEqual(respuesta.cuerpo.facturas, [{
+    numero: "F2026-0001", mes: "2026-12", socioId: "socio-041",
+    lineas: [
+      { reservaId: primera, concepto: "Reserva", importe: 1800 },
+      { reservaId: segunda, concepto: "Reserva", importe: 1800 },
+      { reservaId: ultima, concepto: "Reserva", importe: 2800 },
+    ],
+    total: 6400, base: 5289, iva: 1111,
+  }]);
+});
+
+test("incluye penalizaciones con tilde y excluye cancelaciones gratuitas y socios sin cargos", async () => {
+  const gratis = await reservar("socio-041", "2026-12-01T09:00");
+  const soloGratis = await reservar("socio-004", "2026-12-01T10:30");
+  const penalizada = await reservar("socio-041", "2026-12-02T12:00");
+  for (const id of [gratis, soloGratis]) {
+    const cancelacion = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+    assert.equal(cancelacion.status, 200);
+    assert.equal(cancelacion.cuerpo.reserva.penalizacion, undefined);
+  }
+  await reloj("2026-12-02T10:00");
+  const cancelacion = await api.pedir("POST", `/api/reservas/${penalizada}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelacion.status, 200);
+  assert.equal(cancelacion.cuerpo.reserva.penalizacion, 1800);
+  await reloj("2027-01-01T00:00");
+  const respuesta = await generar("2026-12");
+  assert.equal(respuesta.status, 201);
+  assert.deepEqual(respuesta.cuerpo.facturas, [{
+    numero: "F2026-0001", mes: "2026-12", socioId: "socio-041",
+    lineas: [{ reservaId: penalizada, concepto: "Penalización", importe: 1800 }],
+    total: 1800, base: 1488, iva: 312,
+  }]);
+});
+
+test("numeración anual sin huecos, por socio, con meses fuera de orden y repetición", async () => {
+  await reservar("socio-041", "2026-12-01T09:00");
+  await reservar("socio-002", "2026-12-01T10:30");
+  await reservar("socio-041", "2027-01-04T09:00");
+  await reloj("2027-02-01T00:00");
+  const diciembre = await generar("2026-12");
+  assert.equal(diciembre.status, 201);
+  assert.deepEqual(diciembre.cuerpo.facturas.map((f: Factura) => [f.socioId, f.numero]), [
+    ["socio-002", "F2026-0001"], ["socio-041", "F2026-0002"],
+  ]);
+  const vacio = await generar("2026-09");
+  assert.equal(vacio.status, 201);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  assert.equal((await generar("2026-09")).status, 200);
+  const repetida = await generar("2026-12");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo, diciembre.cuerpo);
+  const octubre = await generar("2026-10");
+  assert.equal(octubre.cuerpo.facturas[0].numero, "F2026-0003");
+  const noviembre = await generar("2026-11");
+  assert.equal(noviembre.cuerpo.facturas[0].numero, `F2026-${String(octubre.cuerpo.facturas.length + 3).padStart(4, "0")}`);
+  const enero = await generar("2027-01");
+  assert.equal(enero.status, 201);
+  assert.deepEqual(enero.cuerpo.facturas.map((f: Factura) => f.numero), ["F2027-0001"]);
+  const todas = [diciembre, octubre, noviembre, enero].flatMap((r) => r.cuerpo.facturas as Factura[]);
+  assert.equal(new Set(todas.map((f) => f.numero)).size, todas.length);
+});
+
+test("consulta meses generados, no generados y facturas individuales", async () => {
+  for (const mes of ["2026-10", "2026-11", "2027-01"]) {
+    const respuesta = await api.pedir("GET", `/api/facturas?mes=${mes}`, { socio: gestor });
+    assert.equal(respuesta.status, 200);
+    assert.deepEqual(respuesta.cuerpo, { facturas: [] });
+  }
+  const generada = await generar("2026-10");
+  const listado = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor });
+  assert.equal(listado.status, 200);
+  assert.deepEqual(listado.cuerpo, generada.cuerpo);
+  const factura: Factura = generada.cuerpo.facturas[0];
+  const individual = await api.pedir("GET", `/api/facturas/${factura.numero}`, { socio: gestor });
+  assert.equal(individual.status, 200);
+  assert.deepEqual(individual.cuerpo, { factura });
+  const inexistente = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: gestor });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  const repetida = await generar("2026-10");
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo, generada.cuerpo);
+});
