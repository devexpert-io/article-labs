@@ -0,0 +1,183 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const generar = (api: Api, mes: unknown, socio = GESTOR) => api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio });
+
+test("permisos: solo un gestor genera y consulta facturas", () =>
+  conApi({}, async (api) => {
+    for (const [metodo, ruta, cuerpo] of [
+      ["POST", "/api/facturas", { mes: "2026-10" }],
+      ["GET", "/api/facturas?mes=2026-10", undefined],
+      ["GET", "/api/facturas/F-2026-0001", undefined],
+    ] as const) {
+      const sin = await api.pedir(metodo, ruta, { cuerpo });
+      assert.equal(sin.status, 401, `${metodo} ${ruta} sin X-Socio`);
+      assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+      const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-001" });
+      assert.equal(socio.status, 403, `${metodo} ${ruta} con un socio`);
+      assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+    }
+    assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, 0);
+  }));
+
+test("mes cerrado: formato AAAA-MM y solo meses que ya han terminado", () =>
+  conApi({}, async (api) => {
+    for (const mes of [undefined, "2026-1", "2026-13", "2026-10-01", 202610]) {
+      const r = await generar(api, mes);
+      assert.equal(r.status, 400, `mes ${mes}`);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    assert.equal((await api.pedir("GET", "/api/facturas?mes=octubre", { socio: GESTOR })).status, 400);
+    for (const mes of ["2026-11", "2026-12"]) {
+      const r = await generar(api, mes);
+      assert.equal(r.status, 409);
+      assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+    }
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T23:59" } });
+    assert.equal((await generar(api, "2026-11")).cuerpo.error.codigo, "MES_ABIERTO");
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T00:00" } });
+    assert.equal((await generar(api, "2026-11")).status, 201);
+  }));
+
+test("octubre de 2026: una factura por socio, sus líneas, el total y el IVA", () =>
+  conApi({}, async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const r = await generar(api, "2026-10");
+    assert.equal(r.status, 201);
+    const facturas = r.cuerpo.facturas;
+
+    // Lo facturable: reservas confirmadas y no presentadas de octubre (en la semilla, ninguna cancelada tiene penalización).
+    const facturables = estado.reservas.filter((x: any) => x.inicio.startsWith("2026-10-") && x.estado !== "cancelada");
+    const socios = [...new Set(facturables.map((x: any) => x.socioId))].sort();
+    assert.equal(facturas.length, 40);
+    assert.deepEqual(facturas.map((f: any) => f.socioId), socios, "una por socio con algo que facturar, por orden de socio");
+    assert.ok(!facturas.some((f: any) => f.socioId === "socio-041"), "Nora Benítez no tiene factura");
+
+    for (const f of facturas) {
+      const suyas = facturables.filter((x: any) => x.socioId === f.socioId).sort((a: any, b: any) => a.inicio.localeCompare(b.inicio));
+      assert.deepEqual(f.lineas.map((l: any) => l.reservaId), suyas.map((x: any) => x.id));
+      assert.deepEqual(f.lineas.map((l: any) => l.importe), suyas.map((x: any) => x.importe));
+      assert.equal(f.mes, "2026-10");
+      assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+      assert.equal(f.base + f.iva, f.total);
+      assert.equal(f.base, Math.round(f.total / 1.21));
+    }
+
+    const primera = facturas[0];
+    assert.deepEqual(primera, {
+      numero: "F-2026-0001",
+      mes: "2026-10",
+      socioId: "socio-001",
+      lineas: [
+        { reservaId: "R-0120", concepto: "Reserva de Pista 1, 2026-10-12 09:00", importe: 1800 },
+        { reservaId: "R-0172", concepto: "Reserva de Pista 2, 2026-10-17 21:00", importe: 2800 },
+        { reservaId: "R-0193", concepto: "Reserva de Pista 4, 2026-10-18 12:00", importe: 2200 },
+      ],
+      total: 6800,
+      base: 5620, // 6800 / 1,21 = 5619,83 → 5620
+      iva: 1180,
+    });
+
+    const noPresentada = facturables.find((x: any) => x.estado === "no_presentada");
+    const linea = facturas.flatMap((f: any) => f.lineas).find((l: any) => l.reservaId === noPresentada.id);
+    assert.match(linea.concepto, /^Reserva no presentada de /);
+    const cancelada = estado.reservas.find((x: any) => x.inicio.startsWith("2026-10-") && x.estado === "cancelada");
+    assert.ok(!facturas.some((f: any) => f.lineas.some((l: any) => l.reservaId === cancelada.id)), "cancelada sin penalización: no se factura");
+
+    assert.deepEqual(facturas.map((f: any) => f.numero), facturas.map((_: any, i: number) => `F-2026-${String(i + 1).padStart(4, "0")}`));
+  }));
+
+test("penalizaciones, redondeo del IVA y numeración entre meses y entre años", () =>
+  conApi({}, async (api) => {
+    // Marta López cancela fuera de plazo su reserva del 19 de noviembre (1200 de penalización).
+    const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 1200);
+    // Una reserva en diciembre y otra en enero de 2027.
+    const dic = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-12-02T09:00" } });
+    assert.equal(dic.status, 201);
+    const ene = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-006", pistaId: "pista-3", inicio: "2027-01-05T09:00" } });
+    assert.equal(ene.status, 201);
+
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-02-01T09:00" } });
+    const octubre = (await generar(api, "2026-10")).cuerpo.facturas;
+    assert.equal(octubre.at(-1).numero, "F-2026-0040");
+
+    // Un mes sin nada que facturar no gasta números.
+    const septiembre = await generar(api, "2026-09");
+    assert.equal(septiembre.status, 201);
+    assert.deepEqual(septiembre.cuerpo.facturas, []);
+
+    const noviembre = (await generar(api, "2026-11")).cuerpo.facturas;
+    assert.equal(noviembre[0].numero, "F-2026-0041", "sigue la numeración de octubre");
+    assert.deepEqual(noviembre.map((f: any) => f.numero), noviembre.map((_: any, i: number) => `F-2026-${String(41 + i).padStart(4, "0")}`));
+    const marta = noviembre.find((f: any) => f.socioId === "socio-002");
+    const penalizacion = marta.lineas.find((l: any) => l.reservaId === "R-0520");
+    assert.deepEqual(penalizacion, { reservaId: "R-0520", concepto: "Penalización por cancelar la reserva de Pista 3, 2026-11-19 09:00", importe: 1200 });
+    const ultimaDeNoviembre = Number(noviembre.at(-1).numero.slice(-4));
+
+    const diciembre = (await generar(api, "2026-12")).cuerpo.facturas;
+    assert.deepEqual(diciembre.map((f: any) => [f.numero, f.socioId]), [[`F-2026-${String(ultimaDeNoviembre + 1).padStart(4, "0")}`, "socio-003"]]);
+    // 1800 / 1,21 = 1487,60 → base 1488, iva 312.
+    assert.deepEqual([diciembre[0].total, diciembre[0].base, diciembre[0].iva], [1800, 1488, 312]);
