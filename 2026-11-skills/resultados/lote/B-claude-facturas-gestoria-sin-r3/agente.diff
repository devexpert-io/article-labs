+// Reglas de facturación. Son PROVISIONALES: la spec remite a las reglas de la gestoría, que no
+// están en el repositorio. Se concentran aquí para cambiarlas en un solo sitio cuando se confirmen.
+const MES = /^\d{4}-(0[1-9]|1[0-2])$/;
+/** Tipo de IVA, en tanto por cien. Los precios del club llevan el IVA incluido. */
+export const TIPO_IVA = 21;
+/** F-AAAA-NNNN: correlativo por año del mes facturado, sin huecos ni repeticiones. */
+export function numeroDeFactura(anio: string, n: number): string {
+  return `F-${anio}-${String(n).padStart(4, "0")}`;
+}
+/** Desglosa un total con IVA incluido: base redondeada al céntimo, e iva = total - base. */
+export function desglosarIva(total: number): { base: number; iva: number } {
+  const base = Math.round((total * 100) / (100 + TIPO_IVA));
+  return { base, iva: total - base };
+}
+
+function mesSiguiente(mes: string): string {
+  const [a, m] = mes.split("-").map(Number);
+  return m === 12 ? `${a! + 1}-01` : `${a}-${String(m! + 1).padStart(2, "0")}`;
+}
+
 function invalido(mensaje: string): never {
   throw new ErrorDelClub("DATOS_INVALIDOS", mensaje, 400);
 }
