+/** Desfase de Europe/Madrid respecto a UTC, en milisegundos, en un instante dado. */
+function desfaseMadrid(instante: number): number {
+  const formato = new Intl.DateTimeFormat("en-US", {
+    timeZone: "Europe/Madrid",
+    hourCycle: "h23",
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+    hour: "2-digit",
+    minute: "2-digit",
+    second: "2-digit",
+  });
+  const valores: Record<string, number> = {};
+  for (const parte of formato.formatToParts(new Date(instante))) valores[parte.type] = Number(parte.value);
+  const comoUtc = Date.UTC(valores.year!, valores.month! - 1, valores.day!, valores.hour!, valores.minute!, valores.second!);
+  return comoUtc - instante;
+}
+
+/** Instante real (UTC, en milisegundos) de una fecha-hora local de Madrid. */
+function instanteMadrid(fechaHora: string): number {
+  const [fecha, hora] = fechaHora.split("T");
+  const [a, m, d] = fecha!.split("-").map(Number);
+  const [hh, mm] = hora!.split(":").map(Number);
+  const comoUtc = Date.UTC(a!, m! - 1, d!, hh!, mm!);
+  return comoUtc - desfaseMadrid(comoUtc);
+}
+
