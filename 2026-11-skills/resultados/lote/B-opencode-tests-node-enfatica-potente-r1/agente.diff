+test("C7 · el informe de caja es solo para gestores, valida el mes y agrega por pista y total", async () => {
+  await conApi({}, async (api) => {
+    const sinIdentificar = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinPermiso = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-003" });
+    assert.equal(sinPermiso.status, 403);
+    assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+    for (const mal of ["noviembre", "2026/11", "2026-1", "202611"]) {
+      const r = await api.pedir("GET", `/api/informes/caja?mes=${mal}`, { socio: "socio-040" });
+      assert.equal(r.status, 400);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+
+    // Añade una penalización real a noviembre: R-0520 (pista-3, 19 a las 09:00) está a 23 horas.
+    const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+    assert.equal(informe.cuerpo.mes, "2026-11");
+    assert.deepEqual(informe.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+    assert.deepEqual(Object.keys(informe.cuerpo.total).sort(), ["ingresos", "penalizaciones", "reservas", "total"]);
+    for (const p of informe.cuerpo.pistas) {
+      assert.deepEqual(Object.keys(p).sort(), ["ingresos", "penalizaciones", "pistaId", "reservas", "total"]);
+    }
+
+    // El informe debe cuadrar con las reservas de noviembre: confirmadas y no presentadas suman
+    // ingresos y reservas; las canceladas suman sus penalizaciones.
+    const todas = await reservasDelMes(api, "2026-11");
+    const confirmadas = todas.filter((r) => r.estado === "confirmada" || r.estado === "no_presentada");
+    const canceladas = todas.filter((r) => r.estado === "cancelada");
+    const suma = (lista: any[], campo: string) => lista.reduce((s, r) => s + (r[campo] ?? 0), 0);
+
+    assert.equal(informe.cuerpo.total.reservas, confirmadas.length);
+    assert.equal(informe.cuerpo.total.ingresos, suma(confirmadas, "importe"));
+    assert.equal(informe.cuerpo.total.penalizaciones, suma(canceladas, "penalizacion"));
+    assert.equal(informe.cuerpo.total.total, suma(confirmadas, "importe") + suma(canceladas, "penalizacion"));
+
+    for (const pistaId of ["pista-1", "pista-2", "pista-3", "pista-4"]) {
+      const p = informe.cuerpo.pistas.find((x: any) => x.pistaId === pistaId);
+      const conf = confirmadas.filter((r) => r.pistaId === pistaId);
+      const canc = canceladas.filter((r) => r.pistaId === pistaId);
+      assert.equal(p.reservas, conf.length);
+      assert.equal(p.ingresos, suma(conf, "importe"));
+      assert.equal(p.penalizaciones, suma(canc, "penalizacion"));
+      assert.equal(p.total, suma(conf, "importe") + suma(canc, "penalizacion"));
+    }
+
+    // Las pistas sin movimientos también aparecen, con todo a cero.
+    const vacio = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: "socio-040" });
+    assert.equal(vacio.status, 200);
+    assert.deepEqual(vacio.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+    for (const p of vacio.cuerpo.pistas) {
+      assert.deepEqual({ reservas: p.reservas, ingresos: p.ingresos, penalizaciones: p.penalizaciones, total: p.total }, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+    }
+    assert.deepEqual(vacio.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+  });
+});
