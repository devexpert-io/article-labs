+// Penalizaciones escalonadas, exención de gestor e informe de caja, probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(entorno: Record<string, string>, fn: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi(entorno);
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function crear(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201);
+  return r.cuerpo.reserva;
+}
+
+async function reservasDelMes(api: Api, mes: string) {
+  const todas: any[] = [];
+  let pagina = 1;
+  for (;;) {
+    const r = await api.pedir("GET", `/api/reservas?desde=${mes}-01&hasta=${mes}-31&limite=100&pagina=${pagina}`);
+    assert.equal(r.status, 200);
+    todas.push(...r.cuerpo.reservas);
+    if (pagina >= r.cuerpo.paginas) break;
+    pagina += 1;
+  }
+  return todas;
+}
+
+test("C1 · los tramos de penalización: sin penalización a 48h+, 25 % entre 24h y 48h, 50 % con forzar bajo 24h", async () => {
+  await conApi({ AHORA: "2026-12-01T10:00" }, async (api) => {
+    const r48 = await crear(api, "socio-001", "pista-1", "2026-12-04T12:00"); // 1800, 51h
+    const r25 = await crear(api, "socio-002", "pista-2", "2026-12-03T12:00"); // 1800, 27h
+    const rMenos24 = await crear(api, "socio-003", "pista-3", "2026-12-02T12:00"); // 1200, 3h
+
+    const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-02T09:00" } });
+    assert.equal(reloj.status, 200);
+
+    const sinForzar = await api.pedir("POST", `/api/reservas/${rMenos24.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+
+    const forzada = await api.pedir("POST", `/api/reservas/${rMenos24.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+    assert.equal(forzada.cuerpo.reembolso, 600);
+
+    const cuarto = await api.pedir("POST", `/api/reservas/${r25.id}/cancelar`);
+    assert.equal(cuarto.status, 200);
+    assert.equal(cuarto.cuerpo.reserva.penalizacion, 450);
+    assert.equal(cuarto.cuerpo.reembolso, 1350);
+
+    const gratis = await api.pedir("POST", `/api/reservas/${r48.id}/cancelar`);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, 1800);
+  });
+});
+
+test("C2 · los límites exactos: a 48 horas justas no hay penalización y a 24 horas justas se aplica el 25 % sin forzar", async () => {
+  await conApi({ AHORA: "2026-12-01T10:00" }, async (api) => {
+    const r48 = await crear(api, "socio-001", "pista-1", "2026-12-04T12:00"); // 1800
+    const r24 = await crear(api, "socio-002", "pista-2", "2026-12-03T12:00"); // 1800
+
+    const reloj = await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-02T12:00" } });
+    assert.equal(reloj.status, 200);
+
+    const justo48 = await api.pedir("POST", `/api/reservas/${r48.id}/cancelar`);
+    assert.equal(justo48.status, 200);
+    assert.equal(justo48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(justo48.cuerpo.reembolso, 1800);
+
+    const justo24 = await api.pedir("POST", `/api/reservas/${r24.id}/cancelar`);
+    assert.equal(justo24.status, 200);
+    assert.equal(justo24.cuerpo.reserva.penalizacion, 450);
+    assert.equal(justo24.cuerpo.reembolso, 1350);
+  });
+});
+
+test("C3 · la antelación se cuenta en horas reales de Madrid contando el cambio de hora", async () => {
+  await conApi({ AHORA: "2027-03-26T20:30" }, async (api) => {
+    const r = await crear(api, "socio-001", "pista-1", "2027-03-28T21:00"); // domingo, punta: 2800
+    // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales (no 48,5),
+    // así que entra en el tramo del 25 % y no hace falta forzar.
+    const cancelada = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  });
+});
+
+test("C4 · la respuesta de cancelar incluye reembolso igual a importe menos penalización", async () => {
+  await conApi({ AHORA: "2026-12-01T10:00" }, async (api) => {
+    const sinPen = await crear(api, "socio-001", "pista-1", "2026-12-04T12:00"); // 1800, sin penalización
+    const al25 = await crear(api, "socio-002", "pista-2", "2026-12-03T12:00"); // 1800, 25 %
+    const al50 = await crear(api, "socio-003", "pista-3", "2026-12-02T12:00"); // 1200, 50 %
+
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-02T09:00" } });
+
+    const a = await api.pedir("POST", `/api/reservas/${sinPen.id}/cancelar`);
+    assert.equal(a.cuerpo.reembolso, a.cuerpo.reserva.importe - (a.cuerpo.reserva.penalizacion ?? 0));
+    assert.equal(a.cuerpo.reembolso, 1800);
+
+    const b = await api.pedir("POST", `/api/reservas/${al25.id}/cancelar`);
+    assert.equal(b.cuerpo.reembolso, b.cuerpo.reserva.importe - b.cuerpo.reserva.penalizacion);
+    assert.equal(b.cuerpo.reembolso, 1350);
+
+    const c = await api.pedir("POST", `/api/reservas/${al50.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(c.cuerpo.reembolso, c.cuerpo.reserva.importe - c.cuerpo.reserva.penalizacion);
+    assert.equal(c.cuerpo.reembolso, 600);
+  });
+});
+
+test("C5 · un gestor puede eximir la penalización con exento y un motivo de al menos 10 caracteres", async () => {
+  await conApi({ AHORA: "2026-12-01T10:00" }, async (api) => {
+    const r = await crear(api, "socio-003", "pista-1", "2026-12-01T12:00"); // 1800, a 2 horas
+
+    const sinIdentificar = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { exento: true, motivo: "Motivo de exención válido" } });
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinPermiso = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { exento: true, motivo: "Motivo de exención válido" }, socio: "socio-003" });
+    assert.equal(sinPermiso.status, 403);
+    assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const sinMotivo = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`, { cuerpo: { exento: true }, socio: "socio-040" });
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
