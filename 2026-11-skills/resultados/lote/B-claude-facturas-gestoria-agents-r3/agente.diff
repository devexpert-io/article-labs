@@ -0,0 +1,174 @@
+// Facturas mensuales (docs/specs/facturas.md) y reglas de facturación de la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(entorno: Record<string, string>, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+const generar = (api: Api, mes: unknown, socio = GESTOR) => api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio });
+const reloj = async (api: Api, ahora: string) => assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+const numeros = (facturas: { numero: string }[]) => facturas.map((f) => f.numero);
+
+test("solo un gestor genera y consulta facturas", () => conApi({ AHORA: "2026-11-18T10:00" }, async (api) => {
+  for (const [metodo, ruta] of [["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F2026-0001"]] as const) {
+    const opciones = metodo === "POST" ? { cuerpo: { mes: "2026-10" } } : {};
+    const anonimo = await api.pedir(metodo, ruta, opciones);
+    assert.equal(anonimo.status, 401, `${metodo} ${ruta}`);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { ...opciones, socio: "socio-004" });
+    assert.equal(socio.status, 403, `${metodo} ${ruta}`);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.facturas, [], "sin permiso no se genera nada");
+}));
+
+test("mes con formato AAAA-MM y ya cerrado", () => conApi({ AHORA: "2026-11-18T10:00" }, async (api) => {
+  for (const mes of [undefined, "2026-13", "2026-1", "octubre", "2026-10-01", 202610]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-1", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409, mes);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  // El último minuto del mes todavía es el mes; el primero del siguiente, ya no.
+  await reloj(api, "2026-11-30T23:59");
+  assert.equal((await generar(api, "2026-11")).cuerpo.error.codigo, "MES_ABIERTO");
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+}));
+
+test("octubre: una factura por socio, sus líneas, el IVA, la numeración y la repetición", () => conApi({}, async (api) => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const reservasOctubre = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+
+  const primera = await generar(api, "2026-10");
+  assert.equal(primera.status, 201);
+  const facturas = primera.cuerpo.facturas;
+
+  // Una factura por socio con algo que facturar, ordenadas por socio y numeradas desde 0001.
+  const conAlgo = [...new Set(reservasOctubre.filter((r: any) => r.estado !== "cancelada").map((r: any) => r.socioId))].sort();
+  assert.deepEqual(facturas.map((f: any) => f.socioId), conAlgo);
+  assert.equal(facturas.length, 40);
+  assert.ok(!facturas.some((f: any) => f.socioId === "socio-041"), "Nora Benítez no tiene nada que facturar");
+  assert.deepEqual(numeros(facturas), facturas.map((_: unknown, i: number) => `F2026-${String(i + 1).padStart(4, "0")}`));
+
+  for (const f of facturas) {
+    assert.equal(f.mes, "2026-10");
+    assert.deepEqual(Object.keys(f).sort(), ["base", "iva", "lineas", "mes", "numero", "socioId", "total"]);
+    const esperadas = reservasOctubre
+      .filter((r: any) => r.socioId === f.socioId && r.estado !== "cancelada")
+      .sort((a: any, b: any) => a.inicio.localeCompare(b.inicio))
+      .map((r: any) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe }));
+    assert.deepEqual(f.lineas, esperadas, f.socioId);
+    assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+    assert.equal(f.base, Math.round((f.total * 100) / 121));
+    assert.equal(f.base + f.iva, f.total);
+  }
+  // Las no presentadas se facturan; las canceladas sin penalización, no.
+  const lineas = new Set(facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId)));
+  const noPresentada = reservasOctubre.find((r: any) => r.estado === "no_presentada");
+  assert.ok(lineas.has(noPresentada.id));
+  for (const r of reservasOctubre.filter((r: any) => r.estado === "cancelada")) assert.ok(!lineas.has(r.id), r.id);
+  assert.deepEqual(facturas[0], {
+    numero: "F2026-0001", mes: "2026-10", socioId: "socio-001",
+    lineas: [
+      { reservaId: "R-0120", concepto: "Reserva", importe: 1800 },
+      { reservaId: "R-0172", concepto: "Reserva", importe: 2800 },
+      { reservaId: "R-0193", concepto: "Reserva", importe: 2200 },
+    ],
+    total: 6800, base: 5620, iva: 1180,
+  });
+
+  // Generar otra vez: 200, las mismas facturas, ninguna nueva.
+  const segunda = await generar(api, "2026-10");
+  assert.equal(segunda.status, 200);
+  assert.deepEqual(segunda.cuerpo.facturas, facturas);
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, 40);
+
+  // Consultar.
+  const listadas = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(listadas.status, 200);
+  assert.deepEqual(listadas.cuerpo.facturas, facturas);
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR })).cuerpo, { facturas: [] });
+  const una = await api.pedir("GET", "/api/facturas/F2026-0007", { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo.factura, facturas[6]);
+  const no = await api.pedir("GET", "/api/facturas/F2026-0041", { socio: GESTOR });
+  assert.equal(no.status, 404);
+  assert.equal(no.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+
+  // Lo demás no cambia.
+  assert.equal((await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=1")).cuerpo.total, 315);
+  assert.equal((await api.pedir("GET", "/api/reservas/R-0120")).cuerpo.reserva.estado, "confirmada");
+}));
+
+test("penalizaciones, base sobre el total y numeración entre meses y años", () => conApi({ AHORA: "2026-11-18T10:00" }, async (api) => {
+  // Noviembre: Marta cancela fuera de plazo (penalización) y Óscar dentro de plazo (gratis).
+  const penalizada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(penalizada.cuerpo.reserva.penalizacion, 1200);
+  const gratis = (await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-25T12:00" } })).cuerpo.reserva;
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`)).cuerpo.reserva.penalizacion, undefined);
+
+  // Diciembre: Nora reserva 1.800 + 1.800 + 2.800 (en desorden, para comprobar el orden de las líneas).
+  const nora: string[] = [];
+  for (const inicio of ["2026-12-02T18:00", "2026-12-01T09:00", "2026-12-02T09:00"]) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio } });
+    assert.equal(r.status, 201);
+    nora.push(r.cuerpo.reserva.id);
+  }
+  // Enero de 2027: una reserva de Óscar.
+  const enero = (await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-2", inicio: "2027-01-12T09:00" } })).cuerpo.reserva;
+
+  // Se genera noviembre antes que octubre: empieza en 0001.
+  await reloj(api, "2026-12-01T09:00");
+  const noviembre = (await generar(api, "2026-11")).cuerpo.facturas;
+  assert.equal(noviembre[0].numero, "F2026-0001");
+  const marta = noviembre.find((f: any) => f.socioId === "socio-002");
+  assert.deepEqual(marta.lineas.find((l: any) => l.reservaId === "R-0520"), { reservaId: "R-0520", concepto: "Penalización", importe: 1200 });
+  assert.ok(!noviembre.some((f: any) => f.lineas.some((l: any) => l.reservaId === gratis.id)), "la cancelación gratuita no se factura");
+  const finNoviembre = noviembre.length;
+
+  // Un mes sin facturas se genera vacío y no gasta números.
+  const septiembre = await generar(api, "2026-09");
+  assert.equal(septiembre.status, 201);
+  assert.deepEqual(septiembre.cuerpo.facturas, []);
+  assert.equal((await generar(api, "2026-09")).status, 200);
+
+  // Diciembre generado en enero de 2027: sigue la serie de 2026.
+  await reloj(api, "2027-01-05T10:00");
+  const diciembre = (await generar(api, "2026-12")).cuerpo.facturas;
+  assert.deepEqual(numeros(diciembre), [`F2026-${String(finNoviembre + 1).padStart(4, "0")}`]);
+  assert.deepEqual(diciembre[0], {
+    numero: diciembre[0].numero, mes: "2026-12", socioId: "socio-041",
+    lineas: [nora[1], nora[2], nora[0]].map((reservaId, i) => ({ reservaId, concepto: "Reserva", importe: [1800, 1800, 2800][i] })),
+    total: 6400, base: 5289, iva: 1111,
+  });
+
+  // Octubre, generado después, sigue donde lo dejó diciembre.
+  const octubre = (await generar(api, "2026-10")).cuerpo.facturas;
+  assert.equal(octubre[0].numero, `F2026-${String(finNoviembre + 2).padStart(4, "0")}`);
+  assert.equal(octubre.at(-1).numero, `F2026-${String(finNoviembre + 1 + octubre.length).padStart(4, "0")}`);
+
+  // Enero de 2027 empieza su propia serie.
+  await reloj(api, "2027-02-01T00:00");
+  const de2027 = (await generar(api, "2027-01")).cuerpo.facturas;
+  assert.deepEqual(de2027.map((f: any) => [f.numero, f.socioId, f.lineas.map((l: any) => l.reservaId)]), [["F2027-0001", "socio-003", [enero.id]]]);
+
+  // La serie de 2026 queda correlativa, sin huecos ni repetidos.
+  const todas = (await api.pedir("GET", "/_estado")).cuerpo.facturas.filter((f: any) => f.numero.startsWith("F2026-")).map((f: any) => f.numero).sort();
+  assert.deepEqual(todas, todas.map((_: unknown, i: number) => `F2026-${String(i + 1).padStart(4, "0")}`));
+  assert.equal((await api.pedir("GET", `/api/facturas/${diciembre[0].numero}`, { socio: GESTOR })).cuerpo.factura.mes, "2026-12");
+}));
