@@ -0,0 +1,298 @@
+// La política de cancelación escalonada, la exención de gestores y el informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+interface ReservaCreada {
+  id: string;
+  pistaId: string;
+  inicio: string;
+  importe: number;
+  estado: string;
+}
+
+/** Crea una reserva en la primera pista libre de esa franja y devuelve la reserva. */
+async function reservar(api: Api, inicio: string, socioId = "socio-006"): Promise<ReservaCreada> {
+  const disponibilidad = await api.pedir("GET", `/api/disponibilidad?fecha=${inicio.slice(0, 10)}`);
+  assert.equal(disponibilidad.status, 200, disponibilidad.texto);
+  for (const pista of disponibilidad.cuerpo.pistas) {
+    const franja = pista.franjas.find((f: { inicio: string }) => f.inicio === inicio);
+    if (franja?.estado !== "libre") continue;
+    const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: pista.pistaId, inicio } });
+    assert.equal(creada.status, 201, creada.texto);
+    return creada.cuerpo.reserva as ReservaCreada;
+  }
+  throw new Error(`No queda ninguna pista libre el ${inicio}`);
+}
+
+async function conApi(prueba: (api: Api) => Promise<void>, entorno: Record<string, string> = {}) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("C1 · con 48 horas o más no hay penalización; entre 24 y 48, el 25 %", async () => {
+  await conApi(async (api) => {
+    const pronto = await reservar(api, "2026-11-21T12:00", "socio-003");
+    const canceladaPronto = await api.pedir("POST", `/api/reservas/${pronto.id}/cancelar`);
+    assert.equal(canceladaPronto.status, 200, canceladaPronto.texto);
+    assert.equal(canceladaPronto.cuerpo.reserva.estado, "cancelada");
+    assert.equal(canceladaPronto.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(canceladaPronto.cuerpo.reembolso, pronto.importe);
+
+    const medio = await reservar(api, "2026-11-19T12:00", "socio-006");
+    const canceladaMedio = await api.pedir("POST", `/api/reservas/${medio.id}/cancelar`);
+    assert.equal(canceladaMedio.status, 200, canceladaMedio.texto);
+    assert.equal(canceladaMedio.cuerpo.reserva.penalizacion, Math.round(medio.importe * 0.25));
+    assert.equal(canceladaMedio.cuerpo.reembolso, medio.importe - Math.round(medio.importe * 0.25));
+  });
+});
+
+test("C1 · con menos de 24 horas solo se cancela con forzar y la penalización es el 50 %", async () => {
+  await conApi(async (api) => {
+    const reserva = await reservar(api, "2026-11-19T09:00");
+
+    const sinForzar = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const sigue = await api.pedir("GET", `/api/reservas/${reserva.id}`);
+    assert.equal(sigue.cuerpo.reserva.estado, "confirmada", "el rechazo no debe cancelar la reserva");
+
+    const forzada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200, forzada.texto);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, Math.round(reserva.importe * 0.5));
+    assert.equal(forzada.cuerpo.reembolso, reserva.importe - Math.round(reserva.importe * 0.5));
+  });
+});
+
+test("C2 · a 48 horas justas no hay penalización y a 24 horas justas se aplica el 25 % sin forzar", async () => {
+  await conApi(async (api) => {
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T09:00" } })).status, 200);
+
+    const a48 = await reservar(api, "2026-11-20T09:00", "socio-006");
+    const cancelada48 = await api.pedir("POST", `/api/reservas/${a48.id}/cancelar`);
+    assert.equal(cancelada48.status, 200, cancelada48.texto);
+    assert.equal(cancelada48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada48.cuerpo.reembolso, a48.importe);
+
+    const a24 = await reservar(api, "2026-11-19T09:00", "socio-003");
+    const cancelada24 = await api.pedir("POST", `/api/reservas/${a24.id}/cancelar`);
+    assert.equal(cancelada24.status, 200, cancelada24.texto);
+    assert.equal(cancelada24.cuerpo.reserva.penalizacion, Math.round(a24.importe * 0.25));
+  });
+});
+
+test("C3 · la antelación cuenta horas reales de Madrid y descuenta el cambio de hora", async () => {
+  await conApi(async (api) => {
+    // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales
+    // (no 48,5), así que la reserva cae en el tramo del 25 %.
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-26T20:30" } })).status, 200);
+    const reserva = await reservar(api, "2027-03-28T21:00");
+    assert.equal(reserva.importe, 2800);
+
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200, cancelada.texto);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700, "47,5 horas reales: 25 % y no gratis");
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  });
+});
+
+test("C4 · la respuesta de cancelar incluye el reembolso igual a importe menos penalización", async () => {
+  await conApi(async (api) => {
+    const reserva = await reservar(api, "2026-11-19T12:00");
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.cuerpo.reembolso, reserva.importe - cancelada.cuerpo.reserva.penalizacion);
+    assert.equal(cancelada.cuerpo.reembolso + cancelada.cuerpo.reserva.penalizacion, reserva.importe);
+  });
+});
+
+test("C5 · un gestor exime con exento y un motivo de 10 caracteres o más", async () => {
+  await conApi(async (api) => {
+    const reserva = await reservar(api, "2026-11-18T12:00");
+    const motivo = "Lesión de última hora";
+
+    const sinIdentificar = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo },
+    });
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinPermiso = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-003",
+      cuerpo: { exento: true, motivo },
+    });
+    assert.equal(sinPermiso.status, 403);
+    assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const sinMotivo = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true },
+    });
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const motivoCorto = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo: "123456789" },
+    });
+    assert.equal(motivoCorto.status, 400);
+    assert.equal(motivoCorto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const exenta = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
