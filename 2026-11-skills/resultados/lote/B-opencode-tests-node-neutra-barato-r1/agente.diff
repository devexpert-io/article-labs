+test("C7 · el informe resume reservas y penalizaciones por pista, también las pistas sin movimientos", async () => {
+  await conApi(async (api) => {
+    const crear = async (socioId: string, pistaId: string, inicio: string) => {
+      const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+      assert.equal(creada.status, 201, creada.texto);
+      return creada.cuerpo.reserva as ReservaCreada;
+    };
+    // Diciembre está vacío en la semilla, así que estas pistas están libres.
+    const creadas = [
+      await crear("socio-003", "pista-1", "2026-12-01T12:00"),
+      await crear("socio-006", "pista-2", "2026-12-01T12:00"),
+      await crear("socio-009", "pista-3", "2026-12-01T12:00"),
+      await crear("socio-012", "pista-3", "2026-12-02T12:00"),
+    ];
+
+    // A 30 de noviembre las reservas del 1 de diciembre están a menos de 24 horas (50 %)
+    // y las del 2, entre 24 y 48 (25 %).
+    assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-30T18:00" } })).status, 200);
+    const del1 = creadas[2]!;
+    const del2 = creadas[3]!;
+    const forzada = await api.pedir("POST", `/api/reservas/${del1.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, Math.round(del1.importe * 0.5));
+    const reducida = await api.pedir("POST", `/api/reservas/${del2.id}/cancelar`);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, Math.round(del2.importe * 0.25));
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: "socio-040" });
+    assert.equal(informe.status, 200, informe.texto);
+    const ingresosPorPista = (pistaId: string) =>
+      creadas.filter((r) => r.pistaId === pistaId).reduce((suma, r) => suma + r.importe, 0);
+    assert.deepEqual(informe.cuerpo, {
+      mes: "2026-12",
+      pistas: [
+        { pistaId: "pista-1", reservas: 1, ingresos: ingresosPorPista("pista-1"), penalizaciones: 0, total: ingresosPorPista("pista-1") },
+        { pistaId: "pista-2", reservas: 1, ingresos: ingresosPorPista("pista-2"), penalizaciones: 0, total: ingresosPorPista("pista-2") },
+        {
+          pistaId: "pista-3",
+          reservas: 0,
+          ingresos: 0,
+          penalizaciones: Math.round(del1.importe * 0.5) + Math.round(del2.importe * 0.25),
+          total: Math.round(del1.importe * 0.5) + Math.round(del2.importe * 0.25),
+        },
+        { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+      ],
+      total: {
+        reservas: 2,
+        ingresos: ingresosPorPista("pista-1") + ingresosPorPista("pista-2"),
+        penalizaciones: Math.round(del1.importe * 0.5) + Math.round(del2.importe * 0.25),
+        total: ingresosPorPista("pista-1") + ingresosPorPista("pista-2") + Math.round(del1.importe * 0.5) + Math.round(del2.importe * 0.25),
+      },
+    });
+  });
+});
