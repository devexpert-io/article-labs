+test("C7 · el informe cuenta las no presentadas y no recalcula las canceladas del historial", async () => {
+  await conApi(async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const delMes = estado.reservas.filter((r: { inicio: string }) => r.inicio.slice(0, 7) === "2026-10");
+    assert.ok(delMes.some((r: { estado: string }) => r.estado === "no_presentada"), "octubre debe traer no presentadas");
+    assert.ok(delMes.some((r: { estado: string }) => r.estado === "cancelada"), "octubre debe traer canceladas");
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-040" });
+    assert.equal(informe.status, 200, informe.texto);
+    const cifras = (pistaId?: string) => {
+      const reservas = delMes.filter((r: { pistaId: string }) => !pistaId || r.pistaId === pistaId);
+      const contadas = reservas.filter((r: { estado: string }) => r.estado === "confirmada" || r.estado === "no_presentada");
+      const ingresos = contadas.reduce((suma: number, r: { importe: number }) => suma + r.importe, 0);
+      const penalizaciones = reservas
+        .filter((r: { estado: string }) => r.estado === "cancelada")
+        .reduce((suma: number, r: { penalizacion?: number }) => suma + (r.penalizacion ?? 0), 0);
+      return { reservas: contadas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    };
+
+    assert.deepEqual(
+      informe.cuerpo.pistas,
+      estado.pistas.map((p: { id: string }) => ({ pistaId: p.id, ...cifras(p.id) })),
+    );
+    assert.deepEqual(informe.cuerpo.total, cifras());
+  });
+});
+
