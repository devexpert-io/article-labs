+test("C7 · informe de caja del mes: solo gestores, por pista y con penalizaciones", () =>
+  conApi(async (api) => {
+    const sinIdentificarse = await api.pedir("GET", "/api/informes/caja?mes=2026-10");
+    assert.equal(sinIdentificarse.status, 401);
+    assert.equal(sinIdentificarse.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinPermiso = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-003" });
+    assert.equal(sinPermiso.status, 403);
+    assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+    for (const consulta of ["", "?mes=2026-13", "?mes=octubre"]) {
+      const invalida = await api.pedir("GET", `/api/informes/caja${consulta}`, { socio: "socio-040" });
+      assert.equal(invalida.status, 400, consulta);
+      assert.equal(invalida.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+
+    const octubre = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-040" });
+    assert.equal(octubre.status, 200);
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    assert.deepEqual(octubre.cuerpo, esperadoInforme(estado, "2026-10"));
+    assert.deepEqual(
+      octubre.cuerpo.pistas.map((p: any) => p.pistaId),
+      ["pista-1", "pista-2", "pista-3", "pista-4"],
+    );
+    assert.ok(octubre.cuerpo.total.reservas > 0);
+
+    // Una cancelación con penalización de este mes entra en el informe.
+    await moverReloj(api, "2026-11-19T08:00");
+    const libre = await primerLibre(api, "2026-11-19");
+    const nueva = await reservar(api, libre);
+    const cancelada = await api.pedir("POST", `/api/reservas/${nueva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.status, 200);
+    assert.ok(cancelada.cuerpo.reserva.penalizacion > 0);
+
+    const noviembre = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-040" });
+    assert.equal(noviembre.status, 200);
+    const estadoDespues = (await api.pedir("GET", "/_estado")).cuerpo;
+    assert.deepEqual(noviembre.cuerpo, esperadoInforme(estadoDespues, "2026-11"));
+    const pistaNueva = noviembre.cuerpo.pistas.find((p: any) => p.pistaId === nueva.pistaId)!;
+    assert.ok(pistaNueva.penalizaciones >= cancelada.cuerpo.reserva.penalizacion);
+    assert.equal(
+      noviembre.cuerpo.total.penalizaciones,
+      noviembre.cuerpo.pistas.reduce((suma: number, p: any) => suma + p.penalizaciones, 0),
+    );
+  }));
