+// Penalizaciones escalonadas, exención de un gestor e informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function moverReloj(api: Api, ahora: string) {
+  const respuesta = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(respuesta.status, 200);
+}
+
+/** Crea una reserva y devuelve la reserva creada. Por defecto, Nora (sin reservas) en la pista 1. */
+async function reservar(api: Api, datos: { socioId?: string; pistaId?: string; inicio: string }) {
+  const respuesta = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: datos.socioId ?? "socio-041", pistaId: datos.pistaId ?? "pista-1", inicio: datos.inicio },
+  });
+  assert.equal(respuesta.status, 201, JSON.stringify(respuesta.cuerpo));
+  return respuesta.cuerpo.reserva;
+}
+
+function esperadoInforme(estado: any, mes: string) {
+  const resumen = (reservas: any[]) => {
+    const cobradas = reservas.filter((r) => r.estado === "confirmada" || r.estado === "no_presentada");
+    const ingresos = cobradas.reduce((suma, r) => suma + r.importe, 0);
+    const penalizaciones = reservas
+      .filter((r) => r.estado === "cancelada")
+      .reduce((suma, r) => suma + (r.penalizacion ?? 0), 0);
+    return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+  };
+  const delMes = estado.reservas.filter((r: any) => r.inicio.slice(0, 7) === mes);
+  const pistas = [...estado.pistas]
+    .sort((a: any, b: any) => a.id.localeCompare(b.id))
+    .map((p: any) => ({
+      pistaId: p.id,
+      ...resumen(delMes.filter((r: any) => r.pistaId === p.id)),
+    }));
+  return { mes, pistas, total: resumen(delMes) };
+}
+
+async function primerLibre(api: Api, fecha: string) {
+  const disponibilidad = (await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`)).cuerpo;
+  for (const pista of disponibilidad.pistas) {
+    const franja = pista.franjas.find((f: any) => f.estado === "libre");
+    if (franja) return { pistaId: pista.pistaId as string, inicio: franja.inicio as string };
+  }
+  throw new Error(`No hay franjas libres el ${fecha}`);
+}
+
+test("C1 · tramos: 48 horas o más sin penalización, de 24 a 48 el 25 % y menos de 24 solo con forzar y el 50 %", () =>
+  conApi(async (api) => {
+    await moverReloj(api, "2027-01-10T10:30");
+
+    const lejos = await reservar(api, { inicio: "2027-01-13T10:30" }); // 72 horas
+    const sinPenalizacion = await api.pedir("POST", `/api/reservas/${lejos.id}/cancelar`);
+    assert.equal(sinPenalizacion.status, 200);
+    assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, undefined);
+
+    const medio = await reservar(api, { inicio: "2027-01-11T16:30" }); // 30 horas
+    const reducida = await api.pedir("POST", `/api/reservas/${medio.id}/cancelar`);
+    assert.equal(reducida.status, 200);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, Math.round(medio.importe * 0.25));
+
+    const cerca = await reservar(api, { inicio: "2027-01-11T09:00" }); // 22,5 horas
+    const sinForzar = await api.pedir("POST", `/api/reservas/${cerca.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+
+    const forzada = await api.pedir("POST", `/api/reservas/${cerca.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, Math.round(cerca.importe * 0.5));
+  }));
+
+test("C2 · límites exactos: a 48 horas nada y a 24 horas el 25 % sin forzar", () =>
+  conApi(async (api) => {
+    await moverReloj(api, "2027-01-10T10:30");
+
+    const a48 = await reservar(api, { inicio: "2027-01-12T10:30" });
+    const justo48 = await api.pedir("POST", `/api/reservas/${a48.id}/cancelar`);
+    assert.equal(justo48.status, 200);
+    assert.equal(justo48.cuerpo.reserva.penalizacion, undefined);
+
+    const a24 = await reservar(api, { inicio: "2027-01-11T10:30" });
+    const justo24 = await api.pedir("POST", `/api/reservas/${a24.id}/cancelar`);
+    assert.equal(justo24.status, 200);
+    assert.equal(justo24.cuerpo.reserva.penalizacion, Math.round(a24.importe * 0.25));
+  }));
+
+test("C3 · cambio de hora: 47,5 horas reales entre el 26 y el 28 de marzo de 2027", () =>
+  conApi(async (api) => {
+    await moverReloj(api, "2027-03-26T20:30");
+    const reserva = await reservar(api, { inicio: "2027-03-28T21:00" });
+    assert.equal(reserva.importe, 2800, "domingo por la tarde es punta en la pista 1");
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700, "47,5 horas es el tramo del 25 %");
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  }));
+
+test("C4 · reembolso: importe menos penalización, o el importe entero sin penalización", () =>
+  conApi(async (api) => {
+    await moverReloj(api, "2027-01-10T10:30");
+
+    const gratis = await reservar(api, { inicio: "2027-01-13T10:30" });
+    const sinPenalizacion = await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`);
+    assert.equal(sinPenalizacion.cuerpo.reembolso, gratis.importe);
+
+    const conPenalizacion = await reservar(api, { inicio: "2027-01-11T16:30" });
+    const reducida = await api.pedir("POST", `/api/reservas/${conPenalizacion.id}/cancelar`);
+    assert.equal(
+      reducida.cuerpo.reembolso,
+      conPenalizacion.importe - reducida.cuerpo.reserva.penalizacion,
+    );
+  }));
+
+test("C5 · exención: solo un gestor, con motivo de 10 caracteres o más y sin forzar", () =>
+  conApi(async (api) => {
+    await moverReloj(api, "2027-01-10T10:30");
+    const reserva = await reservar(api, { inicio: "2027-01-11T09:00" }); // menos de 24 horas
+
+    const sinIdentificarse = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "Avería del coche" },
+    });
+    assert.equal(sinIdentificarse.status, 401);
+    assert.equal(sinIdentificarse.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinPermiso = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-003",
+      cuerpo: { exento: true, motivo: "Avería del coche" },
+    });
+    assert.equal(sinPermiso.status, 403);
