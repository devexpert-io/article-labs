+test("numeración: diciembre generado en enero sigue la serie de 2026 y los meses siguen aunque se generen fuera de orden", async () => {
+  await conApi({}, async (api) => {
+    // Octubre se genera con el reloj por defecto (noviembre de 2026): serie de 2026 desde 0001.
+    const oct = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(oct.status, 201);
+    const nOct = oct.cuerpo.facturas.length;
+    assert.ok(nOct > 0);
+    assert.equal(oct.cuerpo.facturas[0].numero, "F2026-0001");
+
+    // Una reserva de diciembre, creada con el reloj en diciembre.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-01T09:00" } });
+    const r = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-007", pistaId: "pista-2", inicio: "2026-12-05T10:30" },
+    });
+    assert.equal(r.status, 201);
+
+    // Diciembre se genera en enero de 2027: sigue la serie de 2026.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-05T09:00" } });
+    const dic = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+    assert.equal(dic.status, 201);
+    assert.ok(dic.cuerpo.facturas.length > 0);
+    assert.equal(dic.cuerpo.facturas[0].numero, `F2026-${String(nOct + 1).padStart(4, "0")}`);
+
+    // Noviembre se genera después que diciembre (fuera de orden): continúa donde lo dejó diciembre.
+    const nov = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    assert.equal(nov.status, 201);
+    assert.ok(nov.cuerpo.facturas.length > 0);
+    assert.equal(nov.cuerpo.facturas[0].numero, `F2026-${String(nOct + dic.cuerpo.facturas.length + 1).padStart(4, "0")}`);
+  });
+});
