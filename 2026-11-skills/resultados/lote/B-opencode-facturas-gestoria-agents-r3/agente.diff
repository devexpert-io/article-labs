@@ -0,0 +1,204 @@
+// Las facturas mensuales de la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { calcularBaseIva } from "../src/nucleo.ts";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+/** Arranca una API en un puerto libre, ejecuta `fn` y la cierra siempre. */
+async function conApi(entorno: Record<string, string> = {}, fn: (a: Api) => Promise<void>): Promise<void> {
+  const a = await arrancarApi(entorno);
+  try {
+    await fn(a);
+  } finally {
+    a.cerrar();
+  }
+}
+
+/** Primera franja libre por la tarde (a partir de las 18:00) en una pista operativa. */
+async function franjaLibreTarde(a: Api, fecha: string): Promise<{ pista: string; inicio: string } | undefined> {
+  for (const pista of ["pista-1", "pista-2", "pista-3"]) {
+    const disp = await a.pedir("GET", `/api/disponibilidad?fecha=${fecha}&pista=${pista}`);
+    const franja = disp.cuerpo.pistas[0].franjas.find((f: any) => f.inicio.slice(11) >= "18:00" && f.estado === "libre");
+    if (franja) return { pista, inicio: franja.inicio };
+  }
+  return undefined;
+}
+
+test("el IVA se calcula sobre el total, no línea a línea (ejemplo de 6.400)", () => {
+  assert.deepEqual(calcularBaseIva(6400), { base: 5289, iva: 1111 });
+  assert.equal(calcularBaseIva(1800).base + calcularBaseIva(1800).iva, 1800);
+});
+
+test("solo un gestor genera y consulta facturas", async () => {
+  await conApi({}, async (api) => {
+    const sinCabecera = await api.pedir("GET", "/api/facturas?mes=2026-10");
+    assert.equal(sinCabecera.status, 401);
+    assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const noGestor = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const getNoGestor = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" });
+    assert.equal(getNoGestor.status, 403);
+    assert.equal(getNoGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const facturaNoGestor = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: "socio-001" });
+    assert.equal(facturaNoGestor.status, 403);
+    assert.equal(facturaNoGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    // Un gestor sí puede consultar, incluso antes de generar nada (lista vacía).
+    const vacia = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.equal(vacia.status, 200);
+    assert.deepEqual(vacia.cuerpo.facturas, []);
+  });
+});
+
+test("el mes se valida y solo se factura un mes cerrado", async () => {
+  await conApi({}, async (api) => {
+    for (const mes of ["2026-1", "2026-13", "hola", undefined]) {
+      const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+      assert.equal(r.status, 400);
+      assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    assert.equal(abierto.status, 409);
+    assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+
+    const getSinMes = await api.pedir("GET", "/api/facturas", { socio: GESTOR });
+    assert.equal(getSinMes.status, 400);
+    assert.equal(getSinMes.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  });
+});
+
+test("una factura por socio, ordenadas, con líneas, total e IVA; y generar dos veces devuelve lo mismo", async () => {
+  await conApi({}, async (api) => {
+    const primera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(primera.status, 201);
+    const facturas: any[] = primera.cuerpo.facturas;
+    assert.ok(facturas.length > 0, "octubre tiene reservas que facturar");
+
+    // Ordenadas por id de socio.
+    const ids = facturas.map((f) => f.socioId);
+    assert.deepEqual(ids, [...ids].sort());
+
+    // Numeración correlativa desde 0001.
+    assert.deepEqual(
+      facturas.map((f) => f.numero),
+      facturas.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`),
+    );
+
+    // Cada factura cuadra y sus líneas van por orden de inicio de la reserva.
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const inicioDe = new Map<string, string>(estado.reservas.map((r: any) => [r.id, r.inicio]));
+    for (const f of facturas) {
+      assert.equal(f.mes, "2026-10");
+      assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+      assert.deepEqual(calcularBaseIva(f.total), { base: f.base, iva: f.iva });
+      assert.equal(f.base + f.iva, f.total);
+      for (const linea of f.lineas) {
+        assert.equal(linea.concepto, "Reserva");
+        assert.ok(linea.importe > 0);
+      }
+      const inicios = f.lineas.map((l: any) => inicioDe.get(l.reservaId));
+      assert.deepEqual(inicios, [...inicios].sort(), "las líneas van ordenadas por el inicio de la reserva");
+    }
+
+    // Generar de nuevo devuelve las mismas facturas (200) y no crea ninguna nueva.
+    const segunda = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(segunda.status, 200);
+    assert.deepEqual(segunda.cuerpo.facturas, facturas);
+  });
+});
+
+test("consultar por mes y por número", async () => {
+  await conApi({}, async (api) => {
+    const gen = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    const facturas: any[] = gen.cuerpo.facturas;
+
+    const porMes = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.equal(porMes.status, 200);
+    assert.deepEqual(porMes.cuerpo.facturas, facturas);
+
+    const primera = facturas[0];
+    const porNumero = await api.pedir("GET", `/api/facturas/${primera.numero}`, { socio: GESTOR });
+    assert.equal(porNumero.status, 200);
+    assert.deepEqual(porNumero.cuerpo.factura, primera);
+
+    const inexistente = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+    assert.equal(inexistente.status, 404);
+    assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  });
+});
+
+test("una cancelación con penalización entra como Penalización y una sin penalización no entra", async () => {
+  await conApi({ AHORA: "2026-10-15T09:00" }, async (api) => {
+    // Reserva de esa misma tarde (a menos de 24 horas) y se cancela forzando la penalización.
+    const tarde = await franjaLibreTarde(api, "2026-10-15");
+    assert.ok(tarde, "debe haber una franja libre por la tarde");
+    const creada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: tarde!.pista, inicio: tarde!.inicio },
+    });
+    assert.equal(creada.status, 201);
+    const forzada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, forzada.cuerpo.reserva.importe);
+
+    // Reserva a varios días vista y se cancela gratis (sin penalización).
+    const disp = await api.pedir("GET", "/api/disponibilidad?fecha=2026-10-20&pista=pista-2");
+    const franja = disp.cuerpo.pistas[0].franjas.find((f: any) => f.estado === "libre");
+    assert.ok(franja, "debe haber una franja libre el 20 de octubre");
+    const lejana = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-2", inicio: franja.inicio },
+    });
+    assert.equal(lejana.status, 201);
+    const gratis = await api.pedir("POST", `/api/reservas/${lejana.cuerpo.reserva.id}/cancelar`);
+    assert.equal(gratis.cuerpo.reserva.estado, "cancelada");
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+
+    // Cierra octubre y genera sus facturas.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-01T00:00" } });
+    const gen = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(gen.status, 201);
+    const factura = gen.cuerpo.facturas.find((f: any) => f.socioId === "socio-041");
+    assert.ok(factura, "socio-041 debe tener factura");
+
+    const penalizaciones = factura.lineas.filter((l: any) => l.concepto === "Penalización");
+    assert.equal(penalizaciones.length, 1);
+    assert.equal(penalizaciones[0].reservaId, creada.cuerpo.reserva.id);
+    assert.equal(penalizaciones[0].importe, forzada.cuerpo.reserva.penalizacion);
+    assert.equal(factura.lineas.some((l: any) => l.reservaId === lejana.cuerpo.reserva.id), false, "la cancelación sin penalización no entra");
+  });
+});
