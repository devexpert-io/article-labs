@@ -0,0 +1,216 @@
+// Las facturas mensuales de la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(entorno: Record<string, string> = {}, prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi(entorno);
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("solo un gestor genera y consulta facturas", async () => {
+  await conApi({}, async (api) => {
+    const sinCabecera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+    assert.equal(sinCabecera.status, 401);
+    assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinCabeceraGet = await api.pedir("GET", "/api/facturas?mes=2026-10");
+    assert.equal(sinCabeceraGet.status, 401);
+    assert.equal(sinCabeceraGet.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const noGestor = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const gestor = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+    assert.equal(gestor.status, 200);
+    assert.deepEqual(gestor.cuerpo.facturas, []);
+  });
+});
+
+test("mes con formato inválido y mes abierto se rechazan", async () => {
+  await conApi({}, async (api) => {
+    const invalido = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026/10" }, socio: GESTOR });
+    assert.equal(invalido.status, 400);
+    assert.equal(invalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    assert.equal(abierto.status, 409);
+    assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+
+    const cerrado = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(cerrado.status, 201);
+    assert.ok(cerrado.cuerpo.facturas.length > 0);
+  });
+});
+
+test("una factura por socio con algo que facturar, ordenadas por id de socio", async () => {
+  await conApi({}, async (api) => {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(r.status, 201);
+    const facturas = r.cuerpo.facturas as Array<{ socioId: string }>;
+    assert.ok(facturas.length > 0);
+    const ids = facturas.map((f) => f.socioId);
+    assert.deepEqual(ids, [...ids].sort(), "las facturas van ordenadas por id de socio");
+    assert.equal(new Set(ids).size, ids.length, "cada socio tiene como mucho una factura");
+    assert.ok(!ids.includes("socio-041"), "Nora Benítez no tiene reservas en octubre, así que no lleva factura");
+  });
+});
+
+test("las líneas van ordenadas por inicio, con su concepto e importe", async () => {
+  await conApi({}, async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const noPresentada = estado.reservas.find(
+      (r: { inicio: string; estado: string }) => r.inicio.startsWith("2026-10") && r.estado === "no_presentada",
+    );
+    assert.ok(noPresentada, "la semilla trae una no_presentada en octubre");
+
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    const factura = r.cuerpo.facturas.find((f: { socioId: string }) => f.socioId === noPresentada.socioId);
+    assert.ok(factura, "el socio de la no_presentada lleva factura");
+    const linea = factura.lineas.find((l: { reservaId: string }) => l.reservaId === noPresentada.id);
+    assert.ok(linea, "la no_presentada se factura");
+    assert.equal(linea.concepto, "Reserva");
+    assert.equal(linea.importe, noPresentada.importe);
+
+    // Cada factura tiene sus líneas ordenadas por el inicio de la reserva.
+    for (const f of r.cuerpo.facturas) {
+      const inicios = f.lineas.map((l: { reservaId: string }) => {
+        const reserva = estado.reservas.find((x: { id: string }) => x.id === l.reservaId);
+        return reserva.inicio;
+      });
+      assert.deepEqual(inicios, [...inicios].sort(), `líneas ordenadas en la factura de ${f.socioId}`);
+    }
+  });
+});
+
+test("el IVA se calcula sobre el total de la factura (ejemplo de 6.400)", async () => {
+  await conApi({ AHORA: "2026-10-01T09:00" }, async (api) => {
+    // Nora Benítez (socio-041) no tiene reservas en la semilla: sus tres franjas suman 6.400.
+    for (const inicio of ["2026-10-05T10:30", "2026-10-05T12:00", "2026-10-05T18:00"]) {
+      const creada = await api.pedir("POST", "/api/reservas", {
+        cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio },
+      });
+      assert.equal(creada.status, 201, `reserva ${inicio}`);
+    }
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-01T09:00" } });
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    const factura = r.cuerpo.facturas.find((f: { socioId: string }) => f.socioId === "socio-041");
+    assert.ok(factura);
+    assert.equal(factura.lineas.length, 3);
+    assert.deepEqual(factura.lineas.map((l: { importe: number }) => l.importe), [1800, 1800, 2800]);
+    assert.equal(factura.total, 6400);
+    assert.equal(factura.base, 5289);
+    assert.equal(factura.iva, 1111);
+    assert.equal(factura.base + factura.iva, factura.total);
+  });
+});
+
+test("una cancelación con penalización entra como Penalización; sin penalización, no", async () => {
+  await conApi({ AHORA: "2026-12-02T09:00" }, async (api) => {
+    // Diciembre no tiene reservas en la semilla: todo es de socio-041.
+    const gratis = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-10T10:30" },
+    });
+    const penalizada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-02T18:00" },
+    });
+    const confirmada = await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-15T10:30" },
+    });
+
+    // Gratis (más de 24 horas antes) y fuera de plazo con penalización.
+    await api.pedir("POST", `/api/reservas/${gratis.cuerpo.reserva.id}/cancelar`);
+    const forzada = await api.pedir("POST", `/api/reservas/${penalizada.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 2800);
+
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-05T09:00" } });
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+    const factura = r.cuerpo.facturas.find((f: { socioId: string }) => f.socioId === "socio-041");
+    assert.ok(factura);
+
+    const ids = factura.lineas.map((l: { reservaId: string }) => l.reservaId);
+    assert.deepEqual(ids, [penalizada.cuerpo.reserva.id, confirmada.cuerpo.reserva.id], "ordenadas por inicio, sin la cancelación gratis");
+
+    const lineaPenalizacion = factura.lineas[0];
+    assert.equal(lineaPenalizacion.concepto, "Penalización");
+    assert.equal(lineaPenalizacion.importe, 2800);
+    assert.equal(factura.lineas[1].concepto, "Reserva");
+    assert.equal(factura.lineas[1].importe, 1800);
+    assert.equal(factura.total, 4600);
+    assert.equal(factura.base, 3802);
+    assert.equal(factura.iva, 798);
+  });
+});
+
+test("la numeración usa el año del mes y sigue una sola serie por año", async () => {
+  await conApi({ AHORA: "2026-12-01T09:00" }, async (api) => {
+    await api.pedir("POST", "/api/reservas", {
+      cuerpo: { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-12-05T10:30" },
+    });
+    // Diciembre se genera ya en enero de 2027: el número es del año 2026.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-05T09:00" } });
+    const diciembre = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: GESTOR });
+    assert.equal(diciembre.status, 201);
+    assert.equal(diciembre.cuerpo.facturas.length, 1);
+    assert.equal(diciembre.cuerpo.facturas[0].numero, "F2026-0001");
+
+    // Octubre se genera después (fuera de orden) y sigue la serie de 2026.
