+    await reservar(api, "2026-12-12T12:00", "pista-1", "socio-002"); // sábado, 2800, confirmada
+    const media = await reservar(api, "2026-12-10T12:00", "pista-3", SOCIO); // 1200, 25 % = 300
+    const gratis = await reservar(api, "2026-12-11T12:00", "pista-3", SOCIO); // 1200, sin penalización
+    const exenta = await reservar(api, "2026-12-11T12:00", "pista-2", SOCIO); // 1800, exenta
+    await reservar(api, "2027-01-02T12:00", "pista-2", "socio-004"); // otro mes
+    await reloj(api, "2026-12-09T11:00");
+    assert.equal((await cancelar(api, media.id)).cuerpo.reserva.penalizacion, 300);
+    assert.equal((await cancelar(api, gratis.id)).cuerpo.reserva.penalizacion, undefined);
