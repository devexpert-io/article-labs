+      (await api.pedir("GET", `/api/reservas?desde=2026-10-01&hasta=2026-10-31&estado=${estado}&limite=1`)).cuerpo.total as number;
+    const contadas = (await listar("confirmada")) + (await listar("no_presentada"));
