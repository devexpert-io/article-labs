+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: GESTOR });
+    assert.equal(informe.status, 200);
+    assert.deepEqual(informe.cuerpo, {
+      mes: "2026-12",
+      pistas: [
+        { pistaId: "pista-1", reservas: 2, ingresos: 4600, penalizaciones: 0, total: 4600 },
+        { pistaId: "pista-2", ...CAJA_VACIA },
+        { pistaId: "pista-3", reservas: 0, ingresos: 0, penalizaciones: 300, total: 300 },
+        { pistaId: "pista-4", ...CAJA_VACIA },
+      ],
+      total: { reservas: 2, ingresos: 4600, penalizaciones: 300, total: 4900 },
+    });
+  });
