diff --git a/test/reembolsos.test.ts b/test/reembolsos.test.ts
new file mode 100644
index 0000000..487e2c0
--- /dev/null
+++ b/test/reembolsos.test.ts
@@ -0,0 +1,322 @@
+// Spec docs/specs/reembolsos.md: penalizaciones escalonadas, exención y informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-041";
+
+/** Cada test arranca su propia API, con una semilla nueva. */
+async function conApi(cuerpo: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await cuerpo(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reloj(api: Api, ahora: string): Promise<void> {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+/** Reserva como Nora Benítez (sin reservas en la semilla) y devuelve la reserva creada. */
+async function reservar(api: Api, inicio: string, pistaId = "pista-3", socioId = SOCIO) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+}
+
+function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+// Jueves 10 de diciembre de 2026 a las 12:00 en la pista 3: hora valle, 1200 céntimos.
+const JUEVES = "2026-12-10T12:00";
+
+test("C1 · con 48 horas o más de antelación no hay penalización", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, JUEVES);
+    await reloj(api, "2026-12-08T11:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.estado, "cancelada");
+    assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c.cuerpo.reembolso, 1200);
+  });
+});
+
+test("C1 · con 24 horas o más y menos de 48 la penalización es el 25 %", async () => {
+  await conApi(async (api) => {
+    const a = await reservar(api, JUEVES);
+    const b = await reservar(api, JUEVES, "pista-2");
+    await reloj(api, "2026-12-08T12:01");
+    const casi48 = await cancelar(api, a.id);
+    assert.equal(casi48.status, 200);
+    assert.equal(casi48.cuerpo.reserva.penalizacion, 300);
+    await reloj(api, "2026-12-09T11:00");
+    const c = await cancelar(api, b.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, 450);
+    assert.equal(c.cuerpo.reembolso, 1350);
+  });
+});
+
+test("C1 · con menos de 24 horas solo se cancela con forzar y la penalización es el 50 %", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, JUEVES);
+    await reloj(api, "2026-12-09T12:01");
+    const sin = await cancelar(api, r.id);
+    assert.equal(sin.status, 409);
+    assert.equal(sin.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const noForzada = await cancelar(api, r.id, { forzar: false });
+    assert.equal(noForzada.status, 409);
+    assert.equal(noForzada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const sigue = await api.pedir("GET", `/api/reservas/${r.id}`);
+    assert.equal(sigue.cuerpo.reserva.estado, "confirmada");
+    const forzada = await cancelar(api, r.id, { forzar: true });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.estado, "cancelada");
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+    assert.equal(forzada.cuerpo.reembolso, 600);
+  });
+});
+
+test("C2 · a 48 horas justas no hay penalización", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, JUEVES);
+    await reloj(api, "2026-12-08T12:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c.cuerpo.reembolso, 1200);
+  });
+});
+
+test("C2 · a 24 horas justas se aplica el 25 % sin necesidad de forzar", async () => {
+  await conApi(async (api) => {
+    const r = await reservar(api, JUEVES);
+    await reloj(api, "2026-12-09T12:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, 300);
+    assert.equal(c.cuerpo.reembolso, 900);
+  });
+});
+
+test("C3 · en el cambio de hora de marzo, del viernes 20:30 al domingo 21:00 hay 47,5 horas: 25 %", async () => {
+  await conApi(async (api) => {
+    await reloj(api, "2027-03-26T20:30");
+    const r = await reservar(api, "2027-03-28T21:00"); // domingo, punta: 2000
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, 500);
+    assert.equal(c.cuerpo.reembolso, 1500);
+  });
+});
+
+test("C3 · en el cambio de hora de marzo, 24,5 horas de reloj son 23,5 reales: hace falta forzar", async () => {
+  await conApi(async (api) => {
+    await reloj(api, "2027-03-27T20:30");
+    const r = await reservar(api, "2027-03-28T21:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 409);
+    assert.equal(c.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await cancelar(api, r.id, { forzar: true });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 1000);
+  });
+});
+
+test("C3 · en el cambio de hora de octubre, 47,5 horas de reloj son 48,5 reales: sin penalización", async () => {
+  await conApi(async (api) => {
+    await reloj(api, "2027-10-29T21:30");
+    const r = await reservar(api, "2027-10-31T21:00");
+    const c = await cancelar(api, r.id);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c.cuerpo.reembolso, 2000);
+  });
+});
+
+test("C4 · el reembolso es el importe menos la penalización, o el importe entero sin penalización", async () => {
+  await conApi(async (api) => {
+    const gratis = await reservar(api, "2026-12-10T19:30", "pista-1"); // punta: 2800
+    const media = await reservar(api, "2026-12-10T19:30", "pista-2");
+    const c1 = await cancelar(api, gratis.id);
