+function instanteMadrid(fechaHora: string): number {
+  const [fecha, hora] = fechaHora.split("T");
+  const [y, m, d] = fecha!.split("-").map(Number);
+  const [hh, mm] = hora!.split(":").map(Number);
+  // Europe/Madrid offsets are determined from the UTC instant; iterate to
+  // resolve the local wall time, including both sides of DST transitions.
+  const nominal = Date.UTC(y!, m! - 1, d!, hh!, mm!);
+  let utc = nominal;
+  const formato = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/Madrid", timeZoneName: "longOffset", hour: "2-digit" });
+  for (let i = 0; i < 3; i++) {
+    const zone = formato.formatToParts(new Date(utc)).find((p) => p.type === "timeZoneName")!.value;
+    const match = /GMT([+-])(\d{2}):(\d{2})/.exec(zone);
+    const offset = match ? (match[1] === "+" ? 1 : -1) * (Number(match[2]) * 60 + Number(match[3])) : 0;
+    utc = nominal - offset * 60_000;
+  }
+  return utc;
+}
+
 function horasEntre(desde: string, hasta: string): number {
-  return (Date.parse(`${hasta}:00Z`) - Date.parse(`${desde}:00Z`)) / 3_600_000;
+  return (instanteMadrid(hasta) - instanteMadrid(desde)) / 3_600_000;
 }
 
