diff --git a/test/facturas.test.ts b/test/facturas.test.ts
new file mode 100644
index 0000000..ce3109e
--- /dev/null
+++ b/test/facturas.test.ts
@@ -0,0 +1,165 @@
+// Facturas mensuales de la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Base imponible que la gestoría desglosa de un total con el 21 % de IVA. */
+const baseDe = (total: number) => Math.round((total * 100) / 121);
+
+const GESTOR = "socio-040";
+
+let api: Api;
+let octubre: any[];
+
+before(async () => {
+  api = await arrancarApi();
+  const primera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(primera.status, 201);
+  octubre = primera.cuerpo.facturas;
+});
+after(() => api.cerrar());
+
+test("solo un gestor puede generar y consultar facturas", async () => {
+  const sinCabecera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+  assert.equal(sinCabecera.status, 401);
+  assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const noGestor = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10")).status, 401);
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" })).status, 403);
+  assert.equal((await api.pedir("GET", "/api/facturas/FRA-2026-0001")).status, 401);
+  assert.equal((await api.pedir("GET", "/api/facturas/FRA-2026-0001", { socio: "socio-001" })).status, 403);
+});
+
+test("mes cerrado: formato AAAA-MM y solo meses terminados", async () => {
+  const mal = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "octubre" }, socio: GESTOR });
+  assert.equal(mal.status, 400);
+  assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 409, `el mes ${mes} no ha terminado`);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+});
+
+test("una factura por socio, ordenadas por id", () => {
+  assert.equal(octubre.length, 40);
+  const ids = octubre.map((f: any) => f.socioId);
+  assert.deepEqual(ids, [...ids].sort());
+  const numeros = octubre.map((f: any) => f.numero);
+  assert.deepEqual(numeros, Array.from({ length: 40 }, (_, i) => `FRA-2026-${String(i + 1).padStart(4, "0")}`));
+});
+
+test("líneas, total, base e iva", () => {
+  assert.deepEqual(octubre[0], {
+    numero: "FRA-2026-0001",
+    mes: "2026-10",
+    socioId: "socio-001",
+    lineas: [
+      { reservaId: "R-0120", concepto: "reserva", importe: 1800 },
+      { reservaId: "R-0172", concepto: "reserva", importe: 2800 },
+      { reservaId: "R-0193", concepto: "reserva", importe: 2200 },
+    ],
+    total: 6800,
+    base: 5620,
+    iva: 1180,
+  });
+
+  // socio-002: la cancelada sin penalización (R-0043) no factura; el resto, por orden de inicio.
+  const socio002 = octubre.find((f: any) => f.socioId === "socio-002");
+  assert.deepEqual(
+    socio002.lineas.map((l: any) => l.reservaId),
+    ["R-0010", "R-0035", "R-0076", "R-0113", "R-0126", "R-0156", "R-0240", "R-0257", "R-0284"],
+  );
+  assert.equal(socio002.total, 20400);
+
+  for (const f of octubre) {
+    assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0), `${f.numero}: total = suma de líneas`);
+    assert.equal(f.base, baseDe(f.total), `${f.numero}: base`);
+    assert.equal(f.iva, f.total - f.base, `${f.numero}: iva`);
+    assert.equal(f.base + f.iva, f.total, `${f.numero}: base + iva = total`);
+    for (const l of f.lineas) {
+      assert.ok(l.concepto === "reserva" || l.concepto === "penalizacion");
+      assert.ok(Number.isInteger(l.importe) && l.importe > 0);
+    }
+  }
+});
+
+test("generar dos veces devuelve lo mismo y no crea nada", async () => {
+  const repetida = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(repetida.status, 200);
+  assert.deepEqual(repetida.cuerpo.facturas, octubre);
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.facturas.length, 40);
+});
+
+test("consultar facturas", async () => {
+  const lista = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(lista.status, 200);
+  assert.deepEqual(lista.cuerpo.facturas, octubre);
+
+  const vacia = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+  assert.equal(vacia.status, 200);
+  assert.deepEqual(vacia.cuerpo.facturas, []);
+
+  const una = await api.pedir("GET", "/api/facturas/FRA-2026-0001", { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo.factura, octubre[0]);
+
+  const inexistente = await api.pedir("GET", "/api/facturas/FRA-9999-0001", { socio: GESTOR });
+  assert.equal(inexistente.status, 404);
+  assert.equal(inexistente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("lo demás no cambia: las reservas siguen igual", async () => {
+  const listado = await api.pedir("GET", "/api/reservas?desde=2026-10-01&hasta=2026-10-31&limite=1");
+  assert.equal(listado.status, 200);
+  assert.equal(listado.cuerpo.total, 315);
+  assert.equal((await api.pedir("GET", "/api/pistas")).status, 200);
+});
+
+test("la numeración es correlativa por año: entre meses y entre años", async () => {
+  const otra = await arrancarApi();
+  try {
+    // Octubre de 2026 arranca la serie del año.
