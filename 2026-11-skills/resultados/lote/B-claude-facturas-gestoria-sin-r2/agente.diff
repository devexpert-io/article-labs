+    /** Genera las facturas de un mes cerrado. Si ya estaba generado, devuelve las mismas (`nuevas: false`). */
+    generarFacturas(quien: Socio | undefined, datos: { mes?: unknown }) {
+      soloGestor(quien);
+      const mes = validarMes(datos.mes);
+      if (mes >= estado.ahora.slice(0, 7)) throw new ErrorDelClub("MES_ABIERTO", `El mes ${mes} todavía no ha terminado`);
+      if (estado.mesesFacturados.includes(mes)) return { nuevas: false, facturas: estado.facturas.filter((f) => f.mes === mes) };
+      const serie = serieDe(mes);
+      let n = estado.facturas.filter((f) => serieDe(f.mes) === serie).length;
+      const facturas: Factura[] = facturasDelMes(mes, estado.reservas).map(({ mes, socioId, lineas, total, base, iva }) => {
+        n += 1;
+        return { numero: numeroDe(serie, n), mes, socioId, lineas, total, base, iva };
+      });
+      estado.facturas.push(...facturas);
+      estado.mesesFacturados.push(mes);
+      return { nuevas: true, facturas };
+    },
+
+    listarFacturas(quien: Socio | undefined, mes: unknown) {
+      soloGestor(quien);
+      const m = validarMes(mes);
+      return { facturas: estado.facturas.filter((f) => f.mes === m) };
+    },
+
+    obtenerFactura(quien: Socio | undefined, numero: string) {
+      soloGestor(quien);
+      const factura = estado.facturas.find((f) => f.numero === numero);
+      if (!factura) throw new ErrorDelClub("FACTURA_NO_ENCONTRADA", `No existe la factura ${numero}`, 404);
+      return { factura };
+    },
   };
 }
 
