+    assert.equal((await otra.pedir("POST", `/api/reservas/${penalizada}/cancelar`, { cuerpo: { forzar: true } })).cuerpo.reserva.penalizacion, 1200);
+    assert.equal((await otra.pedir("POST", `/api/reservas/${gratis}/cancelar`)).cuerpo.reserva.penalizacion, undefined);
+
+    // Octubre y noviembre van seguidos en la serie de 2026.
