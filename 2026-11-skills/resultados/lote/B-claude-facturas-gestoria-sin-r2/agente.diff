@@ -0,0 +1,62 @@
+// Reglas de facturación: qué entra en una factura, sus conceptos, el IVA y la numeración.
+//
+// PROVISIONAL: la spec (docs/specs/facturas.md) remite a "las reglas de facturación de la gestoría",
+// que no están en el repositorio. Las reglas de este fichero son supuestos razonables, pendientes de
+// confirmar con la gestoría. Si alguna cambia, solo hay que tocar este fichero (y el README).
+import type { Factura, LineaFactura, Reserva } from "./tipos.ts";
+
+/** Tipo de IVA, en tanto por ciento. Los precios del club llevan el IVA incluido. */
+export const TIPO_IVA = 21;
+
+/**
+ * Las líneas facturables de una reserva. Se factura por el mes de inicio de la reserva:
+ * - confirmada o no presentada: se paga la reserva, por su importe;
+ * - cancelada con penalización: se paga la penalización;
+ * - cancelada gratis: nada.
+ */
+export function lineaDe(r: Reserva): LineaFactura | undefined {
+  const cuando = r.inicio.replace("T", " ");
+  if (r.estado === "confirmada" || r.estado === "no_presentada") {
+    return { reservaId: r.id, concepto: `Reserva ${r.pistaId} ${cuando}`, importe: r.importe };
+  }
+  if (r.estado === "cancelada" && (r.penalizacion ?? 0) > 0) {
+    return { reservaId: r.id, concepto: `Penalización por cancelación ${r.pistaId} ${cuando}`, importe: r.penalizacion! };
+  }
+  return undefined;
+}
+
+/** Base e IVA de un total con IVA incluido: la base se redondea al céntimo y el IVA es lo que queda. */
+export function desglosar(total: number): { base: number; iva: number } {
+  const base = Math.round((total * 100) / (100 + TIPO_IVA));
+  return { base, iva: total - base };
+}
+
+/** Año de la serie de una factura: el del mes facturado. */
+export function serieDe(mes: string): string {
+  return mes.slice(0, 4);
+}
+
+/** Número de factura: AAAA-NNNN, correlativo dentro de cada año y empezando en 1. */
+export function numeroDe(serie: string, n: number): string {
+  return `${serie}-${String(n).padStart(4, "0")}`;
+}
+
+/** Las facturas de un mes, sin numerar todavía, ordenadas por id de socio. */
+export function facturasDelMes(mes: string, reservas: Reserva[]): Omit<Factura, "numero">[] {
+  const porSocio = new Map<string, { inicio: string; linea: LineaFactura }[]>();
+  for (const r of reservas) {
+    if (!r.inicio.startsWith(`${mes}-`)) continue;
+    const linea = lineaDe(r);
+    if (!linea) continue;
+    const suyas = porSocio.get(r.socioId) ?? [];
+    suyas.push({ inicio: r.inicio, linea });
+    porSocio.set(r.socioId, suyas);
+  }
+  return [...porSocio.keys()].sort().map((socioId) => {
+    const lineas = porSocio.get(socioId)!
+      .sort((a, b) => a.inicio.localeCompare(b.inicio) || a.linea.reservaId.localeCompare(b.linea.reservaId))
+      .map((l) => l.linea);
+    const total = lineas.reduce((s, l) => s + l.importe, 0);
+    return { mes, socioId, lineas, total, ...desglosar(total) };
+  });
+}
