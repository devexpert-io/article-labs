@@ -0,0 +1,183 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+test("permisos: solo un gestor genera y consulta facturas", async () => {
+  for (const [metodo, ruta, cuerpo] of [
+    ["POST", "/api/facturas", { mes: "2026-10" }],
+    ["GET", "/api/facturas?mes=2026-10", undefined],
+    ["GET", "/api/facturas/2026-0001", undefined],
+  ] as const) {
+    const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+    assert.equal(anonimo.status, 401, `${metodo} ${ruta}`);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const desconocido = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-999" });
+    assert.equal(desconocido.status, 401);
+    const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-004" });
+    assert.equal(socio.status, 403, `${metodo} ${ruta}`);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.facturas.length, 0, "sin permiso no se genera nada");
+});
+
+test("mes cerrado: formato AAAA-MM y solo meses ya terminados", async () => {
+  for (const mes of [undefined, "2026-13", "2026-00", "2026-1", "2026-10-01", 202610, "octubre"]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas", { socio: GESTOR })).status, 400);
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=10-2026", { socio: GESTOR })).status, 400);
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 409, mes);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+});
+
+test("octubre de 2026: una factura por socio con algo que facturar, con sus líneas, total e IVA", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const generada = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(generada.status, 201);
+  const { facturas } = generada.cuerpo;
+
+  // Una por socio, ordenadas por id de socio, y ninguna para quien no tiene nada (Nora Benítez).
+  const socios = facturas.map((f: any) => f.socioId);
+  assert.equal(facturas.length, 40);
+  assert.deepEqual(socios, [...socios].sort());
+  assert.ok(!socios.includes("socio-041"));
+
+  const octubre = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10-"));
+  for (const f of facturas) {
+    assert.equal(f.mes, "2026-10");
+    assert.deepEqual(Object.keys(f), ["numero", "mes", "socioId", "lineas", "total", "base", "iva"]);
+    // Las líneas: las reservas no canceladas del socio en el mes, ordenadas por inicio.
+    const suyas = octubre.filter((r: any) => r.socioId === f.socioId && r.estado !== "cancelada");
+    assert.deepEqual(f.lineas.map((l: any) => l.reservaId), suyas.map((r: any) => r.id));
+    for (const [i, l] of f.lineas.entries()) assert.equal(l.importe, suyas[i].importe);
+    assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+    assert.equal(f.base + f.iva, f.total);
+    assert.equal(f.base, Math.round(f.total / 1.21));
+  }
+
+  // Las reservas canceladas gratis no se facturan; las no presentadas sí.
+  const facturadas = new Set(facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId)));
+  for (const r of octubre) assert.equal(facturadas.has(r.id), r.estado !== "cancelada", r.id);
+  assert.equal(facturas.reduce((s: number, f: any) => s + f.total, 0), 635000);
+
+  const primera = facturas[0];
+  assert.deepEqual(primera, {
+    numero: "2026-0001",
+    mes: "2026-10",
+    socioId: "socio-001",
+    lineas: [
+      { reservaId: "R-0120", concepto: "Reserva pista-1 2026-10-12 09:00", importe: 1800 },
+      { reservaId: "R-0172", concepto: "Reserva pista-2 2026-10-17 21:00", importe: 2800 },
+      { reservaId: "R-0193", concepto: "Reserva pista-4 2026-10-18 12:00", importe: 2200 },
+    ],
+    total: 6800,
+    base: 5620,
+    iva: 1180,
+  });
+  const noPresentada = facturas.find((f: any) => f.socioId === "socio-017").lineas.find((l: any) => l.reservaId === "R-0022");
+  assert.deepEqual(noPresentada, { reservaId: "R-0022", concepto: "Reserva pista-2 2026-10-03 21:00", importe: 2800 });
+});
+
+test("numeración correlativa por orden de socio y generar dos veces no crea nada", async () => {
+  const primera = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas;
+  assert.deepEqual(primera.map((f: any) => f.numero), primera.map((_: unknown, i: number) => `2026-${String(i + 1).padStart(4, "0")}`));
+  const otra = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(otra.status, 200);
+  assert.deepEqual(otra.cuerpo.facturas, primera);
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, 40);
+});
+
+test("consultar: por mes y por número", async () => {
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR })).cuerpo, { facturas: [] });
+  const una = await api.pedir("GET", "/api/facturas/2026-0002", { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.equal(una.cuerpo.factura.socioId, "socio-002");
+  const ninguna = await api.pedir("GET", "/api/facturas/2026-0041", { socio: GESTOR });
+  assert.equal(ninguna.status, 404);
+  assert.equal(ninguna.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("lo demás no cambia: reservar, cancelar y consultar reservas", async () => {
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-24T12:00" } });
+  assert.equal(creada.status, 201);
+  const vista = await api.pedir("GET", `/api/reservas/${creada.cuerpo.reserva.id}`);
+  assert.deepEqual(vista.cuerpo.reserva, creada.cuerpo.reserva);
+  const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
