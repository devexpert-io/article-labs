+test("C7 · el informe de caja cuenta reservas, ingresos y penalizaciones por pista y mes", async () => {
+  await conApi(async (api) => {
+    // Noviembre: se compara con lo que hay en la semilla, incluidas las no presentadas.
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const noviembre = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR });
+    assert.equal(noviembre.status, 200);
+    const pistasEsperadas = [...estado.pistas]
+      .sort((a: any, b: any) => a.id.localeCompare(b.id))
+      .map((p: any) => {
+        const delMes = estado.reservas.filter((r: any) => r.pistaId === p.id && r.inicio.slice(0, 7) === "2026-11");
+        const cobradas = delMes.filter((r: any) => r.estado === "confirmada" || r.estado === "no_presentada");
+        const ingresos = cobradas.reduce((suma: number, r: any) => suma + r.importe, 0);
+        const penalizaciones = delMes
+          .filter((r: any) => r.estado === "cancelada")
+          .reduce((suma: number, r: any) => suma + (r.penalizacion ?? 0), 0);
+        return { pistaId: p.id, reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+      });
+    const totalEsperado = pistasEsperadas.reduce(
+      (suma: any, p: any) => ({
+        reservas: suma.reservas + p.reservas,
+        ingresos: suma.ingresos + p.ingresos,
+        penalizaciones: suma.penalizaciones + p.penalizaciones,
+        total: suma.total + p.total,
+      }),
+      { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    );
+    assert.deepEqual(noviembre.cuerpo, { mes: "2026-11", pistas: pistasEsperadas, total: totalEsperado });
+    assert.deepEqual(noviembre.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+
+    // Enero de 2027: datos controlados para comprobar el desglose exacto.
+    const confirmada = await crear(api, SOCIA, "pista-1", "2027-01-05T12:00");
+    const canceladaGratis = await crear(api, SOCIA, "pista-2", "2027-01-05T12:00");
+    const canceladaConPenalizacion = await crear(api, SOCIA, "pista-3", "2027-01-06T12:00");
+    assert.equal(confirmada.importe, 1800);
+
+    const gratis = await api.pedir("POST", `/api/reservas/${canceladaGratis.id}/cancelar`);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reembolso, 1800);
+
+    await moverReloj(api, "2027-01-06T10:00");
+    const conPenalizacion = await api.pedir("POST", `/api/reservas/${canceladaConPenalizacion.id}/cancelar`, {
+      cuerpo: { forzar: true },
+    });
+    assert.equal(conPenalizacion.status, 200);
+    assert.equal(conPenalizacion.cuerpo.reserva.penalizacion, 600);
+
+    const enero = await api.pedir("GET", "/api/informes/caja?mes=2027-01", { socio: GESTOR });
+    assert.equal(enero.status, 200);
+    assert.deepEqual(enero.cuerpo, {
+      mes: "2027-01",
+      pistas: [
+        { pistaId: "pista-1", reservas: 1, ingresos: 1800, penalizaciones: 0, total: 1800 },
+        { pistaId: "pista-2", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+        { pistaId: "pista-3", reservas: 0, ingresos: 0, penalizaciones: 600, total: 600 },
+        { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+      ],
+      total: { reservas: 1, ingresos: 1800, penalizaciones: 600, total: 2400 },
