@@ -0,0 +1,284 @@
+// Penalizaciones escalonadas, exención de gestor e informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIA = "socio-041";
+
+async function conApi(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function moverReloj(api: Api, ahora: string): Promise<void> {
+  const respuesta = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { ahora });
+}
+
+async function crear(api: Api, socioId: string, pistaId: string, inicio: string): Promise<any> {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(respuesta.status, 201);
+  return respuesta.cuerpo.reserva;
+}
+
+test("C1 · tramos: 48 horas o más sin penalización, entre 48 y 24 el 25 % y por debajo de 24 el 50 % con forzar", async () => {
+  await conApi(async (api) => {
+    const reservaGratis = await crear(api, SOCIA, "pista-2", "2026-12-15T12:00");
+    const reservaReducida = await crear(api, SOCIA, "pista-2", "2026-12-14T12:00");
+    const reservaForzada = await crear(api, SOCIA, "pista-2", "2026-12-10T12:00");
+    assert.equal(reservaGratis.importe, 1800);
+    assert.equal(reservaReducida.importe, 1800);
+    assert.equal(reservaForzada.importe, 1800);
+
+    await moverReloj(api, "2026-12-10T10:00");
+    const sinForzar = await api.pedir("POST", `/api/reservas/${reservaForzada.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${reservaForzada.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+
+    await moverReloj(api, "2026-12-13T10:00");
+    const reducida = await api.pedir("POST", `/api/reservas/${reservaReducida.id}/cancelar`);
+    assert.equal(reducida.status, 200);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, 450);
+    assert.equal(reducida.cuerpo.reembolso, 1350);
+
+    const gratis = await api.pedir("POST", `/api/reservas/${reservaGratis.id}/cancelar`);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.estado, "cancelada");
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, 1800);
+  });
+});
+
+test("C2 · límites exactos: a 48 horas no hay penalización y a 24 horas se aplica el 25 % sin forzar", async () => {
+  await conApi(async (api) => {
+    const a48 = await crear(api, SOCIA, "pista-2", "2026-12-14T12:00");
+    const a24 = await crear(api, SOCIA, "pista-3", "2026-12-14T12:00");
+
+    await moverReloj(api, "2026-12-12T12:00");
+    const gratis = await api.pedir("POST", `/api/reservas/${a48.id}/cancelar`);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, 1800);
+
+    await moverReloj(api, "2026-12-13T12:00");
+    const reducida = await api.pedir("POST", `/api/reservas/${a24.id}/cancelar`);
+    assert.equal(reducida.status, 200);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, 300);
+    assert.equal(reducida.cuerpo.reembolso, 900);
+  });
+});
+
+test("C3 · el cambio de hora se cuenta en horas reales de Madrid", async () => {
+  await conApi(async (api) => {
+    const reserva = await crear(api, SOCIA, "pista-2", "2027-03-28T21:00");
+    assert.equal(reserva.importe, 2800);
+
+    // Del viernes 26 a las 21:00 al domingo 28 a las 21:00 hay 47 horas reales,
+    // aunque en el reloj de pared parezcan 48: esa madrugada se adelanta la hora.
+    await moverReloj(api, "2027-03-26T21:00");
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+  });
+});
+
+test("C4 · el reembolso es el importe menos la penalización, o el importe entero si no hay penalización", async () => {
+  await conApi(async (api) => {
+    const conPenalizacion = await crear(api, SOCIA, "pista-2", "2026-12-16T12:00");
+    const sinPenalizacion = await crear(api, SOCIA, "pista-3", "2026-12-20T12:00");
+
+    await moverReloj(api, "2026-12-15T12:00");
+    const reducida = await api.pedir("POST", `/api/reservas/${conPenalizacion.id}/cancelar`);
+    assert.equal(reducida.status, 200);
+    assert.equal(reducida.cuerpo.reserva.importe, 1800);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, 450);
+    assert.equal(reducida.cuerpo.reembolso, reducida.cuerpo.reserva.importe - reducida.cuerpo.reserva.penalizacion);
+    assert.equal(reducida.cuerpo.reembolso, 1350);
+
+    const gratis = await api.pedir("POST", `/api/reservas/${sinPenalizacion.id}/cancelar`);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, gratis.cuerpo.reserva.importe);
+    assert.equal(gratis.cuerpo.reembolso, 2000);
+  });
+});
+
+test("C5 · un gestor exime con motivo de al menos 10 caracteres y solo él puede hacerlo", async () => {
+  await conApi(async (api) => {
+    const exenta = await crear(api, SOCIA, "pista-2", "2026-12-10T12:00");
+    const otra = await crear(api, SOCIA, "pista-3", "2026-12-10T12:00");
+    assert.equal(exenta.importe, 1800);
+    assert.equal(otra.importe, 1200);
+    await moverReloj(api, "2026-12-10T10:00");
+
+    const sinIdentificar = await api.pedir("POST", `/api/reservas/${exenta.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "Avería familiar" },
+    });
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinPermiso = await api.pedir("POST", `/api/reservas/${exenta.id}/cancelar`, {
+      socio: SOCIA,
+      cuerpo: { exento: true, motivo: "Avería familiar" },
+    });
+    assert.equal(sinPermiso.status, 403);
+    assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const sinMotivo = await api.pedir("POST", `/api/reservas/${exenta.id}/cancelar`, {
+      socio: GESTOR,
+      cuerpo: { exento: true },
+    });
+    assert.equal(sinMotivo.status, 400);
