+// La política de cancelación escalonada, la exención de gestor y el informe de caja.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+/** Crea una reserva en la pista 3 (muro, libre en el periodo vacío que usan los tests). */
+async function reservar(api: Api, socioId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-3", inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+}
+
+test("tramos y límites exactos de la penalización", async () => {
+  const propia = await arrancarApi({ AHORA: "2026-12-01T09:00" });
+  try {
+    // 48 horas justas: gratis, sin forzar.
+    const a48 = await reservar(propia, "socio-001", "2026-12-03T09:00");
+    const c48 = await propia.pedir("POST", `/api/reservas/${a48.id}/cancelar`);
+    assert.equal(c48.status, 200);
+    assert.equal(c48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c48.cuerpo.reembolso, a48.importe);
+
+    // Más de 48 horas: gratis.
+    const mas48 = await reservar(propia, "socio-002", "2026-12-03T10:30");
+    const cMas48 = await propia.pedir("POST", `/api/reservas/${mas48.id}/cancelar`);
+    assert.equal(cMas48.cuerpo.reserva.penalizacion, undefined);
+
+    // 24 horas justas: 25 %, sin forzar.
+    const a24 = await reservar(propia, "socio-003", "2026-12-02T09:00");
+    const c24 = await propia.pedir("POST", `/api/reservas/${a24.id}/cancelar`);
+    assert.equal(c24.status, 200);
+    assert.equal(c24.cuerpo.reserva.penalizacion, Math.round(a24.importe / 4));
+    assert.equal(c24.cuerpo.reembolso, a24.importe - Math.round(a24.importe / 4));
+
+    // Entre 24 y 48 horas: 25 %.
+    const entre = await reservar(propia, "socio-004", "2026-12-02T10:30");
+    const cEntre = await propia.pedir("POST", `/api/reservas/${entre.id}/cancelar`);
+    assert.equal(cEntre.cuerpo.reserva.penalizacion, Math.round(entre.importe / 4));
+
+    // Menos de 24 horas: exige forzar y cobra el 50 %.
+    const menos = await reservar(propia, "socio-005", "2026-12-01T19:30");
+    const sinForzar = await propia.pedir("POST", `/api/reservas/${menos.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await propia.pedir("POST", `/api/reservas/${menos.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, Math.round(menos.importe / 2));
+    assert.equal(forzada.cuerpo.reembolso, menos.importe - Math.round(menos.importe / 2));
+  } finally {
+    propia.cerrar();
+  }
+});
+
+test("la antelación cuenta las horas reales de Madrid (cambio de hora)", async () => {
+  const propia = await arrancarApi({ AHORA: "2027-03-26T20:30" });
+  try {
+    // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales: esa madrugada
+    // los relojes se adelantan una hora. Son menos de 48, así que se aplica el 25 %, no la gratuidad.
+    const creada = await reservar(propia, "socio-003", "2027-03-28T21:00");
+    const cancelada = await propia.pedir("POST", `/api/reservas/${creada.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, Math.round(creada.importe / 4));
+    assert.equal(cancelada.cuerpo.reembolso, creada.importe - Math.round(creada.importe / 4));
+  } finally {
+    propia.cerrar();
+  }
+});
+
+test("exención: solo un gestor, con motivo de al menos 10 caracteres", async () => {
+  const propia = await arrancarApi({ AHORA: "2026-12-01T09:00" });
+  try {
+    const reserva = await reservar(propia, "socio-003", "2026-12-01T19:30");
+
+    // Sin X-Socio no se sabe quién llama.
+    const sinIdentidad = await propia.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "motivo con más de diez caracteres" },
+    });
+    assert.equal(sinIdentidad.status, 401);
+    assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    // Un socio sin rol de gestor no puede eximir.
+    const sinPermiso = await propia.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "motivo con más de diez caracteres" },
+      socio: "socio-003",
+    });
+    assert.equal(sinPermiso.status, 403);
+    assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+    // El gestor necesita un motivo de al menos 10 caracteres.
+    const motivoCorto = await propia.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "corto" },
+      socio: "socio-040",
+    });
+    assert.equal(motivoCorto.status, 400);
+    assert.equal(motivoCorto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // Con gestor, exento y motivo válido se cancela sin penalización y sin forzar.
+    const exenta = await propia.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo: "exención aprobada por recepción" },
+      socio: "socio-040",
+    });
+    assert.equal(exenta.status, 200);
+    assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "exención aprobada por recepción");
+    assert.equal(exenta.cuerpo.reembolso, reserva.importe);
+  } finally {
+    propia.cerrar();
+  }
+});
+
+test("una reserva pasada no se cancela, tampoco con exento", async () => {
+  const sinExento = await api.pedir("POST", "/api/reservas/R-0001/cancelar");
+  assert.equal(sinExento.status, 409);
+  assert.equal(sinExento.cuerpo.error.codigo, "RESERVA_PASADA");
+
+  const conExento = await api.pedir("POST", "/api/reservas/R-0001/cancelar", {
+    cuerpo: { exento: true, motivo: "motivo con más de diez caracteres" },
+    socio: "socio-040",
+  });
+  assert.equal(conExento.status, 409);
+  assert.equal(conExento.cuerpo.error.codigo, "RESERVA_PASADA");
+});
+
+test("informe de caja: solo gestores, con el desglose por pista", async () => {
+  const sinIdentidad = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
+  assert.equal(sinIdentidad.status, 401);
+  assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+  const sinPermiso = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-001" });
+  assert.equal(sinPermiso.status, 403);
+  assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const malFormato = await api.pedir("GET", "/api/informes/caja?mes=2026-1", { socio: "socio-040" });
+  assert.equal(malFormato.status, 400);
+  assert.equal(malFormato.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const mes = "2026-11";
+  const informe = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: "socio-040" });
+  assert.equal(informe.status, 200);
+  assert.equal(informe.cuerpo.mes, mes);
+
+  // Una entrada por pista, ordenadas por id (también las que no tienen movimientos).
+  assert.deepEqual(informe.cuerpo.pistas.map((p: { pistaId: string }) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const pistasEsperadas = estado.pistas.map((p: { id: string }) => {
+    const delMes = estado.reservas.filter((r: { pistaId: string; inicio: string }) => r.pistaId === p.id && r.inicio.slice(0, 7) === mes);
+    const confirmadas = delMes.filter((r: { estado: string }) => r.estado === "confirmada" || r.estado === "no_presentada");
+    const canceladas = delMes.filter((r: { estado: string }) => r.estado === "cancelada");
+    const ingresos = confirmadas.reduce((suma: number, r: { importe: number }) => suma + r.importe, 0);
+    const penalizaciones = canceladas.reduce((suma: number, r: { penalizacion?: number }) => suma + (r.penalizacion ?? 0), 0);
+    return { pistaId: p.id, reservas: confirmadas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+  });
+  assert.deepEqual(informe.cuerpo.pistas, pistasEsperadas);
+
+  type Entrada = { reservas: number; ingresos: number; penalizaciones: number; total: number };
+  const total = pistasEsperadas.reduce(
+    (suma: Entrada, e: Entrada) => ({
+      reservas: suma.reservas + e.reservas,
+      ingresos: suma.ingresos + e.ingresos,
+      penalizaciones: suma.penalizaciones + e.penalizaciones,
+      total: suma.total + e.total,
+    }),
+    { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+  );
+  assert.deepEqual(informe.cuerpo.total, total);
+});
