+test("informe de caja: por pista y para todo el club, solo para gestores", async () => {
+  await conApi(async (api) => {
+    const anonimo = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-002" });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+    for (const mes of ["", "2026-13", "2026-1", "noviembre"]) {
+      const malo = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: GESTOR });
+      assert.equal(malo.status, 400, mes);
+      assert.equal(malo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
+    assert.equal((await api.pedir("GET", "/api/informes/caja", { socio: GESTOR })).status, 400);
+
+    // Una cancelación con penalización en noviembre y otra en diciembre, en pista 4 no hay nada.
+    const forzada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+    const diciembre = await reservarYMoverReloj(api, { socioId: "socio-041", pistaId: "pista-3", inicio: "2026-12-02T12:00" }, "2026-12-01T10:00");
+    assert.equal((await api.pedir("POST", `/api/reservas/${diciembre.id}/cancelar`)).cuerpo.reserva.penalizacion, 300);
+
+    const { reservas } = (await api.pedir("GET", "/_estado")).cuerpo as { reservas: any[] };
+    const esperado = (mes: string, pistaId?: string) => {
+      const delMes = reservas.filter((r) => r.inicio.startsWith(mes) && (!pistaId || r.pistaId === pistaId));
+      const cobradas = delMes.filter((r) => r.estado === "confirmada" || r.estado === "no_presentada");
+      const ingresos = cobradas.reduce((s, r) => s + r.importe, 0);
+      const penalizaciones = delMes.filter((r) => r.estado === "cancelada").reduce((s, r) => s + (r.penalizacion ?? 0), 0);
+      return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    };
+
+    const noviembre = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR });
+    assert.equal(noviembre.status, 200);
+    assert.equal(noviembre.cuerpo.mes, "2026-11");
+    assert.deepEqual(noviembre.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+    for (const fila of noviembre.cuerpo.pistas) assert.deepEqual(fila, { pistaId: fila.pistaId, ...esperado("2026-11", fila.pistaId) });
+    assert.deepEqual(noviembre.cuerpo.total, esperado("2026-11"));
+    assert.equal(noviembre.cuerpo.total.penalizaciones, 600);
+    assert.ok(noviembre.cuerpo.total.reservas > 0);
+
+    const dic = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: GESTOR });
+    assert.deepEqual(dic.cuerpo.pistas, [
+      { pistaId: "pista-1", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+      { pistaId: "pista-2", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+      { pistaId: "pista-3", reservas: 0, ingresos: 0, penalizaciones: 300, total: 300 },
+      { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    ]);
+    assert.deepEqual(dic.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 300, total: 300 });
+  });
+});
