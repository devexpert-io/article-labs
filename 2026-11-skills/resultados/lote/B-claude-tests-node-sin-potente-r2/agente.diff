+    assert.equal(tardia.cuerpo.reembolso, 2100);
+    // Del viernes 26 a las 20:00 hay 48 horas reales justas: sin penalización.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:00" } });
+    const b = await reservarYMoverReloj(api, datos, "2027-03-26T20:00");
+    const gratis = await api.pedir("POST", `/api/reservas/${b.id}/cancelar`);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, 2800);
+    // Del sábado 27 a las 20:30 hay 23,5 horas reales: hace falta forzar.
+    await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:00" } });
+    const c = await reservarYMoverReloj(api, datos, "2027-03-27T20:30");
+    assert.equal((await api.pedir("POST", `/api/reservas/${c.id}/cancelar`)).cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  });
+  await conApi(async (api) => {
+    // Domingo 31 de octubre de 2027 se atrasan los relojes: del viernes 29 a las 21:30 al domingo 31 a las 21:00 hay 48,5 horas.
+    const a = await reservarYMoverReloj(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-10-31T21:00" }, "2027-10-29T21:30");
+    const gratis = await api.pedir("POST", `/api/reservas/${a.id}/cancelar`);
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, 2800);
+  });
+});
+
+test("exención: un gestor cancela sin penalización con un motivo, sin necesidad de forzar", async () => {
+  await conApi(async (api) => {
+    // R-0520: Marta López, jueves 19 a las 09:00, faltan 23 horas.
+    const sinMotivo = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { socio: GESTOR, cuerpo: { exento: true } });
