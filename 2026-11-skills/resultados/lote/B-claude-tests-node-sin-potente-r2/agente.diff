+// Penalizaciones escalonadas, exención por un gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+/** Crea una reserva y mueve el reloj del club a `ahora`. */
+async function reservarYMoverReloj(api: Api, datos: { socioId: string; pistaId: string; inicio: string }, ahora: string) {
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: datos });
+  assert.equal(creada.status, 201, creada.texto);
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+  return creada.cuerpo.reserva as { id: string; importe: number };
+}
+
+test("tramos: sin penalización con 48 horas o más, 25 % entre 24 y 48, 50 % con forzar por debajo de 24", async () => {
+  await conApi(async (api) => {
+    // Miércoles 25 a las 12:00, valle en pista 1: 1800 céntimos.
+    const a = await reservarYMoverReloj(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T12:00" }, "2026-11-23T10:00");
+    const gratis = await api.pedir("POST", `/api/reservas/${a.id}/cancelar`);
+    assert.equal(gratis.status, 200);
+    assert.equal(gratis.cuerpo.reserva.estado, "cancelada");
+    assert.equal(gratis.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(gratis.cuerpo.reembolso, 1800);
+
+    const b = await reservarYMoverReloj(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T12:00" }, "2026-11-24T10:00");
+    const tardia = await api.pedir("POST", `/api/reservas/${b.id}/cancelar`);
+    assert.equal(tardia.status, 200);
+    assert.equal(tardia.cuerpo.reserva.penalizacion, 450);
+    assert.equal(tardia.cuerpo.reembolso, 1350);
+
+    const c = await reservarYMoverReloj(api, { socioId: "socio-041", pistaId: "pista-1", inicio: "2026-11-25T12:00" }, "2026-11-25T09:00");
+    const sinForzar = await api.pedir("POST", `/api/reservas/${c.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${c.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+  });
+});
+
+test("límites exactos: a 48 horas justas no hay penalización y a 24 justas es el 25 % sin forzar", async () => {
+  await conApi(async (api) => {
+    const a = await reservarYMoverReloj(api, { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-11-25T12:00" }, "2026-11-23T12:00");
+    const justas48 = await api.pedir("POST", `/api/reservas/${a.id}/cancelar`);
+    assert.equal(justas48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(justas48.cuerpo.reembolso, 1800);
+
+    const b = await reservarYMoverReloj(api, { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-11-25T12:00" }, "2026-11-24T12:00");
+    const justas24 = await api.pedir("POST", `/api/reservas/${b.id}/cancelar`);
+    assert.equal(justas24.status, 200);
+    assert.equal(justas24.cuerpo.reserva.penalizacion, 450);
+    assert.equal(justas24.cuerpo.reembolso, 1350);
+
+    const c = await reservarYMoverReloj(api, { socioId: "socio-041", pistaId: "pista-2", inicio: "2026-11-25T12:00" }, "2026-11-24T12:01");
+    assert.equal((await api.pedir("POST", `/api/reservas/${c.id}/cancelar`)).cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  });
+});
+
+test("cambio de hora: la antelación se cuenta en horas reales de Madrid", async () => {
+  await conApi(async (api) => {
+    // Domingo 28 de marzo de 2027 a las 21:00 (punta, 2800). Esa madrugada se adelantan los relojes.
+    const datos = { socioId: "socio-041", pistaId: "pista-1", inicio: "2027-03-28T21:00" };
+    // Del viernes 26 a las 20:30 hay 47,5 horas reales: 25 %.
+    const a = await reservarYMoverReloj(api, datos, "2027-03-26T20:30");
+    const tardia = await api.pedir("POST", `/api/reservas/${a.id}/cancelar`);
