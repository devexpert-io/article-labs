+const RELOJ_MADRID = new Intl.DateTimeFormat("en-GB", {
+  timeZone: "Europe/Madrid",
+  year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hourCycle: "h23",
+});
+
+/** Diferencia, en milisegundos, entre la hora de Madrid y la UTC en un instante. */
+function desfaseMadrid(instante: number): number {
+  const p = Object.fromEntries(RELOJ_MADRID.formatToParts(instante).map((x) => [x.type, x.value]));
+  return Date.parse(`${p.year}-${p.month}-${p.day}T${p.hour}:${p.minute}:00Z`) - Math.floor(instante / 60_000) * 60_000;
+}
+
+/** El instante real de una hora local de Madrid (AAAA-MM-DDTHH:MM), teniendo en cuenta el cambio de hora. */
+function instanteMadrid(local: string): number {
+  const comoUtc = Date.parse(`${local}:00Z`);
+  let instante = comoUtc - desfaseMadrid(comoUtc);
+  instante = comoUtc - desfaseMadrid(instante);
+  return instante;
+}
+
+/** Horas reales entre dos horas locales de Madrid. */
+export function horasEntre(desde: string, hasta: string): number {
+  return (instanteMadrid(hasta) - instanteMadrid(desde)) / 3_600_000;
+}
