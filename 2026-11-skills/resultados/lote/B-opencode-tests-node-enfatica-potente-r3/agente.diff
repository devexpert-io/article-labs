+  try {
+    const a = await crear(api, "socio-003", "pista-1", "2026-12-03T10:30");
+    const b = await crear(api, "socio-004", "pista-1", "2026-12-03T12:00");
+    await reloj(api, "2026-12-03T09:00");
+    const cancelada = await api.pedir("POST", `/api/reservas/${b.id}/cancelar`, { cuerpo: { forzar: true } });
