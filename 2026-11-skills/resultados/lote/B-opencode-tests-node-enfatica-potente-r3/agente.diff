+// La política de cancelación escalonada, la exención y el informe de caja, probados por la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function crear(api: Api, socioId: string, pistaId: string, inicio: string) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201);
+  return r.cuerpo.reserva;
+}
+
+async function reloj(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+}
+
+test("C1 · cancelar aplica los tres tramos de penalización", async () => {
+  const api = await arrancarApi({ AHORA: "2026-11-25T10:00" });
+  try {
+    // 48 horas o más: sin penalización.
+    const lejos = await crear(api, "socio-003", "pista-1", "2026-11-27T12:00");
+    const cLejos = await api.pedir("POST", `/api/reservas/${lejos.id}/cancelar`);
+    assert.equal(cLejos.status, 200);
+    assert.equal(cLejos.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cLejos.cuerpo.reembolso, lejos.importe);
+
+    // Entre 24 y 48 horas: el 25 % del importe.
+    const medio = await crear(api, "socio-003", "pista-1", "2026-11-26T12:00");
+    const cMedio = await api.pedir("POST", `/api/reservas/${medio.id}/cancelar`);
+    assert.equal(cMedio.status, 200);
+    assert.equal(cMedio.cuerpo.reserva.penalizacion, Math.round(medio.importe * 0.25));
+    assert.equal(cMedio.cuerpo.reembolso, medio.importe - Math.round(medio.importe * 0.25));
+
+    // Menos de 24 horas: sin forzar da 409 y, con forzar, el 50 %.
+    const cerca = await crear(api, "socio-003", "pista-1", "2026-11-25T12:00");
+    const sinForzar = await api.pedir("POST", `/api/reservas/${cerca.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const conForzar = await api.pedir("POST", `/api/reservas/${cerca.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(conForzar.status, 200);
+    assert.equal(conForzar.cuerpo.reserva.penalizacion, Math.round(cerca.importe * 0.5));
+    assert.equal(conForzar.cuerpo.reembolso, cerca.importe - Math.round(cerca.importe * 0.5));
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C2 · a 48 horas justas no hay penalización y a 24 horas justas es el 25 % sin forzar", async () => {
+  const api = await arrancarApi({ AHORA: "2026-11-25T10:30" });
+  try {
+    const justo48 = await crear(api, "socio-003", "pista-1", "2026-11-27T10:30");
+    const c48 = await api.pedir("POST", `/api/reservas/${justo48.id}/cancelar`);
+    assert.equal(c48.status, 200);
+    assert.equal(c48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(c48.cuerpo.reembolso, justo48.importe);
+
+    const justo24 = await crear(api, "socio-003", "pista-1", "2026-11-26T10:30");
+    const c24 = await api.pedir("POST", `/api/reservas/${justo24.id}/cancelar`);
+    assert.equal(c24.status, 200);
+    assert.equal(c24.cuerpo.reserva.penalizacion, Math.round(justo24.importe * 0.25));
+    assert.equal(c24.cuerpo.reembolso, justo24.importe - Math.round(justo24.importe * 0.25));
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C3 · la antelación cuenta las horas reales de Madrid con el cambio de hora", async () => {
+  const api = await arrancarApi({ AHORA: "2027-03-26T20:30" });
+  try {
+    // Del viernes 26 de marzo a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales, no 48,5.
+    const r = await crear(api, "socio-003", "pista-1", "2027-03-28T21:00");
+    const c = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(c.status, 200);
+    assert.equal(c.cuerpo.reserva.penalizacion, Math.round(r.importe * 0.25));
+    assert.equal(c.cuerpo.reembolso, r.importe - Math.round(r.importe * 0.25));
+  } finally {
+    api.cerrar();
+  }
+});
+
+test("C4 · cancelar responde reembolso igual a importe menos la penalización", async () => {
+  const api = await arrancarApi({ AHORA: "2026-11-25T10:00" });
+  try {
+    const gratis = await crear(api, "socio-003", "pista-1", "2026-11-27T12:00");
+    const cGratis = await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`);
+    assert.equal(cGratis.cuerpo.reembolso, gratis.importe);
+
+    const conPenalizacion = await crear(api, "socio-003", "pista-1", "2026-11-25T12:00");
+    const cPenalizacion = await api.pedir("POST", `/api/reservas/${conPenalizacion.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cPenalizacion.cuerpo.reembolso, conPenalizacion.importe - cPenalizacion.cuerpo.reserva.penalizacion);
+  } finally {
+    api.cerrar();
+  }
+});
+
