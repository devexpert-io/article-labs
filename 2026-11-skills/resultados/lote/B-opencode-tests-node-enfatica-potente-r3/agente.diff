+
+test("C5 · eximir sin motivo o con motivo corto devuelve 400 DATOS_INVALIDOS", async () => {
+  const api = await arrancarApi({ AHORA: "2026-11-25T10:00" });
+  try {
+    const sinMotivo = await crear(api, "socio-003", "pista-1", "2026-11-25T12:00");
+    const cSin = await api.pedir("POST", `/api/reservas/${sinMotivo.id}/cancelar`, { socio: "socio-040", cuerpo: { exento: true } });
+    assert.equal(cSin.status, 400);
