+    assert.equal(cancelada.cuerpo.reserva.penalizacion, Math.round(b.importe * 0.5));
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+    assert.equal(informe.cuerpo.mes, "2026-12");
+    assert.deepEqual(informe.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+
+    const p1 = informe.cuerpo.pistas.find((p: any) => p.pistaId === "pista-1");
+    assert.deepEqual(p1, {
+      pistaId: "pista-1",
+      reservas: 1,
+      ingresos: a.importe,
+      penalizaciones: Math.round(b.importe * 0.5),
+      total: a.importe + Math.round(b.importe * 0.5),
