+++ b/test/reembolsos.test.ts
@@ -0,0 +1,132 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi(fn: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try { await fn(api); } finally { api.cerrar(); }
+}
+async function fijar(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { ahora });
+}
+
+test("C1 · tramos de 24 a 48 horas y menos de 24", async () => conApi(async (api) => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const media = estado.reservas.find((r: any) => r.inicio === "2026-11-19T18:00" && r.estado === "confirmada");
+  const corta = estado.reservas.find((r: any) => r.inicio === "2026-11-19T09:00" && r.estado === "confirmada");
+  await fijar(api, "2026-11-18T10:00");
+  const normal = await api.pedir("POST", `/api/reservas/${media.id}/cancelar`);
+  assert.equal(normal.status, 200);
+  assert.equal(normal.cuerpo.reserva.penalizacion, Math.round(media.importe * 0.25));
+  const bloqueada = await api.pedir("POST", `/api/reservas/${corta.id}/cancelar`);
+  assert.equal(bloqueada.status, 409);
+  assert.deepEqual(bloqueada.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzada = await api.pedir("POST", `/api/reservas/${corta.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.penalizacion, Math.round(corta.importe * 0.5));
+}));
+
+test("C2 · límites exactos de 48 y 24 horas", async () => conApi(async (api) => {
+  await fijar(api, "2026-11-18T10:00");
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const r = estado.reservas.find((x: any) => x.inicio === "2026-11-20T10:00");
+  if (r) {
+    const a48 = await api.pedir("POST", `/api/reservas/${r.id}/cancelar`);
+    assert.equal(a48.status, 200);
+    assert.equal(a48.cuerpo.reserva.penalizacion, undefined);
+  }
+  const disponibles = estado.reservas.filter((x: any) => x.estado === "confirmada" && x.inicio > "2026-11-19T10:00");
+  assert.equal(disponibles.length >= 1, true);
+  await fijar(api, "2026-11-18T10:00");
+  const exacta = await api.pedir("POST", `/api/reservas/${disponibles[0].id}/cancelar`);
+  assert.equal(exacta.status, 200);
+  assert.equal(exacta.cuerpo.reserva.penalizacion, Math.round(disponibles[0].importe * 0.25));
+}));
+
+test("C3 · cambio de hora se cuenta en horas reales de Madrid", async () => conApi(async (api) => {
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2027-03-28T21:00" } });
+  assert.equal(creada.status, 201);
+  const reserva = creada.cuerpo.reserva;
+  await fijar(api, "2027-03-26T20:30");
+  const respuesta = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+  assert.equal(respuesta.status, 200);
+  assert.equal(respuesta.cuerpo.reserva.penalizacion, Math.round(reserva.importe * 0.25));
+}));
+
+test("C4 · reembolso descuenta la penalización", async () => conApi(async (api) => {
+  await fijar(api, "2026-11-18T10:00");
+  const reserva = (await api.pedir("GET", "/_estado")).cuerpo.reservas.find((x: any) => x.inicio === "2026-11-19T09:00" && x.estado === "confirmada");
+  const r = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reembolso, r.cuerpo.reserva.importe - r.cuerpo.reserva.penalizacion);
+}));
+
+test("C5 · exención requiere gestor, motivo y guarda el motivo", async () => conApi(async (api) => {
+  const reserva = (await api.pedir("GET", "/_estado")).cuerpo.reservas.find((x: any) => x.inicio === "2026-11-19T09:00" && x.estado === "confirmada");
+  const ruta = `/api/reservas/${reserva.id}/cancelar`;
+  const falta = await api.pedir("POST", ruta, { cuerpo: { exento: true } });
+  assert.equal(falta.status, 401);
+  assert.deepEqual(falta.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const permiso = await api.pedir("POST", ruta, { socio: "socio-003", cuerpo: { exento: true, motivo: "motivo suficientemente largo" } });
+  assert.equal(permiso.status, 403);
+  assert.deepEqual(permiso.cuerpo.error.codigo, "SIN_PERMISO");
+  const invalido = await api.pedir("POST", ruta, { socio: "socio-040", cuerpo: { exento: true, motivo: "corto" } });
+  assert.equal(invalido.status, 400);
+  assert.deepEqual(invalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const ok = await api.pedir("POST", ruta, { socio: "socio-040", cuerpo: { exento: true, motivo: "Exención aprobada" } });
+  assert.equal(ok.status, 200);
+  assert.deepEqual(ok.cuerpo.reserva.motivoCancelacion, "Exención aprobada");
+  assert.equal(ok.cuerpo.reserva.penalizacion, undefined);
+}));
+
+test("C6 · una reserva pasada no se cancela ni con exención", async () => conApi(async (api) => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const pasada = estado.reservas.find((r: any) => r.inicio === "2026-11-19T09:00" && r.estado === "confirmada");
+  await fijar(api, "2026-11-18T20:00");
+  await fijar(api, "2026-11-19T10:00");
+  const r = await api.pedir("POST", `/api/reservas/${pasada.id}/cancelar`, { socio: "socio-040", cuerpo: { exento: true, motivo: "Exención aprobada" } });
+  assert.equal(r.status, 409);
+  assert.deepEqual(r.cuerpo.error.codigo, "RESERVA_PASADA");
+}));
+
+test("C7 · informe de caja restringido, validado y agregado por pista", async () => conApi(async (api) => {
+  const anon = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
+  assert.equal(anon.status, 401);
+  assert.deepEqual(anon.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const socio = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-003" });
+  assert.equal(socio.status, 403);
+  assert.deepEqual(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  const formato = await api.pedir("GET", "/api/informes/caja?mes=2026-1", { socio: "socio-040" });
+  assert.equal(formato.status, 400);
+  assert.deepEqual(formato.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const ok = await api.pedir("GET", "/api/informes/caja?mes=2099-01", { socio: "socio-040" });
+  assert.equal(ok.status, 200);
+  assert.deepEqual(ok.cuerpo, { mes: "2099-01", pistas: ["pista-1", "pista-2", "pista-3", "pista-4"].map((pistaId) => ({ pistaId, reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 })), total: { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 } });
+}));
+
+test("C8 · las reservas canceladas conservan su penalización y crear sigue disponible", async () => conApi(async (api) => {
+  await fijar(api, "2026-11-18T10:00");
+  const reserva = (await api.pedir("GET", "/_estado")).cuerpo.reservas.find((x: any) => x.inicio === "2026-11-19T09:00" && x.estado === "confirmada");
+  const ruta = `/api/reservas/${reserva.id}/cancelar`;
+  const cancelada = await api.pedir("POST", ruta, { cuerpo: { forzar: true } });
+  const anterior = cancelada.cuerpo.reserva.penalizacion;
+  await fijar(api, "2026-11-18T11:00");
+  const deNuevo = await api.pedir("POST", ruta, { cuerpo: { forzar: true } });
+  assert.equal(deNuevo.status, 409);
+  assert.deepEqual(deNuevo.cuerpo.error.codigo, "YA_CANCELADA");
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.reservas.find((r: any) => r.id === reserva.id).penalizacion, anterior);
+  const nueva = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-24T12:00" } });
+  assert.equal(nueva.status, 201);
+  assert.deepEqual(nueva.cuerpo.reserva.estado, "confirmada");
+}));
+
+test("C9 · README documenta política, exención, reembolso e informe", async () => {
+  const { readFile } = await import("node:fs/promises");
+  const texto = await readFile(new URL("../README.md", import.meta.url), "utf8");
+  assert.equal(texto.includes("penaliza el 25 %"), true);
+  assert.equal(texto.includes("exento"), true);
+  assert.equal(texto.includes("reembolso"), true);
+  assert.equal(texto.includes("/api/informes/caja"), true);
+});
