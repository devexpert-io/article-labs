+import assert from "node:assert/strict";
+import { test, type TestContext } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Factura, Reserva } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+async function iniciar(t: TestContext) {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  return api;
+}
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+async function reservar(api: Api, socioId: string, inicio: string, pistaId = "pista-1"): Promise<Reserva> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, inicio, pistaId } });
+  assert.equal(r.status, 201, r.texto);
+  return r.cuerpo.reserva;
+}
+function generar(api: Api, mes: unknown) {
+  return api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+}
+
+test("solo el gestor puede generar y consultar facturas", async (t) => {
+  const api = await iniciar(t);
+  for (const [metodo, ruta] of [
+    ["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F2026-0001"],
+  ]) {
+    for (const [socio, status, codigo] of [
+      [undefined, 401, "NO_IDENTIFICADO"], ["socio-999", 401, "NO_IDENTIFICADO"], ["socio-001", 403, "SIN_PERMISO"],
+    ] as const) {
+      const r = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      assert.equal(r.status, status);
+      assert.equal(r.cuerpo.error.codigo, codigo);
+    }
+  }
+  assert.equal((await generar(api, "2026-10")).status, 201);
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).status, 200);
+  assert.equal((await api.pedir("GET", "/api/facturas/F2026-0001", { socio: gestor })).status, 200);
+});
+
+test("valida el mes y solo genera meses terminados según el reloj del club", async (t) => {
+  const api = await iniciar(t);
+  for (const mes of [undefined, null, 202610, {}, "", "2026-1", "26-10", "2026-00", "2026-13", "2026-10-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    const consulta = await api.pedir("GET", `/api/facturas?mes=${encodeURIComponent(String(mes))}`, { socio: gestor });
+    assert.equal(consulta.status, 400);
+    assert.equal(consulta.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas", { socio: gestor })).status, 400);
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj(api, "2026-11-30T23:59");
+  assert.equal((await generar(api, "2026-11")).status, 409);
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+});
+
+test("octubre: una factura por socio, líneas por inicio, estados, importes e IVA", async (t) => {
+  const api = await iniciar(t);
+  const estadoAnterior = (await api.pedir("GET", "/_estado")).cuerpo;
+  const reservas: Reserva[] = estadoAnterior.reservas;
+  const octubre = reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(octubre.some((r) => r.estado === "no_presentada"));
+  assert.ok(reservas.some((r) => r.inicio.startsWith("2026-10") && r.estado === "cancelada"));
