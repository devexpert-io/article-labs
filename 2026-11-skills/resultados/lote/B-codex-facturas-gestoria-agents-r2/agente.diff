+    total: 6400, base: 5289, iva: 1111,
+  }]);
+});
+
+test("incluye la penalización con tilde y excluye cancelaciones gratuitas", async (t) => {
+  const api = await iniciar(t);
+  await reloj(api, "2026-12-01T10:00");
