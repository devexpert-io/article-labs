+  }
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, reservas);
+  assert.deepEqual((await api.pedir("GET", "/api/reservas/R-0001")).cuerpo.reserva, reservas.find((r) => r.id === "R-0001"));
