+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import type { Estado } from "../src/tipos.ts";
+
+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+async function crear(api: Api, inicio: string, pistaId = "pista-2") {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId, inicio } });
+  assert.equal(r.status, 201);
+  return r.cuerpo.reserva;
+}
+
+const tramos = [
+  { nombre: "más de 48 horas", ahora: "2026-12-01T08:59", porcentaje: 0 },
+  { nombre: "48 horas exactas", ahora: "2026-12-01T09:00", porcentaje: 0 },
+  { nombre: "menos de 48 horas", ahora: "2026-12-01T09:01", porcentaje: 0.25 },
+  { nombre: "24 horas exactas", ahora: "2026-12-02T09:00", porcentaje: 0.25 },
+  { nombre: "menos de 24 horas", ahora: "2026-12-02T09:01", porcentaje: 0.5 },
+];
+for (const tramo of tramos) {
+  test(`cancelación con ${tramo.nombre}`, async (t) => {
+    const api = await arrancarApi();
+    t.after(() => api.cerrar());
+    const reserva = await crear(api, "2026-12-03T09:00");
+    await reloj(api, tramo.ahora);
+    if (tramo.porcentaje === 0.5) {
+      for (const cuerpo of [{}, { forzar: false }]) {
+        error(await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo }), 409, "FUERA_DE_PLAZO");
+      }
+      const intacta = await api.pedir("GET", `/api/reservas/${reserva.id}`);
+      assert.deepEqual(intacta.cuerpo.reserva, reserva);
+    }
+    const r = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: tramo.porcentaje === 0.5 ? { forzar: true } : {},
+    });
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.estado, "cancelada");
+    assert.equal(r.cuerpo.reserva.penalizacion, reserva.importe * tramo.porcentaje);
+    assert.equal(r.cuerpo.reembolso, reserva.importe * (1 - tramo.porcentaje));
+    const guardada = (await api.pedir("GET", `/api/reservas/${reserva.id}`)).cuerpo.reserva;
+    error(await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: true } }), 409, "YA_CANCELADA");
+    assert.deepEqual((await api.pedir("GET", `/api/reservas/${reserva.id}`)).cuerpo.reserva, guardada);
+  });
+}
+
+for (const caso of [
+  { nombre: "primavera: 47,5 horas", ahora: "2027-03-26T20:30", inicio: "2027-03-28T21:00", porcentaje: 0.25 },
