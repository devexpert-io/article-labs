+
+test("no se pueden cancelar reservas iniciadas ni pasadas, tampoco con exención", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const reserva = await crear(api, "2026-12-03T09:00");
