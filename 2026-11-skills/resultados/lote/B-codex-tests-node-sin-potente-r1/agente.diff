+test("caja incluye no presentadas y conserva las cancelaciones históricas", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const antes: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const canceladas = antes.reservas.filter((r) => r.estado === "cancelada");
+  assert.ok(canceladas.length > 0);
+  for (const mes of ["2026-10", "2026-11"]) {
+    const reservas = antes.reservas.filter((r) => r.inicio.startsWith(mes));
+    assert.ok(reservas.some((r) => r.estado === "no_presentada"));
+    const informe = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+    for (const p of informe.cuerpo.pistas) {
+      const dePista = reservas.filter((r) => r.pistaId === p.pistaId);
+      const cobradas = dePista.filter((r) => r.estado === "confirmada" || r.estado === "no_presentada");
+      assert.equal(p.reservas, cobradas.length);
+      assert.equal(p.ingresos, cobradas.reduce((n, r) => n + r.importe, 0));
+      assert.equal(p.penalizaciones, dePista.filter((r) => r.estado === "cancelada").reduce((n, r) => n + (r.penalizacion ?? 0), 0));
+      assert.equal(p.total, p.ingresos + p.penalizaciones);
+    }
+    for (const campo of ["reservas", "ingresos", "penalizaciones", "total"]) {
+      assert.equal(informe.cuerpo.total[campo], informe.cuerpo.pistas.reduce((n: number, p: any) => n + p[campo], 0));
+    }
+  }
+  const historica = canceladas[0]!;
+  error(await api.pedir("POST", `/api/reservas/${historica.id}/cancelar`, { cuerpo: { exento: true, motivo: "Revisión histórica" }, socio: "socio-040" }), 409, "YA_CANCELADA");
+  const despues: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.deepEqual(despues.reservas.filter((r) => r.estado === "cancelada"), canceladas);
+});
