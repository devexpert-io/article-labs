+test("caja suma ingresos y penalizaciones por inicio e incluye pistas sin movimientos", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const a = await crear(api, "2026-12-01T09:00", "pista-1");
+  const b = await crear(api, "2026-12-02T09:00", "pista-2");
+  const c = await crear(api, "2026-12-03T09:00", "pista-3");
+  await reloj(api, "2026-11-30T09:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${a.id}/cancelar`)).status, 200);
+  await reloj(api, "2026-12-02T08:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${b.id}/cancelar`, { cuerpo: { forzar: true } })).status, 200);
+  const r = await api.pedir("GET", "/api/informes/caja?mes=2026-12", { socio: "socio-040" });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, {
+    mes: "2026-12",
+    pistas: [
+      { pistaId: "pista-1", reservas: 0, ingresos: 0, penalizaciones: a.importe / 4, total: a.importe / 4 },
+      { pistaId: "pista-2", reservas: 0, ingresos: 0, penalizaciones: b.importe / 2, total: b.importe / 2 },
+      { pistaId: "pista-3", reservas: 1, ingresos: c.importe, penalizaciones: 0, total: c.importe },
+      { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    ],
+    total: { reservas: 1, ingresos: c.importe, penalizaciones: a.importe / 4 + b.importe / 2, total: c.importe + a.importe / 4 + b.importe / 2 },
+  });
+  const vacio = await api.pedir("GET", "/api/informes/caja?mes=2028-01", { socio: "socio-040" });
+  assert.deepEqual(vacio.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+  assert.equal(vacio.cuerpo.pistas.length, 4);
+  for (const p of vacio.cuerpo.pistas) assert.deepEqual(p, { pistaId: p.pistaId, reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+});
