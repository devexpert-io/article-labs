+  { nombre: "otoño: 48 horas exactas", ahora: "2027-10-29T20:30", inicio: "2027-10-31T19:30", porcentaje: 0 },
+  { nombre: "otoño: 49 horas", ahora: "2027-10-29T21:00", inicio: "2027-10-31T21:00", porcentaje: 0 },
+  { nombre: "primavera: 24 horas exactas", ahora: "2027-03-27T20:00", inicio: "2027-03-28T21:00", porcentaje: 0.25 },
+  { nombre: "primavera: 23,5 horas", ahora: "2027-03-27T20:30", inicio: "2027-03-28T21:00", porcentaje: 0.5 },
