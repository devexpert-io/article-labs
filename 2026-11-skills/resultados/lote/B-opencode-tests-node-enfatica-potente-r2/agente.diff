+
+/** Recalcula el informe de caja esperado a partir del estado, para compararlo con la API. */
+function esperarInforme(estado: any, mes: string) {
+  const resumen = (pistaId?: string) => {
+    const delMes = estado.reservas.filter((r: any) => r.inicio.startsWith(mes) && (pistaId === undefined || r.pistaId === pistaId));
+    const cobradas = delMes.filter((r: any) => r.estado === "confirmada" || r.estado === "no_presentada");
+    const ingresos = cobradas.reduce((suma: number, r: any) => suma + r.importe, 0);
+    const penalizaciones = delMes.filter((r: any) => r.estado === "cancelada").reduce((suma: number, r: any) => suma + (r.penalizacion ?? 0), 0);
+    return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+  };
+  return {
+    mes,
+    pistas: estado.pistas.map((p: any) => ({ pistaId: p.id, ...resumen(p.id) })),
+    total: resumen(),
+  };
+}
