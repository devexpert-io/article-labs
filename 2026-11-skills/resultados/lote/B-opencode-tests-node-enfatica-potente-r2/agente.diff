+  assert.deepEqual(vacio.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+  for (const p of vacio.cuerpo.pistas) {
+    assert.deepEqual(
+      { reservas: p.reservas, ingresos: p.ingresos, penalizaciones: p.penalizaciones, total: p.total },
+      { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    );
+  }
+
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-040" });
+  assert.equal(informe.status, 200);
+  assert.deepEqual(informe.cuerpo, esperarInforme(estado, "2026-11"));
