+// La política de penalizaciones escalonadas, la exención de los gestores y el informe de caja.
+import assert from "node:assert/strict";
+import { afterEach, beforeEach, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+let api: Api;
+beforeEach(async () => {
+  api = await arrancarApi();
+});
+afterEach(() => api.cerrar());
+
+test("C1 · tramos: 48h o más sin penalización, 24-48h al 25 % y menos de 24h al 50 % con forzar", async () => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T10:00" } });
+
+  const lejos = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-29T10:30" } });
+  const canceladoLejos = await api.pedir("POST", `/api/reservas/${lejos.cuerpo.reserva.id}/cancelar`);
+  assert.equal(canceladoLejos.status, 200);
+  assert.equal(canceladoLejos.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(canceladoLejos.cuerpo.reembolso, lejos.cuerpo.reserva.importe);
+
+  const medio = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-27T15:00" } });
+  const canceladoMedio = await api.pedir("POST", `/api/reservas/${medio.cuerpo.reserva.id}/cancelar`);
+  assert.equal(canceladoMedio.status, 200);
+  assert.equal(canceladoMedio.cuerpo.reserva.penalizacion, Math.round(medio.cuerpo.reserva.importe * 0.25));
+  assert.equal(canceladoMedio.cuerpo.reembolso, medio.cuerpo.reserva.importe - Math.round(medio.cuerpo.reserva.importe * 0.25));
+
+  const cerca = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-26T18:00" } });
+  const sinForzar = await api.pedir("POST", `/api/reservas/${cerca.cuerpo.reserva.id}/cancelar`);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const forzado = await api.pedir("POST", `/api/reservas/${cerca.cuerpo.reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(forzado.status, 200);
+  assert.equal(forzado.cuerpo.reserva.penalizacion, Math.round(cerca.cuerpo.reserva.importe * 0.5));
+  assert.equal(forzado.cuerpo.reembolso, cerca.cuerpo.reserva.importe - Math.round(cerca.cuerpo.reserva.importe * 0.5));
+});
+
+test("C2 · límites exactos: a 48 horas justas sin penalización y a 24 justas al 25 %", async () => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T10:30" } });
+
+  const a48 = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-28T10:30" } });
+  const cancel48 = await api.pedir("POST", `/api/reservas/${a48.cuerpo.reserva.id}/cancelar`);
+  assert.equal(cancel48.status, 200);
+  assert.equal(cancel48.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(cancel48.cuerpo.reembolso, a48.cuerpo.reserva.importe);
+
+  const a24 = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-27T10:30" } });
+  const cancel24 = await api.pedir("POST", `/api/reservas/${a24.cuerpo.reserva.id}/cancelar`);
+  assert.equal(cancel24.status, 200);
+  assert.equal(cancel24.cuerpo.reserva.penalizacion, Math.round(a24.cuerpo.reserva.importe * 0.25));
+});
+
+test("C3 · el cambio de hora cuenta en las horas reales de Madrid", async () => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-03-26T20:30" } });
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2027-03-28T21:00" } });
+  // Del viernes 26 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales: tramo del 25 %.
+  const cancelada = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`);
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+  assert.equal(cancelada.cuerpo.reembolso, 2100);
+});
+
+test("C4 · la cancelación responde el reembolso (importe menos penalización)", async () => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T10:30" } });
+
+  const gratis = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-28T12:00" } });
+  const cancelGratis = await api.pedir("POST", `/api/reservas/${gratis.cuerpo.reserva.id}/cancelar`);
+  assert.equal(cancelGratis.status, 200);
+  assert.equal(cancelGratis.cuerpo.reembolso, gratis.cuerpo.reserva.importe);
+
+  const parcial = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-1", inicio: "2026-11-27T12:00" } });
+  const cancelParcial = await api.pedir("POST", `/api/reservas/${parcial.cuerpo.reserva.id}/cancelar`);
+  assert.equal(cancelParcial.status, 200);
+  assert.equal(cancelParcial.cuerpo.reserva.penalizacion, Math.round(parcial.cuerpo.reserva.importe * 0.25));
+  assert.equal(cancelParcial.cuerpo.reembolso, parcial.cuerpo.reserva.importe - cancelParcial.cuerpo.reserva.penalizacion);
+});
+
+test("C5 · un gestor exime la penalización con un motivo de al menos 10 caracteres", async () => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T10:00" } });
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-2", inicio: "2026-11-26T18:00" } });
+  const importe = creada.cuerpo.reserva.importe;
+  const exenta = await api.pedir("POST", `/api/reservas/${creada.cuerpo.reserva.id}/cancelar`, {
+    cuerpo: { exento: true, motivo: "1234567890" },
+    socio: "socio-040",
+  });
+  assert.equal(exenta.status, 200);
+  assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+  assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(exenta.cuerpo.reserva.motivoCancelacion, "1234567890");
+  assert.equal(exenta.cuerpo.reembolso, importe);
+});
+
+test("C5 · exención: motivo inválido, sin permiso o sin identidad", async () => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T10:00" } });
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-003", pistaId: "pista-2", inicio: "2026-11-26T18:00" } });
+  const id = creada.cuerpo.reserva.id;
+
+  const corto = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { exento: true, motivo: "123456789" }, socio: "socio-040" });
+  assert.equal(corto.status, 400);
+  assert.equal(corto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const sinMotivo = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { exento: true }, socio: "socio-040" });
+  assert.equal(sinMotivo.status, 400);
+  assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+  const noGestor = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { exento: true, motivo: "Motivo suficientemente largo" }, socio: "socio-003" });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+  const anonimo = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { exento: true, motivo: "Motivo suficientemente largo" } });
+  assert.equal(anonimo.status, 401);
+  assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+});
+
+test("C6 · una reserva pasada no se cancela, tampoco con exento", async () => {
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-26T10:00" } });
+  const pasada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", {
+    cuerpo: { exento: true, motivo: "Motivo suficientemente largo" },
+    socio: "socio-040",
+  });
+  assert.equal(pasada.status, 409);
+  assert.equal(pasada.cuerpo.error.codigo, "RESERVA_PASADA");
+});
+
+test("C7 · el informe de caja es solo para gestores y valida el formato del mes", async () => {
