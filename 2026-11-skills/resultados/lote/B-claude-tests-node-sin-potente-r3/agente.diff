+// Penalizaciones escalonadas, exención por un gestor e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIA = "socio-041";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+async function reloj(ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+/** Crea una reserva con el reloj en `creadaEn` y deja el reloj en `ahora`. Devuelve su id. */
+async function reservar(inicio: string, ahora: string, pistaId = "pista-3", creadaEn = "2026-11-18T10:00"): Promise<string> {
+  await reloj(creadaEn);
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIA, pistaId, inicio } });
+  assert.equal(creada.status, 201, JSON.stringify(creada.cuerpo));
+  await reloj(ahora);
+  return creada.cuerpo.reserva.id;
+}
+
+const cancelar = (id: string, cuerpo: unknown = {}, socio?: string) =>
+  api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+
+// Martes 24 a las 12:00 en la pista 3: valle, 1200 céntimos.
+const INICIO = "2026-11-24T12:00";
+
+test("tramos: sin penalización con 48 horas o más, 25 % con 24 o más y 50 % con forzar por debajo", async () => {
+  const holgada = await cancelar(await reservar(INICIO, "2026-11-20T09:00"));
+  assert.equal(holgada.status, 200);
+  assert.equal(holgada.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(holgada.cuerpo.reembolso, 1200);
+
+  const tardia = await cancelar(await reservar(INICIO, "2026-11-23T00:00"));
+  assert.equal(tardia.status, 200);
+  assert.equal(tardia.cuerpo.reserva.penalizacion, 300);
+  assert.equal(tardia.cuerpo.reembolso, 900);
+
+  const id = await reservar(INICIO, "2026-11-24T08:00");
+  const sinForzar = await cancelar(id);
+  assert.equal(sinForzar.status, 409);
+  assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  assert.equal(sinForzar.cuerpo.error.mensaje.includes("50 %"), true);
+  const forzada = await cancelar(id, { forzar: true });
+  assert.equal(forzada.status, 200);
+  assert.equal(forzada.cuerpo.reserva.estado, "cancelada");
+  assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+  assert.equal(forzada.cuerpo.reembolso, 600);
+});
+
+test("límites exactos: a 48 horas justas no hay penalización y a 24 justas es el 25 % sin forzar", async () => {
