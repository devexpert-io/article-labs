+/** Minutos que Madrid va por delante de UTC en ese instante (60 en invierno, 120 en verano). */
+function desfaseMadrid(instante: number): number {
+  const nombre = RELOJ_MADRID.formatToParts(new Date(instante)).find((p) => p.type === "timeZoneName")?.value ?? "GMT";
+  const m = /GMT([+-])(\d{2}):(\d{2})/.exec(nombre);
