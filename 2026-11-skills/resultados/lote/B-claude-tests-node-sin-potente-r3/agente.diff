+test("informe de caja: reservas, ingresos y penalizaciones por pista y del club", async () => {
+  // Una penalización en noviembre, para que el informe la cuente.
+  const id = await reservar("2026-11-25T12:00", "2026-11-24T00:00");
+  assert.equal((await cancelar(id)).cuerpo.reserva.penalizacion, 300);
+
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  for (const mes of ["2026-10", "2026-11", "2027-01"]) {
+    const informe = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: GESTOR });
+    assert.equal(informe.status, 200);
+    assert.equal(informe.cuerpo.mes, mes);
+    assert.deepEqual(informe.cuerpo.pistas.map((p: any) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+    const delMes = estado.reservas.filter((r: any) => r.inicio.startsWith(mes));
+    const esperado = (pistaId?: string) => {
+      const suyas = delMes.filter((r: any) => !pistaId || r.pistaId === pistaId);
+      const cobradas = suyas.filter((r: any) => r.estado === "confirmada" || r.estado === "no_presentada");
+      const ingresos = cobradas.reduce((s: number, r: any) => s + r.importe, 0);
+      const penalizaciones = suyas.filter((r: any) => r.estado === "cancelada").reduce((s: number, r: any) => s + (r.penalizacion ?? 0), 0);
+      return { reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    };
+    for (const fila of informe.cuerpo.pistas) {
+      const { pistaId, ...cifras } = fila;
+      assert.deepEqual(cifras, esperado(pistaId), `${mes} ${pistaId}`);
+    }
+    assert.deepEqual(informe.cuerpo.total, esperado());
+  }
+
+  const noviembre = (await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR })).cuerpo;
+  assert.equal(noviembre.pistas.find((p: any) => p.pistaId === "pista-3").penalizaciones >= 300, true);
+  assert.equal(noviembre.total.reservas > 0, true);
+  const enero = (await api.pedir("GET", "/api/informes/caja?mes=2027-01", { socio: GESTOR })).cuerpo;
+  assert.deepEqual(enero.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+  assert.deepEqual(enero.pistas[3], { pistaId: "pista-4", reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+});
