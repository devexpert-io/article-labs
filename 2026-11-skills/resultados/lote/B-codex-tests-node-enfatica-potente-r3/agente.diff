+  assert.equal(reservas.some((r) => r.estado === "no_presentada"), true);
+  const pistas = [1, 2, 3, 4].map((n) => {
+    const cobradas = reservas.filter((r) => r.pistaId === `pista-${n}` && r.estado !== "cancelada");
+    const ingresos = cobradas.reduce((suma, r) => suma + r.importe, 0);
+    return { pistaId: `pista-${n}`, reservas: cobradas.length, ingresos, penalizaciones: 0, total: ingresos };
