+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { beforeEach, afterEach, test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import type { Reserva } from "../src/tipos.ts";
+
+let api: Api;
+beforeEach(async () => { api = await arrancarApi(); });
+afterEach(() => api.cerrar());
+
+async function reloj(ahora: string) {
+  const respuesta = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, { ahora });
+}
+
+async function crear(inicio = "2027-01-15T12:00", pistaId = "pista-1") : Promise<Reserva> {
+  const respuesta = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio, notas: "Prueba de reembolsos" },
+  });
+  assert.equal(respuesta.status, 201);
+  assert.deepEqual(respuesta.cuerpo.reserva, {
+    id: respuesta.cuerpo.reserva.id, socioId: "socio-041", pistaId, inicio,
+    fin: `${inicio.slice(0, 10)}T${inicio.endsWith("21:00") ? "22:30" : "13:30"}`,
+    estado: "confirmada", importe: inicio.endsWith("21:00") ? 2800 : 1800,
+    notas: "Prueba de reembolsos",
+  });
+  return respuesta.cuerpo.reserva;
+}
+
+function error(respuesta: Respuesta, status: number, codigo: string) {
+  assert.equal(respuesta.status, status);
+  assert.equal(respuesta.cuerpo.error.codigo, codigo);
+  assert.equal(typeof respuesta.cuerpo.error.mensaje, "string");
+}
+
+function cancelada(respuesta: Respuesta, reserva: Reserva, penalizacion: number, motivo?: string) {
+  assert.equal(respuesta.status, 200);
+  assert.deepEqual(respuesta.cuerpo, {
+    reserva: { ...reserva, estado: "cancelada", ...(penalizacion ? { penalizacion } : {}),
+      ...(motivo === undefined ? {} : { motivoCancelacion: motivo }) },
+    reembolso: reserva.importe - penalizacion,
+  });
+}
+
+for (const caso of [
+  { ahora: "2027-01-13T11:59", penalizacion: 0, forzar: false },
+  { ahora: "2027-01-13T12:01", penalizacion: 450, forzar: false },
+  { ahora: "2027-01-14T12:01", penalizacion: 900, forzar: true },
+  { ahora: "2027-01-15T11:59", penalizacion: 900, forzar: true },
+]) {
+  test(`C1 · tramos y último minuto antes del inicio: ${caso.ahora}`, async () => {
+    const reserva = await crear();
+    await reloj(caso.ahora);
+    if (caso.forzar) {
+      error(await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`), 409, "FUERA_DE_PLAZO");
+      error(await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: false } }), 409, "FUERA_DE_PLAZO");
+      const intacta = await api.pedir("GET", `/api/reservas/${reserva.id}`);
+      assert.equal(intacta.status, 200);
+      assert.deepEqual(intacta.cuerpo, { reserva });
+    }
