+function instanteMadrid(local: string): number {
+  const pared = Date.parse(`${local}:00Z`);
+  const formato = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", second: "2-digit", hourCycle: "h23" });
+  let estimado = pared;
+  for (let i = 0; i < 3; i++) {
+    const partes = Object.fromEntries(formato.formatToParts(new Date(estimado)).map((p) => [p.type, p.value]));
+    const representado = Date.UTC(Number(partes.year), Number(partes.month) - 1, Number(partes.day), Number(partes.hour), Number(partes.minute), Number(partes.second));
+    estimado += pared - representado;
+  }
+  return estimado;
 }
 
