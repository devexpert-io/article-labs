+    assert.equal((await cancelar(api, id, { exento: true, motivo: "          " }, gestor)).status, 400);
+    assert.equal((await cancelar(api, id, { exento: "si", motivo }, gestor)).status, 400);
+    assert.equal((await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva.estado, "confirmada", "los intentos fallidos no cancelan");
+
+    // Sin exento, el gestor sigue sujeto a la política: a 24 horas, 25 %.
+    const sinExento = await cancelar(api, id, {}, gestor);
+    assert.equal(sinExento.cuerpo.reserva.penalizacion, 450);
+    assert.equal((await api.pedir("GET", `/api/reservas/${id}`)).cuerpo.reserva.estado, "cancelada");
+  }));
+
+test("un gestor exime sin forzar, pero no en una reserva ya empezada ni dos veces", () =>
+  conApi(async (api) => {
+    const id = await reservar(api, "socio-005", "pista-2", "2026-12-02T12:00");
+    await ahoraEs(api, "2026-12-02T11:00"); // a 1 hora: el gestor cancela sin forzar y sin penalización
+    const exento = await cancelar(api, id, { exento: true, motivo: "Pista encharcada por la lluvia" }, "socio-040");
+    assert.equal(exento.status, 200);
+    assert.equal(exento.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exento.cuerpo.reembolso, 1800);
+    assert.equal(exento.cuerpo.reserva.motivoCancelacion, "Pista encharcada por la lluvia");
+    const otra = await cancelar(api, id, { exento: true, motivo: "Pista encharcada por la lluvia" }, "socio-040");
+    assert.equal(otra.cuerpo.error.codigo, "YA_CANCELADA");
+
+    const empezada = await reservar(api, "socio-006", "pista-3", "2026-12-03T12:00");
