+// Política de cancelación escalonada, exención de gestores e informe de caja, probados a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+/** Arranca una API limpia, la usa y la cierra. */
+async function conApi(prueba: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reservar(api: Api, socio: string, pista: string, inicio: string): Promise<string> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: socio, pistaId: pista, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva.id;
+}
+
+async function ahoraEs(api: Api, ahora: string): Promise<void> {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+test("tramos de penalización y sus límites exactos", () =>
+  conApi(async (api) => {
+    // Miércoles 2 de diciembre, en franja de valle: pista 1 y 2 a 1800, pista 3 a 1200.
+    const id48 = await reservar(api, "socio-003", "pista-1", "2026-12-02T12:00");
+    await ahoraEs(api, "2026-11-30T12:00"); // 48 horas justas
+    const sin = await cancelar(api, id48);
+    assert.equal(sin.status, 200);
+    assert.equal(sin.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(sin.cuerpo.reembolso, 1800);
+
+    const id47 = await reservar(api, "socio-004", "pista-2", "2026-12-02T12:00");
+    await ahoraEs(api, "2026-11-30T12:30"); // 47,5 horas: 25 %
+    const media = await cancelar(api, id47);
+    assert.equal(media.status, 200);
+    assert.equal(media.cuerpo.reserva.penalizacion, 450);
+    assert.equal(media.cuerpo.reembolso, 1350);
+
+    const id24 = await reservar(api, "socio-006", "pista-3", "2026-12-02T12:00");
+    await ahoraEs(api, "2026-12-01T12:00"); // 24 horas justas: 25 % y sin forzar
+    const justas = await cancelar(api, id24);
+    assert.equal(justas.status, 200);
+    assert.equal(justas.cuerpo.reserva.penalizacion, 300);
+    assert.equal(justas.cuerpo.reembolso, 900);
+
+    const id23 = await reservar(api, "socio-007", "pista-1", "2026-12-02T13:30");
+    await ahoraEs(api, "2026-12-01T14:00"); // 23,5 horas: sin forzar no se cancela
+    const sinForzar = await cancelar(api, id23);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await cancelar(api, id23, { forzar: true });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, 900);
+    assert.equal(forzada.cuerpo.reembolso, 900);
+  }));
+
+test("las horas se cuentan en tiempo real de Madrid, con los cambios de hora", () =>
+  conApi(async (api) => {
+    // Primavera de 2027 (el domingo 28 de marzo se adelanta el reloj): de viernes 20:30 a domingo 21:00 hay 47,5 horas.
+    // Domingo: punta, pista 1 a 2800; el 25 % son 700.
+    const primavera = await reservar(api, "socio-008", "pista-1", "2027-03-28T21:00");
+    await ahoraEs(api, "2027-03-26T20:30");
+    const cancelada = await cancelar(api, primavera);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, 700);
+    assert.equal(cancelada.cuerpo.reembolso, 2100);
+
+    // Otoño de 2027 (el domingo 31 de octubre se atrasa el reloj): de viernes 13:00 a domingo 12:00 hay 48 horas reales.
+    const otono = await reservar(api, "socio-009", "pista-2", "2027-10-31T12:00");
+    await ahoraEs(api, "2027-10-29T13:00");
+    const sinPenalizacion = await cancelar(api, otono);
+    assert.equal(sinPenalizacion.status, 200);
+    assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(sinPenalizacion.cuerpo.reembolso, 2800);
+  }));
+
+test("un gestor exime de la penalización con motivo, y los demás no pueden", () =>
+  conApi(async (api) => {
+    const id = await reservar(api, "socio-003", "pista-1", "2026-12-02T12:00");
+    await ahoraEs(api, "2026-12-01T12:00"); // 24 horas antes: la penalización sería del 25 %
+    const motivo = "Lluvia en la pista";
