+test("el informe de caja cuadra con el estado de la semilla", () =>
+  conApi(async (api) => {
+    const r = await api.pedir("GET", "/api/informes/caja?mes=2026-10", { socio: "socio-040" });
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const delMes = estado.reservas.filter((x: any) => x.inicio.slice(0, 7) === "2026-10");
+    const ingresos = delMes.filter((x: any) => x.estado !== "cancelada").reduce((s: number, x: any) => s + x.importe, 0);
+    assert.equal(r.cuerpo.total.reservas, delMes.filter((x: any) => x.estado !== "cancelada").length);
+    assert.equal(r.cuerpo.total.ingresos, ingresos);
+    assert.equal(r.cuerpo.total.penalizaciones, 0);
+    assert.equal(r.cuerpo.pistas.length, estado.pistas.length);
+    assert.equal(r.cuerpo.pistas.reduce((s: number, p: any) => s + p.total, 0), r.cuerpo.total.total);
