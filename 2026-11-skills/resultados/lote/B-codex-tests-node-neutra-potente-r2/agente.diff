+  await reloj("2027-01-14T12:01");
+  for (const cuerpo of [{}, { forzar: false }]) {
+    error(await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo }), 409, "FUERA_DE_PLAZO");
+  }
+  const r = await api.pedir("GET", `/api/reservas/${reserva.id}`);
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { reserva });
+});
+
+for (const [nombre, inicio, ahora, porcentaje] of [
+  ["adelanto de marzo: 47,5 horas reales", "2027-03-28T21:00", "2027-03-26T20:30", 0.25],
+  ["adelanto de marzo: menos de 24 horas reales", "2027-03-28T21:00", "2027-03-27T20:30", 0.5],
+  ["atraso de octubre: 48,5 horas reales", "2027-10-31T21:00", "2027-10-29T21:30", 0],
+] as const) {
+  test(`C3 · ${nombre}`, async () => {
+    const reserva = await crear(inicio);
+    await reloj(ahora);
+    if (porcentaje === 0.5) {
+      error(await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`), 409, "FUERA_DE_PLAZO");
+    }
+    const r = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: porcentaje === 0.5 } });
+    assert.equal(r.status, 200);
+    assert.equal(r.cuerpo.reserva.penalizacion, reserva.importe * porcentaje);
+    assert.equal(r.cuerpo.reembolso, reserva.importe * (1 - porcentaje));
