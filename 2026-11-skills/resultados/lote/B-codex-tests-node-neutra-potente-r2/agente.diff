+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 600);
+  const pistas = estado.pistas.map((p) => {
+    const delMes = estado.reservas.filter((r) => r.pistaId === p.id && r.inicio.startsWith("2026-11") && r.id !== reserva.id);
+    const cobradas = delMes.filter((r) => r.estado === "confirmada" || r.estado === "no_presentada");
+    const ingresos = cobradas.reduce((s, r) => s + r.importe, 0);
+    const penalizaciones = p.id === reserva.pistaId ? 600 : 0;
+    return { pistaId: p.id, reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+  });
+  const total = { reservas: 0, ingresos: 0, penalizaciones: 600, total: 0 };
+  for (const p of pistas) { total.reservas += p.reservas; total.ingresos += p.ingresos; total.total += p.total; }
+  const r = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-040" });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { mes: "2026-11", pistas, total });
+});
