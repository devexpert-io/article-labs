+import assert from "node:assert/strict";
+import { beforeEach, afterEach, test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+import type { Estado, Reserva } from "../src/tipos.ts";
+
+let api: Api;
+beforeEach(async () => { api = await arrancarApi(); });
+afterEach(() => api.cerrar());
+
+async function reloj(ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.cuerpo, { ahora });
+}
+
+async function crear(inicio = "2027-01-15T12:00", pistaId = "pista-1"): Promise<Reserva> {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-041", pistaId, inicio } });
+  assert.equal(r.status, 201);
+  assert.equal(r.cuerpo.reserva.inicio, inicio);
+  return r.cuerpo.reserva;
+}
+
+function error(r: Respuesta, status: number, codigo: string) {
+  assert.equal(r.status, status);
+  assert.equal(r.cuerpo.error.codigo, codigo);
+  assert.equal(typeof r.cuerpo.error.mensaje, "string");
+}
+
+for (const [nombre, ahora, porcentaje, forzar] of [
+  ["C1 · más de 48 horas: gratis", "2027-01-13T11:59", 0, false],
+  ["C1 · entre 24 y 48 horas: 25 %", "2027-01-14T00:00", 0.25, false],
+  ["C1 · menos de 24 horas: 50 % con forzar", "2027-01-14T12:01", 0.5, true],
+  ["C2 · exactamente 48 horas: gratis", "2027-01-13T12:00", 0, false],
+  ["C2 · exactamente 24 horas: 25 % sin forzar", "2027-01-14T12:00", 0.25, false],
+  ["C2 · un minuto antes de 48 horas: 25 %", "2027-01-13T12:01", 0.25, false],
+  ["C4 · un minuto antes del inicio: reembolso del 50 %", "2027-01-15T11:59", 0.5, true],
+] as const) {
+  test(nombre, async () => {
+    const reserva = await crear();
+    await reloj(ahora);
+    const r = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar } });
+    assert.equal(r.status, 200);
+    assert.deepEqual(r.cuerpo, {
+      reserva: { ...reserva, estado: "cancelada", penalizacion: reserva.importe * porcentaje },
+      reembolso: reserva.importe * (1 - porcentaje),
+    });
+  });
+}
+
+test("C1 · sin forzar o con forzar false se rechaza fuera de plazo sin modificar la reserva", async () => {
