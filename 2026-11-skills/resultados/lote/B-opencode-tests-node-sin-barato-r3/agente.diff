@@ -0,0 +1,207 @@
+// Penalizaciones escalonadas, exención de gestor e informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+async function conApi<T>(entorno: Record<string, string>, prueba: (api: Api) => Promise<T>): Promise<T> {
+  const api = await arrancarApi(entorno);
+  try {
+    return await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function reservar(api: Api, inicio: string, socioId = "socio-003", pistaId = "pista-1") {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(respuesta.status, 201, `${inicio} en ${pistaId}: ${respuesta.texto}`);
+  return respuesta.cuerpo.reserva;
+}
+
+/** Primera franja libre de una fecha; si se indica `despues`, solo las posteriores a esa hora. */
+async function franjaLibre(api: Api, fecha: string, despues?: string) {
+  const dia = await api.pedir("GET", `/api/disponibilidad?fecha=${fecha}`);
+  for (const pista of dia.cuerpo.pistas) {
+    for (const franja of pista.franjas) {
+      if (franja.estado === "libre" && (!despues || franja.inicio > despues)) {
+        return { pistaId: pista.pistaId as string, inicio: franja.inicio as string };
+      }
+    }
+  }
+  throw new Error(`No hay franjas libres el ${fecha}`);
+}
+
+test("los tramos de penalización y sus límites exactos", async () => {
+  await conApi({ AHORA: "2027-01-15T12:00" }, async (api) => {
+    // Muy por encima de 48 horas: sin penalización.
+    const lejos = await reservar(api, "2027-01-20T12:00");
+    const canceladaLejos = await api.pedir("POST", `/api/reservas/${lejos.id}/cancelar`);
+    assert.equal(canceladaLejos.status, 200);
+    assert.equal(canceladaLejos.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(canceladaLejos.cuerpo.reembolso, lejos.importe);
+
+    // 25,5 horas: tramo del 25 %.
+    const medio = await reservar(api, "2027-01-16T13:30");
+    const canceladaMedio = await api.pedir("POST", `/api/reservas/${medio.id}/cancelar`);
+    assert.equal(canceladaMedio.status, 200);
+    assert.equal(canceladaMedio.cuerpo.reserva.penalizacion, Math.round(medio.importe * 0.25));
+    assert.equal(canceladaMedio.cuerpo.reembolso, medio.importe - Math.round(medio.importe * 0.25));
+
+    // Exactamente 48 horas: sin penalización.
+    const exacto48 = await reservar(api, "2027-01-17T12:00");
+    const cancelada48 = await api.pedir("POST", `/api/reservas/${exacto48.id}/cancelar`);
+    assert.equal(cancelada48.status, 200);
+    assert.equal(cancelada48.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(cancelada48.cuerpo.reembolso, exacto48.importe);
+
+    // Exactamente 24 horas: 25 % y no hace falta forzar.
+    const exacto24 = await reservar(api, "2027-01-16T12:00");
+    const cancelada24 = await api.pedir("POST", `/api/reservas/${exacto24.id}/cancelar`);
+    assert.equal(cancelada24.status, 200);
+    assert.equal(cancelada24.cuerpo.reserva.penalizacion, Math.round(exacto24.importe * 0.25));
+
+    // 22,5 horas: sin forzar no se cancela; con forzar, 50 %.
+    const corta = await reservar(api, "2027-01-16T10:30");
+    const sinForzar = await api.pedir("POST", `/api/reservas/${corta.id}/cancelar`);
+    assert.equal(sinForzar.status, 409);
+    assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await api.pedir("POST", `/api/reservas/${corta.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, Math.round(corta.importe * 0.5));
+    assert.equal(forzada.cuerpo.reembolso, corta.importe - Math.round(corta.importe * 0.5));
+
+    // Una reserva ya cancelada conserva su penalización.
+    const repetida = await api.pedir("POST", `/api/reservas/${corta.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(repetida.status, 409);
+    assert.equal(repetida.cuerpo.error.codigo, "YA_CANCELADA");
+    const consultada = await api.pedir("GET", `/api/reservas/${corta.id}`);
+    assert.equal(consultada.cuerpo.reserva.penalizacion, Math.round(corta.importe * 0.5));
+  });
+});
+
+test("la antelación se cuenta en horas reales de Madrid, con el cambio de hora", async () => {
+  // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales.
+  await conApi({ AHORA: "2027-03-26T20:30" }, async (api) => {
+    const reserva = await reservar(api, "2027-03-28T21:00");
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, Math.round(reserva.importe * 0.25));
+    assert.equal(cancelada.cuerpo.reembolso, reserva.importe - Math.round(reserva.importe * 0.25));
+  });
+});
+
+test("un gestor puede eximir con motivo y solo él", async () => {
+  await conApi({}, async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const libre = await franjaLibre(api, estado.ahora.slice(0, 10), estado.ahora);
+    const reserva = await reservar(api, libre.inicio, "socio-003", libre.pistaId);
+    const motivo = "Avería de la pista";
+
+    const sinIdentidad = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      cuerpo: { exento: true, motivo },
+    });
+    assert.equal(sinIdentidad.status, 401);
+    assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinPermiso = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-003",
+      cuerpo: { exento: true, motivo },
+    });
+    assert.equal(sinPermiso.status, 403);
+    assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const motivoCorto = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo: "corto" },
+    });
+    assert.equal(motivoCorto.status, 400);
+    assert.equal(motivoCorto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const eximida = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo },
+    });
+    assert.equal(eximida.status, 200);
+    assert.equal(eximida.cuerpo.reserva.estado, "cancelada");
+    assert.equal(eximida.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(eximida.cuerpo.reserva.motivoCancelacion, motivo);
+    assert.equal(eximida.cuerpo.reembolso, reserva.importe);
+  });
+});
+
+test("una reserva que ya ha empezado no se cancela ni con exención", async () => {
+  await conApi({}, async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const pasada = estado.reservas.find(
+      (r: { estado: string; inicio: string }) => r.estado === "confirmada" && r.inicio <= estado.ahora,
+    );
+    assert.ok(pasada, "la semilla debe traer alguna reserva pasada confirmada");
+    const respuesta = await api.pedir("POST", `/api/reservas/${pasada.id}/cancelar`, {
+      socio: "socio-040",
+      cuerpo: { exento: true, motivo: "Cortesía de recepción" },
+    });
+    assert.equal(respuesta.status, 409);
+    assert.equal(respuesta.cuerpo.error.codigo, "RESERVA_PASADA");
+  });
+});
+
+test("el informe de caja es solo para gestores y cuadra con las reservas del mes", async () => {
+  await conApi({}, async (api) => {
+    const estadoInicial = (await api.pedir("GET", "/_estado")).cuerpo;
+    const libre = await franjaLibre(api, estadoInicial.ahora.slice(0, 10), estadoInicial.ahora);
+    const reserva = await reservar(api, libre.inicio, "socio-003", libre.pistaId);
+    const cancelada = await api.pedir("POST", `/api/reservas/${reserva.id}/cancelar`, { cuerpo: { forzar: true } });
+    assert.equal(cancelada.status, 200);
+
+    const sinIdentidad = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
+    assert.equal(sinIdentidad.status, 401);
+    assert.equal(sinIdentidad.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinPermiso = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-003" });
+    assert.equal(sinPermiso.status, 403);
+    assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const mesInvalido = await api.pedir("GET", "/api/informes/caja?mes=2026-11-01", { socio: "socio-040" });
+    assert.equal(mesInvalido.status, 400);
+    assert.equal(mesInvalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: "socio-040" });
+    assert.equal(informe.status, 200);
+    assert.equal(informe.cuerpo.mes, "2026-11");
+
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const pistas = [...estado.pistas].sort((a, b) => a.id.localeCompare(b.id)).map((pista) => {
+      let reservas = 0;
+      let ingresos = 0;
+      let penalizaciones = 0;
+      for (const r of estado.reservas) {
+        if (r.pistaId !== pista.id || !r.inicio.startsWith("2026-11")) continue;
+        if (r.estado === "confirmada" || r.estado === "no_presentada") {
+          reservas += 1;
+          ingresos += r.importe;
+        } else if (r.estado === "cancelada") {
+          penalizaciones += r.penalizacion ?? 0;
+        }
+      }
+      return { pistaId: pista.id, reservas, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    });
+    assert.deepEqual(informe.cuerpo.pistas, pistas);
+    const total = pistas.reduce(
+      (acumulado, p) => ({
+        reservas: acumulado.reservas + p.reservas,
+        ingresos: acumulado.ingresos + p.ingresos,
+        penalizaciones: acumulado.penalizaciones + p.penalizaciones,
+        total: acumulado.total + p.total,
+      }),
+      { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    );
+    assert.deepEqual(informe.cuerpo.total, total);
+
+    // Un mes sin movimientos trae todas las pistas a cero.
+    const vacio = await api.pedir("GET", "/api/informes/caja?mes=2027-01", { socio: "socio-040" });
+    assert.equal(vacio.status, 200);
+    assert.deepEqual(vacio.cuerpo.pistas.map((p: { pistaId: string }) => p.pistaId), pistas.map((p) => p.pistaId));
+    assert.ok(vacio.cuerpo.pistas.every((p: any) => p.reservas === 0 && p.ingresos === 0 && p.penalizaciones === 0 && p.total === 0));
+    assert.deepEqual(vacio.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+  });
+});
