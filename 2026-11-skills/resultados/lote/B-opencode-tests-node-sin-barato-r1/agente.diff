@@ -0,0 +1,179 @@
+// Penalizaciones escalonadas, exención de gestores e informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-041";
+
+async function conApi<T>(entorno: Record<string, string>, prueba: (api: Api) => Promise<T>): Promise<T> {
+  const api = await arrancarApi(entorno);
+  try {
+    return await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+/** Crea la reserva en la primera pista libre a esa hora. */
+async function crear(api: Api, inicio: string, socioId = SOCIO) {
+  for (const pistaId of ["pista-1", "pista-2", "pista-3"]) {
+    const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+    if (r.status === 201) return r.cuerpo.reserva;
+    if (r.cuerpo?.error?.codigo !== "FRANJA_NO_DISPONIBLE") {
+      throw new Error(`No se pudo crear la reserva: ${JSON.stringify(r.cuerpo)}`);
+    }
+  }
+  throw new Error(`No quedan pistas libres a las ${inicio}`);
+}
+
+async function cancelar(api: Api, id: string, cuerpo: Record<string, unknown> = {}, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+test("tramos: 48 horas o más, entre 24 y 48, y menos de 24", async () => {
+  await conApi({ AHORA: "2026-11-18T10:30" }, async (api) => {
+    // A 48 horas justas no hay penalización.
+    const a48 = await crear(api, "2026-11-20T10:30");
+    const sinPenalizacion = await cancelar(api, a48.id);
+    assert.equal(sinPenalizacion.status, 200);
+    assert.equal(sinPenalizacion.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(sinPenalizacion.cuerpo.reembolso, a48.importe);
+
+    // Con 47,5 horas se aplica el 25 %.
+    const a47 = await crear(api, "2026-11-20T09:00");
+    const reducida = await cancelar(api, a47.id);
+    assert.equal(reducida.status, 200);
+    assert.equal(reducida.cuerpo.reserva.penalizacion, Math.round(a47.importe * 0.25));
+    assert.equal(reducida.cuerpo.reembolso, a47.importe - Math.round(a47.importe * 0.25));
+
+    // A 24 horas justas se aplica el 25 % y no hace falta forzar.
+    const a24 = await crear(api, "2026-11-19T10:30");
+    const limite = await cancelar(api, a24.id);
+    assert.equal(limite.status, 200);
+    assert.equal(limite.cuerpo.reserva.penalizacion, Math.round(a24.importe * 0.25));
+
+    // Por debajo de 24 horas no se cancela sin forzar; con forzar, el 50 %.
+    const a22 = await crear(api, "2026-11-19T09:00");
+    const fuera = await cancelar(api, a22.id);
+    assert.equal(fuera.status, 409);
+    assert.equal(fuera.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const forzada = await cancelar(api, a22.id, { forzar: true });
+    assert.equal(forzada.status, 200);
+    assert.equal(forzada.cuerpo.reserva.penalizacion, Math.round(a22.importe * 0.5));
+    assert.equal(forzada.cuerpo.reembolso, a22.importe - Math.round(a22.importe * 0.5));
+  });
+});
+
+test("la antelación se cuenta en horas reales de Madrid con el cambio de hora", async () => {
+  await conApi({ AHORA: "2027-03-26T20:30" }, async (api) => {
+    // En el reloj de pared parecen 48,5 horas, pero con el cambio de hora son 47,5: tramo del 25 %.
+    const reserva = await crear(api, "2027-03-28T21:00");
+    const cancelada = await cancelar(api, reserva.id);
+    assert.equal(cancelada.status, 200);
+    assert.equal(cancelada.cuerpo.reserva.penalizacion, Math.round(reserva.importe * 0.25));
+  });
+});
+
+test("un gestor puede eximir con motivo, y solo un gestor", async () => {
+  await conApi({}, async (api) => {
+    const reserva = await crear(api, "2026-11-19T09:00");
+    const motivo = "Avería del coche";
+
+    const sinIdentificar = await cancelar(api, reserva.id, { exento: true, motivo });
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinPermiso = await cancelar(api, reserva.id, { exento: true, motivo }, "socio-003");
+    assert.equal(sinPermiso.status, 403);
+    assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const sinMotivo = await cancelar(api, reserva.id, { exento: true }, GESTOR);
+    assert.equal(sinMotivo.status, 400);
+    assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const motivoCorto = await cancelar(api, reserva.id, { exento: true, motivo: "corto" }, GESTOR);
+    assert.equal(motivoCorto.status, 400);
+    assert.equal(motivoCorto.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    // Sin forzar y a menos de 24 horas, la exención del gestor evita la penalización.
+    const exenta = await cancelar(api, reserva.id, { exento: true, motivo }, GESTOR);
+    assert.equal(exenta.status, 200);
+    assert.equal(exenta.cuerpo.reserva.estado, "cancelada");
+    assert.equal(exenta.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(exenta.cuerpo.reserva.motivoCancelacion, motivo);
+    assert.equal(exenta.cuerpo.reembolso, reserva.importe);
+  });
+});
+
+test("una reserva ya empezada no se cancela, tampoco con exento", async () => {
+  await conApi({}, async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const pasada = estado.reservas.find((r: any) => r.estado === "confirmada" && r.inicio <= estado.ahora);
+    assert.ok(pasada, "la semilla debe traer alguna reserva confirmada ya pasada");
+    const resultado = await cancelar(api, pasada.id, { exento: true, motivo: "Exención de recepción" }, GESTOR);
+    assert.equal(resultado.status, 409);
+    assert.equal(resultado.cuerpo.error.codigo, "RESERVA_PASADA");
+  });
+});
+
+test("informe de caja: permisos, formato y cifras del mes", async () => {
+  await conApi({}, async (api) => {
+    const sinIdentificar = await api.pedir("GET", "/api/informes/caja?mes=2027-05");
+    assert.equal(sinIdentificar.status, 401);
+    assert.equal(sinIdentificar.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const sinPermiso = await api.pedir("GET", "/api/informes/caja?mes=2027-05", { socio: "socio-003" });
+    assert.equal(sinPermiso.status, 403);
+    assert.equal(sinPermiso.cuerpo.error.codigo, "SIN_PERMISO");
+
+    for (const mes of ["2027-5", "2027-13", "mayo", "2027-05-01"]) {
+      const invalido = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: GESTOR });
+      assert.equal(invalido.status, 400, `mes ${mes} debe ser inválido`);
+      assert.equal(invalido.cuerpo.error.codigo, "DATOS_INVALIDOS");
+    }
