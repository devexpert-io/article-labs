+// Los reembolsos: tramos de penalización, exención de gestor e informe de caja.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api, type Respuesta } from "./ayuda.ts";
+
+const PISTA = "pista-3"; // 1200 en valle, 2000 en punta
+const SOCIO = "socio-003"; // cuota al día, rol socio
+const GESTOR = "socio-040";
+const VALLE = 1200;
+
+/** Levanta una API nueva, fija el reloj y crea una reserva; devuelve la API y el id. */
+async function preparar(ahora: string, inicio: string): Promise<{ api: Api; id: string; importe: number }> {
+  const api = await arrancarApi();
+  await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  const creada = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId: SOCIO, pistaId: PISTA, inicio } });
+  assert.equal(creada.status, 201, `crear reserva en ${inicio}`);
+  return { api, id: creada.cuerpo.reserva.id, importe: creada.cuerpo.reserva.importe };
+}
+
+test("C1 · tramos: 48h+ sin penalización, 24-48h el 25 % y menos de 24h el 50 % con forzar", async () => {
+  // 72 horas de antelación.
+  {
+    const { api, id } = await preparar("2026-12-01T09:00", "2026-12-04T09:00");
+    try {
+      const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+      assert.equal(r.status, 200);
+      assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+      assert.equal(r.cuerpo.reembolso, VALLE);
+    } finally {
+      api.cerrar();
+    }
+  }
+  // 25 horas de antelación (25 %).
+  {
+    const { api, id } = await preparar("2026-12-03T08:00", "2026-12-04T09:00");
+    try {
+      const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+      assert.equal(r.cuerpo.reserva.penalizacion, 300);
+      assert.equal(r.cuerpo.reembolso, 900);
+    } finally {
+      api.cerrar();
+    }
+  }
+  // 13 horas de antelación: sin forzar, FUERA_DE_PLAZO; con forzar, el 50 %.
+  {
+    const { api, id } = await preparar("2026-12-03T20:00", "2026-12-04T09:00");
+    try {
+      const sinForzar = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+      assert.equal(sinForzar.status, 409);
+      assert.equal(sinForzar.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+      const forzada = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { forzar: true } });
+      assert.equal(forzada.cuerpo.reserva.penalizacion, 600);
+      assert.equal(forzada.cuerpo.reembolso, 600);
+    } finally {
+      api.cerrar();
+    }
+  }
+});
+
+test("C2 · límites exactos: a 48 horas justas no hay penalización y a 24 justas el 25 % sin forzar", async () => {
+  {
+    const { api, id } = await preparar("2026-12-02T09:00", "2026-12-04T09:00"); // 48 h justas
+    try {
