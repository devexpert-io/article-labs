+test("C7 · el informe de caja es solo para gestores y cuadra", async () => {
+  const api = await arrancarApi();
+  try {
+    const anonimo = await api.pedir("GET", "/api/informes/caja?mes=2026-11");
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const socio = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: SOCIO });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const mal = await api.pedir("GET", "/api/informes/caja?mes=2026-1", { socio: GESTOR });
+    assert.equal(mal.status, 400);
+    assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR });
+    assert.equal(informe.status, 200);
+    assert.equal(informe.cuerpo.mes, "2026-11");
+    assert.deepEqual(informe.cuerpo.pistas.map((p: { pistaId: string }) => p.pistaId), ["pista-1", "pista-2", "pista-3", "pista-4"]);
+    for (const p of informe.cuerpo.pistas) {
+      assert.equal(p.total, p.ingresos + p.penalizaciones);
+    }
+    const total = informe.cuerpo.total;
+    assert.equal(total.reservas, informe.cuerpo.pistas.reduce((s: number, p: { reservas: number }) => s + p.reservas, 0));
+    assert.equal(total.ingresos, informe.cuerpo.pistas.reduce((s: number, p: { ingresos: number }) => s + p.ingresos, 0));
+    assert.equal(total.penalizaciones, informe.cuerpo.pistas.reduce((s: number, p: { penalizaciones: number }) => s + p.penalizaciones, 0));
+    assert.equal(total.total, informe.cuerpo.pistas.reduce((s: number, p: { total: number }) => s + p.total, 0));
+
+    // Un mes sin movimientos también trae todas las pistas, a cero.
+    const vacio = await api.pedir("GET", "/api/informes/caja?mes=2027-01", { socio: GESTOR });
+    assert.equal(vacio.status, 200);
+    assert.equal(vacio.cuerpo.pistas.length, 4);
+    assert.deepEqual(vacio.cuerpo.total, { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 });
+  } finally {
+    api.cerrar();
+  }
+});
