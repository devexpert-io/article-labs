+++ b/test/facturas.test.ts
@@ -0,0 +1,207 @@
+// La facturación mensual de la gestoría, probada a través de la API y del núcleo.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import { crearClub } from "../src/nucleo.ts";
+import { crearSemilla } from "../src/semilla.ts";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+interface Linea {
+  reservaId: string;
+  concepto: string;
+  importe: number;
+}
+
+/** Reconstruye las líneas facturables por socio para un mes, siguiendo las reglas de la gestoría. */
+function lineasPorSocio(mes: string, reservas: any[]): Map<string, Linea[]> {
+  const porSocio = new Map<string, Linea[]>();
+  const delMes = reservas
+    .filter((r: any) => r.inicio.startsWith(`${mes}-`))
+    .sort((a: any, b: any) => (a.inicio === b.inicio ? a.id.localeCompare(b.id) : a.inicio.localeCompare(b.inicio)));
+  for (const r of delMes) {
+    let linea: Linea | undefined;
+    if (r.estado === "confirmada" || r.estado === "no_presentada") {
+      linea = { reservaId: r.id, concepto: "Reserva", importe: r.importe };
+    } else if (r.estado === "cancelada" && (r.penalizacion ?? 0) > 0) {
+      linea = { reservaId: r.id, concepto: "Penalización", importe: r.penalizacion };
+    }
+    if (!linea) continue;
+    const actuales = porSocio.get(r.socioId) ?? [];
+    actuales.push(linea);
+    porSocio.set(r.socioId, actuales);
+  }
+  return porSocio;
+}
+
+test("solo un gestor genera y consulta facturas", async () => {
+  const sinCabecera = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+  assert.equal(sinCabecera.status, 401);
+  assert.equal(sinCabecera.cuerpo.error.codigo, "NO_IDENTIFICADO");
+  const noGestor = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+  assert.equal(noGestor.status, 403);
+  assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10")).status, 401);
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" })).status, 403);
+  const gestor = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-040" });
+  assert.equal(gestor.status, 201);
+});
+
+test("mes inválido o abierto", async () => {
+  const mal = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026/10" }, socio: "socio-040" });
+  assert.equal(mal.status, 400);
+  assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const actual = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: "socio-040" });
+  assert.equal(actual.status, 409);
+  assert.equal(actual.cuerpo.error.codigo, "MES_ABIERTO");
+  const futuro = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2027-01" }, socio: "socio-040" });
+  assert.equal(futuro.status, 409);
+  assert.equal(futuro.cuerpo.error.codigo, "MES_ABIERTO");
+});
+
+test("una factura por socio, con sus líneas, total e IVA", async () => {
+  const otra = await arrancarApi();
+  try {
+    const estado = (await otra.pedir("GET", "/_estado")).cuerpo;
+    const esperado = lineasPorSocio("2026-10", estado.reservas);
+    const socios = [...esperado.keys()].sort();
+
+    const generadas = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-040" });
+    assert.equal(generadas.status, 201);
+    const facturas = generadas.cuerpo.facturas;
+    assert.equal(facturas.length, socios.length);
+    assert.ok(facturas.length > 0, "octubre debe tener facturas");
+
+    let numero = 1;
+    facturas.forEach((f: any, i: number) => {
+      assert.equal(f.socioId, socios[i], "las facturas van ordenadas por id de socio");
+      assert.equal(f.mes, "2026-10");
+      assert.equal(f.numero, `F2026-${String(numero).padStart(4, "0")}`);
+      numero += 1;
+      const lineas = esperado.get(f.socioId)!;
+      assert.deepEqual(f.lineas, lineas);
+      const total = lineas.reduce((s: number, l: Linea) => s + l.importe, 0);
+      assert.equal(f.total, total);
+      assert.equal(f.base, Math.round((total * 100) / 121));
+      assert.equal(f.iva, total - f.base);
+      assert.equal(f.base + f.iva, f.total);
+    });
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("generar dos veces devuelve las mismas facturas y no crea nuevas", async () => {
+  const otra = await arrancarApi();
+  try {
+    const primera = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-040" });
+    assert.equal(primera.status, 201);
+    const segunda = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-040" });
+    assert.equal(segunda.status, 200);
+    assert.deepEqual(segunda.cuerpo.facturas, primera.cuerpo.facturas);
+    const estado = (await otra.pedir("GET", "/_estado")).cuerpo;
+    assert.equal(estado.facturas.length, primera.cuerpo.facturas.length);
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("consultar facturas: por mes, por número y no encontrada", async () => {
+  const otra = await arrancarApi();
+  try {
+    const vacio = await otra.pedir("GET", "/api/facturas?mes=2026-09", { socio: "socio-040" });
+    assert.equal(vacio.status, 200);
+    assert.deepEqual(vacio.cuerpo.facturas, []);
+
+    const generadas = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-040" });
+    const facturas = generadas.cuerpo.facturas;
+
+    const lista = await otra.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-040" });
+    assert.equal(lista.status, 200);
+    assert.deepEqual(lista.cuerpo.facturas, facturas);
+
+    const una = await otra.pedir("GET", `/api/facturas/${facturas[0].numero}`, { socio: "socio-040" });
+    assert.equal(una.status, 200);
+    assert.deepEqual(una.cuerpo.factura, facturas[0]);
+
+    const no = await otra.pedir("GET", "/api/facturas/F9999-0001", { socio: "socio-040" });
+    assert.equal(no.status, 404);
+    assert.equal(no.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  } finally {
+    otra.cerrar();
+  }
+});
+
+test("el IVA se calcula sobre el total: 6.400 → base 5.289, IVA 1.111", () => {
+  const estado = crearSemilla();
+  estado.ahora = "2026-11-01T00:00";
+  estado.reservas = [
+    { id: "R-9001", socioId: "socio-001", pistaId: "pista-1", inicio: "2026-10-01T09:00", fin: "2026-10-01T10:30", estado: "confirmada", importe: 1800, notas: "" },
+    { id: "R-9002", socioId: "socio-001", pistaId: "pista-1", inicio: "2026-10-01T10:30", fin: "2026-10-01T12:00", estado: "confirmada", importe: 1800, notas: "" },
+    { id: "R-9003", socioId: "socio-001", pistaId: "pista-1", inicio: "2026-10-01T18:00", fin: "2026-10-01T19:30", estado: "confirmada", importe: 2800, notas: "" },
+  ];
+  const club = crearClub(estado);
+  const { facturas } = club.generarFacturas("2026-10");
+  assert.equal(facturas.length, 1);
+  assert.equal(facturas[0]!.total, 6400);
+  assert.equal(facturas[0]!.base, 5289);
+  assert.equal(facturas[0]!.iva, 1111);
+  assert.equal(facturas[0]!.base + facturas[0]!.iva, facturas[0]!.total);
+});
+
