+test("la numeración de diciembre generado en enero sigue la serie del año facturado", async () => {
+  const otra = await arrancarApi({ AHORA: "2026-11-20T09:00" });
+  try {
+    const oct = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-040" });
+    assert.equal(oct.status, 201);
+    assert.ok(oct.cuerpo.facturas.length > 0);
+    const ultimaOctubre = oct.cuerpo.facturas[oct.cuerpo.facturas.length - 1].numero as string;
+    assert.match(ultimaOctubre, /^F2026-\d{4}$/);
+    const nUltima = Number(ultimaOctubre.slice("F2026-".length));
+
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-12-05T09:00" } });
+    const creada = await otra.pedir("POST", "/api/reservas", { cuerpo: { socioId: "socio-004", pistaId: "pista-1", inicio: "2026-12-20T18:00" } });
+    assert.equal(creada.status, 201);
+
+    await otra.pedir("POST", "/_reloj", { cuerpo: { ahora: "2027-01-05T09:00" } });
+    const dic = await otra.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-12" }, socio: "socio-040" });
+    assert.equal(dic.status, 201);
+    assert.ok(dic.cuerpo.facturas.length > 0);
+    const primeraDiciembre = dic.cuerpo.facturas[0].numero as string;
+    assert.match(primeraDiciembre, /^F2026-\d{4}$/);
+    assert.equal(Number(primeraDiciembre.slice("F2026-".length)), nUltima + 1);
+  } finally {
+    otra.cerrar();
+  }
+});
