@@ -0,0 +1,316 @@
+// Penalizaciones escalonadas, exención de gestor, reembolso e informe de caja (docs/specs/reembolsos.md).
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+const SOCIO = "socio-041"; // Nora Benítez: sin reservas, cuota al día, socio normal.
+
+/** Arranca una API nueva para este test y la cierra al terminar. Cada test tiene su propio estado. */
+async function conClub(prueba: (api: Api) => Promise<void>) {
+  const api = await arrancarApi();
+  try {
+    await prueba(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+async function fijarAhora(api: Api, ahora: string) {
+  const r = await api.pedir("POST", "/_reloj", { cuerpo: { ahora } });
+  assert.equal(r.status, 200, `no se pudo fijar la hora ${ahora}`);
+}
+
+async function reservar(api: Api, inicio: string, pistaId = "pista-1", socioId = SOCIO) {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, `no se pudo reservar ${pistaId} ${inicio}: ${r.texto}`);
+  return r.cuerpo.reserva as { id: string; importe: number };
+}
+
+async function cancelar(api: Api, id: string, cuerpo?: unknown, socio?: string) {
+  return api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo, socio });
+}
+
+// Pista 1: 1.800 céntimos en valle y 2.800 en punta. 2026-12-02 es miércoles (valle a las 10:30 y a las 12:00).
+const MIERCOLES_12 = "2026-12-02T12:00";
+const MIERCOLES_1030 = "2026-12-02T10:30";
+
+test("C1 · con 48 horas o más de antelación no hay penalización", () =>
+  conClub(async (api) => {
+    const r = await reservar(api, MIERCOLES_12);
+    await fijarAhora(api, "2026-11-29T12:00"); // 72 horas antes
+    const res = await cancelar(api, r.id);
+    assert.equal(res.status, 200);
+    assert.equal(res.cuerpo.reserva.estado, "cancelada");
+    assert.equal(res.cuerpo.reserva.penalizacion, undefined);
+  }));
+
+test("C1 · entre 24 y 48 horas de antelación, la penalización es el 25 % sin forzar", () =>
+  conClub(async (api) => {
+    const r = await reservar(api, MIERCOLES_12);
+    await fijarAhora(api, "2026-11-30T13:00"); // 47 horas antes
+    const res = await cancelar(api, r.id);
+    assert.equal(res.status, 200);
+    assert.equal(res.cuerpo.reserva.penalizacion, 450);
+  }));
+
+test("C1 · con menos de 24 horas, sin forzar, responde 409 FUERA_DE_PLAZO", () =>
+  conClub(async (api) => {
+    const r = await reservar(api, MIERCOLES_12);
+    await fijarAhora(api, "2026-12-01T20:00"); // 16 horas antes
+    const res = await cancelar(api, r.id);
+    assert.equal(res.status, 409);
+    assert.equal(res.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+    const sigue = await api.pedir("GET", `/api/reservas/${r.id}`);
+    assert.equal(sigue.cuerpo.reserva.estado, "confirmada");
+  }));
+
+test("C1 · con menos de 24 horas y forzar, la penalización es el 50 %", () =>
+  conClub(async (api) => {
+    const r = await reservar(api, MIERCOLES_12);
+    await fijarAhora(api, "2026-12-01T20:00");
+    const res = await cancelar(api, r.id, { forzar: true });
+    assert.equal(res.status, 200);
+    assert.equal(res.cuerpo.reserva.penalizacion, 900);
+    assert.equal(res.cuerpo.reembolso, 900);
+  }));
+
+test("C2 · a 48 horas justas no hay penalización", () =>
+  conClub(async (api) => {
+    const r = await reservar(api, MIERCOLES_12);
+    await fijarAhora(api, "2026-11-30T12:00");
+    const res = await cancelar(api, r.id);
+    assert.equal(res.status, 200);
+    assert.equal(res.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(res.cuerpo.reembolso, 1800);
+  }));
+
+test("C2 · a 24 horas justas se aplica el 25 % y no hace falta forzar", () =>
+  conClub(async (api) => {
+    const r = await reservar(api, MIERCOLES_12);
+    await fijarAhora(api, "2026-12-01T12:00");
+    const res = await cancelar(api, r.id);
+    assert.equal(res.status, 200);
+    assert.equal(res.cuerpo.reserva.penalizacion, 450);
+  }));
+
+test("C2 · a un minuto de las 24 horas ya es menos de 24 horas: 409 sin forzar", () =>
+  conClub(async (api) => {
+    const r = await reservar(api, MIERCOLES_12);
+    await fijarAhora(api, "2026-12-01T12:01");
+    const res = await cancelar(api, r.id);
+    assert.equal(res.status, 409);
+    assert.equal(res.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  }));
+
+test("C3 · la antelación cuenta horas reales de Madrid: 47,5 horas tras el cambio de hora dan el 25 %", () =>
+  conClub(async (api) => {
+    // Del viernes 26 de marzo de 2027 a las 20:30 al domingo 28 a las 21:00 hay 47,5 horas reales (48,5 en reloj de pared).
+    const r = await reservar(api, "2027-03-28T21:00");
+    await fijarAhora(api, "2027-03-26T20:30");
+    const res = await cancelar(api, r.id);
+    assert.equal(res.status, 200);
+    assert.equal(res.cuerpo.reserva.penalizacion, 700); // 25 % de 2.800 (domingo, punta)
+  }));
+
+test("C3 · 48 horas reales justas con cambio de hora de por medio no tienen penalización", () =>
+  conClub(async (api) => {
+    // Del viernes 20:00 al domingo 21:00 hay 48 horas reales (49 en reloj de pared).
+    const r = await reservar(api, "2027-03-28T21:00");
+    await fijarAhora(api, "2027-03-26T20:00");
+    const res = await cancelar(api, r.id);
+    assert.equal(res.status, 200);
+    assert.equal(res.cuerpo.reserva.penalizacion, undefined);
+    assert.equal(res.cuerpo.reembolso, 2800);
+  }));
+
+test("C4 · el reembolso es el importe menos la penalización", () =>
+  conClub(async (api) => {
+    const r = await reservar(api, MIERCOLES_12);
+    await fijarAhora(api, "2026-11-30T13:00");
+    const res = await cancelar(api, r.id);
+    assert.equal(res.cuerpo.reembolso, 1800 - 450);
+  }));
+
+test("C4 · sin penalización, el reembolso es el importe entero", () =>
+  conClub(async (api) => {
+    const r = await reservar(api, MIERCOLES_12);
+    await fijarAhora(api, "2026-11-29T12:00");
+    const res = await cancelar(api, r.id);
+    assert.equal(res.cuerpo.reembolso, 1800);
+  }));
+
+test("C5 · un gestor cancela sin penalización con exento y motivo, aunque falte menos de 24 horas", () =>
+  conClub(async (api) => {
+    const r = await reservar(api, MIERCOLES_12);
+    await fijarAhora(api, "2026-12-01T20:00");
+    const res = await cancelar(api, r.id, { exento: true, motivo: "Lluvia: pista inundada" }, GESTOR);
+    assert.equal(res.status, 200);
