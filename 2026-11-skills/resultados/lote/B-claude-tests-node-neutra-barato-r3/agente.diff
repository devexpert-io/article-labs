+test("C7 · el informe de un mes con histórico coincide con las reservas del estado", () =>
+  conClub(async (api) => {
+    const mes = "2026-10";
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo as {
+      pistas: { id: string }[];
+      reservas: { pistaId: string; inicio: string; estado: string; importe: number; penalizacion?: number }[];
+    };
+    const del = (pistaId: string) => {
+      const reservas = estado.reservas.filter((r) => r.pistaId === pistaId && r.inicio.startsWith(mes));
+      const cobradas = reservas.filter((r) => r.estado !== "cancelada");
+      const ingresos = cobradas.reduce((s, r) => s + r.importe, 0);
+      const penalizaciones = reservas.filter((r) => r.estado === "cancelada").reduce((s, r) => s + (r.penalizacion ?? 0), 0);
+      return { pistaId, reservas: cobradas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+    };
+    const r = await api.pedir("GET", `/api/informes/caja?mes=${mes}`, { socio: GESTOR });
+    assert.deepEqual(r.cuerpo.pistas, estado.pistas.map((p) => del(p.id)));
+    const total = r.cuerpo.pistas.reduce(
+      (t: Record<string, number>, p: Record<string, number>) => ({
+        reservas: t.reservas + p.reservas, ingresos: t.ingresos + p.ingresos,
+        penalizaciones: t.penalizaciones + p.penalizaciones, total: t.total + p.total,
+      }),
+      { reservas: 0, ingresos: 0, penalizaciones: 0, total: 0 },
+    );
+    assert.deepEqual(r.cuerpo.total, total);
+  }));
