+/** Diferencia horaria de Madrid respecto a UTC, en milisegundos, en ese instante real. */
+function desfaseMadrid(instante: number): number {
+  const p = Object.fromEntries(formatoMadrid.formatToParts(new Date(instante)).map((x) => [x.type, x.value]));
+  const comoUtc = Date.UTC(Number(p.year), Number(p.month) - 1, Number(p.day), Number(p.hour), Number(p.minute), Number(p.second));
