+
+async function crear(api: Api, inicio = "2027-01-20T12:00", pistaId = "pista-1") {
+  const respuesta = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: "socio-041", pistaId, inicio },
+  });
+  assert.equal(respuesta.status, 201);
+  return respuesta.cuerpo.reserva;
+}
+
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+
+for (const caso of [
+  { ahora: "2027-01-18T11:59", porcentaje: 0 },
+  { ahora: "2027-01-18T12:00", porcentaje: 0 },
+  { ahora: "2027-01-18T12:01", porcentaje: 0.25 },
+  { ahora: "2027-01-19T11:59", porcentaje: 0.25 },
+  { ahora: "2027-01-19T12:00", porcentaje: 0.25 },
+  { ahora: "2027-01-19T12:01", porcentaje: 0.5 },
+]) {
+  test(`tramo y reembolso al cancelar desde ${caso.ahora}`, async () => {
+    const api = await arrancarApi();
+    try {
+      const reserva = await crear(api);
+      assert.equal(reserva.importe, 1800);
+      await reloj(api, caso.ahora);
+      const ruta = `/api/reservas/${reserva.id}/cancelar`;
+      if (caso.porcentaje === 0.5) {
