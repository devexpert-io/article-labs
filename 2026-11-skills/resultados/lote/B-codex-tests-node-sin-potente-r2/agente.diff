+function instanteMadrid(fecha: string): number {
+  const local = Date.parse(`${fecha}:00Z`);
+  let instante = local;
+  for (let i = 0; i < 3; i++) {
+    const zona = zonaMadrid.formatToParts(instante).find((p) => p.type === "timeZoneName")!.value;
