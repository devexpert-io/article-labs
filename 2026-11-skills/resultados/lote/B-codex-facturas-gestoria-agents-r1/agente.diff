@@ -0,0 +1,156 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+import type { Estado, Factura } from "../src/tipos.ts";
+
+const gestor = "socio-040";
+const generar = (api: Api, mes: unknown) => api.pedir("POST", "/api/facturas", { socio: gestor, cuerpo: { mes } });
+async function reloj(api: Api, ahora: string) {
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+}
+async function reservar(api: Api, inicio: string, socioId = "socio-041") {
+  const respuesta = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId: "pista-1", inicio } });
+  assert.equal(respuesta.status, 201, respuesta.texto);
+  return respuesta.cuerpo.reserva;
+}
+
+test("solo el gestor puede generar y consultar facturas", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const [metodo, ruta] of [
+    ["POST", "/api/facturas"], ["GET", "/api/facturas?mes=2026-10"], ["GET", "/api/facturas/F2026-0001"],
+  ]) {
+    for (const socio of [undefined, "socio-999", "socio-001"]) {
+      const r = await api.pedir(metodo!, ruta!, { socio, cuerpo: metodo === "POST" ? { mes: "2026-10" } : undefined });
+      assert.equal(r.status, socio === "socio-001" ? 403 : 401);
+      assert.equal(r.cuerpo.error.codigo, socio === "socio-001" ? "SIN_PERMISO" : "NO_IDENTIFICADO");
+    }
+  }
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.facturasPorMes, {});
+});
+
+test("valida el mes y solo genera meses cerrados según el reloj del club", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  for (const mes of [undefined, null, 202610, {}, "", "2026-1", "26-10", "2026-00", "2026-13", "2026-10-01", " 2026-10"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const ruta of ["/api/facturas", "/api/facturas?mes=2026-13", "/api/facturas?mes=2026-1"]) {
+    const r = await api.pedir("GET", ruta, { socio: gestor });
+    assert.equal(r.status, 400);
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await generar(api, mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+  await reloj(api, "2026-11-30T23:59");
+  assert.equal((await generar(api, "2026-11")).status, 409);
+  await reloj(api, "2026-12-01T00:00");
+  assert.equal((await generar(api, "2026-11")).status, 201);
+});
+
+test("octubre: una factura por socio, líneas cronológicas, ausencias, IVA y consultas", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const estado: Estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const pendientes = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor });
+  assert.equal(pendientes.status, 200);
+  assert.deepEqual(pendientes.cuerpo, { facturas: [] });
+  const r = await generar(api, "2026-10");
+  assert.equal(r.status, 201);
+  const facturables = estado.reservas.filter((r) => r.inicio.startsWith("2026-10") && r.estado !== "cancelada");
+  assert.ok(facturables.some((r) => r.estado === "no_presentada"));
+  const socios = [...new Set(facturables.map((r) => r.socioId))].sort();
+  const esperadas: Factura[] = socios.map((socioId, i) => {
+    const lineas = facturables.filter((r) => r.socioId === socioId).sort((a, b) => a.inicio.localeCompare(b.inicio))
+      .map((r) => ({ reservaId: r.id, concepto: "Reserva" as const, importe: r.importe }));
+    const total = lineas.reduce((suma, l) => suma + l.importe, 0);
+    const base = Math.round(total * 100 / 121);
+    return { numero: `F2026-${String(i + 1).padStart(4, "0")}`, mes: "2026-10", socioId, lineas, total, base, iva: total - base };
+  });
+  assert.deepEqual(r.cuerpo, { facturas: esperadas });
+  assert.ok(!r.cuerpo.facturas.some((f: Factura) => f.socioId === "socio-041"));
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: gestor })).cuerpo, r.cuerpo);
+  for (const factura of esperadas) {
+    const consulta = await api.pedir("GET", `/api/facturas/${factura.numero}`, { socio: gestor });
+    assert.equal(consulta.status, 200);
+    assert.deepEqual(consulta.cuerpo, { factura });
+  }
+  const ausente = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: gestor });
+  assert.equal(ausente.status, 404);
+  assert.equal(ausente.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.reservas, estado.reservas);
+});
+
+test("calcula el IVA sobre 6400 céntimos: base 5289 e IVA 1111", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const punta = await reservar(api, "2026-12-03T18:00");
+  const valle1 = await reservar(api, "2026-12-01T09:00");
+  const valle2 = await reservar(api, "2026-12-02T09:00");
+  await reloj(api, "2027-01-01T00:00");
+  const r = await generar(api, "2026-12");
+  assert.equal(r.status, 201);
+  assert.deepEqual(r.cuerpo.facturas, [{
+    numero: "F2026-0001", mes: "2026-12", socioId: "socio-041",
+    lineas: [valle1, valle2, punta].map((r) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe })),
+    total: 6400, base: 5289, iva: 1111,
+  }]);
+});
+
+test("factura Penalización y excluye cancelaciones gratuitas por el mes de inicio", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  const gratis = await reservar(api, "2026-12-01T09:00");
+  const penalizada = await reservar(api, "2026-12-01T10:30");
+  const enero = await reservar(api, "2027-01-01T09:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`)).status, 200);
+  await reloj(api, "2026-11-30T12:00");
+  const cancelada = await api.pedir("POST", `/api/reservas/${penalizada.id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(cancelada.status, 200);
+  assert.equal(cancelada.cuerpo.reserva.penalizacion, 1800);
+  await reloj(api, "2027-01-01T00:00");
+  const diciembre = await generar(api, "2026-12");
+  assert.equal(diciembre.status, 201);
+  assert.deepEqual(diciembre.cuerpo.facturas[0].lineas, [{ reservaId: penalizada.id, concepto: "Penalización", importe: 1800 }]);
+  assert.equal(diciembre.cuerpo.facturas[0].total, 1800);
+  await reloj(api, "2027-02-01T00:00");
+  const siguiente = await generar(api, "2027-01");
+  assert.deepEqual(siguiente.cuerpo.facturas[0].lineas, [{ reservaId: enero.id, concepto: "Reserva", importe: 1800 }]);
+});
+
+test("numeración anual, meses fuera de orden, meses vacíos y generación repetida", async (t) => {
+  const api = await arrancarApi();
+  t.after(() => api.cerrar());
+  await reservar(api, "2026-12-01T09:00");
+  await reservar(api, "2026-12-02T09:00", "socio-002");
+  const vacio = await generar(api, "2026-09");
+  assert.equal(vacio.status, 201);
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  assert.equal((await generar(api, "2026-09")).status, 200);
+  await reloj(api, "2027-01-01T00:00");
+  const diciembre = await generar(api, "2026-12");
+  assert.deepEqual(diciembre.cuerpo.facturas.map((f: Factura) => [f.socioId, f.numero]), [
+    ["socio-002", "F2026-0001"], ["socio-041", "F2026-0002"],
+  ]);
+  const octubre = await generar(api, "2026-10");
+  assert.equal(octubre.cuerpo.facturas[0].numero, "F2026-0003");
+  const repetidas = await Promise.all([generar(api, "2026-12"), generar(api, "2026-12")]);
+  for (const repetida of repetidas) {
+    assert.equal(repetida.status, 200);
+    assert.deepEqual(repetida.cuerpo, diciembre.cuerpo);
+  }
+  const noviembre = await generar(api, "2026-11");
+  const todas = [...diciembre.cuerpo.facturas, ...octubre.cuerpo.facturas, ...noviembre.cuerpo.facturas];
+  assert.deepEqual(todas.map((f: Factura) => f.numero), todas.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+  await reservar(api, "2027-01-04T09:00");
+  await reloj(api, "2027-02-01T00:00");
+  const enero = await generar(api, "2027-01");
+  assert.equal(enero.status, 201);
+  assert.equal(enero.cuerpo.facturas[0].numero, "F2027-0001");
+  assert.deepEqual((await generar(api, "2026-12")).cuerpo, diciembre.cuerpo);
+});
