+/** Diferencia, en milisegundos, entre la hora de pared de Madrid en ese instante y UTC. */
+function desplazamientoMadrid(instante: number): number {
+  const partes = Object.fromEntries(FORMATO_MADRID.formatToParts(new Date(instante)).map((p) => [p.type, Number(p.value)]));
