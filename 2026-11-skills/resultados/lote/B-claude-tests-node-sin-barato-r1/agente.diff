+
+/** Instante real (en ms) de una hora local de Madrid `AAAA-MM-DDTHH:MM`, con el cambio de hora. */
+function instanteMadrid(local: string): number {
+  const comoUtc = Date.parse(`${local}:00Z`);
+  const primero = comoUtc - desplazamientoMadrid(comoUtc);
+  return comoUtc - desplazamientoMadrid(primero);
