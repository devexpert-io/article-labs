@@ -0,0 +1,211 @@
+// Política de cancelación escalonada, exención de la penalización por un gestor e informe de caja.
+import assert from "node:assert/strict";
+import { after, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+// Miércoles 25 de noviembre a las 12:00 en pista-1: franja de valle, 1800 céntimos.
+const INICIO = "2026-11-25T12:00";
+const IMPORTE_VALLE = 1800;
+const GESTOR = "socio-040";
+const SOCIO = "socio-003";
+
+const apis: Api[] = [];
+after(() => {
+  for (const api of apis) api.cerrar();
+});
+
+/** Arranca la API, crea una reserva con la hora por defecto del club y luego mueve el reloj a `ahora`. */
+async function escenario(ahora: string, reserva: { socio?: string; pista?: string; inicio?: string } = {}) {
+  const api = await arrancarApi();
+  apis.push(api);
+  const creada = await api.pedir("POST", "/api/reservas", {
+    cuerpo: { socioId: reserva.socio ?? SOCIO, pistaId: reserva.pista ?? "pista-1", inicio: reserva.inicio ?? INICIO },
+  });
+  assert.equal(creada.status, 201, creada.texto);
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+  return { api, id: creada.cuerpo.reserva.id as string };
+}
+
+test("tramos: 49 horas antes no penaliza", async () => {
+  const { api, id } = await escenario("2026-11-23T11:00");
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { socio: SOCIO });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, IMPORTE_VALLE);
+});
+
+test("límite: 48 horas justas no penalizan", async () => {
+  const { api, id } = await escenario("2026-11-23T12:00");
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { socio: SOCIO });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, IMPORTE_VALLE);
+});
+
+test("tramos: 47 horas y 59 minutos penalizan el 25 % sin forzar", async () => {
+  const { api, id } = await escenario("2026-11-23T12:01");
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 450);
+  assert.equal(r.cuerpo.reembolso, IMPORTE_VALLE - 450);
+});
+
+test("límite: 24 horas justas penalizan el 25 % y no hace falta forzar", async () => {
+  const { api, id } = await escenario("2026-11-24T12:00");
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 450);
+  assert.equal(r.cuerpo.reembolso, 1350);
+});
+
+test("tramos: menos de 24 horas sin forzar es FUERA_DE_PLAZO; con forzar, el 50 %", async () => {
+  const { api, id } = await escenario("2026-11-24T12:01");
+  const sin = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(sin.status, 409);
+  assert.equal(sin.cuerpo.error.codigo, "FUERA_DE_PLAZO");
+  const con = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(con.status, 200);
+  assert.equal(con.cuerpo.reserva.penalizacion, 900);
+  assert.equal(con.cuerpo.reembolso, 900);
+});
+
+test("forzar no sube la penalización: a 30 horas sigue siendo el 25 %", async () => {
+  const { api, id } = await escenario("2026-11-24T06:00");
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { cuerpo: { forzar: true } });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 450);
+});
+
+test("cambio de hora: 47,5 horas reales son el 25 %, aunque en el reloj de pared pasen 48,5", async () => {
+  // Viernes 26 de marzo de 2027 a las 20:30 hasta domingo 28 a las 21:00: el cambio de hora quita una hora.
+  const { api, id } = await escenario("2027-03-26T20:30", { inicio: "2027-03-28T21:00" });
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, 700);
+  assert.equal(r.cuerpo.reembolso, 2800 - 700);
+});
+
+test("cambio de hora: 48 horas reales justas no penalizan", async () => {
+  const { api, id } = await escenario("2027-03-26T20:00", { inicio: "2027-03-28T21:00" });
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`);
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reembolso, 2800);
+});
+
+test("una reserva cancelada conserva su penalización aunque el reloj cambie", async () => {
+  const { api, id } = await escenario("2026-11-24T12:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${id}/cancelar`)).status, 200);
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-18T10:00" } })).status, 200);
+  const reserva = await api.pedir("GET", `/api/reservas/${id}`);
+  assert.equal(reserva.cuerpo.reserva.penalizacion, 450);
+});
+
+test("exención: un gestor cancela sin penalización a menos de 24 horas, con motivo", async () => {
+  const { api, id } = await escenario("2026-11-24T12:01");
+  const motivo = "Lluvia: la pista no se puede usar";
+  const r = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { socio: GESTOR, cuerpo: { exento: true, motivo } });
+  assert.equal(r.status, 200);
+  assert.equal(r.cuerpo.reserva.estado, "cancelada");
+  assert.equal(r.cuerpo.reserva.penalizacion, undefined);
+  assert.equal(r.cuerpo.reserva.motivoCancelacion, motivo);
+  assert.equal(r.cuerpo.reembolso, IMPORTE_VALLE);
+});
+
+test("exención: el motivo debe tener al menos 10 caracteres", async () => {
+  const { api, id } = await escenario("2026-11-24T12:01");
+  const sinMotivo = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { socio: GESTOR, cuerpo: { exento: true } });
+  assert.equal(sinMotivo.status, 400);
+  assert.equal(sinMotivo.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  const corto = await api.pedir("POST", `/api/reservas/${id}/cancelar`, { socio: GESTOR, cuerpo: { exento: true, motivo: "   Nueve     " } });
+  assert.equal(corto.status, 400);
