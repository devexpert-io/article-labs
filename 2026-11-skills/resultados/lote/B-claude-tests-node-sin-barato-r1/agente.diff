+test("el informe de caja suma por pista las reservas, los ingresos y las penalizaciones del mes", async () => {
+  const { api } = await escenario("2026-11-18T10:00");
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const delMes = estado.reservas.filter((r: { inicio: string }) => r.inicio.startsWith("2026-11-"));
+  const resumen = (reservas: any[]) => {
+    const activas = reservas.filter((r) => r.estado !== "cancelada");
+    const ingresos = activas.reduce((s, r) => s + r.importe, 0);
+    const penalizaciones = reservas.reduce((s, r) => s + (r.penalizacion ?? 0), 0);
+    return { reservas: activas.length, ingresos, penalizaciones, total: ingresos + penalizaciones };
+  };
+  const informe = await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR });
+  assert.equal(informe.status, 200);
+  assert.equal(informe.cuerpo.mes, "2026-11");
+  assert.deepEqual(
+    informe.cuerpo.pistas,
+    estado.pistas.map((p: { id: string }) => ({ pistaId: p.id, ...resumen(delMes.filter((r: { pistaId: string }) => r.pistaId === p.id)) })),
+  );
+  assert.deepEqual(informe.cuerpo.total, resumen(delMes));
+});
+
+test("el informe de caja recoge la penalización de una cancelación y deja de contar la reserva", async () => {
+  const { api, id } = await escenario("2026-11-18T10:00");
+  const antes = (await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR })).cuerpo;
+  assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora: "2026-11-24T12:00" } })).status, 200);
+  assert.equal((await api.pedir("POST", `/api/reservas/${id}/cancelar`)).status, 200);
+  const despues = (await api.pedir("GET", "/api/informes/caja?mes=2026-11", { socio: GESTOR })).cuerpo;
+  const pista = (informe: any) => informe.pistas.find((p: { pistaId: string }) => p.pistaId === "pista-1");
+  assert.equal(pista(despues).reservas, pista(antes).reservas - 1);
+  assert.equal(pista(despues).ingresos, pista(antes).ingresos - IMPORTE_VALLE);
+  assert.equal(pista(despues).penalizaciones, pista(antes).penalizaciones + 450);
+  assert.equal(despues.total.total, despues.total.ingresos + despues.total.penalizaciones);
+  assert.equal(despues.total.penalizaciones, antes.total.penalizaciones + 450);
+});
