@@ -0,0 +1,167 @@
+// Facturas mensuales (docs/specs/facturas.md), probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+test("solo un gestor genera y consulta facturas", async () => {
+  const rutas: [string, string, unknown?][] = [
+    ["POST", "/api/facturas", { mes: "2026-10" }],
+    ["GET", "/api/facturas?mes=2026-10"],
+    ["GET", "/api/facturas/F2026-0001"],
+  ];
+  for (const [metodo, ruta, cuerpo] of rutas) {
+    const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+    assert.equal(anonimo.status, 401, `${metodo} ${ruta}`);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-001" });
+    assert.equal(socio.status, 403, `${metodo} ${ruta}`);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  assert.equal(estado.facturas.length, 0, "sin permiso no se genera nada");
+});
+
+test("mes con formato AAAA-MM y ya terminado", async () => {
+  for (const mes of [undefined, "2026-13", "2026-1", "2026-10-01", 202610]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=octubre", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12", "2027-01"]) {
+    const r = await api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio: GESTOR });
+    assert.equal(r.status, 409, mes);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+});
+
+test("octubre de 2026: una factura por socio con lo facturable, numerada y con el IVA sobre el total", async () => {
+  const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+  const octubre = estado.reservas
+    .filter((r: any) => r.inicio.startsWith("2026-10"))
+    .sort((a: any, b: any) => a.inicio.localeCompare(b.inicio) || a.id.localeCompare(b.id));
+  assert.ok(octubre.some((r: any) => r.estado === "cancelada"), "el historial tiene cancelaciones sin penalización");
+  assert.ok(octubre.some((r: any) => r.estado === "no_presentada"), "el historial tiene no presentadas");
+  const facturables = octubre.filter((r: any) => r.estado !== "cancelada");
+  const esperadosSocios = [...new Set(facturables.map((r: any) => r.socioId))].sort();
+
+  const generada = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(generada.status, 201);
+  const facturas = generada.cuerpo.facturas;
+  assert.deepEqual(facturas.map((f: any) => f.socioId), esperadosSocios);
+  facturas.forEach((f: any, i: number) => {
+    assert.equal(f.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+    assert.equal(f.mes, "2026-10");
+    const esperadas = facturables.filter((r: any) => r.socioId === f.socioId)
+      .map((r: any) => ({ reservaId: r.id, concepto: "Reserva", importe: r.importe }));
+    assert.deepEqual(f.lineas, esperadas);
+    const total = esperadas.reduce((s: number, l: any) => s + l.importe, 0);
+    assert.equal(f.total, total);
+    assert.equal(f.base, Math.round((total * 100) / 121));
+    assert.equal(f.base + f.iva, f.total);
+  });
+  const sinFactura = estado.socios.map((s: any) => s.id).filter((id: string) => !esperadosSocios.includes(id));
+  assert.ok(sinFactura.includes("socio-041"));
+
+  // Generar dos veces: las mismas facturas, sin gastar números.
+  const otraVez = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+  assert.equal(otraVez.status, 200);
+  assert.deepEqual(otraVez.cuerpo.facturas, facturas);
+  assert.equal((await api.pedir("GET", "/_estado")).cuerpo.facturas.length, facturas.length);
+
+  // Consultar.
+  const lista = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(lista.status, 200);
+  assert.deepEqual(lista.cuerpo.facturas, facturas);
+  assert.deepEqual((await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR })).cuerpo, { facturas: [] });
+  const una = await api.pedir("GET", `/api/facturas/${facturas[2].numero}`, { socio: GESTOR });
+  assert.equal(una.status, 200);
+  assert.deepEqual(una.cuerpo.factura, facturas[2]);
+  const ninguna = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+  assert.equal(ninguna.status, 404);
+  assert.equal(ninguna.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("penalizaciones, redondeo del IVA y numeración entre meses y entre años", async () => {
+  const otra = await arrancarApi();
+  try {
+    const pedir = (metodo: string, ruta: string, cuerpo?: unknown) => otra.pedir(metodo, ruta, { cuerpo, socio: GESTOR });
+    // Noviembre: Marta cancela fuera de plazo (penalización) y socio-003 cancela gratis.
+    const penalizada = await pedir("POST", "/api/reservas/R-0520/cancelar", { forzar: true });
+    assert.equal(penalizada.cuerpo.reserva.penalizacion, 1200);
+    const gratis = await pedir("POST", "/api/reservas", { socioId: "socio-003", pistaId: "pista-3", inicio: "2026-11-24T12:00" });
+    const idGratis = gratis.cuerpo.reserva.id;
+    assert.equal((await pedir("POST", `/api/reservas/${idGratis}/cancelar`)).status, 200);
+    // Diciembre: Nora reserva 1.800 + 1.800 + 2.800 = 6.400 (base 5.289 sobre el total; línea a línea saldría 5.290).
+    for (const hora of ["09:00", "12:00", "18:00"]) {
+      const r = await pedir("POST", "/api/reservas", { socioId: "socio-041", pistaId: "pista-1", inicio: `2026-12-01T${hora}` });
+      assert.equal(r.status, 201);
+    }
+
+    await pedir("POST", "/_reloj", { ahora: "2026-11-30T23:59" });
+    assert.equal((await pedir("POST", "/api/facturas", { mes: "2026-11" })).cuerpo.error.codigo, "MES_ABIERTO");
+    await pedir("POST", "/_reloj", { ahora: "2026-12-01T00:00" });
+    const octubre = (await pedir("POST", "/api/facturas", { mes: "2026-10" })).cuerpo.facturas;
+    const n = octubre.length;
+
+    // Diciembre, generado en enero de 2027 y antes que noviembre: sigue la serie de 2026.
+    await pedir("POST", "/_reloj", { ahora: "2027-01-05T10:00" });
+    const diciembre = await pedir("POST", "/api/facturas", { mes: "2026-12" });
+    assert.equal(diciembre.status, 201);
+    assert.deepEqual(diciembre.cuerpo.facturas, [{
+      numero: `F2026-${String(n + 1).padStart(4, "0")}`,
+      mes: "2026-12",
+      socioId: "socio-041",
+      lineas: [
+        { reservaId: diciembre.cuerpo.facturas[0].lineas[0].reservaId, concepto: "Reserva", importe: 1800 },
+        { reservaId: diciembre.cuerpo.facturas[0].lineas[1].reservaId, concepto: "Reserva", importe: 1800 },
+        { reservaId: diciembre.cuerpo.facturas[0].lineas[2].reservaId, concepto: "Reserva", importe: 2800 },
+      ],
+      total: 6400,
+      base: 5289,
+      iva: 1111,
+    }]);
+
+    // Noviembre después: sigue donde lo dejó diciembre.
+    const noviembre = (await pedir("POST", "/api/facturas", { mes: "2026-11" })).cuerpo.facturas;
+    noviembre.forEach((f: any, i: number) => assert.equal(f.numero, `F2026-${String(n + 2 + i).padStart(4, "0")}`));
+    const marta = noviembre.find((f: any) => f.socioId === "socio-002");
+    assert.deepEqual(marta.lineas.find((l: any) => l.reservaId === "R-0520"), { reservaId: "R-0520", concepto: "Penalización", importe: 1200 });
+    assert.ok(!noviembre.some((f: any) => f.lineas.some((l: any) => l.reservaId === idGratis)), "la cancelación gratuita no se factura");
+    for (const f of noviembre) {
+      const inicios = f.lineas.map((l: any) => l.reservaId);
+      assert.equal(new Set(inicios).size, inicios.length);
+    }
+
+    // 2027: serie nueva desde 0001. Un mes sin facturas no gasta números.
