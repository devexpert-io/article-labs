+function instanteMadrid(fechaHora: string): number {
+  const [fecha, hora] = fechaHora.split("T");
+  const [anio, mes, dia] = fecha!.split("-").map(Number);
+  const [hh, mm] = hora!.split(":").map(Number);
+  const local = Date.UTC(anio!, mes! - 1, dia!, hh!, mm!);
+  const formato = new Intl.DateTimeFormat("en-GB", { timeZone: "Europe/Madrid", timeZoneName: "longOffset", year: "numeric" });
+  const offset = formato.formatToParts(new Date(local)).find((p) => p.type === "timeZoneName")!.value;
+  const match = /GMT([+-])(\d{2}):(\d{2})/.exec(offset);
+  const minutos = match ? (Number(match[2]) * 60 + Number(match[3])) * (match[1] === "+" ? 1 : -1) : 0;
+  return local - minutos * 60_000;
+}
+
 function invalido(mensaje: string): never {
   throw new ErrorDelClub("DATOS_INVALIDOS", mensaje, 400);
 }
