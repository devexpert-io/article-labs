+// Las facturas mensuales de la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+
+async function conApi(ahora: string, fn: (api: Api) => Promise<void>): Promise<void> {
+  const api = await arrancarApi({ AHORA: ahora });
+  try {
+    await fn(api);
+  } finally {
+    api.cerrar();
+  }
+}
+
+test("solo un gestor puede generar y consultar facturas", async () => {
+  await conApi("2026-11-18T10:00", async (api) => {
+    const sin = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" } });
+    assert.equal(sin.status, 401);
+    assert.equal(sin.cuerpo.error.codigo, "NO_IDENTIFICADO");
+
+    const noGestor = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: "socio-001" });
+    assert.equal(noGestor.status, 403);
+    assert.equal(noGestor.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const consulta = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: "socio-001" });
+    assert.equal(consulta.status, 403);
+    assert.equal(consulta.cuerpo.error.codigo, "SIN_PERMISO");
+
+    const detalle = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: "socio-001" });
+    assert.equal(detalle.status, 403);
+
+    const ok = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(ok.status, 201);
+    assert.ok(Array.isArray(ok.cuerpo.facturas));
+  });
+});
+
+test("el mes debe tener formato AAAA-MM y estar cerrado", async () => {
+  await conApi("2026-11-18T10:00", async (api) => {
+    const mal = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10-01" }, socio: GESTOR });
+    assert.equal(mal.status, 400);
+    assert.equal(mal.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const mesInexistente = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-13" }, socio: GESTOR });
+    assert.equal(mesInexistente.status, 400);
+    assert.equal(mesInexistente.cuerpo.error.codigo, "DATOS_INVALIDOS");
+
+    const abierto = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    assert.equal(abierto.status, 409);
+    assert.equal(abierto.cuerpo.error.codigo, "MES_ABIERTO");
+
+    const futuro = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2027-01" }, socio: GESTOR });
+    assert.equal(futuro.status, 409);
+    assert.equal(futuro.cuerpo.error.codigo, "MES_ABIERTO");
+  });
+});
+
+test("octubre: las líneas cuadran con las reservas facturables, ordenadas y con IVA", async () => {
+  await conApi("2026-11-18T10:00", async (api) => {
+    const estado = (await api.pedir("GET", "/_estado")).cuerpo;
+    const generada = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    assert.equal(generada.status, 201);
+    const facturas: any[] = generada.cuerpo.facturas;
+    assert.ok(facturas.length > 0);
+
+    // Ordenadas por id de socio.
+    const ids = facturas.map((f) => f.socioId);
+    assert.deepEqual(ids, [...ids].sort((a: string, b: string) => a.localeCompare(b)));
+
+    const reservasOctubre = estado.reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+    const facturable = (r: any) =>
+      r.estado === "confirmada" || r.estado === "no_presentada" || (r.estado === "cancelada" && (r.penalizacion ?? 0) > 0);
+
+    // Una factura por socio con algo que facturar, y ninguna para los demás.
+    const sociosConAlgo = new Set(reservasOctubre.filter(facturable).map((r: any) => r.socioId));
+    assert.deepEqual([...new Set(facturas.map((f) => f.socioId))].sort(), [...sociosConAlgo].sort());
+
+    for (let i = 0; i < facturas.length; i++) {
+      const factura = facturas[i];
+      assert.equal(factura.mes, "2026-10");
+      assert.equal(factura.numero, `F2026-${String(i + 1).padStart(4, "0")}`);
+
+      const esperadas = reservasOctubre
+        .filter((r: any) => r.socioId === factura.socioId && facturable(r))
+        .sort((a: any, b: any) => (a.inicio === b.inicio ? a.id.localeCompare(b.id) : a.inicio.localeCompare(b.inicio)));
+
+      assert.equal(factura.lineas.length, esperadas.length);
+      for (let j = 0; j < esperadas.length; j++) {
+        const reserva = esperadas[j];
+        const linea = factura.lineas[j];
+        assert.equal(linea.reservaId, reserva.id);
+        assert.equal(linea.concepto, reserva.estado === "cancelada" ? "Penalización" : "Reserva");
+        assert.equal(linea.importe, reserva.estado === "cancelada" ? reserva.penalizacion : reserva.importe);
+      }
+
+      const total = factura.lineas.reduce((s: number, l: any) => s + l.importe, 0);
+      assert.equal(factura.total, total);
+      assert.equal(factura.base, Math.round((total * 100) / 121));
+      assert.equal(factura.iva, total - factura.base);
+      assert.equal(factura.base + factura.iva, total);
+    }
+  });
+});
+
