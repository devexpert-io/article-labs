+    assert.equal(dic.cuerpo.facturas.length, 0);
+
+    const nov = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-11" }, socio: GESTOR });
+    const novFacturas: any[] = nov.cuerpo.facturas;
+    assert.ok(novFacturas.length > 0);
+    assert.equal(novFacturas[0].numero, "F2026-0001");
+
+    // Octubre se genera después, pero sigue donde lo dejó noviembre.
+    const oct = await api.pedir("POST", "/api/facturas", { cuerpo: { mes: "2026-10" }, socio: GESTOR });
+    const octFacturas: any[] = oct.cuerpo.facturas;
+    assert.ok(octFacturas.length > 0);
+
+    const maxNov = Math.max(...novFacturas.map((f) => Number(f.numero.slice(6))));
+    const minOct = Math.min(...octFacturas.map((f) => Number(f.numero.slice(6))));
+    assert.equal(minOct, maxNov + 1);
+
+    const todos = [...novFacturas, ...octFacturas].map((f) => f.numero);
+    assert.equal(new Set(todos).size, todos.length, "no debe haber números repetidos");
+  });
+});
