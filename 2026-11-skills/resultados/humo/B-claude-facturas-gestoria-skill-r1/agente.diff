@@ -0,0 +1,154 @@
+// Facturas mensuales por socio, con las reglas de la gestoría, probadas a través de la API.
+import assert from "node:assert/strict";
+import { after, before, test } from "node:test";
+import { arrancarApi, type Api } from "./ayuda.ts";
+
+const GESTOR = "socio-040";
+let api: Api;
+before(async () => {
+  api = await arrancarApi();
+});
+after(() => api.cerrar());
+
+const generar = (mes: unknown, socio: string | undefined = GESTOR) => api.pedir("POST", "/api/facturas", { cuerpo: { mes }, socio });
+const reloj = async (ahora: string) => assert.equal((await api.pedir("POST", "/_reloj", { cuerpo: { ahora } })).status, 200);
+const reservar = async (socioId: string, pistaId: string, inicio: string) => {
+  const r = await api.pedir("POST", "/api/reservas", { cuerpo: { socioId, pistaId, inicio } });
+  assert.equal(r.status, 201, JSON.stringify(r.cuerpo));
+  return r.cuerpo.reserva;
+};
+
+// Los tests de este fichero comparten la API y van en orden: cada uno parte de lo que dejó el anterior.
+
+test("permisos: sin X-Socio 401 y con un socio que no es gestor 403", async () => {
+  for (const [metodo, ruta, cuerpo] of [
+    ["POST", "/api/facturas", { mes: "2026-10" }],
+    ["GET", "/api/facturas?mes=2026-10", undefined],
+    ["GET", "/api/facturas/F2026-0001", undefined],
+  ] as const) {
+    const anonimo = await api.pedir(metodo, ruta, { cuerpo });
+    assert.equal(anonimo.status, 401);
+    assert.equal(anonimo.cuerpo.error.codigo, "NO_IDENTIFICADO");
+    const socio = await api.pedir(metodo, ruta, { cuerpo, socio: "socio-004" });
+    assert.equal(socio.status, 403);
+    assert.equal(socio.cuerpo.error.codigo, "SIN_PERMISO");
+  }
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.facturas, [], "no se ha generado nada");
+});
+
+test("mes: formato AAAA-MM y solo meses cerrados", async () => {
+  for (const mes of ["2026-13", "2026-1", "octubre", 202610, undefined]) {
+    const r = await generar(mes);
+    assert.equal(r.status, 400, String(mes));
+    assert.equal(r.cuerpo.error.codigo, "DATOS_INVALIDOS");
+  }
+  assert.equal((await api.pedir("GET", "/api/facturas?mes=2026/10", { socio: GESTOR })).cuerpo.error.codigo, "DATOS_INVALIDOS");
+  for (const mes of ["2026-11", "2026-12"]) {
+    const r = await generar(mes);
+    assert.equal(r.status, 409);
+    assert.equal(r.cuerpo.error.codigo, "MES_ABIERTO");
+  }
+});
+
+test("octubre de 2026: una factura por socio, líneas, total, IVA y numeración", async () => {
+  const reservas = (await api.pedir("GET", "/_estado")).cuerpo.reservas.filter((r: any) => r.inicio.startsWith("2026-10"));
+  const facturables = reservas.filter((r: any) => r.estado !== "cancelada");
+  const socios = [...new Set(facturables.map((r: any) => r.socioId))].sort();
+
+  const r = await generar("2026-10");
+  assert.equal(r.status, 201);
+  const { facturas } = r.cuerpo;
+  assert.deepEqual(facturas.map((f: any) => f.socioId), socios, "una por socio con algo que facturar, por id de socio");
+  assert.deepEqual(facturas.map((f: any) => f.numero), socios.map((_, i) => `F2026-${String(i + 1).padStart(4, "0")}`));
+  for (const f of facturas) {
+    assert.equal(f.mes, "2026-10");
+    const suyas = facturables.filter((x: any) => x.socioId === f.socioId);
+    assert.deepEqual(f.lineas, suyas.map((x: any) => ({ reservaId: x.id, concepto: "Reserva", importe: x.importe })));
+    assert.ok(f.lineas.every((l: any, i: number) => i === 0 || suyas[i - 1].inicio <= suyas[i].inicio));
+    assert.equal(f.total, f.lineas.reduce((s: number, l: any) => s + l.importe, 0));
+    assert.equal(f.base, Math.round((f.total * 100) / 121));
+    assert.equal(f.base + f.iva, f.total);
+  }
+  // Las no presentadas se facturan; las canceladas sin penalización, no.
+  const noPresentada = reservas.find((x: any) => x.estado === "no_presentada");
+  const cancelada = reservas.find((x: any) => x.estado === "cancelada");
+  const lineas = facturas.flatMap((f: any) => f.lineas.map((l: any) => l.reservaId));
+  assert.ok(lineas.includes(noPresentada.id));
+  assert.ok(!lineas.includes(cancelada.id));
+});
+
+test("generar dos veces devuelve las mismas facturas y no crea ninguna", async () => {
+  const antes = (await api.pedir("GET", "/_estado")).cuerpo.facturas;
+  const otra = await generar("2026-10");
+  assert.equal(otra.status, 200);
+  assert.deepEqual(otra.cuerpo.facturas, antes);
+  assert.deepEqual((await api.pedir("GET", "/_estado")).cuerpo.facturas, antes);
+});
+
+test("consultar facturas por mes y por número", async () => {
+  const octubre = await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR });
+  assert.equal(octubre.status, 200);
+  assert.ok(octubre.cuerpo.facturas.length > 0);
+  const vacio = await api.pedir("GET", "/api/facturas?mes=2026-09", { socio: GESTOR });
+  assert.deepEqual(vacio.cuerpo, { facturas: [] });
+  const una = await api.pedir("GET", "/api/facturas/F2026-0001", { socio: GESTOR });
+  assert.deepEqual(una.cuerpo, { factura: octubre.cuerpo.facturas[0] });
+  const falta = await api.pedir("GET", "/api/facturas/F2026-9999", { socio: GESTOR });
+  assert.equal(falta.status, 404);
+  assert.equal(falta.cuerpo.error.codigo, "FACTURA_NO_ENCONTRADA");
+});
+
+test("penalizaciones, redondeo del IVA sobre el total y numeración entre meses y años", async () => {
+  const octubre = (await api.pedir("GET", "/api/facturas?mes=2026-10", { socio: GESTOR })).cuerpo.facturas.length;
+
+  // Noviembre: Marta cancela fuera de plazo (penalización) y socio-003 cancela gratis.
+  const penalizada = await api.pedir("POST", "/api/reservas/R-0520/cancelar", { cuerpo: { forzar: true } });
+  assert.equal(penalizada.cuerpo.reserva.penalizacion, 1200);
+  const gratis = await reservar("socio-003", "pista-3", "2026-11-24T12:00");
+  assert.equal((await api.pedir("POST", `/api/reservas/${gratis.id}/cancelar`)).cuerpo.reserva.penalizacion, undefined);
+
+  // Diciembre: Nora (socio-041, sin reservas) juega 1.800 + 1.800 + 2.800 = 6.400.
+  await reloj("2026-11-25T10:00");
+  const nora = [
+    await reservar("socio-041", "pista-1", "2026-12-05T10:30"),
+    await reservar("socio-041", "pista-1", "2026-12-02T09:00"),
+    await reservar("socio-041", "pista-2", "2026-12-03T09:00"),
+  ];
+
+  // Enero de 2027: diciembre se genera antes que noviembre y sigue la serie de 2026.
+  await reloj("2027-01-05T10:00");
+  const enero = await reservar("socio-041", "pista-2", "2027-01-11T09:00");
+  const diciembre = (await generar("2026-12")).cuerpo.facturas;
+  assert.equal(diciembre.length, 1);
+  const fNora = diciembre[0];
+  assert.equal(fNora.numero, `F2026-${String(octubre + 1).padStart(4, "0")}`);
+  assert.deepEqual(fNora.lineas.map((l: any) => l.reservaId), [nora[1].id, nora[2].id, nora[0].id], "por inicio de la reserva");
+  assert.deepEqual([fNora.total, fNora.base, fNora.iva], [6400, 5289, 1111], "IVA sobre el total, no línea a línea");
+
+  const noviembre = await generar("2026-11");
+  assert.equal(noviembre.status, 201);
+  const nums = noviembre.cuerpo.facturas.map((f: any) => f.numero);
+  assert.deepEqual(nums, nums.map((_: string, i: number) => `F2026-${String(octubre + 2 + i).padStart(4, "0")}`));
+  const lineas = noviembre.cuerpo.facturas.flatMap((f: any) => f.lineas);
+  assert.deepEqual(lineas.find((l: any) => l.reservaId === "R-0520"), { reservaId: "R-0520", concepto: "Penalización", importe: 1200 });
+  assert.equal(lineas.find((l: any) => l.reservaId === gratis.id), undefined);
+  const marta = noviembre.cuerpo.facturas.find((f: any) => f.socioId === "socio-002");
+  assert.ok(marta.lineas.some((l: any) => l.reservaId === "R-0520"));
+
+  // Un mes sin facturas no gasta números; enero de 2027 empieza su propia serie.
+  assert.equal((await generar("2026-09")).cuerpo.facturas.length, 0);
+  await reloj("2027-02-01T10:00");
+  const fEnero = (await generar("2027-01")).cuerpo.facturas;
+  assert.deepEqual(fEnero.map((f: any) => [f.numero, f.socioId]), [["F2027-0001", "socio-041"]]);
+  assert.equal(fEnero[0].lineas[0].reservaId, enero.id);
+
+  // Ningún número repetido ni con huecos.
+  const todas = (await api.pedir("GET", "/_estado")).cuerpo.facturas.map((f: any) => f.numero).filter((n: string) => n.startsWith("F2026"));
